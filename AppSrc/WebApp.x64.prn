7359>>>>>>>>>>>    End_Procedure
7360>>>>>>>>>>>    
7360>>>>>>>>>>>    Procedure Parse String[] ByRef aLines 
7362>>>>>>>>>>>        Boolean bSuccess bSkip
7362>>>>>>>>>>>        String sLine sChar
7362>>>>>>>>>>>        Integer iLine iLineTo iPos iSection iValue
7362>>>>>>>>>>>        tIniSection[] aIniData
7362>>>>>>>>>>>        tIniSection[] aIniData
7363>>>>>>>>>>>        tIniSection newSec

29496>>>>>>>>>>>    //  Parses newline characters 
29496>>>>>>>>>>>    Procedure SkipNewLine tMultipartParsingData ByRef parsedata
29498>>>>>>>>>>>        //  Skip carriage return
29498>>>>>>>>>>>        If (parsedata.iChunkRead < SizeOfArray(parsedata.ucCurrentChunk) and parsedata.ucCurrentChunk[parsedata.iChunkRead] = 13) Begin
29500>>>>>>>>>>>            Increment parsedata.iChunkRead
29501>>>>>>>>>>>            If (parsedata.iChunkRead >= SizeOfArray(parsedata.ucCurrentChunk)) Begin
29503>>>>>>>>>>>                Send ReadChunk (&parsedata)
29504>>>>>>>>>>>            End
29504>>>>>>>>>>>>
29504>>>>>>>>>>>        
29504>>>>>>>>>>>            //  Skip line feed
29504>>>>>>>>>>>            If (parsedata.iChunkRead < SizeOfArray(parsedata.ucCurrentChunk) and parsedata.ucCurrentChunk[parsedata.iChunkRead] = 10) Begin
29506>>>>>>>>>>>                Increment parsedata.iChunkRead
29507>>>>>>>>>>>                If (parsedata.iChunkRead >= SizeOfArray(parsedata.ucCurrentChunk)) Begin
29509>>>>>>>>>>>                    Send ReadChunk (&parsedata)
29510>>>>>>>>>>>                End
29510>>>>>>>>>>>>
29510>>>>>>>>>>>            End
29510>>>>>>>>>>>>
29510>>>>>>>>>>>        End
29510>>>>>>>>>>>>
29510>>>>>>>>>>>    End_Procedure
29511>>>>>>>>>>>    
29511>>>>>>>>>>>    //  Moves to the next chunk by updating the parsing data. It reads the next chunk for peeking ahead.
29511>>>>>>>>>>>    Procedure ReadChunk tMultipartParsingData ByRef parsedata
29513>>>>>>>>>>>        //  Move to next chunk (already in cache)
29513>>>>>>>>>>>        Move (parsedata.iChunkOffset + SizeOfArray(parsedata.ucCurrentChunk)) to parsedata.iChunkOffset
29514>>>>>>>>>>>        Move parsedata.ucNextChunk to parsedata.ucCurrentChunk
29515>>>>>>>>>>>        Move 0 to parsedata.iChunkRead
29516>>>>>>>>>>>        
29516>>>>>>>>>>>        //  Update the boundpos
29516>>>>>>>>>>>        Get FindToken (&parsedata) parsedata.ucBoundary False False to parsedata.iBoundPos
29517>>>>>>>>>>>        
29517>>>>>>>>>>>        //  Cache the next chunk
29517>>>>>>>>>>>        If (not(parsedata.bEndOfReq)) Begin
29519>>>>>>>>>>>            Get RequestDataUChar HTTP_DEFAULT_CHUNK_SIZE to parsedata.ucNextChunk
29520>>>>>>>>>>>            Move (SizeOfArray(parsedata.ucNextChunk) < HTTP_DEFAULT_CHUNK_SIZE) to parsedata.bEndOfReq
29521>>>>>>>>>>>            Move (parsedata.iSize + SizeOfArray(parsedata.ucNextChunk)) to parsedata.iSize
29522>>>>>>>>>>>        End
29522>>>>>>>>>>>>
29522>>>>>>>>>>>    End_Procedure
29523>>>>>>>>>>>    
29523>>>>>>>>>>>    //  Extracts a value from the request (like content-type, filename, field name). The current 
29523>>>>>>>>>>>    //  position (iChunkRead) will be moved until the end of the value.
29523>>>>>>>>>>>    //  
29523>>>>>>>>>>>    //  Params:
29523>>>>>>>>>>>    //      parsedata   Parsing data for the current parse.
29523>>>>>>>>>>>    //      ucToken     The token that marks the end of the field.
29523>>>>>>>>>>>    //      bBoundPos   If true it will not read past the next boundary.
29523>>>>>>>>>>>    Function ExtractField tMultipartParsingData ByRef parsedata UChar[] ucToken Boolean bBoundPos Returns String
29525>>>>>>>>>>>        Integer iTokenPos
29525>>>>>>>>>>>        UChar[] ucResult
29526>>>>>>>>>>>        String sResult
29526>>>>>>>>>>>        
29526>>>>>>>>>>>        Get FindToken (&parsedata) ucToken False bBoundPos to iTokenPos
29527>>>>>>>>>>>        
29527>>>>>>>>>>>        //  The token might run into the next chunk
29527>>>>>>>>>>>        While (iTokenPos < 0 and (parsedata.iChunkOffset + parsedata.iChunkRead < parsedata.iSize) and not(parsedata.bAbort))
29531>>>>>>>>>>>            Move (AppendArray(ucResult, CopyArray(parsedata.ucCurrentChunk, parsedata.iChunkRead, SizeOfArray(parsedata.ucCurrentChunk)))) to ucResult
29532>>>>>>>>>>>            Send ReadChunk (&parsedata)
29533>>>>>>>>>>>            Get FindToken (&parsedata) ucToken False False to iTokenPos
29534>>>>>>>>>>>        Loop
29535>>>>>>>>>>>>
29535>>>>>>>>>>>        
29535>>>>>>>>>>>        If (iTokenPos > 0) Begin
29537>>>>>>>>>>>            Move (AppendArray(ucResult, CopyArray(parsedata.ucCurrentChunk, parsedata.iChunkRead, iTokenPos - 1))) to ucResult
29538>>>>>>>>>>>            Move (iTokenPos + SizeOfArray(ucToken)) to parsedata.iChunkRead
29539>>>>>>>>>>>        End
29539>>>>>>>>>>>>
29539>>>>>>>>>>>        Else Begin
29540>>>>>>>>>>>            Move (ResizeArray(ucResult, 0)) to ucResult
29541>>>>>>>>>>>        End
29541>>>>>>>>>>>>
29541>>>>>>>>>>>        
29541>>>>>>>>>>>        Get ConvertRequestDataToString ucResult to sResult
29542>>>>>>>>>>>        Function_Return sResult
29543>>>>>>>>>>>    End_Function
29544>>>>>>>>>>>    
29544>>>>>>>>>>>    //  Searches for a token in the current chunk starting at the current position (iChunkRead). It
29544>>>>>>>>>>>    //  will peek in the next chunk if the token starts in the current chunk and continues into the
29544>>>>>>>>>>>    //  next chunk. It will not search the next chunk. 
29544>>>>>>>>>>>    //
29544>>>>>>>>>>>    //  Params:
29544>>>>>>>>>>>    //      parseData   Parsing data.
29544>>>>>>>>>>>    //      ucToken     Token to find in the current chunk data.
29544>>>>>>>>>>>    //      bSkip       If true it will move the current position (iChunkRead) past the found token.
29544>>>>>>>>>>>    //      bBoundary   If true it will not search past the next boundary (iBoundPos).
29544>>>>>>>>>>>    //  Returns:
29544>>>>>>>>>>>    //      The start position of the token, -1 if the token is not found in the current chunk.
29544>>>>>>>>>>>    Function FindToken tMultipartParsingData ByRef parsedata UChar[] ucToken Boolean bSkip Boolean bBoundary Returns Integer

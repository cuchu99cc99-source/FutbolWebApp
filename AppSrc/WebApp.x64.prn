23291>>>>>>>>>    // Clears the view stack.
23291>>>>>>>>>    // bDefaultView - Pass True if the default view should be pushed onto the
23291>>>>>>>>>    //                view stack automatically after it is reset.
23291>>>>>>>>>    // Returns - True if the Reset succeeded.
23291>>>>>>>>>    //           False if the View stack could not be reset (usually due to unsaved changes in
23291>>>>>>>>>    //           one of the current views in the stack).
23291>>>>>>>>>    Function Reset Boolean bDefaultView Boolean bUnconditional Returns Boolean
23293>>>>>>>>>        Handle hoShouldSaveView 
23293>>>>>>>>>        Handle hoTopView hoDefaultView
23293>>>>>>>>>        Integer iDefaultViewIndex
23293>>>>>>>>>        tWebViewInfo[] aViewStack
23293>>>>>>>>>        tWebViewInfo[] aViewStack
23294>>>>>>>>>        String sReason
23294>>>>>>>>>        
23294>>>>>>>>>        Get GetDefaultView of (Host(Self)) to hoDefaultView
23295>>>>>>>>>        Get TopViewHandle to hoTopView
23296>>>>>>>>>        
23296>>>>>>>>>        // First see if it is OK to close all of the current views down
23296>>>>>>>>>        // to the current first view.
23296>>>>>>>>>        If bUnconditional Begin
23298>>>>>>>>>            Move hoDefaultView to hoShouldSaveView
23299>>>>>>>>>        End
23299>>>>>>>>>>
23299>>>>>>>>>        Else Begin
23300>>>>>>>>>            Get CanCloseViews hoDefaultView False to hoShouldSaveView
23301>>>>>>>>>        End
23301>>>>>>>>>>
23301>>>>>>>>>        If (hoShouldSaveView<>hoDefaultView) Begin
23303>>>>>>>>>            If (hoShouldSaveView <> hoTopView) Begin
23305>>>>>>>>>                Send ShowView to (Host(Self)) hoShouldSaveView
23306>>>>>>>>>            End
23306>>>>>>>>>>
23306>>>>>>>>>            Send PopDownToView of (ViewStack(Self)) hoShouldSaveView
23307>>>>>>>>>            Send UpdateInvokingViewDrillDownStyle to hoShouldSaveView
23308>>>>>>>>>            Send CantCloseChangedViewError
23309>>>>>>>>>            Function_Return False
23310>>>>>>>>>        End
23310>>>>>>>>>>
23310>>>>>>>>>        
23310>>>>>>>>>        // If we got here then we can reset the stack...
23310>>>>>>>>>        If (hoTopView <> 0) Begin
23312>>>>>>>>>            If (hoDefaultView <> hoTopView or not(bDefaultView)) Begin
23314>>>>>>>>>                Send Hide to hoTopView    // First hide the current view
23315>>>>>>>>>            End
23315>>>>>>>>>>
23315>>>>>>>>>        End
23315>>>>>>>>>>
23315>>>>>>>>>        
23315>>>>>>>>>        // Make sure we do not clear the default view off the stack
23315>>>>>>>>>        If (bDefaultView and hoDefaultView <> 0) Begin
23317>>>>>>>>>            // Test that the default view is the first view in the stack
23317>>>>>>>>>            Get GetViewIndex hoDefaultView to iDefaultViewIndex
23318>>>>>>>>>            
23318>>>>>>>>>            If (iDefaultViewIndex = 0) Begin
23320>>>>>>>>>                WebGet paViewStack to aViewStack
23321>>>>>>>>>                Move (ResizeArray(aViewStack, 1)) to aViewStack
23322>>>>>>>>>            End
23322>>>>>>>>>>
23322>>>>>>>>>        End
23322>>>>>>>>>>
23322>>>>>>>>>        
23322>>>>>>>>>        // Clear the stack
23322>>>>>>>>>        WebSet paViewStack to aViewStack        
23323>>>>>>>>>        Send NotifyClients    // Notify the view stack clients of this change
23324>>>>>>>>>        
23324>>>>>>>>>        Function_Return True
23325>>>>>>>>>    End_Function

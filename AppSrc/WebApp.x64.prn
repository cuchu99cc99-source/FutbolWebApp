26300>>>>>>>>>>>                            Move (sSearchFilter + " OR ") to sSearchFilter
26301>>>>>>>>>>>                        End
26301>>>>>>>>>>>>
26301>>>>>>>>>>>                        Move (sSearchFilter + sColumnFilter) to sSearchFilter
26302>>>>>>>>>>>                    End
26302>>>>>>>>>>>>
26302>>>>>>>>>>>                End
26302>>>>>>>>>>>>
26302>>>>>>>>>>>            End
26302>>>>>>>>>>>>
26302>>>>>>>>>>>
26302>>>>>>>>>>>            Increment iColumn
26303>>>>>>>>>>>        Loop
26304>>>>>>>>>>>>
26304>>>>>>>>>>>
26304>>>>>>>>>>>        If (sSearchFilter <> "") Begin
26306>>>>>>>>>>>            Move ("(" + sSearchFilter + ")") to sSearchFilter
26307>>>>>>>>>>>        End
26307>>>>>>>>>>>>
26307>>>>>>>>>>>        Else Begin
26308>>>>>>>>>>>            Procedure_Return
26309>>>>>>>>>>>        End
26309>>>>>>>>>>>>
26309>>>>>>>>>>>
26309>>>>>>>>>>>        Move sSearchFilter to sFilter
26310>>>>>>>>>>>        If (sOrigFilter <> "") Begin
26312>>>>>>>>>>>            Get SQLStrAppend of hoDD sOrigFilter sSearchFilter to sFilter
26313>>>>>>>>>>>        End
26313>>>>>>>>>>>>
26313>>>>>>>>>>>
26313>>>>>>>>>>>        If (sFilter = sOrigFilter) Begin
26315>>>>>>>>>>>            Procedure_Return
26316>>>>>>>>>>>        End
26316>>>>>>>>>>>>
26316>>>>>>>>>>>

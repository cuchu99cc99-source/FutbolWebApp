9965>>>>>>>>>        Get piColumnCount to iColCount
9966>>>>>>>>>        Get piHasVariableDataType to iHasVariableDataType
9967>>>>>>>>>        
9967>>>>>>>>>        If (iHasVariableDataType) Begin
9969>>>>>>>>>            
9969>>>>>>>>>            Get piVariableBufferLength      to iVariableBufferLength
9970>>>>>>>>>            Get piMaxVariableBufferLength   to iLen
9971>>>>>>>>>            
9971>>>>>>>>>            If (iLen > iVariableBufferLength) Begin
9973>>>>>>>>>                // Allocate
9973>>>>>>>>>                Move (Repeat(' ', iLen)) to wVariableResult
9974>>>>>>>>>                
9974>>>>>>>>>                Set piVariableBufferLength to iLen
9975>>>>>>>>>                Set psVariableBuffer       to wVariableResult
9976>>>>>>>>>                
9976>>>>>>>>>                Get piVariableBufferLength to iVariableBufferLength
9977>>>>>>>>>            End
9977>>>>>>>>>>
9977>>>>>>>>>        End
9977>>>>>>>>>>
9977>>>>>>>>>        
9977>>>>>>>>>        // Fetch
9977>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
9979>>>>>>>>>            Move (False) to Err
9980>>>>>>>>>            
9980>>>>>>>>>            // FUNC_SQLCOLUMNINFO will tell the driver which hdbc and hstmt to use
9980>>>>>>>>>            // in the next FUNC_SQLCOLUMNVALUE call.
9980>>>>>>>>>            // If hdbc and hstmt have not changed since the last call we don't have to set it.
9980>>>>>>>>>            If (ihstmt <> giLastSQLhstmt or ihdbc <> giLastSQLhdbc) Begin
9982>>>>>>>>>                // Setup function arguments
9982>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO Callback 0 Passing ihdbc iCol ihstmt Result iVoid
9987>>>>>>>>>                Move ihstmt to giLastSQLhstmt
9988>>>>>>>>>                Move ihdbc to giLastSQLhdbc
9989>>>>>>>>>            End
9989>>>>>>>>>>
9989>>>>>>>>>            
9989>>>>>>>>>            // Call the driver function to fetch
9989>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLFETCH Callback 0 Passing ihdbc sEmpty ihstmt Result iResult
9994>>>>>>>>>            
9994>>>>>>>>>            // If something went wrong, adjust the result
9994>>>>>>>>>            If (Err) ;                Move 0 to iResult
9997>>>>>>>>>            
9997>>>>>>>>>            If (iResult) Begin
9999>>>>>>>>>                For iCol from 1 to iColCount
10005>>>>>>>>>>
10005>>>>>>>>>                    
10005>>>>>>>>>                    If (not(aSQLColumns[iCol].iVariableDataType)) Begin
10007>>>>>>>>>                        Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNVALUE ;                            Callback 0 ;                            Passing sEmpty sEmpty iCol ;                            Result pResultWStr
10012>>>>>>>>>                            
10012>>>>>>>>>                        If (pResultWStr) Begin
10014>>>>>>>>>                            Move (CString(PointerToWString(pResultWStr))) to asValues[iCol - 1]
10015>>>>>>>>>                        End
10015>>>>>>>>>>
10015>>>>>>>>>                        Else Begin
10016>>>>>>>>>                            Move "" to asValues[iCol - 1]
10017>>>>>>>>>                        End
10017>>>>>>>>>>
10017>>>>>>>>>                        
10017>>>>>>>>>                    End
10017>>>>>>>>>>
10017>>>>>>>>>                    Else Begin
10018>>>>>>>>>                        Get psVariableBuffer       to wVariableResult
10019>>>>>>>>>                        Call_Driver 0 sDrvrId Function FUNC_SQLGETDATA ;                            Callback 0 ;                            Passing iCol iVariableBufferLength (AddressOf(wVariableResult));                            Result iVoid
10024>>>>>>>>>                        
10024>>>>>>>>>                        Move (CString(wVariableResult)) to asValues[iCol - 1]
10025>>>>>>>>>                    End
10025>>>>>>>>>>
10025>>>>>>>>>                    
10025>>>>>>>>>                Loop
10026>>>>>>>>>>
10026>>>>>>>>>            End
10026>>>>>>>>>>
10026>>>>>>>>>        End

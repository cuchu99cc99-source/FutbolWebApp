39526>>>    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -  
39526>>>    // Add a DDO Structure 
39526>>>    //
39526>>>    // There is no need to synchronize a DD structure on the client so we do
39526>>>    // not set the Server property or send ADDOStructure. We will simply use
39526>>>    // DDO's to mine data and generate HTML for our cWebHTMLBox objects.
39526>>>    // It is the HTML in these objects that is sent to the client each time 
39526>>>    // this page is shown.
39526>>>    //
39526>>>    // Also, it is important for the drill-down Navigation interface that we
39526>>>    // do not set the Server property to some DDO because this will affect 
39526>>>    // constraints in the next view that we navigate to.
39526>>>    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
39526>>>
39526>>>    Set piMaxWidth to 1024
39527>>>    
39527>>>    Set psCaption to "Dashboard"
39528>>>    Set peViewType to vtUndefined

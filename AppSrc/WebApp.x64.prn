29768>>>>>>>>>    //  Registers a folder as being allowed to stream files from. Even through the download URL's 
29768>>>>>>>>>    //  should be secure this provides an extra layer of security on top of the encryption.
29768>>>>>>>>>    //
29768>>>>>>>>>    //  Params:
29768>>>>>>>>>    //      sPath   The absolute path to this folder (relative paths will not work!).
29768>>>>>>>>>    Procedure RegisterDownloadFolder String sPath
29770>>>>>>>>>        String[] aFolders
29771>>>>>>>>>        
29771>>>>>>>>>        Get paDownloadFolders to aFolders
29772>>>>>>>>>        
29772>>>>>>>>>        //  Convert relative paths into a full path and lowercase for comparison
29772>>>>>>>>>        Get FullPathName sPath to sPath
29773>>>>>>>>>        Move (Lowercase(sPath)) to sPath
29774>>>>>>>>>        
29774>>>>>>>>>        //  Add trailing "\" to prevent "Picture" sharing also "Pictures" mistake
29774>>>>>>>>>        If (Right(sPath, 1) <> "\") Begin
29776>>>>>>>>>            Move (sPath + "\") to sPath
29777>>>>>>>>>        End
29777>>>>>>>>>>
29777>>>>>>>>>        
29777>>>>>>>>>        //  Prevent duplicates
29777>>>>>>>>>        If (SearchArray(sPath, aFolders) >= 0) Begin
29779>>>>>>>>>            Procedure_Return 
29780>>>>>>>>>        End
29780>>>>>>>>>>
29780>>>>>>>>>        
29780>>>>>>>>>        //  Add path
29780>>>>>>>>>        Move sPath to aFolders[SizeOfArray(aFolders)]
29781>>>>>>>>>        Set paDownloadFolders to aFolders
29782>>>>>>>>>    End_Procedure

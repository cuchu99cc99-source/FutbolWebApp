2972>>>>>>>        If not (iType=FA_VALIDATION_TYPE_NONE or iType=FA_VALIDATION_TYPE_RANGE) ;            Move DD_Global_Validation_Prompt_Object to iObj
2975>>>>>>>        Function_Return iObj
2976>>>>>>>    End_Function
2977>>>>>>>
2977>>>>>>>

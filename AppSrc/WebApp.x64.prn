7337>>>>>>>>>>>        If (sBOMCheck <> C_BOM_UTF8) Begin
7339>>>>>>>>>>>            Set_Channel_Position iChnl to 0 
7340>>>>>>>>>>>>
7340>>>>>>>>>>>        End
7340>>>>>>>>>>>>
7340>>>>>>>>>>>        
7340>>>>>>>>>>>        Repeat
7340>>>>>>>>>>>>
7340>>>>>>>>>>>            Readln aLines[-1]
7341>>>>>>>>>>>        Until (SeqEof)
7343>>>>>>>>>>>        
7343>>>>>>>>>>>        If (SizeOfArray(aLines) > 0 and aLines[SizeOfArray(aLines) - 1] = "") ;            Move (RemoveFromArray(aLines, SizeOfArray(aLines) - 1)) to aLines
7346>>>>>>>>>>>        
7346>>>>>>>>>>>        Close_Input channel iChnl
7348>>>>>>>>>>>        
7348>>>>>>>>>>>        Send Seq_Release_Channel iChnl
7349>>>>>>>>>>>        

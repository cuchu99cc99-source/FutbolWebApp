15486>>>>>>>        If (pbDataSent(Self)) Begin
15488>>>>>>>            Error DFERR_PROGRAM "Data has already been sent. AddHttpResponseHeader should be called before OutputString or OutputUChar is used."
15489>>>>>>>>
15489>>>>>>>        End
15489>>>>>>>>
15489>>>>>>>        Forward Send AddHttpResponseHeader sHeaderName sHeaderValue
15491>>>>>>>    End_Procedure
15492>>>>>>>
15492>>>>>>>    Procedure OutputString String sData
15494>>>>>>>        UChar[] ucData
15495>>>>>>>        Integer eCodePage
15495>>>>>>>        
15495>>>>>>>        Move (StringToUCharArray(sData)) to ucData
15496>>>>>>>        
15496>>>>>>>        Get peResponseCodePage to eCodePage
15497>>>>>>>        If (eCodePage <> CP_UTF8) Begin
15499>>>>>>>            Get ConvertUCharArray of oCharTranslator ucData CP_UTF8 eCodePage to ucData
15500>>>>>>>        End
15500>>>>>>>>
15500>>>>>>>        
15500>>>>>>>        Send OutputUChar ucData
15501>>>>>>>    End_Procedure

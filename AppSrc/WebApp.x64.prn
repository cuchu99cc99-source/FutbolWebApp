24557>>>>>>>>>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
24559>>>>>>>>>>>>>>>>>            Get piFindIndex to iIndex
24560>>>>>>>>>>>>>>>>>            Get pbCaseSensitive to bCase
24561>>>>>>>>>>>>>>>>>            
24561>>>>>>>>>>>>>>>>>            Get_Attribute DF_FIELD_TYPE of iFile iField to eType
24564>>>>>>>>>>>>>>>>>            Get_Attribute DF_FIELD_LENGTH of iFile iField to iLength
24567>>>>>>>>>>>>>>>>>            Get_Attribute DF_FIELD_PRECISION of iFile iField to iDec
24570>>>>>>>>>>>>>>>>>            
24570>>>>>>>>>>>>>>>>>            Move (iLength - iDec) to iLength
24571>>>>>>>>>>>>>>>>>            
24571>>>>>>>>>>>>>>>>>            If (iIndex <= 0) ;                Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
24576>>>>>>>>>>>>>>>>>            If (iIndex <= 0) ;                Error DFERR_PROGRAM C_$CouldNotFindAnIndex
24579>>>>>>>>>>>>>>>>>            
24579>>>>>>>>>>>>>>>>>            Get No_Relate_State of hoServer to bOldRelate
24580>>>>>>>>>>>>>>>>>            Get DDOConstraintNeedsRelate of hoServer iIndex to bNeedsRelate
24581>>>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to (not(bNeedsRelate))
24582>>>>>>>>>>>>>>>>>            
24582>>>>>>>>>>>>>>>>>            //  Determine current filter settings
24582>>>>>>>>>>>>>>>>>            Get SupportsFilterExpressions hoServer to bSupportsFilters
24583>>>>>>>>>>>>>>>>>            Get piaDataFiles to iaFiles
24584>>>>>>>>>>>>>>>>>            Get piaDataFields to iaFields
24585>>>>>>>>>>>>>>>>>            Move (SizeOfArray(iaFiles) > 1) to bScanAll
24586>>>>>>>>>>>>>>>>>                            
24586>>>>>>>>>>>>>>>>>            Move (Length(sFilter)) to iLen
24587>>>>>>>>>>>>>>>>>            Move (Lowercase(sFilter)) to sLowSearch
24588>>>>>>>>>>>>>>>>>            Move False to bSuccess
24589>>>>>>>>>>>>>>>>>            
24589>>>>>>>>>>>>>>>>>            //  Find first record or if a page was selected do a refind and go from there.
24589>>>>>>>>>>>>>>>>>            If (iPage > 0 and Length(prevItem.sRowId) > 0) Begin
24591>>>>>>>>>>>>>>>>>                Move (DeserializeRowID(prevItem.sRowId)) to riTest    
24592>>>>>>>>>>>>>>>>>                If (not(IsNullRowID(riTest))) Begin
24594>>>>>>>>>>>>>>>>>                    Get ReadByRowIdEx of hoServer iFile riTest to bSuccess
24595>>>>>>>>>>>>>>>>>                End
24595>>>>>>>>>>>>>>>>>>
24595>>>>>>>>>>>>>>>>>            End
24595>>>>>>>>>>>>>>>>>>
24595>>>>>>>>>>>>>>>>>            
24595>>>>>>>>>>>>>>>>>            If (not(bSuccess)) Begin
24597>>>>>>>>>>>>>>>>>                If (bSupportsFilters) Begin
24599>>>>>>>>>>>>>>>>>                    Send ApplyFilterExpression hoServer iaFiles iaFields sFilter (&sOrigFilter) (&bOrigActive) (&bFilterApplied)
24600>>>>>>>>>>>>>>>>>                End
24600>>>>>>>>>>>>>>>>>>
24600>>>>>>>>>>>>>>>>>                If (bScanAll or bFilterApplied) Begin
24602>>>>>>>>>>>>>>>>>                    Send Request_Read of hoServer FIRST_RECORD iFile iIndex
24603>>>>>>>>>>>>>>>>>                End
24603>>>>>>>>>>>>>>>>>>
24603>>>>>>>>>>>>>>>>>                Else Begin
24604>>>>>>>>>>>>>>>>>                    Set_Field_Value iFile iField to sFilter
24607>>>>>>>>>>>>>>>>>                    Send Request_Read of hoServer GE iFile iIndex
24608>>>>>>>>>>>>>>>>>                End
24608>>>>>>>>>>>>>>>>>>
24608>>>>>>>>>>>>>>>>>            End
24608>>>>>>>>>>>>>>>>>>
24608>>>>>>>>>>>>>>>>>            Else Begin
24609>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex  
24610>>>>>>>>>>>>>>>>>            End
24610>>>>>>>>>>>>>>>>>>
24610>>>>>>>>>>>>>>>>>            
24610>>>>>>>>>>>>>>>>>            While (Found and (not(iItemIndex >= iPageSize) or bAllData) and not(bBreak))
24614>>>>>>>>>>>>>>>>>                Move False to bBreak
24615>>>>>>>>>>>>>>>>>                Move (ResizeArray(aEntryValues, 0)) to aEntryValues
24616>>>>>>>>>>>>>>>>>                Get CheckAllEntryItem (&aEntryValues) sFilter bCase False False to bOk
24617>>>>>>>>>>>>>>>>>                If (bOk) Begin
24619>>>>>>>>>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to aItems[iItemIndex].sRowId
24620>>>>>>>>>>>>>>>>>                    Move aEntryValues to aItems[iItemIndex].aValues
24621>>>>>>>>>>>>>>>>>                    Send OnSetCalculatedValue (&aItems[iItemIndex].aValues[0]) 
24622>>>>>>>>>>>>>>>>>                    Increment iItemIndex
24623>>>>>>>>>>>>>>>>>                End
24623>>>>>>>>>>>>>>>>>>
24623>>>>>>>>>>>>>>>>>                Else Begin
24624>>>>>>>>>>>>>>>>>                    If (bScanAll or bFilterApplied) Begin
24626>>>>>>>>>>>>>>>>>                        Move False to bBreak
24627>>>>>>>>>>>>>>>>>                    End
24627>>>>>>>>>>>>>>>>>>
24627>>>>>>>>>>>>>>>>>                    Else Begin
24628>>>>>>>>>>>>>>>>>                        Move True to bBreak
24629>>>>>>>>>>>>>>>>>                    End
24629>>>>>>>>>>>>>>>>>>
24629>>>>>>>>>>>>>>>>>                    If (bBreak and eType = DF_BCD and Length(sFilter) < iLength) Begin
24631>>>>>>>>>>>>>>>>>                        Move (GetRowID(iFile)) to riTest
24632>>>>>>>>>>>>>>>>>                        
24632>>>>>>>>>>>>>>>>>                        Repeat
24632>>>>>>>>>>>>>>>>>>
24632>>>>>>>>>>>>>>>>>                            Move (sFilter + "0") to sFilter
24633>>>>>>>>>>>>>>>>>                            If (Length(sFilter) >= iLength) ;                                Break
24636>>>>>>>>>>>>>>>>>                            
24636>>>>>>>>>>>>>>>>>                            Set_Field_Value iFile iField to sFilter
24639>>>>>>>>>>>>>>>>>                            Send Request_Read of hoServer GE iFile iIndex
24640>>>>>>>>>>>>>>>>>                            Move (IsSameRowID(riTest, GetRowID(iFile))) to bBreak
24641>>>>>>>>>>>>>>>>>                        Until (not(bBreak))
24643>>>>>>>>>>>>>>>>>                    End                    
24643>>>>>>>>>>>>>>>>>>
24643>>>>>>>>>>>>>>>>>                End
24643>>>>>>>>>>>>>>>>>>
24643>>>>>>>>>>>>>>>>>
24643>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex
24644>>>>>>>>>>>>>>>>>            Loop
24645>>>>>>>>>>>>>>>>>>
24645>>>>>>>>>>>>>>>>>            Move (not(Found) or bBreak) to bLast
24646>>>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to bOldRelate
24647>>>>>>>>>>>>>>>>>            Send DisregardFilterExpression hoServer sOrigFilter bOrigActive bFilterApplied
24648>>>>>>>>>>>>>>>>>        End
24648>>>>>>>>>>>>>>>>>>
24648>>>>>>>>>>>>>>>>>    End_Procedure
24649>>>>>>>>>>>>>>>>>    
24649>>>>>>>>>>>>>>>>>    Procedure FindFullText tSelectionItem[] ByRef aItems Boolean ByRef bLast String sFilter tSelectionItem prevItem Integer iPageSize Integer iPage
24651>>>>>>>>>>>>>>>>>        Integer iIndex iFile iField iItemIndex
24651>>>>>>>>>>>>>>>>>        Boolean bCase bOldRelate bNeedsRelate bAllData bSuccess bSupportsFilters bOrigActive bFilterApplied bOk
24651>>>>>>>>>>>>>>>>>        String sLowSearch sRowId sValue sOrigFilter
24651>>>>>>>>>>>>>>>>>        String[] aEntryValues
24652>>>>>>>>>>>>>>>>>        Integer[] iaFiles iaFields
24654>>>>>>>>>>>>>>>>>        Handle hoServer
24654>>>>>>>>>>>>>>>>>        RowID riTest
24654>>>>>>>>>>>>>>>>>        
24654>>>>>>>>>>>>>>>>>        Get Server to hoServer
24655>>>>>>>>>>>>>>>>>        Get Data_File to iFile
24656>>>>>>>>>>>>>>>>>        Get Data_Field to iField
24657>>>>>>>>>>>>>>>>>        Get pbAllData to bAllData
24658>>>>>>>>>>>>>>>>>        Move (SizeOfArray(aItems)) to iItemIndex
24659>>>>>>>>>>>>>>>>>
24659>>>>>>>>>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
24661>>>>>>>>>>>>>>>>>            Get pbCaseSensitive to bCase
24662>>>>>>>>>>>>>>>>>            
24662>>>>>>>>>>>>>>>>>            Get piFindIndex to iIndex
24663>>>>>>>>>>>>>>>>>            If (iIndex <= 0) ;                Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
24668>>>>>>>>>>>>>>>>>            If (iIndex <= 0);                Error DFERR_PROGRAM C_$CouldNotFindAnIndex
24671>>>>>>>>>>>>>>>>>            
24671>>>>>>>>>>>>>>>>>            Get No_Relate_State of hoServer to bOldRelate
24672>>>>>>>>>>>>>>>>>            Get DDOConstraintNeedsRelate of hoServer iIndex to bNeedsRelate
24673>>>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to (not(bNeedsRelate))
24674>>>>>>>>>>>>>>>>>            
24674>>>>>>>>>>>>>>>>>            //  Determine current filter settings
24674>>>>>>>>>>>>>>>>>            Get SupportsFilterExpressions hoServer to bSupportsFilters
24675>>>>>>>>>>>>>>>>>            Get piaDataFiles to iaFiles
24676>>>>>>>>>>>>>>>>>            Get piaDataFields to iaFields
24677>>>>>>>>>>>>>>>>>            
24677>>>>>>>>>>>>>>>>>            Move (Lowercase(sFilter)) to sLowSearch
24678>>>>>>>>>>>>>>>>>            Move False to bSuccess
24679>>>>>>>>>>>>>>>>>            
24679>>>>>>>>>>>>>>>>>            //  Find first record or if a page was selected do a refind and go from there.
24679>>>>>>>>>>>>>>>>>            If (iPage > 0 and Length(prevItem.sRowId) > 0) Begin
24681>>>>>>>>>>>>>>>>>                Move (DeserializeRowID(prevItem.sRowId)) to riTest    
24682>>>>>>>>>>>>>>>>>                If (not(IsNullRowID(riTest))) Begin
24684>>>>>>>>>>>>>>>>>                    Get ReadByRowIdEx of hoServer iFile riTest to bSuccess
24685>>>>>>>>>>>>>>>>>                End
24685>>>>>>>>>>>>>>>>>>
24685>>>>>>>>>>>>>>>>>            End
24685>>>>>>>>>>>>>>>>>>
24685>>>>>>>>>>>>>>>>>            
24685>>>>>>>>>>>>>>>>>            If (not(bSuccess)) Begin
24687>>>>>>>>>>>>>>>>>                If (bSupportsFilters) Begin
24689>>>>>>>>>>>>>>>>>                    Send ApplyFilterExpression hoServer iaFiles iaFields sFilter (&sOrigFilter) (&bOrigActive) (&bFilterApplied)
24690>>>>>>>>>>>>>>>>>                End
24690>>>>>>>>>>>>>>>>>>
24690>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer FIRST_RECORD iFile iIndex
24691>>>>>>>>>>>>>>>>>            End
24691>>>>>>>>>>>>>>>>>>
24691>>>>>>>>>>>>>>>>>            Else Begin
24692>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex  
24693>>>>>>>>>>>>>>>>>            End
24693>>>>>>>>>>>>>>>>>>
24693>>>>>>>>>>>>>>>>>            
24693>>>>>>>>>>>>>>>>>            While (Found and (not(iItemIndex >= iPageSize) or bAllData))
24697>>>>>>>>>>>>>>>>>                Move (ResizeArray(aEntryValues, 0)) to aEntryValues
24698>>>>>>>>>>>>>>>>>                Get CheckAllEntryItem (&aEntryValues) sFilter bCase True False to bOk
24699>>>>>>>>>>>>>>>>>                If (bOk) Begin
24701>>>>>>>>>>>>>>>>>                    
24701>>>>>>>>>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to aItems[iItemIndex].sRowId
24702>>>>>>>>>>>>>>>>>                    Move aEntryValues to aItems[iItemIndex].aValues
24703>>>>>>>>>>>>>>>>>                    Send OnSetCalculatedValue (&aItems[iItemIndex].aValues[0])
24704>>>>>>>>>>>>>>>>>                    
24704>>>>>>>>>>>>>>>>>                    Increment iItemIndex
24705>>>>>>>>>>>>>>>>>                End
24705>>>>>>>>>>>>>>>>>>
24705>>>>>>>>>>>>>>>>>                
24705>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex 
24706>>>>>>>>>>>>>>>>>            Loop
24707>>>>>>>>>>>>>>>>>>
24707>>>>>>>>>>>>>>>>>            Move (not(Found)) to bLast
24708>>>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to bOldRelate
24709>>>>>>>>>>>>>>>>>            Send DisregardFilterExpression hoServer sOrigFilter bOrigActive bFilterApplied
24710>>>>>>>>>>>>>>>>>        End
24710>>>>>>>>>>>>>>>>>>
24710>>>>>>>>>>>>>>>>>    End_Procedure
24711>>>>>>>>>>>>>>>>>
24711>>>>>>>>>>>>>>>>>    Procedure FindFilteredFullText tSelectionItem[] ByRef aItems Boolean ByRef bLast String sFilter tSelectionItem prevItem Integer iPageSize Integer iPage
24713>>>>>>>>>>>>>>>>>        Integer iIndex iFile iField iItemIndex
24713>>>>>>>>>>>>>>>>>        Boolean bOrigActive bOldRelate bNeedsRelate bAllData bSuccess bOk bFilterApplied
24713>>>>>>>>>>>>>>>>>        String sOrigFilter sFile sField sRowId sValue
24713>>>>>>>>>>>>>>>>>        String[] aEntryValues
24714>>>>>>>>>>>>>>>>>        Integer[] iaFiles iaFields
24716>>>>>>>>>>>>>>>>>        Handle hoServer
24716>>>>>>>>>>>>>>>>>        RowID riTest
24716>>>>>>>>>>>>>>>>>        
24716>>>>>>>>>>>>>>>>>        Get Server to hoServer
24717>>>>>>>>>>>>>>>>>        Get Data_File to iFile
24718>>>>>>>>>>>>>>>>>        Get Data_Field to iField
24719>>>>>>>>>>>>>>>>>        Move (SizeOfArray(aItems)) to iItemIndex
24720>>>>>>>>>>>>>>>>>
24720>>>>>>>>>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
24722>>>>>>>>>>>>>>>>>            
24722>>>>>>>>>>>>>>>>>            // make sure we send DD messages to owner DDO
24722>>>>>>>>>>>>>>>>>            Get Which_Data_Set of hoServer iFile to hoServer
24723>>>>>>>>>>>>>>>>>            If (hoServer=0) Begin
24725>>>>>>>>>>>>>>>>>                Procedure_Return
24726>>>>>>>>>>>>>>>>>            End
24726>>>>>>>>>>>>>>>>>>
24726>>>>>>>>>>>>>>>>>            
24726>>>>>>>>>>>>>>>>>            Get piFindIndex to iIndex
24727>>>>>>>>>>>>>>>>>            If (iIndex <= 0) ;                Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
24732>>>>>>>>>>>>>>>>>            If (iIndex <= 0) ;                Error DFERR_PROGRAM C_$CouldNotFindAnIndex
24735>>>>>>>>>>>>>>>>>            
24735>>>>>>>>>>>>>>>>>            //  Determine current filter settings
24735>>>>>>>>>>>>>>>>>            Get piaDataFiles to iaFiles
24736>>>>>>>>>>>>>>>>>            Get piaDataFields to iaFields
24737>>>>>>>>>>>>>>>>>            Send ApplyFilterExpression hoServer iaFiles iaFields sFilter (&sOrigFilter) (&bOrigActive) (&bFilterApplied)
24738>>>>>>>>>>>>>>>>>            
24738>>>>>>>>>>>>>>>>>            // this will optimize No_relate. If your DF constraint does not
24738>>>>>>>>>>>>>>>>>            // need a post-relate test, we will disabled relates for this
24738>>>>>>>>>>>>>>>>>            Get No_Relate_State of hoServer to bOldRelate
24739>>>>>>>>>>>>>>>>>            Get DDOConstraintNeedsRelate of hoServer iIndex to bNeedsRelate
24740>>>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to (not(bNeedsRelate))
24741>>>>>>>>>>>>>>>>>            
24741>>>>>>>>>>>>>>>>>            Move False to bSuccess
24742>>>>>>>>>>>>>>>>>            
24742>>>>>>>>>>>>>>>>>            //  Find first record or if a page was selected do a refind and go from there.
24742>>>>>>>>>>>>>>>>>            If (iPage > 0 and Length(prevItem.sRowId) > 0) Begin
24744>>>>>>>>>>>>>>>>>                Move (DeserializeRowID(prevItem.sRowId)) to riTest    
24745>>>>>>>>>>>>>>>>>                If (not(IsNullRowID(riTest))) Begin
24747>>>>>>>>>>>>>>>>>                    Get FindByRowIdEx of hoServer iFile riTest to bSuccess
24748>>>>>>>>>>>>>>>>>                End
24748>>>>>>>>>>>>>>>>>>
24748>>>>>>>>>>>>>>>>>            End
24748>>>>>>>>>>>>>>>>>>
24748>>>>>>>>>>>>>>>>>            
24748>>>>>>>>>>>>>>>>>            If (not(bSuccess)) Begin
24750>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer FIRST_RECORD iFile iIndex
24751>>>>>>>>>>>>>>>>>            End
24751>>>>>>>>>>>>>>>>>>
24751>>>>>>>>>>>>>>>>>            Else Begin
24752>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex  
24753>>>>>>>>>>>>>>>>>            End
24753>>>>>>>>>>>>>>>>>>
24753>>>>>>>>>>>>>>>>>            
24753>>>>>>>>>>>>>>>>>            While (Found and not(iItemIndex >= iPageSize))
24757>>>>>>>>>>>>>>>>>                Move (ResizeArray(aEntryValues, 0)) to aEntryValues
24758>>>>>>>>>>>>>>>>>                Get CheckAllEntryItem (&aEntryValues) sFilter False True False to bOk
24759>>>>>>>>>>>>>>>>>                If (bOk) Begin
24761>>>>>>>>>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to aItems[iItemIndex].sRowId
24762>>>>>>>>>>>>>>>>>                    Move aEntryValues to aItems[iItemIndex].aValues
24763>>>>>>>>>>>>>>>>>                    Send OnSetCalculatedValue (&aItems[iItemIndex].aValues[0])
24764>>>>>>>>>>>>>>>>>                    
24764>>>>>>>>>>>>>>>>>                    Increment iItemIndex
24765>>>>>>>>>>>>>>>>>                End
24765>>>>>>>>>>>>>>>>>>
24765>>>>>>>>>>>>>>>>>                    
24765>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex
24766>>>>>>>>>>>>>>>>>            Loop
24767>>>>>>>>>>>>>>>>>>
24767>>>>>>>>>>>>>>>>>            Move (not(Found)) to bLast
24768>>>>>>>>>>>>>>>>>            
24768>>>>>>>>>>>>>>>>>            //  Restore filters
24768>>>>>>>>>>>>>>>>>            Send Clear of hoServer
24769>>>>>>>>>>>>>>>>>            Send DisregardFilterExpression hoServer sOrigFilter bOrigActive bFilterApplied
24770>>>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to bOldRelate
24771>>>>>>>>>>>>>>>>>        End
24771>>>>>>>>>>>>>>>>>>
24771>>>>>>>>>>>>>>>>>    End_Procedure
24772>>>>>>>>>>>>>>>>>
24772>>>>>>>>>>>>>>>>>    Procedure FindValidation Boolean bFullText tSelectionItem[] ByRef aItems Boolean ByRef bLast String sFilter tSelectionItem prevItem Integer iPageSize Integer iPage
24774>>>>>>>>>>>>>>>>>        Handle hoTable hoServer
24774>>>>>>>>>>>>>>>>>        Integer iCount iFound iLen iFile iField iItemIndex
24774>>>>>>>>>>>>>>>>>        Variant[][] aData
24775>>>>>>>>>>>>>>>>>        Boolean bCaseSensitive bAllData bOk
24775>>>>>>>>>>>>>>>>>        String sValue sDescription sCompareValue sCompareDescription
24775>>>>>>>>>>>>>>>>>        
24775>>>>>>>>>>>>>>>>>        Get Server to hoServer
24776>>>>>>>>>>>>>>>>>        Get Data_File to iFile
24777>>>>>>>>>>>>>>>>>        Get Data_Field to iField
24778>>>>>>>>>>>>>>>>>        Get pbAllData to bAllData
24779>>>>>>>>>>>>>>>>>        Move (SizeOfArray(aItems)) to iItemIndex
24780>>>>>>>>>>>>>>>>>
24780>>>>>>>>>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
24782>>>>>>>>>>>>>>>>>            Get File_Field_Table_Object of hoServer iFile iField to hoTable
24783>>>>>>>>>>>>>>>>>            If (hoTable <> 0) Begin
24785>>>>>>>>>>>>>>>>>                Get tabledata of hoTable to aData
24786>>>>>>>>>>>>>>>>>        
24786>>>>>>>>>>>>>>>>>                Get pbCaseSensitive to bCaseSensitive  
24787>>>>>>>>>>>>>>>>>            
24787>>>>>>>>>>>>>>>>>                If (not(bCaseSensitive)) Begin
24789>>>>>>>>>>>>>>>>>                    Move (Lowercase(sFilter)) to sFilter
24790>>>>>>>>>>>>>>>>>                End
24790>>>>>>>>>>>>>>>>>>
24790>>>>>>>>>>>>>>>>>                
24790>>>>>>>>>>>>>>>>>                Move (SizeOfArray(aData)) to iCount
24791>>>>>>>>>>>>>>>>>                Move (Length(sFilter)) to iLen
24792>>>>>>>>>>>>>>>>>                
24792>>>>>>>>>>>>>>>>>                If (iPage > 0 and prevItem.sRowId > 0);                    Move (prevItem.sRowId + 1) to iFound
24795>>>>>>>>>>>>>>>>>            
24795>>>>>>>>>>>>>>>>>                While (iFound < iCount and (not(iItemIndex >= iPageSize) or bAllData))
24799>>>>>>>>>>>>>>>>>                    Move (Trim(aData[iFound][0])) to sValue
24800>>>>>>>>>>>>>>>>>                    Move (Trim(aData[iFound][1])) to sDescription
24801>>>>>>>>>>>>>>>>>                    Get Find_Code_Description of hoTable sValue to sDescription
24802>>>>>>>>>>>>>>>>>                    Move sValue to sCompareValue
24803>>>>>>>>>>>>>>>>>                    Move sDescription to sCompareDescription
24804>>>>>>>>>>>>>>>>>                    If (not(bCaseSensitive)) Begin
24806>>>>>>>>>>>>>>>>>                        Move (Lowercase(sCompareValue)) to sCompareValue
24807>>>>>>>>>>>>>>>>>                        Move (Lowercase(sCompareDescription)) to sCompareDescription
24808>>>>>>>>>>>>>>>>>                    End
24808>>>>>>>>>>>>>>>>>>
24808>>>>>>>>>>>>>>>>>                    Move False to bOk
24809>>>>>>>>>>>>>>>>>                    If (bFullText) Begin
24811>>>>>>>>>>>>>>>>>                        Move (sCompareValue contains sFilter or sCompareDescription contains sFilter) to bOk
24812>>>>>>>>>>>>>>>>>                    End
24812>>>>>>>>>>>>>>>>>>
24812>>>>>>>>>>>>>>>>>                    Else Begin
24813>>>>>>>>>>>>>>>>>                        Move (Left(sCompareValue, iLen) = sFilter or Left(sCompareDescription, iLen) = sFilter) to bOk
24814>>>>>>>>>>>>>>>>>                    End
24814>>>>>>>>>>>>>>>>>>
24814>>>>>>>>>>>>>>>>>                    
24814>>>>>>>>>>>>>>>>>                    If (bOk) Begin
24816>>>>>>>>>>>>>>>>>                        Move (String(iFound)) to aItems[iItemIndex].sRowId
24817>>>>>>>>>>>>>>>>>                        Move sValue to aItems[iItemIndex].aValues[0]
24818>>>>>>>>>>>>>>>>>                        Move sDescription to aItems[iItemIndex].aValues[1]
24819>>>>>>>>>>>>>>>>>                        
24819>>>>>>>>>>>>>>>>>                        Increment iItemIndex
24820>>>>>>>>>>>>>>>>>                    End
24820>>>>>>>>>>>>>>>>>>
24820>>>>>>>>>>>>>>>>>                    
24820>>>>>>>>>>>>>>>>>                    Increment iFound
24821>>>>>>>>>>>>>>>>>                Loop
24822>>>>>>>>>>>>>>>>>>
24822>>>>>>>>>>>>>>>>>                Move (iFound >= iCount) to bLast
24823>>>>>>>>>>>>>>>>>            End
24823>>>>>>>>>>>>>>>>>>
24823>>>>>>>>>>>>>>>>>        End
24823>>>>>>>>>>>>>>>>>>
24823>>>>>>>>>>>>>>>>>    End_Procedure
24824>>>>>>>>>>>>>>>>>
24824>>>>>>>>>>>>>>>>>    Function RefindByRowIdentification String sRowIdentification tSelectionItem ByRef tOut Returns Boolean
24826>>>>>>>>>>>>>>>>>        Handle hoServer hoTable
24826>>>>>>>>>>>>>>>>>        Integer iFile iField iRow
24826>>>>>>>>>>>>>>>>>        Variant[][] aData
24827>>>>>>>>>>>>>>>>>        Boolean bSuccess bCaseSensitive bIsValidationTable
24827>>>>>>>>>>>>>>>>>        RowID rRowId
24827>>>>>>>>>>>>>>>>>        
24827>>>>>>>>>>>>>>>>>        Get Server to hoServer
24828>>>>>>>>>>>>>>>>>        Get Data_File to iFile
24829>>>>>>>>>>>>>>>>>        Get Data_Field to iField
24830>>>>>>>>>>>>>>>>>        Get pbUseValidationTable to bIsValidationTable
24831>>>>>>>>>>>>>>>>>                
24831>>>>>>>>>>>>>>>>>        If (hoServer <> 0) Begin
24833>>>>>>>>>>>>>>>>>            If (not(bIsValidationTable)) Begin
24835>>>>>>>>>>>>>>>>>                Move (DeserializeRowID(sRowIdentification)) to rRowId    
24836>>>>>>>>>>>>>>>>>                If (not(IsNullRowID(rRowId))) Begin
24838>>>>>>>>>>>>>>>>>                    Get FindByRowIdEx of hoServer iFile rRowId to bSuccess
24839>>>>>>>>>>>>>>>>>                End
24839>>>>>>>>>>>>>>>>>>
24839>>>>>>>>>>>>>>>>>                If (bSuccess) Begin
24841>>>>>>>>>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to tOut.sRowId
24842>>>>>>>>>>>>>>>>>                    Get_Field_Value iFile iField to tOut.aValues[0]
24845>>>>>>>>>>>>>>>>>                    Move (Trim(tOut.aValues[0])) to tOut.aValues[0]
24846>>>>>>>>>>>>>>>>>                    Function_Return True
24847>>>>>>>>>>>>>>>>>                End
24847>>>>>>>>>>>>>>>>>>
24847>>>>>>>>>>>>>>>>>            End
24847>>>>>>>>>>>>>>>>>>
24847>>>>>>>>>>>>>>>>>            Else Begin
24848>>>>>>>>>>>>>>>>>                Get File_Field_Table_Object of hoServer iFile iField to hoTable
24849>>>>>>>>>>>>>>>>>                Get tabledata of hoTable to aData
24850>>>>>>>>>>>>>>>>>                Get pbCaseSensitive to bCaseSensitive
24851>>>>>>>>>>>>>>>>>            
24851>>>>>>>>>>>>>>>>>                For iRow from 0 to (SizeOfArray(aData) - 1)
24857>>>>>>>>>>>>>>>>>>
24857>>>>>>>>>>>>>>>>>                    If (aData[iRow][0] = sRowIdentification or (not(bCaseSensitive) and Lowercase(aData[iRow][0]) = sRowIdentification)) Begin
24859>>>>>>>>>>>>>>>>>                        If (not(bCaseSensitive)) Begin
24861>>>>>>>>>>>>>>>>>                            Move (Lowercase(aData[iRow][0])) to tOut.sRowId
24862>>>>>>>>>>>>>>>>>                            Move (Lowercase(Trim(aData[iRow][0]))) to tOut.aValues[0]
24863>>>>>>>>>>>>>>>>>                            Move (Lowercase(Trim(aData[iRow][1]))) to tOut.aValues[1]
24864>>>>>>>>>>>>>>>>>                        End
24864>>>>>>>>>>>>>>>>>>
24864>>>>>>>>>>>>>>>>>                        Else Begin
24865>>>>>>>>>>>>>>>>>                            Move aData[iRow][0] to tOut.sRowId
24866>>>>>>>>>>>>>>>>>                            Move (Trim(aData[iRow][0])) to tOut.aValues[0]
24867>>>>>>>>>>>>>>>>>                            Move (Trim(aData[iRow][1])) to tOut.aValues[1]
24868>>>>>>>>>>>>>>>>>                        End
24868>>>>>>>>>>>>>>>>>>
24868>>>>>>>>>>>>>>>>>                        Function_Return True
24869>>>>>>>>>>>>>>>>>                    End
24869>>>>>>>>>>>>>>>>>>
24869>>>>>>>>>>>>>>>>>                Loop
24870>>>>>>>>>>>>>>>>>>
24870>>>>>>>>>>>>>>>>>            End
24870>>>>>>>>>>>>>>>>>>
24870>>>>>>>>>>>>>>>>>        End
24870>>>>>>>>>>>>>>>>>>
24870>>>>>>>>>>>>>>>>>        Function_Return False
24871>>>>>>>>>>>>>>>>>    End_Function
24872>>>>>>>>>>>>>>>>>
24872>>>>>>>>>>>>>>>>>    Function RefindByValue String sValue tSelectionItem ByRef tOut Returns Boolean
24874>>>>>>>>>>>>>>>>>        Handle hoServer hoTable
24874>>>>>>>>>>>>>>>>>        String sDBValue
24874>>>>>>>>>>>>>>>>>        Integer iFile iField iRow iIndex
24874>>>>>>>>>>>>>>>>>        Variant[][] aData
24875>>>>>>>>>>>>>>>>>        Boolean bFound bCaseSensitive bIsValidationTable
24875>>>>>>>>>>>>>>>>>        
24875>>>>>>>>>>>>>>>>>        Get Server to hoServer
24876>>>>>>>>>>>>>>>>>        Get Data_File to iFile
24877>>>>>>>>>>>>>>>>>        Get Data_Field to iField
24878>>>>>>>>>>>>>>>>>        Get pbUseValidationTable to bIsValidationTable
24879>>>>>>>>>>>>>>>>>        Get pbCaseSensitive to bCaseSensitive
24880>>>>>>>>>>>>>>>>>        
24880>>>>>>>>>>>>>>>>>        Get piFindIndex to iIndex
24881>>>>>>>>>>>>>>>>>        If (iIndex <= 0) ;            Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
24886>>>>>>>>>>>>>>>>>        If (iIndex <= 0) ;            Error DFERR_PROGRAM C_$CouldNotFindAnIndex
24889>>>>>>>>>>>>>>>>>                
24889>>>>>>>>>>>>>>>>>        If (hoServer <> 0) Begin
24891>>>>>>>>>>>>>>>>>            If (not(bIsValidationTable)) Begin
24893>>>>>>>>>>>>>>>>>                Send Request_Clear of hoServer
24894>>>>>>>>>>>>>>>>>                Set_Field_Value iFile iField to sValue
24897>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer GE iFile iIndex
24898>>>>>>>>>>>>>>>>>                Get_Field_Value iFile iField to sDBValue
24901>>>>>>>>>>>>>>>>>                
24901>>>>>>>>>>>>>>>>>                If (Found and (sDBValue = sValue or (not(bCaseSensitive) and Lowercase(sDBValue) = Lowercase(sValue)))) Begin
24903>>>>>>>>>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to tOut.sRowId
24904>>>>>>>>>>>>>>>>>                    Move (Trim(sValue)) to tOut.aValues[0]
24905>>>>>>>>>>>>>>>>>                    Function_Return True
24906>>>>>>>>>>>>>>>>>                End
24906>>>>>>>>>>>>>>>>>>
24906>>>>>>>>>>>>>>>>>            End
24906>>>>>>>>>>>>>>>>>>
24906>>>>>>>>>>>>>>>>>            Else Begin
24907>>>>>>>>>>>>>>>>>                Get File_Field_Table_Object of hoServer iFile iField to hoTable
24908>>>>>>>>>>>>>>>>>                Get tabledata of hoTable to aData
24909>>>>>>>>>>>>>>>>>        
24909>>>>>>>>>>>>>>>>>                For iRow from 0 to (SizeOfArray(aData) - 1)
24915>>>>>>>>>>>>>>>>>>
24915>>>>>>>>>>>>>>>>>                    If (aData[iRow][0] = sValue or (not(bCaseSensitive) and Lowercase(aData[iRow][0]) = Lowercase(sValue))) Begin
24917>>>>>>>>>>>>>>>>>                        Move aData[iRow][0] to tOut.sRowId
24918>>>>>>>>>>>>>>>>>                        Move (Trim(aData[iRow][0])) to tOut.aValues[0]
24919>>>>>>>>>>>>>>>>>                        Move (Trim(aData[iRow][1])) to tOut.aValues[1]
24920>>>>>>>>>>>>>>>>>                        Function_Return True
24921>>>>>>>>>>>>>>>>>                    End
24921>>>>>>>>>>>>>>>>>>
24921>>>>>>>>>>>>>>>>>                Loop
24922>>>>>>>>>>>>>>>>>>
24922>>>>>>>>>>>>>>>>>            End
24922>>>>>>>>>>>>>>>>>>
24922>>>>>>>>>>>>>>>>>        End
24922>>>>>>>>>>>>>>>>>>
24922>>>>>>>>>>>>>>>>>        Function_Return False
24923>>>>>>>>>>>>>>>>>    End_Function

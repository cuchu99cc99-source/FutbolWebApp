39477>>>>>            Error DFERR_PROGRAM "Unable to generate download key"
39478>>>>>>
39478>>>>>            Function_Return ""
39479>>>>>        End
39479>>>>>>
39479>>>>>        
39479>>>>>        //  Encode binary hash to Base64
39479>>>>>        Move (Base64Encode(AddressOf(ucBinary), SizeOfArray(ucBinary))) to pBase64
39480>>>>>        Move (PointerToString(pBase64)) to sBase64
39481>>>>>        Move (Free(pBase64)) to iVoid
39482>>>>>        
39482>>>>>        //  Replace URL sensitive characters
39482>>>>>        Move (Replaces("/", sBase64, "-")) to sBase64
39483>>>>>        Move (Replaces("+", sBase64, "_")) to sBase64

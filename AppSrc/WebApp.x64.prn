39444>>>>>    // Splits a string into an array of strings using the given delimeter.
39444>>>>>    //
39444>>>>>    // Params:
39444>>>>>    //     sString     The string to split.
39444>>>>>    //     sDel        The delimiter (like "," or "|")
39444>>>>>    // Returns:
39444>>>>>    //     Array of strings (not including the delimiters itself.
39444>>>>>    Function StrSplit String sString String sDel Returns String[]
39446>>>>>        String[] asResult
39447>>>>>        Integer iStart iEnd iDel
39447>>>>>        
39447>>>>>        If (sString <> "") Begin
39449>>>>>            
39449>>>>>            Move 1 to iStart
39450>>>>>            
39450>>>>>            If (sDel  <> "") Begin
39452>>>>>                Move (Length(sDel)) to iDel
39453>>>>>                Move (Pos(sDel, sString, iStart)) to iEnd
39454>>>>>                
39454>>>>>                While (iEnd > 0)
39458>>>>>                    Move (Mid(sString,  iEnd - iStart, iStart)) to asResult[SizeOfArray(asResult)]
39459>>>>>                    
39459>>>>>                    Move (iEnd + iDel) to iStart
39460>>>>>                    Move (Pos(sDel, sString, iStart)) to iEnd
39461>>>>>                Loop
39462>>>>>>
39462>>>>>                
39462>>>>>                Move (Right(sString,  Length(sString) - iStart + 1)) to asResult[SizeOfArray(asResult)]
39463>>>>>            End
39463>>>>>>
39463>>>>>            Else Begin
39464>>>>>                Move sString to asResult[SizeOfArray(asResult)]
39465>>>>>            End
39465>>>>>>
39465>>>>>            
39465>>>>>        End
39465>>>>>>
39465>>>>>        
39465>>>>>        
39465>>>>>        Function_Return asResult
39466>>>>>    End_Function

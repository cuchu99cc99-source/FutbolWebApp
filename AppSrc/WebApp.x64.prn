39972>>>                // If from parent, this is a constrained drill down
39972>>>                // If Row select does main-zoom we don't need this
39972>>>                WebSet pbRender of oDetailButton to False
39973>>>                Case Break
39974>>>
39974>>>            Case (NavigateData.eNavigateType = nfFromChild)
39977>>>                // If from child, this is a probably a parent lookup from a Zoom
39977>>>                Case Break
39978>>>
39978>>>            Case (NavigateData.eNavigateType = nfFromMain)
39981>>>                // If from main, this is a probably a main-file lookup from a Zoom
39981>>>                WebSet pbRender of oDetailButton to False
39982>>>                Case Break
39983>>>
39983>>>            Case Else // must be nfUndefined
39983>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
39983>>>                // If Row select does main-zoom we don't need this
39983>>>                WebSet pbRender of oDetailButton to False
39984>>>
39984>>>        Case End
39984>>>
39984>>>    End_Procedure

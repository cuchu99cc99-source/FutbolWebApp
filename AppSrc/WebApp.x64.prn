20152>>>>>>>>>>>>>>>    //  Override the ShowControlError function called by the error system to show control errors. 
20152>>>>>>>>>>>>>>>    //  Returns true to let the error system know that this control can show errors.
20152>>>>>>>>>>>>>>>    Function ShowControlError Integer iErrNum String sErrText Returns Boolean
20154>>>>>>>>>>>>>>>        Boolean bInSync bRender
20154>>>>>>>>>>>>>>>        
20154>>>>>>>>>>>>>>>        Get IsInCallActionScope to bInSync
20155>>>>>>>>>>>>>>>        If (bInSync) Begin
20157>>>>>>>>>>>>>>>            Get IsControlRendered to bRender
20158>>>>>>>>>>>>>>>            If (bRender) Begin
20160>>>>>>>>>>>>>>>                Send ShowControlError iErrNum sErrText
20161>>>>>>>>>>>>>>>                Function_Return True        
20162>>>>>>>>>>>>>>>            End
20162>>>>>>>>>>>>>>>>
20162>>>>>>>>>>>>>>>        End
20162>>>>>>>>>>>>>>>>
20162>>>>>>>>>>>>>>>        
20162>>>>>>>>>>>>>>>        Function_Return False
20163>>>>>>>>>>>>>>>    End_Function
20164>>>>>>>>>>>>>>>    
20164>>>>>>>>>>>>>>>    
20164>>>>>>>>>>>>>>>    //  Displays a control error in an error balloon around the control. The error number is used 
20164>>>>>>>>>>>>>>>    //  as identifier to hide the error. The error will be cleared by a WebSet of psValue and the 
20164>>>>>>>>>>>>>>>    //  HideControlError / HideAllControlErrors procedures and by a succesfull server-side 
20164>>>>>>>>>>>>>>>    //  validation.
20164>>>>>>>>>>>>>>>    // 
20164>>>>>>>>>>>>>>>    //  Params:
20164>>>>>>>>>>>>>>>    //      iErrNum     Error number used as identifier.
20164>>>>>>>>>>>>>>>    //      sErrText    Error description.
20164>>>>>>>>>>>>>>>    Procedure ShowControlError Integer iErrNum String sErrText
20166>>>>>>>>>>>>>>>        String[] aParams
20167>>>>>>>>>>>>>>>        
20167>>>>>>>>>>>>>>>        Move iErrNum    to aParams[0]
20168>>>>>>>>>>>>>>>        Move sErrText   to aParams[1]
20169>>>>>>>>>>>>>>>        
20169>>>>>>>>>>>>>>>        WebSet pbHasControlError to True
20170>>>>>>>>>>>>>>>        Send ClientAction "showControlError" aParams
20171>>>>>>>>>>>>>>>    End_Procedure
20172>>>>>>>>>>>>>>>        
20172>>>>>>>>>>>>>>>    
20172>>>>>>>>>>>>>>>    //  Hides an error shown using ShowControlError based on its error number.
20172>>>>>>>>>>>>>>>    // 
20172>>>>>>>>>>>>>>>    //  Params:
20172>>>>>>>>>>>>>>>    //      iErrNum     Error number used as identifier.
20172>>>>>>>>>>>>>>>    Procedure HideControlError Integer iErrNum
20174>>>>>>>>>>>>>>>        String[] aParams
20175>>>>>>>>>>>>>>>        
20175>>>>>>>>>>>>>>>        Move iErrNum    to aParams[0]
20176>>>>>>>>>>>>>>>        
20176>>>>>>>>>>>>>>>        Send ClientAction "hideControlError" aParams
20177>>>>>>>>>>>>>>>    End_Procedure
20178>>>>>>>>>>>>>>>    
20178>>>>>>>>>>>>>>>    //  Hides all active control errors on this control.
20178>>>>>>>>>>>>>>>    Procedure HideAllControlErrors
20180>>>>>>>>>>>>>>>        Boolean bHas
20180>>>>>>>>>>>>>>>        
20180>>>>>>>>>>>>>>>        WebGet pbHasControlError to bHas
20181>>>>>>>>>>>>>>>        
20181>>>>>>>>>>>>>>>        If (bHas) Begin
20183>>>>>>>>>>>>>>>            Send ClientAction "hideAllControlErrors"
20184>>>>>>>>>>>>>>>            WebSet pbHasControlError to False
20185>>>>>>>>>>>>>>>        End
20185>>>>>>>>>>>>>>>>
20185>>>>>>>>>>>>>>>    End_Procedure
20186>>>>>>>>>>>>>>>    
20186>>>>>>>>>>>>>>>    
20186>>>>>>>>>>>>>>>    //  Called to determine if filling the DEO with data is allowed.

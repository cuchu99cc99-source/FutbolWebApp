11657>>>>>>>        
11657>>>>>>>        Get pbCmdLineIniAllowed to bCmdLineIniAllowed
11658>>>>>>>        Get phoWorkspace of ghoApplication to hoWorkspace
11659>>>>>>>        
11659>>>>>>>        // order of naming precedence
11659>>>>>>>        // 1. If defined directly via a set, use that name
11659>>>>>>>        // 2. If command line allowed and exists use that name
11659>>>>>>>        // 3. If workspace has a definition (from config.ws) use that name
11659>>>>>>>        // 4. Else the default of data\dfconnid.ini
11659>>>>>>>        
11659>>>>>>>        Get psConnectionIni to sConnections
11660>>>>>>>        If (sConnections="" and bCmdLineIniAllowed) Begin
11662>>>>>>>            Get ConnectionIniFromCmdLine to sConnections
11663>>>>>>>        End
11663>>>>>>>>
11663>>>>>>>        If (sConnections="") Begin
11665>>>>>>>            Get psConnectionIni of hoWorkspace to sConnections
11666>>>>>>>        End
11666>>>>>>>>
11666>>>>>>>        If (sConnections="") Begin
11668>>>>>>>            Move C_ConnectionIniFileName to sConnections
11669>>>>>>>        End
11669>>>>>>>>
11669>>>>>>>        Move (Trim(sConnections)) to sConnections
11670>>>>>>>        
11670>>>>>>>        If (sConnections<>"") Begin
11672>>>>>>>            // first data path
11672>>>>>>>            If (Pos("<datapath>\",Lowercase(sConnections))) Begin
11674>>>>>>>                Get psDataPath of hoWorkspace to sPath
11675>>>>>>>                Move "<datapath>\" to sPName
11676>>>>>>>            End
11676>>>>>>>>
11676>>>>>>>            // first programs path
11676>>>>>>>            Else If (Pos("<apppath>\",Lowercase(sConnections))) Begin
11679>>>>>>>                Get GetApplicationPath of hoWorkspace to sPath
11680>>>>>>>                Move "<apppath>\" to sPName
11681>>>>>>>            End
11681>>>>>>>>
11681>>>>>>>            // first workspace home path
11681>>>>>>>            Else If (Pos("<homepath>\",Lowercase(sConnections))) Begin
11684>>>>>>>                Get psHome of hoWorkspace to sPath
11685>>>>>>>                Move "<homepath>\" to sPName
11686>>>>>>>            End
11686>>>>>>>>
11686>>>>>>>            // if no special path, use first data path
11686>>>>>>>            Else If (not(IsFilenameQualified(sConnections))) Begin
11689>>>>>>>                Get psDataPath of hoWorkspace to sPath
11690>>>>>>>                Move '' to sPName
11691>>>>>>>            End
11691>>>>>>>>
11691>>>>>>>            
11691>>>>>>>            If (sPath<>"") Begin
11693>>>>>>>                Get PathAtIndex of hoWorkspace sPath 1 to sPath
11694>>>>>>>                If (sPName<>"") Begin
11696>>>>>>>                    Move (Replace(sPName, sConnections, (sPath + "\"))) to sConnections
11697>>>>>>>                End
11697>>>>>>>>
11697>>>>>>>                Else Begin
11698>>>>>>>                    Move (sPath + "\" + sConnections) to sConnections
11699>>>>>>>                End
11699>>>>>>>>
11699>>>>>>>            End
11699>>>>>>>>
11699>>>>>>>        End
11699>>>>>>>>
11699>>>>>>>        Function_Return sConnections
11700>>>>>>>    End_Function
11701>>>>>>>    
11701>>>>>>>    Procedure OnReadCredentials String sSection String sId Handle hoIni String ByRef sUID String ByRef sPWDEncrypted Boolean ByRef bTrusted
11703>>>>>>>        String sTrusted
11703>>>>>>>        If (hoIni) Begin
11705>>>>>>>            Get ReadString of hoIni sSection C_ConnectionIniSectionUID "" to sUID
11706>>>>>>>            Get ReadString of hoIni sSection C_ConnectionIniSectionPWD "" to sPWDEncrypted
11707>>>>>>>            Get ReadString of hoIni sSection C_ConnectionIniSectionTrusted "" to sTrusted
11708>>>>>>>            Move (lowercase(sTrusted)="yes") to bTrusted
11709>>>>>>>        End
11709>>>>>>>>
11709>>>>>>>    End_Procedure
11710>>>>>>>    
11710>>>>>>>    Procedure OnWriteCredentials String sSection String sId Handle hoIni String sUID String sPWDEncrypted Boolean bTrusted
11712>>>>>>>        If hoIni Begin
11714>>>>>>>            If (not(bTrusted) and  sUID<>"") Begin
11716>>>>>>>                Send WriteString of hoIni sSection C_ConnectionIniSectionUID sUID
11717>>>>>>>            End
11717>>>>>>>>
11717>>>>>>>            Else Begin
11718>>>>>>>                Send DeleteKey of hoIni sSection C_ConnectionIniSectionUID
11719>>>>>>>            End
11719>>>>>>>>
11719>>>>>>>            
11719>>>>>>>            If (not(bTrusted) and sUID<>"" and sPWDEncrypted<>"") Begin
11721>>>>>>>                Send WriteString of hoIni sSection C_ConnectionIniSectionPWD sPWDEncrypted
11722>>>>>>>            End
11722>>>>>>>>
11722>>>>>>>            Else Begin
11723>>>>>>>                Send DeleteKey of hoIni sSection C_ConnectionIniSectionPWD
11724>>>>>>>            End
11724>>>>>>>>
11724>>>>>>>            
11724>>>>>>>            If (bTrusted) Begin
11726>>>>>>>                Send WriteString of hoIni sSection C_ConnectionIniSectionTrusted "yes"
11727>>>>>>>            End
11727>>>>>>>>
11727>>>>>>>            Else Begin
11728>>>>>>>                Send DeleteKey of hoIni sSection C_ConnectionIniSectionTrusted
11729>>>>>>>            End
11729>>>>>>>>
11729>>>>>>>        End
11729>>>>>>>>
11729>>>>>>>    End_Procedure
11730>>>>>>>    
11730>>>>>>>    // returns a list of connection Ids from the connections.ini file.
11730>>>>>>>    // Driver does not have to be loaded (if not loaded, hoCLI=0)
11730>>>>>>>    // If pbUseConnectionIni is False, this does Nothing
11730>>>>>>>    // and must be augmented to do anything useful
11730>>>>>>>    Function LoadStoredConnections tConnection[] ByRef Connects Returns Boolean
11732>>>>>>>        String sConnectPath sId sConnect sDriver sUID sPWD sSection sDisabled
11732>>>>>>>        String[] Sections
11733>>>>>>>        Handle hoWorkspace hoArray hoIniFile
11733>>>>>>>        Integer i iConns iIndex
11733>>>>>>>        Boolean bUseConnectionIni bOk bTrusted bDisabled
11733>>>>>>>        tConnection ConnNew
11733>>>>>>>        tConnection ConnNew
11733>>>>>>>        
11733>>>>>>>        Get pbUseConnectionIni to bUseConnectionIni
11734>>>>>>>        
11734>>>>>>>        If bUseConnectionIni Begin
11736>>>>>>>            
11736>>>>>>>            Get ConnectionIniFile of ghoConnection to sConnectPath
11737>>>>>>>            If (sConnectPath="" or not(DoesFileExist(sConnectPath))) Begin
11739>>>>>>>                Function_Return True // if file does not exist, that's ok - no connections
11740>>>>>>>            End
11740>>>>>>>>
11740>>>>>>>            
11740>>>>>>>            Get Create (RefClass(cIniFile)) to hoIniFile
11741>>>>>>>            Get Create (RefClass(Array)) to hoArray
11742>>>>>>>            Set psFilename of hoIniFile to sConnectPath
11743>>>>>>>            
11743>>>>>>>            Send ReadSections of hoIniFile hoArray
11744>>>>>>>            
11744>>>>>>>            // create an array of all Connection sections.
11744>>>>>>>            For i from 0 to (Item_Count(hoArray) -1)
11750>>>>>>>>
11750>>>>>>>                Get Value of hoArray i to sSection
11751>>>>>>>                Move (Trim(sSection)) to sSection
11752>>>>>>>                If (Pos(Uppercase(C_ConnectionIniSectionBaseName),Uppercase(sSection))=1) Begin
11754>>>>>>>                    // make sure id is not a duplicate
11754>>>>>>>                    Move sId to ConnNew.sId
11755>>>>>>>                    Move (SearchArray(sSection, Sections, Desktop,RefFunc(DFSTRICMP))) to iIndex
11756>>>>>>>                    If (iIndex<>-1) Begin
11758>>>>>>>                        Send ConfigurationError DFERR_SETUP (SFormat(C_$ConnectionIniDupSection,sConnectPath,sSection))
11759>>>>>>>                        Function_Return False
11760>>>>>>>                    End
11760>>>>>>>>
11760>>>>>>>                    Move (trim(sSection)) to Sections[SizeOfArray(Sections)]
11761>>>>>>>                End
11761>>>>>>>>
11761>>>>>>>            Loop
11762>>>>>>>>
11762>>>>>>>            
11762>>>>>>>            For i from 0 to (SizeOfArray(Sections)-1)
11768>>>>>>>>
11768>>>>>>>                Move Sections[i] to sSection
11769>>>>>>>                
11769>>>>>>>                Get ReadString of hoIniFile sSection C_ConnectionIniSectionId "" to sId
11770>>>>>>>                If (sId="") Begin
11772>>>>>>>                    Send ConfigurationError DFERR_SETUP (SFormat(C_$ConnectionIniBadId,sConnectPath,sSection))
11773>>>>>>>                    Function_Return False
11774>>>>>>>                End
11774>>>>>>>>
11774>>>>>>>                
11774>>>>>>>                Get ReadString of hoIniFile sSection C_ConnectionIniSectionDriver "" to sDriver
11775>>>>>>>                If (sDriver="") Begin
11777>>>>>>>                    Send ConfigurationError DFERR_SETUP (SFormat(C_$ConnectionIniBadDriver,sConnectPath,sSection))
11778>>>>>>>                    Function_Return False
11779>>>>>>>                End
11779>>>>>>>>
11779>>>>>>>                
11779>>>>>>>                Get ReadString of hoIniFile sSection C_ConnectionIniSectionConnection "" to sConnect
11780>>>>>>>                If (sConnect="") Begin
11782>>>>>>>                    Send ConfigurationError DFERR_SETUP (SFormat(C_$ConnectionIniBadConnection,sConnectPath,sSection))
11783>>>>>>>                    Function_Return False
11784>>>>>>>                End
11784>>>>>>>>
11784>>>>>>>                
11784>>>>>>>                Get ReadString of hoIniFile sSection C_ConnectionIniSectionDisabled "" to sDisabled
11785>>>>>>>                Move (Lowercase(sDisabled)="yes") to bDisabled
11786>>>>>>>
11786>>>>>>>                Send OnReadCredentials sSection sId hoIniFile (&sUID) (&sPWD) (&bTrusted)
11787>>>>>>>                
11787>>>>>>>                If (sPWD<>"") Begin
11789>>>>>>>                    Get DecryptPassword sPWD to sPWD
11790>>>>>>>                End
11790>>>>>>>>
11790>>>>>>>                
11790>>>>>>>                Move sSection to Connects[iConns].sSection
11791>>>>>>>                Move sDriver to Connects[iConns].sDriver
11792>>>>>>>                Move sId to Connects[iConns].sId
11793>>>>>>>                Move sConnect to Connects[iConns].sString
11794>>>>>>>                Move bDisabled to Connects[iConns].bDisabled
11795>>>>>>>                Move sPWD to Connects[iConns].sPWD
11796>>>>>>>                Move bTrusted to Connects[iConns].bTrustedConnection
11797>>>>>>>                Move sUID to Connects[iConns].sUID
11798>>>>>>>                Move 0 to Connects[iConns].hTokenProvider
11799>>>>>>>                
11799>>>>>>>                Increment iConns
11800>>>>>>>            Loop
11801>>>>>>>>
11801>>>>>>>            Send Destroy of hoArray
11802>>>>>>>            Send Destroy of hoIniFile
11803>>>>>>>        End
11803>>>>>>>>
11803>>>>>>>        
11803>>>>>>>        Function_Return True
11804>>>>>>>    End_Function
11805>>>>>>>    
11805>>>>>>>    Function DecryptPassword String sPWD Returns String
11807>>>>>>>        Handle hoLoginEncrypt
11807>>>>>>>        Boolean bEncryptPassword
11807>>>>>>>        Get pbEncryptPassword to bEncryptPassword
11808>>>>>>>        If (bEncryptPassword) Begin
11810>>>>>>>            Move ghoLoginEncryption to hoLoginEncrypt
11811>>>>>>>            // if not registered an error will occur - programming error
11811>>>>>>>            Get DecryptPassword of hoLoginEncrypt sPWD to sPWD
11812>>>>>>>        End
11812>>>>>>>>
11812>>>>>>>        Function_Return sPWD
11813>>>>>>>    End_Function
11814>>>>>>>    
11814>>>>>>>    Function EncryptPassword String sPWD Returns String
11816>>>>>>>        Handle hoLoginEncrypt
11816>>>>>>>        Boolean bEncryptPassword
11816>>>>>>>        Get pbEncryptPassword to bEncryptPassword
11817>>>>>>>        If (bEncryptPassword) Begin
11819>>>>>>>            Move ghoLoginEncryption to hoLoginEncrypt
11820>>>>>>>            // if not registered an error will occur - programming error
11820>>>>>>>            Get EncryptPassword of hoLoginEncrypt sPWD to sPWD
11821>>>>>>>        End
11821>>>>>>>>
11821>>>>>>>        Function_Return sPWD
11822>>>>>>>    End_Function
11823>>>>>>>    
11823>>>>>>>    // assembles connect string based on connect string, user id, password and trusted connection
11823>>>>>>>    // If connect string already contains user id, etc. it is still appended which is consistent
11823>>>>>>>    // with odbc connection strings. The last one wins.
11823>>>>>>>    // sConnect should contain the SERVER= or DSN= information.
11823>>>>>>>    Function AssembleConnectionString String sConnect String sUID String sPWD Boolean bTrusted Returns String
11825>>>>>>>        String sConnectString
11825>>>>>>>        String sConnectionAppName
11825>>>>>>>        
11825>>>>>>>        Move sConnect to sConnectString
11826>>>>>>>        If (bTrusted) Begin
11828>>>>>>>            Move (sConnectString+";trusted_connection=yes") to sConnectString
11829>>>>>>>        End
11829>>>>>>>>
11829>>>>>>>        Else Begin
11830>>>>>>>            If (sUID<>"") Begin
11832>>>>>>>                Move (sConnectString+";UID="+sUID) to sConnectString
11833>>>>>>>            End
11833>>>>>>>>
11833>>>>>>>            If (sPWD<>"") Begin
11835>>>>>>>                Move (sConnectString+";PWD="+sPWD) to sConnectString
11836>>>>>>>            End
11836>>>>>>>>
11836>>>>>>>        End
11836>>>>>>>>
11836>>>>>>>        
11836>>>>>>>        Function_Return sConnectString
11837>>>>>>>    End_Function
11838>>>>>>>
11838>>>>>>>    Procedure AddAppNameToConnectString String sDriver String ByRef sConnectString
11840>>>>>>>        
11840>>>>>>>        String sConnectionAppName
11840>>>>>>>        Integer iAPPpos iNameAppEnd
11840>>>>>>>        String sEndConnString
11840>>>>>>>        String  sAppKeyword
11840>>>>>>>        
11840>>>>>>>        If (Uppercase(sDriver) = "MSSQLDRV") Begin
11842>>>>>>>            Move "APP=" to sAppKeyword
11843>>>>>>>        End
11843>>>>>>>>
11843>>>>>>>        Else Begin
11844>>>>>>>            If (Uppercase(sDriver) = "DB2_DRV") Begin
11846>>>>>>>                Move "PROGRAMNAME=" to sAppKeyword
11847>>>>>>>            End
11847>>>>>>>>
11847>>>>>>>        End
11847>>>>>>>>
11847>>>>>>>        If (sAppKeyword <> "") Begin
11849>>>>>>>            // add the application name 
11849>>>>>>>            Get psConnectionAppName to sConnectionAppName
11850>>>>>>>            If (sConnectionAppName = "") Begin
11852>>>>>>>                If (ghoApplication <> 0) Begin
11854>>>>>>>                    Get GetApplicationName of ghoApplication to sConnectionAppName
11855>>>>>>>                End
11855>>>>>>>>
11855>>>>>>>            End
11855>>>>>>>>
11855>>>>>>>            If (sConnectionAppName <> "") Begin
11857>>>>>>>                // make sure there's no APP already in the string
11857>>>>>>>                Move (Pos(sAppKeyword, Uppercase(sConnectString))) to iAPPpos
11858>>>>>>>                If (iAPPpos = 0) Begin
11860>>>>>>>                    Move (sConnectString+(If(sConnectString<>"",";",""))+sAppKeyword+sConnectionAppName) to sConnectString  
11861>>>>>>>                End 
11861>>>>>>>>
11861>>>>>>>                Else Begin
11862>>>>>>>                    // update AppName in connection string
11862>>>>>>>                    Move "" to sEndConnString 
11863>>>>>>>                    Move (Pos(";", sConnectString, iAPPpos + (Length(sAppKeyword)))) to iNameAppEnd
11864>>>>>>>                    If (iNameAppEnd > 0) Begin
11866>>>>>>>                        Move (Right(sConnectString, (Length(sConnectString) - iNameAppEnd) + 1)) to sEndConnString
11867>>>>>>>                    End
11867>>>>>>>>
11867>>>>>>>                    Move ((Left(sConnectString, iAPPpos + (Length(sAppKeyword) - 1))+sConnectionAppName)+ sEndConnString) to sConnectString
11868>>>>>>>                End
11868>>>>>>>>
11868>>>>>>>                    
11868>>>>>>>            End
11868>>>>>>>>
11868>>>>>>>        End
11868>>>>>>>>
11868>>>>>>>    End_Procedure
11869>>>>>>>    
11869>>>>>>>    Function AddConnectionToDriverCLI Handle hoCLI tConnection Connection Returns Integer
11871>>>>>>>        Integer iResult iIndex
11871>>>>>>>        Get ConnectionIdIndex Connection.sId to iIndex
11872>>>>>>>        If (iIndex<>-1) Begin
11874>>>>>>>            Send ConfigurationError DFERR_SETUP (SFormat(C_$ConnectionIdAlreadyExists,Connection.sId))
11875>>>>>>>            Function_Return 1
11876>>>>>>>        End
11876>>>>>>>>
11876>>>>>>>        Get CreateConnectionID of hoCLI Connection.sId Connection.sConnectionString Connection.iOptions to iResult
11877>>>>>>>        If (iResult=0) Begin
11879>>>>>>>            Get AddToConnections Connection to iIndex
11880>>>>>>>        End
11880>>>>>>>>
11880>>>>>>>        Function_Return iResult
11881>>>>>>>    End_Function
11882>>>>>>>    
11882>>>>>>>    
11882>>>>>>>    // adds a connection id for this driver.
11882>>>>>>>    // passes server string, user id, password and trusted connection info. The
11882>>>>>>>    // server string that gets added will combine all of these. The password
11882>>>>>>>    // may require decoding by calling decode password.
11882>>>>>>>    Function AddConnection String sDriver String sId String sString String sUID String sPWD Boolean bTrusted String sSection Returns Integer
11884>>>>>>>        Handle hoCLI
11884>>>>>>>        Integer iResult
11884>>>>>>>        tConnection Connection
11884>>>>>>>        tConnection Connection
11884>>>>>>>        String sConnectString
11884>>>>>>>        Get RegisterDriver sDriver to hoCLI
11885>>>>>>>        If (hoCLI=0) Begin
11887>>>>>>>            // will have raised an error
11887>>>>>>>            Function_Return False
11888>>>>>>>        End
11888>>>>>>>>
11888>>>>>>>        Get DriverIndex sDriver to Connection.iDriverIndex
11889>>>>>>>        Move sDriver to Connection.sDriver
11890>>>>>>>        Get AssembleConnectionString sString sUID sPWD bTrusted to sConnectString
11891>>>>>>>        Send AddAppNameToConnectString sDriver (&sConnectString)
11892>>>>>>>        
11892>>>>>>>        // assemble the connection struct variable.
11892>>>>>>>        Move (Trim(sSection)) to Connection.sSection
11893>>>>>>>        Move (Trim(sId)) to Connection.sId
11894>>>>>>>        Move sString to Connection.sString
11895>>>>>>>        Move sUID to Connection.sUID
11896>>>>>>>        Move sPWD to Connection.sPWD
11897>>>>>>>        Move bTrusted to Connection.bTrustedConnection
11898>>>>>>>        Move True to Connection.iOptions // login always silent.
11899>>>>>>>        Move sConnectString to Connection.sConnectionString
11900>>>>>>>        Send OnAddConnection (&Connection) // further customize connection
11901>>>>>>>        Get AddConnectionToDriverCLI hoCLI Connection to iResult
11902>>>>>>>        Function_Return (iResult=0)
11903>>>>>>>    End_Function
11904>>>>>>>    
11904>>>>>>>    // adds connectionIds for all registered drivers
11904>>>>>>>    // if driver not loaded/registered, do so first
11904>>>>>>>    // If any error occurs, stop process and return false, else true
11904>>>>>>>    Function AddAllConnections Returns Boolean
11906>>>>>>>        tConnection[] Connects
11906>>>>>>>        tConnection[] Connects
11907>>>>>>>        Integer i iResult
11907>>>>>>>        Boolean bOk
11907>>>>>>>        Handle hoCLI
11907>>>>>>>        Get LoadStoredConnections (&Connects) to bOk
11908>>>>>>>        If not bOk Begin
11910>>>>>>>            Function_Return False
11911>>>>>>>        End
11911>>>>>>>>
11911>>>>>>>        
11911>>>>>>>        For i from 0 to (SizeOfArray(Connects)-1)
11917>>>>>>>>
11917>>>>>>>            If (not(Connects[i].bDisabled)) Begin
11919>>>>>>>                Get AddConnection Connects[i].sDriver Connects[i].sId Connects[i].sString Connects[i].sUID Connects[i].sPWD Connects[i].bTrustedConnection Connects[i].sSection to bOK
11920>>>>>>>                If not bOk Begin
11922>>>>>>>                    Function_Return False
11923>>>>>>>                End
11923>>>>>>>>
11923>>>>>>>            End
11923>>>>>>>>
11923>>>>>>>        Loop
11924>>>>>>>>
11924>>>>>>>        Function_Return True
11925>>>>>>>    End_Function
11926>>>>>>>    
11926>>>>>>>    // returns the DF_DATABASE_ID handle for the passed connection
11926>>>>>>>    // should only be called with data obtained from ConnectionIdInfo
11926>>>>>>>    // of ConnectionIds and not LoadStoredConnections
11926>>>>>>>    // If this returns 0, the connection is not logged in
11926>>>>>>>    Function ConnectionDatabaseIdHandle tConnection Conn Returns Handle
11928>>>>>>>        Handle hConnectionHandle
11928>>>>>>>        String sServerString
11928>>>>>>>        Get ConnectionIDServerString Conn.sId to sServerString
11929>>>>>>>        Get ServerDatabaseIdHandle Conn.sDriver Conn.iDriverIndex sServerString to hConnectionHandle
11930>>>>>>>        Function_Return hConnectionHandle
11931>>>>>>>    End_Function
11932>>>>>>>    
11932>>>>>>>    Function ServerDatabaseIdHandle String sDriver Integer iDriver String sServerString Returns Handle
11934>>>>>>>        Integer i
11934>>>>>>>        String[] ServerNames
11935>>>>>>>        Handle hConnectionHandle
11935>>>>>>>        Get DriverServerNames sDriver to ServerNames
11936>>>>>>>        Move (SearchArray(sServerString,ServerNames,Desktop,RefFunc(DFSTRICMP))) to i
11937>>>>>>>        If (i<>-1) Begin
11939>>>>>>>            Get_Attribute DF_DATABASE_ID of iDriver (i+1) to hConnectionHandle
11942>>>>>>>        End
11942>>>>>>>>
11942>>>>>>>        Function_Return hConnectionHandle
11943>>>>>>>    End_Function
11944>>>>>>>    
11944>>>>>>>    // is connection ID logged in. Pass just the id (e.g. ID1)
11944>>>>>>>    // If connection ID is not registered, raise an error
11944>>>>>>>    Function IsConnectionIdLoggedIn String sId Returns Boolean
11946>>>>>>>        tConnection Connect
11946>>>>>>>        tConnection Connect
11946>>>>>>>        Handle hConnectionHandle
11946>>>>>>>        Get ConnectionIdInfo sId to Connect
11947>>>>>>>        Get ConnectionDatabaseIdHandle Connect to hConnectionHandle
11948>>>>>>>        Function_Return (hConnectionHandle<>0)
11949>>>>>>>    End_Function
11950>>>>>>>    
11950>>>>>>>    // logs in to this managed connection via connection id. return 0 if ok
11950>>>>>>>    // If ID not found, raise a program error
11950>>>>>>>    // Login by connect Id - main interface.
11950>>>>>>>    Function LoginConnectionId String sId Returns Integer
11952>>>>>>>        Integer iResult
11952>>>>>>>        Handle hoCli
11952>>>>>>>        Boolean bSkipDup bConnected
11952>>>>>>>        String sDriver sServer sError sDesc
11952>>>>>>>        tConnection Connect
11952>>>>>>>        tConnection Connect
11952>>>>>>>        Get ConnectionIdCLIHandler sId to hoCLI
11953>>>>>>>        
11953>>>>>>>        If hoCli Begin
11955>>>>>>>            Get pbSkipDuplicateLogin to bSkipDup
11956>>>>>>>            If (bSkipDup) Begin
11958>>>>>>>                Get IsConnectionIdLoggedIn sId to bConnected
11959>>>>>>>            End
11959>>>>>>>>
11959>>>>>>>            If not bConnected Begin
11961>>>>>>>                Get LoginConnectIdBase sId False to iResult
11962>>>>>>>                If (iResult) Begin
11964>>>>>>>                    Get psErrorText to sError
11965>>>>>>>                    Get ConnectionIdInfo sId to Connect
11966>>>>>>>                    Move (sDesc + sFormat("Connection Id=%1.\n\n",sId) + sError) to sError
11967>>>>>>>                    Set psErrorText to sError
11968>>>>>>>                End
11968>>>>>>>>
11968>>>>>>>            End
11968>>>>>>>>
11968>>>>>>>        End
11968>>>>>>>>
11968>>>>>>>        Else Begin
11969>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$ConnectionIdNotFound,sId))
11970>>>>>>>>
11970>>>>>>>            Move 1 to iResult
11971>>>>>>>        End
11971>>>>>>>>
11971>>>>>>>        Function_Return iResult
11972>>>>>>>    End_Function
11973>>>>>>>    
11973>>>>>>>    // does unconditional login for connection Id. This
11973>>>>>>>    // can be customized.
11973>>>>>>>    Function LoginConnectIdBase String sId Boolean bSilent Returns Integer
11975>>>>>>>        Integer iError
11975>>>>>>>        Boolean bOk bSkipDialog
11975>>>>>>>        String sConn
11975>>>>>>>        tConnection Connect
11975>>>>>>>        tConnection Connect
11975>>>>>>>        Get ConnectionIdInfo sId to Connect
11976>>>>>>>        Get ConnectionIDServerString Connect.sId to sConn
11977>>>>>>>        // first try a silent login. If it works we are done
11977>>>>>>>        Get BasicLogin Connect.sDriver sConn "" "" to iError
11978>>>>>>>        If (iError=0) Begin
11980>>>>>>>            Function_Return 0
11981>>>>>>>        End
11981>>>>>>>>
11981>>>>>>>        
11981>>>>>>>        // if login failed because of incorrect client, skip the login dialog.
11981>>>>>>>        // This is the first place this version test occurs.
11981>>>>>>>        If (iError=CLIERR_NOCLIENTSERVERVERSIONMATCH or iError=CLIERR_MINIMUMCLIENTVERSIONNOTFOUND) Begin
11983>>>>>>>            Function_Return 1
11984>>>>>>>        End
11984>>>>>>>>
11984>>>>>>>        
11984>>>>>>>        // if we have a compliant login dialog, try that
11984>>>>>>>        If (not(bSilent)) Begin
11986>>>>>>>            Get ConnectionIdInfo sId to Connect // Refresh!
11987>>>>>>>            If (Connect.hTokenProvider <> 0) Begin 
11989>>>>>>>                Get pbSQLTokenLogin of Connect.hTokenProvider to bSilent
11990>>>>>>>            End
11990>>>>>>>>
11990>>>>>>>        End
11990>>>>>>>>
11990>>>>>>>        
11990>>>>>>>        If (not(bSilent)) Begin
11992>>>>>>>            Get LoginConnectIdDialog Connect.sId to bOk
11993>>>>>>>        End
11993>>>>>>>>
11993>>>>>>>        Function_Return (If(bOk,0,1))
11994>>>>>>>    End_Function
11995>>>>>>>    
11995>>>>>>>    
11995>>>>>>>    Function LoginConnectIdDialog String sId Returns Boolean
11997>>>>>>>        Handle hoLoginConnectDialog bLoginDialogRequired
11997>>>>>>>        Boolean bOk
11997>>>>>>>        
11997>>>>>>>// web applications don't use an embedded database login
11997>>>>>>>        
11997>>>>>>>        Function_Return bOk
11998>>>>>>>    End_Function
11999>>>>>>>    
11999>>>>>>>    // changes Connect string based on passed credentials
11999>>>>>>>    // Updates the driver's map of connect Id/Connect strings.
11999>>>>>>>    // If there is no change in the connection string, this does nothing.
11999>>>>>>>    // This will log out and disconnect from the existing connection and connect (but
11999>>>>>>>    // not login) to the new one.
11999>>>>>>>    // The Id must exist or errors
11999>>>>>>>    Function ChangeConnectIdCredentials String sId String sUser String sPwd Boolean bTrust Returns tConnection
12001>>>>>>>        tConnection Connect
12001>>>>>>>        tConnection Connect
12001>>>>>>>        Integer iError
12001>>>>>>>        String sConnStr
12001>>>>>>>        Get ConnectionIdInfo sId to Connect
12002>>>>>>>        Get AssembleConnectionString Connect.sString sUser sPwd bTrust to Connect.sConnectionString
12003>>>>>>>        If (Connect.sConnectionString<>sConnStr) Begin
12005>>>>>>>            Send LogoutConnectionId Connect.sId
12006>>>>>>>            Send DeleteConnectionId Connect.sId
12007>>>>>>>            
12007>>>>>>>            Move bTrust to Connect.bTrustedConnection
12008>>>>>>>            Move (If(bTrust,"",sUser))  to Connect.sUID
12009>>>>>>>            Move (If(bTrust,"",sPwd)) to Connect.sPWD
12010>>>>>>>            
12010>>>>>>>            Get AddConnection Connect.sDriver Connect.sId Connect.sString Connect.sUID Connect.sPWD Connect.bTrustedConnection Connect.sSection to iError
12011>>>>>>>        End
12011>>>>>>>>
12011>>>>>>>        Function_Return Connect
12012>>>>>>>    End_Function
12013>>>>>>>    
12013>>>>>>>    // attempts connection Id login using ID with passed credentials.
12013>>>>>>>    // These credentials will update the driver's map of connect Id/Connect strings.
12013>>>>>>>    // The Id must exist or errors
12013>>>>>>>    Function LoginConnectIdNewCredentials String sId String sUser String sPwd Boolean bTrust Returns Integer
12015>>>>>>>        Integer iError
12015>>>>>>>        tConnection Connect
12015>>>>>>>        tConnection Connect
12015>>>>>>>        Get ChangeConnectIdCredentials sId sUser sPwd bTrust to Connect
12016>>>>>>>        Get LoginConnectIdBase sId True to iError // silent
12017>>>>>>>        Function_Return iError
12018>>>>>>>    End_Function
12019>>>>>>>    
12019>>>>>>>    // stores credentials for Id. By default store in connections INI file, if used.
12019>>>>>>>    // Can be augmented or overridden
12019>>>>>>>    Function StoreConnectionIdCredentials String sId String sUID String sPWD Boolean bTrusted Returns Boolean
12021>>>>>>>        String sConnectPath
12021>>>>>>>        Handle hoIniFile
12021>>>>>>>        Boolean bUseConnectionIni
12021>>>>>>>        tConnection Connect
12021>>>>>>>        tConnection Connect
12021>>>>>>>        
12021>>>>>>>        Get pbUseConnectionIni to bUseConnectionIni
12022>>>>>>>        
12022>>>>>>>        If bUseConnectionIni Begin
12024>>>>>>>            
12024>>>>>>>            Get ConnectionIniFile to sConnectPath
12025>>>>>>>            If (sConnectPath="" or not(DoesFileExist(sConnectPath))) Begin
12027>>>>>>>                Function_Return True // empty is ok
12028>>>>>>>            End
12028>>>>>>>>
12028>>>>>>>            
12028>>>>>>>            Get ConnectionIdInfo sId to Connect
12029>>>>>>>            Get Create (RefClass(cIniFile)) to hoIniFile
12030>>>>>>>            Set psFilename of hoIniFile to sConnectPath
12031>>>>>>>            
12031>>>>>>>            If (sPWD<>"") Begin
12033>>>>>>>                Get EncryptPassword sPWD to sPWD
12034>>>>>>>            End
12034>>>>>>>>
12034>>>>>>>            
12034>>>>>>>            Send OnWriteCredentials Connect.sSection sId hoIniFile sUid sPWD bTrusted
12035>>>>>>>            
12035>>>>>>>            Send Destroy of hoIniFile
12036>>>>>>>        End
12036>>>>>>>>
12036>>>>>>>        Function_Return True
12037>>>>>>>    End_Function
12038>>>>>>>    
12038>>>>>>>    // logs out of this managed connection id. If Id does not exist, do nothing
12038>>>>>>>    // note that logging out closes all tables for this connection
12038>>>>>>>    Procedure LogoutConnectionId String sId
12040>>>>>>>        Handle hoCli
12040>>>>>>>        String sDriver sServer
12040>>>>>>>        Get ConnectionIdCLIHandler sId to hoCLI
12041>>>>>>>        If hoCLI Begin
12043>>>>>>>            Get psDriverID of hoCli to sDriver
12044>>>>>>>            Get ConnectionIDServerString sId to sServer
12045>>>>>>>            Logout sDriver sServer
12046>>>>>>>        End
12046>>>>>>>>
12046>>>>>>>    End_Procedure
12047>>>>>>>    
12047>>>>>>>    // deletes this managed connection id. If Id does not exist, do nothing
12047>>>>>>>    // if logged in raise a programming error.
12047>>>>>>>    Procedure DeleteConnectionId String sId
12049>>>>>>>        Handle hoCli
12049>>>>>>>        Integer iResult
12049>>>>>>>        Boolean bOk bLoggedIn
12049>>>>>>>        Get ConnectionIdCLIHandler sId to hoCli
12050>>>>>>>        If hoCLI Begin
12052>>>>>>>            // if the connection is logged in, this is an error. Precede this call with
12052>>>>>>>            // LogoutConnectionId. This is not done automatically so it is clear to the
12052>>>>>>>            // developer that they are logging out of existing connections, which closes
12052>>>>>>>            // open tables.
12052>>>>>>>            Get IsConnectionIdLoggedIn sId to bLoggedIn
12053>>>>>>>            If bLoggedIn Begin
12055>>>>>>>                Error DFERR_PROGRAM (SFormat("Connection ID '%1' is still logged-in and cannot be deleted",sId))
12056>>>>>>>>
12056>>>>>>>                Procedure_Return
12057>>>>>>>            End
12057>>>>>>>>
12057>>>>>>>            Get DeleteConnectionID of hoCli sId -1 to iResult
12058>>>>>>>            Get RemoveFromConnections sId to bOk
12059>>>>>>>        End
12059>>>>>>>>
12059>>>>>>>    End_Procedure
12060>>>>>>>    
12060>>>>>>>    
12060>>>>>>>    // logs in to all managed connection Ids for all drivers
12060>>>>>>>    // if error return false on first failure
12060>>>>>>>    Function LoginAllConnections Returns Boolean
12062>>>>>>>        tConnection[] ConnIds
12062>>>>>>>        tConnection[] ConnIds
12063>>>>>>>        Integer i iResult
12063>>>>>>>        Get ConnectionIDs to ConnIds
12064>>>>>>>        For i from 0 to (SizeOfArray(ConnIds)-1)
12070>>>>>>>>
12070>>>>>>>            Get LoginConnectionId ConnIds[i].sId to iResult
12071>>>>>>>            If (iResult) Begin
12073>>>>>>>                Function_Return False
12074>>>>>>>            End
12074>>>>>>>>
12074>>>>>>>        Loop
12075>>>>>>>>
12075>>>>>>>        Function_Return True
12076>>>>>>>    End_Function
12077>>>>>>>    
12077>>>>>>>    // logs out of all managed connections for all drivers
12077>>>>>>>    Procedure LogoutAllConnections
12079>>>>>>>        tConnection[] ConnIds
12079>>>>>>>        tConnection[] ConnIds
12080>>>>>>>        Integer i
12080>>>>>>>        Get ConnectionIDs to ConnIds
12081>>>>>>>        For i from 0 to (SizeOfArray(ConnIds)-1)
12087>>>>>>>>
12087>>>>>>>            Send LogoutConnectionId ConnIds[i].sId
12088>>>>>>>        Loop
12089>>>>>>>>
12089>>>>>>>    End_Procedure
12090>>>>>>>    
12090>>>>>>>    // "unregisters" all managed connections for all drivers
12090>>>>>>>    // Logs out and then delete the connection. Note there is no DeleteAllConnections
12090>>>>>>>    // because you will always want to logout and delete in a single step.
12090>>>>>>>    Procedure UnRegisterAllConnections
12092>>>>>>>        tConnection[] ConnIds
12092>>>>>>>        tConnection[] ConnIds
12093>>>>>>>        Integer i
12093>>>>>>>        Get ConnectionIDs to ConnIds
12094>>>>>>>        For i from 0 to (SizeOfArray(ConnIds)-1)
12100>>>>>>>>
12100>>>>>>>            Send LogoutConnectionId ConnIds[i].sId
12101>>>>>>>            Send DeleteConnectionId ConnIds[i].sId
12102>>>>>>>        Loop
12103>>>>>>>>
12103>>>>>>>    End_Procedure
12104>>>>>>>    
12104>>>>>>>    // you can redefine a connection-string for a logged in server and all open tables will get
12104>>>>>>>    // redirected to the new connection. You can choose to leave the old connection open so if you switch back
12104>>>>>>>    // it can be done quickly.
12104>>>>>>>    // This assumes that two servers contain the same tables with the same definitions. If they don't things
12104>>>>>>>    // will not work. It is the developer's responsibility to make sure this is the case.
12104>>>>>>>    // Use with care.
12104>>>>>>>    Function RedirectConnectionId String sId String sServer String sUID String sPWD Boolean bTrusted Boolean bKeepOpen Returns Boolean
12106>>>>>>>        Handle hoCli
12106>>>>>>>        Integer iIndex iRet
12106>>>>>>>        tConnection[] Connections
12106>>>>>>>        tConnection[] Connections
12107>>>>>>>        tConnection Connection
12107>>>>>>>        tConnection Connection
12107>>>>>>>        String sConnectString
12107>>>>>>>        
12107>>>>>>>        Get ConnectionIdIndex sId to iIndex
12108>>>>>>>        If (iIndex=-1) Begin
12110>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$ConnectionIdNotFound,sId))
12111>>>>>>>>
12111>>>>>>>            Function_Return 1
12112>>>>>>>        End
12112>>>>>>>>
12112>>>>>>>        
12112>>>>>>>        Get ConnectionIdCLIHandler sId to hoCli
12113>>>>>>>        Get pConnections to Connections
12114>>>>>>>        Move Connections[iIndex] to Connection
12115>>>>>>>        
12115>>>>>>>        Get AssembleConnectionString sServer sUID sPWD bTrusted to sConnectString
12116>>>>>>>        Send AddAppNameToConnectString Connection.sDriver (&sConnectString)
12117>>>>>>>        Move sServer to Connection.sString
12118>>>>>>>        Move sUID to Connection.sUID
12119>>>>>>>        Move sPWD to Connection.sPWD
12120>>>>>>>        Move bTrusted to Connection.bTrustedConnection
12121>>>>>>>        Move sConnectString to Connection.sConnectionString
12122>>>>>>>        Get ConnectionIDServerString sId to sId
12123>>>>>>>        
12123>>>>>>>        Send TrapErrors
12124>>>>>>>        Get RedirectIdConnectString of hoCli sId sConnectString bKeepOpen to iRet
12125>>>>>>>        Send UnTrapErrors
12126>>>>>>>        // if 1, we have the ID but it must not be not logged-in. We can still
12126>>>>>>>        // switch to the non-logged in connection
12126>>>>>>>        If (iRet=0 or iRet=1) Begin
12128>>>>>>>            // if all is ok, update the connection info
12128>>>>>>>            Move Connection to Connections[iIndex]
12129>>>>>>>            Set pConnections to Connections
12130>>>>>>>            Move 0 to iRet
12131>>>>>>>            Set piErrorNumber to 0
12132>>>>>>>        End
12132>>>>>>>>
12132>>>>>>>        Function_Return (iRet=0)
12133>>>>>>>    End_Function
12134>>>>>>>    
12134>>>>>>>    // this gets sent when a mangaged driver is registerd (it might already be loaded).
12134>>>>>>>    // Can be used to set CLI driver settings like use-cache etc.
12134>>>>>>>    Procedure OnDriverRegistered String sDriver Integer iDriver Handle hoCLIHandler
12136>>>>>>>    End_Procedure
12137>>>>>>>    
12137>>>>>>>    
12137>>>>>>>    // this can be used to do whatever you want to the various connection
12137>>>>>>>    // info. You might use this to handle your own default UID/PWD enoding logic
12137>>>>>>>    // etc.
12137>>>>>>>    Procedure OnAddConnection tConnection ByRef Connection
12139>>>>>>>    End_Procedure
12140>>>>>>>    
12140>>>>>>>    Function WriteConnectionsIniString Handle hoIniFile String sSection String sKey String sValue Returns Integer
12142>>>>>>>        Integer iErrorNumber
12142>>>>>>>        Send TrapErrors
12143>>>>>>>        Send WriteString of hoIniFile sSection sKey sValue
12144>>>>>>>        Send UnTrapErrors
12145>>>>>>>        Get piErrorNumber to iErrorNumber
12146>>>>>>>        Function_Return iErrorNumber
12147>>>>>>>    End_Function
12148>>>>>>>    
12148>>>>>>>    // updates the connections ini file with passed Ids. Note that the section name
12148>>>>>>>    // for each ID is not the name that will be written. It exists if this was the
12148>>>>>>>    // initial section name.
12148>>>>>>>    Function WriteConnectionsIni String sQFile tConnection[] Ids Returns Boolean
12150>>>>>>>        Integer i iErrorNumber iIndex iSec iSections
12150>>>>>>>        String  sDriver sValue sPWD sSection
12150>>>>>>>        Handle hoIniFile hoArray hoSection
12150>>>>>>>        Boolean bOk bExists
12150>>>>>>>        String[] Keys Values
12152>>>>>>>        tConnectionIniSection[] Sections
12152>>>>>>>        tConnectionIniSection[] Sections
12153>>>>>>>        tConnectionIniSection SectionTarget
12153>>>>>>>        tConnectionIniSection SectionTarget
12153>>>>>>>        
12153>>>>>>>        // if filename not passed, use the default
12153>>>>>>>        If (sQFile="") Begin
12155>>>>>>>            Get ConnectionIniFile of ghoConnection to sQFile
12156>>>>>>>        End
12156>>>>>>>>
12156>>>>>>>        
12156>>>>>>>        Get Create (RefClass(cIniFile)) to hoIniFile
12157>>>>>>>        Get Create (RefClass(Array)) to hoArray
12158>>>>>>>        Get Create (RefClass(Array)) to hoSection
12159>>>>>>>        Set psFilename of hoIniFile to sQFile
12160>>>>>>>        
12160>>>>>>>        // first save off all info from an existing section name. This section may get
12160>>>>>>>        // renamed but we want to write it out later under that new section name. Hence
12160>>>>>>>        // we must store all values.
12160>>>>>>>        For i from 0 to (SizeOfArray(Ids)-1)
12166>>>>>>>>
12166>>>>>>>            If (Ids[i].sSection<>"") Begin
12168>>>>>>>                Get SectionExists of hoIniFile Ids[i].sSection to bExists
12169>>>>>>>                If bExists Begin
12171>>>>>>>                    Move (Lowercase(Ids[i].sSection)) to sSection
12172>>>>>>>                    Move sSection to Sections[iSections].sSection
12173>>>>>>>                    Send Delete_Data of hoSection
12174>>>>>>>                    Send ReadSection of hoIniFile sSection hoSection
12175>>>>>>>                    For iSec from 0 to (Item_Count(hoSection)-1)
12181>>>>>>>>
12181>>>>>>>                        Get Value of hoSection iSec to Sections[iSections].Keys[iSec]
12182>>>>>>>                        Get ReadString of hoIniFile sSection Sections[iSections].Keys[iSec] "" to Sections[iSections].Values[iSec]
12183>>>>>>>                    Loop
12184>>>>>>>>
12184>>>>>>>                    Increment iSections
12185>>>>>>>                End
12185>>>>>>>>
12185>>>>>>>            End
12185>>>>>>>>
12185>>>>>>>        Loop
12186>>>>>>>>
12186>>>>>>>        
12186>>>>>>>        // now remove all existing connection sections
12186>>>>>>>        Send ReadSections of hoIniFile hoArray
12187>>>>>>>        For i from 0 to (Item_Count(hoArray) -1)
12193>>>>>>>>
12193>>>>>>>            Get Value of hoArray i to sSection
12194>>>>>>>            Move (Trim(sSection)) to sSection
12195>>>>>>>            If (Pos(Uppercase(C_ConnectionIniSectionBaseName),Uppercase(sSection))=1) Begin
12197>>>>>>>                Send DeleteSection of hoIniFile sSection
12198>>>>>>>            End
12198>>>>>>>>
12198>>>>>>>            If (iErrorNumber<>0) ;                Break
12201>>>>>>>        Loop
12202>>>>>>>>
12202>>>>>>>        
12202>>>>>>>        // now write the new connections, with each connection renamed.
12202>>>>>>>        For i from 0 to (SizeOfArray(Ids)-1)
12208>>>>>>>>
12208>>>>>>>            Move (C_ConnectionIniSectionBaseName+String(i+1)) to sSection
12209>>>>>>>            
12209>>>>>>>            // if the section already existed, write all existing data back under what
12209>>>>>>>            // might be a new section name. Some of this may get overridden below
12209>>>>>>>            Move (Lowercase(Ids[i].sSection)) to SectionTarget.sSection
12210>>>>>>>            Move (SearchArray(SectionTarget,Sections)) to iIndex
12211>>>>>>>            If (iIndex<>-1) Begin
12213>>>>>>>                For iSec from 0 to (SizeOfArray(Sections[iIndex].Keys)-1)
12219>>>>>>>>
12219>>>>>>>                    Get WriteConnectionsIniString hoIniFile sSection Sections[iIndex].Keys[iSec] Sections[iIndex].Values[iSec] to iErrorNumber
12220>>>>>>>                    If iErrorNumber ;                        Break
12223>>>>>>>                Loop
12224>>>>>>>>
12224>>>>>>>            End
12224>>>>>>>>
12224>>>>>>>            If iErrorNumber ;                Break
12227>>>>>>>            
12227>>>>>>>            // now write / overwrite new data
12227>>>>>>>            Get WriteConnectionsIniString hoIniFile sSection C_ConnectionIniSectionId Ids[i].sId to iErrorNumber
12228>>>>>>>            If iErrorNumber ;                Break
12231>>>>>>>            Get WriteConnectionsIniString hoIniFile sSection C_ConnectionIniSectionDriver Ids[i].sDriver to iErrorNumber
12232>>>>>>>            If iErrorNumber ;                Break
12235>>>>>>>            Get WriteConnectionsIniString hoIniFile sSection C_ConnectionIniSectionConnection Ids[i].sString to iErrorNumber
12236>>>>>>>            If iErrorNumber ;                Break
12239>>>>>>>
12239>>>>>>>            If (Ids[i].bDisabled) Begin
12241>>>>>>>                Get WriteConnectionsIniString hoIniFile sSection C_ConnectionIniSectionDisabled "yes" to iErrorNumber
12242>>>>>>>            End
12242>>>>>>>>
12242>>>>>>>            Else Begin
12243>>>>>>>                Send DeleteKey of hoIniFile sSection C_ConnectionIniSectionDisabled
12244>>>>>>>            End
12244>>>>>>>>
12244>>>>>>>            If iErrorNumber ;                Break
12247>>>>>>>
12247>>>>>>>            Move Ids[i].sPWD to sPWD
12248>>>>>>>            If (sPWD<>"") Begin
12250>>>>>>>                Get EncryptPassword sPWD to sPWD
12251>>>>>>>            End
12251>>>>>>>>
12251>>>>>>>            
12251>>>>>>>            Send OnWriteCredentials sSection Ids[i].sId hoIniFile Ids[i].sUID sPWD Ids[i].bTrustedConnection
12252>>>>>>>        Loop
12253>>>>>>>>
12253>>>>>>>        
12253>>>>>>>        Send Destroy of hoSection
12254>>>>>>>        Send Destroy of hoArray
12255>>>>>>>        Send Destroy of hoIniFile
12256>>>>>>>        Function_Return (iErrorNumber=0)
12257>>>>>>>    End_Function
12258>>>>>>>    
12258>>>>>>>    // creates an SQL Connection handler for SQL usage. It is up to you to destroy this
12258>>>>>>>    // by default it creates a cSQLConnection object. This can be augmented to create use
12258>>>>>>>    // a different class
12258>>>>>>>    Function CreateESQLConnectionHandler Returns Handle
12260>>>>>>>        Handle hoSQLConnection
12260>>>>>>>        Get CreateNamed (RefClass(cSQLConnection)) "oSQLConnectionHandler" to hoSQLConnection
12261>>>>>>>        Function_Return hoSQLConnection
12262>>>>>>>    End_Function
12263>>>>>>>    
12263>>>>>>>    // gets a new ESQL connection handle for this connection Id.
12263>>>>>>>    // Programmer must destroy this handle when done
12263>>>>>>>    // Id must exist. Programming error if it does not
12263>>>>>>>    Function SQLConnectionId String sId Returns Handle
12265>>>>>>>        Handle hoSQLConnection hoCLI
12265>>>>>>>        Integer bOK
12265>>>>>>>        String sDrvrID sServer
12265>>>>>>>        
12265>>>>>>>        Get ConnectionIdCLIHandler sId to hoCLI
12266>>>>>>>        If hoCLI Begin
12268>>>>>>>            Get ConnectionIDServerString sId to sServer
12269>>>>>>>            Get psDriverID of hoCLI to sDrvrId
12270>>>>>>>            Get CreateESQLConnectionHandler to hoSQLConnection
12271>>>>>>>            
12271>>>>>>>            // force it to use existing connection
12271>>>>>>>            Get SQLConnectionConnect of hoSQLConnection sDrvrID sServer to bOK
12272>>>>>>>            
12272>>>>>>>            If (not(bOK)) Begin
12274>>>>>>>                Send DestroySQLConnection of hoSQLConnection
12275>>>>>>>                Move 0 to hoSQLConnection
12276>>>>>>>            End
12276>>>>>>>>
12276>>>>>>>        End
12276>>>>>>>>
12276>>>>>>>        Else Begin
12277>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$ConnectionIdNotFound,sId))
12278>>>>>>>>
12278>>>>>>>        End
12278>>>>>>>>
12278>>>>>>>        Function_Return hoSQLConnection
12279>>>>>>>    End_Function
12280>>>>>>>    
12280>>>>>>>    // these are interfaces that do not require connection Ids. You can pass a
12280>>>>>>>    // driver and a server connect string. Generally there are ID versions of these
12280>>>>>>>    // that should be used when possible.
12280>>>>>>>    
12280>>>>>>>    // is this connection to a server logged in. Pass driver and connect string
12280>>>>>>>    // connect string should be INT style. Either full string or DFCONNID=xx
12280>>>>>>>    // if driver not loaded, raise an error
12280>>>>>>>    Function IsDriverConnectionLoggedIn String sDriver String sConnect Returns Boolean
12282>>>>>>>        Handle hConnectionHandle hoCLI
12282>>>>>>>        Integer iDriver
12282>>>>>>>        Get DriverCLIHandler sDriver to hoCLI
12283>>>>>>>        If (hoCLI) Begin
12285>>>>>>>            Get DriverIndex sDriver to iDriver
12286>>>>>>>            Get ServerDatabaseIdHandle sDriver iDriver sConnect to hConnectionHandle
12287>>>>>>>        End
12287>>>>>>>>
12287>>>>>>>        Else Begin
12288>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$DriverNotFound,sDriver))
12289>>>>>>>>
12289>>>>>>>        End
12289>>>>>>>>
12289>>>>>>>        Function_Return (hConnectionHandle<>0)
12290>>>>>>>    End_Function
12291>>>>>>>    
12291>>>>>>>    // logs in to this managed connection via driver and connection string.
12291>>>>>>>    // Normally you'd not use this and use LoginConnectionId
12291>>>>>>>    // If pbSkipDuplicateLogin=T it will skip the login if it is already connected
12291>>>>>>>    // If driver not loaded, attempt to load it.
12291>>>>>>>    // If it cannot be loaded, raise a configuration Error
12291>>>>>>>    // This is low level - use carefully
12291>>>>>>>    Function LoginServer String sDriver String sConnectString String sUID String sPWD Boolean bSilent Returns Integer
12293>>>>>>>        Integer iResult iDriver
12293>>>>>>>        Handle hoCli
12293>>>>>>>        Boolean bSkipDup bConnected bOldSilent
12293>>>>>>>        Get RegisterDriver sDriver to hoCLI
12294>>>>>>>        If hoCli Begin
12296>>>>>>>            Get pbSkipDuplicateLogin to bSkipDup
12297>>>>>>>            If (bSkipDup) Begin
12299>>>>>>>                Get IsDriverConnectionLoggedIn sDriver sConnectString to bConnected
12300>>>>>>>            End
12300>>>>>>>>
12300>>>>>>>            If not bConnected Begin
12302>>>>>>>                Get DriverIndex sDriver to iDriver
12303>>>>>>>                // note that passing the server as dfconnid=Id will not recognize bSilent
12303>>>>>>>                Get_Attribute DF_DRIVER_SILENT_LOGIN of iDriver to bOldSilent
12306>>>>>>>                Set_Attribute DF_DRIVER_SILENT_LOGIN of iDriver to bSilent
12309>>>>>>>                Get BasicLogin sDriver sConnectString sUID sPWD to iResult
12310>>>>>>>                Set_Attribute DF_DRIVER_SILENT_LOGIN of iDriver to bOldSilent
12313>>>>>>>            End
12313>>>>>>>>
12313>>>>>>>        End
12313>>>>>>>>
12313>>>>>>>        Else Begin
12314>>>>>>>            // if driver cannot be loaded, an error will be raised in RegisterDriver
12314>>>>>>>            Move 1 to iResult
12315>>>>>>>        End
12315>>>>>>>>
12315>>>>>>>        Function_Return iResult
12316>>>>>>>    End_Function
12317>>>>>>>    
12317>>>>>>>    // can connect using any server connect string for this driver
12317>>>>>>>    // returns new  ESQL connection handler, which the developer must destroy.
12317>>>>>>>    Function SQLConnection String sDriver String sConnect Returns Handle
12319>>>>>>>        Handle hoSQLConnection
12319>>>>>>>        String sDrvrID
12319>>>>>>>        Handle hoCLI
12319>>>>>>>        Boolean bOk
12319>>>>>>>        
12319>>>>>>>        // will raise configuration error if driver cannot be loaded
12319>>>>>>>        Get RegisterDriver sDriver to hoCLI
12320>>>>>>>        If hoCli Begin
12322>>>>>>>            Get CreateESQLConnectionHandler to hoSQLConnection
12323>>>>>>>            
12323>>>>>>>            // force it to use existing connection
12323>>>>>>>            Get SQLConnectionConnect of hoSQLConnection sDriver sConnect to bOK
12324>>>>>>>            
12324>>>>>>>            If (not(bOK)) Begin
12326>>>>>>>                Send DestroySQLConnection of hoSQLConnection
12327>>>>>>>                Move 0 to hoSQLConnection
12328>>>>>>>            End
12328>>>>>>>>
12328>>>>>>>            
12328>>>>>>>        End
12328>>>>>>>>
12328>>>>>>>        Function_Return hoSQLConnection
12329>>>>>>>    End_Function
12330>>>>>>>    
12330>>>>>>>    // gets a new ESQL connection handle for this open table. Programmer must
12330>>>>>>>    // destroy this handle when done
12330>>>>>>>    Function SQLConnectionByTable Handle hoTable Returns Handle
12332>>>>>>>        Handle hoSQLConnection
12332>>>>>>>        Boolean bOk
12332>>>>>>>        
12332>>>>>>>        Get CreateESQLConnectionHandler to hoSQLConnection
12333>>>>>>>        Get SQLFileConnect of hoSQLConnection hoTable to bOk
12334>>>>>>>        If (not(bOK)) Begin
12336>>>>>>>            Send DestroySQLConnection of hoSQLConnection
12337>>>>>>>            Move 0 to hoSQLConnection
12338>>>>>>>        End
12338>>>>>>>>
12338>>>>>>>        
12338>>>>>>>        Function_Return hoSQLConnection
12339>>>>>>>    End_Function
12340>>>>>>>    
12340>>>>>>>    // loads all managed drivers and set up all managed connections. Abort if a failure
12340>>>>>>>    // if you don't want automatic abort, use RegisterAllDrivers and AddAllConnections
12340>>>>>>>    // This should succeed - if not it's a programming error
12340>>>>>>>    Procedure RegisterAllConnections
12342>>>>>>>        Boolean bOk
12342>>>>>>>        Get AddAllConnections to bOk
12343>>>>>>>        If not bOk Begin
12345>>>>>>>            Send UserError "Could not load and register managed drivers. The application cannot be run"
12346>>>>>>>            Abort
12347>>>>>>>>
12347>>>>>>>        End
12347>>>>>>>>
12347>>>>>>>    End_Procedure
12348>>>>>>>    
12348>>>>>>>    // logs in to all managed connections in all managed drivers. Abort if any fail
12348>>>>>>>    // if you don't want automatic abort, use the function LoginAllConnections or
12348>>>>>>>    // LoginConnectionId
12348>>>>>>>    Procedure LoginAll
12350>>>>>>>        Boolean bOk
12350>>>>>>>        Integer iError
12350>>>>>>>        String sError
12350>>>>>>>        Get LoginAllConnections to bOk
12351>>>>>>>        If not bOk Begin
12353>>>>>>>            Get psErrorText to sError
12354>>>>>>>            Get piErrorNumber to iError
12355>>>>>>>            Send UserError (C_$LoginAllFailedWillAbort + "\n\n" + sError)
12356>>>>>>>            Abort
12357>>>>>>>>
12357>>>>>>>        End
12357>>>>>>>>
12357>>>>>>>    End_Procedure
12358>>>>>>>    
12358>>>>>>>    // standard Auto-connect behavior.
12358>>>>>>>    // if pbAutoConnect is T it does a registerAll & LoginAll and aborts if an error occurs
12358>>>>>>>    // if pbAutoConnect is F, it does nothing.
12358>>>>>>>    // Note that RegisterAll and LoginIn don't do anything if managed connections are not used.
12358>>>>>>>    // This is called by cApplication when a workspace is opened.
12358>>>>>>>    Procedure AutoConnect
12360>>>>>>>        Boolean bAutoConnect
12360>>>>>>>        Get pbAutoConnect to bAutoConnect
12361>>>>>>>        If bAutoConnect Begin
12363>>>>>>>            Send RegisterAllConnections // might abort on failure
12364>>>>>>>            Send LoginAll // might abort on failure
12365>>>>>>>        End
12365>>>>>>>>
12365>>>>>>>    End_Procedure
12366>>>>>>>    
12366>>>>>>>    // this is called by cApplication when a workspace is opened.
12366>>>>>>>    Procedure AutoDisconnect
12368>>>>>>>        Boolean bAutoConnect
12368>>>>>>>        Get pbAutoConnect to bAutoConnect
12369>>>>>>>        If bAutoConnect Begin
12371>>>>>>>            Send UnRegisterAllConnections
12372>>>>>>>        End
12372>>>>>>>>
12372>>>>>>>    End_Procedure
12373>>>>>>>    
12373>>>>>>>    // lists the current registered connection ids.
12373>>>>>>>    Procedure EnumerateConnections Handle hoCallBack Handle hmGeneric
12375>>>>>>>        tConnection[] ConnIds
12375>>>>>>>        tConnection[] ConnIds
12376>>>>>>>        Integer i iConnIds
12376>>>>>>>        String sConnectionsIni
12376>>>>>>>        
12376>>>>>>>        Get ConnectionIniFile to sConnectionsIni
12377>>>>>>>        
12377>>>>>>>        Send hmGeneric of hoCallBack C_$ManagedConnections
12378>>>>>>>        Send hmGeneric of hoCallBack (SFormat(C_$ManagedConnectionsIniFile, ConnectionIniFile(Self)))
12379>>>>>>>        
12379>>>>>>>        Get ConnectionIDs to ConnIds
12380>>>>>>>        Move (SizeOfArray(ConnIds)) to iConnIds
12381>>>>>>>        If (iConnIds=0) Begin
12383>>>>>>>            Send hmGeneric of hoCallBack C_$ManagedConnectionsNone
12384>>>>>>>        End
12384>>>>>>>>
12384>>>>>>>        Else Begin
12385>>>>>>>            For i from 0 to (iConnIds-1)
12391>>>>>>>>
12391>>>>>>>                Send hmGeneric of hoCallBack (SFormat(C_$ManagedConnectionsIdLine, ConnIds[i].sId, ConnIds[i].sString, ConnIds[i].sDriver))
12392>>>>>>>            Loop
12393>>>>>>>>
12393>>>>>>>        End
12393>>>>>>>>
12393>>>>>>>    End_Procedure

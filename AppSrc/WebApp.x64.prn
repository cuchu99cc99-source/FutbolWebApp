25999>>>>>>>>>>>    //  Called by the list / grid to determine the field value details based on the current 
25999>>>>>>>>>>>    //  environment values (global buffer or properties). It fills the tWebCell struct that is 
25999>>>>>>>>>>>    //  passed by reference with details needed by the JavaScript Engine to render the cell.
25999>>>>>>>>>>>    Procedure LoadGridCell tWebCell ByRef tCell
26001>>>>>>>>>>>        Integer iFile iField
26001>>>>>>>>>>>        String sValue
26001>>>>>>>>>>>        
26001>>>>>>>>>>>
26001>>>>>>>>>>>        Get Data_File  to iFile
26002>>>>>>>>>>>        Get Data_Field to iField
26003>>>>>>>>>>>        
26003>>>>>>>>>>>        If (iFile <> 0) Begin
26005>>>>>>>>>>>            //  Security check
26005>>>>>>>>>>>            If (FillDEOAllowed(Self)) Begin            
26007>>>>>>>>>>>                // If there is a data binding then get the file.field value....
26007>>>>>>>>>>>                Get_Field_Value iFile iField to sValue
26010>>>>>>>>>>>            End
26010>>>>>>>>>>>>
26010>>>>>>>>>>>        End
26010>>>>>>>>>>>>
26010>>>>>>>>>>>        Else Begin
26011>>>>>>>>>>>            // if there is no data binding then fire the calculated field event....
26011>>>>>>>>>>>            WebGet psValue to sValue
26012>>>>>>>>>>>            Send OnSetCalculatedValue (&sValue)         // calculated value
26013>>>>>>>>>>>        End
26013>>>>>>>>>>>>
26013>>>>>>>>>>>
26013>>>>>>>>>>>        // Convert the value into the correct format for transport....                    
26013>>>>>>>>>>>        Move (Trim(sValue)) to sValue                                            // make sure the value is trimmed
26014>>>>>>>>>>>        Get ConvertToTransport (RefFunc(psValue)) sValue cArgStr  to sValue
26015>>>>>>>>>>>        
26015>>>>>>>>>>>        // Give a chance to add custom tooltips & CSS Classnames
26015>>>>>>>>>>>        Send OnDefineTooltip (&tCell.sTooltip)
26016>>>>>>>>>>>        Send OnDefineCssClass (&tCell.sCssClassName)
26017>>>>>>>>>>>        
26017>>>>>>>>>>>        Move sValue to tCell.sValue
26018>>>>>>>>>>>    End_Procedure

34586>>>>>>>        WebSet psSeedValue to sVal
34587>>>>>>>
34587>>>>>>>        Get pbAutoSeed to iVal
34588>>>>>>>        WebSet pbAutoSeed to iVal
34589>>>>>>>
34589>>>>>>>        Get psPromptUpdateCallback to sVal
34590>>>>>>>        WebSet psPromptUpdateCallback to sVal
34591>>>>>>>    End_Procedure
34592>>>>>>>
34592>>>>>>>    // called before the list is activated. 
34592>>>>>>>    Procedure InitializePromptList
34594>>>>>>>        Handle hoServer hoReadingDD hoInvokingObject hoInvokingServer hoInitialColumn hoUpdateColumn
34594>>>>>>>        Boolean bSeeded bReverseOrdering bDataAware
34594>>>>>>>        Integer iFile iField iOldMode iMainFile eUpdateMode iOrdering
34594>>>>>>>        Integer iUpdateColumn iInitialColumn 
34594>>>>>>>        String sValue sName
34594>>>>>>>        RowID riRowid
34594>>>>>>>        
34594>>>>>>>        Send RestoreDefaults // set back to default state
34595>>>>>>>        
34595>>>>>>>        WebGet peUpdateMode to eUpdateMode
34596>>>>>>>        
34596>>>>>>>        If (eUpdateMode<>umPromptNonInvoking) Begin
34598>>>>>>>            // get and webset the full name of the invoking object
34598>>>>>>>            Get ReturnObject to hoInvokingObject
34599>>>>>>>            Get WebObjectName of hoInvokingObject to sName
34600>>>>>>>            WebSet psInvokingObject to sName  
34601>>>>>>>                      
34601>>>>>>>            If (hoInvokingObject<=Desktop) Begin
34603>>>>>>>                Error DFERR_PROGRAM C_$PromptListHasNoInvokingObject
34604>>>>>>>>
34604>>>>>>>                Procedure_Return
34605>>>>>>>            End
34605>>>>>>>>
34605>>>>>>>
34605>>>>>>>            Send Prompt_Callback to hoInvokingObject Self
34606>>>>>>>            WebGet peUpdateMode to eUpdateMode // this may have changed
34607>>>>>>>        End
34607>>>>>>>>
34607>>>>>>>        Get pbDataAware to bDataAware
34608>>>>>>>        If not bDataAware Begin
34610>>>>>>>            Send InitializePromptListNDA
34611>>>>>>>            Procedure_Return
34612>>>>>>>        End
34612>>>>>>>>
34612>>>>>>>
34612>>>>>>>        Get Server to hoServer
34613>>>>>>>        If (hoServer=0) Begin
34615>>>>>>>            Error DFERR_PROGRAM C_$PromptListHasNoServer
34616>>>>>>>>
34616>>>>>>>            Procedure_Return
34617>>>>>>>        End
34617>>>>>>>>
34617>>>>>>>        
34617>>>>>>>        WebGet piInitialColumn to iInitialColumn
34618>>>>>>>
34618>>>>>>>        If (eUpdateMode=umPromptRelational) Begin
34620>>>>>>>            Get Delegation_Mode of hoInvokingObject to iOldMode
34621>>>>>>>            Set Delegation_Mode of hoInvokingObject to NO_DELEGATE_OR_ERROR
34622>>>>>>>            Get Data_File  of hoInvokingObject Current to iFile
34623>>>>>>>            Get Data_Field of hoInvokingObject Current to iField
34624>>>>>>>            Set Delegation_Mode of hoInvokingObject to iOldMode
34625>>>>>>>            If (iFile) Begin
34627>>>>>>>                Get Server of hoInvokingObject to hoInvokingServer
34628>>>>>>>            End
34628>>>>>>>>
34628>>>>>>>            
34628>>>>>>>            Get Main_File of hoServer to iMainFile
34629>>>>>>>            
34629>>>>>>>            If (not (iFile<>0 and iMainFile=iFile and hoInvokingObject<>0)) Begin
34631>>>>>>>                Send OnRelationalPromptListError
34632>>>>>>>                // get the update mode in case the RelationalPromptListError changes the mode to try another mode
34632>>>>>>>                WebGet peUpdateMode to eUpdateMode
34633>>>>>>>            End
34633>>>>>>>>
34633>>>>>>>        End
34633>>>>>>>>
34633>>>>>>>        
34633>>>>>>>        If (eUpdateMode=umPromptValue) Begin // else not used here intentionally
34635>>>>>>>            WebGet psValue of hoInvokingObject to sValue
34636>>>>>>>            WebSet psSeedValue to sValue
34637>>>>>>>        End
34637>>>>>>>>
34637>>>>>>>        
34637>>>>>>>        // if relational, update column is the "best" else you must specify it
34637>>>>>>>        If (eUpdateMode=umPromptRelational) Begin
34639>>>>>>>            Get SelectBestColumn iFile iField to iUpdateColumn
34640>>>>>>>        End
34640>>>>>>>>
34640>>>>>>>        Else Begin
34641>>>>>>>            WebGet piUpdateColumn to iUpdateColumn
34642>>>>>>>        End
34642>>>>>>>>
34642>>>>>>>        If (iUpdateColumn>=0) Begin
34644>>>>>>>            Get GetColumnObject iUpdateColumn to hoUpdateColumn
34645>>>>>>>        End
34645>>>>>>>>
34645>>>>>>>        
34645>>>>>>>        // We need an initial column. if you specified an initial column that will get used for the start column
34645>>>>>>>        // and the initial sort order. If you did not, which is typical, it will use the update column
34645>>>>>>>        If (iInitialColumn=-1) Begin
34647>>>>>>>            Move iUpdateColumn to iInitialColumn
34648>>>>>>>        End
34648>>>>>>>>
34648>>>>>>>        If (iInitialColumn>=0) Begin
34650>>>>>>>            Get GetColumnObject iInitialColumn to hoInitialColumn
34651>>>>>>>        End
34651>>>>>>>>
34651>>>>>>>        
34651>>>>>>>        // this assigns an ordering and a sort order
34651>>>>>>>        If (hoInitialColumn) Begin
34653>>>>>>>            WebSet piSortColumn to iUpdateColumn
34654>>>>>>>        End
34654>>>>>>>>
34654>>>>>>>        
34654>>>>>>>        // this function seeds the data and a boolean indicating if the buffer was seeded and read
34654>>>>>>>        If (eUpdateMode<>umPromptNonInvoking) Begin 
34656>>>>>>>            Get SeedData hoUpdateColumn hoInitialColumn to bSeeded
34657>>>>>>>        End 
34657>>>>>>>>
34657>>>>>>>
34657>>>>>>>        // if initial and update columns are different we must now reset the ordering
34657>>>>>>>        // to the initial order.
34657>>>>>>>        If (hoInitialColumn and (hoInitialColumn<>hoUpdateColumn)) Begin
34659>>>>>>>            WebSet piSortColumn to iInitialColumn
34660>>>>>>>        End
34660>>>>>>>>
34660>>>>>>>            
34660>>>>>>>        If (not(bSeeded)) Begin
34662>>>>>>>            WebGet pbReverseOrdering to bReverseOrdering
34663>>>>>>>            Get IndexOrder to iOrdering
34664>>>>>>>            Get ReadingServer to hoReadingDD
34665>>>>>>>            Get ReadDDFirstRecord hoReadingDD iOrdering bReverseOrdering to riRowid
34666>>>>>>>            Move (not(IsNullRowID(riRowid))) to bSeeded
34667>>>>>>>        End
34667>>>>>>>>
34667>>>>>>>        
34667>>>>>>>        If (peDbGridType(Self)<>gtManual) Begin
34669>>>>>>>            If bSeeded Begin
34671>>>>>>>                Send Request_Assign of hoServer
34672>>>>>>>            End
34672>>>>>>>>
34672>>>>>>>            Else Begin
34673>>>>>>>                Send ClearGrid
34674>>>>>>>            End
34674>>>>>>>>
34674>>>>>>>        End
34674>>>>>>>>
34674>>>>>>>        Else Begin
34675>>>>>>>            // with a manual loaded list, we will refresh the grid by sending GridRefresh
34675>>>>>>>            Move (GetRowID(Main_File(hoServer))) to riRowid
34676>>>>>>>            Send GridRefresh // this will do a manual load
34677>>>>>>>            String sRowId
34677>>>>>>>            Get psCurrentRowID to sRowId
34678>>>>>>>            If (bSeeded and IsNullRowID(DeserializeRowID(sRowId))) Begin
34680>>>>>>>                WebSet psCurrentRowID to (SerializeRowID(riRowid))
34681>>>>>>>            End
34681>>>>>>>>
34681>>>>>>>        End            
34681>>>>>>>>
34681>>>>>>>    End_Procedure
34682>>>>>>>
34682>>>>>>>    // initialize prompt list for a non-data aware grid (pbDataAware=F)
34682>>>>>>>    Procedure InitializePromptListNDA
34684>>>>>>>        Handle hoInvokingObject hoInitialColumn hoUpdateColumn
34684>>>>>>>        Boolean  bDataAware
34684>>>>>>>        Integer  eUpdateMode
34684>>>>>>>        Integer iUpdateColumn iInitialColumn 
34684>>>>>>>        String sValue sName
34684>>>>>>>        
34684>>>>>>>        Get FocusObject to hoInvokingObject
34685>>>>>>>
34685>>>>>>>        WebGet peUpdateMode to eUpdateMode
34686>>>>>>>        If (eUpdateMode=umPromptRelational) Begin
34688>>>>>>>            Move umPromptValue to eUpdateMode
34689>>>>>>>            WebSet peUpdateMode to eUpdateMode
34690>>>>>>>        End
34690>>>>>>>>
34690>>>>>>>        
34690>>>>>>>        WebGet piInitialColumn to iInitialColumn
34691>>>>>>>        
34691>>>>>>>        If (eUpdateMode=umPromptValue) Begin
34693>>>>>>>            WebGet psValue of hoInvokingObject to sValue
34694>>>>>>>            WebSet psSeedValue to sValue
34695>>>>>>>        End
34695>>>>>>>>
34695>>>>>>>        
34695>>>>>>>        WebGet piUpdateColumn to iUpdateColumn
34696>>>>>>>        If (iUpdateColumn>=0) Begin
34698>>>>>>>            Get GetColumnObject iUpdateColumn to hoUpdateColumn
34699>>>>>>>        End
34699>>>>>>>>
34699>>>>>>>        
34699>>>>>>>        // We need an initial column. if you specified an initial column that will get used for the start column
34699>>>>>>>        // and the initial sort order. If you did not, which is typical, it will use the update column
34699>>>>>>>        If (iInitialColumn=-1) Begin
34701>>>>>>>            Move iUpdateColumn to iInitialColumn
34702>>>>>>>        End
34702>>>>>>>>
34702>>>>>>>        If (iInitialColumn>=0) Begin
34704>>>>>>>            Get GetColumnObject iInitialColumn to hoInitialColumn
34705>>>>>>>        End
34705>>>>>>>>
34705>>>>>>>        
34705>>>>>>>        // this assigns an ordering and a sort order
34705>>>>>>>        If (hoInitialColumn) Begin
34707>>>>>>>            WebSet piSortColumn to iInitialColumn
34708>>>>>>>        End
34708>>>>>>>>
34708>>>>>>>        
34708>>>>>>>        Send GridRefresh // this will call OnLoadManualData which will fill and seed the list
34709>>>>>>>    End_Procedure

35740>>>>>>>    // Send this method to fire a client action to refresh the breadcrumb items.
35740>>>>>>>    Procedure FullRefresh
35742>>>>>>>        Integer i iCount
35742>>>>>>>        tWebViewInfo[] aViewStack
35742>>>>>>>        tWebViewInfo[] aViewStack
35743>>>>>>>        tWebBreadcrumbItem[] aItems
35743>>>>>>>        tWebBreadcrumbItem[] aItems
35744>>>>>>>        String[] aParams
35745>>>>>>>        
35745>>>>>>>        //  Load the items
35745>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
35746>>>>>>>        Move (SizeOfArray(aViewStack)) to iCount
35747>>>>>>>        
35747>>>>>>>        For i from 0 to (iCount-1)
35753>>>>>>>>
35753>>>>>>>            Move aViewStack[i].sViewName      to aItems[i].sViewName
35754>>>>>>>            Move aViewStack[i].sCaption       to aItems[i].sCrumbCaption
35755>>>>>>>            Move aViewStack[i].sHeaderCaption to aItems[i].sHeadCaption
35756>>>>>>>        Loop
35757>>>>>>>>
35757>>>>>>>        
35757>>>>>>>        Send CancelClientAction "refresh"
35758>>>>>>>        Send CancelClientAction "clear"
35759>>>>>>>
35759>>>>>>>        //  Add client message
35759>>>>>>>        If (iCount > 0) Begin
35761>>>>>>>            Move "" to aParams[0]        
35762>>>>>>>            Send ClientAction "refresh" aParams aItems
35763>>>>>>>        End
35763>>>>>>>>
35763>>>>>>>        Else Begin
35764>>>>>>>            Send ClientAction "clear"
35765>>>>>>>        End        
35765>>>>>>>>
35765>>>>>>>    End_Procedure

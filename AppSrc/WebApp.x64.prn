33458>>>>>>>        Case Begin
33458>>>>>>>            Case (sExt = "jpg")
33460>>>>>>>            Case (sExt = "jpeg")
33463>>>>>>>                Function_Return "image/jpeg"
33464>>>>>>>            Case (sExt = "gif")
33467>>>>>>>                Function_Return "image/gif"
33468>>>>>>>            Case (sExt = "png")
33471>>>>>>>                Function_Return "image/png"
33472>>>>>>>            Case (sExt = "svg")
33475>>>>>>>                Function_Return "image/svg"
33476>>>>>>>            Case (sExt = "tiff")
33479>>>>>>>                Function_Return "image/tiff"
33480>>>>>>>            Case (sExt = "bmp")
33483>>>>>>>                Function_Return "image/bmp"
33484>>>>>>>            Case (sExt = "ico")
33487>>>>>>>                Function_Return "image/x-icon"
33488>>>>>>>            Case Else 
33488>>>>>>>                Function_Return ("image/" + sExt)
33489>>>>>>>        Case End
33489>>>>>>>        
33489>>>>>>>    End_Function

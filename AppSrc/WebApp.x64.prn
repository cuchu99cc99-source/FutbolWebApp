22689>>>>>>>>>>>        Property Handle phoLoadView C_WebUnresolvedObject       // handle to view to load during a CallAction to LoadView
22690>>>>>>>>>>>        
22690>>>>>>>>>>>        Property Handle phoLoginView C_WebUnresolvedObject      // handle of login view to load when application is loaded.
22691>>>>>>>>>>>        Property Handle phoDefaultView C_WebUnresolvedObject    // handle of the default view to load when web application is loaded (unless there is a login screen to be shown - see phoLoginView)
22692>>>>>>>>>>>        
22692>>>>>>>>>>>        Property Handle phoCommandBar C_WebUnresolvedObject     // handle to child cWebCommandbar object
22693>>>>>>>>>>>        
22693>>>>>>>>>>>        
22693>>>>>>>>>>>        Property Integer peApplicationStyle wvsDesktop 
22694>>>>>>>>>>>        
22694>>>>>>>>>>>        Property Boolean pbTestSyncDDO False // for testing only (s/b False on release)
22695>>>>>>>>>>>        
22695>>>>>>>>>>>        Property String[] paLoadedViews     // List of all views loaded to the client (used by ShowView to determine if it should go back to the client)
22698>>>>>>>>>>>        
22698>>>>>>>>>>>        Property String psCurrentView ""    // Name of the currently active view
22701>>>>>>>>>>>        Property Handle phoCurrentShowView  C_WebUnresolvedObject // Handle to the view currently being shown (used to check if OnNavigateForward calls another view during show
22702>>>>>>>>>>>        
22702>>>>>>>>>>>        
22702>>>>>>>>>>>        Property String psApplicationTitle "DataFlex WebApp"        // The title shown in the browser title bar
22705>>>>>>>>>>>        Property Boolean pbUpdateApplicationTitle True              // If true the title in the title bar is automatically updated
22708>>>>>>>>>>>        
22708>>>>>>>>>>>        // When set to True all views will show an unhandled error when a refind record
22708>>>>>>>>>>>        // fails (usually some kind of FindByRowIdEx call). Normally this is False because
22708>>>>>>>>>>>        // refinds can fail in a multi-user environment and the framework will handle this
22708>>>>>>>>>>>        // as best it can. However, refind errors can also be caused by a programming error.
22708>>>>>>>>>>>        // If you set this true during debugging you will be notified of refind errors that
22708>>>>>>>>>>>        // may be a programming bug. This can work well because the multi-user can't refind
22708>>>>>>>>>>>        // error usually does not occur while debugging. If you set this True while testing,
22708>>>>>>>>>>>        // remember to set it back to False when deploying.  
22708>>>>>>>>>>>        Property Boolean pbShowAllRefindErrors False
22709>>>>>>>>>>>    End_Procedure
22710>>>>>>>>>>>    
22710>>>>>>>>>>>    // An object is only in-scope during a WebApp CallAction in the following cases:
22710>>>>>>>>>>>    // - It is a Global Object: cWebApp or its child objects (but not a cWebWindow child).
22710>>>>>>>>>>>    // - It is part of the stack of views\dialog in the cWebApp's paDDOViews property.
22710>>>>>>>>>>>    // - During a call to LoadView, it is part of the view being loaded.
22710>>>>>>>>>>>    Function OwnerIsInCallActionScope Handle hoWO Returns Boolean
22712>>>>>>>>>>>        Integer iViewIndex
22712>>>>>>>>>>>        Handle hoWebNeighborhood hoLoadView
22712>>>>>>>>>>>        Handle[] aDDOViews
22713>>>>>>>>>>>        
22713>>>>>>>>>>>        Get phoWebNeighborhood of hoWO to hoWebNeighborhood    // This property is set during object creation
22714>>>>>>>>>>>        
22714>>>>>>>>>>>        // Test if the neighborhood property is actually correctly set.
22714>>>>>>>>>>>        If (hoWebNeighborhood = C_WebUnresolvedObject) Begin
22716>>>>>>>>>>>            Function_Return False
22717>>>>>>>>>>>        End
22717>>>>>>>>>>>>
22717>>>>>>>>>>>        
22717>>>>>>>>>>>        // is this in the cWebApp Neighborhood?
22717>>>>>>>>>>>        If (hoWebNeighborhood = Self) Begin
22719>>>>>>>>>>>            Function_Return True
22720>>>>>>>>>>>        End
22720>>>>>>>>>>>>
22720>>>>>>>>>>>        
22720>>>>>>>>>>>        // is this a View that is being loaded?
22720>>>>>>>>>>>        Get phoLoadView to hoLoadView
22721>>>>>>>>>>>        If (hoWebNeighborhood = hoLoadView) Begin
22723>>>>>>>>>>>            Function_Return True
22724>>>>>>>>>>>        End
22724>>>>>>>>>>>>
22724>>>>>>>>>>>        
22724>>>>>>>>>>>        // is this in the neighborhood of one of the focus windows?
22724>>>>>>>>>>>        Get paDDOViews to aDDOViews     // This property is set during CallAction
22725>>>>>>>>>>>        Move (SearchArray(hoWebNeighborhood, aDDOViews)) to iViewIndex
22726>>>>>>>>>>>        Function_Return (iViewIndex <> -1)
22727>>>>>>>>>>>    End_Function
22728>>>>>>>>>>>    
22728>>>>>>>>>>>    Procedure OwnerRegisterView Handle hoView
22730>>>>>>>>>>>        tWebControlMapItem new
22730>>>>>>>>>>>        tWebControlMapItem new
22730>>>>>>>>>>>        tWebControlMapItem[] aViews
22730>>>>>>>>>>>        tWebControlMapItem[] aViews
22731>>>>>>>>>>>        
22731>>>>>>>>>>>        Get paViews to aViews
22732>>>>>>>>>>>        
22732>>>>>>>>>>>        Move hoView to new.hoObj
22733>>>>>>>>>>>        Move (Uppercase(Name(hoView))) to new.sName
22734>>>>>>>>>>>        
22734>>>>>>>>>>>        If (BinarySearchArray(new, aViews, False) = -1) Begin
22736>>>>>>>>>>>            Move (InsertInArray(aViews, BinarySearchInsertPos(), new)) to aViews
22737>>>>>>>>>>>            Set paViews to aViews
22738>>>>>>>>>>>        End
22738>>>>>>>>>>>>
22738>>>>>>>>>>>        Else Begin
22739>>>>>>>>>>>            Error DFERR_PROGRAM (SFormat("View with name '%1' already registered.", new.sName))
22740>>>>>>>>>>>>
22740>>>>>>>>>>>        End
22740>>>>>>>>>>>>
22740>>>>>>>>>>>    End_Function
22741>>>>>>>>>>>    
22741>>>>>>>>>>>    Function FindView String sViewName Boolean bSilent Returns Handle
22743>>>>>>>>>>>        tWebControlMapItem[] aViews
22743>>>>>>>>>>>        tWebControlMapItem[] aViews
22744>>>>>>>>>>>        tWebControlMapItem search
22744>>>>>>>>>>>        tWebControlMapItem search
22744>>>>>>>>>>>        Integer iPos
22744>>>>>>>>>>>        
22744>>>>>>>>>>>        Get paViews to aViews
22745>>>>>>>>>>>        Move (Uppercase(Trim(sViewName))) to search.sName
22746>>>>>>>>>>>        Move (BinarySearchArray(search, aViews, False)) to iPos
22747>>>>>>>>>>>        
22747>>>>>>>>>>>        If (iPos <> -1) Begin
22749>>>>>>>>>>>            Function_Return aViews[iPos].hoObj
22750>>>>>>>>>>>        End
22750>>>>>>>>>>>>
22750>>>>>>>>>>>        
22750>>>>>>>>>>>        If (not(bSilent)) Begin
22752>>>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppTargetObjectNotFound, sViewName))
22753>>>>>>>>>>>>
22753>>>>>>>>>>>        End
22753>>>>>>>>>>>>
22753>>>>>>>>>>>        
22753>>>>>>>>>>>        Function_Return C_WebUnresolvedObject
22754>>>>>>>>>>>    End_Function
22755>>>>>>>>>>>    
22755>>>>>>>>>>>    Function OwnerActionState Handle hoWO Returns Integer
22757>>>>>>>>>>>        Handle hoLoadView hoNeigborhood
22757>>>>>>>>>>>        
22757>>>>>>>>>>>        Get phoLoadView to hoLoadView
22758>>>>>>>>>>>        Get phoWebNeighborhood to hoNeigborhood
22759>>>>>>>>>>>        
22759>>>>>>>>>>>        If (hoLoadView <> C_WebUnresolvedObject and hoLoadView = hoNeigborhood) Begin
22761>>>>>>>>>>>            Function_Return ctExecViewLoad
22762>>>>>>>>>>>        End
22762>>>>>>>>>>>>
22762>>>>>>>>>>>        
22762>>>>>>>>>>>        Function_Return ctExecDefault    //  Execute as a default client action (after synchronization of web properties)
22763>>>>>>>>>>>    End_Function
22764>>>>>>>>>>>    
22764>>>>>>>>>>>    // Called by LoadWebApp to load the initial view
22764>>>>>>>>>>>    Procedure Load_InitialView
22766>>>>>>>>>>>        Handle hoView
22766>>>>>>>>>>>        String sStateHash
22766>>>>>>>>>>>        Integer eAppStyle
22766>>>>>>>>>>>        String[] aLoadedViews
22767>>>>>>>>>>>        
22767>>>>>>>>>>>        WebGet paLoadedViews to aLoadedViews
22768>>>>>>>>>>>        If (SizeOfArray(aLoadedViews) > 0) ;            Procedure_Return
22771>>>>>>>>>>>        
22771>>>>>>>>>>>        //  Get forced initial view (login dialog or so)
22771>>>>>>>>>>>        Get ForcedInitialView to hoView
22772>>>>>>>>>>>        
22772>>>>>>>>>>>        //  Set initial page title (a login dialog might not set one)
22772>>>>>>>>>>>        Send UpdatePageTitle C_WebUnresolvedObject ""
22773>>>>>>>>>>>        
22773>>>>>>>>>>>        //  Send back default view unless a login dialog needs to be sent
22773>>>>>>>>>>>        If (hoView = C_WebUnresolvedObject) Begin
22775>>>>>>>>>>>            //  Restore application state
22775>>>>>>>>>>>            If (peApplicationStateMode(Self) <> asmOff) Begin
22777>>>>>>>>>>>                Get StateHash to sStateHash 
22778>>>>>>>>>>>                Send RestoreState sStateHash True
22779>>>>>>>>>>>            End
22779>>>>>>>>>>>>
22779>>>>>>>>>>>            Else Begin //  Or return default view
22780>>>>>>>>>>>                Get GetDefaultView to hoView
22781>>>>>>>>>>>                If (hoView > 0) Begin
22783>>>>>>>>>>>                    Send Show of hoView
22784>>>>>>>>>>>                End
22784>>>>>>>>>>>>
22784>>>>>>>>>>>            End
22784>>>>>>>>>>>>
22784>>>>>>>>>>>        End
22784>>>>>>>>>>>>
22784>>>>>>>>>>>        Else Begin
22785>>>>>>>>>>>            Get peApplicationStyle to eAppStyle
22786>>>>>>>>>>>            If (eAppStyle = wvsDrillDown) Begin
22788>>>>>>>>>>>               Send NavigateBegin of hoView Self True 
22789>>>>>>>>>>>            End
22789>>>>>>>>>>>>
22789>>>>>>>>>>>            Else Begin
22790>>>>>>>>>>>                Send Show of hoView    
22791>>>>>>>>>>>            End
22791>>>>>>>>>>>>
22791>>>>>>>>>>>        End
22791>>>>>>>>>>>>
22791>>>>>>>>>>>    End_Procedure
22792>>>>>>>>>>>    
22792>>>>>>>>>>>    Function ViewAccessDenied Handle hoView Boolean bRestoreState Returns Boolean
22794>>>>>>>>>>>        tOnViewAccessDenied deniedDetails
22794>>>>>>>>>>>        tOnViewAccessDenied deniedDetails
22794>>>>>>>>>>>        Integer eAppStyle
22794>>>>>>>>>>>        
22794>>>>>>>>>>>        Move hoView to deniedDetails.hoView
22795>>>>>>>>>>>        Move bRestoreState to deniedDetails.bRestoreState
22796>>>>>>>>>>>        Move False to deniedDetails.bHandled
22797>>>>>>>>>>>        Move C_WebUnresolvedObject to deniedDetails.hoNavigateToView
22798>>>>>>>>>>>        
22798>>>>>>>>>>>        Send OnViewAccessDenied (&deniedDetails)
22799>>>>>>>>>>>        If (deniedDetails.bHandled) ;            Function_Return True
22802>>>>>>>>>>>        
22802>>>>>>>>>>>        If (deniedDetails.hoNavigateToView <> C_WebUnresolvedObject) Begin
22804>>>>>>>>>>>            Get peApplicationStyle to eAppStyle
22805>>>>>>>>>>>            If (eAppStyle = wvsDrillDown) Begin
22807>>>>>>>>>>>                Send NavigatePathBegin deniedDetails.hoNavigateToView True
22808>>>>>>>>>>>            End
22808>>>>>>>>>>>>
22808>>>>>>>>>>>            Else Begin
22809>>>>>>>>>>>                Send Show of deniedDetails.hoNavigateToView    
22810>>>>>>>>>>>            End 
22810>>>>>>>>>>>>
22810>>>>>>>>>>>            Function_Return True
22811>>>>>>>>>>>        End
22811>>>>>>>>>>>>
22811>>>>>>>>>>>        
22811>>>>>>>>>>>        Function_Return False
22812>>>>>>>>>>>    End_Function
22813>>>>>>>>>>>    
22813>>>>>>>>>>>    // Event that is fired when the user tries to navigate into a view or dialog and access is denied. Implement this 
22813>>>>>>>>>>>    // procedure to customize behavior (for example show a login view). By default triggers the Access Denied error.
22813>>>>>>>>>>>    Procedure OnViewAccessDenied tOnViewAccessDenied ByRef details
22815>>>>>>>>>>>        Error DFERR_WEBAPP_ACCESS_DENIED
22816>>>>>>>>>>>>
22816>>>>>>>>>>>    End_Procedure
22817>>>>>>>>>>>
22817>>>>>>>>>>>
22817>>>>>>>>>>>    // Client Action: Sends hideView to the client to hide the passed view. A hidden view can be re-shown without making
22817>>>>>>>>>>>    // a server call (see ShowView). Note, a hidden view and it's data is still present on the client. 
22817>>>>>>>>>>>    // If access to a view is to be securely restricted Use CloseView instead.
22817>>>>>>>>>>>    // See also "Hide" method of cWebView.
22817>>>>>>>>>>>    // See also "ShowView" 
22817>>>>>>>>>>>    Procedure HideView Handle hoView
22819>>>>>>>>>>>        String sView sCurrent sInvoking
22819>>>>>>>>>>>        String[] aParams
22820>>>>>>>>>>>
22820>>>>>>>>>>>        Get Object_Label of hoView to sView
22821>>>>>>>>>>>        
22821>>>>>>>>>>>        WebGet psCurrentView to sCurrent
22822>>>>>>>>>>>        If (sView = sCurrent) Begin
22824>>>>>>>>>>>            WebGet psInvokingView of hoView to sInvoking
22825>>>>>>>>>>>            WebSet psCurrentView to sInvoking
22826>>>>>>>>>>>        End
22826>>>>>>>>>>>>
22826>>>>>>>>>>>        
22826>>>>>>>>>>>        Move sView to aParams[0]       // Pass the view name as the 1st parameter.
22827>>>>>>>>>>>        Move False to aParams[1]       // We do want to send OnHide if needed
22828>>>>>>>>>>>        Send ClientAction "hideView" aParams 
22829>>>>>>>>>>>    End_Procedure
22830>>>>>>>>>>>    
22830>>>>>>>>>>>    
22830>>>>>>>>>>>    //  Determines if a view loaded on the client by looking at paLoadedViews.
22830>>>>>>>>>>>    //
22830>>>>>>>>>>>    //  hoView      - Handle to the view object.
22830>>>>>>>>>>>    //  Returns true if the view is available on the client.
22830>>>>>>>>>>>    Function IsViewLoaded Handle hoView Returns Boolean
22832>>>>>>>>>>>        String [] aLoadedViews
22833>>>>>>>>>>>        String sView
22833>>>>>>>>>>>        
22833>>>>>>>>>>>        Get WebObjectName of hoView to sView
22834>>>>>>>>>>>        WebGet paLoadedViews to aLoadedViews
22835>>>>>>>>>>>        
22835>>>>>>>>>>>        Function_Return (SearchArray(UpperCase(sView), aLoadedViews) >= 0)
22836>>>>>>>>>>>    End_Function
22837>>>>>>>>>>>    
22837>>>>>>>>>>>    
22837>>>>>>>>>>>    //  Determines if a view is in sync using IsInCallActionScope.
22837>>>>>>>>>>>    //
22837>>>>>>>>>>>    //  hoView      - Handle to the view object.
22837>>>>>>>>>>>    //  Returns true if the view is currently in sync.
22837>>>>>>>>>>>    Function IsViewInSync Handle hoView Returns Boolean
22839>>>>>>>>>>>        Boolean bResult
22839>>>>>>>>>>>        
22839>>>>>>>>>>>        Get IsInCallActionScope of hoView to bResult
22840>>>>>>>>>>>        
22840>>>>>>>>>>>        Function_Return bResult
22841>>>>>>>>>>>    End_Function
22842>>>>>>>>>>>    
22842>>>>>>>>>>>    //  Determines the currently shown view.
22842>>>>>>>>>>>    //
22842>>>>>>>>>>>    //  Returns a handle to the currently shown view.
22842>>>>>>>>>>>    Function CurrentView Returns Handle
22844>>>>>>>>>>>        String sView
22844>>>>>>>>>>>        Handle hoView
22844>>>>>>>>>>>        
22844>>>>>>>>>>>        Move C_WebUnresolvedObject to hoView
22845>>>>>>>>>>>        
22845>>>>>>>>>>>        WebGet psCurrentView to sView
22846>>>>>>>>>>>        If (sView <> "") Begin
22848>>>>>>>>>>>            Get WebObjectByName sView to hoView
22849>>>>>>>>>>>        End
22849>>>>>>>>>>>>
22849>>>>>>>>>>>        
22849>>>>>>>>>>>        Function_Return hoView
22850>>>>>>>>>>>    End_Function
22851>>>>>>>>>>>    
22851>>>>>>>>>>>    // Server-Action
22851>>>>>>>>>>>    //
22851>>>>>>>>>>>    // Part of the CallAction interface. Used to return a view's object definition to the client.
22851>>>>>>>>>>>    // Returns a structure of objects and properties for nested DDO and cWebObjects
22851>>>>>>>>>>>    // These are returned to the client as serialized JSON.
22851>>>>>>>>>>>    // sViewName     - Is the name of the view to be loaded
22851>>>>>>>>>>>    // sInvokingView - Is the name of the view that triggered the LoadView call. This is mostly used
22851>>>>>>>>>>>    //                 in the cWebDialog class when activating a modal dialog.
22851>>>>>>>>>>>    Function LoadView String sViewName String sInvokingView Returns Boolean
22853>>>>>>>>>>>        Handle hoView
22853>>>>>>>>>>>        Handle[] aDDOViews
22854>>>>>>>>>>>        String[] aLoadedViews asParams
22856>>>>>>>>>>>        Boolean bAllowAccess bLoaded bHandled
22856>>>>>>>>>>>        Handle hjObjectDef
22856>>>>>>>>>>>        tWebDDODef DDODef
22856>>>>>>>>>>>        tWebDDODef DDODef
22856>>>>>>>>>>>        String sPreLoad
22856>>>>>>>>>>>
22856>>>>>>>>>>>        // Get a handle to the view we are loading....
22856>>>>>>>>>>>        Get GetAjaxWebAppView of (phoWebControlLocator(Self)) sViewName to hoView
22857>>>>>>>>>>>        
22857>>>>>>>>>>>        If (hoView <> C_WebUnresolvedObject) Begin
22859>>>>>>>>>>>            
22859>>>>>>>>>>>            // Set up the web properties system to allow WebGet to access this view....
22859>>>>>>>>>>>            Set phoLoadView to hoView
22860>>>>>>>>>>>            Send ProcessLoadViewClientSyncProps hoView
22861>>>>>>>>>>>            
22861>>>>>>>>>>>            // Test AllowViewAcess here because this explicitly tests access to the view we are loading.
22861>>>>>>>>>>>            // That is not the case when testing AllowViewAccess from CallAction. In CallAction we only
22861>>>>>>>>>>>            // test AllowViewAccess of the view that is processing the call (this might be different).
22861>>>>>>>>>>>            Get AllowViewAccess hoView to bAllowAccess
22862>>>>>>>>>>>    
22862>>>>>>>>>>>            If (bAllowAccess) Begin
22864>>>>>>>>>>>                // Add to the list of views to synchronize back to the client....
22864>>>>>>>>>>>                Get paDDOViews to aDDOViews
22865>>>>>>>>>>>                If (SearchArray(hoView, aDDOViews) < 0) Begin
22867>>>>>>>>>>>                    Move hoView to aDDOViews[SizeOfArray(aDDOViews)]
22868>>>>>>>>>>>                End
22868>>>>>>>>>>>>
22868>>>>>>>>>>>                Set paDDOViews to aDDOViews
22869>>>>>>>>>>>
22869>>>>>>>>>>>                //  Perform initialization (clear, set constraints)
22869>>>>>>>>>>>                Send InitForShow of hoView                    
22870>>>>>>>>>>>                
22870>>>>>>>>>>>                // we want view sync before OnLoad
22870>>>>>>>>>>>                Send NotifySyncWebApp of hoView
22871>>>>>>>>>>>                    
22871>>>>>>>>>>>                // Serialize the view to JSON....
22871>>>>>>>>>>>                Get SerializeObject of hoView to hjObjectDef
22872>>>>>>>>>>>                Send ClientActionEarly "createView" asParams hjObjectDef    
22873>>>>>>>>>>>                Send Destroy of hjObjectDef           
22874>>>>>>>>>>>
22874>>>>>>>>>>>                // Set the psInvokingView web property. We need this to be set already during LoadView
22874>>>>>>>>>>>                // if we are loading a Modal Dialog...
22874>>>>>>>>>>>                //WebSet psInvokingView of hoView to sInvokingView
22874>>>>>>>>>>>                Send InitInvokingView to hoView sInvokingView
22875>>>>>>>>>>>                
22875>>>>>>>>>>>                Set phoLoadView to C_WebUnresolvedObject
22876>>>>>>>>>>>                
22876>>>>>>>>>>>                //  Mark view as loaded
22876>>>>>>>>>>>                WebGet paLoadedViews to aLoadedViews
22877>>>>>>>>>>>                If (SearchArray(Uppercase(sViewName), aLoadedViews) = -1) Begin
22879>>>>>>>>>>>                    Move (Uppercase(sViewName)) to aLoadedViews[SizeOfArray(aLoadedViews)]
22880>>>>>>>>>>>                    WebSet paLoadedViews to aLoadedViews
22881>>>>>>>>>>>                End            
22881>>>>>>>>>>>>
22881>>>>>>>>>>>                
22881>>>>>>>>>>>                Function_Return True
22882>>>>>>>>>>>            End
22882>>>>>>>>>>>>
22882>>>>>>>>>>>            Else Begin
22883>>>>>>>>>>>                Get ViewAccessDenied hoView False to bHandled
22884>>>>>>>>>>>            End
22884>>>>>>>>>>>>
22884>>>>>>>>>>>        End
22884>>>>>>>>>>>>
22884>>>>>>>>>>>        
22884>>>>>>>>>>>        Function_Return False
22885>>>>>>>>>>>    End_Function
22886>>>>>>>>>>>    
22886>>>>>>>>>>>    //  Loads and initializes a view asynchronously (the loading is done via a separate round-trip).
22886>>>>>>>>>>>    //  This is used for performance reasons when restoring the application state from a URL path.
22886>>>>>>>>>>>    //
22886>>>>>>>>>>>    //  Note: Should only be used when the view is not loaded to the client!!
22886>>>>>>>>>>>    //  
22886>>>>>>>>>>>    //  - hoView        Handle to the view.
22886>>>>>>>>>>>    Procedure DelayLoadview Handle hoView
22888>>>>>>>>>>>        String[] aParams
22889>>>>>>>>>>>        Handle[] aDDOViews
22890>>>>>>>>>>>        
22890>>>>>>>>>>>        // Add to the list of views to synchronize back to the client....
22890>>>>>>>>>>>        Get paDDOViews to aDDOViews
22891>>>>>>>>>>>        If (SearchArray(hoView, aDDOViews) < 0) Begin
22893>>>>>>>>>>>            Move hoView to aDDOViews[SizeOfArray(aDDOViews)]
22894>>>>>>>>>>>        End
22894>>>>>>>>>>>>
22894>>>>>>>>>>>        Set paDDOViews to aDDOViews
22895>>>>>>>>>>>
22895>>>>>>>>>>>        //  Add load view client action
22895>>>>>>>>>>>        Get WebObjectName of hoView to aParams[0]
22896>>>>>>>>>>>        Move 1 to aParams[1]
22897>>>>>>>>>>>        Send ClientAction "loadView" aParams
22898>>>>>>>>>>>        
22898>>>>>>>>>>>        //  Initialize view
22898>>>>>>>>>>>        Send InitForShow of hoView
22899>>>>>>>>>>>        WebSet pbPreLoaded of hoView to True
22901>>>>>>>>>>>
22901>>>>>>>>>>>        //  We want view sync before OnLoad
22901>>>>>>>>>>>        Send NotifySyncWebApp of hoView
22902>>>>>>>>>>>        
22902>>>>>>>>>>>
22902>>>>>>>>>>>    End_Procedure
22903>>>>>>>>>>>      
22903>>>>>>>>>>>    
22903>>>>>>>>>>>    //  Shows a view and loads it (if nessecary). If a view is loaded and synchronized it will be 
22903>>>>>>>>>>>    //  shown directly (when returned to the client) and processing can continue. If a view is 
22903>>>>>>>>>>>    //  loaded to the client but not synchronized it depends on pbOverrideStateOnShow what happens.
22903>>>>>>>>>>>    //  If pbOverrideStateOnShow is false it will go back to the client before it continues and this 
22903>>>>>>>>>>>    //  makes the message asynchronous. If pbOverridestateOnShow is true it will continue and 
22903>>>>>>>>>>>    //  instruct the client to reinitialize the view before rendering it. If the view is not loaded
22903>>>>>>>>>>>    //  it will load the view (add the definitions to the response) and show it directly. The
22903>>>>>>>>>>>    //  optional handler message needs to be published and the object needs to be a web object.
22903>>>>>>>>>>>    //
22903>>>>>>>>>>>    //  - hoView                Handle of the view to be shown.
22903>>>>>>>>>>>    //  - hmOptCallBackMsg      (optional) Callback message executed when the view is initialized.
22903>>>>>>>>>>>    //  - hoOptCallbackObj      (optional) Object to which the callback message should be sent.
22903>>>>>>>>>>>    Procedure ShowView Handle hoView Handle hmOptCallbackMsg Handle hoOptCallbackObj
22905>>>>>>>>>>>        Boolean bIsLoaded bInSync bAllowAccess bShowDirect
22905>>>>>>>>>>>        String sView
22905>>>>>>>>>>>        String[] aParams
22906>>>>>>>>>>>        tWebClientAction tClientAction
22906>>>>>>>>>>>        tWebClientAction tClientAction
22906>>>>>>>>>>>        tWebClientAction[] aClientActions
22906>>>>>>>>>>>        tWebClientAction[] aClientActions
22907>>>>>>>>>>>        Handle hmCallbackMsg hoCallbackObj
22907>>>>>>>>>>>        Boolean bHandled
22907>>>>>>>>>>>        
22907>>>>>>>>>>>        If (num_arguments > 2) Begin
22909>>>>>>>>>>>            Move hmOptCallbackMsg to hmCallbackMsg
22910>>>>>>>>>>>            Move hoOptCallbackObj to hoCallbackObj
22911>>>>>>>>>>>        End
22911>>>>>>>>>>>>
22911>>>>>>>>>>>        
22911>>>>>>>>>>>        Move False to bShowDirect
22912>>>>>>>>>>>        
22912>>>>>>>>>>>        Get WebObjectName of hoView to sView
22913>>>>>>>>>>>                
22913>>>>>>>>>>>        // Test AllowViewAcess here because this explicitly tests access to the view we are loading.
22913>>>>>>>>>>>        // That is not the case when testing AllowViewAccess from CallAction. In CallAction we only
22913>>>>>>>>>>>        // test AllowViewAccess of the view that is processing the call (this might be different).
22913>>>>>>>>>>>        Get AllowViewAccess hoView to bAllowAccess
22914>>>>>>>>>>>        If (not(bAllowAccess)) Begin
22916>>>>>>>>>>>            Get ViewAccessDenied hoView False to bHandled
22917>>>>>>>>>>>            Procedure_Return
22918>>>>>>>>>>>        End
22918>>>>>>>>>>>>
22918>>>>>>>>>>>        
22918>>>>>>>>>>>        Set phoCurrentShowView to hoView    // Property used to check if no other ShowView is called meanwhile (check is in ShowView_Exec)
22919>>>>>>>>>>>        Get IsViewLoaded hoView to bIsLoaded
22920>>>>>>>>>>>        If (not(bIsLoaded)) Begin
22922>>>>>>>>>>>            //  If the view is not loaded we load it now
22922>>>>>>>>>>>            Get LoadView sView 0 to bIsLoaded
22923>>>>>>>>>>>            If (bIsLoaded) Begin
22925>>>>>>>>>>>                Move True to bShowDirect
22926>>>>>>>>>>>            End
22926>>>>>>>>>>>>
22926>>>>>>>>>>>        End
22926>>>>>>>>>>>>
22926>>>>>>>>>>>        Else Begin
22927>>>>>>>>>>>            Get IsViewInSync hoView to bInSync
22928>>>>>>>>>>>            If (bInSync) Begin
22930>>>>>>>>>>>                Move True to bShowDirect
22931>>>>>>>>>>>            End
22931>>>>>>>>>>>>
22931>>>>>>>>>>>            Else Begin
22932>>>>>>>>>>>                If (pbOverrideStateOnShow(hoView)) Begin
22934>>>>>>>>>>>                    //  If pbOverrideStateOnShow is true we can override it by unloading it on the client and simply loading it fresh (we used to do sneaky things here before 20.0)
22934>>>>>>>>>>>                    
22934>>>>>>>>>>>                    //  Add an early executed action to unload the view
22934>>>>>>>>>>>                    Move "unloadView"   to tClientAction.sName
22935>>>>>>>>>>>                    Move ""             to tClientAction.sTarget
22936>>>>>>>>>>>                    Move ctExecEarly    to tClientAction.eType
22937>>>>>>>>>>>                    Move sView          to tClientAction.aParams[0]
22938>>>>>>>>>>>                    
22938>>>>>>>>>>>                    Get paClientActions to aClientActions
22939>>>>>>>>>>>                    Move tClientAction to aClientActions[SizeOfArray(aClientActions)]
22940>>>>>>>>>>>                    Set paClientActions to aClientActions
22941>>>>>>>>>>>                    
22941>>>>>>>>>>>                    //  Load the view fresh and show when succesfull
22941>>>>>>>>>>>                    Get LoadView sView 0 to bIsLoaded
22942>>>>>>>>>>>                    If (bIsLoaded) Begin
22944>>>>>>>>>>>                        Move True to bShowDirect
22945>>>>>>>>>>>                    End
22945>>>>>>>>>>>>
22945>>>>>>>>>>>                End
22945>>>>>>>>>>>>
22945>>>>>>>>>>>                Else Begin
22946>>>>>>>>>>>                    //  We need to go to the client first
22946>>>>>>>>>>>                    Move sView to aParams[0]
22947>>>>>>>>>>>                    
22947>>>>>>>>>>>                    If (hmCallbackMsg > 0) Begin
22949>>>>>>>>>>>                        Get WebMethodName of hoCallbackObj hmCallbackMsg to aParams[1]
22950>>>>>>>>>>>                        Get WebObjectName of hoCallbackObj to aParams[2]
22951>>>>>>>>>>>                    End
22951>>>>>>>>>>>>
22951>>>>>>>>>>>                    
22951>>>>>>>>>>>                    Send ClientAction "showView" aParams
22952>>>>>>>>>>>                End
22952>>>>>>>>>>>>
22952>>>>>>>>>>>            End
22952>>>>>>>>>>>>
22952>>>>>>>>>>>        End
22952>>>>>>>>>>>>
22952>>>>>>>>>>>        
22952>>>>>>>>>>>        If (bShowDirect) Begin
22954>>>>>>>>>>>            // Do callback
22954>>>>>>>>>>>            If (hmCallbackMsg > 0) Begin
22956>>>>>>>>>>>                Send hmCallbackMsg of hoCallbackObj hoView
22957>>>>>>>>>>>            End
22957>>>>>>>>>>>>
22957>>>>>>>>>>>            
22957>>>>>>>>>>>            // Directly show the view
22957>>>>>>>>>>>            Send ShowView_Exec hoView False
22958>>>>>>>>>>>        End    
22958>>>>>>>>>>>>
22958>>>>>>>>>>>    End_Procedure
22959>>>>>>>>>>>    
22959>>>>>>>>>>>    
22959>>>>>>>>>>>    //  Actually shows the view by sending doShow and performing the renderView client action.
22959>>>>>>>>>>>    //
22959>>>>>>>>>>>    //  - hoView        Handle of the view object to the be shown.
22959>>>>>>>>>>>    //  - bStandalone   If true this is a standalone view (oWebApp.displayView(..)) and not 
22959>>>>>>>>>>>    //                  rendered by renderview.
22959>>>>>>>>>>>    Procedure ShowView_Exec Handle hoView Boolean bStandalone
22961>>>>>>>>>>>        String[] aParams
22962>>>>>>>>>>>        String sView
22962>>>>>>>>>>>        Handle hoInvokingView
22962>>>>>>>>>>>        
22962>>>>>>>>>>>        //  Check if the showview is not overriden by a different ShowView call inside OnNavigateForward, phoCurrentShowView should be set before this function is called
22962>>>>>>>>>>>        If (phoCurrentShowView(Self) = hoView or (phoCurrentShowView(Self) <> C_WebUnresolvedObject and IsDialog(phoCurrentShowView(Self)))) Begin
22964>>>>>>>>>>>            Send DoShow of hoView
22965>>>>>>>>>>>            Get WebObjectName of hoView to sView
22966>>>>>>>>>>>            
22966>>>>>>>>>>>            WebSet psCurrentView to sView
22967>>>>>>>>>>>            
22967>>>>>>>>>>>            If (not(bStandalone)) Begin
22969>>>>>>>>>>>                Move sView to aParams[0]
22970>>>>>>>>>>>                Send ClientAction "renderView" aParams
22971>>>>>>>>>>>            End
22971>>>>>>>>>>>>
22971>>>>>>>>>>>            
22971>>>>>>>>>>>            Set phoCurrentShowView to C_WebUnresolvedObject
22972>>>>>>>>>>>        End
22972>>>>>>>>>>>>
22972>>>>>>>>>>>    End_Procedure
22973>>>>>>>>>>>    
22973>>>>>>>>>>>    
22973>>>>>>>>>>>    //  Server-Action
22973>>>>>>>>>>>    //
22973>>>>>>>>>>>    //  Called by the JavaScript Engine to show a view. This can either be initiated by the server 
22973>>>>>>>>>>>    //  via ShowView (view was loaded to the client but not in sync) or be initiated from the 
22973>>>>>>>>>>>    //  client like with cWebMenuItemLoadView.
22973>>>>>>>>>>>    //
22973>>>>>>>>>>>    //  - sView         Name of the view.
22973>>>>>>>>>>>    //  - bStandalone   True if the view is shown separately (oWebApp.displayView).
22973>>>>>>>>>>>    //  - sOptCallbackMsg   (optional) String with the published procedure that needs to be called 
22973>>>>>>>>>>>    //                      when the view is initialized.
22973>>>>>>>>>>>    //  - sOptCallback      (optional) Name of the web object handling the callback message.
22973>>>>>>>>>>>    Procedure ShowView_FromClient String sView Boolean bStandalone String sOptCallbackMsg String sOptCallbackObj
22975>>>>>>>>>>>        Handle hoView hmCallbackMsg hoCallbackObj
22975>>>>>>>>>>>        Boolean bIsLoaded bInSync
22975>>>>>>>>>>>        
22975>>>>>>>>>>>        If (num_arguments > 3) Begin
22977>>>>>>>>>>>            Get WebObjectByName sOptCallbackObj to hoCallbackObj
22978>>>>>>>>>>>            If (hoCallbackObj > 0) Begin
22980>>>>>>>>>>>                Get WebMethodByName of hoCallbackObj sOptCallbackMsg to hmCallbackMsg
22981>>>>>>>>>>>            End
22981>>>>>>>>>>>>
22981>>>>>>>>>>>        End
22981>>>>>>>>>>>>
22981>>>>>>>>>>>        
22981>>>>>>>>>>>        Get WebObjectByName sView to hoView
22982>>>>>>>>>>>        Get IsViewLoaded hoView to bIsLoaded
22983>>>>>>>>>>>        Set phoCurrentShowView to hoView    // Property used to check if no other ShowView is called meanwhile (check is in ShowView_Exec)
22984>>>>>>>>>>>        
22984>>>>>>>>>>>        If (not(bIsLoaded)) Begin
22986>>>>>>>>>>>            Get LoadView sView 0 to bIsLoaded
22987>>>>>>>>>>>            If (bIsLoaded) Begin
22989>>>>>>>>>>>                
22989>>>>>>>>>>>                // Do callback
22989>>>>>>>>>>>                If (hmCallbackMsg > 0) Begin
22991>>>>>>>>>>>                    Send hmCallbackMsg of hoCallbackObj hoView
22992>>>>>>>>>>>                End
22992>>>>>>>>>>>>
22992>>>>>>>>>>>                
22992>>>>>>>>>>>                Send ShowView_Exec hoView bStandalone
22993>>>>>>>>>>>            End
22993>>>>>>>>>>>>
22993>>>>>>>>>>>        End
22993>>>>>>>>>>>>
22993>>>>>>>>>>>        Else Begin
22994>>>>>>>>>>>            Get IsViewInSync hoView to bInSync
22995>>>>>>>>>>>            If (bInSync) Begin
22997>>>>>>>>>>>                // Do callback
22997>>>>>>>>>>>                If (hmCallbackMsg > 0) Begin
22999>>>>>>>>>>>                    Send hmCallbackMsg of hoCallbackObj hoView
23000>>>>>>>>>>>                End
23000>>>>>>>>>>>>
23000>>>>>>>>>>>                
23000>>>>>>>>>>>                Send ShowView_Exec hoView bStandalone
23001>>>>>>>>>>>            End
23001>>>>>>>>>>>>
23001>>>>>>>>>>>            Else Begin
23002>>>>>>>>>>>                Error DFERR_OPERATOR "ShowView_FromClient requires view to be synchronized if loaded."
23003>>>>>>>>>>>>
23003>>>>>>>>>>>            End
23003>>>>>>>>>>>>
23003>>>>>>>>>>>        End
23003>>>>>>>>>>>>
23003>>>>>>>>>>>    End_Procedure
23004>>>>>>>>>>>    
23004>>>>>>>>>>>    
23004>>>>>>>>>>>    // Client Action: Sends unloadView to the client to remove the passed view and its web properties.
23004>>>>>>>>>>>    // An Unloaded view must be reloaded from the server before it can be displayed again (using LoadView). 
23004>>>>>>>>>>>    // Note, unloading a view is more secure than hiding it because its data is removed from the client.
23004>>>>>>>>>>>    // See also "Unload" method of cWebView.
23004>>>>>>>>>>>    // See also "LoadView"
23004>>>>>>>>>>>    Procedure UnloadView Handle hoView
23006>>>>>>>>>>>        String sViewName
23006>>>>>>>>>>>        String[] aParams
23007>>>>>>>>>>>        
23007>>>>>>>>>>>        Get Object_Label of hoView to sViewName
23008>>>>>>>>>>>        Move sViewName      to aParams[0]   // Pass the view name as the 1st parameter.
23009>>>>>>>>>>>        Move True           to aParams[1]
23010>>>>>>>>>>>        Send ClientAction "unloadView" aParams
23011>>>>>>>>>>>    End_Procedure
23012>>>>>>>>>>>    
23012>>>>>>>>>>>    
23012>>>>>>>>>>>    // Triggers when the page title is automatically updated and concatenates the the application 
23012>>>>>>>>>>>    // title with the view title. Can be augmented / overriden to 
23012>>>>>>>>>>>    //
23012>>>>>>>>>>>    // Params:
23012>>>>>>>>>>>    //      ByRef sTitle    Contains the page title when coming in, should receive the full title.
23012>>>>>>>>>>>    //      hoView          Handle to the current view (can be C_WebUnresolvedObject).
23012>>>>>>>>>>>    //      sViewTitle      Current caption of the view (can be "").
23012>>>>>>>>>>>    Procedure OnGeneratePageTitle String ByRef sTitle Handle hoView String sViewTitle
23014>>>>>>>>>>>        If (Trim(sViewTitle) <> "") Begin
23016>>>>>>>>>>>            Move (sTitle + " - " + sViewTitle) to sTitle
23017>>>>>>>>>>>        End
23017>>>>>>>>>>>>
23017>>>>>>>>>>>    End_Procedure
23018>>>>>>>>>>>    
23018>>>>>>>>>>>    
23018>>>>>>>>>>>    // Updates the page title by generating the full title based on the passed view title.
23018>>>>>>>>>>>    //
23018>>>>>>>>>>>    // Params:
23018>>>>>>>>>>>    //      hoView      Handle to the current view (can be C_WebUnresolvedObject).
23018>>>>>>>>>>>    //      sViewTitle  Current view caption.
23018>>>>>>>>>>>    Procedure UpdatePageTitle Handle hoView String sViewTitle
23020>>>>>>>>>>>        String sTitle
23020>>>>>>>>>>>        Boolean bUpdate
23020>>>>>>>>>>>        
23020>>>>>>>>>>>        WebGet pbUpdateApplicationTitle to bUpdate
23021>>>>>>>>>>>        
23021>>>>>>>>>>>        If (bUpdate) Begin
23023>>>>>>>>>>>            WebGet psApplicationTitle to sTitle
23024>>>>>>>>>>>            
23024>>>>>>>>>>>            Send OnGeneratePageTitle (&sTitle) hoView sViewTitle
23025>>>>>>>>>>>            
23025>>>>>>>>>>>            Send SetPageTitle sTitle
23026>>>>>>>>>>>        End
23026>>>>>>>>>>>>
23026>>>>>>>>>>>    End_Procedure
23027>>>>>>>>>>>
23027>>>>>>>>>>>
23027>>>>>>>>>>>    // This can be sent to any child object to retrieve the object handle of the parent view via delegation.
23027>>>>>>>>>>>    // If delegation reaches here it means there is no view object so we return C_WebUnresolvedObject.
23027>>>>>>>>>>>    Function ViewObject Returns Handle
23029>>>>>>>>>>>        Function_Return C_WebUnresolvedObject
23030>>>>>>>>>>>    End_Function
23031>>>>>>>>>>>    
23031>>>>>>>>>>>    
23031>>>>>>>>>>>    // Locate_Server and Server are used so that child objects can resolve 
23031>>>>>>>>>>>    // that a server does not exit.
23031>>>>>>>>>>>    Function Locate_Server Returns Handle
23033>>>>>>>>>>>        Function_Return 0
23034>>>>>>>>>>>    End_Function
23035>>>>>>>>>>>    
23035>>>>>>>>>>>    
23035>>>>>>>>>>>    Function Server Returns Handle
23037>>>>>>>>>>>        Function_Return 0
23038>>>>>>>>>>>    End_Function
23039>>>>>>>>>>>
23039>>>>>>>>>>>    // Determines if an initial view (like a login dialog) needs to be shown. Overriden in
23039>>>>>>>>>>>    // cWebSessionHost_mixin to handle showing of a login view.
23039>>>>>>>>>>>    //
23039>>>>>>>>>>>    // Returns:
23039>>>>>>>>>>>    //  Handle to the initial view that needs to be shown (C_WebUnresolvedObject if none)
23039>>>>>>>>>>>    Function ForcedInitialView Returns Handle
23041>>>>>>>>>>>        Function_Return C_WebUnresolvedObject
23042>>>>>>>>>>>    End_Function
23043>>>>>>>>>>>
23043>>>>>>>>>>>    // returns the default view, which is normally phoDefaultView.
23043>>>>>>>>>>>    // Is provided for augmentation so developers can specify the default view dynamically
23043>>>>>>>>>>>    Function GetDefaultView Returns Handle
23045>>>>>>>>>>>        Handle hoView
23045>>>>>>>>>>>        Get phoDefaultView to hoView
23046>>>>>>>>>>>        Function_Return hoView
23047>>>>>>>>>>>    End_Function
23048>>>>>>>>>>>
23048>>>>>>>>>>>    // Synchronizes the current records with the passed row id's for each DDO in the
23048>>>>>>>>>>>    // passed collection of DDO structures. Each Structure in the collection belongs
23048>>>>>>>>>>>    // to a different view. The aDDOViews parameter is populated with the object handle
23048>>>>>>>>>>>    // of each view referenced in the aDDODefs collection
23048>>>>>>>>>>>    //
23048>>>>>>>>>>>    // During this process the view is tested for AllowViewAccess. If access is denied to
23048>>>>>>>>>>>    // any view in the stack then SynchronizeDDOs is aborted and the function returns False.
23048>>>>>>>>>>>    Procedure Call_PreSync tWebCallContext ByRef cctx
23050>>>>>>>>>>>        Integer i icDDODef
23050>>>>>>>>>>>        Handle[] aDDOViews
23051>>>>>>>>>>>        Handle hoInvokingObject
23051>>>>>>>>>>>        
23051>>>>>>>>>>>        Send NotifySyncWebApp         
23052>>>>>>>>>>>        
23052>>>>>>>>>>>        // Iterate the DDODefs array and synchronize the DDOs for each view....
23052>>>>>>>>>>>        Move (SizeOfArray(cctx.request.Header.aDDOViews)) to icDDODef
23053>>>>>>>>>>>        
23053>>>>>>>>>>>        //  First get all the object references
23053>>>>>>>>>>>        For i from 0 to (icDDODef - 1)
23059>>>>>>>>>>>>
23059>>>>>>>>>>>            // Get the array of object handles to the views referenced in the request header's aDDODefs collection....
23059>>>>>>>>>>>            Get GetAjaxWebAppView of (phoWebControlLocator(Self)) cctx.request.Header.aDDOViews[i] to aDDOViews[i]
23060>>>>>>>>>>>        Loop
23061>>>>>>>>>>>>
23061>>>>>>>>>>>        
23061>>>>>>>>>>>        Set paDDOViews to aDDOViews
23062>>>>>>>>>>>        
23062>>>>>>>>>>>        //  Now update data bindings (note that this needs to happen after paDDOViews is set for accessibility checks
23062>>>>>>>>>>>        For i from 0 to (icDDODef - 1)
23068>>>>>>>>>>>>
23068>>>>>>>>>>>            // Process the synchronized psValue and pbChanged properties for each control that has a data binding
23068>>>>>>>>>>>            Broadcast Recursive Send UpdateDataBinding to aDDOViews[i]
23070>>>>>>>>>>>            
23070>>>>>>>>>>>            // Get the invoking object, as this might create dynamic objects which could sync their DDO's and we don't want that to happen later
23070>>>>>>>>>>>            Get GetInvokingObject of aDDOViews[i] to hoInvokingObject
23071>>>>>>>>>>>        Loop
23072>>>>>>>>>>>>
23072>>>>>>>>>>>    End_Procedure
23073>>>>>>>>>>>
23073>>>>>>>>>>>    Procedure Call_PostOnCallEnd tWebCallContext ByRef cctx
23075>>>>>>>>>>>        Integer i icDDODef
23075>>>>>>>>>>>        Handle[] aDDOViews
23076>>>>>>>>>>>        
23076>>>>>>>>>>>        // Iterate all the DDODefs in the Request and return the DDODefs for each one in the response
23076>>>>>>>>>>>        Get paDDOViews to aDDOViews
23077>>>>>>>>>>>        Move (SizeOfArray(aDDOViews)) to icDDODef
23078>>>>>>>>>>>        
23078>>>>>>>>>>>        For i from 0 to (icDDODef - 1)
23084>>>>>>>>>>>>
23084>>>>>>>>>>>            Send TriggerOnCallEnd of aDDOViews[i]
23085>>>>>>>>>>>        Loop
23086>>>>>>>>>>>>
23086>>>>>>>>>>>        
23086>>>>>>>>>>>        Send TriggerOnCallEnd
23087>>>>>>>>>>>    End_Procedure
23088>>>>>>>>>>>    
23088>>>>>>>>>>>    // This event is sent for every AJAX call to this view. This can be used by your
23088>>>>>>>>>>>    // security rights management system to set various global rights and roles constraints
23088>>>>>>>>>>>    // properties during each AJAX call.
23088>>>>>>>>>>>    // Note: You should not use web properties for this purpose since synchronized
23088>>>>>>>>>>>    // properties are sync'ed to the client and thus considered insecure.
23088>>>>>>>>>>>    Procedure OnSyncWebApp
23090>>>>>>>>>>>    End_Procedure
23091>>>>>>>>>>>    
23091>>>>>>>>>>>    Procedure NotifySyncWebApp
23093>>>>>>>>>>>        Send OnSyncWebApp
23094>>>>>>>>>>>    End_Procedure
23095>>>>>>>>>>>
23095>>>>>>>>>>>    Procedure End_Construct_cWebViewHost_mixin
23097>>>>>>>>>>>        WebPublishFunction LoadView
23098>>>>>>>>>>>        WebPublishProcedure LoadViewCallBack_CallBack
23099>>>>>>>>>>>        WebPublishProcedure ShowView_FromClient
23100>>>>>>>>>>>    End_Procedure
23101>>>>>>>>>>>
23101>>>>>>>>>>>End_Class
23102>>>>>>>>>
23102>>>>>>>>>Register_Procedure OnUpdateViewStack
23102>>>>>>>>>
23102>>>>>>>>>// Singleton stack object. Store and manipulates information about the stack of views
23102>>>>>>>>>// in a drill-down navigation architecture.
23102>>>>>>>>>Class cWebViewStack is a cWebObject
23103>>>>>>>>>    
23103>>>>>>>>>    Procedure Construct_Object
23105>>>>>>>>>        Forward Send Construct_Object
23107>>>>>>>>>        
23107>>>>>>>>>        // Global handle is deprecated.
23107>>>>>>>>>        Move Self to ghoWebViewStack
23108>>>>>>>>>        // Set the viewstack of the cWebApp or cLocalWebControlHost to this object
23108>>>>>>>>>        Set phoViewStack of (Host(Self)) to Self
23109>>>>>>>>>        
23109>>>>>>>>>        Property tWebViewInfo[] paViewStack    // The stack of current views navigated to in the drill-down view stack.
23112>>>>>>>>>        
23112>>>>>>>>>        Property Handle[] paClientControls     // Array of client web controls that are notified whenever the view stack is modified
23113>>>>>>>>>    End_Procedure 
23114>>>>>>>>>
23114>>>>>>>>>    
23114>>>>>>>>>    // Returns the total number of views currently in the view stack.
23114>>>>>>>>>    Function ViewStackSize Returns Integer
23116>>>>>>>>>        Integer iCount
23116>>>>>>>>>        tWebViewInfo[] aViewStack
23116>>>>>>>>>        tWebViewInfo[] aViewStack
23117>>>>>>>>>        WebGet paViewStack to aViewStack
23118>>>>>>>>>        Move (SizeOfArray(aViewStack)) to iCount
23119>>>>>>>>>        Function_Return iCount
23120>>>>>>>>>    End_Function
23121>>>>>>>>>
23121>>>>>>>>>        
23121>>>>>>>>>    // Adds a new client object to the set of listening client objects.
23121>>>>>>>>>    // See also NotifyClients
23121>>>>>>>>>    Procedure AddClient Handle hoClient
23123>>>>>>>>>        Integer iCount
23123>>>>>>>>>        Handle[] aClientControls
23124>>>>>>>>>        
23124>>>>>>>>>        Get paClientControls to aClientControls
23125>>>>>>>>>        Move (SizeOfArray(aClientControls)) to iCount
23126>>>>>>>>>        Move hoClient to aClientControls[iCount]
23127>>>>>>>>>        Set paClientControls to aClientControls
23128>>>>>>>>>    End_Procedure
23129>>>>>>>>>
23129>>>>>>>>>
23129>>>>>>>>>
23129>>>>>>>>>    // sReason - [Out] Passes back the reason why Pop View is not allowed.
23129>>>>>>>>>    // Returns true if you can pop the passed View. 
23129>>>>>>>>>    // Returns False if the view is not at the top of the stack
23129>>>>>>>>>    Function CanPopView Handle hoView String ByRef sReason Returns Boolean
23131>>>>>>>>>        Integer iCount
23131>>>>>>>>>        String sViewName
23131>>>>>>>>>        tWebViewInfo[] aViewStack
23131>>>>>>>>>        tWebViewInfo[] aViewStack
23132>>>>>>>>>        
23132>>>>>>>>>        //Send DeserializeViewStack
23132>>>>>>>>>        WebGet paViewStack to aViewStack
23133>>>>>>>>>        Move (SizeOfArray(aViewStack)) to iCount
23134>>>>>>>>>        Get WebObjectName of hoView to sViewName
23135>>>>>>>>>        
23135>>>>>>>>>        If (iCount > 0 and sViewName = aViewStack[iCount-1].sViewName) Begin
23137>>>>>>>>>            Function_Return True
23138>>>>>>>>>        End
23138>>>>>>>>>>
23138>>>>>>>>>        Else Begin
23139>>>>>>>>>            Move "This is not the top view." to sReason
23140>>>>>>>>>            Function_Return False
23141>>>>>>>>>        End
23141>>>>>>>>>>
23141>>>>>>>>>    End_Function
23142>>>>>>>>>    
23142>>>>>>>>>    // sReason - [Out] Passes back the reason why Push View is not allowed.
23142>>>>>>>>>    // Returns true if you can push the passed View. 
23142>>>>>>>>>    // Returns False If the view is already on the view stack.
23142>>>>>>>>>    Function CanPushView Handle hoView String ByRef sReason Returns Boolean
23144>>>>>>>>>        Integer iIndex
23144>>>>>>>>>        Boolean bOK
23144>>>>>>>>>        
23144>>>>>>>>>        Get GetViewIndex hoView to iIndex
23145>>>>>>>>>        Move (iIndex = -1) to bOK
23146>>>>>>>>>        If (not(bOK)) Begin
23148>>>>>>>>>            Move "View is already in the view stack." to sReason        
23149>>>>>>>>>        End
23149>>>>>>>>>>
23149>>>>>>>>>        Function_Return bOK
23150>>>>>>>>>    End_Function
23151>>>>>>>>>
23151>>>>>>>>>    
23151>>>>>>>>>    // Returns the index in the view stack of the passed view handle. 
23151>>>>>>>>>    // Returns -1 if the view is not in the stack
23151>>>>>>>>>    Function GetViewIndex Handle hoView Returns Integer
23153>>>>>>>>>        Integer i iCount
23153>>>>>>>>>        String sViewName
23153>>>>>>>>>        tWebViewInfo[] aViewStack
23153>>>>>>>>>        tWebViewInfo[] aViewStack
23154>>>>>>>>>
23154>>>>>>>>>        If (hoView <> 0) Begin        
23156>>>>>>>>>            WebGet paViewStack to aViewStack
23157>>>>>>>>>            Move (SizeOfArray(aViewStack)) to iCount
23158>>>>>>>>>            Get WebObjectName of hoView to sViewName
23159>>>>>>>>>            
23159>>>>>>>>>            For i from 0 to (iCount-1)
23165>>>>>>>>>>
23165>>>>>>>>>                If (sViewName = aViewStack[i].sViewName) Begin
23167>>>>>>>>>                    Function_Return i
23168>>>>>>>>>                End
23168>>>>>>>>>>
23168>>>>>>>>>            Loop
23169>>>>>>>>>>
23169>>>>>>>>>        End
23169>>>>>>>>>>
23169>>>>>>>>>        
23169>>>>>>>>>        Function_Return -1
23170>>>>>>>>>    End_Function
23171>>>>>>>>>
23171>>>>>>>>>
23171>>>>>>>>>    // Returns the view handle of the view below the top of stack. 
23171>>>>>>>>>    // Returns 0 If there are less than two views in the stack.
23171>>>>>>>>>    // See also TopViewHandle.
23171>>>>>>>>>    Function InvokingViewHandle Returns Handle
23173>>>>>>>>>        Integer iTop
23173>>>>>>>>>        Handle hoView
23173>>>>>>>>>        tWebViewInfo[] aViewStack
23173>>>>>>>>>        tWebViewInfo[] aViewStack
23174>>>>>>>>>
23174>>>>>>>>>        // Update the stack
23174>>>>>>>>>        //Send DeserializeViewStack
23174>>>>>>>>>        WebGet paViewStack to aViewStack
23175>>>>>>>>>        Move (SizeOfArray(aViewStack)) to iTop
23176>>>>>>>>>            
23176>>>>>>>>>        If (iTop < 2) Begin
23178>>>>>>>>>            Function_Return 0
23179>>>>>>>>>        End
23179>>>>>>>>>>
23179>>>>>>>>>        Else Begin
23180>>>>>>>>>            Get WebObjectByName aViewStack[iTop-2].sViewName to hoView
23181>>>>>>>>>            Function_Return hoView
23182>>>>>>>>>        End
23182>>>>>>>>>>
23182>>>>>>>>>    End_Function
23183>>>>>>>>>    
23183>>>>>>>>>    // Returns the view handle of the invoking view of a specific view that is on the stack. 
23183>>>>>>>>>    // Returns C_WebUnresolvedObject if the view is not found on the stack.
23183>>>>>>>>>    Function InvokingViewHandleByView Handle hoView Returns Handle
23185>>>>>>>>>        Integer iIndex
23185>>>>>>>>>
23185>>>>>>>>>        tWebViewInfo[] aViewStack
23185>>>>>>>>>        tWebViewInfo[] aViewStack
23186>>>>>>>>>
23186>>>>>>>>>        // Update the stack
23186>>>>>>>>>        //Send DeserializeViewStack
23186>>>>>>>>>        WebGet paViewStack to aViewStack
23187>>>>>>>>>        
23187>>>>>>>>>        Get GetViewIndex hoView to iIndex
23188>>>>>>>>>        If (iIndex > 0) Begin
23190>>>>>>>>>       
23190>>>>>>>>>            Get WebObjectByName aViewStack[iIndex-1].sViewName to hoView
23191>>>>>>>>>            Function_Return hoView
23192>>>>>>>>>        End
23192>>>>>>>>>>
23192>>>>>>>>>        
23192>>>>>>>>>        Function_Return C_WebUnresolvedObject
23193>>>>>>>>>    End_Function
23194>>>>>>>>>    
23194>>>>>>>>>    
23194>>>>>>>>>    // Returns the view in the stack after the passed view. So the view of which the passed view is
23194>>>>>>>>>    // the invoking view. If the passed view is not in the stack or is the top view then
23194>>>>>>>>>    // C_WebUnresolvedObject will be returned.
23194>>>>>>>>>    Function NextViewHandleByView Handle hoView Returns Handle
23196>>>>>>>>>        Integer iIndex
23196>>>>>>>>>
23196>>>>>>>>>        tWebViewInfo[] aViewStack
23196>>>>>>>>>        tWebViewInfo[] aViewStack
23197>>>>>>>>>
23197>>>>>>>>>        // Update the stack
23197>>>>>>>>>        //Send DeserializeViewStack
23197>>>>>>>>>        WebGet paViewStack to aViewStack
23198>>>>>>>>>        
23198>>>>>>>>>        Get GetViewIndex hoView to iIndex
23199>>>>>>>>>        If (iIndex < SizeOfArray(aViewStack) - 1) Begin
23201>>>>>>>>>       
23201>>>>>>>>>            Get WebObjectByName aViewStack[iIndex+1].sViewName to hoView
23202>>>>>>>>>            Function_Return hoView
23203>>>>>>>>>        End
23203>>>>>>>>>>
23203>>>>>>>>>        
23203>>>>>>>>>        Function_Return C_WebUnresolvedObject
23204>>>>>>>>>    End_Function
23205>>>>>>>>>
23205>>>>>>>>>    
23205>>>>>>>>>    // Notifies all listening client objects that the view stack has changed.
23205>>>>>>>>>    // These objects must understand the OnUpdateViewStack event.
23205>>>>>>>>>    // See also AddClient
23205>>>>>>>>>    Procedure NotifyClients
23207>>>>>>>>>        Integer i iCount
23207>>>>>>>>>        Handle[] aClientControls
23208>>>>>>>>>        
23208>>>>>>>>>        Get paClientControls to aClientControls
23209>>>>>>>>>        Move (SizeOfArray(aClientControls)) to iCount
23210>>>>>>>>>        
23210>>>>>>>>>        For i from 0 to (iCount-1)
23216>>>>>>>>>>
23216>>>>>>>>>            Send OnUpdateViewStack to aClientControls[i]
23217>>>>>>>>>        Loop
23218>>>>>>>>>>
23218>>>>>>>>>    End_Procedure
23219>>>>>>>>>    
23219>>>>>>>>>    
23219>>>>>>>>>    // Pops all members of the stack down to the passed view handle. If the view is
23219>>>>>>>>>    // not on the stack then nothing is removed.
23219>>>>>>>>>    Procedure PopDownToView Handle hoView
23221>>>>>>>>>        Integer iIndex iTopOfStack
23221>>>>>>>>>        tWebViewInfo[] aViewStack
23221>>>>>>>>>        tWebViewInfo[] aViewStack
23222>>>>>>>>>
23222>>>>>>>>>        Get GetViewIndex hoView to iIndex
23223>>>>>>>>>        
23223>>>>>>>>>        If (iIndex <> -1) Begin
23225>>>>>>>>>            // Update the stack
23225>>>>>>>>>            WebGet paViewStack to aViewStack
23226>>>>>>>>>            Move (ResizeArray(aViewStack, iIndex+1)) to aViewStack
23227>>>>>>>>>            WebSet paViewStack to aViewStack        
23228>>>>>>>>>            Send NotifyClients    // Notify the view stack clients of this change
23229>>>>>>>>>        End
23229>>>>>>>>>>
23229>>>>>>>>>    End_Procedure
23230>>>>>>>>>
23230>>>>>>>>>
23230>>>>>>>>>    // Pops a view off the top of the view stack.
23230>>>>>>>>>    Procedure PopView
23232>>>>>>>>>        Integer iTop
23232>>>>>>>>>        tWebViewInfo[] aViewStack
23232>>>>>>>>>        tWebViewInfo[] aViewStack
23233>>>>>>>>>
23233>>>>>>>>>        // Update the stack
23233>>>>>>>>>        WebGet paViewStack to aViewStack
23234>>>>>>>>>        Move (SizeOfArray(aViewStack)) to iTop
23235>>>>>>>>>        
23235>>>>>>>>>        If (iTop = 0) Begin
23237>>>>>>>>>            Error DFERR_PROGRAM "View Stack Error: Pop past end of stack"
23238>>>>>>>>>>
23238>>>>>>>>>        End
23238>>>>>>>>>>
23238>>>>>>>>>        Else Begin
23239>>>>>>>>>            Move (ResizeArray(aViewStack, iTop - 1)) to aViewStack
23240>>>>>>>>>            WebSet paViewStack to aViewStack        
23241>>>>>>>>>            Send NotifyClients    // Notify the view stack clients of this change
23242>>>>>>>>>        End
23242>>>>>>>>>>
23242>>>>>>>>>    End_Procedure
23243>>>>>>>>>
23243>>>>>>>>>    
23243>>>>>>>>>    // Pushes a new view to the top of the view stack (Note: we assume hoView's web properties are in scope).
23243>>>>>>>>>    Procedure PushView Handle hoView Integer eNavigateType
23245>>>>>>>>>        Handle hoMainDD
23245>>>>>>>>>        Integer iTop
23245>>>>>>>>>        tWebViewInfo ViewInfo
23245>>>>>>>>>        tWebViewInfo ViewInfo
23245>>>>>>>>>        tWebViewInfo[] aViewStack
23245>>>>>>>>>        tWebViewInfo[] aViewStack
23246>>>>>>>>>        RowID riId
23246>>>>>>>>>        // Before pushing any new view onto the stack we want 
23246>>>>>>>>>        // to retrieve the latest "Should_Save state of the
23246>>>>>>>>>        // current top view...
23246>>>>>>>>>        Send UpdateShouldSave
23247>>>>>>>>>        
23247>>>>>>>>>        // Populate the ViewInfo struct
23247>>>>>>>>>        Get WebObjectName of hoView  to ViewInfo.sViewName
23248>>>>>>>>>        WebGet psCaption of hoView   to ViewInfo.sCaption
23249>>>>>>>>>        Move ViewInfo.sCaption       to ViewInfo.sHeaderCaption    // by default these are both set to the same value
23250>>>>>>>>>        Get peViewType of hoView     to ViewInfo.eViewType
23251>>>>>>>>>        Move eNavigateType           to ViewInfo.eNavigateType 
23252>>>>>>>>>        
23252>>>>>>>>>        Get Main_DD of hoView to hoMainDD
23253>>>>>>>>>        If (hoMainDD <> 0) Begin
23255>>>>>>>>>            Get Main_File of hoMainDD to ViewInfo.iMainTable
23256>>>>>>>>>            Get CurrentRowId of hoMainDD to riId
23257>>>>>>>>>            Move riId to ViewInfo.riMainTable
23258>>>>>>>>>//            Move (SerializeRowID(riId)) to ViewInfo.sMainTableRowID
23258>>>>>>>>>        End
23258>>>>>>>>>>
23258>>>>>>>>>        
23258>>>>>>>>>        // Update the stack
23258>>>>>>>>>        WebGet paViewStack to aViewStack
23259>>>>>>>>>        Move (InsertInArray(aViewStack,-1,ViewInfo)) to aViewStack
23260>>>>>>>>>        WebSet paViewStack to aViewStack        
23261>>>>>>>>>        Send NotifyClients    // Notify the view stack clients of this change
23262>>>>>>>>>    End_Procedure
23263>>>>>>>>>    
23263>>>>>>>>>    // returns handle of object we can close up to
23263>>>>>>>>>    // hoCloseToView is the view you want to close to. If 0, it's all.
23263>>>>>>>>>    // bSkipTop deremines if you should skip the top of the stack, which sometimes gets special
23263>>>>>>>>>    // treatment.
23263>>>>>>>>>    Function CanCloseViews Handle hoCloseToView Boolean bSkipTop Returns Handle
23265>>>>>>>>>        tWebViewInfo[] aViewStack
23265>>>>>>>>>        tWebViewInfo[] aViewStack
23266>>>>>>>>>        Integer iStackViews eCloseAction
23266>>>>>>>>>        Handle hoView
23266>>>>>>>>>        Boolean bStop
23266>>>>>>>>>        Send UpdateShouldSave to (ViewStack(Self))
23267>>>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
23268>>>>>>>>>        Move (SizeOfArray(aViewStack)) to iStackViews
23269>>>>>>>>>        If bSkipTop Begin
23271>>>>>>>>>            Decrement iStackViews
23272>>>>>>>>>        End
23272>>>>>>>>>>
23272>>>>>>>>>        While (iStackViews and not(bStop))
23276>>>>>>>>>            Decrement iStackViews
23277>>>>>>>>>            Get WebObjectByName aViewStack[iStackViews].sViewName to hoView
23278>>>>>>>>>            If (hoView=hoCloseToView) Begin
23280>>>>>>>>>                Move 0 to iStackViews
23281>>>>>>>>>            End
23281>>>>>>>>>>
23281>>>>>>>>>            Else If (aViewStack[iStackViews].bShouldSave) Begin
23284>>>>>>>>>                Get GetChangedViewExitAction of hoView to eCloseAction 
23285>>>>>>>>>                // we only allow a close if it is a pure adandon changes.
23285>>>>>>>>>                If (eCloseAction<>cveAbandonChanges) Begin
23287>>>>>>>>>                   Function_Return hoView 
23288>>>>>>>>>                End
23288>>>>>>>>>>
23288>>>>>>>>>            End
23288>>>>>>>>>>
23288>>>>>>>>>        Loop
23289>>>>>>>>>>
23289>>>>>>>>>        Function_Return hoCloseToView
23290>>>>>>>>>    End_Function

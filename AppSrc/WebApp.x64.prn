7214>>>>>>>>>>>Procedure Seq_Close_Channel Global Integer iChannel
7216>>>>>>>>>>>    Integer iMode
7216>>>>>>>>>>>    
7216>>>>>>>>>>>    If ((iChannel >= DF_SEQ_CHANNEL_MIN) and (iChannel <= DF_SEQ_CHANNEL_MAX)) Begin
7218>>>>>>>>>>>        Move (Seq_Channel_Mode(iChannel)) to iMode
7219>>>>>>>>>>>        
7219>>>>>>>>>>>        If (iMode = DF_SEQ_CHANNEL_MODE_OUTPUT) Begin
7221>>>>>>>>>>>            Close_Output channel iChannel
7223>>>>>>>>>>>        End
7223>>>>>>>>>>>>
7223>>>>>>>>>>>        Else If (iMode = DF_SEQ_CHANNEL_MODE_INPUT) Begin
7226>>>>>>>>>>>            Close_Input channel iChannel
7228>>>>>>>>>>>        End
7228>>>>>>>>>>>>
7228>>>>>>>>>>>        // If channel not open, release it! No (fatal) Error.
7228>>>>>>>>>>>        Send Seq_Release_Channel iChannel

11344>>>>>>>    End_Function
11345>>>>>>>    
11345>>>>>>>    
11345>>>>>>>    // returns the Index from list of loaded drivers for sDriver. 0 if not found.
11345>>>>>>>    // This searches all loaded drivers which may include drivers that were
11345>>>>>>>    // not registered
11345>>>>>>>    Function DriverIndex String sDriver Returns Integer
11347>>>>>>>        Integer iDrivers i
11347>>>>>>>        String sADriver
11347>>>>>>>        Move (Uppercase(sDriver)) to sDriver
11348>>>>>>>        Get_Attribute DF_NUMBER_DRIVERS to iDrivers
11351>>>>>>>        For i from 1 to iDrivers
11357>>>>>>>>
11357>>>>>>>            Get_Attribute DF_DRIVER_NAME of i to sADriver
11360>>>>>>>            If (sDriver=Uppercase(sADriver)) Begin
11362>>>>>>>                Function_Return i
11363>>>>>>>            End
11363>>>>>>>>
11363>>>>>>>        Loop
11364>>>>>>>>
11364>>>>>>>        Function_Return 0
11365>>>>>>>    End_Function
11366>>>>>>>    
11366>>>>>>>    // returns cConnectionCLIHandler object for this driver id.
11366>>>>>>>    // This must be a registered managed driver. If not found return 0
11366>>>>>>>    // This can be used to test if a driver is registered (and therefore loaded)
11366>>>>>>>    Function DriverCLIHandler String sDriver Returns Handle
11368>>>>>>>        Integer iIndex
11368>>>>>>>        tDriverCLIDictionary[] DriverMap
11368>>>>>>>        tDriverCLIDictionary[] DriverMap
11369>>>>>>>        tDriverCLIDictionary DriverItem
11369>>>>>>>        tDriverCLIDictionary DriverItem
11369>>>>>>>        Move (Trim(Uppercase(sDriver))) to sDriver
11370>>>>>>>        Move sDriver to DriverItem.sDriver
11371>>>>>>>        Get pRegisteredDriversDict to DriverMap
11372>>>>>>>        Move (SearchArray(DriverItem,DriverMap)) to iIndex
11373>>>>>>>        If (iIndex<>-1) Begin
11375>>>>>>>            Function_Return DriverMap[iIndex].hoCLI
11376>>>>>>>        End
11376>>>>>>>>
11376>>>>>>>        Function_Return 0
11377>>>>>>>    End_Function
11378>>>>>>>    
11378>>>>>>>    // low level load which does not register the driver - only loads
11378>>>>>>>    Function LoadDriver String sDriver Returns Boolean
11380>>>>>>>        Integer iErrorNumber
11380>>>>>>>        Send TrapErrors
11381>>>>>>>        Load_Driver sDriver
11382>>>>>>>        Send UnTrapErrors
11383>>>>>>>        Get piErrorNumber to iErrorNumber
11384>>>>>>>        Function_Return (iErrorNumber=0)
11385>>>>>>>    End_Function
11386>>>>>>>    
11386>>>>>>>    Function TestDriverConformance String sDriver Integer iDriver Handle hoCLI Returns Boolean
11388>>>>>>>        Integer iConformance
11388>>>>>>>        Get_Attribute DF_DRIVER_CONFORMANCE of iDriver to iConformance
11391>>>>>>>        If (not(iConformance iand 8)) Begin // bit 4 is managed driver conformance
11393>>>>>>>            Send ConfigurationError DFERR_SETUP (SFormat(C_$DriverIsNotManaged,sDriver))
11394>>>>>>>            Function_Return False
11395>>>>>>>        End
11395>>>>>>>>
11395>>>>>>>        Function_Return True
11396>>>>>>>    End_Function
11397>>>>>>>    
11397>>>>>>>    // registers this driver. Load driver if not yet loaded
11397>>>>>>>    // returns cConnectionCLIHandler handle for this driver.
11397>>>>>>>    // If registered, just return the handle
11397>>>>>>>    // returns 0 if driver cannot be loaded
11397>>>>>>>    // If newly registered here, sends OnDriverRegistered event
11397>>>>>>>    // raises error if driver cannot be loaded or does not conform
11397>>>>>>>    Function RegisterDriver String sDriver Returns Handle
11399>>>>>>>        Integer iIndex iDriver iConformance
11399>>>>>>>        Handle hoCLI hClass
11399>>>>>>>        Boolean bOk
11399>>>>>>>        Boolean bAutoLogin
11399>>>>>>>        tDriverCLIDictionary[] DriverMap
11399>>>>>>>        tDriverCLIDictionary[] DriverMap
11400>>>>>>>        Integer iIds iRet
11400>>>>>>>        String sId
11400>>>>>>>        Get DriverCLIHandler sDriver to hoCLI
11401>>>>>>>        If (hoCLI=0) Begin // driver not registered yet
11403>>>>>>>            Get pRegisteredDriversDict to DriverMap
11404>>>>>>>            Get phcDriverConnection to hClass
11405>>>>>>>            Get CreateNamed hClass ("oCLI_"+sDriver) to hoCLI
11406>>>>>>>            Move (SizeOfArray(DriverMap)) to iIndex
11407>>>>>>>            Move (Trim(Uppercase(sDriver)))  to DriverMap[iIndex].sDriver
11408>>>>>>>            Move hoCLI to DriverMap[iIndex].hoCLI
11409>>>>>>>            Set pRegisteredDriversDict to DriverMap
11410>>>>>>>            Set psDriverID of hoCLI to DriverMap[iIndex].sDriver
11411>>>>>>>            
11411>>>>>>>            Get DriverIndex DriverMap[iIndex].sDriver to iDriver
11412>>>>>>>            Move (iDriver>0) to bOk // is driver already loaded (just not registered)
11413>>>>>>>            If not bOk Begin
11415>>>>>>>                Get LoadDriver DriverMap[iIndex].sDriver to bOk
11416>>>>>>>                If bOk Begin
11418>>>>>>>                    Get DriverIndex DriverMap[iIndex].sDriver to iDriver
11419>>>>>>>                End
11419>>>>>>>>
11419>>>>>>>                Else Begin
11420>>>>>>>                    Send ConfigurationError DFERR_SETUP (SFormat(C_$DriverNotFound,sDriver))
11421>>>>>>>                End
11421>>>>>>>>
11421>>>>>>>            End
11421>>>>>>>>
11421>>>>>>>            
11421>>>>>>>            // finally make sure loaded driver supports managed connections and any other
11421>>>>>>>            // tests that might be applied by the developer
11421>>>>>>>            If bOk Begin
11423>>>>>>>                Get TestDriverConformance sDriver iDriver hoCLI to bOk
11424>>>>>>>            End
11424>>>>>>>>
11424>>>>>>>            
11424>>>>>>>            If not bOk Begin
11426>>>>>>>                Send Destroy of hoCLI
11427>>>>>>>                Move 0 to hoCLI
11428>>>>>>>                Move (RemoveFromArray(DriverMap,iIndex)) to DriverMap
11429>>>>>>>                Set pRegisteredDriversDict to DriverMap
11430>>>>>>>            End
11430>>>>>>>>
11430>>>>>>>            Else Begin
11431>>>>>>>                // driver is loaded and valid, complete registration
11431>>>>>>>                
11431>>>>>>>                // is auto-login on open supported?
11431>>>>>>>                Get pbLoginOnOpen to bAutoLogin
11432>>>>>>>                Set_Attribute DF_DRIVER_LOGIN_ON_OPEN of iDriver to bAutoLogin
11435>>>>>>>                
11435>>>>>>>                // remove existing connection IDs as defined in the driver.int file. If you are
11435>>>>>>>                // using registered connections, you are using registered drivers!
11435>>>>>>>                Get_Attribute DF_DRIVER_NUMBER_CONNECTION_IDS of iDriver to iIds
11438>>>>>>>                While (iIds>0)
11442>>>>>>>                    Decrement iIds
11443>>>>>>>                    Get DeleteConnectionID of hoCLI "" iIds to iRet
11444>>>>>>>                Loop
11445>>>>>>>>
11445>>>>>>>                
11445>>>>>>>                Send OnDriverRegistered sDriver iDriver hoCLI
11446>>>>>>>            End
11446>>>>>>>>
11446>>>>>>>        End
11446>>>>>>>>
11446>>>>>>>        Function_Return hoCLI
11447>>>>>>>    End_Function
11448>>>>>>>    
11448>>>>>>>    
11448>>>>>>>    
11448>>>>>>>    // returns a string array of loaded drivers (managed and unmanaged)
11448>>>>>>>    Function LoadedDrivers Returns String[]
11450>>>>>>>        Integer iDrivers i
11450>>>>>>>        String[] ArrayOfDrivers
11451>>>>>>>        Get_Attribute DF_NUMBER_DRIVERS to iDrivers
11454>>>>>>>        For i from 1 to iDrivers
11460>>>>>>>>
11460>>>>>>>            Get_Attribute DF_DRIVER_NAME of i to ArrayOfDrivers[i-1]
11463>>>>>>>        Loop
11464>>>>>>>>
11464>>>>>>>        Function_Return ArrayOfDrivers
11465>>>>>>>    End_Function
11466>>>>>>>    
11466>>>>>>>    // list of all Server connection-strings logged into this driver.
11466>>>>>>>    // This includes managed/registered strings and strings used in non-managed ways (e.g., in int file)
11466>>>>>>>    Function DriverServerNames String sDriver Returns String[]
11468>>>>>>>        Integer iConnections i iDriver
11468>>>>>>>        String[] Connections
11469>>>>>>>        Get DriverIndex sDriver to iDriver
11470>>>>>>>        If (iDriver>0) Begin
11472>>>>>>>            Get_Attribute DF_DRIVER_NUMBER_SERVERS of iDriver to iConnections
11475>>>>>>>            For i from 0 to (iConnections-1)
11481>>>>>>>>
11481>>>>>>>                Get_Attribute DF_DRIVER_SERVER_NAME of iDriver (i+1) to Connections[i]
11484>>>>>>>            Loop
11485>>>>>>>>
11485>>>>>>>        End
11485>>>>>>>>
11485>>>>>>>        Function_Return Connections
11486>>>>>>>    End_Function
11487>>>>>>>       
11487>>>>>>>    // adds a token connection ID and handle to token provider
11487>>>>>>>    Procedure SetTokenConnection String sConnectionID Handle hTokenProvider
11489>>>>>>>        Integer iIndex, iCount
11489>>>>>>>        String  sTokenConnectionID
11489>>>>>>>        tTokenConnection[] aTokenConnections
11489>>>>>>>        tTokenConnection[] aTokenConnections
11490>>>>>>>        
11490>>>>>>>        Get pTokenConnections to aTokenConnections
11491>>>>>>>        Move sConnectionID to sTokenConnectionID
11492>>>>>>>        Move (Trim(sTokenConnectionID)) to sTokenConnectionID
11493>>>>>>>        Move (Insert(C_ConnectionId, sTokenConnectionID, 0)) to sTokenConnectionID
11494>>>>>>>                           
11494>>>>>>>        Move (SizeOfArray(aTokenConnections)) to iIndex
11495>>>>>>>        If (iIndex > 0) Begin            
11497>>>>>>>            For iCount from 0 to (iIndex - 1)
11503>>>>>>>>
11503>>>>>>>                If (aTokenConnections[iCount].sConnectionID = sTokenConnectionID) Begin
11505>>>>>>>                    Move iCount to iIndex
11506>>>>>>>                End
11506>>>>>>>>
11506>>>>>>>            Loop
11507>>>>>>>>
11507>>>>>>>        End
11507>>>>>>>>
11507>>>>>>>       
11507>>>>>>>        Move sConnectionID to aTokenConnections[iIndex].sConnectionID       
11508>>>>>>>        Move sTokenConnectionID to aTokenConnections[iIndex].sTokenConnectionID
11509>>>>>>>        Move hTokenProvider to aTokenConnections[iIndex].hTokenProvider
11510>>>>>>>        
11510>>>>>>>        Set pTokenConnections to aTokenConnections
11511>>>>>>>    End_Procedure
11512>>>>>>>    
11512>>>>>>>    // checks if connection is using token login
11512>>>>>>>    Procedure CheckTokenConnection String sDriver String sServer
11514>>>>>>>        Integer iCount iTokens iConnection
11514>>>>>>>        tConnection[] Connections
11514>>>>>>>        tConnection[] Connections
11515>>>>>>>        tTokenConnection[] aTokenConnections
11515>>>>>>>        tTokenConnection[] aTokenConnections
11516>>>>>>>        
11516>>>>>>>        Get pTokenConnections to aTokenConnections           
11517>>>>>>>        Move (SizeOfArray(aTokenConnections)) to iTokens
11518>>>>>>>        If (iTokens > 0) Begin
11520>>>>>>>            For iCount from 0 to (iTokens - 1)
11526>>>>>>>>
11526>>>>>>>                If (aTokenConnections[iCount].sTokenConnectionID = sServer) Begin
11528>>>>>>>                    Send SQLInitTokenAccess of aTokenConnections[iCount].hTokenProvider sDriver sServer
11529>>>>>>>                    
11529>>>>>>>                    Get ConnectionIdIndex aTokenConnections[iCount].sConnectionID to iConnection                        
11530>>>>>>>                    Get pConnections to Connections
11531>>>>>>>                    Move aTokenConnections[iCount].hTokenProvider to Connections[iConnection].hTokenProvider
11532>>>>>>>                    Set pConnections to Connections
11533>>>>>>>                    
11533>>>>>>>                    Move iCount to iTokens
11534>>>>>>>                End
11534>>>>>>>>
11534>>>>>>>            Loop
11535>>>>>>>>
11535>>>>>>>        End
11535>>>>>>>>
11535>>>>>>>    End_Procedure

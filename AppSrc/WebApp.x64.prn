30794>>>>>>>    //           an error is raised and the function will return "". 
30794>>>>>>>    Function GetReportsCache Boolean bCreate Returns String
30796>>>>>>>        Integer iAttributes
30796>>>>>>>        String sPath sHome sSep
30796>>>>>>>        Boolean bOK
30796>>>>>>>
30796>>>>>>>        Move (SysConf(SYSCONF_DIR_SEPARATOR)) to sSep                // i.e. sSep = "\"
30797>>>>>>>        Get psHome of (phoWorkspace(ghoApplication)) to sHome
30798>>>>>>>        
30798>>>>>>>        // Strip trailing "/"

35476>>>>>>>        
35476>>>>>>>        Set paComboItems to atEmpty
35477>>>>>>>        
35477>>>>>>>        If (hoServer > 0 and iFile > 0) Begin
35479>>>>>>>            //  Do security check
35479>>>>>>>            If (not(FillDEOAllowed(Self))) Begin
35481>>>>>>>                Procedure_Return
35482>>>>>>>            End
35482>>>>>>>>
35482>>>>>>>            
35482>>>>>>>            Get Data_Set of hoServer iFile to hoDD
35483>>>>>>>            
35483>>>>>>>            If (hoDD > 0) Begin
35485>>>>>>>                Get pbAddEmptyItem to bAddEmptyItem
35486>>>>>>>                If (bAddEmptyItem) Begin
35488>>>>>>>                    Get psEmptyItemDescription to sEmptyItemDescription
35489>>>>>>>                    Send AddComboItem (SerializeRowID(NullRowID())) sEmptyItemDescription
35490>>>>>>>                End
35490>>>>>>>>
35490>>>>>>>                
35490>>>>>>>                //  Use the field its prefered index
35490>>>>>>>                If (iIndex <= 0) Begin
35492>>>>>>>                    Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
35495>>>>>>>                End
35495>>>>>>>>
35495>>>>>>>                
35495>>>>>>>                //  If the field is not indexed we use the table its primary index
35495>>>>>>>                If (iIndex <= 0) Begin
35497>>>>>>>                    Get_Attribute DF_FILE_PRIMARY_INDEX of iFile to iIndex
35500>>>>>>>                End
35500>>>>>>>>
35500>>>>>>>                                 
35500>>>>>>>                // optimize relates. Only do it if needed
35500>>>>>>>                Get No_Relate_State of hoDD to bOldRelate
35501>>>>>>>                Get DDOConstraintNeedsRelate of hoDD iIndex to bNeedsRelate
35502>>>>>>>                Set No_Relate_State of hoDD to (not(bNeedsRelate))
35503>>>>>>>                Send Request_Read of hoDD FIRST_RECORD iFile iIndex
35504>>>>>>>                
35504>>>>>>>                While (Found)

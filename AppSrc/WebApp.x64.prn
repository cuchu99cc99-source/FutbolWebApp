29583>>>>>>>>>>>    //  Determines if parsing should continue based on the information in the parsedata struct.
29583>>>>>>>>>>>    Function ShouldParseContinue tMultipartParsingData ByRef parsedata Returns Boolean
29585>>>>>>>>>>>        Function_Return (not(parsedata.bAbort) and (not(parsedata.bEndOfReq) or (parsedata.iChunkRead + parsedata.iChunkOffset < parsedata.iSize)))

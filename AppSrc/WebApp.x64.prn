8643>>>>>>>    Procedure ResetWindowPos tWinRect ByRef WindowPos
8645>>>>>>>        Integer ixySize ixSize iySize
8645>>>>>>>        Integer ixOffset iyOffset
8645>>>>>>>        
8645>>>>>>>        // first calculate the offset needed to move onto the main monitor at 0,0
8645>>>>>>>        Move (0 - WindowPos.left) to ixOffset
8646>>>>>>>        Move (0 - WindowPos.top) to iyOffset
8647>>>>>>>        
8647>>>>>>>        Move 0 to WindowPos.left
8648>>>>>>>        Move 0 to WindowPos.top
8649>>>>>>>        
8649>>>>>>>        Move (WindowPos.right + ixOffset) to WindowPos.right
8650>>>>>>>        Move (WindowPos.bottom + iyOffset) to WindowPos.bottom
8651>>>>>>>        
8651>>>>>>>        // also make sure that the size of the window is <= the size of the main monitor
8651>>>>>>>        Move (GUIScreen_Size(1)) to ixySize    // parameter of 1 means return "available" screen size
8652>>>>>>>        Move (low(ixySize))      to ixSize
8653>>>>>>>        Move (hi(ixySize))       to iySize
8654>>>>>>>        
8654>>>>>>>        Move (ixSize min WindowPos.right) to WindowPos.right
8655>>>>>>>        Move (iySize min WindowPos.bottom) to WindowPos.bottom
8656>>>>>>>    End_Procedure

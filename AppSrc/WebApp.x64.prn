30492>>>>>>>>>        Property Integer piSessionCookieTimeout 0           //  The number hours that the session cookie should be stored (0 for the current browser session)
30493>>>>>>>>>        Property String psSessionCookiePath ""              //  Determines the path for which the session key cookie is set ('/' for entire domain, '' for the current path)
30494>>>>>>>>>        Property String psSessionCookieDomain ""            //  Determines the domain name for which the cookie is set (if the app is running on a subdomain the cookie can be shared accross the entire domain, "" means just for the current domain)
30495>>>>>>>>>        Property Boolean pbSessionCookieSecure False        //  Determines if the session cookie should be set as a secure cookie so that it is only send for HTTPS connections
30496>>>>>>>>>        Property Boolean pbSessionCookieHttpOnly False      //  Determines if the session cookie should be set as HTTP Only cookie so that it is not accessible from JavaScript.
30497>>>>>>>>>        Property String psSessionCookieSameSite "Lax"    //  Determines the samesite attribute of the session cookie.
30498>>>>>>>>>        

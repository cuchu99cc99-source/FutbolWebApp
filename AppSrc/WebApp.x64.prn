18528>>>>>>>>>>>>>>>                    Get IsControlVisible of hoParent to bVisible
18529>>>>>>>>>>>>>>>                End
18529>>>>>>>>>>>>>>>>
18529>>>>>>>>>>>>>>>            End
18529>>>>>>>>>>>>>>>>
18529>>>>>>>>>>>>>>>        End
18529>>>>>>>>>>>>>>>>

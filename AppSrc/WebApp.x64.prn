30735>>>>>>>    // Synchronizes the current records with the passed row id's for each DDO in the
30735>>>>>>>    // passed collection of DDO structures. Each Structure in the collection belongs
30735>>>>>>>    // to a different view. The aDDOViews parameter is populated with the object handle
30735>>>>>>>    // of each view referenced in the aDDODefs collection
30735>>>>>>>    //
30735>>>>>>>    // During this process the view is tested for AllowViewAccess. If access is denied to
30735>>>>>>>    // any view in the stack then SynchronizeDDOs is aborted and the function returns False.
30735>>>>>>>    Procedure Call_PreSync tWebCallContext ByRef cctx
30737>>>>>>>        Boolean bAllowAccess
30737>>>>>>>        Integer i icDDODef
30737>>>>>>>        String sViewName
30737>>>>>>>        Handle[] aDDOViews
30738>>>>>>>        Handle hoInvokingObject
30738>>>>>>>         
30738>>>>>>>        Set pbSynchronizing to True
30739>>>>>>>        
30739>>>>>>>        Send NotifySyncWebApp
30740>>>>>>>         
30740>>>>>>>        // Iterate the DDODefs array and synchronize the DDOs for each view....
30740>>>>>>>        Move True to bAllowAccess
30741>>>>>>>        Move (SizeOfArray(cctx.request.Header.aDDOViews)) to icDDODef
30742>>>>>>>        
30742>>>>>>>        //  First get all the object references
30742>>>>>>>        For i from 0 to (icDDODef - 1)
30748>>>>>>>>
30748>>>>>>>            // Get the array of object handles to the views referenced in the request header's aDDODefs collection....
30748>>>>>>>            Get GetAjaxWebAppView of (phoWebControlLocator(Self)) cctx.request.Header.aDDOViews[i] to aDDOViews[i]
30749>>>>>>>        Loop
30750>>>>>>>>
30750>>>>>>>        Set paDDOViews to aDDOViews
30751>>>>>>>        
30751>>>>>>>        //  Now we can do the rest of the work
30751>>>>>>>        For i from 0 to (icDDODef - 1)
30757>>>>>>>>
30757>>>>>>>            If (aDDOViews[i] <> C_WebUnresolvedObject) Begin
30759>>>>>>>                // Test if access is allowed to the view...
30759>>>>>>>                Get Object_Label of aDDOViews[i] to sViewName
30760>>>>>>>                Get AllowViewAccess of (SessionManager(Self)) aDDOViews[i] sViewName to bAllowAccess
30761>>>>>>>
30761>>>>>>>                If (not(bAllowAccess)) Begin
30763>>>>>>>                    Error DFERR_WEBAPP_ACCESS_DENIED
30764>>>>>>>>
30764>>>>>>>                    Move True to cctx.bCancel
30765>>>>>>>                    Function_Return False
30766>>>>>>>                End
30766>>>>>>>>
30766>>>>>>>                
30766>>>>>>>                // Synchronize the view's DDOs with the DDOs in the request header
30766>>>>>>>                Get SyncDDOs of aDDOViews[i] to bAllowAccess
30767>>>>>>>                If (not(bAllowAccess)) Begin
30769>>>>>>>                    Move True to cctx.bCancel
30770>>>>>>>                    Function_Return False
30771>>>>>>>                End
30771>>>>>>>>
30771>>>>>>>                                
30771>>>>>>>                // Process the synchronized psValue and pbChanged properties for each control that has a data binding
30771>>>>>>>                Broadcast Recursive Send UpdateDataBinding to aDDOViews[i]
30773>>>>>>>                
30773>>>>>>>                // Send the Rights & Roles event hook to the view....
30773>>>>>>>                Send NotifySyncWebApp to aDDOViews[i]
30774>>>>>>>                
30774>>>>>>>                // Get the invoking object, as this might create dynamic objects which could sync their DDO's and we don't want that to happen later
30774>>>>>>>                Get GetInvokingObject of aDDOViews[i] to hoInvokingObject
30775>>>>>>>            End
30775>>>>>>>>
30775>>>>>>>        Loop 
30776>>>>>>>>
30776>>>>>>>        
30776>>>>>>>        Set pbSynchronizing to False
30777>>>>>>>    End_Procedure
30778>>>>>>>    
30778>>>>>>>    Procedure Call_PostSync tWebCallContext ByRef cctx
30780>>>>>>>        Integer i icDDODef
30780>>>>>>>        Handle[] aDDOViews
30781>>>>>>>        
30781>>>>>>>        // Iterate all the DDODefs in the Request and return the DDODefs for each one in the response
30781>>>>>>>        Get paDDOViews to aDDOViews
30782>>>>>>>        Move (SizeOfArray(aDDOViews)) to icDDODef
30783>>>>>>>        
30783>>>>>>>        For i from 0 to (icDDODef - 1)
30789>>>>>>>>
30789>>>>>>>            Send StoreDDOStates of aDDOViews[i]
30790>>>>>>>        Loop
30791>>>>>>>>
30791>>>>>>>    End_Procedure

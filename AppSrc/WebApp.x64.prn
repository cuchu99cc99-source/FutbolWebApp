34307>>>>>>>Class cWebModalDialog is a cWebView
34308>>>>>>>    
34308>>>>>>>    Procedure Construct_Object
34310>>>>>>>        Forward Send Construct_Object
34312>>>>>>>        
34312>>>>>>>        // Published Properties
34312>>>>>>>        Property Boolean pbResizable True             // True if the window can be resized (with mouse)
34315>>>>>>>        Property Boolean pbShowClose True             // True if the title has a close button to hide the window
34318>>>>>>>        Property Boolean pbShowMax False              // True if the title has a max button to maximize the window 
34321>>>>>>>        Property Boolean pbShowMin False              // True if the title has a min button to minimize the window
34324>>>>>>>        Property Integer piLeft 0                   // Left co-ordinate, in pixels of the window
34327>>>>>>>        Property Integer piMinHeight 80               // Minimum height, in pixels, of the window
34330>>>>>>>        Property Integer piTop 0                    // Top co-ordinate, in pixels of the window
34333>>>>>>>        Property Integer piWidth -1                   // Width, in pixels of the window
34336>>>>>>>        
34336>>>>>>>        Property Boolean pbServerOnEscape False   // Set to true to trigger server OnEscape event
34339>>>>>>>        Property String psClientOnEscape ""       // Name of client side OnEscape event handler
34342>>>>>>>        
34342>>>>>>>        Property String psReturnMessage "OnCloseModalDialog"   // callback method name
34345>>>>>>>        Property String psReturnObject             // callback object name
34348>>>>>>>        Property Boolean pbCanceled True          // maintained by class when used in a default manner
34351>>>>>>>        
34351>>>>>>>        //  Configure super classes
34351>>>>>>>        Set pbOverrideStateOnShow to True
34352>>>>>>>        Set pbScroll to False
34353>>>>>>>        
34353>>>>>>>        Set piMinWidth to 200
34354>>>>>>>        Set peWebViewStyle to wvsDialog
34355>>>>>>>        
34355>>>>>>>        Set psJSClass to "df.WebModalDialog"
34356>>>>>>>    End_Procedure
34357>>>>>>>    
34357>>>>>>>
34357>>>>>>>    // Returns a handle to the invoking view object. i.e. the view that activated this modal dialog.
34357>>>>>>>    // Returns C_WebUnresolvedObject if there is no invoking view. See also psInvokingView
34357>>>>>>>    Function InvokingView Returns Handle
34359>>>>>>>        Handle hoInvokingView
34359>>>>>>>        String sInvokingView
34359>>>>>>>        
34359>>>>>>>        WebGet psInvokingView to sInvokingView
34360>>>>>>>        If (Trim(sInvokingView) <> "") Begin
34362>>>>>>>            Get FindWebObject of (Owner(Self)) sInvokingView to hoInvokingView
34363>>>>>>>            Function_Return hoInvokingView
34364>>>>>>>        End
34364>>>>>>>>
34364>>>>>>>         
34364>>>>>>>        Function_Return C_WebUnresolvedObject    
34365>>>>>>>    End_Function   
34366>>>>>>>    
34366>>>>>>>     
34366>>>>>>>    // Does a standard modal dialog invocation. It web-sets pbCanceled to True (which can be
34366>>>>>>>    // set to true on a successful close), it sets the callback object and sets the default
34366>>>>>>>    // callback message "OnCloseModalDialog". Finally it calls OnPopup
34366>>>>>>>    Procedure Popup Handle hoReturnObject
34368>>>>>>>        String sReturnMethod sReturnObject
34368>>>>>>>        WebSet pbCanceled to True // this gets reset if it closes ok
34369>>>>>>>        Get WebObjectName of hoReturnObject to sReturnObject
34370>>>>>>>        WebSet psReturnObject to sReturnObject
34371>>>>>>>        Send Show
34372>>>>>>>    End_Procedure
34373>>>>>>>    
34373>>>>>>>    // Can be called to do a successful closing of a panel. It sets pbCanceled to False, sends hide
34373>>>>>>>    // and class NotifyCloseModalDialog, which performs the callback using data web-set in Popup
34373>>>>>>>    Procedure Ok
34375>>>>>>>        WebSet pbCanceled to False
34376>>>>>>>        Send NotifyCloseModalDialog
34377>>>>>>>        Send CloseDialog
34378>>>>>>>    End_Procedure
34379>>>>>>>
34379>>>>>>>    // Can be called to do a non-successful closing of a panel. pbCanceled will be True (from Popup),
34379>>>>>>>    // it sends hide and it optionally sends NotifyCloseModalDialog, which performs the callback using data web-set in Popup.
34379>>>>>>>    // It sends NotifyCloseModalPanel if pbServerOnEscape is True. This makes the assumption that pbServerOnEscape means that
34379>>>>>>>    // you want to send a close notification and callback even when canceled in any manner.
34379>>>>>>>    Procedure Cancel
34381>>>>>>>        Boolean bServerOnEscape
34381>>>>>>>        WebGet pbServerOnEscape to bServerOnEscape
34382>>>>>>>        If (bServerOnEscape) Begin
34384>>>>>>>            Send NotifyCloseModalDialog
34385>>>>>>>        End
34385>>>>>>>>
34385>>>>>>>        Send CloseDialog
34386>>>>>>>    End_Procedure
34387>>>>>>>    
34387>>>>>>>    // this is called when the Esc key or "x" is pressed
34387>>>>>>>    Procedure OnEscape
34389>>>>>>>        Send Cancel
34390>>>>>>>    End_Procedure
34391>>>>>>>    
34391>>>>>>>    
34391>>>>>>>    // Sends the callback method to the callback object using values web-set in Popup. This is 
34391>>>>>>>    // usually called by Ok and maybe Cancel.
34391>>>>>>>    Procedure NotifyCloseModalDialog
34393>>>>>>>        Handle hoReturnObject hReturnMessage
34393>>>>>>>        String sReturnObject sReturnMessage
34393>>>>>>>        Boolean bOpenedWithNavigate
34393>>>>>>>        
34393>>>>>>>        //Check if we got here through navigation or through Send popup
34393>>>>>>>        Get OpenedWithNavigate to bOpenedWithNavigate
34394>>>>>>>        //If sReturnObject is an empty string we got here through Send popup
34394>>>>>>>        If (bOpenedWithNavigate) Begin
34396>>>>>>>            WebGet psInvokingObject to sReturnObject
34397>>>>>>>        End
34397>>>>>>>>
34397>>>>>>>        Else Begin
34398>>>>>>>            WebGet psReturnObject to sReturnObject
34399>>>>>>>        End
34399>>>>>>>>
34399>>>>>>>        
34399>>>>>>>        WebGet psReturnMessage to sReturnMessage
34400>>>>>>>
34400>>>>>>>        Get WebObjectByName sReturnObject to hoReturnObject
34401>>>>>>>        If hoReturnObject Begin
34403>>>>>>>            If (sReturnMessage <> "") Begin
34405>>>>>>>                Get WebMethodByName of hoReturnObject sReturnMessage to hReturnMessage
34406>>>>>>>                If hReturnMessage Begin
34408>>>>>>>                    Send hReturnMessage of hoReturnObject Self
34409>>>>>>>                End
34409>>>>>>>>
34409>>>>>>>            End
34409>>>>>>>>
34409>>>>>>>        End
34409>>>>>>>>
34409>>>>>>>    End_Procedure
34410>>>>>>>    
34410>>>>>>>    // Returns a handle to the return object. This is used by controls (cWebPromptList) to get
34410>>>>>>>    // the return object using delegation.
34410>>>>>>>    Function ReturnObject Returns Handle
34412>>>>>>>        String sWO
34412>>>>>>>        Handle hoWO
34412>>>>>>>        Boolean bOpenedWithNavigate
34412>>>>>>>        
34412>>>>>>>        Move C_WebUnresolvedObject to hoWO
34413>>>>>>>        Get OpenedWithNavigate to bOpenedWithNavigate
34414>>>>>>>        
34414>>>>>>>        //When opened with navigate we rely on psInvokingObject, otherwise psReturnObject.
34414>>>>>>>        If (bOpenedWithNavigate) Begin
34416>>>>>>>            WebGet psInvokingObject to sWO
34417>>>>>>>        End
34417>>>>>>>>
34417>>>>>>>        Else Begin
34418>>>>>>>            WebGet psReturnObject to sWO
34419>>>>>>>        End
34419>>>>>>>>
34419>>>>>>>
34419>>>>>>>        If (sWO <> "") Begin
34421>>>>>>>            Get WebObjectByName sWO to hoWO
34422>>>>>>>        End
34422>>>>>>>>
34422>>>>>>>        
34422>>>>>>>        Function_Return hoWO
34423>>>>>>>    End_Function
34424>>>>>>>    
34424>>>>>>>    Function IsDialog Returns Boolean
34426>>>>>>>        Function_Return True
34427>>>>>>>    End_Function
34428>>>>>>>    
34428>>>>>>>    //Calls navigate close for a modal dialog
34428>>>>>>>    Procedure NavigateCloseDialog
34430>>>>>>>        Boolean bCanceled
34430>>>>>>>        WebGet  pbCanceled to bCanceled
34431>>>>>>>        WebSet pbServerOnEscape to False
34432>>>>>>>        Send SetInvokingObject C_WebUnresolvedObject
34433>>>>>>>        If (bCanceled) Begin
34435>>>>>>>            Send NavigateCancel    
34436>>>>>>>        End
34436>>>>>>>>
34436>>>>>>>        Else Begin
34437>>>>>>>            Send NavigateClose Self
34438>>>>>>>        End
34438>>>>>>>>
34438>>>>>>>    End_Procedure
34439>>>>>>>    
34439>>>>>>>    Function OpenedWithNavigate Returns Boolean
34441>>>>>>>        String sInvokingObject
34441>>>>>>>        
34441>>>>>>>        WebGet psInvokingObject of Self to sInvokingObject
34442>>>>>>>        //If the invoking object is either empty or [NULL] we didnt get here through navigation but through a popup
34442>>>>>>>        If (sInvokingObject = "" or sInvokingObject = "[NULL]") Begin
34444>>>>>>>            Function_Return False
34445>>>>>>>        End
34445>>>>>>>>
34445>>>>>>>        
34445>>>>>>>        Function_Return True
34446>>>>>>>    End_Function
34447>>>>>>>    

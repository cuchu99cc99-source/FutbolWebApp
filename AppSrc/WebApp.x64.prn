7197>>>>>>>>>>>    If (iChannel <= DF_SEQ_CHANNEL_ERROR) Begin
7199>>>>>>>>>>>        If (Seq_Channel_Error_Mode() = DF_SEQ_CHANNEL_ERROR_MODE_ALL) Begin
7201>>>>>>>>>>>            Error DFERR_CANT_OPEN_OUTPUT_FILE (sChannel + ":" *C_$ChannelNotAvailable)
7202>>>>>>>>>>>>

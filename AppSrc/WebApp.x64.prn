27762>>>>>>>    //  iWindowHeight   Height of the browser window in pixels.
27762>>>>>>>    Procedure OnResizeWindow Integer iWindowWidth Integer iWindowHeight
27764>>>>>>>    End_Procedure    
27765>>>>>>>
27765>>>>>>>    // Generic request find method for handling Request_Find
27765>>>>>>>    // Currently this will get delegated here by objects that do not understand Requset_Find. In the
27765>>>>>>>    // future we could use DEO_Find_Object to not send these messages at all.
27765>>>>>>>    // eFindMode - Can be one of... lt, le, eq, ge, gt, or it may be either Next_Record, First_Record, or Last_Record
27765>>>>>>>    Procedure Request_Find Integer eFindMode
27767>>>>>>>        // Do nothing. Ignore this message in this class.
27767>>>>>>>    End_Procedure
27768>>>>>>>
27768>>>>>>>
27768>>>>>>>    //  Performs the initialization of the view when it is loaded to the client. It is called by 
27768>>>>>>>    //  cWebApp at the right moment (pbOverrideStateOnShow influences this). Clears the DDO 
27768>>>>>>>    //  structures, adds key handlers and sends OnResizeWindow.
27768>>>>>>>    //    
27768>>>>>>>    Procedure InitForShow
27770>>>>>>>        Integer i iCount iWidth iHeight
27770>>>>>>>        Handle hoMainDD
27770>>>>>>>        Handle[] aAdditionalDDOStructures 
27771>>>>>>>        tNameHandlePair[] aDDOs
27771>>>>>>>        tNameHandlePair[] aDDOs
27772>>>>>>>        Boolean bOnResize bPreLoaded bDynamicConstraints
27772>>>>>>>        tDDRemembered[] aEmptyRemembered
27772>>>>>>>        tDDRemembered[] aEmptyRemembered
27773>>>>>>>        
27773>>>>>>>        //  If this is a preloaded view we skip initforshow
27773>>>>>>>        WebGet pbPreLoaded to bPreLoaded
27774>>>>>>>        If (bPreLoaded) Begin
27776>>>>>>>            WebSet pbPreLoaded to False
27777>>>>>>>            Procedure_Return
27778>>>>>>>        End
27778>>>>>>>>
27778>>>>>>>        
27778>>>>>>>        Get Main_DD to hoMainDD
27779>>>>>>>        If (hoMainDD <> 0) Begin
27781>>>>>>>            // Clear dynamic constraints that might have been left from previous show
27781>>>>>>>            Get IsDynamicConstraints to bDynamicConstraints
27782>>>>>>>            If (bDynamicConstraints) Begin
27784>>>>>>>                Send ClearConstrainFiles hoMainDD
27785>>>>>>>                Send Rebuild_Constraints of hoMainDD
27786>>>>>>>            End
27786>>>>>>>>
27786>>>>>>>        End
27786>>>>>>>>
27786>>>>>>>        
27786>>>>>>>        Set pbInitForShow to True
27787>>>>>>>        
27787>>>>>>>        // Clear remember values
27787>>>>>>>        Get paDDOIndex to aDDOs
27788>>>>>>>        Move (SizeOfArray(aDDOs) - 1) to iCount
27789>>>>>>>        For i from 0 to iCount
27795>>>>>>>>
27795>>>>>>>            Set pDDDefaults of aDDOs[i].hValue to aEmptyRemembered
27796>>>>>>>        Loop
27797>>>>>>>>
27797>>>>>>>        
27797>>>>>>>        // Clear the main DDO structure
27797>>>>>>>        If (hoMainDD <> 0) Begin
27799>>>>>>>            Send Clear_All of hoMainDD
27800>>>>>>>        End
27800>>>>>>>>
27800>>>>>>>        
27800>>>>>>>        // Now clear the main dd of any 'additional' DDO structures
27800>>>>>>>        Get paAdditionalDDOStructures to aAdditionalDDOStructures
27801>>>>>>>        Move (SizeOfArray(aAdditionalDDOStructures)) to iCount
27802>>>>>>>        
27802>>>>>>>        For i from 0 to (iCount - 1)
27808>>>>>>>>
27808>>>>>>>            If (aAdditionalDDOStructures[i] <> 0) Begin
27810>>>>>>>                Send Clear_All of aAdditionalDDOStructures[i]
27811>>>>>>>            End
27811>>>>>>>>
27811>>>>>>>        Loop
27812>>>>>>>>
27812>>>>>>>        
27812>>>>>>>        //  Rebuild constraints
27812>>>>>>>        Send RebuildDDConstraints
27813>>>>>>>        
27813>>>>>>>        //  Trigger resize event
27813>>>>>>>        Get pbServerOnResizeWindow to bOnResize
27814>>>>>>>        If (bOnResize) Begin
27816>>>>>>>            WebGet piWindowWidth of (Host(Self)) to iWidth
27817>>>>>>>            WebGet piWindowHeight of (Host(Self)) to iHeight
27818>>>>>>>            
27818>>>>>>>            Send OnResizeWindow iWidth iHeight
27819>>>>>>>        End
27819>>>>>>>>
27819>>>>>>>        
27819>>>>>>>        Set pbInitForShow to False
27820>>>>>>>    End_Procedure
27821>>>>>>>    
27821>>>>>>>    
27821>>>>>>>    //  Called always when the view is shown.
27821>>>>>>>    //  
27821>>>>>>>    Procedure DoShow
27823>>>>>>>        Boolean bOnShow
27823>>>>>>>        Integer eViewStyle
27823>>>>>>>        String sPrevHash sView sHashView
27823>>>>>>>        
27823>>>>>>>        //  Fire OnShow (optimization, used to be fired from JavaScript)
27823>>>>>>>        Send OnBeforeShow
27824>>>>>>>        
27824>>>>>>>        Get peWebViewStyle to eViewStyle
27825>>>>>>>        If (eViewStyle = wvsDesktop) Begin
27827>>>>>>>            
27827>>>>>>>            If (peStateMode(Self) <> vsmOff) Begin 
27829>>>>>>>                //  Replace state if the hash no location url
27829>>>>>>>                Get psStateViewName to sView
27830>>>>>>>                Get StateHash of (Host(Self)) to sPrevHash
27831>>>>>>>                Send ParseViewStateHash sPrevHash (&sHashView)
27832>>>>>>>                
27832>>>>>>>                If (Lowercase(sHashView) <> Lowercase(sView)) Begin
27834>>>>>>>                    Send UpdateStateHash ((Trim(sPrevHash) = "") or pbStateReplace(Self))            
27835>>>>>>>                End
27835>>>>>>>>
27835>>>>>>>            End
27835>>>>>>>>
27835>>>>>>>            Send UpdatePageTitle
27836>>>>>>>        End
27836>>>>>>>>
27836>>>>>>>        
27836>>>>>>>    End_Procedure
27837>>>>>>>    
27837>>>>>>>    
27837>>>>>>>    Procedure HandleFindKey Integer iKey Boolean bShift Boolean bAlt Boolean bCtrl
27839>>>>>>>        Handle hoFocus
27839>>>>>>>        
27839>>>>>>>        If (pbFindKeys(Self)) Begin
27841>>>>>>>            Get DEOControlFocusObject to hoFocus
27842>>>>>>>            If (hoFocus) Begin
27844>>>>>>>                Case Begin
27844>>>>>>>                    Case (iKey = 119)
27846>>>>>>>                        Send Request_Find of hoFocus  GT
27847>>>>>>>                        Case Break
27848>>>>>>>                    Case (iKey = 118)
27851>>>>>>>                        Send Request_Find of hoFocus  LT
27852>>>>>>>                        Case Break
27853>>>>>>>                    Case (iKey = 120)
27856>>>>>>>                        Send Request_Find of hoFocus  GE
27857>>>>>>>                        Case Break
27858>>>>>>>                    Case (iKey = 36 and bCtrl)
27861>>>>>>>                        Send Request_Find of hoFocus  FIRST_RECORD
27862>>>>>>>                        Case Break
27863>>>>>>>                    Case (iKey = 35 and bCtrl)
27866>>>>>>>                        Send Request_Find of hoFocus  LAST_RECORD
27867>>>>>>>                        Case Break
27868>>>>>>>                Case End
27868>>>>>>>                
27868>>>>>>>            End
27868>>>>>>>>
27868>>>>>>>        End
27868>>>>>>>>
27868>>>>>>>    End_Procedure
27869>>>>>>>    
27869>>>>>>>    Procedure HandleClearKey Integer iKey Boolean bShift Boolean bAlt Boolean bCtrl
27871>>>>>>>        Handle hoFocus
27871>>>>>>>        
27871>>>>>>>        If (pbClearKeys(Self) and iKey = 116) Begin 
27873>>>>>>>            Get DEOControlFocusObject to hoFocus
27874>>>>>>>            
27874>>>>>>>            If (hoFocus) Begin
27876>>>>>>>                If (bCtrl) Begin
27878>>>>>>>                    Send Request_Clear_All of hoFocus
27879>>>>>>>                End
27879>>>>>>>>
27879>>>>>>>                Else Begin
27880>>>>>>>                    Send Request_Clear of hoFocus
27881>>>>>>>                End
27881>>>>>>>>
27881>>>>>>>            End
27881>>>>>>>>
27881>>>>>>>        End
27881>>>>>>>>
27881>>>>>>>    End_Procedure
27882>>>>>>>    
27882>>>>>>>    Procedure HandleDeleteKey Integer iKey Boolean bShift Boolean bAlt Boolean bCtrl
27884>>>>>>>        Handle hoFocus
27884>>>>>>>        
27884>>>>>>>        If (pbDeleteKeys(Self) and iKey = 113 and bShift) Begin
27886>>>>>>>            Get DEOFocusObject to hoFocus
27887>>>>>>>            If hoFocus Begin
27889>>>>>>>                Send Request_Delete of hoFocus
27890>>>>>>>            End
27890>>>>>>>>
27890>>>>>>>        End
27890>>>>>>>>
27890>>>>>>>    End_Procedure
27891>>>>>>>    
27891>>>>>>>    Procedure HandleSaveKey Integer iKey Boolean bShift Boolean bAlt Boolean bCtrl
27893>>>>>>>        Handle hoFocus
27893>>>>>>>        
27893>>>>>>>        If (pbSaveKeys(Self) and iKey = 113 and not(bShift)) Begin
27895>>>>>>>            Get DEOFocusObject to hoFocus
27896>>>>>>>            If hoFocus Begin
27898>>>>>>>                Send Request_Save of hoFocus
27899>>>>>>>            End
27899>>>>>>>>
27899>>>>>>>        End
27899>>>>>>>>
27899>>>>>>>    End_Procedure
27900>>>>>>>    
27900>>>>>>>    
27900>>>>>>>    
27900>>>>>>>    Procedure DefaultKeyHandlers
27902>>>>>>>        If (pbFindKeys(Self)) Begin
27904>>>>>>>            Send AddKeyHandler (RefProc(HandleFindKey)) 119 False False False   //  F8
27905>>>>>>>            Send AddKeyHandler (RefProc(HandleFindKey)) 118 False False False   //  F7
27906>>>>>>>            Send AddKeyHandler (RefProc(HandleFindKey)) 120 False False False   //  F9
27907>>>>>>>            
27907>>>>>>>            Send AddKeyHandler (RefProc(HandleFindKey)) 36 False False True     //  Ctrl - home
27908>>>>>>>            Send AddKeyHandler (RefProc(HandleFindKey)) 35 False False True     //  Ctrl - end
27909>>>>>>>        End
27909>>>>>>>>
27909>>>>>>>        
27909>>>>>>>        If (pbClearKeys(Self)) Begin
27911>>>>>>>            Send AddKeyHandler (RefProc(HandleClearKey)) 116 False False False  //  F5
27912>>>>>>>            Send AddKeyHandler (RefProc(HandleClearKey)) 116 False False True   //  Ctrl - F5
27913>>>>>>>        End
27913>>>>>>>>
27913>>>>>>>        
27913>>>>>>>        If (pbDeleteKeys(Self)) Begin
27915>>>>>>>            Send AddKeyHandler (RefProc(HandleDeleteKey)) 113 True False False  //  Shift - F2
27916>>>>>>>        End
27916>>>>>>>>
27916>>>>>>>        
27916>>>>>>>        If (pbSaveKeys(Self)) Begin
27918>>>>>>>            Send AddKeyHandler (RefProc(HandleSaveKey)) 113 False False False   //  F2
27919>>>>>>>        End
27919>>>>>>>>
27919>>>>>>>        
27919>>>>>>>    End_Procedure
27920>>>>>>>    
27920>>>>>>>    // Show an unhandled refind error for this DDO.
27920>>>>>>>    Procedure CannotRefindRecordUnhandledError Handle hoDDO
27922>>>>>>>        Integer iFile
27922>>>>>>>        String sExtMess sFile sView
27922>>>>>>>        Get WebObjectName to sView
27923>>>>>>>        Get Main_File of hoDDO to iFile
27924>>>>>>>        Get ErrorMessageTableName of hoDDO iFile to sFile
27925>>>>>>>        Move ("View:" * sView - "." * DD_FILE_TEXT * String(iFile) * "-" * sFile) to sExtMess
27926>>>>>>>        Error DFERR_REC_NOT_FOUND sExtMess
27927>>>>>>>>
27927>>>>>>>    End_Procedure
27928>>>>>>>
27928>>>>>>>    
27928>>>>>>>    // Sent when a NavigateForward fails. 
27928>>>>>>>    // By default call standard OnRefindRecordError and a NavigateCancel. This allows for customization
27928>>>>>>>    // eReason can be retCannotRereadMain or retCannotRereadConstrainingParent
27928>>>>>>>    Procedure OnNavigateForwardRefindError Handle hoDD Integer eReason
27930>>>>>>>        Send OnRefindRecordError hoDD reoNavigateForward eReason
27931>>>>>>>        // we will cancel this navigation forward
27931>>>>>>>        Send NavigateCancel
27932>>>>>>>    End_Procedure
27933>>>>>>>
27933>>>>>>>    // Sent when a Navigate Back fails. 
27933>>>>>>>    // By default call standard OnRefindRecordError. This allows for customization
27933>>>>>>>    // eReason can be retCannotRereadMain or retCannotRereadConstrainingParent
27933>>>>>>>    Procedure OnNavigateBackRefindError Handle hoDD Integer eReason
27935>>>>>>>        Send OnRefindRecordError hoDD reoNavigateBack eReason
27936>>>>>>>    End_Procedure
27937>>>>>>>
27937>>>>>>>    
27937>>>>>>>    
27937>>>>>>>
27937>>>>>>>    // these are used for setting dynamic enabled controls
27937>>>>>>>     
27937>>>>>>>    // returns true if this view should not allow finds on main-dd DEOs
27937>>>>>>>    // You want no finds with drilldowns that don't come from a main (select to zoom for same DDO)
27937>>>>>>>    Function IsViewNoFindOnMain Returns Boolean
27939>>>>>>>        tWebNavigateData NData
27939>>>>>>>        tWebNavigateData NData
27939>>>>>>>        Integer eWebViewStyle
27939>>>>>>>        Get peWebViewStyle to eWebViewStyle
27940>>>>>>>        If (eWebViewStyle = wvsDrillDown) Begin
27942>>>>>>>            // typically if you navigated from main (from select) you
27942>>>>>>>            // will not want to allow finds or prompts on main field indexes
27942>>>>>>>            Get GetNavigateData to NData
27943>>>>>>>            Function_Return (NData.eNavigateType = nfFromMain)
27944>>>>>>>        End
27944>>>>>>>>
27944>>>>>>>        Else Begin
27945>>>>>>>            Function_Return False
27946>>>>>>>        End
27946>>>>>>>>
27946>>>>>>>    End_Function
27947>>>>>>>    
27947>>>>>>>    // this this view have a No finding on a constrained parent? 
27947>>>>>>>    // Normally drilldowns do not want finding on the constrained parent
27947>>>>>>>    Function IsViewNoFindOnConstrainedParent Returns Boolean
27949>>>>>>>        Integer eWebViewStyle
27949>>>>>>>        Get peWebViewStyle to eWebViewStyle
27950>>>>>>>        If (eWebViewStyle = wvsDrillDown) Begin
27952>>>>>>>            // typically with drill down views you don't allow finds on the
27952>>>>>>>            // constraining child, because that's what you drilled in from
27952>>>>>>>            Function_Return True
27953>>>>>>>        End
27953>>>>>>>>
27953>>>>>>>        Else Begin
27954>>>>>>>            Function_Return False
27955>>>>>>>        End
27955>>>>>>>>
27955>>>>>>>    End_Function
27956>>>>>>>    
27956>>>>>>>    // Is this a read-only. With drilldown this is set true
27956>>>>>>>    // when the NavigateData.bReadOnly is True.
27956>>>>>>>    Function IsViewReadOnly Returns Boolean
27958>>>>>>>        Integer eWebViewStyle
27958>>>>>>>        Get peWebViewStyle to eWebViewStyle
27959>>>>>>>        If (eWebViewStyle = wvsDrillDown) Begin
27961>>>>>>>            // if this was called as read only, it's read only
27961>>>>>>>            tWebNavigateData NData
27961>>>>>>>            tWebNavigateData NData
27961>>>>>>>            Get GetNavigateData to NData
27962>>>>>>>            Function_Return (NData.bReadOnly)
27963>>>>>>>        End
27963>>>>>>>>
27963>>>>>>>        Else Begin
27964>>>>>>>            Function_Return False
27965>>>>>>>        End
27965>>>>>>>>
27965>>>>>>>    End_Function
27966>>>>>>>    
27966>>>>>>>    // this just sets the view readonly property
27966>>>>>>>    // With drilldown style, this is set in tWebNavigateData
27966>>>>>>>    // With non-drilldown, it is not set and you'd have to do this yourself
27966>>>>>>>    Procedure SetViewReadOnly Boolean bReadOnly
27968>>>>>>>        tWebNavigateData NData
27968>>>>>>>        tWebNavigateData NData
27968>>>>>>>        Integer eWebViewStyle
27968>>>>>>>        Get peWebViewStyle to eWebViewStyle
27969>>>>>>>        If (eWebViewStyle = wvsDrillDown) Begin
27971>>>>>>>            // set edit mode in NavigateData
27971>>>>>>>            Get GetNavigateData to NData
27972>>>>>>>            Move bReadOnly to NData.bReadOnly
27973>>>>>>>            Send SetNavigateData NData
27974>>>>>>>        End
27974>>>>>>>>
27974>>>>>>>    End_Procedure
27975>>>>>>>
27975>>>>>>>    // performs a refind and refresh based on the main view's DD record
27975>>>>>>>    // If the record cannot be found a handled error is raised
27975>>>>>>>    Procedure RefreshRecord
27977>>>>>>>        Handle hoDD
27977>>>>>>>        Integer iFile
27977>>>>>>>        RowID RID
27977>>>>>>>        Boolean bSuccess
27977>>>>>>>        Get Server to hoDD
27978>>>>>>>        If hoDD Begin
27980>>>>>>>            Get Main_File of hoDD to iFile
27981>>>>>>>            Get CurrentRowId of hoDD to RID
27982>>>>>>>            Get FindByRowIdEx of hoDD iFile RID to bSuccess
27983>>>>>>>            If not bSuccess Begin
27985>>>>>>>                Send OnRefreshRecordError hoDD
27986>>>>>>>            End
27986>>>>>>>>
27986>>>>>>>        End
27986>>>>>>>>
27986>>>>>>>    End_Procedure
27987>>>>>>>    
27987>>>>>>>    // Sets the edit mode
27987>>>>>>>    // refinds records and resets the DEOs as needed 
27987>>>>>>>    Procedure ChangeEditMode Boolean bEdit
27989>>>>>>>        Send SetViewReadOnly (not(bEdit))
27990>>>>>>>        // for a refind which will change enabled/disabled
27990>>>>>>>        Send RefreshRecord
27991>>>>>>>    End_Procedure

22084>>>>>>>>>>>>>    // Concatenates the different parts of a view state hash into a single string. Some characters 
22084>>>>>>>>>>>>>    // will be escaped.
22084>>>>>>>>>>>>>    //
22084>>>>>>>>>>>>>    // Params:
22084>>>>>>>>>>>>>    //      sView       The view name.
22084>>>>>>>>>>>>>    //      sRecordId   The record id.
22084>>>>>>>>>>>>>    //      sCustomHash Custom hash part.
22084>>>>>>>>>>>>>    Function ConcatViewStateHash String sView String sRecordId String sCustomHash Returns String
22086>>>>>>>>>>>>>        String sResult
22086>>>>>>>>>>>>>        
22086>>>>>>>>>>>>>        Get EscapeViewStatePartial sView to sView
22087>>>>>>>>>>>>>        Move sView to sResult
22088>>>>>>>>>>>>>        
22088>>>>>>>>>>>>>        If (sRecordId <> "" or sCustomHash <> "") Begin
22090>>>>>>>>>>>>>            Get EscapeViewStatePartial sRecordId to sRecordId
22091>>>>>>>>>>>>>            Move (sResult + "-" + sRecordId) to sResult
22092>>>>>>>>>>>>>            
22092>>>>>>>>>>>>>            If (sCustomHash <> "") Begin
22094>>>>>>>>>>>>>                Get EscapeViewStatePartial sCustomHash to sCustomHash
22095>>>>>>>>>>>>>                Move (sResult + "-" + sCustomHash) to sResult
22096>>>>>>>>>>>>>            End
22096>>>>>>>>>>>>>>
22096>>>>>>>>>>>>>        End
22096>>>>>>>>>>>>>>
22096>>>>>>>>>>>>>        
22096>>>>>>>>>>>>>        Function_Return sResult
22097>>>>>>>>>>>>>    End_Function

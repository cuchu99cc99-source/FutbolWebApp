26043>>>>>>>>>>>
26043>>>>>>>>>>>    // special Request_Find logic for web-lists. cWebColumn will direct a Request_Find
26043>>>>>>>>>>>    // to here. This understands non-data aware and static lists and ignores those
26043>>>>>>>>>>>    // requests. It also understands peRequestFindMode which can filter out finds that
26043>>>>>>>>>>>    // don't make sense in a grid.
26043>>>>>>>>>>>    
26043>>>>>>>>>>>    Procedure Request_Find Integer eFindMode
26045>>>>>>>>>>>        Integer iFile iField iIndex iMain iRelField 
26045>>>>>>>>>>>        Integer eRequestFindMode eDbGridType
26045>>>>>>>>>>>        Boolean bFound
26045>>>>>>>>>>>        Handle hoServer
26045>>>>>>>>>>>        Boolean bAllowSwitch bDataAware
26045>>>>>>>>>>>        
26045>>>>>>>>>>>        // only data aware grids process request_find
26045>>>>>>>>>>>        Get pbDataAware to bDataAware
26046>>>>>>>>>>>        If not bDataAware Begin
26048>>>>>>>>>>>            Move False to Found
26049>>>>>>>>>>>            Procedure_Return
26050>>>>>>>>>>>        End
26050>>>>>>>>>>>>
26050>>>>>>>>>>>        
26050>>>>>>>>>>>        // find mode determines what kind of finding is supported
26050>>>>>>>>>>>        Get peRequestFindMode to eRequestFindMode
26051>>>>>>>>>>>        
26051>>>>>>>>>>>        // if finding not allowed at all, no find
26051>>>>>>>>>>>        If (eRequestFindMode=rfmFindNone) Begin
26053>>>>>>>>>>>            Move False to Found
26054>>>>>>>>>>>            Procedure_Return
26055>>>>>>>>>>>        End
26055>>>>>>>>>>>>
26055>>>>>>>>>>>
26055>>>>>>>>>>>        Get peDbGridType to eDbGridType
26056>>>>>>>>>>>        Get Server to hoServer
26057>>>>>>>>>>>        Get Data_File to iFile
26058>>>>>>>>>>>        Get Data_Field to iField
26059>>>>>>>>>>>
26059>>>>>>>>>>>        If (hoServer=0 or iFile=0) Begin
26061>>>>>>>>>>>            Move False to Found
26062>>>>>>>>>>>            Procedure_Return
26063>>>>>>>>>>>        End
26063>>>>>>>>>>>>
26063>>>>>>>>>>>
26063>>>>>>>>>>>        Get Main_File of hoServer to iMain
26064>>>>>>>>>>>        
26064>>>>>>>>>>>        // if no finding index, no find
26064>>>>>>>>>>>        Get File_Field_Index of hoServer iFile iField to iIndex
26065>>>>>>>>>>>        If (iIndex=-1) Begin
26067>>>>>>>>>>>            Move False to Found
26068>>>>>>>>>>>            Procedure_Return
26069>>>>>>>>>>>        End
26069>>>>>>>>>>>>
26069>>>>>>>>>>>            
26069>>>>>>>>>>>        // if this is a main file find we will ignore it if main-file finds are
26069>>>>>>>>>>>        // not allowed or the grid is static. If Static, you should not be doing finds
26069>>>>>>>>>>>        // on the mainfile as it will cause the data to all be reloaded.
26069>>>>>>>>>>>        If (iFile=iMain and ( (eRequestFindMode=rfmFindParentOnly) or (eDbGridType<>gtAutomatic) ) ) Begin
26071>>>>>>>>>>>            Move False to Found
26072>>>>>>>>>>>            Procedure_Return
26073>>>>>>>>>>>        End
26073>>>>>>>>>>>>
26073>>>>>>>>>>>        // if main or find all or findparentonly (with a parent find)
26073>>>>>>>>>>>        Else If (iFile=iMain or eRequestFindMode=rfmFindAll or eRequestFindMode=rfmFindParentOnly ) Begin
26076>>>>>>>>>>>            Send Item_Find of hoServer eFindMode iFile iField True True False
26077>>>>>>>>>>>            Move (Found) to bFound
26078>>>>>>>>>>>        End
26078>>>>>>>>>>>>
26078>>>>>>>>>>>        // if parent with find mainonly
26078>>>>>>>>>>>        Else If (eRequestFindMode=rfmFindMainOnly) Begin
26081>>>>>>>>>>>           Move False to Found
26082>>>>>>>>>>>           Procedure_Return 
26083>>>>>>>>>>>        End
26083>>>>>>>>>>>>
26083>>>>>>>>>>>        // is parent with find superfind logic (used by prompt lists)
26083>>>>>>>>>>>        Else Begin
26084>>>>>>>>>>>           Get RelatingField iFile to iRelField
26085>>>>>>>>>>>           If (iRelField=-1) Begin
26087>>>>>>>>>>>               Move False to Found
26088>>>>>>>>>>>               Procedure_Return   
26089>>>>>>>>>>>           End
26089>>>>>>>>>>>>
26089>>>>>>>>>>>           
26089>>>>>>>>>>>           // if superfind mode, which means this is a prompt list we want to be able to change the
26089>>>>>>>>>>>           // parent, even if committed w/ no parent switch set. 
26089>>>>>>>>>>>           //So Clear that parentNoSwitch for the main-dd for this parent Find and then restore it
26089>>>>>>>>>>>           Get ParentNoSwitchIfCommitted of hoServer iFile to bAllowSwitch
26090>>>>>>>>>>>           Set ParentNoSwitchIfCommitted of hoServer iFile to False
26091>>>>>>>>>>>           Send Item_Find of hoServer eFindMode iFile iField True True False
26092>>>>>>>>>>>           Move (Found) to bFound
26093>>>>>>>>>>>           Set ParentNoSwitchIfCommitted of hoServer iFile to bAllowSwitch
26094>>>>>>>>>>>           If ( (bFound) ) Begin
26096>>>>>>>>>>>                Send Item_Find to hoServer GE iMain iRelField True True False
26097>>>>>>>>>>>                Move (Found) to bFound
26098>>>>>>>>>>>           End
26098>>>>>>>>>>>>
26098>>>>>>>>>>>        End
26098>>>>>>>>>>>>
26098>>>>>>>>>>>        
26098>>>>>>>>>>>        Move bFound to Found
26099>>>>>>>>>>>            
26099>>>>>>>>>>>    End_Procedure

8737>>>>>>>    // returns true if both sub-key and value exists.
8737>>>>>>>    Function ValueExists String sSubKey String sValueName Returns Boolean
8739>>>>>>>        String sKey
8739>>>>>>>        Handle hoRegistry
8739>>>>>>>        Boolean bOK
8739>>>>>>>        Get Create U_cRegistry to hoRegistry
8740>>>>>>>        Get RegistryKeyString to sKey
8741>>>>>>>        If (sSubKey <>"") ;            Move (sKey +'\' +sSubKey) to sKey
8744>>>>>>>        Get OpenKey of hoRegistry sKey to bOk
8745>>>>>>>        If (bOK) Begin
8747>>>>>>>            Move (ValueExists(hoRegistry, sValueName)) to bOk
8748>>>>>>>            Send CloseKey of hoRegistry
8749>>>>>>>        End
8749>>>>>>>>
8749>>>>>>>        Send Destroy of hoRegistry
8750>>>>>>>        Function_Return bOk
8751>>>>>>>    End_Function

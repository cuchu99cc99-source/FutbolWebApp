7542>>>>>>>>>>>           If (pbCaseSensitive(Self)) ;               Move sKey to searchVal.sName
7545>>>>>>>>>>>           Else Begin
7546>>>>>>>>>>>               Move (Uppercase(sKey)) to searchVal.sName
7547>>>>>>>>>>>               Move sKey to searchVal.sCaseName
7548>>>>>>>>>>>           End
7548>>>>>>>>>>>>
7548>>>>>>>>>>>           Move sValue to searchVal.sValue
7549>>>>>>>>>>>           
7549>>>>>>>>>>>           Move (SearchArray(searchVal, aIniData[iSection].aValues)) to iKey
7550>>>>>>>>>>>           
7550>>>>>>>>>>>           //  Insert of set value
7550>>>>>>>>>>>           If (iKey = -1) ;               Move (SizeOfArray(aIniData[iSection].aValues)) to iKey
7553>>>>>>>>>>>           
7553>>>>>>>>>>>           Move searchVal to aIniData[iSection].aValues[iKey]
7554>>>>>>>>>>>        End
7554>>>>>>>>>>>>
7554>>>>>>>>>>>        
7554>>>>>>>>>>>        Set paIniData to aIniData
7555>>>>>>>>>>>    End_Procedure
7556>>>>>>>>>>>    
7556>>>>>>>>>>>    /*    Reads a value from the ini file. The provided default value is retruned if the key and/or     section does not exist. Note that this works on the data in memory, call ReadFromFile to load an     ini file from disk.    */
7556>>>>>>>>>>>    Function GetValue String sSection String sKey String sDefault Returns String
7558>>>>>>>>>>>        tIniSection[] aIniData
7558>>>>>>>>>>>        tIniSection[] aIniData
7559>>>>>>>>>>>        Integer iSection iKey
7559>>>>>>>>>>>        
7559>>>>>>>>>>>        Get FindSection sSection to iSection
7560>>>>>>>>>>>        If (iSection = -1) ;            Function_Return sDefault
7563>>>>>>>>>>>      
7563>>>>>>>>>>>        Get paIniData to aIniData
7564>>>>>>>>>>>        Get FindKey (&aIniData[iSection]) sKey to iKey
7565>>>>>>>>>>>        If (iKey = -1) ;            Function_Return sDefault
7568>>>>>>>>>>>                
7568>>>>>>>>>>>        // Remove quotes as per Windows behavior.
7568>>>>>>>>>>>        If (pbRemoveQuotes(Self) and Left(aIniData[iSection].aValues[iKey].sValue, 1) = '"' and Right(aIniData[iSection].aValues[iKey].sValue, 1) = '"') Begin
7570>>>>>>>>>>>            Function_Return (Mid(aIniData[iSection].aValues[iKey].sValue, Length(aIniData[iSection].aValues[iKey].sValue) - 2, 2))
7571>>>>>>>>>>>        End
7571>>>>>>>>>>>>
7571>>>>>>>>>>>        
7571>>>>>>>>>>>        Function_Return aIniData[iSection].aValues[iKey].sValue
7572>>>>>>>>>>>    End_Function
7573>>>>>>>>>>>    
7573>>>>>>>>>>>    /*    Returns true if a section exists on the ini data.  Note that this works on the data in     memory, call ReadFromFile to load an ini file from disk.    */
7573>>>>>>>>>>>    Function HasSection String sSection Returns Boolean
7575>>>>>>>>>>>        Integer iSection 
7575>>>>>>>>>>>        
7575>>>>>>>>>>>        Get FindSection sSection to iSection
7576>>>>>>>>>>>        Function_Return (iSection <> -1)
7577>>>>>>>>>>>    End_Function
7578>>>>>>>>>>>    
7578>>>>>>>>>>>    /*    Checks if a key exists in the ini data.  Note that this works on the data in     memory, call ReadFromFile to load an ini file from disk.    */
7578>>>>>>>>>>>    Function HasKey String sSection String sKey Returns Boolean
7580>>>>>>>>>>>        tIniSection[] aIniData
7580>>>>>>>>>>>        tIniSection[] aIniData
7581>>>>>>>>>>>        Integer iSection iKey
7581>>>>>>>>>>>        
7581>>>>>>>>>>>        Get FindSection sSection to iSection
7582>>>>>>>>>>>        If (iSection = -1) ;            Function_Return False
7585>>>>>>>>>>>      
7585>>>>>>>>>>>        Get paIniData to aIniData
7586>>>>>>>>>>>        Get FindKey (&aIniData[iSection]) sKey to iKey
7587>>>>>>>>>>>        Function_Return (iKey <> -1)
7588>>>>>>>>>>>    End_Function
7589>>>>>>>>>>>    
7589>>>>>>>>>>>    /*    Deletes a section and all of its keys from the ini data. To apply the changes to disk call     WriteToFile.    */
7589>>>>>>>>>>>    Procedure RemoveSection String sSection
7591>>>>>>>>>>>        tIniSection[] aIniData
7591>>>>>>>>>>>        tIniSection[] aIniData
7592>>>>>>>>>>>        Integer iSection iKey
7592>>>>>>>>>>>        
7592>>>>>>>>>>>        Get FindSection sSection to iSection
7593>>>>>>>>>>>        If (iSection <> -1) Begin
7595>>>>>>>>>>>            Get paIniData to aIniData
7596>>>>>>>>>>>       
7596>>>>>>>>>>>            Move (RemoveFromArray(aIniData, iSection)) to aIniData
7597>>>>>>>>>>>            Set paIniData to aIniData
7598>>>>>>>>>>>        End
7598>>>>>>>>>>>>
7598>>>>>>>>>>>    End_Procedure
7599>>>>>>>>>>>    
7599>>>>>>>>>>>    /*    Deletes a key from the ini data, an error will occur if the key did not exist. To apply the     changes to disk call WriteToFile.    */
7599>>>>>>>>>>>    Procedure RemoveKey String sSection String sKey
7601>>>>>>>>>>>        tIniSection[] aIniData
7601>>>>>>>>>>>        tIniSection[] aIniData
7602>>>>>>>>>>>        Integer iSection iKey
7602>>>>>>>>>>>        
7602>>>>>>>>>>>        Get FindSection sSection to iSection
7603>>>>>>>>>>>        If (iSection <> -1) Begin
7605>>>>>>>>>>>            Get paIniData to aIniData
7606>>>>>>>>>>>            Get FindKey (&aIniData[iSection]) sKey to iKey
7607>>>>>>>>>>>            If (iKey <> -1) Begin
7609>>>>>>>>>>>                Move (RemoveFromArray(aIniData[iSection].aValues, iKey)) to aIniData[iSection].aValues
7610>>>>>>>>>>>                
7610>>>>>>>>>>>                //  Remove empty section
7610>>>>>>>>>>>                If (SizeOfArray(aIniData[iSection].aValues) = 0) ;                    Move (RemoveFromArray(aIniData, iSection)) to aIniData
7613>>>>>>>>>>>                
7613>>>>>>>>>>>                Set paIniData to aIniData
7614>>>>>>>>>>>            End
7614>>>>>>>>>>>>
7614>>>>>>>>>>>        End
7614>>>>>>>>>>>>
7614>>>>>>>>>>>    End_Procedure
7615>>>>>>>>>>>    
7615>>>>>>>>>>>    /*    Returns all sections that are defined in the ini data. Note that this works on the data in     memory, call ReadFromFile to load an ini file from disk.    */
7615>>>>>>>>>>>    Function Sections Returns String[]
7617>>>>>>>>>>>        tIniSection[] aIniData
7617>>>>>>>>>>>        tIniSection[] aIniData
7618>>>>>>>>>>>        Integer iSection iSectionTo
7618>>>>>>>>>>>        String[] aSections
7619>>>>>>>>>>>        
7619>>>>>>>>>>>        Get paIniData to aIniData
7620>>>>>>>>>>>        
7620>>>>>>>>>>>        Move (SizeOfArray(aIniData) - 1) to iSectionTo
7621>>>>>>>>>>>        For iSection from 0 to iSectionTo
7627>>>>>>>>>>>>
7627>>>>>>>>>>>            If (pbCaseSensitive(Self)) ;                Move aIniData[iSection].sName to aSections[iSection]
7630>>>>>>>>>>>            Else ;                Move aIniData[iSection].sCaseName to aSections[iSection]
7632>>>>>>>>>>>        Loop
7633>>>>>>>>>>>>
7633>>>>>>>>>>>        
7633>>>>>>>>>>>        Function_Return aSections
7634>>>>>>>>>>>    End_Function
7635>>>>>>>>>>>    
7635>>>>>>>>>>>    /*    Returns all keys available within the provided section. Note that this works on the data in     memory, call ReadFromFile to load an ini file from disk.    */
7635>>>>>>>>>>>    Function Keys String sSection Returns String[]
7637>>>>>>>>>>>        String[] aKeys
7638>>>>>>>>>>>        tIniSection[] aIniData
7638>>>>>>>>>>>        tIniSection[] aIniData
7639>>>>>>>>>>>        Integer iVal iValTo iSection
7639>>>>>>>>>>>        
7639>>>>>>>>>>>        Get FindSection sSection to iSection
7640>>>>>>>>>>>        If (iSection = -1) Begin
7642>>>>>>>>>>>            If (pbReportReadErrors(Self)) ;                Error DFERR_INI_FILE "Ini file section does not exist."
7645>>>>>>>>>>>        End
7645>>>>>>>>>>>>
7645>>>>>>>>>>>        Else Begin
7646>>>>>>>>>>>            Get paIniData to aIniData
7647>>>>>>>>>>>            Move (SizeOfArray(aIniData[iSection].aValues) - 1) to iValTo
7648>>>>>>>>>>>            
7648>>>>>>>>>>>            For iVal from 0 to iValTo
7654>>>>>>>>>>>>
7654>>>>>>>>>>>                If (not(aIniData[iSection].aValues[iVal].bComment)) Begin
7656>>>>>>>>>>>                    If (pbCaseSensitive(Self)) ;                        Move aIniData[iSection].aValues[iVal].sName to aKeys[iVal]
7659>>>>>>>>>>>                    Else ;                        Move aIniData[iSection].aValues[iVal].sCaseName to aKeys[iVal]
7661>>>>>>>>>>>                End
7661>>>>>>>>>>>>
7661>>>>>>>>>>>            Loop
7662>>>>>>>>>>>>
7662>>>>>>>>>>>        End
7662>>>>>>>>>>>>
7662>>>>>>>>>>>        
7662>>>>>>>>>>>        Function_Return aKeys
7663>>>>>>>>>>>    End_Function
7664>>>>>>>>>>>    
7664>>>>>>>>>>>End_Class
7665>>>>>>>>>>>
7665>>>>>>>>>>>
7665>>>>>>>>>>>/*Reads and writes ini files directly. Is compatible with the classic cIniFile.*/
7665>>>>>>>>>>>Class cIniFile is a cIniProcessor
7666>>>>>>>>>>>    Procedure Construct_Object
7668>>>>>>>>>>>        Forward Send Construct_Object
7670>>>>>>>>>>>        
7670>>>>>>>>>>>        Set pbReportReadErrors to False
7671>>>>>>>>>>>    End_Procedure
7672>>>>>>>>>>>    
7672>>>>>>>>>>>    Function OpenForWrite Returns Boolean
7674>>>>>>>>>>>        Boolean bSuccess bExists
7674>>>>>>>>>>>        
7674>>>>>>>>>>>        File_Exist (psFileName(Self)) bExists
7675>>>>>>>>>>>        
7675>>>>>>>>>>>        If (bExists) Begin
7677>>>>>>>>>>>            Get ReadFromFile to bSuccess
7678>>>>>>>>>>>            If (not(bSuccess)) ;                Function_Return False
7681>>>>>>>>>>>        End
7681>>>>>>>>>>>>
7681>>>>>>>>>>>        Else Begin
7682>>>>>>>>>>>            If (trim(psFileName(Self))="") Begin
7684>>>>>>>>>>>                Error DFERR_INI_FILE "Ini file name not defined"
7685>>>>>>>>>>>>
7685>>>>>>>>>>>                Function_Return False
7686>>>>>>>>>>>            End
7686>>>>>>>>>>>>
7686>>>>>>>>>>>        End
7686>>>>>>>>>>>>
7686>>>>>>>>>>>        
7686>>>>>>>>>>>        Function_Return True
7687>>>>>>>>>>>    End_Function
7688>>>>>>>>>>>    
7688>>>>>>>>>>>    /*    Writes a string directly to an ini file. Note that when setting multiple values it is more     efficient to use ReadFromFile, SetValue and WriteToFile separately.    */
7688>>>>>>>>>>>    Procedure WriteString String sSection String sKey String sValue
7690>>>>>>>>>>>        If (OpenForWrite(Self)) Begin
7692>>>>>>>>>>>            Send SetValue sSection sKey sValue
7693>>>>>>>>>>>        
7693>>>>>>>>>>>            Send WriteToFile
7694>>>>>>>>>>>        End
7694>>>>>>>>>>>>
7694>>>>>>>>>>>    End_Procedure
7695>>>>>>>>>>>    
7695>>>>>>>>>>>    /*    Reads a string directly to an ini file. Note that when reading multiple values it is more     efficient to call ReadFromFile and GetValue separately.    */
7695>>>>>>>>>>>    Function ReadString String sSection String sKey String sDefault Returns String
7697>>>>>>>>>>>        Boolean bSuccess
7697>>>>>>>>>>>        String sResult
7697>>>>>>>>>>>        
7697>>>>>>>>>>>        Move sDefault to sResult
7698>>>>>>>>>>>        
7698>>>>>>>>>>>        If (ReadFromFile(Self)) ;            Get GetValue sSection sKey sDefault to sResult
7701>>>>>>>>>>>            
7701>>>>>>>>>>>        Function_Return sResult    
7702>>>>>>>>>>>    End_Function
7703>>>>>>>>>>>    
7703>>>>>>>>>>>    /*    Deletes a section from an ini file. Note that to perform multiple manipulations calling     ReadFromFile, RemoveSection and WriteToFile separately is more efficient.    */
7703>>>>>>>>>>>    Procedure DeleteSection String sSection
7705>>>>>>>>>>>        If (OpenForWrite(Self)) Begin
7707>>>>>>>>>>>            Send RemoveSection sSection
7708>>>>>>>>>>>        
7708>>>>>>>>>>>            Send WriteToFile
7709>>>>>>>>>>>        End
7709>>>>>>>>>>>>
7709>>>>>>>>>>>    End_Procedure
7710>>>>>>>>>>>    
7710>>>>>>>>>>>    /*    Deletes a key from an ini file. Note that to perform multiple manipulations calling     ReadFromFile, RemoveKey and WriteToFile separately is more efficient.    */
7710>>>>>>>>>>>    Procedure DeleteKey String sSection String sKey
7712>>>>>>>>>>>        If (OpenForWrite(Self)) Begin
7714>>>>>>>>>>>            Send RemoveKey sSection sKey
7715>>>>>>>>>>>        
7715>>>>>>>>>>>            Send WriteToFile
7716>>>>>>>>>>>        End
7716>>>>>>>>>>>>
7716>>>>>>>>>>>    End_Procedure
7717>>>>>>>>>>>    
7717>>>>>>>>>>>    /*    Checks if a key exists in an ini file. When checking for multiple keys it is more     efficient to call ReadFromFile and HasKey separately.    */
7717>>>>>>>>>>>    Function KeyExists String sSection String sKey Returns Boolean
7719>>>>>>>>>>>        If (ReadFromFile(Self)) ;            Function_Return (HasKey(Self, sSection, sKey))
7722>>>>>>>>>>>            
7722>>>>>>>>>>>        Function_Return False
7723>>>>>>>>>>>    End_Function
7724>>>>>>>>>>>    
7724>>>>>>>>>>>    /*    Checks if a section exists in an ini file. When checking for multiple keys it is more     efficient to call ReadFromFile and HasSection separately.    */
7724>>>>>>>>>>>    Function SectionExists String sSection Returns Boolean
7726>>>>>>>>>>>        If (ReadFromFile(Self)) ;            Function_Return (HasSection(Self, sSection))
7729>>>>>>>>>>>            
7729>>>>>>>>>>>        Function_Return False
7730>>>>>>>>>>>    End_Function
7731>>>>>>>>>>>    
7731>>>>>>>>>>>    /*    Reads the sections into the provided array object. Here for compatibility only, please use the     Sections function that returns an array.    */
7731>>>>>>>>>>>    Procedure ReadSections Handle hoArray
7733>>>>>>>>>>>        String[] aSections
7734>>>>>>>>>>>        Integer iSection iSectionTo
7734>>>>>>>>>>>        
7734>>>>>>>>>>>        If (not(ReadFromFile(Self))) ;            Procedure_Return
7737>>>>>>>>>>>            
7737>>>>>>>>>>>        Get Sections to aSections
7738>>>>>>>>>>>        
7738>>>>>>>>>>>        Move (SizeOfArray(aSections) - 1) to iSectionTo
7739>>>>>>>>>>>        For iSection from 0 to iSectionTo
7745>>>>>>>>>>>>
7745>>>>>>>>>>>            Set Value of hoArray iSection to aSections[iSection]
7746>>>>>>>>>>>        Loop
7747>>>>>>>>>>>>
7747>>>>>>>>>>>    End_Procedure
7748>>>>>>>>>>>    
7748>>>>>>>>>>>    /*    Reads the keys of a section into the provided array object. Here for compatibility only,     please use the Keys function that retuns an array.    */
7748>>>>>>>>>>>    Procedure ReadSection String sSection Handle hoArray
7750>>>>>>>>>>>        String[] aKeys
7751>>>>>>>>>>>        Integer iKey iKeyTo
7751>>>>>>>>>>>        
7751>>>>>>>>>>>        If (not(ReadFromFile(Self))) ;            Procedure_Return
7754>>>>>>>>>>>        
7754>>>>>>>>>>>        Get Keys sSection to aKeys
7755>>>>>>>>>>>        
7755>>>>>>>>>>>        Move (SizeOfArray(aKeys) - 1) to iKeyTo
7756>>>>>>>>>>>        For iKey from 0 to iKeyTo
7762>>>>>>>>>>>>
7762>>>>>>>>>>>            Set Value of hoArray iKey to aKeys[iKey]
7763>>>>>>>>>>>        Loop
7764>>>>>>>>>>>>
7764>>>>>>>>>>>    End_Procedure
7765>>>>>>>>>>>End_Class

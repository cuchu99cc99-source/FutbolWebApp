35511>>>>>>>                    Send OnDefineDescription (&sDescription)
35512>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to sRowId
35513>>>>>>>                    Send AddComboItem sRowId (Trim(sDescription))
35514>>>>>>>                    
35514>>>>>>>                    Send Locate_Next of hoDD
35515>>>>>>>                Loop
35516>>>>>>>>
35516>>>>>>>                Set No_Relate_State of hoDD to bOldRelate
35517>>>>>>>           End
35517>>>>>>>>
35517>>>>>>>        End

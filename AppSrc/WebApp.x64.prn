14712>>>>>>>>>    // use this to generate a report of all errors
14712>>>>>>>>>    Procedure ReportAllErrors String sErrHdr
14714>>>>>>>>>        // if no errors... do nothing
14714>>>>>>>>>        If (ErrorCount(Self)) Begin

882>>>>>>>>>    If not bISCString ;        Append sString (character(0))
885>>>>>>>>>    Move (AddressOf(sString)) to psString
886>>>>>>>>>    If bToAnsi ;        Move (OEMToANSI(psString,psString)) to iVoid
889>>>>>>>>>    Else       ;        Move (ANSItoOEM(psString,psString)) to iVoid
891>>>>>>>>>    
891>>>>>>>>>    Function_Return (If(bIsCString, sString, cstring(sString)))
892>>>>>>>>>End_Function

35959>>>>>>>        WebSet ptAdvServerSyncPropsWrapper to tAdvSyncPropsWrapper
35960>>>>>>>        WebSet ptAdvServerSessionSyncPropsWrapper to tAdvSyncPropsWrapper
35961>>>>>>>        
35961>>>>>>>        Send ClientAction "resetContainer"
35962>>>>>>>    End_Procedure
35963>>>>>>>      
35963>>>>>>>    
35963>>>>>>>    // ====================
35963>>>>>>>    // CLIENT COMMUNICATION
35963>>>>>>>    // ====================
35963>>>>>>>    
35963>>>>>>>    // Adds a client action to the queue of client actions. Used to keep track
35963>>>>>>>    // of client actions that are executed before the objects actually 
35963>>>>>>>    // exist on the client.
35963>>>>>>>    Procedure AddClientAction tWebClientAction tClientAction
35965>>>>>>>        String sName
35965>>>>>>>        Integer iIndex
35965>>>>>>>        tWebDynamicObject tDynamicObject
35965>>>>>>>        tWebDynamicObject tDynamicObject
35965>>>>>>>        tWebDynamicObject[] aDynamicObjects
35965>>>>>>>        tWebDynamicObject[] aDynamicObjects
35966>>>>>>>        tWebClientAction[] aClientActionsQueue 
35966>>>>>>>        tWebClientAction[] aClientActionsQueue 
35967>>>>>>>        
35967>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
35968>>>>>>>        
35968>>>>>>>        // This simply removes parentage from the name of the object
35968>>>>>>>        Get TruncateName tClientAction.sTarget to tDynamicObject.sId
35969>>>>>>>        
35969>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
35970>>>>>>>        If (iIndex <> -1) Begin
35972>>>>>>>            If (aDynamicObjects[iIndex].bRendered) Begin
35974>>>>>>>                Send AddClientAction of (Owner(Self)) tClientAction
35975>>>>>>>            End 
35975>>>>>>>>
35975>>>>>>>            Else Begin
35976>>>>>>>                Get paClientActionsQueue to aClientActionsQueue 
35977>>>>>>>                Move tClientAction to aClientActionsQueue[SizeOfArray(aClientActionsQueue)]
35978>>>>>>>                Set paClientActionsQueue to aClientActionsQueue
35979>>>>>>>            End
35979>>>>>>>>
35979>>>>>>>        End
35979>>>>>>>>
35979>>>>>>>        Else Begin
35980>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$DynamicObjectNotRegistered, tDynamicObject.sId))
35981>>>>>>>>
35981>>>>>>>        End
35981>>>>>>>>
35981>>>>>>>    End_Procedure
35982>>>>>>>    
35982>>>>>>>    // Cancels a client action that was scheduled.
35982>>>>>>>    // tClientAction    - Is the action to be executed
35982>>>>>>>    Procedure OwnerCancelClientAction Handle hoWO String sName
35984>>>>>>>        Integer iIndex
35984>>>>>>>        Boolean bRendered
35984>>>>>>>        tWebDynamicObject tDynamicObject
35984>>>>>>>        tWebDynamicObject tDynamicObject
35984>>>>>>>        tWebDynamicObject[] aDynamicObjects
35984>>>>>>>        tWebDynamicObject[] aDynamicObjects
35985>>>>>>>        tWebClientAction[] aClientActionsQueue
35985>>>>>>>        tWebClientAction[] aClientActionsQueue
35986>>>>>>>        String sFullName
35986>>>>>>>        
35986>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
35987>>>>>>>        
35987>>>>>>>        // This simply removes parentage from the name of the object
35987>>>>>>>        Get WebObjectName of hoWO to sFullName
35988>>>>>>>        Get TruncateName sFullName to tDynamicObject.sId
35989>>>>>>>        
35989>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
35990>>>>>>>        If (iIndex <> -1) Begin
35992>>>>>>>            Move aDynamicObjects[iIndex].bRendered to bRendered
35993>>>>>>>            
35993>>>>>>>            If (bRendered) Begin
35995>>>>>>>                Send OwnerCancelClientAction of (Owner(Self)) hoWO sName
35996>>>>>>>            End 
35996>>>>>>>>
35996>>>>>>>            Else Begin
35997>>>>>>>                Get paClientActionsQueue to aClientActionsQueue 
35998>>>>>>>                For iIndex from 0 to (SizeOfArray(aClientActionsQueue) - 1)
36004>>>>>>>>
36004>>>>>>>                    If (aClientActionsQueue[iIndex].sTarget = sFullName and aClientActionsQueue[iIndex].sName = sName) Begin
36006>>>>>>>                        Move (RemoveFromArray(aClientActionsQueue, iIndex)) to aClientActionsQueue
36007>>>>>>>                        Decrement iIndex
36008>>>>>>>                    End
36008>>>>>>>>
36008>>>>>>>                Loop
36009>>>>>>>>
36009>>>>>>>                Set paClientActionsQueue to aClientActionsQueue
36010>>>>>>>                
36010>>>>>>>                
36010>>>>>>>            End
36010>>>>>>>>
36010>>>>>>>        End
36010>>>>>>>>
36010>>>>>>>    End_Procedure
36011>>>>>>>    
36011>>>>>>>    
36011>>>>>>>    // Signals that the dynamic objects of this container have been loaded.
36011>>>>>>>    // Sends all queued client actions to the client to be executed ands
36011>>>>>>>    // marks all dynamic objects as being rendered.
36011>>>>>>>    Procedure FinishRendering String[] aObjects
36013>>>>>>>        Integer icObjects iObject iObjectIndex
36013>>>>>>>        tWebDynamicObject tDynamicObject
36013>>>>>>>        tWebDynamicObject tDynamicObject
36013>>>>>>>        tWebDynamicObject[] aDynamicObjects
36013>>>>>>>        tWebDynamicObject[] aDynamicObjects
36014>>>>>>>        tWebClientAction[] aClientActions aClientActionsQueue
36014>>>>>>>        tWebClientAction[] aClientActions aClientActionsQueue
36016>>>>>>>        
36016>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36017>>>>>>>        
36017>>>>>>>        Get paClientActions of (Host(Self)) to aClientActions
36018>>>>>>>        Get paClientActionsQueue to aClientActionsQueue
36019>>>>>>>        Move (AppendArray(aClientActions, aClientActionsQueue)) to aClientActions
36020>>>>>>>        Set paClientActions of (Host(Self)) to aClientActions
36021>>>>>>>        
36021>>>>>>>        Move (ResizeArray(aClientActionsQueue, 0)) to aClientActionsQueue
36022>>>>>>>        Set paClientActionsQueue to aClientActionsQueue
36023>>>>>>>        
36023>>>>>>>        Move (SizeOfArray(aObjects)) to icObjects
36024>>>>>>>        For iObject from 0 to (icObjects - 1)
36030>>>>>>>>
36030>>>>>>>            Send SetRendered aObjects[iObject] True (&aDynamicObjects) True
36031>>>>>>>        Loop
36032>>>>>>>>
36032>>>>>>>        
36032>>>>>>>        WebSet paDynamicObjects to aDynamicObjects
36033>>>>>>>        WebSet pbActivated to True
36034>>>>>>>    End_Procedure
36035>>>>>>>    
36035>>>>>>>    
36035>>>>>>>    // =====================================
36035>>>>>>>    // DYNAMIC OBJECT CREATION & DESTRUCTION
36035>>>>>>>    // =====================================
36035>>>>>>>    
36035>>>>>>>    // Registers a dynamic object
36035>>>>>>>    Function CreateDynamicObject Integer iClassId String sDynamicObjectId String sParentId Returns Handle
36037>>>>>>>        Integer iIndex
36037>>>>>>>        Handle hoObj
36037>>>>>>>        tWebDynamicObject tDynamicObject
36037>>>>>>>        tWebDynamicObject tDynamicObject
36037>>>>>>>        tWebDynamicObject[] aDynamicObjects  
36037>>>>>>>        tWebDynamicObject[] aDynamicObjects  
36038>>>>>>>        
36038>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36039>>>>>>>
36039>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36040>>>>>>>
36040>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36041>>>>>>>        If (iIndex = -1) Begin                 
36043>>>>>>>            // Dynamic object has not been registered before, so append it  
36043>>>>>>>            Move (BinarySearchInsertPos()) to iIndex 
36044>>>>>>>            
36044>>>>>>>            //  Check for illegal characters in the id
36044>>>>>>>            If (Pos("#", sDynamicObjectId) > 0 or Pos("$", sDynamicObjectId) > 0) Begin
36046>>>>>>>                Error DFERR_PROGRAM (SFormat("# and $ characters are not allowed in sDynamicObjectId ('%1').", sDynamicObjectId))
36047>>>>>>>>
36047>>>>>>>                Function_Return C_WebUnresolvedObject 
36048>>>>>>>            End
36048>>>>>>>>
36048>>>>>>>            
36048>>>>>>>            Move sParentId to tDynamicObject.sParentId
36049>>>>>>>            Move iClassId to tDynamicObject.iClassId
36050>>>>>>>            Move False to tDynamicObject.bRendered
36051>>>>>>>            
36051>>>>>>>            Move (InsertInArray(aDynamicObjects, iIndex, tDynamicObject)) to aDynamicObjects
36052>>>>>>>            
36052>>>>>>>            WebSet paDynamicObjects to aDynamicObjects
36053>>>>>>>            
36053>>>>>>>            // Create the object
36053>>>>>>>            Set pbIsCreating to True
36054>>>>>>>            Get CreateLocal sDynamicObjectId to hoObj
36055>>>>>>>            Set pbIsCreating to False
36056>>>>>>>            
36056>>>>>>>            // Insert object at end of parent's child structure
36056>>>>>>>            Send AppendToSiblings sDynamicObjectId
36057>>>>>>>        End        
36057>>>>>>>>
36057>>>>>>>        Else Begin
36058>>>>>>>            // Object has been registered before, so throw an error
36058>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$DynamicObjectAlreadyExists, sDynamicObjectId))
36059>>>>>>>>
36059>>>>>>>        End
36059>>>>>>>>
36059>>>>>>>        
36059>>>>>>>        Function_Return hoObj
36060>>>>>>>    End_Function
36061>>>>>>>    
36061>>>>>>>    
36061>>>>>>>    // Moves a dynamic object to a different location, after another specified dynamic object.
36061>>>>>>>    Procedure MoveDynamicObject String sDynamicObjectId String sInsertAfter
36063>>>>>>>        String sParentId sName
36063>>>>>>>        String[] aParams aChildren
36065>>>>>>>        Integer iIndex iRemoveIndex iInsertIndex
36065>>>>>>>        Boolean bSendCommand
36065>>>>>>>        Handle hoObj
36065>>>>>>>        tWebDynamicObject tDynamicObject
36065>>>>>>>        tWebDynamicObject tDynamicObject
36065>>>>>>>        tWebDynamicObject[] aDynamicObjects
36065>>>>>>>        tWebDynamicObject[] aDynamicObjects
36066>>>>>>>        
36066>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36067>>>>>>>        
36067>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36068>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36069>>>>>>>        If (iIndex <> -1) Begin
36071>>>>>>>            Move aDynamicObjects[iIndex].sParentId to sParentId
36072>>>>>>>            Move sParentId to tDynamicObject.sId
36073>>>>>>>            
36073>>>>>>>            // Remove child from old location
36073>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36074>>>>>>>            If (iIndex <> -1) Begin
36076>>>>>>>                Move (SearchArray(sDynamicObjectId, aDynamicObjects[iIndex].aChildren)) to iRemoveIndex
36077>>>>>>>                Move (RemoveFromArray(aDynamicObjects[iIndex].aChildren, iRemoveIndex)) to aDynamicObjects[iIndex].aChildren
36078>>>>>>>            End  
36078>>>>>>>>
36078>>>>>>>            
36078>>>>>>>            // Insert child at new location
36078>>>>>>>            Move sInsertAfter to tDynamicObject.sId
36079>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36080>>>>>>>            If (iIndex <> -1) Begin
36082>>>>>>>                Move aDynamicObjects[iIndex].sParentId to sParentId
36083>>>>>>>                
36083>>>>>>>                // Find new parent
36083>>>>>>>                Move sParentId to tDynamicObject.sId
36084>>>>>>>                Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36085>>>>>>>                If (iIndex <> -1) Begin
36087>>>>>>>                    Move (SearchArray(sInsertAfter, aDynamicObjects[iIndex].aChildren)) to iInsertIndex
36088>>>>>>>                    If (iInsertIndex <> -1) Begin
36090>>>>>>>                        Move aDynamicObjects[iIndex].aChildren to aChildren
36091>>>>>>>                        
36091>>>>>>>                        // Insert object afer sInsertAfter
36091>>>>>>>                        Move (InsertInArray(aChildren, iInsertIndex + 1, sDynamicObjectId)) to aChildren
36092>>>>>>>                        Move aChildren to aDynamicObjects[iIndex].aChildren
36093>>>>>>>                        WebSet paDynamicObjects to aDynamicObjects
36094>>>>>>>                        
36094>>>>>>>                        Move True to bSendCommand
36095>>>>>>>                    End
36095>>>>>>>>
36095>>>>>>>                End
36095>>>>>>>>
36095>>>>>>>            End
36095>>>>>>>>
36095>>>>>>>        End
36095>>>>>>>>
36095>>>>>>>        
36095>>>>>>>        If (bSendCommand) Begin
36097>>>>>>>            Send ConnectRadioButtons
36098>>>>>>>            
36098>>>>>>>            Get DynamicObject sDynamicObjectId to hoObj
36099>>>>>>>            Get WebObjectName of hoObj to sName
36100>>>>>>>            
36100>>>>>>>            Move sName to aParams[0]
36101>>>>>>>            
36101>>>>>>>            Get DynamicObject sInsertAfter to hoObj
36102>>>>>>>            Get WebObjectName of hoObj to sName
36103>>>>>>>            
36103>>>>>>>            Move sName to aParams[1]
36104>>>>>>>            
36104>>>>>>>            Send ClientAction "moveDynamicObject" aParams
36105>>>>>>>        End
36105>>>>>>>>
36105>>>>>>>    End_Procedure
36106>>>>>>>    
36106>>>>>>>    
36106>>>>>>>    // Moves a dynamic object to a specific index in a new parent's list of children.
36106>>>>>>>    Procedure MoveDynamicObjectToIndex String sDynamicObjectId String sParentId Integer iInsertIndex
36108>>>>>>>        String sName
36108>>>>>>>        String[] aParams aChildren
36110>>>>>>>        Integer iIndex iRemoveIndex
36110>>>>>>>        Boolean bSendCommand
36110>>>>>>>        Handle hoObj
36110>>>>>>>        tWebDynamicObject tDynamicObject
36110>>>>>>>        tWebDynamicObject tDynamicObject
36110>>>>>>>        tWebDynamicObject[] aDynamicObjects
36110>>>>>>>        tWebDynamicObject[] aDynamicObjects
36111>>>>>>>        
36111>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36112>>>>>>>        
36112>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36113>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36114>>>>>>>        If (iIndex <> -1) Begin
36116>>>>>>>            Move aDynamicObjects[iIndex].sParentId to tDynamicObject.sId
36117>>>>>>>            
36117>>>>>>>            // Remove child from old location
36117>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36118>>>>>>>            If (iIndex <> -1) Begin
36120>>>>>>>                Move (SearchArray(sDynamicObjectId, aDynamicObjects[iIndex].aChildren)) to iRemoveIndex
36121>>>>>>>                Move (RemoveFromArray(aDynamicObjects[iIndex].aChildren, iRemoveIndex)) to aDynamicObjects[iIndex].aChildren
36122>>>>>>>            End  
36122>>>>>>>>
36122>>>>>>>                
36122>>>>>>>            // Find new parent
36122>>>>>>>            Move sParentId to tDynamicObject.sId
36123>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36124>>>>>>>            If (iIndex <> -1) Begin
36126>>>>>>>                Move aDynamicObjects[iIndex].aChildren to aChildren
36127>>>>>>>                
36127>>>>>>>                // Insert object afer sInsertAfter
36127>>>>>>>                Move (InsertInArray(aChildren, iInsertIndex, sDynamicObjectId)) to aChildren
36128>>>>>>>                Move aChildren to aDynamicObjects[iIndex].aChildren
36129>>>>>>>                WebSet paDynamicObjects to aDynamicObjects
36130>>>>>>>                
36130>>>>>>>                Move True to bSendCommand
36131>>>>>>>            End
36131>>>>>>>>
36131>>>>>>>        End
36131>>>>>>>>
36131>>>>>>>        
36131>>>>>>>        If (bSendCommand) Begin
36133>>>>>>>            Send ConnectRadioButtons
36134>>>>>>>            
36134>>>>>>>            Get DynamicObject sDynamicObjectId to hoObj
36135>>>>>>>            Get WebObjectName of hoObj to sName
36136>>>>>>>            Move sName to aParams[0] 
36137>>>>>>>            
36137>>>>>>>            Get DynamicObject sParentId to hoObj
36138>>>>>>>            Get WebObjectName of hoObj to sName
36139>>>>>>>            Move sName to aParams[1] 
36140>>>>>>>
36140>>>>>>>            Move iInsertIndex to aParams[2]
36141>>>>>>>            
36141>>>>>>>            Send ClientAction "moveDynamicObjectToIndex" aParams
36142>>>>>>>        End 
36142>>>>>>>>
36142>>>>>>>    End_Procedure
36143>>>>>>>    
36143>>>>>>>    
36143>>>>>>>    // Inserts a dynamic object after the given object. The inserted 
36143>>>>>>>    // object inherits the parent of the object it is inserted after.
36143>>>>>>>    Procedure InsertDynamicObject String sDynamicObjectId String sInsertAfter
36145>>>>>>>        String sParentId
36145>>>>>>>        String[] aParams aChildren aEmptyArray aObjects
36149>>>>>>>        Integer iIndex iInsertIndex iRemoveIndex
36149>>>>>>>        Boolean bSendCommand
36149>>>>>>>        Handle hoObj hoQueuedSyncPropsJson hoObjectJson
36149>>>>>>>        tWebDynamicObject tDynamicObject
36149>>>>>>>        tWebDynamicObject tDynamicObject
36149>>>>>>>        tWebDynamicObject[] aDynamicObjects
36149>>>>>>>        tWebDynamicObject[] aDynamicObjects
36150>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36150>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36151>>>>>>>        
36151>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36152>>>>>>>        
36152>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36153>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36154>>>>>>>        If (iIndex <> -1) Begin
36156>>>>>>>            // Retrieve parent
36156>>>>>>>            Move aDynamicObjects[iIndex].sParentId to sParentId
36157>>>>>>>            
36157>>>>>>>            // Find parent object
36157>>>>>>>            Move sParentId to tDynamicObject.sId
36158>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36159>>>>>>>            If (iIndex <> -1) Begin
36161>>>>>>>                
36161>>>>>>>                // Remove previously appended object (in CreateDynamicObject)
36161>>>>>>>                Move (SearchArray(sDynamicObjectId, aDynamicObjects[iIndex].aChildren)) to iRemoveIndex
36162>>>>>>>                Move (RemoveFromArray(aDynamicObjects[iIndex].aChildren, iRemoveIndex)) to aDynamicObjects[iIndex].aChildren
36163>>>>>>>                
36163>>>>>>>                Move (SearchArray(sInsertAfter, aDynamicObjects[iIndex].aChildren)) to iInsertIndex
36164>>>>>>>                If (iInsertIndex <> -1) Begin
36166>>>>>>>                    Move aDynamicObjects[iIndex].aChildren to aChildren
36167>>>>>>>                    
36167>>>>>>>                    // Insert object afer sInsertAfter
36167>>>>>>>                    Move (InsertInArray(aChildren, iInsertIndex + 1, sDynamicObjectId)) to aChildren
36168>>>>>>>                    Move aChildren to aDynamicObjects[iIndex].aChildren
36169>>>>>>>                    WebSet paDynamicObjects to aDynamicObjects
36170>>>>>>>                    
36170>>>>>>>                    Move True to bSendCommand
36171>>>>>>>                End
36171>>>>>>>>
36171>>>>>>>            End
36171>>>>>>>>
36171>>>>>>>            Else Begin
36172>>>>>>>                Error DFERR_PROGRAM (SFormat(C_$DynamicParentNotFound, sParentId))
36173>>>>>>>>
36173>>>>>>>            End
36173>>>>>>>>
36173>>>>>>>        End
36173>>>>>>>>
36173>>>>>>>        Else Begin
36174>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$CannotInsertDynamic, sInsertAfter))
36175>>>>>>>>
36175>>>>>>>        End
36175>>>>>>>>
36175>>>>>>>        
36175>>>>>>>        // Finally, send an insert command to the client
36175>>>>>>>        If (bSendCommand) Begin
36177>>>>>>>            Send ConnectRadioButtons
36178>>>>>>>            
36178>>>>>>>            Get DynamicObject sDynamicObjectId to hoObj
36179>>>>>>>            Get SerializeDynamicObject hoObj aDynamicObjects to hoObjectJson
36180>>>>>>>            WebGet paSyncPropsQueue to aSyncPropsQueue
36181>>>>>>>            
36181>>>>>>>            Get DynamicObject sParentId to hoObj
36182>>>>>>>            Get WebObjectName of hoObj to sParentId
36183>>>>>>>            
36183>>>>>>>            // Convert queued sync props to JSON
36183>>>>>>>            Get Create (RefClass(cJsonObject)) to hoQueuedSyncPropsJson
36184>>>>>>>            Send DataTypeToJson of hoQueuedSyncPropsJson aSyncPropsQueue 
36185>>>>>>>
36185>>>>>>>            Move sParentId to aParams[0]
36186>>>>>>>            Move sInsertAfter to aParams[1]
36187>>>>>>>            
36187>>>>>>>            // Send actions to the client
36187>>>>>>>            Send ClientActionEx "loadQueuedSyncProps" aEmptyArray hoQueuedSyncPropsJson
36188>>>>>>>            Send ClientActionEx "insertDynamicObject" aParams hoObjectJson
36189>>>>>>>            
36189>>>>>>>            Send Destroy of hoObjectJson
36190>>>>>>>            Send Destroy of hoQueuedSyncPropsJson
36191>>>>>>>
36191>>>>>>>            Move sDynamicObjectId to aObjects[0]
36192>>>>>>>            Send FinishRendering aObjects
36193>>>>>>>        End
36193>>>>>>>>
36193>>>>>>>    End_Procedure
36194>>>>>>>    
36194>>>>>>>    
36194>>>>>>>    // Inserts a dynamic object at a certain index in its parent's list of childen.
36194>>>>>>>    Procedure InsertDynamicObjectAtIndex String sDynamicObjectId String sParentId Integer iInsertIndex
36196>>>>>>>        String[] aParams aChildren aEmptyArray aObjects
36200>>>>>>>        Integer iIndex iRemoveIndex
36200>>>>>>>        Boolean bSendCommand
36200>>>>>>>        Handle hoObj hoQueuedSyncPropsJson hoObjectJson
36200>>>>>>>        tWebDynamicObject tDynamicObject
36200>>>>>>>        tWebDynamicObject tDynamicObject
36200>>>>>>>        tWebDynamicObject[] aDynamicObjects
36200>>>>>>>        tWebDynamicObject[] aDynamicObjects
36201>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36201>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36202>>>>>>>        
36202>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36203>>>>>>>        
36203>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36204>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36205>>>>>>>        If (iIndex <> -1) Begin
36207>>>>>>>            // Retrieve parent
36207>>>>>>>            Move aDynamicObjects[iIndex].sParentId to sParentId
36208>>>>>>>            
36208>>>>>>>            // Find parent object
36208>>>>>>>            Move sParentId to tDynamicObject.sId
36209>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36210>>>>>>>            If (iIndex <> -1) Begin
36212>>>>>>>                
36212>>>>>>>                // Remove previously appended object (in CreateDynamicObject)
36212>>>>>>>                Move (SearchArray(sDynamicObjectId, aDynamicObjects[iIndex].aChildren)) to iRemoveIndex
36213>>>>>>>                Move (RemoveFromArray(aDynamicObjects[iIndex].aChildren, iRemoveIndex)) to aDynamicObjects[iIndex].aChildren
36214>>>>>>>            End
36214>>>>>>>>
36214>>>>>>>                
36214>>>>>>>            // Find new parent
36214>>>>>>>            Move sParentId to tDynamicObject.sId
36215>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36216>>>>>>>            If (iIndex <> -1) Begin
36218>>>>>>>                Move aDynamicObjects[iIndex].aChildren to aChildren
36219>>>>>>>                
36219>>>>>>>                // Insert object at specified index
36219>>>>>>>                Move (InsertInArray(aChildren, iInsertIndex, sDynamicObjectId)) to aChildren
36220>>>>>>>                Move aChildren to aDynamicObjects[iIndex].aChildren
36221>>>>>>>                WebSet paDynamicObjects to aDynamicObjects
36222>>>>>>>                
36222>>>>>>>                Move True to bSendCommand
36223>>>>>>>            End
36223>>>>>>>>
36223>>>>>>>        End
36223>>>>>>>>
36223>>>>>>>        
36223>>>>>>>        If (bSendCommand) Begin
36225>>>>>>>            Send ConnectRadioButtons
36226>>>>>>>            
36226>>>>>>>            Get DynamicObject sDynamicObjectId to hoObj
36227>>>>>>>            Get SerializeDynamicObject hoObj aDynamicObjects to hoObjectJson
36228>>>>>>>            WebGet paSyncPropsQueue to aSyncPropsQueue
36229>>>>>>>            
36229>>>>>>>            Get DynamicObject sParentId to hoObj
36230>>>>>>>            Get WebObjectName of hoObj to sParentId
36231>>>>>>>            
36231>>>>>>>            // Convert queued sync props to JSON
36231>>>>>>>            Get Create (RefClass(cJsonObject)) to hoQueuedSyncPropsJson
36232>>>>>>>            Send DataTypeToJson of hoQueuedSyncPropsJson aSyncPropsQueue 
36233>>>>>>>            
36233>>>>>>>            // Convert object definition to JSON
36233>>>>>>>
36233>>>>>>>            
36233>>>>>>>            Move sParentId to aParams[0]
36234>>>>>>>            Move iInsertIndex to aParams[1]
36235>>>>>>>            
36235>>>>>>>            // Send actions to the client
36235>>>>>>>            Send ClientActionEx "loadQueuedSyncProps" aEmptyArray hoQueuedSyncPropsJson
36236>>>>>>>            Send ClientActionEx "insertDynamicObjectAtIndex" aParams hoObjectJson
36237>>>>>>>            
36237>>>>>>>            Send Destroy of hoObjectJson
36238>>>>>>>            Send Destroy of hoQueuedSyncPropsJson
36239>>>>>>>
36239>>>>>>>            Move sDynamicObjectId to aObjects[0]
36240>>>>>>>            Send FinishRendering aObjects
36241>>>>>>>        End 
36241>>>>>>>>
36241>>>>>>>    End_Procedure
36242>>>>>>>    
36242>>>>>>>    
36242>>>>>>>    // Appends a dynamic object at the end of its parent's list of children.
36242>>>>>>>    Procedure AppendDynamicObject String sDynamicObjectId
36244>>>>>>>        String[] aParams aEmptyParams aObjects
36247>>>>>>>        Handle hoObj hoQueuedSyncPropsJson hoObjectJson
36247>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36247>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36248>>>>>>>        tWebDynamicObject[] aDynamicObjects
36248>>>>>>>        tWebDynamicObject[] aDynamicObjects
36249>>>>>>>        
36249>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36250>>>>>>>        
36250>>>>>>>        Send ConnectRadioButtons
36251>>>>>>>            
36251>>>>>>>        Get DynamicObject sDynamicObjectId to hoObj
36252>>>>>>>        Get SerializeDynamicObject hoObj aDynamicObjects to hoObjectJson
36253>>>>>>>        WebGet paSyncPropsQueue to aSyncPropsQueue
36254>>>>>>>        
36254>>>>>>>        // Convert queued sync props to JSON
36254>>>>>>>        Get Create (RefClass(cJsonObject)) to hoQueuedSyncPropsJson
36255>>>>>>>        Send DataTypeToJson of hoQueuedSyncPropsJson aSyncPropsQueue 
36256>>>>>>>        
36256>>>>>>>        // Convert object definition to JSON
36256>>>>>>>        Get DynamicParent sDynamicObjectId to hoObj
36257>>>>>>>        Get WebObjectName of hoObj to aParams[0]
36258>>>>>>>        
36258>>>>>>>        // Send actions to the client
36258>>>>>>>        Send ClientActionEx "loadQueuedSyncProps" aEmptyParams hoQueuedSyncPropsJson
36259>>>>>>>        Send ClientActionEx "appendDynamicObject" aParams hoObjectJson
36260>>>>>>>        
36260>>>>>>>        Send Destroy of hoObjectJson
36261>>>>>>>        Send Destroy of hoQueuedSyncPropsJson
36262>>>>>>>
36262>>>>>>>        Move sDynamicObjectId to aObjects[0]

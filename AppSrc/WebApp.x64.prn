37783>>>>>>>
37783>>>>>>>    // Convert a clColor to a hex value
37783>>>>>>>    // Taken and adapted from Convetions lib
37783>>>>>>>    //
37783>>>>>>>    // iColor: The cl Color value
37783>>>>>>>    //
37783>>>>>>>    // Returns: HTML HEX color value as a string
37783>>>>>>>    Function GDIColorToHex Integer iColor Returns String
37785>>>>>>>        String sResult
37785>>>>>>>        Repeat
37785>>>>>>>>
37785>>>>>>>            Move (sResult + Mid ("0123456789ABCDEF", 1, ((iColor iand |CI$0F) + 1))) to sResult
37786>>>>>>>            Move (iColor / |CI$10) to iColor
37787>>>>>>>        Until (iColor = 0)
37789>>>>>>>
37789>>>>>>>        // Fill remaining
37789>>>>>>>        While (Length(sResult) < 6)
37793>>>>>>>            Move (sResult + "0") to sResult
37794>>>>>>>        Loop
37795>>>>>>>>
37795>>>>>>>
37795>>>>>>>        // Prepend hash symbol
37795>>>>>>>        Move ("#" + sResult) to sResult
37796>>>>>>>
37796>>>>>>>        Function_Return sResult
37797>>>>>>>    End_Function

30576>>>>>>>    Function IsLoadWebAppCall tWebCallContext ByRef cctx Returns Boolean
30578>>>>>>>        Integer i 
30578>>>>>>>        
30578>>>>>>>        For i from 0 to (SizeOfArray(cctx.request.aActions) - 1)
30584>>>>>>>>
30584>>>>>>>            If (cctx.request.aActions[i].sTarget = "" and cctx.request.aActions[i].sAction = "LoadWebApp") Begin
30586>>>>>>>                Function_Return True
30587>>>>>>>            End
30587>>>>>>>>
30587>>>>>>>        Loop
30588>>>>>>>>
30588>>>>>>>        
30588>>>>>>>        Function_Return False
30589>>>>>>>    End_Function

7123>>>>>>>>>>>Function Seq_New_Channel Global Returns Integer
7125>>>>>>>>>>>    Integer iObject iChannel
7125>>>>>>>>>>>    
7125>>>>>>>>>>>    Move DF_SEQ_START_CHANNEL to iChannel
7126>>>>>>>>>>>    
7126>>>>>>>>>>>    While (iChannel < DF_SEQ_CHANNEL_MAX)
7130>>>>>>>>>>>        If (Seq_Channel_Mode(iChannel) = DF_SEQ_CHANNEL_MODE_CLOSED) Begin
7132>>>>>>>>>>>            Set Seq_Channel_Mode iChannel to DF_SEQ_CHANNEL_MODE_OPEN
7133>>>>>>>>>>>            Function_Return iChannel
7134>>>>>>>>>>>        End
7134>>>>>>>>>>>>
7134>>>>>>>>>>>        
7134>>>>>>>>>>>        Increment iChannel
7135>>>>>>>>>>>    Loop
7136>>>>>>>>>>>>
7136>>>>>>>>>>>    
7136>>>>>>>>>>>    // wrap back to beginning
7136>>>>>>>>>>>    Move 0 to iChannel
7137>>>>>>>>>>>    
7137>>>>>>>>>>>    While (iChannel < DF_SEQ_START_CHANNEL)
7141>>>>>>>>>>>        If (Seq_Channel_Mode(iChannel) = DF_SEQ_CHANNEL_MODE_CLOSED) Begin
7143>>>>>>>>>>>            Set Seq_Channel_Mode iChannel to DF_SEQ_CHANNEL_MODE_OPEN
7144>>>>>>>>>>>            Function_Return iChannel
7145>>>>>>>>>>>        End
7145>>>>>>>>>>>>
7145>>>>>>>>>>>        
7145>>>>>>>>>>>        Increment iChannel
7146>>>>>>>>>>>    Loop
7147>>>>>>>>>>>>
7147>>>>>>>>>>>    
7147>>>>>>>>>>>    Function_Return DF_SEQ_CHANNEL_NOT_AVAILABLE
7148>>>>>>>>>>>End_Function
7149>>>>>>>>>>>
7149>>>>>>>>>>>Procedure Seq_Release_Channel Global Integer iChannel
7151>>>>>>>>>>>    If ((iChannel >= DF_SEQ_CHANNEL_MIN) and (iChannel <= DF_SEQ_CHANNEL_MAX)) Begin
7153>>>>>>>>>>>        Set Seq_Channel_Mode iChannel to DF_SEQ_CHANNEL_MODE_CLOSED
7154>>>>>>>>>>>    End
7154>>>>>>>>>>>>
7154>>>>>>>>>>>End_Procedure
7155>>>>>>>>>>>
7155>>>>>>>>>>>Function Seq_Open_Input_Channel Global String sChannel Returns Integer
7157>>>>>>>>>>>    Integer iChannel
7157>>>>>>>>>>>    
7157>>>>>>>>>>>    Move (Seq_New_Channel()) to iChannel
7158>>>>>>>>>>>    
7158>>>>>>>>>>>    If (iChannel <= DF_SEQ_CHANNEL_ERROR) Begin
7160>>>>>>>>>>>        If (Seq_Channel_Error_Mode() = DF_SEQ_CHANNEL_ERROR_MODE_ALL) Begin
7162>>>>>>>>>>>            Error DFERR_CANT_OPEN_INPUT_FILE (sChannel + ":" *C_$NoOpenChannels)
7163>>>>>>>>>>>>
7163>>>>>>>>>>>        End
7163>>>>>>>>>>>>
7163>>>>>>>>>>>        Function_Return iChannel
7164>>>>>>>>>>>    End
7164>>>>>>>>>>>>
7164>>>>>>>>>>>    
7164>>>>>>>>>>>    Move False to Err
7165>>>>>>>>>>>    Direct_Input channel iChannel sChannel
7167>>>>>>>>>>>    
7167>>>>>>>>>>>    If (Err) Begin
7169>>>>>>>>>>>        Send Seq_Release_Channel iChannel
7170>>>>>>>>>>>        Function_Return DF_SEQ_CHANNEL_ERROR
7171>>>>>>>>>>>    End
7171>>>>>>>>>>>>
7171>>>>>>>>>>>    
7171>>>>>>>>>>>    Set Seq_Channel_Mode iChannel to DF_SEQ_CHANNEL_MODE_INPUT
7172>>>>>>>>>>>    
7172>>>>>>>>>>>    Function_Return iChannel
7173>>>>>>>>>>>End_Function
7174>>>>>>>>>>>
7174>>>>>>>>>>>Function Seq_Open_Output_Channel Global String sChannel Returns Integer
7176>>>>>>>>>>>    Integer iChannel

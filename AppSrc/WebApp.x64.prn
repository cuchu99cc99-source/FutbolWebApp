2361>>>>>>>Class cDAWSQLDriverHelper is a cObject
2362>>>>>>>
2362>>>>>>>    Function DriverIndex String sDriver Returns Integer
2364>>>>>>>        String  sCurrentDriver
2364>>>>>>>        Integer iNumberOfDrivers iDriver iCount
2364>>>>>>>        Move 0 to iDriver
2365>>>>>>>        Get_Attribute DF_NUMBER_DRIVERS to iNumberOfDrivers
2368>>>>>>>        For iCount from 1 to iNumberOfDrivers
2374>>>>>>>>
2374>>>>>>>            Get_Attribute DF_DRIVER_NAME of iCount to sCurrentDriver
2377>>>>>>>            If ( Uppercase(sCurrentDriver) = Uppercase(sDriver) ) Begin
2379>>>>>>>                Function_Return iCount
2380>>>>>>>            End
2380>>>>>>>>
2380>>>>>>>        Loop
2381>>>>>>>>
2381>>>>>>>        Function_Return 0
2382>>>>>>>    End_Function

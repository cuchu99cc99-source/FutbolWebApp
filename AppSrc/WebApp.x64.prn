8657>>>>>>>    Function RegistryKeyString Returns String
8659>>>>>>>        String sCompany sProduct sVersion sProgram
8659>>>>>>>        
8659>>>>>>>        Get psCompany to sCompany
8660>>>>>>>        Get psProduct to sProduct
8661>>>>>>>        Get psVersion to sVersion
8662>>>>>>>        Get psProgram to sProgram
8663>>>>>>>        
8663>>>>>>>        If (sCompany = "") ;            Move "Data Access Worldwide" to sCompany
8666>>>>>>>        If (sProduct = "") ;            Move "DataFlex Applications" to sProduct
8669>>>>>>>        If (sVersion = "") ;            Move C_DFVersion             to sVersion
8672>>>>>>>        If (sProgram ="") ;            Move (Module_Name(desktop))   to sProgram
8675>>>>>>>        
8675>>>>>>>        Function_Return ("SOFTWARE\" +sCompany +"\" +sProduct +"\" +sVersion +"\" +sProgram)
8676>>>>>>>    End_Function

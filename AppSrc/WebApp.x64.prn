32>>>>>>>>>>>Function BIGINTtoBytes Global BigInt aBigInt64 Returns String
34>>>>>>>>>>>    String sBigInt
34>>>>>>>>>>>    Boolean bOk
34>>>>>>>>>>>    Move (Repeat(Character(0),8)) to sBigInt
35>>>>>>>>>>>    Move (StoreQw(AddressOf(sBigInt), 0, aBigInt64)) to bOk
36>>>>>>>>>>>   Function_Return sBigInt
37>>>>>>>>>>>End_Function

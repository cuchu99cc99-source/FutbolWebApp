30221>>>>>>>>>>>Class cCryptographerEx is a cObject
30222>>>>>>>>>>>    
30222>>>>>>>>>>>    Procedure Construct_Object
30224>>>>>>>>>>>        Forward Send Construct_Object
30226>>>>>>>>>>>        
30226>>>>>>>>>>>        Property String     psProvider  MS_ENHANCED_PROV
30227>>>>>>>>>>>        Property Integer    piProvider  PROV_RSA_FULL
30228>>>>>>>>>>>        Property Integer    piCipher    CALG_RC4
30229>>>>>>>>>>>        Property Integer    piHash      CALG_MD5
30230>>>>>>>>>>>        
30230>>>>>>>>>>>        // Private properties
30230>>>>>>>>>>>        Property Handle     Private_phProv
30231>>>>>>>>>>>        
30231>>>>>>>>>>>        // Block cipher properties
30231>>>>>>>>>>>        Property UChar[]    paKey
30232>>>>>>>>>>>        Property UChar[]    paIV
30233>>>>>>>>>>>        Property Integer    piKeyAlg        PLAINTEXTKEYBLOB
30234>>>>>>>>>>>        Property Integer    piKeyType       CALG_AES_256
30235>>>>>>>>>>>        Property Integer    piKeyPadding    PKCS5_PADDING
30236>>>>>>>>>>>        Property Integer    piKeyMode       CRYPT_MODE_CBC
30237>>>>>>>>>>>        Property Integer    piBlockSize     16
30238>>>>>>>>>>>    End_Procedure
30239>>>>>>>>>>>    
30239>>>>>>>>>>>    
30239>>>>>>>>>>>    // Acquire key container handle
30239>>>>>>>>>>>    Function AcquireContext Returns Handle
30241>>>>>>>>>>>        Integer iProvider
30241>>>>>>>>>>>        WString wProvider
30241>>>>>>>>>>>        Handle hProv
30241>>>>>>>>>>>        Boolean bOk
30241>>>>>>>>>>>        Pointer pProv
30241>>>>>>>>>>>        
30241>>>>>>>>>>>        Move 0 to hProv
30242>>>>>>>>>>>        Get piProvider to iProvider
30243>>>>>>>>>>>        Get psProvider to wProvider
30244>>>>>>>>>>>        
30244>>>>>>>>>>>        //  Determine address to be passed as provider
30244>>>>>>>>>>>        If (Trim(wProvider) <> "") Begin
30246>>>>>>>>>>>            Move (AddressOf(wProvider)) to pProv
30247>>>>>>>>>>>        End
30247>>>>>>>>>>>>
30247>>>>>>>>>>>        Else Begin
30248>>>>>>>>>>>            Move 0 to pProv
30249>>>>>>>>>>>        End
30249>>>>>>>>>>>>
30249>>>>>>>>>>>        
30249>>>>>>>>>>>        //  Acquire Crypto Context. Note: pProv is pointer to UTF16 string.
30249>>>>>>>>>>>        Move (CryptAcquireContextW(AddressOf(hProv),0,pProv,iProvider,CRYPT_VERIFYCONTEXT)) to bOk
30250>>>>>>>>>>>        If (not(bOk) or hProv = 0) Begin
30252>>>>>>>>>>>            Move (CryptAcquireContextW(AddressOf(hProv),0,pProv,iProvider,CRYPT_NEWKEYSET ior CRYPT_VERIFYCONTEXT)) to bOk
30253>>>>>>>>>>>        End
30253>>>>>>>>>>>>
30253>>>>>>>>>>>        
30253>>>>>>>>>>>        If (not(bOk) or hProv = 0) Begin
30255>>>>>>>>>>>            // Fallback to original
30255>>>>>>>>>>>            Move (CryptAcquireContextW(AddressOf(hProv),0,pProv,iProvider,0)) to bOk
30256>>>>>>>>>>>            
30256>>>>>>>>>>>            If (not(bOk) or hProv = 0) Begin
30258>>>>>>>>>>>                Move (CryptAcquireContextW(AddressOf(hProv),0,pProv,iProvider,CRYPT_NEWKEYSET)) to bOk
30259>>>>>>>>>>>            End
30259>>>>>>>>>>>>
30259>>>>>>>>>>>        End
30259>>>>>>>>>>>>
30259>>>>>>>>>>>        Set Private_phProv to hProv
30260>>>>>>>>>>>        
30260>>>>>>>>>>>        Function_Return hProv
30261>>>>>>>>>>>    End_Function
30262>>>>>>>>>>>    
30262>>>>>>>>>>>    // Releases key container handle
30262>>>>>>>>>>>    Function ReleaseContext Handle hProv Returns Boolean
30264>>>>>>>>>>>        Function_Return (CryptReleaseContext(hProv,0))
30265>>>>>>>>>>>    End_Function
30266>>>>>>>>>>>    
30266>>>>>>>>>>>    // Creates hash object
30266>>>>>>>>>>>    Function CreateHash Handle hProv Returns Handle
30268>>>>>>>>>>>        Integer iAlgorithm
30268>>>>>>>>>>>        Handle hHash
30268>>>>>>>>>>>        Boolean bOk
30268>>>>>>>>>>>        
30268>>>>>>>>>>>        Move 0 to hHash
30269>>>>>>>>>>>        Get piHash to iAlgorithm
30270>>>>>>>>>>>        Move (CryptCreateHash(hProv,iAlgorithm,0,0,AddressOf(hHash))) to bOk
30271>>>>>>>>>>>        
30271>>>>>>>>>>>        Function_Return hHash
30272>>>>>>>>>>>    End_Function
30273>>>>>>>>>>>    
30273>>>>>>>>>>>    // Destroys the hash object
30273>>>>>>>>>>>    Function DestroyHash Handle hHash Returns Boolean
30275>>>>>>>>>>>        Function_Return (CryptDestroyHash(hHash))
30276>>>>>>>>>>>    End_Function
30277>>>>>>>>>>>    
30277>>>>>>>>>>>    // Adds data to hash object
30277>>>>>>>>>>>    Function HashData Handle hHash UChar[] ucData Returns Boolean
30279>>>>>>>>>>>        Function_Return (CryptHashData(hHash,AddressOf(ucData), SizeOfArray(ucData),0))
30280>>>>>>>>>>>    End_Function
30281>>>>>>>>>>>    
30281>>>>>>>>>>>    // Generates session key
30281>>>>>>>>>>>    Function DeriveKey Handle hProv Handle hHash Returns Handle
30283>>>>>>>>>>>        Integer iAlgorithm
30283>>>>>>>>>>>        Handle hKey
30283>>>>>>>>>>>        Boolean bOk
30283>>>>>>>>>>>        
30283>>>>>>>>>>>        Move 0 to hKey
30284>>>>>>>>>>>        Get piCipher to iAlgorithm
30285>>>>>>>>>>>        Move (CryptDeriveKey(hProv,iAlgorithm,hHash,CRYPT_EXPORTABLE,AddressOf(hKey))) to bOk
30286>>>>>>>>>>>        
30286>>>>>>>>>>>        Function_Return hKey
30287>>>>>>>>>>>    End_Function
30288>>>>>>>>>>>    
30288>>>>>>>>>>>    // Imports a plain text key
30288>>>>>>>>>>>    Function ImportPlainTextKey Handle hProv UChar[] ucaKey Returns Handle
30290>>>>>>>>>>>        tPLAINTEXTKEYBLOB blobhead
30290>>>>>>>>>>>        tPLAINTEXTKEYBLOB blobhead
30290>>>>>>>>>>>        Boolean   bSuccess
30290>>>>>>>>>>>        Handle    hKey
30290>>>>>>>>>>>        Integer   iHeadSize iKeySize
30290>>>>>>>>>>>        UChar[]   ucaKeyblob
30291>>>>>>>>>>>        Integer iVoid
30291>>>>>>>>>>>        
30291>>>>>>>>>>>        Move (SizeOfType(tPLAINTEXTKEYBLOB)) to iHeadSize
30292>>>>>>>>>>>        Move (SizeOfArray(ucaKey)) to iKeySize
30293>>>>>>>>>>>        
30293>>>>>>>>>>>        Move PLAINTEXTKEYBLOB to blobhead.hdr.bType
30294>>>>>>>>>>>        Move CUR_BLOB_VERSION   to blobhead.hdr.bVersion
30295>>>>>>>>>>>        Get piCipher            to blobhead.hdr.aiKeyAlg
30296>>>>>>>>>>>        Move iKeySize           to blobhead.dwKeySize
30297>>>>>>>>>>>        
30297>>>>>>>>>>>        Move (ResizeArray(ucaKeyblob, iHeadSize)) to ucaKeyblob
30298>>>>>>>>>>>        Move (CopyMemory(AddressOf(ucaKeyblob), AddressOf(blobhead), iHeadSize)) to iVoid
30299>>>>>>>>>>>        Move (AppendArray(ucaKeyblob, ucaKey)) to ucaKeyblob
30300>>>>>>>>>>>        
30300>>>>>>>>>>>        Move 0 to hKey
30301>>>>>>>>>>>        Move (CryptImportKey(hProv, AddressOf(ucaKeyblob), SizeOfArray(ucaKeyblob), 0, 0, AddressOf(hKey))) to bSuccess
30302>>>>>>>>>>>        If (not(bSuccess)) Begin
30304>>>>>>>>>>>            Move (ShowLastError()) to iVoid
30305>>>>>>>>>>>        End
30305>>>>>>>>>>>>
30305>>>>>>>>>>>        
30305>>>>>>>>>>>        Function_Return hKey
30306>>>>>>>>>>>    End_Function
30307>>>>>>>>>>>    
30307>>>>>>>>>>>    // Destroys the key
30307>>>>>>>>>>>    Function DestroyKey Handle hKey Returns Boolean
30309>>>>>>>>>>>        Function_Return (CryptDestroyKey(hKey))
30310>>>>>>>>>>>    End_Function
30311>>>>>>>>>>>    
30311>>>>>>>>>>>    // Retrieves key data
30311>>>>>>>>>>>    Function KeyParameter Handle hKey Integer iQuery Returns Integer
30313>>>>>>>>>>>        Integer iBuffer iLen
30313>>>>>>>>>>>        Boolean bOk
30313>>>>>>>>>>>        
30313>>>>>>>>>>>        Move (SizeOfType(Integer)) to iLen
30314>>>>>>>>>>>        Move (CryptGetKeyParam(hKey,iQuery,AddressOf(iBuffer),AddressOf(iLen),0)) to bOk
30315>>>>>>>>>>>        Function_Return iBuffer
30316>>>>>>>>>>>    End_Function
30317>>>>>>>>>>>    
30317>>>>>>>>>>>    // Retrieves a hash value
30317>>>>>>>>>>>    Function HashValue Handle lhHash Returns UChar[]
30319>>>>>>>>>>>        UChar[] ucHash
30320>>>>>>>>>>>        Integer liResult
30320>>>>>>>>>>>        DWord   dwDataLen
30320>>>>>>>>>>>        
30320>>>>>>>>>>>        Move 0 to dwDataLen
30321>>>>>>>>>>>        Move (CryptGetHashParam(lhHash,HP_HASHVAL,0,AddressOf(dwDataLen),0)) to liResult
30322>>>>>>>>>>>        If (liResult = 0) ;            Function_Return ""
30325>>>>>>>>>>>        
30325>>>>>>>>>>>        Move (ResizeArray(ucHash, dwDataLen, 0)) to ucHash
30326>>>>>>>>>>>        Move (CryptGetHashParam(lhHash,HP_HASHVAL,AddressOf(ucHash),AddressOf(dwDataLen),0)) to liResult
30327>>>>>>>>>>>        If (liResult = 0) ;            Function_Return ""
30330>>>>>>>>>>>        
30330>>>>>>>>>>>        Function_Return ucHash
30331>>>>>>>>>>>    End_Function
30332>>>>>>>>>>>
30332>>>>>>>>>>>    // Encrypts data
30332>>>>>>>>>>>    Function Encrypt UChar[] ucPassword UChar[] ucData Returns UChar[]
30334>>>>>>>>>>>        Handle hProv hHash hKey
30334>>>>>>>>>>>        Integer iAlgorithm iDataLen iCipherLen iErr
30334>>>>>>>>>>>        Boolean bOk
30334>>>>>>>>>>>        
30334>>>>>>>>>>>        Get AcquireContext to hProv
30335>>>>>>>>>>>        If (hProv) Begin
30337>>>>>>>>>>>            Get CreateHash hProv to hHash
30338>>>>>>>>>>>            If (hHash) Begin
30340>>>>>>>>>>>                Get HashData hHash ucPassword to bOk
30341>>>>>>>>>>>                If (bOk) Begin
30343>>>>>>>>>>>                    Get piCipher to iAlgorithm
30344>>>>>>>>>>>                    Get DeriveKey hProv hHash to hKey
30345>>>>>>>>>>>                End
30345>>>>>>>>>>>>
30345>>>>>>>>>>>                Get DestroyHash hHash to bOk
30346>>>>>>>>>>>            End
30346>>>>>>>>>>>>
30346>>>>>>>>>>>            
30346>>>>>>>>>>>            If (hKey) Begin
30348>>>>>>>>>>>                //  First call to determine resulting data size
30348>>>>>>>>>>>                Move (SizeOfArray(ucData)) to iDataLen
30349>>>>>>>>>>>                Move (SizeOfArray(ucData)) to iCipherLen
30350>>>>>>>>>>>                Move (CryptEncrypt(hKey, 0, True, 0, 0, AddressOf(iCipherLen), iDataLen)) to bOk
30351>>>>>>>>>>>                
30351>>>>>>>>>>>                //  Reserve space in string
30351>>>>>>>>>>>                If (iDataLen < iCipherLen) Begin
30353>>>>>>>>>>>                    Move (ResizeArray(ucData, iCipherLen, 0)) to ucData
30354>>>>>>>>>>>                End
30354>>>>>>>>>>>>
30354>>>>>>>>>>>                
30354>>>>>>>>>>>                //  Call to really decrypt
30354>>>>>>>>>>>                Move (CryptEncrypt(hKey,0,True,0,AddressOf(ucData),AddressOf(iDataLen),SizeOfArray(ucData))) to bOk
30355>>>>>>>>>>>                //If (not(bOk)) Begin
30355>>>>>>>>>>>                //Move "" to sData
30355>>>>>>>>>>>                //Move (GetLastError()) to iErr
30355>>>>>>>>>>>                //End
30355>>>>>>>>>>>                
30355>>>>>>>>>>>                Get DestroyKey hKey to bOk
30356>>>>>>>>>>>            End 
30356>>>>>>>>>>>>
30356>>>>>>>>>>>            Get ReleaseContext hProv to bOk
30357>>>>>>>>>>>        End 
30357>>>>>>>>>>>>
30357>>>>>>>>>>>        Function_Return ucData
30358>>>>>>>>>>>    End_Function
30359>>>>>>>>>>>    
30359>>>>>>>>>>>    // Decrypts data
30359>>>>>>>>>>>    Function Decrypt UChar[] ucPassword UChar[] ucData Returns UChar[]
30361>>>>>>>>>>>        Handle hProv hHash hKey
30361>>>>>>>>>>>        Integer iAlgorithm iDataLen
30361>>>>>>>>>>>        Boolean bOk
30361>>>>>>>>>>>        
30361>>>>>>>>>>>        Get AcquireContext to hProv
30362>>>>>>>>>>>        If (hProv) Begin
30364>>>>>>>>>>>            Get CreateHash hProv to hHash
30365>>>>>>>>>>>            If (hHash) Begin
30367>>>>>>>>>>>                Get HashData hHash ucPassword to bOk
30368>>>>>>>>>>>                If (bOk) Begin
30370>>>>>>>>>>>                    Get piCipher to iAlgorithm
30371>>>>>>>>>>>                    Get DeriveKey hProv hHash to hKey
30372>>>>>>>>>>>                End
30372>>>>>>>>>>>>
30372>>>>>>>>>>>                Get DestroyHash hHash to bOk
30373>>>>>>>>>>>            End
30373>>>>>>>>>>>>
30373>>>>>>>>>>>            
30373>>>>>>>>>>>            If (hKey) Begin
30375>>>>>>>>>>>                Move (SizeOfArray(ucData)) to iDataLen
30376>>>>>>>>>>>                Move (CryptDecrypt(hKey,0,True,0,AddressOf(ucData),AddressOf(iDataLen))) to bOk
30377>>>>>>>>>>>                //  Resulting data can be shorter as the input string, in that case we shorten the result string
30377>>>>>>>>>>>                If (SizeOfArray (ucData) > iDataLen) Begin
30379>>>>>>>>>>>                    Move (ResizeArray(ucData, iDataLen)) to ucData
30380>>>>>>>>>>>                End
30380>>>>>>>>>>>>
30380>>>>>>>>>>>                
30380>>>>>>>>>>>                Get DestroyKey hKey to bOk
30381>>>>>>>>>>>            End
30381>>>>>>>>>>>>
30381>>>>>>>>>>>            Get ReleaseContext hProv to bOk
30382>>>>>>>>>>>        End
30382>>>>>>>>>>>>
30382>>>>>>>>>>>        Function_Return ucData
30383>>>>>>>>>>>    End_Function
30384>>>>>>>>>>>    
30384>>>>>>>>>>>    // Creates a key
30384>>>>>>>>>>>    Function CreateKey Handle hProv Returns Handle
30386>>>>>>>>>>>        Integer iAlg iType iByte iLength iSize
30386>>>>>>>>>>>        CryptoBlob keyBlob
30386>>>>>>>>>>>        CryptoBlob keyBlob
30386>>>>>>>>>>>        Boolean bOk
30386>>>>>>>>>>>        Handle hKey
30386>>>>>>>>>>>        UChar[] aKey
30387>>>>>>>>>>>
30387>>>>>>>>>>>        Get paKey to aKey
30388>>>>>>>>>>>        Get piKeyAlg to iAlg
30389>>>>>>>>>>>        Get piKeyType to iType
30390>>>>>>>>>>>        Move iAlg                   to keyBlob.header.bType
30391>>>>>>>>>>>        Move CUR_BLOB_VERSION       to keyBlob.header.bVersion
30392>>>>>>>>>>>        Move iType                  to keyBlob.header.aiKeyAlg
30393>>>>>>>>>>>        Move (SizeOfArray(aKey))    to keyBlob.cbKeySize
30394>>>>>>>>>>>        
30394>>>>>>>>>>>        Move (SizeOfArray(aKey)-1) to iLength
30395>>>>>>>>>>>        For iByte from 0 to iLength
30401>>>>>>>>>>>>
30401>>>>>>>>>>>            Move aKey[iByte] to keyBlob.rgbKeyData[iByte]
30402>>>>>>>>>>>        Loop
30403>>>>>>>>>>>>
30403>>>>>>>>>>>        
30403>>>>>>>>>>>        Move 0 to hKey
30404>>>>>>>>>>>        Move (CryptImportKey(hProv,AddressOf(keyBlob),SizeOfType(CryptoBlob),0,0,AddressOf(hKey))) to bOk
30405>>>>>>>>>>>        Function_Return hKey
30406>>>>>>>>>>>    End_Function
30407>>>>>>>>>>>    
30407>>>>>>>>>>>    // Sets the key parameters
30407>>>>>>>>>>>    Function SetKeyParameters Handle hKey Returns Boolean
30409>>>>>>>>>>>        Integer iPadding iMode
30409>>>>>>>>>>>        Boolean bOk
30409>>>>>>>>>>>        UChar[] aIV
30410>>>>>>>>>>>        
30410>>>>>>>>>>>        //Move (SizeOfArray(aIV)-1) to iLength
30410>>>>>>>>>>>        //For iByte from 0 to iLength
30410>>>>>>>>>>>        //    Move iByte to aIV[iByte]
30410>>>>>>>>>>>        //Loop
30410>>>>>>>>>>>
30410>>>>>>>>>>>        // Set initialization vector
30410>>>>>>>>>>>        Get paIV to aIV
30411>>>>>>>>>>>        Move (CryptSetKeyParam(hKey,KP_IV,AddressOf(aIV),0)) to bOk
30412>>>>>>>>>>>        If (bOk) Begin
30414>>>>>>>>>>>            // Set padding
30414>>>>>>>>>>>            Get piKeyPadding to iPadding
30415>>>>>>>>>>>            Move (CryptSetKeyParam(hKey,KP_PADDING,AddressOf(iPadding),0)) to bOk
30416>>>>>>>>>>>            If (bOk) Begin
30418>>>>>>>>>>>                // Set move
30418>>>>>>>>>>>                Get piKeyMode to iMode
30419>>>>>>>>>>>                Move (CryptSetKeyParam(hKey,KP_MODE,AddressOf(iMode),0)) to bOk
30420>>>>>>>>>>>            End
30420>>>>>>>>>>>>
30420>>>>>>>>>>>        End
30420>>>>>>>>>>>>
30420>>>>>>>>>>>        Function_Return bOk        
30421>>>>>>>>>>>    End_Function
30422>>>>>>>>>>>    
30422>>>>>>>>>>>    // Encrypts using block cipher
30422>>>>>>>>>>>    Function BlockEncrypt UChar[] ucData Returns UChar[]
30424>>>>>>>>>>>        Handle hProv hKey
30424>>>>>>>>>>>        Integer iLen iSize iBlocks
30424>>>>>>>>>>>        Boolean bOk
30424>>>>>>>>>>>        
30424>>>>>>>>>>>        Get AcquireContext to hProv
30425>>>>>>>>>>>        If (hProv) Begin
30427>>>>>>>>>>>            // Create key
30427>>>>>>>>>>>            Get CreateKey hProv to hKey
30428>>>>>>>>>>>            If (hKey) Begin
30430>>>>>>>>>>>                Get SetKeyParameters hKey to bOk
30431>>>>>>>>>>>                If (bOk) Begin
30433>>>>>>>>>>>                    // Buffer for block ciphers can be up to block length larger
30433>>>>>>>>>>>                    Get piBlockSize to iSize
30434>>>>>>>>>>>                    Move (SizeOfArray(ucData)) to iLen
30435>>>>>>>>>>>                    
30435>>>>>>>>>>>                    Move ((iLen/iSize)+1) to iBlocks
30436>>>>>>>>>>>                    Move (ResizeArray(ucData,iBlocks*iSize)) to ucData
30437>>>>>>>>>>>                    Move (CryptEncrypt(hKey,0,True,0,AddressOf(ucData),AddressOf(iLen),SizeOfArray(ucData))) to bOk
30438>>>>>>>>>>>                End
30438>>>>>>>>>>>>
30438>>>>>>>>>>>                Get DestroyKey hKey to bOk
30439>>>>>>>>>>>            End
30439>>>>>>>>>>>>
30439>>>>>>>>>>>            Get ReleaseContext hProv to bOk
30440>>>>>>>>>>>        End
30440>>>>>>>>>>>>
30440>>>>>>>>>>>        Function_Return ucData
30441>>>>>>>>>>>    End_Function
30442>>>>>>>>>>>    
30442>>>>>>>>>>>    // Decrypts using block cipher
30442>>>>>>>>>>>    Function BlockDecrypt UChar[] ucData Returns UChar[]
30444>>>>>>>>>>>        Handle hProv hKey
30444>>>>>>>>>>>        Integer iLen
30444>>>>>>>>>>>        Boolean bOk
30444>>>>>>>>>>>        
30444>>>>>>>>>>>        Get AcquireContext to hProv
30445>>>>>>>>>>>        If (hProv) Begin
30447>>>>>>>>>>>            // Create key
30447>>>>>>>>>>>            Get CreateKey hProv to hKey
30448>>>>>>>>>>>            If (hKey) Begin
30450>>>>>>>>>>>                Get SetKeyParameters hKey to bOk
30451>>>>>>>>>>>                If (bOk) Begin
30453>>>>>>>>>>>                    Move (SizeOfArray(ucData)) to iLen
30454>>>>>>>>>>>                    Move (CryptDecrypt(hKey,0,True,0,AddressOf(ucData),AddressOf(iLen))) to bOk
30455>>>>>>>>>>>                    Move (ResizeArray(ucData,iLen)) to ucData
30456>>>>>>>>>>>                End
30456>>>>>>>>>>>>
30456>>>>>>>>>>>                Get DestroyKey hKey to bOk
30457>>>>>>>>>>>            End
30457>>>>>>>>>>>>
30457>>>>>>>>>>>            Get ReleaseContext hProv to bOk
30458>>>>>>>>>>>        End
30458>>>>>>>>>>>>
30458>>>>>>>>>>>        Function_Return ucData
30459>>>>>>>>>>>    End_Function

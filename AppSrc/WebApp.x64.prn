30537>>>>>>>>>    // Performs a logout and a reset of the session. May trigger a login if one is required.
30537>>>>>>>>>    Procedure RequestLogout
30539>>>>>>>>>        Boolean bValid
30539>>>>>>>>>        Integer eLoginMode eAppStateMode 
30539>>>>>>>>>        String sStateHash
30539>>>>>>>>>        Handle hoWebApp
30539>>>>>>>>>        
30539>>>>>>>>>        Get Host to hoWebApp
30540>>>>>>>>>        
30540>>>>>>>>>        //  We end the session and create a new one (so the user is logged out)
30540>>>>>>>>>        Send EndSession // close the current session key
30541>>>>>>>>>        Get RecreateSession of hoWebApp to bValid
30542>>>>>>>>>        
30542>>>>>>>>>        //  Now we try to 
30542>>>>>>>>>        Get LoginMode to eLoginMode
30543>>>>>>>>>        
30543>>>>>>>>>        If (eLoginMode = lmLoginRequired) Begin
30545>>>>>>>>>            Get peApplicationStateMode to eAppStateMode
30546>>>>>>>>>            
30546>>>>>>>>>            //  If history management is used we add an entry for the default view, and then refresh, so after login the user gets back to the dashboard
30546>>>>>>>>>            If (eAppStateMode <> asmOff) Begin
30548>>>>>>>>>                Send SetStateHash of hoWebApp "" "" False
30549>>>>>>>>>            End
30549>>>>>>>>>>
30549>>>>>>>>>
30549>>>>>>>>>            Send NavigateRefresh of hoWebApp          // refresh the WebApp at the client (triggers a login)
30550>>>>>>>>>        End
30550>>>>>>>>>>
30550>>>>>>>>>    End_Procedure

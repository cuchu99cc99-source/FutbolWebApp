34072>>>>>>>        // if a view menu item set pbEnabled or pbRendered based on the views AllowAccess
34072>>>>>>>        // If you want to do something else, like hide it, you can augment this or
34072>>>>>>>        // augment OnChangeRights
34072>>>>>>>        If bHideViewWhenNoAccess Begin
34074>>>>>>>            WebGet pbRender to bEnabled
34075>>>>>>>            If (bEnabled <> bAllowAccess) Begin
34077>>>>>>>                WebSet pbRender to bAllowAccess
34078>>>>>>>            End
34078>>>>>>>>
34078>>>>>>>        End

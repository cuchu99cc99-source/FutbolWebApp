6183>>>>>>>
6183>>>>>>>    // return an array with the server path from this DD to passed top. The top will be
6183>>>>>>>    // in 0 and its child in 1, grand-child in 2, etc. If empty, no path was found. To start
6183>>>>>>>    // this process the byref hoDDs array MUST be empty
6183>>>>>>>    Procedure DDOServerPath Handle hoTop Handle[] ByRef hoDDs
6185>>>>>>>        Handle hoServer
6185>>>>>>>        Integer iServers iServer
6185>>>>>>>        If (hoTop=Self) Begin
6187>>>>>>>            Move Self to hoDDs[SizeOfArray(hoDDs)]
6188>>>>>>>            Procedure_Return
6189>>>>>>>        End
6189>>>>>>>>
6189>>>>>>>        Get Data_Set_Server_Count to iServers
6190>>>>>>>        For iServer from 0 to (iServers-1)
6196>>>>>>>>
6196>>>>>>>            Get Data_Set_Server iServer to hoServer
6197>>>>>>>            Send DDOServerPath of hoServer hoTop (&hoDDs)
6198>>>>>>>            If (SizeOfArray(hoDDs)) Begin
6200>>>>>>>                Move Self to hoDDs[SizeOfArray(hoDDs)]
6201>>>>>>>                Procedure_Return
6202>>>>>>>            End
6202>>>>>>>>
6202>>>>>>>        Loop
6203>>>>>>>>
6203>>>>>>>    End_Procedure
6204>>>>>>>
6204>>>>>>>    // returns True if the value passed can be considered empty for this field.
6204>>>>>>>    Function IsEmptyField Integer iField String sValue Returns Boolean
6206>>>>>>>        Integer iFile iDataType iValidationType
6206>>>>>>>        Number nNum
6206>>>>>>>        Boolean bInvalid bChecked
6206>>>>>>>        Get Main_File to iFile
6207>>>>>>>        Get_Attribute DF_FIELD_TYPE of iFile iField to iDataType
6210>>>>>>>        Get IsDataInvalid iDataType sValue to bInvalid
6211>>>>>>>        If bInvalid Begin
6213>>>>>>>            Function_Return True
6214>>>>>>>        End
6214>>>>>>>>
6214>>>>>>>
6214>>>>>>>        // DDs set checkbox fields to the False value as default. We must test its select_state
6214>>>>>>>        Get Field_Validation_Type of (Field_Attributes(Self)) iField to iValidationType
6215>>>>>>>        If (iValidationType=FA_VALIDATION_TYPE_CHECKBOX) Begin
6217>>>>>>>            Get Field_Select_State iField to bChecked
6218>>>>>>>            If not bChecked Begin
6220>>>>>>>                Function_Return True
6221>>>>>>>            End
6221>>>>>>>>
6221>>>>>>>        End
6221>>>>>>>>
6221>>>>>>>
6221>>>>>>>        If ((iDataType=DF_BCD or iDataType=DF_DATE) and (Number(sValue)=0)) Begin
6223>>>>>>>            Move "" to sValue
6224>>>>>>>        End
6224>>>>>>>>
6224>>>>>>>        Else If (iDataType=DF_DATETIME and IsNullDateTime(cast(sValue,DateTime))) Begin
6227>>>>>>>            Move "" to sValue
6228>>>>>>>        End
6228>>>>>>>>
6228>>>>>>>        Function_Return (sValue="")
6229>>>>>>>    End_Function
6230>>>>>>>
6230>>>>>>>
6230>>>>>>>    // is the record committed
6230>>>>>>>    Function IsCommitted Returns Boolean
6232>>>>>>>        Boolean bHasRecord
6232>>>>>>>        Get HasRecord to bHasRecord
6233>>>>>>>        Function_Return bHasRecord
6234>>>>>>>    End_Function
6235>>>>>>>
6235>>>>>>>    // is the field committed. It assumes the record is already committed
6235>>>>>>>    Function IsFieldCommitted Integer iField Returns Boolean
6237>>>>>>>        Boolean bIsCommitted
6237>>>>>>>        Get Field_Option iField DD_COMMIT to bIsCommitted
6238>>>>>>>        Function_Return bIsCommitted
6239>>>>>>>    End_Function
6240>>>>>>>
6240>>>>>>>    // is a parent change allowed for this parent server.
6240>>>>>>>    Function IsCommittedParentChangeAllowed Integer iServer Returns Boolean
6242>>>>>>>        Boolean bNoSwitch
6242>>>>>>>        Get ParentNoSwitchIfCommitted iServer to bNoSwitch
6243>>>>>>>        Function_Return (not(bNoSwitch))
6244>>>>>>>    End_Function
6245>>>>>>>
6245>>>>>>>    // Are we allowed to find with this file when it is used as a parent?
6245>>>>>>>    // Check all child DDOs and see if any are committed and do not allow switching parents when committed.
6245>>>>>>>    //  The rules for each child are switching is ok If:
6245>>>>>>>    // 1. the child is not committed,
6245>>>>>>>    // 2. it has a relates-to constraint (Find will change child which is ok)
6245>>>>>>>    // 3. if IsCommittedParentChangeAllowed allowed.
6245>>>>>>>    //
6245>>>>>>>    Function AllowParentFind Returns Boolean
6247>>>>>>>        Integer iClients iClient iMain
6247>>>>>>>        Handle hoChild
6247>>>>>>>        Boolean bIsCommitted
6247>>>>>>>        Get Data_Set_Client_Count to iClients
6248>>>>>>>        For iClient from 0 to (iClients-1)
6254>>>>>>>>
6254>>>>>>>            Get Data_Set_Client iClient to hoChild
6255>>>>>>>            Get IsCommitted of hoChild to bIsCommitted
6256>>>>>>>            If bIsCommitted Begin
6258>>>>>>>                Get Main_File to iMain
6259>>>>>>>                Get IsRelatesToConstrained of hoChild iMain to bIsCommitted
6260>>>>>>>                If not bIsCommitted Begin
6262>>>>>>>                    Get IsCommittedParentChangeAllowed of hoChild iMain to bIsCommitted
6263>>>>>>>                    If (not(bIsCommitted)) Begin
6265>>>>>>>                        Function_Return False
6266>>>>>>>                    End
6266>>>>>>>>
6266>>>>>>>                End
6266>>>>>>>>
6266>>>>>>>            End
6266>>>>>>>>
6266>>>>>>>        Loop
6267>>>>>>>>
6267>>>>>>>        Function_Return True
6268>>>>>>>    End_Function
6269>>>>>>>
6269>>>>>>>    // aumgented to do nothing if there is no index (instead of annoying error message) and
6269>>>>>>>    // to do nothing if a find is not allowed because it is a no switch parent of a committed child.
6269>>>>>>>    Procedure Item_Find Integer eFindMode ;            Integer iFile Integer iField ;            Integer bDoEntryUpdate Integer bShowFindErr Integer bDeferred
6271>>>>>>>
6271>>>>>>>        Integer iIndex iMain
6271>>>>>>>        Handle  hoOwner
6271>>>>>>>        Boolean bOk
6271>>>>>>>
6271>>>>>>>        Get File_Field_Index iFile iField to iIndex
6272>>>>>>>        If (iIndex=-1)  Begin
6274>>>>>>>            Procedure_Return
6275>>>>>>>        End
6275>>>>>>>>
6275>>>>>>>        Get Main_File to iMain
6276>>>>>>>        If (iMain<>iFile) Begin
6278>>>>>>>            Get Which_Data_Set iFile to hoOwner
6279>>>>>>>            If hoOwner Begin
6281>>>>>>>                Get AllowParentFind of hoOwner to bOk
6282>>>>>>>                If not bOk Begin
6284>>>>>>>                    Procedure_Return
6285>>>>>>>                End
6285>>>>>>>>
6285>>>>>>>            End
6285>>>>>>>>
6285>>>>>>>        End
6285>>>>>>>>
6285>>>>>>>
6285>>>>>>>        If not bDeferred Begin
6287>>>>>>>            Send Refind_Records // make sure the buffers are correct before the find
6288>>>>>>>        End
6288>>>>>>>>
6288>>>>>>>
6288>>>>>>>        Forward Send Item_Find eFindMode iFile iField bDoEntryUpdate bShowFindErr bDeferred
6290>>>>>>>    End_Procedure
6291>>>>>>>
6291>>>>>>>
6291>>>>>>>    Function Field_CommitNoEnterOnIndex Integer iField Returns Boolean
6293>>>>>>>        Function_Return False
6294>>>>>>>    End_Function
6295>>>>>>>
6295>>>>>>>    // Return the committed options for this field based on the committed status or this record,
6295>>>>>>>    // the committed status of the field and whether, if committed, it should be noput or noput+noenter
6295>>>>>>>    Function File_Field_Committed_Options Integer iFile Integer iField Returns Integer
6297>>>>>>>        Boolean bIsCommitted bNoEnter
6297>>>>>>>        Integer iNewOpts iIndex
6297>>>>>>>        Handle hoOwner
6297>>>>>>>
6297>>>>>>>        Get Which_Data_Set iFile to hoOwner
6298>>>>>>>        If not hoOwner ;            Function_Return 0
6301>>>>>>>
6301>>>>>>>        Get File_Field_Index iFile iField to iIndex
6302>>>>>>>        Get IsCommitted of hoOwner to bIsCommitted
6303>>>>>>>        If bIsCommitted Begin
6305>>>>>>>            Get IsFieldCommitted of hoOwner iField to bIsCommitted
6306>>>>>>>            If bIsCommitted Begin
6308>>>>>>>                Move True to bNoEnter
6309>>>>>>>                If (iIndex<>-1) Begin
6311>>>>>>>                    Get Field_CommitNoEnterOnIndex iField to bNoEnter
6312>>>>>>>                End
6312>>>>>>>>
6312>>>>>>>                // if committed, it is noput and, if non-indexed, also noenter
6312>>>>>>>                Move (If(bNoEnter,DD_DISPLAYONLY,DD_NOPUT)) to iNewOpts
6313>>>>>>>            End
6313>>>>>>>>
6313>>>>>>>        End
6313>>>>>>>>
6313>>>>>>>        // if a finding parent field, we want to know if you are allowed to switch parents as we will assume
6313>>>>>>>        // that this field is used for finding.
6313>>>>>>>        If (hoOwner<>Self and iIndex>-1) Begin
6315>>>>>>>            Get AllowParentFind of hoOwner to bIsCommitted
6316>>>>>>>            If not bIsCommitted Begin
6318>>>>>>>                Move DD_DISPLAYONLY to iNewOpts
6319>>>>>>>            End
6319>>>>>>>>
6319>>>>>>>        End
6319>>>>>>>>
6319>>>>>>>
6319>>>>>>>        Function_Return iNewOpts
6320>>>>>>>    End_Function
6321>>>>>>>
6321>>>>>>>    // Returns the current field-field options based on regular options, foreign field status
6321>>>>>>>    // plus committed record status
6321>>>>>>>    Function File_Field_DynamicEntryOptions Integer iFile Integer iField Returns Integer
6323>>>>>>>        Integer iCOpts iFOpts
6323>>>>>>>        If (iFile=0) Begin
6325>>>>>>>            Function_Return 0
6326>>>>>>>        End
6326>>>>>>>>
6326>>>>>>>        Get File_Field_Options iFile iField to iFOpts            // regular options (handles regular and foreign)
6327>>>>>>>        Get File_Field_Committed_Options iFile iField to iCOpts  // possible NoPut, NoEnter additions
6328>>>>>>>        Function_Return (iFOpts ior iCOpts)
6329>>>>>>>    End_Function
6330>>>>>>>
6330>>>>>>>    Function DDRememberedFieldIndex Integer iField Returns Integer
6332>>>>>>>        tDDRemembered[] DefaultValues
6332>>>>>>>        tDDRemembered[] DefaultValues
6333>>>>>>>        tDDRemembered SearchItem
6333>>>>>>>        tDDRemembered SearchItem
6333>>>>>>>        Integer iIndex
6333>>>>>>>        Get pDDDefaults to DefaultValues
6334>>>>>>>        Move iField to SearchItem.iField
6335>>>>>>>        Move (SearchArray(SearchItem,DefaultValues)) to iIndex
6336>>>>>>>        Function_Return iIndex
6337>>>>>>>    End_Function
6338>>>>>>>
6338>>>>>>>    // Interface used to set or clear a dynamic default (remembered) value for a DD field. If the
6338>>>>>>>    // value passed is empty ("" or as empty as defined by the data-type) it is cleared. If the value
6338>>>>>>>    // is DD_RememberLast, it will use the last value before a clear as the default, else it uses the
6338>>>>>>>    // passed value as the default
6338>>>>>>>    Procedure Set Field_RememberedValue Integer iField String sValue
6340>>>>>>>        tDDRemembered[] DefaultValues
6340>>>>>>>        tDDRemembered[] DefaultValues
6341>>>>>>>        Integer iIndex
6341>>>>>>>        Boolean bNull
6341>>>>>>>        Get DDRememberedFieldIndex iField to iIndex
6342>>>>>>>        Get pDDDefaults to DefaultValues
6343>>>>>>>        If (sValue<>DD_RememberLast) Begin // if it is rememberlast, we know it is not null
6345>>>>>>>            Get IsEmptyField iField sValue to bNull
6346>>>>>>>        End
6346>>>>>>>>
6346>>>>>>>        If (not(bNull)) Begin
6348>>>>>>>            If (iIndex=-1) Begin
6350>>>>>>>                Move (SizeOfArray(DefaultValues)) to iIndex
6351>>>>>>>                Move iField to DefaultValues[iIndex].iField
6352>>>>>>>            End
6352>>>>>>>>
6352>>>>>>>            Move sValue to DefaultValues[iIndex].sDefault
6353>>>>>>>            Set pDDDefaults to DefaultValues
6354>>>>>>>        End
6354>>>>>>>>
6354>>>>>>>        Else If  (iIndex<>-1) Begin
6357>>>>>>>            Set pDDDefaults to (RemoveFromArray(DefaultValues,iIndex))
6358>>>>>>>        End
6358>>>>>>>>
6358>>>>>>>    End_Procedure
6359>>>>>>>
6359>>>>>>>    // get the remembered value as per rules above
6359>>>>>>>    Function Field_RememberedValue Integer iField Returns String
6361>>>>>>>        tDDRemembered[] DefaultValues
6361>>>>>>>        tDDRemembered[] DefaultValues
6362>>>>>>>        Integer iIndex
6362>>>>>>>        Get DDRememberedFieldIndex iField to iIndex
6363>>>>>>>        If (iIndex<>-1) Begin
6365>>>>>>>            Get pDDDefaults to DefaultValues
6366>>>>>>>            Function_Return DefaultValues[iIndex].sDefault
6367>>>>>>>        End
6367>>>>>>>>
6367>>>>>>>        Function_Return ''
6368>>>>>>>    End_Function
6369>>>>>>>
6369>>>>>>>    Procedure AssignDynamicDefaults
6371>>>>>>>        Integer iField iFields iFile
6371>>>>>>>        tDDRemembered[] DefaultValues
6371>>>>>>>        tDDRemembered[] DefaultValues
6372>>>>>>>        Boolean bMain
6372>>>>>>>        String sValue
6372>>>>>>>
6372>>>>>>>        Get Main_File to iFile
6373>>>>>>>        Get pDDDefaults to DefaultValues
6374>>>>>>>        Move (SizeOfArray(DefaultValues)) to iFields
6375>>>>>>>        For iField from 0 to (iFields-1)
6381>>>>>>>>
6381>>>>>>>            If ( DefaultValues[iField].sDefault<>"") Begin
6383>>>>>>>                If (DefaultValues[iField].sDefault=DD_RememberLast) Begin
6385>>>>>>>                    Move DefaultValues[iField].sLastValue to sValue
6386>>>>>>>                End
6386>>>>>>>>
6386>>>>>>>                Else Begin
6387>>>>>>>                    Move DefaultValues[iField].sDefault to sValue
6388>>>>>>>                End
6388>>>>>>>>
6388>>>>>>>                Set Field_Changed_Value DefaultValues[iField].iField to sValue
6389>>>>>>>            End
6389>>>>>>>>
6389>>>>>>>        Loop
6390>>>>>>>>
6390>>>>>>>    End_Procedure
6391>>>>>>>
6391>>>>>>>    // Clears all remembered defaults for this DD.
6391>>>>>>>    Procedure ClearRememberedDefaults
6393>>>>>>>        tDDRemembered[] DefaultValues
6393>>>>>>>        tDDRemembered[] DefaultValues
6394>>>>>>>        Set pDDDefaults to DefaultValues
6395>>>>>>>    End_Procedure
6396>>>>>>>
6396>>>>>>>    Procedure PrivateClearAllRememberedDefaults
6398>>>>>>>        Integer iCount iMax
6398>>>>>>>        Handle hoDD
6398>>>>>>>        Boolean bVisisted
6398>>>>>>>
6398>>>>>>>        Set Visited_State to True
6399>>>>>>>
6399>>>>>>>        Get Data_Set_Server_Count to iMax
6400>>>>>>>        Decrement iMax
6401>>>>>>>        For iCount from 0 to iMax
6407>>>>>>>>
6407>>>>>>>            Get Data_Set_Server iCount to hoDD
6408>>>>>>>            Get Visited_State of hoDD to bVisisted
6409>>>>>>>            If not (bVisisted) Begin
6411>>>>>>>                Send PrivateClearAllRememberedDefaults of hoDD
6412>>>>>>>            End
6412>>>>>>>>
6412>>>>>>>        Loop
6413>>>>>>>>
6413>>>>>>>
6413>>>>>>>        Send ClearRememberedDefaults
6414>>>>>>>
6414>>>>>>>        Get Data_Set_Client_Count to iMax
6415>>>>>>>        Decrement iMax
6416>>>>>>>        For iCount from 0 to iMax
6422>>>>>>>>
6422>>>>>>>            Get Data_Set_Client iCount to hoDD
6423>>>>>>>            Get Visited_State of hoDD to bVisisted
6424>>>>>>>            If not (bVisisted) Begin
6426>>>>>>>                Send PrivateClearAllRememberedDefaults of hoDD
6427>>>>>>>            End
6427>>>>>>>>
6427>>>>>>>        Loop
6428>>>>>>>>
6428>>>>>>>
6428>>>>>>>    End_Procedure
6429>>>>>>>
6429>>>>>>>    // Clears all remembered defaults for all DDs in this structure.
6429>>>>>>>    Procedure ClearAllRememberedDefaults
6431>>>>>>>        Send InitializeAllVisited
6432>>>>>>>        Send PrivateClearAllRememberedDefaults
6433>>>>>>>    End_Procedure
6434>>>>>>>
6434>>>>>>>    // This is called after a clear or clear all is sent to this DD. It does autofinds as needed
6434>>>>>>>    // for any parent DDs. It does this if the parent is not a relates to contraining parent, if
6434>>>>>>>    // a field has an index, it has a changed value and it is autofind or autofind_ge.
6434>>>>>>>    Procedure DefaultParentAutofinds
6436>>>>>>>        Integer i iServers iField iFields iFile iIndex iOpts
6436>>>>>>>        Boolean bDoAutoFind bRelates bIsEmptyField
6436>>>>>>>        String sValue
6436>>>>>>>        Handle hoServer
6436>>>>>>>        Get Data_Set_Server_Count to iServers
6437>>>>>>>        For i from 0 to (iServers-1)
6443>>>>>>>>
6443>>>>>>>            Get Data_Set_Server i to hoServer
6444>>>>>>>            Get Main_File of hoServer to iFile
6445>>>>>>>            Get IsRelatesToConstrained iFile to bRelates
6446>>>>>>>            // never autofind on a relates-to constraining parent
6446>>>>>>>            If not (bRelates) Begin
6448>>>>>>>
6448>>>>>>>                Get Field_Count of hoServer to iFields
6449>>>>>>>                Move False to bDoAutoFind
6450>>>>>>>                Move 1 to iField
6451>>>>>>>                While (not(bDoAutoFind) and (iField<=iFields))
6455>>>>>>>                    Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
6458>>>>>>>                    If (iIndex>0) Begin
6460>>>>>>>                        Get Field_Changed_State of hoServer iField to bDoAutoFind
6461>>>>>>>                        If bDoAutoFind Begin
6463>>>>>>>                            Get Field_Current_Value of hoServer iField to sValue
6464>>>>>>>                            Get IsEmptyField of hoServer iField sValue to bIsEmptyField
6465>>>>>>>                            Move (not(bIsEmptyField)) to bDoAutoFind
6466>>>>>>>                            If bDoAutoFind Begin
6468>>>>>>>                                Get File_Field_Options iFile iField to iOpts
6469>>>>>>>                                // if this is a retain or retainall we don't do this because we want
6469>>>>>>>                                // to maintain backwards compatibility
6469>>>>>>>                                Move ( (iOpts iand DD_AUTOFIND or iOpts iand DD_AUTOFIND_GE) and ;                                    not( iOpts iand DD_RETAIN or iOpts iand DD_RETAINALL) ) to bDoAutoFind
6470>>>>>>>                                If bDoAutoFind Begin
6472>>>>>>>                                    Send File_Field_Default_AutoFind iFile iField
6473>>>>>>>                                    Set Changed_State to False // clears parent changed state
6474>>>>>>>                                End
6474>>>>>>>>
6474>>>>>>>                            End
6474>>>>>>>>
6474>>>>>>>                        End
6474>>>>>>>>
6474>>>>>>>                    End
6474>>>>>>>>
6474>>>>>>>                    Increment iField
6475>>>>>>>                Loop
6476>>>>>>>>
6476>>>>>>>
6476>>>>>>>                // Only check for grandparent autofinds if this parent did not do a an autofind
6476>>>>>>>                // Doing an autofind on an autofind parent's parent is just too confusing
6476>>>>>>>                If not bDoAutoFind Begin
6478>>>>>>>                    Send DefaultParentAutofinds of hoServer
6479>>>>>>>                End
6479>>>>>>>>
6479>>>>>>>            End
6479>>>>>>>>
6479>>>>>>>        Loop
6480>>>>>>>>
6480>>>>>>>    End_Procedure
6481>>>>>>>
6481>>>>>>>    // Set this DD to be an alias, passing the file number of the alias
6481>>>>>>>    // This can only be called once per instance and the Main_File must already have been set
6481>>>>>>>    // most likely in a superclass.
6481>>>>>>>    // This sets Main_File to the alias, stores the original master file (accessed via MasterForAlias).
6481>>>>>>>    // It also clears all existing relatonships. Normally we expect the alias class to set
6481>>>>>>>    // sets pbUseDDRelates and pbNoCascadeDeleteStrict to true. We don't do that automatically so that
6481>>>>>>>    // the Studio's property panel will show the correct values. When an alias is defined using the
6481>>>>>>>    // studio it will set these two properties.
6481>>>>>>>    // This means you must set any required relationships yourself
6481>>>>>>>    Procedure Set Alias_File Integer iTable
6483>>>>>>>        Integer iMain iMaster iFieldsM iFieldsA
6483>>>>>>>        Get Main_File to iMain
6484>>>>>>>        Get MasterForAlias to iMaster
6485>>>>>>>
6485>>>>>>>        If (iTable=0 and iMaster) Begin
6487>>>>>>>            Error DFERR_PROGRAM "Cannot unset alias table"
6488>>>>>>>>
6488>>>>>>>            Procedure_Return
6489>>>>>>>        End
6489>>>>>>>>
6489>>>>>>>        If (iTable=iMain) Begin
6491>>>>>>>            Error DFERR_PROGRAM "Cannot set alias table to self"
6492>>>>>>>>
6492>>>>>>>            Procedure_Return
6493>>>>>>>        End
6493>>>>>>>>
6493>>>>>>>        If (iMaster) Begin
6495>>>>>>>            Error DFERR_PROGRAM "Cannot redefine alias table"
6496>>>>>>>>
6496>>>>>>>            Procedure_Return
6497>>>>>>>        End
6497>>>>>>>>
6497>>>>>>>        Get_Attribute DF_FILE_NUMBER_FIELDS of iMain to iFieldsM
6500>>>>>>>        Get_Attribute DF_FILE_NUMBER_FIELDS of iTable to iFieldsA
6503>>>>>>>        If (iFieldsA<>iFieldsM) Begin
6505>>>>>>>            Error DFERR_PROGRAM "Alias and Master file are not based on the same table"
6506>>>>>>>>
6506>>>>>>>            Procedure_Return
6507>>>>>>>        End
6507>>>>>>>>
6507>>>>>>>
6507>>>>>>>        Set piMasterTable to iMain
6508>>>>>>>        Set Main_File to iTable
6509>>>>>>>        Send DefineAsAlias
6510>>>>>>>    End_Procedure
6511>>>>>>>
6511>>>>>>>    Procedure DefineAsAlias
6513>>>>>>>        Integer i iFile
6513>>>>>>>
6513>>>>>>>        // We expect he developer to set these properties to True
6513>>>>>>>        //Set pbUseDDRelates to True
6513>>>>>>>        //Set pbNoCascadeDeleteStrict to True
6513>>>>>>>
6513>>>>>>>        Send ClearDDRelates
6514>>>>>>>        Get Client_File_Count to i
6515>>>>>>>        While i
6519>>>>>>>            Decrement i
6520>>>>>>>            Get Client_File i to iFile
6521>>>>>>>            Send Remove_Client_File iFile
6522>>>>>>>        Loop
6523>>>>>>>>
6523>>>>>>>        Get Server_File_Count to i
6524>>>>>>>        While i
6528>>>>>>>            Decrement i
6529>>>>>>>            Get Server_File i to iFile
6530>>>>>>>            Send Remove_Server_File iFile
6531>>>>>>>        Loop
6532>>>>>>>>
6532>>>>>>>    End_Procedure

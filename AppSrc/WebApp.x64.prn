653>>>>>>>>>// define first, so we can use this for strings anywhere else.
653>>>>>>>>>Function SFormat Global String sText ;        String s1 String s2 String s3 String s4 String s5 String s6 String s7 String s8 String s9 ;        Returns String
655>>>>>>>>>    String sParam
655>>>>>>>>>    Integer iArg
655>>>>>>>>>    If (num_arguments>10) ;        Error DFERR_WRONG_NUMBER_OF_ARGUMENTS // only allow max of 9 params
658>>>>>>>>>    Move (Replaces("%%",sText,"$%$")) to sText // %% is used when you want a single % followed by a 1-9. e.g. "%%1"=%1
659>>>>>>>>>    For iArg from 2 to Num_Arguments
665>>>>>>>>>>
665>>>>>>>>>        Move iArg& to sParam
666>>>>>>>>>        Move (Replaces("%"+String(iArg-1),sText,sParam)) to sText
667>>>>>>>>>    Loop
668>>>>>>>>>>
668>>>>>>>>>    Move (Replaces("$%$",sText,"%")) to sText
669>>>>>>>>>    Function_Return sText
670>>>>>>>>>End_Function

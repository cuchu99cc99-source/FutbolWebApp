32985>>>>>>>        Property Boolean pbAllowAppendRow True   // Allows inserting rows at the End. 
32988>>>>>>>        Property Boolean pbAllowInsertRow True   // Allows inserting rows in Between. 
32991>>>>>>>        Property Integer piCurrentColumn -1       // Indicates the currently selected column.
32994>>>>>>>        

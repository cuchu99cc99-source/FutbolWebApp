17001>>>>>>>>>>>    
17001>>>>>>>>>>>
17001>>>>>>>>>>>    Function IsInCallActionScope Returns Boolean
17003>>>>>>>>>>>        Function_Return (OwnerIsInCallActionScope(Owner(Self), Self))
17004>>>>>>>>>>>    End_Function
17005>>>>>>>>>>>    
17005>>>>>>>>>>>    
17005>>>>>>>>>>>    // Called for each cWebObject during LoadView or LoadWebApp. The event is called before the published
17005>>>>>>>>>>>    // properties are serialized. Can be used to:
17005>>>>>>>>>>>    // - Modify an Object's published properties as a view is being loaded,
17005>>>>>>>>>>>    // - Call client actions to be executed after the view/webapp is loaded,
17005>>>>>>>>>>>    // - Set web properties as the view/webapp is loaded.
17005>>>>>>>>>>>    Procedure OnLoad
17007>>>>>>>>>>>        // Stub: User event hook
17007>>>>>>>>>>>    End_Procedure
17008>>>>>>>>>>>    
17008>>>>>>>>>>>    
17008>>>>>>>>>>>    // Registers the passed cWebControl in pChildWebControls array.
17008>>>>>>>>>>>    // (see also RegisterThisWebObject)
17008>>>>>>>>>>>    Procedure RegisterChildWebObject Handle hoChild
17010>>>>>>>>>>>        Handle[] aChildWebControls
17011>>>>>>>>>>>        Integer iSize
17011>>>>>>>>>>>        Boolean bChildExists
17011>>>>>>>>>>>        
17011>>>>>>>>>>>        Get ChildExists hoChild to bChildExists
17012>>>>>>>>>>>        
17012>>>>>>>>>>>        If (not(bChildExists)) Begin
17014>>>>>>>>>>>            Get paChildWebControls to aChildWebControls
17015>>>>>>>>>>>            Move (SizeOfArray(aChildWebControls)) to iSize
17016>>>>>>>>>>>            Move hoChild to aChildWebControls[iSize]
17017>>>>>>>>>>>            Set paChildWebControls to aChildWebControls
17018>>>>>>>>>>>        End
17018>>>>>>>>>>>>
17018>>>>>>>>>>>    End_Procedure
17019>>>>>>>>>>>    
17019>>>>>>>>>>>    
17019>>>>>>>>>>>    // Registers the passed method as a procedure or function that is permitted to be called from the client.
17019>>>>>>>>>>>    Procedure RegisterPublishedMethod Handle hMethod String sName Boolean bIsFunction
17021>>>>>>>>>>>        Integer iPos iSize
17021>>>>>>>>>>>        Handle[] aPubMethodHandles
17022>>>>>>>>>>>        String[] aPubMethodNames
17023>>>>>>>>>>>        Boolean[] aPubMethodIsFunction
17024>>>>>>>>>>>        
17024>>>>>>>>>>>        Get paPubMethodHandles to aPubMethodHandles
17025>>>>>>>>>>>        Get paPubMethodNames   to aPubMethodNames
17026>>>>>>>>>>>        Get paPubMethodIsFunction to aPubMethodIsFunction
17027>>>>>>>>>>>        Move (SearchArray(hMethod, aPubMethodHandles)) to iPos
17028>>>>>>>>>>>        
17028>>>>>>>>>>>        If (iPos = -1) Begin
17030>>>>>>>>>>>            Move (SizeOfArray(aPubMethodHandles)) to iSize
17031>>>>>>>>>>>            Move hMethod            to aPubMethodHandles[iSize]
17032>>>>>>>>>>>            Move (Uppercase(sName)) to aPubMethodNames[iSize]     // make the name search case insensitive
17033>>>>>>>>>>>            Move bIsFunction        to aPubMethodIsFunction[iSize]
17034>>>>>>>>>>>
17034>>>>>>>>>>>            Set paPubMethodHandles to aPubMethodHandles
17035>>>>>>>>>>>            Set paPubMethodNames   to aPubMethodNames
17036>>>>>>>>>>>            Set paPubMethodIsFunction to aPubMethodIsFunction
17037>>>>>>>>>>>        End
17037>>>>>>>>>>>>
17037>>>>>>>>>>>    End_Procedure
17038>>>>>>>>>>>
17038>>>>>>>>>>>
17038>>>>>>>>>>>    // Registers the passed property as a property to publish to the client object.
17038>>>>>>>>>>>    Procedure RegisterPublishedProperty Handle hmGetter Handle hmSetter String sName Integer iType Integer eMode Boolean bObject
17040>>>>>>>>>>>        Handle hoMeta
17040>>>>>>>>>>>        Variant vDefault
17040>>>>>>>>>>>        String sDefault
17040>>>>>>>>>>>        
17040>>>>>>>>>>>        If (bObject) Begin
17042>>>>>>>>>>>            Send RegisterWebProperty hmGetter hmSetter sName iType eMode
17043>>>>>>>>>>>        End
17043>>>>>>>>>>>>
17043>>>>>>>>>>>        Else Begin
17044>>>>>>>>>>>            Get phoClassPropMeta to hoMeta
17045>>>>>>>>>>>            
17045>>>>>>>>>>>            //  Only add to class if it is not already sealed
17045>>>>>>>>>>>            If (not(pbSealed(hoMeta))) Begin
17047>>>>>>>>>>>                If (iType <> cArgStruct and iType <> cArgArray) Begin
17049>>>>>>>>>>>                    Get hmGetter to vDefault
17050>>>>>>>>>>>                    Get ConvertToTransport hmGetter vDefault iType to sDefault
17051>>>>>>>>>>>                End
17051>>>>>>>>>>>>
17051>>>>>>>>>>>                    
17051>>>>>>>>>>>                Send RegisterWebProperty of hoMeta hmGetter hmSetter sName iType eMode sDefault
17052>>>>>>>>>>>            End
17052>>>>>>>>>>>>
17052>>>>>>>>>>>        End
17052>>>>>>>>>>>>
17052>>>>>>>>>>>    End_Procedure
17053>>>>>>>>>>>    
17053>>>>>>>>>>>    // Looks up the meta data for a web property based on its setter. Returns the meta data in a tWebPropMetaData struct.
17053>>>>>>>>>>>    Function FindWebPropertyMetaBySetter Handle hmSetter Returns tWebPropMetaData
17055>>>>>>>>>>>        tWebPropMetaData result
17055>>>>>>>>>>>        tWebPropMetaData result
17055>>>>>>>>>>>        
17055>>>>>>>>>>>        //  Look in object properties if we have them
17055>>>>>>>>>>>        Get FindWebPropertyBySetter hmSetter to result
17056>>>>>>>>>>>        
17056>>>>>>>>>>>        //  Look in class properties if we did not find it yet
17056>>>>>>>>>>>        If (result.hmGetter = 0) ;            Get FindWebPropertyBySetter of (phoClassPropMeta(Self)) hmSetter to result
17059>>>>>>>>>>>            
17059>>>>>>>>>>>        Function_Return result
17060>>>>>>>>>>>    End_Function
17061>>>>>>>>>>>    
17061>>>>>>>>>>>    // Looks up the meta data for a web property based on its getter. Returns the meta data in a tWebPropMetaData struct.
17061>>>>>>>>>>>    Function FindWebPropertyMetaByGetter Handle hmGetter Returns tWebPropMetaData
17063>>>>>>>>>>>        tWebPropMetaData result
17063>>>>>>>>>>>        tWebPropMetaData result
17063>>>>>>>>>>>        
17063>>>>>>>>>>>        //  Look in object properties if we have them
17063>>>>>>>>>>>        Get FindWebPropertyByGetter hmGetter to result
17064>>>>>>>>>>>        
17064>>>>>>>>>>>        //  Look in class properties if we did not find it yet
17064>>>>>>>>>>>        If (result.hmGetter = 0) ;            Get FindWebPropertyByGetter of (phoClassPropMeta(Self)) hmGetter to result
17067>>>>>>>>>>>            
17067>>>>>>>>>>>        Function_Return result
17068>>>>>>>>>>>    End_Function
17069>>>>>>>>>>>    
17069>>>>>>>>>>>    // Looks up the meta data for a web property based on its name. Returns the meta data in a tWebPropMetaData struct.
17069>>>>>>>>>>>    Function FindWebPropertyMetaByName String sName Returns tWebPropMetaData
17071>>>>>>>>>>>        tWebPropMetaData result
17071>>>>>>>>>>>        tWebPropMetaData result
17071>>>>>>>>>>>        
17071>>>>>>>>>>>        //  Look in object properties if we have them
17071>>>>>>>>>>>        Get FindWebPropertyByName sName to result
17072>>>>>>>>>>>        
17072>>>>>>>>>>>        //  Look in class properties if we did not find it yet
17072>>>>>>>>>>>        If (result.hmGetter = 0) ;            Get FindWebPropertyByName of (phoClassPropMeta(Self)) sName to result
17075>>>>>>>>>>>        
17075>>>>>>>>>>>        Function_Return result
17076>>>>>>>>>>>    End_Function
17077>>>>>>>>>>>    
17077>>>>>>>>>>>    
17077>>>>>>>>>>>    // Registers this cWebControl in pChildWebControls array of parent control.
17077>>>>>>>>>>>    // Override this method to prevent registering a cWebControl
17077>>>>>>>>>>>    // (see also RegisterChildWebObject)
17077>>>>>>>>>>>    Procedure RegisterThisWebObject
17079>>>>>>>>>>>        Handle hoWebNeighborhood
17079>>>>>>>>>>>        
17079>>>>>>>>>>>        Delegate Send RegisterChildWebObject Self              // register the control with parent container
17081>>>>>>>>>>>        
17081>>>>>>>>>>>        Send OwnerRegisterWebObject of (Owner(Self)) Self   // register control in cWebControlLocator
17082>>>>>>>>>>>        
17082>>>>>>>>>>>        // Get the web neighborhood object handle. This is used to test which neighborhood 'scope'
17082>>>>>>>>>>>        // the cWebObject belongs to....
17082>>>>>>>>>>>        Get WebNeighborhood to hoWebNeighborhood  // delegate to nearest neighborhood object (cWebApp or cWebWindow)
17083>>>>>>>>>>>        Set phoWebNeighborhood to hoWebNeighborhood
17084>>>>>>>>>>>    End_Procedure
17085>>>>>>>>>>>    
17085>>>>>>>>>>>    Function IsWebView Returns Boolean
17087>>>>>>>>>>>        Function_Return False
17088>>>>>>>>>>>    End_Function
17089>>>>>>>>>>>    
17089>>>>>>>>>>>    Function IsWebWidget Returns Boolean
17091>>>>>>>>>>>        Function_Return False
17092>>>>>>>>>>>    End_Function
17093>>>>>>>>>>>    
17093>>>>>>>>>>>    Function GetParentWidget Returns Handle
17095>>>>>>>>>>>        Handle hoParent
17095>>>>>>>>>>>        Boolean bIsWidget bIsView bIsWebapp
17095>>>>>>>>>>>        
17095>>>>>>>>>>>        // Check if we're a widget ourselves, if so return
17095>>>>>>>>>>>        Get IsWebWidget to bIsWidget
17096>>>>>>>>>>>        
17096>>>>>>>>>>>        If (bIsWidget) Begin
17098>>>>>>>>>>>            Function_Return Self
17099>>>>>>>>>>>        End
17099>>>>>>>>>>>>
17099>>>>>>>>>>>        
17099>>>>>>>>>>>        Get IsWebView to bIsView
17100>>>>>>>>>>>        If (bIsView) Begin
17102>>>>>>>>>>>            Function_Return C_WebUnresolvedObject
17103>>>>>>>>>>>        End
17103>>>>>>>>>>>>
17103>>>>>>>>>>>        
17103>>>>>>>>>>>        // Recursively find parent until we reach a view or have no parent
17103>>>>>>>>>>>        Get Parent to hoParent
17104>>>>>>>>>>>        
17104>>>>>>>>>>>        If (hoParent <> 0) Begin
17106>>>>>>>>>>>            Get GetParentWidget of hoParent to hoParent
17107>>>>>>>>>>>        End
17107>>>>>>>>>>>>
17107>>>>>>>>>>>        
17107>>>>>>>>>>>        Function_Return hoParent
17108>>>>>>>>>>>    End_Function
17109>>>>>>>>>>>    
17109>>>>>>>>>>>    
17109>>>>>>>>>>>    // Checks if child has already been registered with this object.
17109>>>>>>>>>>>    Function ChildExists Handle hoChild Returns Boolean
17111>>>>>>>>>>>        Integer iIndex
17111>>>>>>>>>>>        Handle[] aChildWebControls
17112>>>>>>>>>>>        
17112>>>>>>>>>>>        Get paChildWebControls to aChildWebControls
17113>>>>>>>>>>>        Move (SearchArray(hoChild, aChildWebControls)) to iIndex
17114>>>>>>>>>>>        
17114>>>>>>>>>>>        If (iIndex <> -1) ;            Function_Return True
17117>>>>>>>>>>>        Else ;            Function_Return False
17119>>>>>>>>>>>    End_Function
17120>>>>>>>>>>>    
17120>>>>>>>>>>>    Procedure PreSerializeObject
17122>>>>>>>>>>>    End_Procedure
17123>>>>>>>>>>>    
17123>>>>>>>>>>>    Procedure PostSerializeObject
17125>>>>>>>>>>>    End_Procedure
17126>>>>>>>>>>>
17126>>>>>>>>>>>
17126>>>>>>>>>>>    // Serializes this cWebObject, and its child cWebObjects.
17126>>>>>>>>>>>    Function DoSerializeObject Handle hjClassArray Handle[] ByRef aClasses Returns Handle
17128>>>>>>>>>>>        Handle hClass hjClass hjProps hjAdvProps hjObject hjVT hjChildren hjChild hoClassMeta
17128>>>>>>>>>>>        tWebPropMetaData[] aProperties
17128>>>>>>>>>>>        tWebPropMetaData[] aProperties
17129>>>>>>>>>>>        Integer iProperty icProperty iChild icChild
17129>>>>>>>>>>>        Variant vValue
17129>>>>>>>>>>>        String sValue
17129>>>>>>>>>>>        tWebValueTree tVT tVTEmpty
17129>>>>>>>>>>>        tWebValueTree tVT tVTEmpty
17129>>>>>>>>>>>        Handle[] aChildWebControls
17130>>>>>>>>>>>        
17130>>>>>>>>>>>        If (pbGhost(Self)) ;            Function_Return C_WebUnresolvedObject
17133>>>>>>>>>>>            
17133>>>>>>>>>>>        // Hook for controls to do pre serialize initialization
17133>>>>>>>>>>>        Send PreSerializeObject
17134>>>>>>>>>>>        
17134>>>>>>>>>>>        // Send a user event hook to each object before fetching the published properties....
17134>>>>>>>>>>>        Send OnLoad
17135>>>>>>>>>>>        
17135>>>>>>>>>>>        Get ObjectClass to hClass
17136>>>>>>>>>>>        If (SearchArray(hClass, aClasses) = -1) Begin
17138>>>>>>>>>>>            Get phoClassPropMeta to hoClassMeta
17139>>>>>>>>>>>            Get paWebPropertyMeta of hoClassMeta to aProperties    
17140>>>>>>>>>>>            
17140>>>>>>>>>>>            Move hClass to aClasses[-1]
17141>>>>>>>>>>>            
17141>>>>>>>>>>>            If (pjJsonCache(hoClassMeta) <> C_WebUnresolvedObject) Begin
17143>>>>>>>>>>>                Get pjJsonCache of hoClassMeta to hjClass
17144>>>>>>>>>>>            End
17144>>>>>>>>>>>>
17144>>>>>>>>>>>            Else Begin
17145>>>>>>>>>>>                Get Create of hoClassMeta (RefClass(cJsonObject)) to hjClass
17146>>>>>>>>>>>                Send InitializeJsonType of hjClass jsonTypeObject
17147>>>>>>>>>>>                Send SetMemberValue of hjClass "sType" jsonTypeString (psJSClass(Self))
17148>>>>>>>>>>>                Send SetMemberValue of hjClass "hClassId" jsonTypeInteger hClass
17149>>>>>>>>>>>                
17149>>>>>>>>>>>                Get Create (RefClass(cJsonObject)) to hjProps
17150>>>>>>>>>>>                Send InitializeJsonType of hjProps jsonTypeObject
17151>>>>>>>>>>>                
17151>>>>>>>>>>>                Move (SizeOfArray(aProperties) - 1) to icProperty
17152>>>>>>>>>>>                For iProperty from 0 to icProperty 
17158>>>>>>>>>>>>
17158>>>>>>>>>>>                    If (aProperties[iProperty].eMode = wptClient or aProperties[iProperty].eMode = wptClientProtected) Begin
17160>>>>>>>>>>>                        If (aProperties[iProperty].eType = cArgArray or aProperties[iProperty].eType = cArgStruct) Begin
17162>>>>>>>>>>>                            If (hjAdvProps = C_WebUnresolvedObject) Begin
17164>>>>>>>>>>>                                Get Create (RefClass(cJsonObject)) to hjAdvProps
17165>>>>>>>>>>>                                Send InitializeJsonType of hjAdvProps jsonTypeObject
17166>>>>>>>>>>>                            End
17166>>>>>>>>>>>>
17166>>>>>>>>>>>                            
17166>>>>>>>>>>>                            Get aProperties[iProperty].hmGetter to vValue    // call the getter function
17167>>>>>>>>>>>                                
17167>>>>>>>>>>>                            ValueTreeSerializeParameter vValue to tVT
17168>>>>>>>>>>>                            Get Create (RefClass(cJsonObject)) to hjVT
17169>>>>>>>>>>>                            Send DataTypeToJson of hjVT tVT
17170>>>>>>>>>>>                            Send SetMember of hjAdvProps aProperties[iProperty].sName hjVT
17171>>>>>>>>>>>                            Send Destroy of hjVT
17172>>>>>>>>>>>                            Move tVTEmpty to tVT
17173>>>>>>>>>>>                        End
17173>>>>>>>>>>>>
17173>>>>>>>>>>>                        Else Begin
17174>>>>>>>>>>>                            Send SetMemberValue of hjProps aProperties[iProperty].sName jsonTypeString aProperties[iProperty].sDefault
17175>>>>>>>>>>>                        End
17175>>>>>>>>>>>>
17175>>>>>>>>>>>                    End
17175>>>>>>>>>>>>
17175>>>>>>>>>>>                Loop  
17176>>>>>>>>>>>>
17176>>>>>>>>>>>                
17176>>>>>>>>>>>                Send SetMember of hjClass "props" hjProps 
17177>>>>>>>>>>>                If (hjAdvProps <> C_WebUnresolvedObject) Begin
17179>>>>>>>>>>>                    Send SetMember of hjClass "advProps" hjAdvProps
17180>>>>>>>>>>>                    Send Destroy of hjAdvProps
17181>>>>>>>>>>>                    Move C_WebUnresolvedObject to hjAdvProps
17182>>>>>>>>>>>                End
17182>>>>>>>>>>>>
17182>>>>>>>>>>>                
17182>>>>>>>>>>>                Send Destroy of hjProps
17183>>>>>>>>>>>                
17183>>>>>>>>>>>                Set pjJsonCache of hoClassMeta to hjClass
17184>>>>>>>>>>>            End
17184>>>>>>>>>>>>
17184>>>>>>>>>>>            
17184>>>>>>>>>>>            Send AddMember of hjClassArray hjClass
17185>>>>>>>>>>>        End
17185>>>>>>>>>>>>
17185>>>>>>>>>>>        
17185>>>>>>>>>>>        Get Create (RefClass(cJsonObject)) to hjObject
17186>>>>>>>>>>>        Send InitializeJsonType of hjObject jsonTypeObject
17187>>>>>>>>>>>        Send SetMemberValue of hjObject "sName" jsonTypeString (Object_Label(Self))
17188>>>>>>>>>>>        Send SetMemberValue of hjObject "hClassId" jsonTypeInteger hClass
17189>>>>>>>>>>>        
17189>>>>>>>>>>>        Get Create (RefClass(cJsonObject)) to hjProps
17190>>>>>>>>>>>        Send InitializeJsonType of hjProps jsonTypeObject
17191>>>>>>>>>>>        Move C_WebUnresolvedObject to hjAdvProps
17192>>>>>>>>>>>        
17192>>>>>>>>>>>        Get paWebPropertyMeta to aProperties
17193>>>>>>>>>>>            
17193>>>>>>>>>>>        Move (SizeOfArray(aProperties) - 1) to icProperty
17194>>>>>>>>>>>        For iProperty from 0 to icProperty 
17200>>>>>>>>>>>>
17200>>>>>>>>>>>            If (aProperties[iProperty].eMode = wptClient or aProperties[iProperty].eMode = wptClientProtected and aProperties[iProperty].hmGetter <> 0) Begin
17202>>>>>>>>>>>                If (aProperties[iProperty].eType = cArgArray or aProperties[iProperty].eType = cArgStruct) Begin
17204>>>>>>>>>>>                    If (hjAdvProps = C_WebUnresolvedObject) Begin
17206>>>>>>>>>>>                        Get Create (RefClass(cJsonObject)) to hjAdvProps
17207>>>>>>>>>>>                        Send InitializeJsonType of hjAdvProps jsonTypeObject
17208>>>>>>>>>>>                    End
17208>>>>>>>>>>>>
17208>>>>>>>>>>>                    
17208>>>>>>>>>>>                    If (aProperties[iProperty].eMode = wptClientProtected) ;                        Get GetSyncProp Self aProperties[iProperty].hmSetter aProperties[iProperty].sName to vValue // for protected web properties we query the synchronized server value as it might have WebSet before
17211>>>>>>>>>>>                    Else ;                        Get aProperties[iProperty].hmGetter to vValue    // call the getter function
17213>>>>>>>>>>>                        
17213>>>>>>>>>>>                    ValueTreeSerializeParameter vValue to tVT
17214>>>>>>>>>>>                    Get Create (RefClass(cJsonObject)) to hjVT
17215>>>>>>>>>>>                    Send DataTypeToJson of hjVT tVT
17216>>>>>>>>>>>                    Send SetMember of hjAdvProps aProperties[iProperty].sName hjVT
17217>>>>>>>>>>>                    Send Destroy of hjVT
17218>>>>>>>>>>>                    Move tVTEmpty to tVT
17219>>>>>>>>>>>                End
17219>>>>>>>>>>>>
17219>>>>>>>>>>>                Else Begin
17220>>>>>>>>>>>                    If (aProperties[iProperty].eMode = wptClientProtected) ;                        Get GetSyncProp Self aProperties[iProperty].hmSetter aProperties[iProperty].sName to vValue // for protected web properties we query the synchronized server value as it might have WebSet before
17223>>>>>>>>>>>                    Else ;                        Get aProperties[iProperty].hmGetter to vValue    // call the getter function
17225>>>>>>>>>>>                    
17225>>>>>>>>>>>                    Get ConvertToTransport aProperties[iProperty].hmGetter vValue aProperties[iProperty].eType to sValue
17226>>>>>>>>>>>                    Send SetMemberValue of hjProps aProperties[iProperty].sName jsonTypeString sValue
17227>>>>>>>>>>>                End
17227>>>>>>>>>>>>
17227>>>>>>>>>>>            End
17227>>>>>>>>>>>>
17227>>>>>>>>>>>        Loop
17228>>>>>>>>>>>>
17228>>>>>>>>>>>        
17228>>>>>>>>>>>        Send SetMember of hjObject "props" hjProps
17229>>>>>>>>>>>        Send Destroy of hjProps
17230>>>>>>>>>>>        If (hjAdvProps <> C_WebUnresolvedObject) Begin
17232>>>>>>>>>>>            Send SetMember of hjObject "advProps" hjAdvProps
17233>>>>>>>>>>>            Send Destroy of hjAdvProps
17234>>>>>>>>>>>        End
17234>>>>>>>>>>>>
17234>>>>>>>>>>>        
17234>>>>>>>>>>>        Send PassPropertyRules
17235>>>>>>>>>>>        
17235>>>>>>>>>>>        //  Serialize children
17235>>>>>>>>>>>        Get Create (RefClass(cJsonObject)) to hjChildren
17236>>>>>>>>>>>        Send InitializeJsonType of hjChildren jsonTypeArray
17237>>>>>>>>>>>        
17237>>>>>>>>>>>        Get paChildWebControls to aChildWebControls
17238>>>>>>>>>>>        Move (SizeOfArray(aChildWebControls) - 1) to icChild
17239>>>>>>>>>>>        
17239>>>>>>>>>>>        For iChild from 0 to icChild
17245>>>>>>>>>>>>
17245>>>>>>>>>>>            Get DoSerializeObject of aChildWebControls[iChild] hjClassArray (&aClasses) to hjChild
17246>>>>>>>>>>>            If (hjChild <> C_WebUnresolvedObject) Begin
17248>>>>>>>>>>>                Send AddMember of hjChildren hjChild
17249>>>>>>>>>>>                Send Destroy of hjChild
17250>>>>>>>>>>>            End
17250>>>>>>>>>>>>
17250>>>>>>>>>>>        Loop 
17251>>>>>>>>>>>>
17251>>>>>>>>>>>        
17251>>>>>>>>>>>        Send SetMember of hjObject "aObjs" hjChildren
17252>>>>>>>>>>>        Send Destroy of hjChildren
17253>>>>>>>>>>>        
17253>>>>>>>>>>>        
17253>>>>>>>>>>>        Send PostSerializeObject
17254>>>>>>>>>>>        
17254>>>>>>>>>>>        Function_Return hjObject
17255>>>>>>>>>>>    End_Procedure
17256>>>>>>>>>>>    
17256>>>>>>>>>>>    // Serializes this Web Object and its children to JSON and returns a JSON Handle.
17256>>>>>>>>>>>    Function SerializeObject Returns Handle
17258>>>>>>>>>>>        Handle hjClasses hjObject hjWrap
17258>>>>>>>>>>>        Handle[] aClasses
17259>>>>>>>>>>>        
17259>>>>>>>>>>>        Get Create (RefClass(cJsonObject)) to hjClasses
17260>>>>>>>>>>>        Send InitializeJsonType of hjClasses jsonTypeArray
17261>>>>>>>>>>>        
17261>>>>>>>>>>>        Get DoSerializeObject hjClasses (&aClasses) to hjObject
17262>>>>>>>>>>>        
17262>>>>>>>>>>>        Get Create (RefClass(cJsonObject)) to hjWrap
17263>>>>>>>>>>>        Send InitializeJsonType of hjWrap jsonTypeObject
17264>>>>>>>>>>>        
17264>>>>>>>>>>>        If (hjObject <> C_WebUnresolvedObject) Begin
17266>>>>>>>>>>>            Send SetMember of hjWrap "obj" hjObject
17267>>>>>>>>>>>            Send Destroy of hjObject
17268>>>>>>>>>>>        End
17268>>>>>>>>>>>>
17268>>>>>>>>>>>        
17268>>>>>>>>>>>        Send SetMember of hjWrap "aClasses" hjClasses
17269>>>>>>>>>>>        Send Destroy of hjClasses
17270>>>>>>>>>>>        
17270>>>>>>>>>>>        Function_Return hjWrap
17271>>>>>>>>>>>    End_Function
17272>>>>>>>>>>>    
17272>>>>>>>>>>>    // pass the responsive mode property rules to the client. These are passed to the client
17272>>>>>>>>>>>    // via Client Actions in the response data. This is the most flexible approach.
17272>>>>>>>>>>>    Procedure PassPropertyRules
17274>>>>>>>>>>>        Integer iProp icProp iMode icMode
17274>>>>>>>>>>>        String[] aParams
17275>>>>>>>>>>>        tWebPropRule PropRule
17275>>>>>>>>>>>        tWebPropRule PropRule
17275>>>>>>>>>>>        tWebPropRule[] aPropRules
17275>>>>>>>>>>>        tWebPropRule[] aPropRules
17276>>>>>>>>>>>
17276>>>>>>>>>>>        // Iterate the properties....
17276>>>>>>>>>>>        Get paPubPropertyRules to aPropRules
17277>>>>>>>>>>>        Move (SizeOfArray(aPropRules)) to icProp
17278>>>>>>>>>>>        
17278>>>>>>>>>>>        For iProp from 0 to (icProp-1)
17284>>>>>>>>>>>>
17284>>>>>>>>>>>            // iterate the modes...
17284>>>>>>>>>>>            Move aPropRules[iProp] to PropRule
17285>>>>>>>>>>>            Move (SizeOfArray(PropRule.aModeRules)) to icMode
17286>>>>>>>>>>>            
17286>>>>>>>>>>>            For iMode from 0 to (icMode-1)
17292>>>>>>>>>>>>
17292>>>>>>>>>>>                // Write the client action
17292>>>>>>>>>>>                Move PropRule.sName                    to aParams[0]
17293>>>>>>>>>>>                Move PropRule.aModeRules[iMode].eMode  to aParams[1]
17294>>>>>>>>>>>                Move PropRule.aModeRules[iMode].vValue to aParams[2]
17295>>>>>>>>>>>                Send ClientAction "propRule" aParams
17296>>>>>>>>>>>            Loop
17297>>>>>>>>>>>>
17297>>>>>>>>>>>        Loop
17298>>>>>>>>>>>>
17298>>>>>>>>>>>    End_Procedure
17299>>>>>>>>>>>
17299>>>>>>>>>>>    // Sets the addressed web property to the passed value. (see also GetSyncProp)
17299>>>>>>>>>>>    // Simply delegates this message to the global cWebSyncPropsHandler. 
17299>>>>>>>>>>>    //
17299>>>>>>>>>>>    // Note that even through we use variant for the value, it is never really converted to a 
17299>>>>>>>>>>>    // variant for simple types (so no unnessecary UTF-16 conversions). Confirmed in the runtime @ DF20.
17299>>>>>>>>>>>    //
17299>>>>>>>>>>>    // hoObject   - Is handle to the object which owns the property.
17299>>>>>>>>>>>    // hmSetter   - Is a handle to the property's getter message
17299>>>>>>>>>>>    // sPropName  - Is the (case sensitive) property name.
17299>>>>>>>>>>>    // vPropValue - Is the property value.
17299>>>>>>>>>>>    //
17299>>>>>>>>>>>    // Use the WebSet command instead of sending this message.
17299>>>>>>>>>>>    Procedure SetSyncProp Handle hoObject Handle hmSetter String sPropName Variant vPropValue
17301>>>>>>>>>>>        String sObject
17301>>>>>>>>>>>        tWebPropMetaData pubProp
17301>>>>>>>>>>>        tWebPropMetaData pubProp
17301>>>>>>>>>>>        If (pbGhost(Self)) ;            Procedure_Return
17304>>>>>>>>>>>        
17304>>>>>>>>>>>         //  Find property index
17304>>>>>>>>>>>        Get FindWebPropertyMetaBySetter hmSetter to pubProp
17305>>>>>>>>>>>        
17305>>>>>>>>>>>        If (pubProp.hmGetter <= 0) Begin
17307>>>>>>>>>>>            Get Object_Label to sObject
17308>>>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppPropertyNotPublished, "WebSet", sPropName, sObject, C_NewLine+C_NewLine))        
17309>>>>>>>>>>>>
17309>>>>>>>>>>>            Procedure_Return
17310>>>>>>>>>>>        End
17310>>>>>>>>>>>>
17310>>>>>>>>>>>        
17310>>>>>>>>>>>        Send OwnerSetSyncProp of (Owner(Self)) hoObject (&pubProp) vPropValue
17311>>>>>>>>>>>    End_Procedure
17312>>>>>>>>>>>    
17312>>>>>>>>>>>    // Marks a web property as changed (different than the class default).
17312>>>>>>>>>>>    // Called by SetWebProp in cWebBaseObject. 
17312>>>>>>>>>>>    Procedure MarkWebPropChanged Handle hmSetter
17314>>>>>>>>>>>        tWebPropMetaData propMeta
17314>>>>>>>>>>>        tWebPropMetaData propMeta
17314>>>>>>>>>>>
17314>>>>>>>>>>>        //  If it is already registered at object level we are done, else look up the class definition and register it if nessecary
17314>>>>>>>>>>>        Get FindWebPropertyBySetter hmSetter to propMeta
17315>>>>>>>>>>>        If (propMeta.hmGetter <> 0) ;            Procedure_Return
17318>>>>>>>>>>>    
17318>>>>>>>>>>>        Get FindWebPropertyBySetter of (phoClassPropMeta(Self)) hmSetter to propMeta
17319>>>>>>>>>>>        If (propMeta.hmGetter = 0) Begin
17321>>>>>>>>>>>            Error DFERR_PROGRAM "Web property administration error!"
17322>>>>>>>>>>>>
17322>>>>>>>>>>>            Procedure_Return
17323>>>>>>>>>>>        End
17323>>>>>>>>>>>>
17323>>>>>>>>>>>    
17323>>>>>>>>>>>        If (propMeta.eMode = wptClient or propMeta.eMode = wptClientProtected) Begin
17325>>>>>>>>>>>            Send RegisterWebProperty propMeta.hmGetter propMeta.hmSetter propMeta.sName propMeta.eType propMeta.eMode 
17326>>>>>>>>>>>        End
17326>>>>>>>>>>>>
17326>>>>>>>>>>>
17326>>>>>>>>>>>    End_Procedure
17327>>>>>>>>>>>
17327>>>>>>>>>>>    // Unsynchronizes a client web property. Doing this prevents the property value from being sent
17327>>>>>>>>>>>    // with future requests (until it is webset or changes on the client again).
17327>>>>>>>>>>>    //
17327>>>>>>>>>>>    // Usage Example:
17327>>>>>>>>>>>    //  Send UnSyncWebProperty of oWebLabel1 (RefFunc(psCaption))
17327>>>>>>>>>>>    Procedure UnSyncWebProperty Handle hmGetter
17329>>>>>>>>>>>        tWebPropMetaData pubProp
17329>>>>>>>>>>>        tWebPropMetaData pubProp
17329>>>>>>>>>>>        String[] aParams
17330>>>>>>>>>>>    
17330>>>>>>>>>>>        // Find web property
17330>>>>>>>>>>>        Get FindWebPropertyMetaByGetter hmGetter to pubProp
17331>>>>>>>>>>>        
17331>>>>>>>>>>>        If (pubProp.hmGetter = 0) Begin
17333>>>>>>>>>>>            Error DFERR_PROGRAM "UnSyncWebProperty is only supported on published client web properties."   
17334>>>>>>>>>>>>
17334>>>>>>>>>>>            Procedure_Return
17335>>>>>>>>>>>        End
17335>>>>>>>>>>>>
17335>>>>>>>>>>>                
17335>>>>>>>>>>>        //  Check the type
17335>>>>>>>>>>>        If (pubProp.eMode = wptClient or pubProp.eMode = wptClientProtected) Begin
17337>>>>>>>>>>>            Move pubProp.sName to aParams[0]
17338>>>>>>>>>>>            Send ClientAction "unSync" aParams
17339>>>>>>>>>>>        End
17339>>>>>>>>>>>>
17339>>>>>>>>>>>        Else Begin
17340>>>>>>>>>>>            Error DFERR_PROGRAM "UnSyncWebProperty is only supported on client web properties."
17341>>>>>>>>>>>>
17341>>>>>>>>>>>        End
17341>>>>>>>>>>>>
17341>>>>>>>>>>>    End_Procedure
17342>>>>>>>>>>>    
17342>>>>>>>>>>>    // Sets a responsive mode value for a web property. Note that this is here for compatibility, use SetPropertyRuleEx if possible.
17342>>>>>>>>>>>    // hmGetter   - Is a handle to the property's getter message
17342>>>>>>>>>>>    // sPropName  - Is the (case sensitive) property name.
17342>>>>>>>>>>>    // eMode      - Responsive mode, e.g. ModeTablet, ModeMobile
17342>>>>>>>>>>>    // vValue     - Is the property value.
17342>>>>>>>>>>>    //
17342>>>>>>>>>>>    // Use the WebSetRule command instead of sending this message.
17342>>>>>>>>>>>    Procedure SetPropertyRule Handle hmGetter String sPropName Integer eMode Variant vValue
17344>>>>>>>>>>>        tWebPropMetaData pubProp
17344>>>>>>>>>>>        tWebPropMetaData pubProp
17344>>>>>>>>>>>        
17344>>>>>>>>>>>        Get FindWebPropertyMetaByGetter hmGetter to pubProp
17345>>>>>>>>>>>        If (pubProp.hmGetter = 0) Begin
17347>>>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppPropertyNotPublished, "WebSetRule", sPropName, C_NewLine + C_NewLine))        
17348>>>>>>>>>>>>
17348>>>>>>>>>>>            Procedure_Return
17349>>>>>>>>>>>        End
17349>>>>>>>>>>>>
17349>>>>>>>>>>>        
17349>>>>>>>>>>>        Send SetPropertyRuleEx pubProp.hmSetter sPropName eMode vValue
17350>>>>>>>>>>>    End_Procedure
17351>>>>>>>>>>>    
17351>>>>>>>>>>>    // Sets a responsive mode value for a web property.
17351>>>>>>>>>>>    // hmSetter   - Is a handle to the property's getter message
17351>>>>>>>>>>>    // sPropName  - Is the (case sensitive) property name.
17351>>>>>>>>>>>    // eMode      - Responsive mode, e.g. ModeTablet, ModeMobile
17351>>>>>>>>>>>    // vValue     - Is the property value.
17351>>>>>>>>>>>    //
17351>>>>>>>>>>>    // Use the WebSetRule command instead of sending this message.
17351>>>>>>>>>>>    Procedure SetPropertyRuleEx Handle hmSetter String sPropName Integer eMode Variant vValue
17353>>>>>>>>>>>        Integer iModeIndex i iCount iPropIndex
17353>>>>>>>>>>>        tWebPropRule PropRule
17353>>>>>>>>>>>        tWebPropRule PropRule
17353>>>>>>>>>>>        tWebPropRule[] aPropRules
17353>>>>>>>>>>>        tWebPropRule[] aPropRules
17354>>>>>>>>>>>        tWebPropMetaData pubProp
17354>>>>>>>>>>>        tWebPropMetaData pubProp
17354>>>>>>>>>>>
17354>>>>>>>>>>>        // Test that the passed property name belongs to the set of web properties 
17354>>>>>>>>>>>        // for this object.
17354>>>>>>>>>>>        Get FindWebPropertyMetaBySetter hmSetter to pubProp
17355>>>>>>>>>>>        If (pubProp.hmGetter = 0) Begin
17357>>>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppPropertyNotPublished, "WebSetRule", sPropName, C_NewLine + C_NewLine))        
17358>>>>>>>>>>>>
17358>>>>>>>>>>>            Procedure_Return
17359>>>>>>>>>>>        End
17359>>>>>>>>>>>>
17359>>>>>>>>>>>        
17359>>>>>>>>>>>        // sPropName is passed in "UPPERCASE". Use iIndex now to lookup the correctly cased
17359>>>>>>>>>>>        // property name.
17359>>>>>>>>>>>        Move pubProp.sName to sPropName
17360>>>>>>>>>>>        
17360>>>>>>>>>>>        // Now look to see if we already have an entry for this property. If so, get its index.
17360>>>>>>>>>>>        Move -1 to iPropIndex
17361>>>>>>>>>>>        Get paPubPropertyRules to aPropRules
17362>>>>>>>>>>>        Move (SizeOfArray(aPropRules)) to iCount
17363>>>>>>>>>>>        
17363>>>>>>>>>>>        For i from 0 to (iCount-1)
17369>>>>>>>>>>>>
17369>>>>>>>>>>>            If (Uppercase(aPropRules[i].sName) = sPropName) Begin
17371>>>>>>>>>>>                Move i to iPropIndex
17372>>>>>>>>>>>            End
17372>>>>>>>>>>>>
17372>>>>>>>>>>>            If (iPropIndex > -1) ;                Break
17375>>>>>>>>>>>        Loop
17376>>>>>>>>>>>>
17376>>>>>>>>>>>        
17376>>>>>>>>>>>        If (iPropIndex = -1) Begin
17378>>>>>>>>>>>            // Create a new entry for this property.
17378>>>>>>>>>>>            Move iCount to iPropIndex
17379>>>>>>>>>>>            Move sPropName to PropRule.sName
17380>>>>>>>>>>>        End
17380>>>>>>>>>>>>
17380>>>>>>>>>>>        Else Begin
17381>>>>>>>>>>>            Move aPropRules[iPropIndex] to PropRule
17382>>>>>>>>>>>        End
17382>>>>>>>>>>>>
17382>>>>>>>>>>>        
17382>>>>>>>>>>>        // look if we already have an entry for this mode. If so get its index.
17382>>>>>>>>>>>        Move -1 to iModeIndex
17383>>>>>>>>>>>        Move (SizeOfArray(PropRule.aModeRules)) to iCount
17384>>>>>>>>>>>        
17384>>>>>>>>>>>        For i from 0 to (iCount-1)
17390>>>>>>>>>>>>
17390>>>>>>>>>>>            If (PropRule.aModeRules[i].eMode = eMode) Begin
17392>>>>>>>>>>>                Move i to iModeIndex
17393>>>>>>>>>>>            End
17393>>>>>>>>>>>>
17393>>>>>>>>>>>            If (iModeIndex > -1) ;                Break
17396>>>>>>>>>>>        Loop
17397>>>>>>>>>>>>
17397>>>>>>>>>>>        
17397>>>>>>>>>>>        // Add or update the mode value...
17397>>>>>>>>>>>        If (iModeIndex = -1) Begin
17399>>>>>>>>>>>            Move iCount to iModeIndex
17400>>>>>>>>>>>        End
17400>>>>>>>>>>>>
17400>>>>>>>>>>>        
17400>>>>>>>>>>>        Move eMode  to PropRule.aModeRules[iModeIndex].eMode
17401>>>>>>>>>>>        Move vValue to PropRule.aModeRules[iModeIndex].vValue
17402>>>>>>>>>>>        
17402>>>>>>>>>>>        // Save the changes back to the array property.
17402>>>>>>>>>>>        Move PropRule to aPropRules[iPropIndex]
17403>>>>>>>>>>>        Set paPubPropertyRules to aPropRules
17404>>>>>>>>>>>    End_Procedure
17405>>>>>>>>>>>    
17405>>>>>>>>>>>    
17405>>>>>>>>>>>    //  This procedure changes the action mode of the specified server action. The action  mode
17405>>>>>>>>>>>    //  determines how the browser application will behave while the call to the server is being 
17405>>>>>>>>>>>    //  executed. The client needs to know this upfront which is why this needs to be determined 
17405>>>>>>>>>>>    //  before the call is actually made. It is advised to set the action mode in the OnLoad event 
17405>>>>>>>>>>>    //  so that it is immediately set when the object is first loaded to the client. It also needs 
17405>>>>>>>>>>>    //  to be set for every session independently.
17405>>>>>>>>>>>    //
17405>>>>>>>>>>>    //  hMessage - The message for which the action mode needs to be updated. Note that this 
17405>>>>>>>>>>>    //  message should be on the same object as this procedure is called on.
17405>>>>>>>>>>>    //  eMode - The action mode that should be used.
17405>>>>>>>>>>>    //      scModeDefault : The default mode where the browser application is not locked and 
17405>>>>>>>>>>>    //      multiple actions can be joined to a single action.
17405>>>>>>>>>>>    //      scModeWait: Locks the user interface and shows the wait cursor.
17405>>>>>>>>>>>    //      scModeProgress: Locks the user interface and shows the wait dialog.
17405>>>>>>>>>>>    //  sOptWaitMessage - The message shown in the waiting dialog for scModeWait.
17405>>>>>>>>>>>    //  
17405>>>>>>>>>>>    Procedure SetActionMode Handle hMessage Integer eMode String sOptWaitMessage
17407>>>>>>>>>>>        String sMsg
17407>>>>>>>>>>>        String[] aParams
17408>>>>>>>>>>>        
17408>>>>>>>>>>>        Get WebMethodName hMessage to sMsg
17409>>>>>>>>>>>        
17409>>>>>>>>>>>        If (sMsg <> "") Begin
17411>>>>>>>>>>>            Move sMsg to aParams[0]
17412>>>>>>>>>>>            Move eMode to aParams[1]
17413>>>>>>>>>>>            
17413>>>>>>>>>>>            If (num_arguments > 2) Begin
17415>>>>>>>>>>>                Move sOptWaitMessage to aParams[2]
17416>>>>>>>>>>>            End
17416>>>>>>>>>>>>
17416>>>>>>>>>>>            
17416>>>>>>>>>>>            Send ClientAction "setActionMode" aParams
17417>>>>>>>>>>>        End
17417>>>>>>>>>>>>
17417>>>>>>>>>>>    End_Procedure
17418>>>>>>>>>>>    
17418>>>>>>>>>>>    
17418>>>>>>>>>>>    //  Sends a client-action to the client that calls back the specified message on the server. 
17418>>>>>>>>>>>    //  This extra round-trip causes the UI to be updated which can be interresting for operations 

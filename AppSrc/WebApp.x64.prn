30023>>>>>>>        // Split the file name from the key 
30023>>>>>>>        Move (RightPos("/", sPath)) to iPos
30024>>>>>>>        If (iPos > 0) ;            Move (Right(sPath, Length(sPath) - iPos)) to sFileName
30027>>>>>>>        Else ;            Move sPath to sFileName
30029>>>>>>>        
30029>>>>>>>        //  Determine stream type
30029>>>>>>>        Get UrlParameter "attach" to sAttach
30030>>>>>>>        If (Lowercase(Trim(sAttach)) = "true") ;            Move "attachment" to sStreamType
30033>>>>>>>        Else ;            Move "inline" to sStreamType
30035>>>>>>>            
30035>>>>>>>        //  Let resource manager parse the path
30035>>>>>>>        Get FileDownload of hoResourceManager sHash (&sFilePath) (&iHttpError) (&sHttpError) to bOk
30036>>>>>>>        
30036>>>>>>>        If (not(bOk)) Begin
30038>>>>>>>            Send SetResponseStatus iHttpError sHttpError
30039>>>>>>>            Procedure_Return
30040>>>>>>>        End
30040>>>>>>>>
30040>>>>>>>                
30040>>>>>>>        //  Determine contenttype based on extension
30040>>>>>>>        Move (RightPos(".", sFileName)) to iPos
30041>>>>>>>        If (iPos >= 0) ;            Get ContentType of hoResourceManager (Right(sFileName, Length(sFileName) - iPos)) to sContentType
30044>>>>>>>        Else ;            Get ContentType of hoResourceManager "" to sContentType
30046>>>>>>>                
30046>>>>>>>        //  Open the file
30046>>>>>>>        Move (Seq_New_Channel()) to iChnl
30047>>>>>>>        If (iChnl >= 0) Begin
30049>>>>>>>            Direct_Input channel iChnl ("binary:" + sFilePath)
30051>>>>>>>            Get_Channel_Size iChnl to iSize
30052>>>>>>>            
30052>>>>>>>            //  Send the response headers
30052>>>>>>>            Send AddHttpResponseHeader "Content-Type" sContentType
30053>>>>>>>            Send AddHttpResponseHeader "Content-Disposition" (sStreamType +';filename="' + sFileName + '"')
30054>>>>>>>            Send AddHttpResponseHeader "Content-Length" iSize
30055>>>>>>>            
30055>>>>>>>            //  Send the file
30055>>>>>>>            While (not(SeqEof))
30059>>>>>>>                Read_Block channel iChnl aData HTTP_DEFAULT_CHUNK_SIZE
30061>>>>>>>                
30061>>>>>>>                Send OutputUChar aData
30062>>>>>>>            Loop
30063>>>>>>>>
30063>>>>>>>            
30063>>>>>>>            Close_Input channel iChnl
30065>>>>>>>            Send Seq_Release_Channel iChnl
30066>>>>>>>            
30066>>>>>>>            //  Trigger filedownloadfinished
30066>>>>>>>            Send FileDownloadFinished of hoResourceManager sFilePath
30067>>>>>>>        End
30067>>>>>>>>
30067>>>>>>>        Else If (iChnl = -1) Begin
30070>>>>>>>            Send SetResponseStatus 500 "I/O Channel Error" 1
30071>>>>>>>            Procedure_Return
30072>>>>>>>        End
30072>>>>>>>>
30072>>>>>>>        Else If (iChnl = -2) Begin
30075>>>>>>>            Send SetResponseStatus 500 "No I/O Channel Available" 2
30076>>>>>>>            Procedure_Return
30077>>>>>>>        End
30077>>>>>>>>
30077>>>>>>>    End_Procedure
30078>>>>>>>
30078>>>>>>>    //  In case of a post this is a file upload. The cWebHttpMultipartFormDataHandler base class 
30078>>>>>>>    //  will tear the request apart and trigger OnField and OnFile.. events. 
30078>>>>>>>    Procedure OnHttpPost String sPath String sContentType String sAcceptType DWord iSize
30080>>>>>>>        Send HandleFileUpload
30081>>>>>>>    End_Procedure
30082>>>>>>>    
30082>>>>>>>    // Main entry point for parsing the file upload
30082>>>>>>>    Procedure HandleFileUpload 
30084>>>>>>>        Boolean bSuccess bExists
30084>>>>>>>        String sFilePath
30084>>>>>>>        
30084>>>>>>>        Set psHash to ""
30085>>>>>>>        Set piChannel to -1
30086>>>>>>>        Set psUploadPath to ""
30087>>>>>>>        Set pbStatusSent to False
30088>>>>>>>
30088>>>>>>>        Get ParseMultipartFormData to bSuccess
30089>>>>>>>        //Send SetResponseStatus 500 "Invalid request format: test" 8
30089>>>>>>>        If (not(bSuccess)) Begin
30091>>>>>>>            Get psUploadPath to sFilePath    
30092>>>>>>>            If (sFilePath <> "") Begin
30094>>>>>>>                File_Exist sFilePath bExists
30095>>>>>>>                If (bExists) Begin
30097>>>>>>>                    EraseFile sFilePath 
30098>>>>>>>>
30098>>>>>>>                End
30098>>>>>>>>
30098>>>>>>>            End
30098>>>>>>>>
30098>>>>>>>            
30098>>>>>>>            If (not(pbstatussent(Self))) ;                Send SetResponseStatus 500 (psParseError(Self)) (piParseErrorCode(Self))             
30101>>>>>>>        End
30101>>>>>>>>
30101>>>>>>>        Set psHash to ""
30102>>>>>>>        Set piChannel to -1
30103>>>>>>>        Set psUploadPath to ""
30104>>>>>>>        Set pbStatusSent to False
30105>>>>>>>    End_Procedure
30106>>>>>>>    
30106>>>>>>>    //  The hash is sent as a field before the file is sent.
30106>>>>>>>    Procedure OnField String sName UChar[] ucData
30108>>>>>>>        Forward Send OnField sName ucData
30110>>>>>>>        
30110>>>>>>>        If (sName = "hash") Begin
30112>>>>>>>            Set psHash to (UCharArrayToString(ucData))
30113>>>>>>>        End
30113>>>>>>>>
30113>>>>>>>    End_Procedure
30114>>>>>>>    
30114>>>>>>>    //  When the file comes in we decrypt the hash and open the file. We store the channel so that
30114>>>>>>>    //  OnFileChunk can actually write the data.
30114>>>>>>>    Procedure OnFileStart String sFieldName String sFileName String sContentType Boolean ByRef bAbort
30116>>>>>>>        String sHash sPath sError
30116>>>>>>>        Integer iChnl iHttpErr
30116>>>>>>>        Boolean bExists bOk
30116>>>>>>>        
30116>>>>>>>        If (sFieldName = "file") Begin
30118>>>>>>>            Get psHash to sHash
30119>>>>>>>            
30119>>>>>>>            If (sHash = "") Begin
30121>>>>>>>                Send SetResponseStatus 500 "Invalid request format: expected hash before file." 4
30122>>>>>>>                Move True to bAbort
30123>>>>>>>                Set pbStatusSent to True
30124>>>>>>>                Procedure_Return
30125>>>>>>>            End
30125>>>>>>>>
30125>>>>>>>            
30125>>>>>>>            Get FileUpload of (ResourceManager(Self)) sFileName sHash (&sPath) (&iHttpErr) (&sError) to bOk
30126>>>>>>>            If (not(bOk)) Begin
30128>>>>>>>                Send SetResponseStatus iHttpErr sError
30129>>>>>>>                Set pbStatusSent to True
30130>>>>>>>                Move True to bAbort
30131>>>>>>>                Procedure_Return
30132>>>>>>>            End
30132>>>>>>>>
30132>>>>>>>            
30132>>>>>>>            File_Exist sPath bExists
30133>>>>>>>            
30133>>>>>>>            If (not(bExists)) Begin
30135>>>>>>>                Move (Seq_New_Channel()) to iChnl
30136>>>>>>>                If (iChnl >= 0) Begin
30138>>>>>>>                    Direct_Output channel iChnl ("binary:" + sPath)
30140>>>>>>>                    Set piChannel to iChnl
30141>>>>>>>                    Set psUploadPath to sPath
30142>>>>>>>                End
30142>>>>>>>>
30142>>>>>>>                Else If (iChnl = -1) Begin
30145>>>>>>>                    Send SetResponseStatus 500 "I/O Channel Error" 1
30146>>>>>>>                    Set pbStatusSent to True
30147>>>>>>>                    Move True to bAbort
30148>>>>>>>                End
30148>>>>>>>>
30148>>>>>>>                Else If (iChnl = -2) Begin
30151>>>>>>>                    Send SetResponseStatus 500 "No I/O Channel Available" 2
30152>>>>>>>                    Set pbStatusSent to True
30153>>>>>>>                    Move True to bAbort
30154>>>>>>>                End
30154>>>>>>>>
30154>>>>>>>            End
30154>>>>>>>>
30154>>>>>>>            Else Begin
30155>>>>>>>                Send SetResponseStatus 500 "File already exists" 6
30156>>>>>>>                Set pbStatusSent to True
30157>>>>>>>                Move True to bAbort
30158>>>>>>>            End
30158>>>>>>>>
30158>>>>>>>        End
30158>>>>>>>>
30158>>>>>>>    End_Procedure
30159>>>>>>>    
30159>>>>>>>    //  Called for each chunk of data that comes in for a file, we simply write it out to the 
30159>>>>>>>    //  already opened file channel.
30159>>>>>>>    Procedure OnFileChunk String sFieldName UChar[] ByRef ucData
30161>>>>>>>        Integer iChnl
30161>>>>>>>        
30161>>>>>>>        If (sFieldName = "file") Begin
30163>>>>>>>            Get piChannel to iChnl
30164>>>>>>>            If (iChnl >= 0) Begin
30166>>>>>>>                Write channel iChnl ucData
30168>>>>>>>            End
30168>>>>>>>>
30168>>>>>>>        End
30168>>>>>>>>
30168>>>>>>>    End_Procedure
30169>>>>>>>    
30169>>>>>>>    //  The upload is done, we send back a positive response.
30169>>>>>>>    Procedure OnFileFinished String sFieldName
30171>>>>>>>        Integer iChnl
30171>>>>>>>        String sFilePath
30171>>>>>>>        
30171>>>>>>>        If (sFieldName = "file") Begin
30173>>>>>>>            Get piChannel to iChnl
30174>>>>>>>            If (iChnl >= 0) Begin
30176>>>>>>>                Close_Output channel iChnl
30178>>>>>>>                Send Seq_Release_Channel iChnl
30179>>>>>>>                
30179>>>>>>>                Get psUploadPath to sFilePath
30180>>>>>>>                                
30180>>>>>>>                Set piChannel to -1
30181>>>>>>>                Set psUploadPath to ""
30182>>>>>>>                
30182>>>>>>>                Send SetResponseStatus 201 "Upload succesfull" 0
30183>>>>>>>                Set pbStatusSent to True
30184>>>>>>>                Send FileUploadFinished of (ResourceManager(Self)) sFilePath
30185>>>>>>>            End
30185>>>>>>>>
30185>>>>>>>            Else If (iChnl = -1) Begin
30188>>>>>>>                Send SetResponseStatus 500 "I/O Channel Error" 1
30189>>>>>>>                Set pbStatusSent to True
30190>>>>>>>            End
30190>>>>>>>>
30190>>>>>>>            Else If (iChnl = -2) Begin
30193>>>>>>>                Send SetResponseStatus 500 "No I/O Channel Available" 2
30194>>>>>>>                Set pbStatusSent to True
30195>>>>>>>            End
30195>>>>>>>>
30195>>>>>>>        End
30195>>>>>>>>
30195>>>>>>>    End_Procedure
30196>>>>>>>    
30196>>>>>>>    
30196>>>>>>>End_Class

29546>>>>>>>>>>>        Boolean bEqual
29546>>>>>>>>>>>        
29546>>>>>>>>>>>        //  If we are already at the split then we move to the next chunk (we don't want to miss out out on tokens starting on the split)
29546>>>>>>>>>>>        If (bSkip and parsedata.iChunkRead >= SizeOfArray(parsedata.ucCurrentChunk)) Begin
29548>>>>>>>>>>>            Send ReadChunk (&parsedata)
29549>>>>>>>>>>>        End
29549>>>>>>>>>>>>
29549>>>>>>>>>>>        
29549>>>>>>>>>>>        Move parsedata.iChunkRead to iRead
29550>>>>>>>>>>>        
29550>>>>>>>>>>>        //  Search data for initial character
29550>>>>>>>>>>>        Repeat
29550>>>>>>>>>>>>
29550>>>>>>>>>>>            Move (SearchArray(ucToken[0], (&parsedata.ucCurrentChunk), iRead)) to iTokenPos
29551>>>>>>>>>>>            If (iTokenPos >= 0) Begin
29553>>>>>>>>>>>                If (bBoundary and parsedata.iBoundPos >= 0 and iTokenPos >= parsedata.iBoundPos) Begin
29555>>>>>>>>>>>                    Function_Return -1
29556>>>>>>>>>>>                End
29556>>>>>>>>>>>>
29556>>>>>>>>>>>                
29556>>>>>>>>>>>                //  See if this is really the boundary
29556>>>>>>>>>>>                Move (MemCompare(AddressOf(ucToken), AddressOf(parsedata.ucCurrentChunk[iTokenPos]), (SizeOfArray(ucToken) min (SizeOfArray(parsedata.ucCurrentChunk) - iTokenPos))) = 0) to bEqual
29557>>>>>>>>>>>                If (bEqual) Begin
29559>>>>>>>>>>>                
29559>>>>>>>>>>>                    //  Boundary is possibly split between chunks, compare next chunk
29559>>>>>>>>>>>                    Move (SizeOfArray(ucToken) - (SizeOfArray(parsedata.ucCurrentChunk) - iTokenPos)) to iSplit
29560>>>>>>>>>>>                    If (iSplit > 0) Begin
29562>>>>>>>>>>>                        If (iSplit < SizeOfArray(parsedata.ucNextChunk)) Begin
29564>>>>>>>>>>>                            Move (MemCompare(AddressOf(ucToken[SizeOfArray(ucToken) - iSplit]), AddressOf(parsedata.ucNextChunk), iSplit) = 0) to bEqual
29565>>>>>>>>>>>                            
29565>>>>>>>>>>>                            If (bEqual and bSkip) Begin
29567>>>>>>>>>>>                                Send ReadChunk (&parsedata)
29568>>>>>>>>>>>                                Move iSplit to parsedata.iChunkRead
29569>>>>>>>>>>>                                Function_Return 0
29570>>>>>>>>>>>                            End    
29570>>>>>>>>>>>>
29570>>>>>>>>>>>                        End
29570>>>>>>>>>>>>
29570>>>>>>>>>>>                        Else Begin
29571>>>>>>>>>>>                            Function_Return -1
29572>>>>>>>>>>>                        End
29572>>>>>>>>>>>>
29572>>>>>>>>>>>                    End
29572>>>>>>>>>>>>
29572>>>>>>>>>>>                    
29572>>>>>>>>>>>                    //  Check for a regular match
29572>>>>>>>>>>>                    If (bEqual) Begin
29574>>>>>>>>>>>                        If (bSkip) Begin
29576>>>>>>>>>>>                            Move (iTokenPos + SizeOfArray(ucToken)) to parsedata.iChunkRead
29577>>>>>>>>>>>                        End
29577>>>>>>>>>>>>
29577>>>>>>>>>>>                        
29577>>>>>>>>>>>                        Function_Return iTokenPos
29578>>>>>>>>>>>                    End
29578>>>>>>>>>>>>
29578>>>>>>>>>>>                    
29578>>>>>>>>>>>                End
29578>>>>>>>>>>>>
29578>>>>>>>>>>>                
29578>>>>>>>>>>>                Move (iTokenPos + 1) to iRead
29579>>>>>>>>>>>            End
29579>>>>>>>>>>>>
29579>>>>>>>>>>>        Until (iTokenPos < 0 )
29581>>>>>>>>>>>        
29581>>>>>>>>>>>        Function_Return iTokenPos
29582>>>>>>>>>>>    End_Function

8557>>>>>>>>>    
8557>>>>>>>>>    Procedure DoCreate WString sFileName
8559>>>>>>>>>        DWord dwHandle
8559>>>>>>>>>        Integer iInfoSize iVerSize iSuccess iVersion iVoid iFlags
8559>>>>>>>>>        WString sData
8559>>>>>>>>>        tWinVs_FixedFileInfo VsFixedFileInfo
8559>>>>>>>>>        tWinVs_FixedFileInfo VsFixedFileInfo
8559>>>>>>>>>        WString sSubBlock
8559>>>>>>>>>        Pointer pVsFixedFileInfo
8559>>>>>>>>>        
8559>>>>>>>>>        Move 0 to pVsFixedFileInfo
8560>>>>>>>>>        Move 0 to dwHandle
8561>>>>>>>>>        Move 0 to iVerSize
8562>>>>>>>>>        
8562>>>>>>>>>        Move (GetFileVersionInfoSizeW(AddressOf(sFilename), AddressOf(dwHandle))) to iInfoSize
8563>>>>>>>>>        Set pbIncluded to (iInfoSize <>0)
8564>>>>>>>>>        
8564>>>>>>>>>        If (pbIncluded(Self)) Begin
8566>>>>>>>>>            Move (Repeat(Character(0), iInfoSize)) to sData
8567>>>>>>>>>            Move (GetFileVersionInfoW(AddressOf(sFilename), 0, iInfoSize, AddressOf(sData))) to iSuccess
8568>>>>>>>>>            
8568>>>>>>>>>            If (iSuccess <>0) Begin
8570>>>>>>>>>                Move "\" to sSubBlock
8571>>>>>>>>>                If (VerQueryValueW(AddressOf(sData), AddressOf(sSubBlock), AddressOf(pVsFixedFileInfo), AddressOf(iVerSize))) Begin
8573>>>>>>>>>                    Move (memcopy(AddressOf(VsFixedFileInfo), pVsFixedFileInfo, iVerSize)) to iVoid // copy the structure
8574>>>>>>>>>                    
8574>>>>>>>>>                    Move VsFixedFileInfo.dwFileVersionMS to iVersion
8575>>>>>>>>>                    Set piVersionMajor to (Hi(iVersion))
8576>>>>>>>>>                    Set piVersionMinor to (Low(iVersion))
8577>>>>>>>>>                    
8577>>>>>>>>>                    Move VsFixedFileInfo.dwFileVersionLS to iVersion
8578>>>>>>>>>                    Set piVersionRelease to (Hi(iVersion))
8579>>>>>>>>>                    Set piVersionBuild   to (Low(iVersion))
8580>>>>>>>>>                    
8580>>>>>>>>>                    Move VsFixedFileInfo.dwFileFlags to iFlags
8581>>>>>>>>>                    Set pbSpecialBuild    to (iFlags iand VS_FF_SPECIALBUILD)
8582>>>>>>>>>                    Set pbPrivateBuild    to (iFlags iand VS_FF_PRIVATEBUILD)
8583>>>>>>>>>                End
8583>>>>>>>>>>
8583>>>>>>>>>            End
8583>>>>>>>>>>
8583>>>>>>>>>            
8583>>>>>>>>>        End
8583>>>>>>>>>>
8583>>>>>>>>>    End_Procedure
8584>>>>>>>>>    
8584>>>>>>>>>End_Class

10171>>>>>>>>>        
10171>>>>>>>>>        tSQLColumn[] aSQLColumns
10171>>>>>>>>>        tSQLColumn[] aSQLColumns
10172>>>>>>>>>        
10172>>>>>>>>>        // Get the cli handles
10172>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10173>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10174>>>>>>>>>        Get psDriverId            to sDrvrId
10175>>>>>>>>>        
10175>>>>>>>>>        // Get the value
10175>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10177>>>>>>>>>            
10177>>>>>>>>>            Get paSQLColumns   to aSQLColumns
10178>>>>>>>>>            Move (SizeOfArray(aSQLColumns)) to iColumns
10179>>>>>>>>>            
10179>>>>>>>>>            If (iCol >= 1 and iCol <= iColumns) Begin
10181>>>>>>>>>                Move aSQLColumns[iCol].iVariableDataType to iVariableDataType
10182>>>>>>>>>            End
10182>>>>>>>>>>
10182>>>>>>>>>            Else Begin
10183>>>>>>>>>                Send StmtError CLIERR_SQLINVALID_COLUMN ("(Column number = " + String(iCol) + ")") "SQLColumnVariableDatatype"
10184>>>>>>>>>            End
10184>>>>>>>>>>
10184>>>>>>>>>        End
10184>>>>>>>>>>
10184>>>>>>>>>        Else Begin
10185>>>>>>>>>            Send HandleError ihstmt ihdbc sDrvrId "SQLColumnVariableDatatype"
10186>>>>>>>>>        End
10186>>>>>>>>>>
10186>>>>>>>>>        
10186>>>>>>>>>        Function_Return iVariableDataType
10187>>>>>>>>>    End_Function
10188>>>>>>>>>    
10188>>>>>>>>>    
10188>>>>>>>>>    // Return the value of a column in a fetched row of a given
10188>>>>>>>>>    // statement.
10188>>>>>>>>>    Function SQLColumnValue Integer iCol Returns String
10190>>>>>>>>>        Integer ihdbc
10190>>>>>>>>>        Integer ihstmt
10190>>>>>>>>>        String  sDrvrId sResult
10190>>>>>>>>>        Longptr pResultWStr
10190>>>>>>>>>        
10190>>>>>>>>>        Integer iVoid
10190>>>>>>>>>        Integer iColSize
10190>>>>>>>>>        Integer iColPrecision
10190>>>>>>>>>        String  sEmpty
10190>>>>>>>>>        Integer bLegalColumn
10190>>>>>>>>>        
10190>>>>>>>>>        // Initialize
10190>>>>>>>>>        Move "" to sResult
10191>>>>>>>>>        
10191>>>>>>>>>        // Get the cli handles
10191>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10192>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10193>>>>>>>>>        Get psDriverId            to sDrvrId
10194>>>>>>>>>        
10194>>>>>>>>>        // FUNC_SQLCOLUMNINFO will tell the driver which hdbc and hstmt to use
10194>>>>>>>>>        // in the next FUNC_SQLCOLUMNVALUE call.
10194>>>>>>>>>        // If hdbc and hstmt have not changed since the last call we don't have to set it.
10194>>>>>>>>>        If (ihstmt <> giLastSQLhstmt or ihdbc <> giLastSQLhdbc) Begin
10196>>>>>>>>>            // Setup function arguments
10196>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                Callback 0 ;                Passing ihdbc iCol ihstmt ;                Result iVoid
10201>>>>>>>>>            Move ihstmt to giLastSQLhstmt
10202>>>>>>>>>            Move ihdbc to giLastSQLhdbc
10203>>>>>>>>>        End
10203>>>>>>>>>>
10203>>>>>>>>>        
10203>>>>>>>>>        If (iCol >= 1 and iCol <= piColumnCount(Self)) Begin
10205>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNVALUE ;                Callback 0 ;                Passing sResult sEmpty iCol ;                Result pResultWStr
10210>>>>>>>>>            
10210>>>>>>>>>            If (pResultWStr) Begin
10212>>>>>>>>>                Move (PointerToWString(pResultWStr)) to sResult
10213>>>>>>>>>            End
10213>>>>>>>>>>
10213>>>>>>>>>            Else Begin
10214>>>>>>>>>                Move "" to sResult
10215>>>>>>>>>            End
10215>>>>>>>>>>
10215>>>>>>>>>        End
10215>>>>>>>>>>
10215>>>>>>>>>        Else Begin
10216>>>>>>>>>            Send StmtError CLIERR_SQLINVALID_COLUMN ("(Column number = " + String(iCol) + ")") "SQLColumnValue"
10217>>>>>>>>>        End
10217>>>>>>>>>>
10217>>>>>>>>>        
10217>>>>>>>>>        Function_Return sResult
10218>>>>>>>>>        
10218>>>>>>>>>    End_Function
10219>>>>>>>>>    
10219>>>>>>>>>    // Add a file to the files used to place the statement result in.
10219>>>>>>>>>    Procedure SQLBindFile Integer iFileNum
10221>>>>>>>>>        Integer ihdbc
10221>>>>>>>>>        Integer ihstmt
10221>>>>>>>>>        Integer iVoid
10221>>>>>>>>>        String  sDrvrId
10221>>>>>>>>>        String  sFileType
10221>>>>>>>>>        Integer bIsOpen
10221>>>>>>>>>        
10221>>>>>>>>>        // Get the cli handles
10221>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10222>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10223>>>>>>>>>        Get psDriverId            to sDrvrId
10224>>>>>>>>>        
10224>>>>>>>>>        // If a file number is not passed see if we can use the statement's
10224>>>>>>>>>        // default file number which is usually set with SetFileConnection
10224>>>>>>>>>        If (iFileNum = 0) Begin
10226>>>>>>>>>            Get piBindFile to iFileNum
10227>>>>>>>>>            If (iFileNum = 0) Begin
10229>>>>>>>>>                // Logic error, if 0 is passed as filenumber, piBindFile should be set.
10229>>>>>>>>>                Send StmtError CLIERR_SQLINVALID_BIND_FILE "piBindFile should be set" "SQLBindFile"
10230>>>>>>>>>                
10230>>>>>>>>>                Move 0 to SQLResult
10231>>>>>>>>>                Procedure_Return
10232>>>>>>>>>            End
10232>>>>>>>>>>
10232>>>>>>>>>        End
10232>>>>>>>>>>
10232>>>>>>>>>        
10232>>>>>>>>>        // Bind the file
10232>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10234>>>>>>>>>            // Chek if the file is open
10234>>>>>>>>>            Get_Attribute DF_FILE_OPENED of iFileNum to bIsOpen
10237>>>>>>>>>            If (bIsOpen) Begin
10239>>>>>>>>>                // Check if the file has the correct type
10239>>>>>>>>>                Get_Attribute DF_FILE_DRIVER of iFileNum to sFileType
10242>>>>>>>>>                If (sFileType = sDrvrId) Begin
10244>>>>>>>>>                    // Call the driver function to add a file to a statement
10244>>>>>>>>>                    Call_Driver 0 sDrvrId Function FUNC_SQLBINDFILE ;                        Callback Self ;                        Passing ihdbc iFileNum ihstmt ;                        Result iVoid
10249>>>>>>>>>                End
10249>>>>>>>>>>
10249>>>>>>>>>                Else ;                    Send StmtError CLIERR_SQLINVALID_BIND_FILE ("File" * String(iFileNum) * "type incompatible with statement ("  + sFileType + ")") "SQLBindFile"
10251>>>>>>>>>            End
10251>>>>>>>>>>
10251>>>>>>>>>            Else ;                Send StmtError CLIERR_SQLINVALID_BIND_FILE ("File not open (number =" * String(iFileNum) + ")") "SQLBindFile"
10253>>>>>>>>>        End
10253>>>>>>>>>>
10253>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLBindFile"
10255>>>>>>>>>    End_Procedure
10256>>>>>>>>>    
10256>>>>>>>>>    
10256>>>>>>>>>    
10256>>>>>>>>>    // Get data of a column.                                  
10256>>>>>>>>>    Function SQLGetData Integer iCol Integer iLen Returns String
10258>>>>>>>>>        Integer ihdbc
10258>>>>>>>>>        Integer ihstmt
10258>>>>>>>>>        Integer iVoid
10258>>>>>>>>>        Integer iColSize
10258>>>>>>>>>        Integer iResult
10258>>>>>>>>>        String  sDrvrId
10258>>>>>>>>>        WString wResult
10258>>>>>>>>>        String  sEmpty
10258>>>>>>>>>        Integer bLegalColumn
10258>>>>>>>>>        
10258>>>>>>>>>        Integer iVariableBufferLength
10258>>>>>>>>>        
10258>>>>>>>>>        // Initialize
10258>>>>>>>>>        Move "" to sEmpty
10259>>>>>>>>>        Move 0 to iResult
10260>>>>>>>>>        
10260>>>>>>>>>        // Get the cli handles
10260>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10261>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10262>>>>>>>>>        Get psDriverId            to sDrvrId
10263>>>>>>>>>        
10263>>>>>>>>>        // Get the data
10263>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10265>>>>>>>>>            // Check if the column exists
10265>>>>>>>>>            If (iCol >= 1 and iCol <= piColumnCount(Self)) Begin
10267>>>>>>>>>                If (iLen = 0) Begin
10269>>>>>>>>>                    Get SQLColumnValue iCol to wResult
10270>>>>>>>>>                End
10270>>>>>>>>>>
10270>>>>>>>>>                Else Begin
10271>>>>>>>>>                    // Add 1 for string terminator
10271>>>>>>>>>                    Move (iLen + 1) to iLen
10272>>>>>>>>>                    
10272>>>>>>>>>                    Get piVariableBufferLength to iVariableBufferLength
10273>>>>>>>>>                    If (iLen > iVariableBufferLength) Begin
10275>>>>>>>>>                        // Allocate
10275>>>>>>>>>                        Move (Repeat(' ', iLen)) to wResult
10276>>>>>>>>>                        
10276>>>>>>>>>                        Set piVariableBufferLength to iLen
10277>>>>>>>>>                        Set psVariableBuffer       to wResult
10278>>>>>>>>>                    End
10278>>>>>>>>>>
10278>>>>>>>>>                    Else Begin
10279>>>>>>>>>                        Get psVariableBuffer       to wResult
10280>>>>>>>>>                    End
10280>>>>>>>>>>
10280>>>>>>>>>                    
10280>>>>>>>>>                    
10280>>>>>>>>>                    // FUNC_SQLCOLUMNINFO will tell the driver which hdbc and hstmt to use
10280>>>>>>>>>                    // in the next FUNC_SQLCOLUMNVALUE call.
10280>>>>>>>>>                    // If hdbc and hstmt have not changed since the last call we don't have to set it.
10280>>>>>>>>>                    If (ihstmt <> giLastSQLhstmt or ihdbc <> giLastSQLhdbc) Begin
10282>>>>>>>>>                        // Setup function arguments
10282>>>>>>>>>                        Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                            Callback 0 ;                            Passing ihdbc iCol ihstmt ;                            Result iVoid
10287>>>>>>>>>                        Move ihstmt to giLastSQLhstmt
10288>>>>>>>>>                        Move ihdbc to giLastSQLhdbc
10289>>>>>>>>>                    End
10289>>>>>>>>>>
10289>>>>>>>>>                    
10289>>>>>>>>>                    Move False to Err
10290>>>>>>>>>                    // Call the driver function to get the data
10290>>>>>>>>>                    Call_Driver 0 sDrvrId Function FUNC_SQLGETDATA ;                        Callback Self ;                        Passing iCol iLen (AddressOf(wResult)) ;                        Result iResult
10295>>>>>>>>>                    
10295>>>>>>>>>                    // If something went wrong, adjust the result
10295>>>>>>>>>                    If (Err) Begin
10297>>>>>>>>>                        Move 0 to iResult
10298>>>>>>>>>                    End
10298>>>>>>>>>>
10298>>>>>>>>>                    
10298>>>>>>>>>                    // SQL_NO_TOTAL (-4) Not all data retrieved. Unknown how much is left. 
10298>>>>>>>>>                    If (iResult = -4) Begin
10300>>>>>>>>>                        Move (SizeOfWString(wResult)) to iResult
10301>>>>>>>>>                    End
10301>>>>>>>>>>
10301>>>>>>>>>                End
10301>>>>>>>>>>
10301>>>>>>>>>            End
10301>>>>>>>>>>
10301>>>>>>>>>            Else Begin
10302>>>>>>>>>                Send StmtError CLIERR_SQLINVALID_COLUMN ("(Column number = " + String(iCol) + ")") "SQLGetData"
10303>>>>>>>>>            End
10303>>>>>>>>>>
10303>>>>>>>>>        End
10303>>>>>>>>>>
10303>>>>>>>>>        Else Begin
10304>>>>>>>>>            Send HandleError ihstmt ihdbc sDrvrId "SQLGetData"
10305>>>>>>>>>        End
10305>>>>>>>>>>
10305>>>>>>>>>        
10305>>>>>>>>>        // Fill global result
10305>>>>>>>>>        If (iResult > 0) Begin
10307>>>>>>>>>            Move 1 to SQLResult // SQLResult == 1 : Something was found
10308>>>>>>>>>        End
10308>>>>>>>>>>
10308>>>>>>>>>        Else Begin
10309>>>>>>>>>           Move 0 to SQLResult // SQLResult == 0 : no (more) data found
10310>>>>>>>>>        End
10310>>>>>>>>>>
10310>>>>>>>>>        
10310>>>>>>>>>        Function_Return (CString(wResult))
10311>>>>>>>>>    End_Function
10312>>>>>>>>>
10312>>>>>>>>>    // SQLGetDataToUChar (SQLGetData returning uchar array)
10312>>>>>>>>>    // Use for binary data and for character data containing Unicode non-bmp characters
10312>>>>>>>>>    Function SQLGetDataToUChar Integer iCol Integer iLen Returns UChar[]
10314>>>>>>>>>        Integer ihdbc
10314>>>>>>>>>        Integer ihstmt
10314>>>>>>>>>        Integer iVoid
10314>>>>>>>>>        Integer iColSize
10314>>>>>>>>>        Integer iResult
10314>>>>>>>>>        String  sDrvrId
10314>>>>>>>>>        UChar[] uaResult
10315>>>>>>>>>        
10315>>>>>>>>>        Integer iSQLType
10315>>>>>>>>>        Integer iBinaryType
10315>>>>>>>>>        Integer iLenArray
10315>>>>>>>>>        Integer iResizeSize
10315>>>>>>>>>        
10315>>>>>>>>>        Move 0 to iResult
10316>>>>>>>>>        
10316>>>>>>>>>        // Get the cli handles
10316>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10317>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10318>>>>>>>>>        Get psDriverId            to sDrvrId
10319>>>>>>>>>        
10319>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10321>>>>>>>>>            // Check if the column exists
10321>>>>>>>>>            If (iCol >= 1 and iCol <= piColumnCount(Self)) Begin
10323>>>>>>>>>                            
10323>>>>>>>>>                Get SQLColumnType iCol to iSQLType
10324>>>>>>>>>                If ( (iSQLType = SQL_BINARY) or (iSQLType = SQL_VARBINARY) or (iSQLType = SQL_LONGVARBINARY) ) Begin
10326>>>>>>>>>                    Move 1 to iBinaryType
10327>>>>>>>>>                End
10327>>>>>>>>>>
10327>>>>>>>>>                Else Begin
10328>>>>>>>>>                    Move 0 to iBinaryType 
10329>>>>>>>>>                End
10329>>>>>>>>>>
10329>>>>>>>>>    
10329>>>>>>>>>                If (iBinaryType) Begin
10331>>>>>>>>>                    Move (ResizeArray(uaResult,iLen)) to uaResult
10332>>>>>>>>>                End
10332>>>>>>>>>>
10332>>>>>>>>>                Else Begin
10333>>>>>>>>>                    // Character type
10333>>>>>>>>>                    // returned as wstring (2 bytes per character)
10333>>>>>>>>>                    // Add 1 for string terminator
10333>>>>>>>>>                    Move (iLen + 1) to iLen
10334>>>>>>>>>                    Move (iLen * 2) to iLenArray // wstring 2 bytes per char
10335>>>>>>>>>                    Move (ResizeArray(uaResult,iLenArray)) to uaResult
10336>>>>>>>>>                End
10336>>>>>>>>>>
10336>>>>>>>>>
10336>>>>>>>>>                // FUNC_SQLCOLUMNINFO will tell the driver which hdbc and hstmt to use
10336>>>>>>>>>                // in the next FUNC_SQLCOLUMNVALUE call.
10336>>>>>>>>>                If (ihstmt <> giLastSQLhstmt or ihdbc <> giLastSQLhdbc) Begin
10338>>>>>>>>>                    // Setup function arguments
10338>>>>>>>>>                    Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                        Callback 0 ;                        Passing ihdbc iCol ihstmt ;                        Result iVoid
10343>>>>>>>>>                    Move ihstmt to giLastSQLhstmt
10344>>>>>>>>>                    Move ihdbc to giLastSQLhdbc
10345>>>>>>>>>                End
10345>>>>>>>>>>
10345>>>>>>>>>                
10345>>>>>>>>>                Move False to Err
10346>>>>>>>>>                
10346>>>>>>>>>                // Call the driver function to get the data
10346>>>>>>>>>                // iResult will be the length of the data in bytes 
10346>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLGETDATA ;                    Callback Self ;                    Passing iCol iLen (AddressOf(uaResult[0])) ;                    Result iResult
10351>>>>>>>>>                
10351>>>>>>>>>                // If something went wrong, adjust the result
10351>>>>>>>>>                If (Err) Begin
10353>>>>>>>>>                    Move 0 to iResult
10354>>>>>>>>>                End
10354>>>>>>>>>>
10354>>>>>>>>>                
10354>>>>>>>>>                // SQL_NO_TOTAL (-4) Not all data retrieved. Unknown how much is left. 
10354>>>>>>>>>                If (iResult = -4) Begin
10356>>>>>>>>>                    Move (SizeOfArray(uaResult)) to iResult
10357>>>>>>>>>                End
10357>>>>>>>>>>
10357>>>>>>>>>                
10357>>>>>>>>>                If (iBinaryType) Begin
10359>>>>>>>>>                    If (iResult < iLen) Begin
10361>>>>>>>>>                        Move (ResizeArray(uaResult,iResult)) to uaResult
10362>>>>>>>>>                    End
10362>>>>>>>>>>
10362>>>>>>>>>                End
10362>>>>>>>>>>
10362>>>>>>>>>                Else Begin
10363>>>>>>>>>                    // Character data
10363>>>>>>>>>                    //   iResult has length of data in bytes (without zero terminator)
10363>>>>>>>>>                    //   uaResult will have data + zero terminator
10363>>>>>>>>>                    If (iResult < (iLenArray - 2) ) Begin
10365>>>>>>>>>                        // Received less than requested, strip off trailing zeroes.
10365>>>>>>>>>                        Move iResult to iResizeSize
10366>>>>>>>>>                    End
10366>>>>>>>>>>
10366>>>>>>>>>                    Else Begin
10367>>>>>>>>>                        // Strip off zero terminator
10367>>>>>>>>>                        Move (iLenArray - 2) to iResizeSize
10368>>>>>>>>>                    End
10368>>>>>>>>>>
10368>>>>>>>>>                    
10368>>>>>>>>>                    Move (ResizeArray(uaResult,iResizeSize)) to uaResult
10369>>>>>>>>>                    
10369>>>>>>>>>                End
10369>>>>>>>>>>
10369>>>>>>>>>            End
10369>>>>>>>>>>
10369>>>>>>>>>            Else Begin
10370>>>>>>>>>                Send StmtError CLIERR_SQLINVALID_COLUMN ("(Column number = " + String(iCol) + ")") "SQLGetData"
10371>>>>>>>>>            End
10371>>>>>>>>>>
10371>>>>>>>>>        End
10371>>>>>>>>>>
10371>>>>>>>>>        Else Begin
10372>>>>>>>>>            Send HandleError ihstmt ihdbc sDrvrId "SQLGetData"
10373>>>>>>>>>        End
10373>>>>>>>>>>
10373>>>>>>>>>        
10373>>>>>>>>>        // Fill global result
10373>>>>>>>>>        If (iResult > 0) Begin
10375>>>>>>>>>            Move 1 to SQLResult // SQLResult == 1 : Something was found
10376>>>>>>>>>        End
10376>>>>>>>>>>
10376>>>>>>>>>        Else Begin
10377>>>>>>>>>           Move 0 to SQLResult // SQLResult == 0 : no (more) data found
10378>>>>>>>>>        End
10378>>>>>>>>>>
10378>>>>>>>>>        
10378>>>>>>>>>        Function_Return uaResult
10379>>>>>>>>>
10379>>>>>>>>>    End_Function
10380>>>>>>>>>    
10380>>>>>>>>>    
10380>>>>>>>>>    // Map a column name to a number, if the name id not found no
10380>>>>>>>>>    // error is generated the returned number will be 0 (zero) in
10380>>>>>>>>>    // that case
10380>>>>>>>>>    Function SQLColumnMap String sColname Returns Integer
10382>>>>>>>>>        Integer ihdbc
10382>>>>>>>>>        Integer ihstmt
10382>>>>>>>>>        Integer iNumColumns
10382>>>>>>>>>        Integer iColCount
10382>>>>>>>>>        Integer iColNum
10382>>>>>>>>>        String  sDrvrId
10382>>>>>>>>>        String  sCurColName
10382>>>>>>>>>        
10382>>>>>>>>>        // Get the cli handles
10382>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10383>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10384>>>>>>>>>        Get psDriverId            to sDrvrId
10385>>>>>>>>>        
10385>>>>>>>>>        // Get the number by looping through the column names
10385>>>>>>>>>        Move 0 to iColNum
10386>>>>>>>>>        Get SQLPrivateStmtAttribute SQLSTMTATTRIB_COLUMNCOUNT ihdbc sDrvrId ihstmt to iNumColumns
10387>>>>>>>>>        For iColCount from 1 to iNumColumns
10393>>>>>>>>>>
10393>>>>>>>>>            Get SQLPrivateColAttribute iColCount SQLCOLATTRIB_LABEL ihdbc sDrvrId ihstmt to sCurColName
10394>>>>>>>>>            If (Uppercase(Trim(sColName)) = Uppercase(Trim(sCurColName))) ;                Move iColCount to iColNum
10397>>>>>>>>>            
10397>>>>>>>>>            If (iColNum) ;                Break
10400>>>>>>>>>        Loop
10401>>>>>>>>>>
10401>>>>>>>>>        
10401>>>>>>>>>        Function_Return iColNum
10402>>>>>>>>>    End_Function
10403>>>>>>>>>    
10403>>>>>>>>>    
10403>>>>>>>>>    // SQLStmtAttribute
10403>>>>>>>>>    // Moved to SQLGetStatementAttribute. 
10403>>>>>>>>>    // This function is still here for backward compatibility.
10403>>>>>>>>>
10403>>>>>>>>>    Function SQLStmtAttribute Integer iAttribId Returns String
10405>>>>>>>>>        String  sResult
10405>>>>>>>>>
10405>>>>>>>>>        Get SQLGetStmtAttribute iAttribId to sResult        
10406>>>>>>>>>        
10406>>>>>>>>>        Function_Return sResult
10407>>>>>>>>>    End_Function
10408>>>>>>>>>
10408>>>>>>>>> 
10408>>>>>>>>>   Function SQLGetStmtAttribute Integer iAttribId Returns String
10410>>>>>>>>>        Integer ihdbc
10410>>>>>>>>>        Integer ihstmt
10410>>>>>>>>>        String  sResult
10410>>>>>>>>>        String  sDrvrId
10410>>>>>>>>>        
10410>>>>>>>>>        // Initialize
10410>>>>>>>>>        Move "" to sResult
10411>>>>>>>>>        
10411>>>>>>>>>        // Get the cli handles
10411>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10412>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10413>>>>>>>>>        Get psDriverId            to sDrvrId
10414>>>>>>>>>        
10414>>>>>>>>>        // Get the attribute
10414>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") ;            Get SQLPrivateStmtAttribute iAttribId ihdbc sDrvrId ihstmt to sResult
10417>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLGetStmtAttribute"
10419>>>>>>>>>        
10419>>>>>>>>>        Function_Return sResult
10420>>>>>>>>>    End_Function
10421>>>>>>>>>
10421>>>>>>>>>    
10421>>>>>>>>>    Procedure SQLSetStmtAttribute Integer iAttribId String sAttribValue 
10423>>>>>>>>>
10423>>>>>>>>>        Integer ihdbc
10423>>>>>>>>>        Integer ihstmt
10423>>>>>>>>>        String  sDrvrId
10423>>>>>>>>>        
10423>>>>>>>>>        Integer iLen
10423>>>>>>>>>        Integer bLegalAttrib
10423>>>>>>>>>        Integer iVoid
10423>>>>>>>>>        Integer iAttribValue
10423>>>>>>>>>
10423>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10424>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10425>>>>>>>>>        Get psDriverId            to sDrvrId
10426>>>>>>>>>        
10426>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10428>>>>>>>>>            Case Begin
10428>>>>>>>>>                Case (iAttribId = SQLSTMTATTRIB_CURSOR_TYPE)
10430>>>>>>>>>                    Move DFTRUE to bLegalAttrib
10431>>>>>>>>>                    Break
10432>>>>>>>>>                    
10432>>>>>>>>>                Case Else
10432>>>>>>>>>                    Move DFFALSE to bLegalAttrib
10433>>>>>>>>>                    Send SQLIllegalAttribute ("Attribute is = " + String(iAttribId) + ")") "SQLSetStmtAttribute"
10434>>>>>>>>>            Case End
10434>>>>>>>>>
10434>>>>>>>>>            If (bLegalAttrib) Begin
10436>>>>>>>>>                If (iAttribId = SQLSTMTATTRIB_CURSOR_TYPE) Begin
10438>>>>>>>>>                    
10438>>>>>>>>>                    Move sAttribValue to iAttribValue // Check numeric?
10439>>>>>>>>>                    Case Begin
10439>>>>>>>>>                        Case (iAttribValue = SQL_CURSOR_FORWARD_ONLY)
10441>>>>>>>>>                        Case (iAttribValue = SQL_CURSOR_DYNAMIC)
10444>>>>>>>>>                        Case (iAttribValue = SQL_CURSOR_KEYSET_DRIVEN)
10447>>>>>>>>>                        Case (iAttribValue = SQL_CURSOR_STATIC)
10450>>>>>>>>>                            Break
10451>>>>>>>>>                            
10451>>>>>>>>>                        Case Else
10451>>>>>>>>>                            Move DFFALSE to bLegalAttrib
10452>>>>>>>>>                            Send StmtError CLIERR_SQLINVALID_ATTRIBUTE (SFormat("Invalid value for SQLSTMTATTRIB_CURSOR_TYPE: %1", iAttribValue)) "SQLSetStmtAttribute"
10453>>>>>>>>>
10453>>>>>>>>>                    Case End
10453>>>>>>>>>                End
10453>>>>>>>>>>
10453>>>>>>>>>            End
10453>>>>>>>>>>
10453>>>>>>>>>
10453>>>>>>>>>            
10453>>>>>>>>>            If (bLegalAttrib) Begin
10455>>>>>>>>>                
10455>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                    Callback Self ;                    Passing ihdbc iVoid ihstmt ;                    Result iVoid
10460>>>>>>>>>                
10460>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLSETSTMTINTATTRIB ;                    Callback Self ;                    Passing iAttribId iAttribValue 0 ;                    Result iVoid
10465>>>>>>>>>            End
10465>>>>>>>>>>
10465>>>>>>>>>        End
10465>>>>>>>>>>
10465>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLPrivateStmtAttribute"
10467>>>>>>>>>        
10467>>>>>>>>>        
10467>>>>>>>>>        
10467>>>>>>>>>    End_Procedure
10468>>>>>>>>>    
10468>>>>>>>>>    
10468>>>>>>>>>    
10468>>>>>>>>>    Function SQLPrivateStmtAttribute Integer iAttribId Integer ihdbc String sDrvrId Integer ihstmt Returns String
10470>>>>>>>>>        String  sResult
10470>>>>>>>>>        Integer iLen
10470>>>>>>>>>        Integer bLegalAttrib
10470>>>>>>>>>        
10470>>>>>>>>>        // Initialize
10470>>>>>>>>>        Move ""     to sResult
10471>>>>>>>>>        
10471>>>>>>>>>        // Get the attribute
10471>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10473>>>>>>>>>            Case Begin
10473>>>>>>>>>                Case (iAttribId = SQLSTMTATTRIB_COLUMNCOUNT)
10475>>>>>>>>>                Case (iAttribId = SQLSTMTATTRIB_ROWCOUNT)
10478>>>>>>>>>                Case (iAttribId = SQLSTMTATTRIB_ROWCOUNT_TYPE)
10481>>>>>>>>>                Case (iAttribId = SQLSTMTATTRIB_NUMMESSAGES)
10484>>>>>>>>>                Case (iAttribId = SQLSTMTATTRIB_CURSOR_TYPE)
10487>>>>>>>>>                    Move DFTRUE to bLegalAttrib
10488>>>>>>>>>                    Break
10489>>>>>>>>>                    
10489>>>>>>>>>                Case Else
10489>>>>>>>>>                    Move DFFALSE to bLegalAttrib
10490>>>>>>>>>                    Send SQLIllegalAttribute ("Attribute is = " + String(iAttribId) + ")") "SQLPrivateStmtAttribute"
10491>>>>>>>>>            Case End
10491>>>>>>>>>            
10491>>>>>>>>>            If (bLegalAttrib) Begin
10493>>>>>>>>>                // Setup function arguments
10493>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLSTMTINTATTRIB ;                    Callback Self ;                    Passing ihdbc iAttribId ihstmt ;                    Result sResult
10498>>>>>>>>>            End
10498>>>>>>>>>>
10498>>>>>>>>>        End
10498>>>>>>>>>>
10498>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLPrivateStmtAttribute"
10500>>>>>>>>>        
10500>>>>>>>>>        Function_Return sResult
10501>>>>>>>>>    End_Function
10502>>>>>>>>>    
10502>>>>>>>>>    
10502>>>>>>>>>    
10502>>>>>>>>>    // Get a column's attribute
10502>>>>>>>>>    Function SQLColAttribute Integer iCol Integer iAttribId Returns String
10504>>>>>>>>>        Integer ihdbc
10504>>>>>>>>>        Integer ihstmt
10504>>>>>>>>>        String  sResult
10504>>>>>>>>>        String  sDrvrId
10504>>>>>>>>>        
10504>>>>>>>>>        // Initialize
10504>>>>>>>>>        Move "" to sResult
10505>>>>>>>>>        
10505>>>>>>>>>        // Get the cli handles
10505>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10506>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10507>>>>>>>>>        Get psDriverId            to sDrvrId
10508>>>>>>>>>        
10508>>>>>>>>>        // Get the attribute
10508>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") ;            Get SQLPrivateColAttribute iCol iAttribId ihdbc sDrvrId ihstmt to sResult
10511>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLColAttribute"
10513>>>>>>>>>        
10513>>>>>>>>>        Function_Return sResult
10514>>>>>>>>>    End_Function
10515>>>>>>>>>    
10515>>>>>>>>>    Function SQLPrivateColAttribute Integer iCol Integer iAttribId Integer ihdbc String sDrvrId Integer ihstmt Returns String
10517>>>>>>>>>        String  sResult
10517>>>>>>>>>        String  sEmpty
10517>>>>>>>>>        Integer bIsStringAttribute
10517>>>>>>>>>        Integer iLen
10517>>>>>>>>>        Integer iVoid
10517>>>>>>>>>        Integer bLegalAttrib
10517>>>>>>>>>        Integer bLegalColumn
10517>>>>>>>>>        
10517>>>>>>>>>        // Initialize
10517>>>>>>>>>        Move "" to sResult
10518>>>>>>>>>        Move "" to sEmpty
10519>>>>>>>>>        Move 0  to iLen
10520>>>>>>>>>        
10520>>>>>>>>>        // Get the attribute
10520>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10522>>>>>>>>>            Get SQLPrivateColumnIsLegal ihdbc sDrvrId ihstmt iCol to bLegalColumn
10523>>>>>>>>>            If (bLegalColumn) Begin
10525>>>>>>>>>                // Determine the atributes type
10525>>>>>>>>>                Case Begin
10525>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_SIZE)
10527>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_LENGTH)
10530>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_PRECISION)
10533>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_SQLTYPE)
10536>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_NULLABLE)
10539>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_DFTYPE)
10542>>>>>>>>>                        Move DFFALSE to bIsStringAttribute
10543>>>>>>>>>                        Move DFTRUE to bLegalAttrib
10544>>>>>>>>>                        Break
10545>>>>>>>>>                        
10545>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_LABEL)
10548>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_BASECOLUMNNAME)
10551>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_BASETABLENAME)
10554>>>>>>>>>                        Move DFTRUE to bIsStringAttribute
10555>>>>>>>>>                        Move DFTRUE to bLegalAttrib
10556>>>>>>>>>                        Break
10557>>>>>>>>>                        
10557>>>>>>>>>                    Case Else
10557>>>>>>>>>                        Move DFFALSE to bLegalAttrib
10558>>>>>>>>>                        Send SQLIllegalAttribute ("Attribute is = " + String(iAttribId) + ")") "SQLPrivateColAttribute"
10559>>>>>>>>>                Case End
10559>>>>>>>>>                
10559>>>>>>>>>                If (bLegalAttrib) Begin
10561>>>>>>>>>                    // Setup function arguments
10561>>>>>>>>>                    Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                        Callback Self ;                        Passing ihdbc iCol ihstmt ;                        Result iVoid
10566>>>>>>>>>                    
10566>>>>>>>>>                    If (bIsStringAttribute) Begin
10568>>>>>>>>>                        // Call the driver function to get the data length
10568>>>>>>>>>                        Call_Driver 0 sDrvrId Function FUNC_SQLCOLSTRINGATTRIBLEN ;                            Callback Self ;                            Passing sEmpty sEmpty iAttribId ;                            Result iLen
10573>>>>>>>>>                        
10573>>>>>>>>>                        If (iLen) Begin
10575>>>>>>>>>                            // Allocate
10575>>>>>>>>>                            Move (Repeat(' ', iLen)) to sResult
10576>>>>>>>>>                            
10576>>>>>>>>>                            // Call the driver function to get the name
10576>>>>>>>>>                            Call_Driver 0 sDrvrId Function FUNC_SQLCOLSTRINGATTRIB ;                                Callback Self ;                                Passing sResult sEmpty iAttribId ;                                Result iVoid
10581>>>>>>>>>                        End
10581>>>>>>>>>>
10581>>>>>>>>>                    End
10581>>>>>>>>>>
10581>>>>>>>>>                    Else Begin
10582>>>>>>>>>                        // get the attribute
10582>>>>>>>>>                        Call_Driver 0 sDrvrId Function FUNC_SQLCOLINTATTRIB ;                            Callback Self ;                            Passing sEmpty sEmpty iAttribId ;                            Result sResult
10587>>>>>>>>>                    End
10587>>>>>>>>>>
10587>>>>>>>>>                End
10587>>>>>>>>>>
10587>>>>>>>>>            End
10587>>>>>>>>>>
10587>>>>>>>>>            Else ;                Send StmtError CLIERR_SQLINVALID_COLUMN ("(Column number = " + String(iCol) + ")") "SQLPrivateColAttribute"
10589>>>>>>>>>        End
10589>>>>>>>>>>
10589>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLPrivateColAttribute"
10591>>>>>>>>>        
10591>>>>>>>>>        Function_Return sResult
10592>>>>>>>>>    End_Function
10593>>>>>>>>>    
10593>>>>>>>>>    
10593>>>>>>>>>    // Preapre for calling a stored procedure, pass the procedure name.
10593>>>>>>>>>    Procedure SQLSetProcedureName String sProcName String sSchemaArg
10595>>>>>>>>>        Integer ihdbc

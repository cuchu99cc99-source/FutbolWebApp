198>>>>>>>>>>>>>>>>>// Unicode.pkg
198>>>>>>>>>>>>>>>>>// Author: JDF
198>>>>>>>>>>>>>>>>>
198>>>>>>>>>>>>>>>>>       
198>>>>>>>>>>>>>>>>>//  Unicode UTF-16 text wrapper to provide the interface between the DataFlex strings (UTF-8) and Windows Wide strings (UTF-16)
198>>>>>>>>>>>>>>>>>Struct UWide
198>>>>>>>>>>>>>>>>>    WString sWide   // This is the source of the text
198>>>>>>>>>>>>>>>>>    Pointer lpUText // Pointer to UText
198>>>>>>>>>>>>>>>>>    Integer Size    // Size of UText in bytes
198>>>>>>>>>>>>>>>>>    Pointer lpSize  // Pointer to Size
198>>>>>>>>>>>>>>>>>End_Struct
198>>>>>>>>>>>>>>>>>
198>>>>>>>>>>>>>>>>>//  Fills a UWide text wrapper from a UTF-8 string and converts it to UTF-16 internal (null terminated)
198>>>>>>>>>>>>>>>>>//  lpszString points to the UTF-8 string (null terminated)
198>>>>>>>>>>>>>>>>>//  pUWide holds the reference to the UWide text wrapper 
198>>>>>>>>>>>>>>>>>//
198>>>>>>>>>>>>>>>>>Procedure StringToWide Global Pointer lpszString UWide ByRef pUWide  
200>>>>>>>>>>>>>>>>>    If (lpszString <> 0) Begin
202>>>>>>>>>>>>>>>>>        Move (PointerToString(lpszString)) to pUWide.sWide
203>>>>>>>>>>>>>>>>>        Move (SizeOfWString(pUWide.sWide) * 2) to pUWide.Size
204>>>>>>>>>>>>>>>>>        
204>>>>>>>>>>>>>>>>>        Move (AddressOf(pUWide.Size)) to pUWide.lpSize 
205>>>>>>>>>>>>>>>>>        Move (AddressOf(pUWide.sWide)) to pUWide.lpUText      
206>>>>>>>>>>>>>>>>>    End
206>>>>>>>>>>>>>>>>>>
206>>>>>>>>>>>>>>>>>    Else Begin
207>>>>>>>>>>>>>>>>>        Move 0 to pUWide.Size            
208>>>>>>>>>>>>>>>>>        Move (AddressOf(pUWide.Size)) to pUWide.lpSize
209>>>>>>>>>>>>>>>>>        Move lpszString to pUWide.lpUtext 
210>>>>>>>>>>>>>>>>>    End
210>>>>>>>>>>>>>>>>>>
210>>>>>>>>>>>>>>>>>End_Procedure
211>>>>>>>>>>>>>>>>> 
211>>>>>>>>>>>>>>>>>Function StringToWide Global Pointer lpszString UWide ByRef pUWide Returns Pointer    
213>>>>>>>>>>>>>>>>>    If (lpszString <> 0) Begin
215>>>>>>>>>>>>>>>>>        Move (PointerToString(lpszString)) to pUWide.sWide
216>>>>>>>>>>>>>>>>>        Move (SizeOfWString(pUWide.sWide) * 2) to pUWide.Size
217>>>>>>>>>>>>>>>>>        
217>>>>>>>>>>>>>>>>>        Move (AddressOf(pUWide.Size)) to pUWide.lpSize
218>>>>>>>>>>>>>>>>>        Move (AddressOf(pUWide.sWide)) to pUWide.lpUtext       
219>>>>>>>>>>>>>>>>>    End
219>>>>>>>>>>>>>>>>>>
219>>>>>>>>>>>>>>>>>    Else Begin
220>>>>>>>>>>>>>>>>>        Move 0 to pUWide.Size
221>>>>>>>>>>>>>>>>>        Move (AddressOf(pUWide.Size)) to pUWide.lpSize            
222>>>>>>>>>>>>>>>>>        Move lpszString to pUWide.lpUtext 
223>>>>>>>>>>>>>>>>>    End
223>>>>>>>>>>>>>>>>>>
223>>>>>>>>>>>>>>>>>    
223>>>>>>>>>>>>>>>>>    Function_Return pUWide.lpUtext
224>>>>>>>>>>>>>>>>>End_Function
225>>>>>>>>>>>>>>>>>
225>>>>>>>>>>>>>>>>>
225>>>>>>>>>>>>>>>>>//  Copys the Context of a UWide text wrapper to a UTF-8 string (null terminated)
225>>>>>>>>>>>>>>>>>//  pUWide holds the reference to the UWide text wrapper
225>>>>>>>>>>>>>>>>>//  lpszString points to the UTF-8 string
225>>>>>>>>>>>>>>>>>//
225>>>>>>>>>>>>>>>>>Procedure WideToString Global UWide ByRef pUWide Pointer lpszString  
227>>>>>>>>>>>>>>>>>    Boolean bOK
227>>>>>>>>>>>>>>>>>    String sNarrow
227>>>>>>>>>>>>>>>>>    Integer iVoid
227>>>>>>>>>>>>>>>>>    
227>>>>>>>>>>>>>>>>>    If (lpszString <> 0) Begin    
229>>>>>>>>>>>>>>>>>        If (pUWide.lpUtext <> 0) Begin
231>>>>>>>>>>>>>>>>>            Move pUWide.sWide to sNarrow
232>>>>>>>>>>>>>>>>>            Move (MemCopy(lpszString, AddressOf(sNarrow), SizeOfString(sNarrow))) to iVoid            
233>>>>>>>>>>>>>>>>>        End
233>>>>>>>>>>>>>>>>>>
233>>>>>>>>>>>>>>>>>    End
233>>>>>>>>>>>>>>>>>>
233>>>>>>>>>>>>>>>>>End_Procedure
234>>>>>>>>>>>>>>>>>
234>>>>>>>>>>>>>>>>>Function WideToString Global UWide ByRef pUWide Returns String
236>>>>>>>>>>>>>>>>>    Function_Return pUWide.sWide
237>>>>>>>>>>>>>>>>>End_Function
238>>>>>>>>>>>>>>>>>
238>>>>>>>>>>>>>>>>>//  Copys the Context of a UWide text wrapper to a UTF-8 string (null terminated)
238>>>>>>>>>>>>>>>>>//  pUWide holds the reference to the UWide text wrapper
238>>>>>>>>>>>>>>>>>//  lpszString points to the UTF-8 string
238>>>>>>>>>>>>>>>>>//  iSize holds the number of CHARACTERS to process (-1 for a null terminated string)
238>>>>>>>>>>>>>>>>>//
238>>>>>>>>>>>>>>>>>Procedure WideToStringSized Global UWide ByRef pUWide Pointer lpszString Integer iSize 
240>>>>>>>>>>>>>>>>>    String sResult
240>>>>>>>>>>>>>>>>>    Boolean bOK
240>>>>>>>>>>>>>>>>>
240>>>>>>>>>>>>>>>>>    If (lpszString <> 0) Begin    
242>>>>>>>>>>>>>>>>>        If (pUWide.lpUtext <> 0) Begin
244>>>>>>>>>>>>>>>>>            Move (PointerToWString(pUWide.lpUtext)) to sResult
245>>>>>>>>>>>>>>>>>            If (iSize >= 0) ;                Move (Left(sResult, iSize)) to sResult
248>>>>>>>>>>>>>>>>>                
248>>>>>>>>>>>>>>>>>            Move (MemCopy(lpszString, AddressOf(sResult), SizEOfString(sResult))) to bOK
249>>>>>>>>>>>>>>>>>        End
249>>>>>>>>>>>>>>>>>>
249>>>>>>>>>>>>>>>>>    End
249>>>>>>>>>>>>>>>>>>
249>>>>>>>>>>>>>>>>>End_Procedure
250>>>>>>>>>>>>>>>>>
250>>>>>>>>>>>>>>>>>Function WideToStringSized Global UWide ByRef pUWide Integer iSize Returns String
252>>>>>>>>>>>>>>>>>    String sResult
252>>>>>>>>>>>>>>>>>
252>>>>>>>>>>>>>>>>>    Move "" to sResult
253>>>>>>>>>>>>>>>>>    If (pUWide.lpUtext <> 0) Begin
255>>>>>>>>>>>>>>>>>        Move (PointerToWString(pUWide.lpUtext)) to sResult
256>>>>>>>>>>>>>>>>>        If (iSize >= 0) ;            Move (Left(sResult, iSize)) to sResult
259>>>>>>>>>>>>>>>>>    End
259>>>>>>>>>>>>>>>>>>
259>>>>>>>>>>>>>>>>>
259>>>>>>>>>>>>>>>>>    Function_Return sResult
260>>>>>>>>>>>>>>>>>End_Function
261>>>>>>>>>>>>>>>>>
261>>>>>>>>>>>>>>>>>
261>>>>>>>>>>>>>>>>>//  Initializes a UWide text wrapper to funtion as UTF-16 receive buffer
261>>>>>>>>>>>>>>>>>//  lpBuffer points to the receiving buffer
261>>>>>>>>>>>>>>>>>//  lpSize points to a variable holding the size of the buffer
261>>>>>>>>>>>>>>>>>//  pUWide holds the reference to the UWide text wrapper 
261>>>>>>>>>>>>>>>>>//
261>>>>>>>>>>>>>>>>>Procedure WideSetBuffer Global Pointer lpBuffer Pointer lpSize UWide ByRef pUWide  
263>>>>>>>>>>>>>>>>>    DWord dwSize
263>>>>>>>>>>>>>>>>>    
263>>>>>>>>>>>>>>>>>    If ((lpBuffer <> 0) and (lpSize <> 0)) Begin
265>>>>>>>>>>>>>>>>>        Move ((DeRefDW(lpSize, 0))) to dwSize
266>>>>>>>>>>>>>>>>>        Move (Repeat(" ", dwSize)) to pUWide.sWide
267>>>>>>>>>>>>>>>>>        Move (dwSize * 2) to pUWide.Size
268>>>>>>>>>>>>>>>>>        Move (AddressOf(pUWide.Size)) to pUWide.lpSize
269>>>>>>>>>>>>>>>>>        Move (AddressOf  (pUWide.sWide)) to pUWide.lpUtext 
270>>>>>>>>>>>>>>>>>    End
270>>>>>>>>>>>>>>>>>>
270>>>>>>>>>>>>>>>>>    Else Begin
271>>>>>>>>>>>>>>>>>        Move 0 to pUWide.Size
272>>>>>>>>>>>>>>>>>        Move (AddressOf(pUWide.Size)) to pUWide.lpSize            
273>>>>>>>>>>>>>>>>>        Move lpBuffer to pUWide.lpUtext 
274>>>>>>>>>>>>>>>>>    End        
274>>>>>>>>>>>>>>>>>>
274>>>>>>>>>>>>>>>>>End_Procedure
275>>>>>>>>>>>>>>>>>
275>>>>>>>>>>>>>>>>>Function WideSetBuffer Global Pointer lpBuffer Pointer lpSize UWide ByRef pUWide Returns Pointer
277>>>>>>>>>>>>>>>>>    DWord dwSize
277>>>>>>>>>>>>>>>>>    
277>>>>>>>>>>>>>>>>>    If ((lpBuffer <> 0) and (lpSize <> 0)) Begin
279>>>>>>>>>>>>>>>>>        Move ((DeRefDW(lpSize, 0)) * 2) to dwSize
280>>>>>>>>>>>>>>>>>        Move (Repeat(" ", dwSize)) to pUWide.sWide
281>>>>>>>>>>>>>>>>>        Move (dwSize * 2) to pUWide.Size
282>>>>>>>>>>>>>>>>>        Move (AddressOf(pUWide.Size)) to pUWide.lpSize
283>>>>>>>>>>>>>>>>>        Move (AddressOf  (pUWide.sWide)) to pUWide.lpUtext 
284>>>>>>>>>>>>>>>>>    End
284>>>>>>>>>>>>>>>>>>
284>>>>>>>>>>>>>>>>>    Else Begin
285>>>>>>>>>>>>>>>>>        Move 0 to pUWide.Size
286>>>>>>>>>>>>>>>>>        Move (AddressOf(pUWide.Size)) to pUWide.lpSize            
287>>>>>>>>>>>>>>>>>        Move lpBuffer to pUWide.lpUtext 
288>>>>>>>>>>>>>>>>>    End     
288>>>>>>>>>>>>>>>>>>
288>>>>>>>>>>>>>>>>>    
288>>>>>>>>>>>>>>>>>    Function_Return pUWide.lpUtext
289>>>>>>>>>>>>>>>>>End_Function

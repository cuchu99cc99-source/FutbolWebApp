9266>>>>>>>>>    // Convert a DataFlex date to a SQL date using the dummy zero date value.
9266>>>>>>>>>    //
9266>>>>>>>>>    Function CLIDFDateToSQLDate String sDriver Date dDFDate Returns String
9268>>>>>>>>>        
9268>>>>>>>>>        Integer iDriverIndex
9268>>>>>>>>>        
9268>>>>>>>>>        String sSQLDate
9268>>>>>>>>>        Integer iOrgDateFmt
9268>>>>>>>>>        Integer iOrgDateSep
9268>>>>>>>>>        
9268>>>>>>>>>        // Change date format to military, SQL dates are military dates
9268>>>>>>>>>        Get_Attribute DF_DATE_FORMAT to iOrgDateFmt
9271>>>>>>>>>        Get_Attribute DF_DATE_SEPARATOR to iOrgDateSep
9274>>>>>>>>>        Set_Attribute DF_DATE_FORMAT to DF_DATE_MILITARY
9277>>>>>>>>>        Set_Attribute DF_DATE_SEPARATOR to (Ascii('-'))
9280>>>>>>>>>        
9280>>>>>>>>>        If (Integer(dDFDate) = 0) Begin
9282>>>>>>>>>            // Return the dummy zero date
9282>>>>>>>>>            Get DriverIndex sDriver to iDriverIndex
9283>>>>>>>>>            If (iDriverIndex <> 0) Begin
9285>>>>>>>>>                Get_Attribute DF_DRIVER_DUMMY_ZERO_DATE_VALUE of iDriverIndex to sSQLDate
9288>>>>>>>>>            End
9288>>>>>>>>>>
9288>>>>>>>>>            Else Begin
9289>>>>>>>>>                Move '0001-01-01' to sSQLDate
9290>>>>>>>>>            End
9290>>>>>>>>>>
9290>>>>>>>>>        End
9290>>>>>>>>>>
9290>>>>>>>>>        Else Begin
9291>>>>>>>>>            Move dDFDate to sSQLDate
9292>>>>>>>>>        End
9292>>>>>>>>>>
9292>>>>>>>>>        
9292>>>>>>>>>        // Change date format back to original
9292>>>>>>>>>        Set_Attribute DF_DATE_FORMAT to iOrgDateFmt
9295>>>>>>>>>        Set_Attribute DF_DATE_SEPARATOR to iOrgDateSep
9298>>>>>>>>>        
9298>>>>>>>>>        Function_Return sSQLDate
9299>>>>>>>>>    End_Function
9300>>>>>>>>>    
9300>>>>>>>>>    
9300>>>>>>>>>    
9300>>>>>>>>>    // Convert a SQL date to a DataFlex date using the dummy zero date value.
9300>>>>>>>>>    Function CLISQLDateToDFDate String sDriver String sSQLDate Returns Date
9302>>>>>>>>>        
9302>>>>>>>>>        Integer iDriverIndex
9302>>>>>>>>>        
9302>>>>>>>>>        Date dDFDate
9302>>>>>>>>>        String sDummyDateValue
9302>>>>>>>>>        Integer iOrgDateFmt
9302>>>>>>>>>        Integer iOrgDateSep
9302>>>>>>>>>        
9302>>>>>>>>>        // Change date format to military, SQL dates are military dates
9302>>>>>>>>>        Get_Attribute DF_DATE_FORMAT to iOrgDateFmt
9305>>>>>>>>>        Get_Attribute DF_DATE_SEPARATOR to iOrgDateSep
9308>>>>>>>>>        Set_Attribute DF_DATE_FORMAT to DF_DATE_MILITARY
9311>>>>>>>>>        Set_Attribute DF_DATE_SEPARATOR to (Ascii('-'))
9314>>>>>>>>>        
9314>>>>>>>>>        // We only need to convert if the date is the dummy zero date value
9314>>>>>>>>>        Get DriverIndex sDriver to iDriverIndex
9315>>>>>>>>>        If (iDriverIndex <> 0) Begin
9317>>>>>>>>>            Get_Attribute DF_DRIVER_DUMMY_ZERO_DATE_VALUE of iDriverIndex to sDummyDateValue
9320>>>>>>>>>        End
9320>>>>>>>>>>
9320>>>>>>>>>        Else Begin
9321>>>>>>>>>            Move '0001-01-01' to sDummyDateValue
9322>>>>>>>>>        End
9322>>>>>>>>>>
9322>>>>>>>>>        If (sDummyDateValue = sSQLDate) ;            Move 0 to dDFDate
9325>>>>>>>>>        Else ;            Move sSQLDate to dDFDate
9327>>>>>>>>>        
9327>>>>>>>>>        // Change date format back to original
9327>>>>>>>>>        Set_Attribute DF_DATE_FORMAT to iOrgDateFmt
9330>>>>>>>>>        Set_Attribute DF_DATE_SEPARATOR to iOrgDateSep
9333>>>>>>>>>        
9333>>>>>>>>>        Function_Return dDFDate
9334>>>>>>>>>    End_Function

29085>>>>>>>        Else If (eViewStyle = wvsDrillDown or eViewStyle = wvsDialog) Begin
29088>>>>>>>            Get GenerateStateHash_DrillDown to sResult
29089>>>>>>>        End
29089>>>>>>>>
29089>>>>>>>        
29089>>>>>>>        Function_Return sResult
29090>>>>>>>    End_Function

39333>>>>>    //  This function is called by the cWebResourceManagerProxy to parse the resource string and retrieve the local file path.
39333>>>>>    Function FileDownload String sResource String ByRef sPath Integer ByRef iHttpErr String ByRef sHttpError Returns Boolean
39335>>>>>        Boolean bRes
39335>>>>>        String sKey sSessionKey
39335>>>>>        String[] aKey
39336>>>>>        Integer iSegment
39336>>>>>        DateTime dtTimeout
39336>>>>>        
39336>>>>>        Move 1 to iSegment
39337>>>>>        
39337>>>>>        //  Decript the resource key
39337>>>>>        Get DecryptKey sResource to sKey
39338>>>>>        Get StrSplit sKey "||" to aKey
39339>>>>>        If (SizeOfArray(aKey) >= 2) Begin
39341>>>>>            //  Validate session            
39341>>>>>            If (Left(aKey[0], 1) = "1") Begin
39343>>>>>                Get ReadSessionKey of (Host(Self)) to sSessionKey
39344>>>>>                
39344>>>>>                //  Validate the session key from the cookie
39344>>>>>                Get ValidateSession of (SessionManager(Self)) sSessionKey to bRes    
39345>>>>>                
39345>>>>>                If (aKey[iSegment] <> sSessionKey) Begin
39347>>>>>                    Move False to bRes
39348>>>>>                End
39348>>>>>>
39348>>>>>                
39348>>>>>                Increment iSegment
39349>>>>>            End
39349>>>>>>
39349>>>>>            Else Begin
39350>>>>>                Get pbAllowNonSessionDownloads to bRes
39351>>>>>            End
39351>>>>>>
39351>>>>>            
39351>>>>>            If (bRes) Begin            
39353>>>>>                If (SizeOfArray(aKey) > iSegment) Begin
39355>>>>>                    
39355>>>>>                    //  Validate expiration date & time
39355>>>>>                    If (Right(aKey[0], 1) = "1") Begin
39357>>>>>                        Move (aKey[iSegment]) to dtTimeout
39358>>>>>                        
39358>>>>>                        If (not(IsDateValid(dtTimeout)) or dtTimeout < CurrentDateTime()) Begin
39360>>>>>                            Move 410 to iHttpErr
39361>>>>>                            Move "URL Expired" to sHttpError
39362>>>>>                
39362>>>>>                            Function_Return False
39363>>>>>                        End
39363>>>>>>
39363>>>>>                        
39363>>>>>                        Increment iSegment
39364>>>>>                    End
39364>>>>>>
39364>>>>>                    
39364>>>>>                    //  Return the file path if succesfull
39364>>>>>                    If (SizeOfArray(aKey) > iSegment) Begin
39366>>>>>                        Get IsAllowedDownloadFolder aKey[iSegment] to bRes
39367>>>>>                        
39367>>>>>                        If (bRes) Begin
39369>>>>>                            File_Exist aKey[iSegment] bRes
39370>>>>>                            If (not(bRes)) Begin
39372>>>>>                                Move 404 to iHttpErr
39373>>>>>                                Move "File not found" to sHttpError
39374>>>>>                                
39374>>>>>                                Function_Return False
39375>>>>>                            End
39375>>>>>>
39375>>>>>                            
39375>>>>>                            Move aKey[iSegment] to sPath
39376>>>>>                            Function_Return True
39377>>>>>                        End
39377>>>>>>
39377>>>>>                        Else Begin
39378>>>>>                            //  Report error directly to the error log as the file streaming script will give an HTTP error (that would be disturbed if the error system would write html)
39378>>>>>                            Send ReportErrorEvent to ghInetSession DFERR_PROGRAM (SFormat("Attempt to download from unregistered download folder ('%1')", aKey[iSegment])) 0 0 0
39379>>>>>                            Move 403 to iHttpErr
39380>>>>>                            Move "Invalid download folder" to sHttpError
39381>>>>>                            Function_Return False
39382>>>>>                        End
39382>>>>>>
39382>>>>>                    End
39382>>>>>>
39382>>>>>                End    
39382>>>>>>
39382>>>>>            End
39382>>>>>>
39382>>>>>            Else Begin
39383>>>>>                Move 401 to iHttpErr
39384>>>>>                Move "Invalid session" to sHttpError
39385>>>>>                Function_Return False
39386>>>>>            End
39386>>>>>>
39386>>>>>        End
39386>>>>>>
39386>>>>>        
39386>>>>>        Move 400 to iHttpErr
39387>>>>>        Move "Invalid key" to sHttpError
39388>>>>>        Function_Return False
39389>>>>>    End_Function

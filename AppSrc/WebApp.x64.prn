30590>>>>>>>    Procedure Call_PreValidateSession tWebCallContext ByRef cctx
30592>>>>>>>        Boolean bSetCookie bLoadWebApp bValidSession
30592>>>>>>>        String sSessionKey sRemoteAddress
30592>>>>>>>        Handle hoSessionManager
30592>>>>>>>        
30592>>>>>>>        Get IsLoadWebAppCall (&cctx) to bLoadWebApp
30593>>>>>>>        
30593>>>>>>>        Move bLoadWebApp to bSetCookie
30594>>>>>>>        
30594>>>>>>>        //  Read the session key
30594>>>>>>>        Get ReadSessionKey to sSessionKey
30595>>>>>>>        
30595>>>>>>>        // Get the handle here so we do not have to call the function multiple times
30595>>>>>>>        Get SessionManager to hoSessionManager
30596>>>>>>>        
30596>>>>>>>        //  Create new session if no session key is sent
30596>>>>>>>        If (Trim(sSessionKey) = "" and bLoadWebApp) Begin
30598>>>>>>>            Get ServerVariable of (ServiceDispatcher(Self)) "REMOTE_ADDR" to sRemoteAddress
30599>>>>>>>            Get CreateSession of hoSessionManager sRemoteAddress to sSessionKey
30600>>>>>>>            Move True to bSetCookie
30601>>>>>>>        End
30601>>>>>>>>
30601>>>>>>>
30601>>>>>>>        //  Validate session
30601>>>>>>>        Get ValidateSession of hoSessionManager sSessionKey bLoadWebApp to bValidSession
30602>>>>>>>        Get psSessionKey of hoSessionManager to sSessionKey //  The session key might have changed during validaiton
30603>>>>>>>        If (bValidSession) Begin
30605>>>>>>>
30605>>>>>>>            //  Write the cookie if session is created or on initial call
30605>>>>>>>            If (bSetCookie) Begin
30607>>>>>>>                Send StoreSessionKey sSessionKey
30608>>>>>>>                Move True to cctx.bNotifyChangeRights
30609>>>>>>>            End
30609>>>>>>>>
30609>>>>>>>        End
30609>>>>>>>>
30609>>>>>>>        Else Begin
30610>>>>>>>            //  Clear the vaulty session cookie
30610>>>>>>>            Send StoreSessionKey ""
30611>>>>>>>            Move False to cctx.bSuccess
30612>>>>>>>        End
30612>>>>>>>>
30612>>>>>>>    End_Procedure
30613>>>>>>>    
30613>>>>>>>    Procedure Call_PreNotifyChangeRights tWebCallContext ByRef cctx
30615>>>>>>>        If (cctx.bNotifyChangeRights) ;            Send NotifyChangeRights to (SessionManager(Self))
30618>>>>>>>    End_Procedure
30619>>>>>>>    
30619>>>>>>>    // Adds a new client object to the set of listeners to NotifyChangeRights.
30619>>>>>>>    // This is only supported for object in the global scope, i.e. not supported
30619>>>>>>>    // for menus/toolbars declared inside a view.
30619>>>>>>>    // See also OnChangeRights.
30619>>>>>>>    Procedure AddChangeRightsClient Handle hoClient
30621>>>>>>>        Integer iPos
30621>>>>>>>        Handle[] aClients
30622>>>>>>>        
30622>>>>>>>        Get paChangeRightsClients to aClients
30623>>>>>>>        Move (BinarySearchArray(hoClient, aClients, False)) to iPos
30624>>>>>>>        
30624>>>>>>>        If (iPos = -1) Begin
30626>>>>>>>            Move (InsertInArray(aClients, BinarySearchInsertPos(), hoClient)) to aClients
30627>>>>>>>            Set paChangeRightsClients to aClients
30628>>>>>>>        End
30628>>>>>>>>
30628>>>>>>>    End_Procedure
30629>>>>>>>    
30629>>>>>>>    // Removes a new client object from the set of listeners to NotifyChangeRights.
30629>>>>>>>    Procedure RemoveChangeRightsClient Handle hoClient
30631>>>>>>>        Integer iPos
30631>>>>>>>        Handle[] aClients
30632>>>>>>>        
30632>>>>>>>        Get paChangeRightsClients to aClients
30633>>>>>>>        Move (BinarySearchArray(hoClient, aClients, False)) to iPos
30634>>>>>>>        
30634>>>>>>>        If (iPos <> -1) Begin
30636>>>>>>>            Move (RemoveFromArray(aClients, iPos)) to aClients
30637>>>>>>>            Set paChangeRightsClients to aClients
30638>>>>>>>        End
30638>>>>>>>>
30638>>>>>>>    End_Procedure
30639>>>>>>>    
30639>>>>>>>    
30639>>>>>>>    // This function is called by the framework to read a session key. By default the session key 
30639>>>>>>>    // is read from the cookie. Overriding this procedure allows the developer to customize this 
30639>>>>>>>    // behavior.
30639>>>>>>>    //
30639>>>>>>>    // WARNING: Note that this method can also be called when the WebApp is out of sync (Web 
30639>>>>>>>    // Properties are not available at that point). This happens in case of a file download.
30639>>>>>>>    Function ReadSessionKey Returns String
30641>>>>>>>        String sSessionKey
30641>>>>>>>        
30641>>>>>>>        Get GetCookie (psSessionCookieName(SessionManager(Self))) to sSessionKey
30642>>>>>>>        
30642>>>>>>>        Function_Return sSessionKey
30643>>>>>>>    End_Function
30644>>>>>>>
30644>>>>>>>    // This procedure is called whenever a session key is stored by the framework. By default the 
30644>>>>>>>    // session key is stored in a cookie and the settings (cookie name,  timeout, path) are read 
30644>>>>>>>    // from the SessionManager. Overriding this procedure allows the developer to customize
30644>>>>>>>    // this behavior.
30644>>>>>>>    //
30644>>>>>>>    // Params:
30644>>>>>>>    //   sSessionKey   The new session key. "" if the session is cleared.
30644>>>>>>>    Procedure StoreSessionKey String sSessionKey
30646>>>>>>>        String sPath
30646>>>>>>>        Integer iPos
30646>>>>>>>        Handle hoSessionManager
30646>>>>>>>        
30646>>>>>>>        Get SessionManager to hoSessionManager
30647>>>>>>>        Get psSessionCookiePath of hoSessionManager to sPath
30648>>>>>>>        
30648>>>>>>>        //  If the path is empty we determine the current path where the cookie should be set, we can't leave it blank as the client interprets /CallAction/JSON in the URL as part of the path
30648>>>>>>>        If (Trim(sPath) = "") Begin
30650>>>>>>>            Get ServerVariable of (ServiceDispatcher(Self)) "SCRIPT_NAME" to sPath
30651>>>>>>>            
30651>>>>>>>            Move (Pos("WebServiceDispatcher.wso", sPath)) to iPos
30652>>>>>>>            If (iPos > 0) Begin
30654>>>>>>>                Move (Left(sPath, iPos - 1)) to sPath
30655>>>>>>>            End
30655>>>>>>>>
30655>>>>>>>            
30655>>>>>>>            Move (RightPos("/", sPath)) to iPos    
30656>>>>>>>            If (iPos > 0) Begin
30658>>>>>>>                Move (Left(sPath, iPos)) to sPath
30659>>>>>>>            End
30659>>>>>>>>
30659>>>>>>>        End
30659>>>>>>>>
30659>>>>>>>        
30659>>>>>>>        Send SetCookie (psSessionCookieName(hoSessionManager)) sSessionKey (piSessionCookieTimeout(hoSessionManager)) sPath (psSessionCookieDomain(hoSessionManager)) (pbSessionCookieSecure(hoSessionManager)) (pbSessionCookieHttpOnly(hoSessionManager)) (psSessionCookieSameSite(hoSessionManager))
30660>>>>>>>    End_Procedure    
30661>>>>>>>
30661>>>>>>>    // Determines if a login is required to access this web application. If so it will determine if
30661>>>>>>>    // the current session is logged in by asking the session manager. This function is called by 
30661>>>>>>>    // views as a first level security test.
30661>>>>>>>    //
30661>>>>>>>    // Returns: 
30661>>>>>>>    //      True if a login is not required or if login is required and the session is logged in.
30661>>>>>>>    //      False if the login is required and the session is nog logged in.
30661>>>>>>>    Function ValidLogin Returns Boolean
30663>>>>>>>        Boolean bIsLoggedIn 
30663>>>>>>>        Integer eLoginMode
30663>>>>>>>        Get peLoginMode to eLoginMode
30664>>>>>>>        If (eLoginMode=lmLoginRequired) Begin
30666>>>>>>>            Get IsLoggedIn of (SessionManager(Self)) to bIsLoggedIn
30667>>>>>>>            Function_Return (bIsLoggedIn)
30668>>>>>>>        End
30668>>>>>>>>
30668>>>>>>>        Function_Return True
30669>>>>>>>    End_Function

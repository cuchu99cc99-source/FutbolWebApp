16445>>>>>>>>>>>    // Checks whether the object is dynamic. Relies on the fact that 'phoOwner'
16445>>>>>>>>>>>    // will only be set for dynamic objects. Therefore, the property should
16445>>>>>>>>>>>    // never be set for regular objects.
16445>>>>>>>>>>>    Function IsDynamicObject Returns Boolean
16447>>>>>>>>>>>        Handle hoOwner
16447>>>>>>>>>>>        Boolean bRes
16447>>>>>>>>>>>        
16447>>>>>>>>>>>        Get Owner to hoOwner
16448>>>>>>>>>>>        If (hoOwner <> Self) ;            Get IsDynamicObjectContainer of hoOwner to bRes
16451>>>>>>>>>>>        Else ;            Move False to bRes
16453>>>>>>>>>>>        
16453>>>>>>>>>>>        Function_Return bRes
16454>>>>>>>>>>>    End_Function  
16455>>>>>>>>>>>    
16455>>>>>>>>>>>    
16455>>>>>>>>>>>    // Checks if the webobject is loaded to the client by asking the owner.
16455>>>>>>>>>>>    Function IsLoaded Returns Boolean
16457>>>>>>>>>>>        
16457>>>>>>>>>>>        Handle hoOwner hoNeighborhood
16457>>>>>>>>>>>        Boolean bIsLoaded
16457>>>>>>>>>>>        
16457>>>>>>>>>>>        Move False to bIsLoaded
16458>>>>>>>>>>>        If (pbGhost(Self)) ;            Function_Return False
16461>>>>>>>>>>>        
16461>>>>>>>>>>>        If (IsDynamicObject(Self)) Begin
16463>>>>>>>>>>>            Get Owner to hoOwner
16464>>>>>>>>>>>            Get IsLoaded of hoOwner to bIsLoaded
16465>>>>>>>>>>>        End
16465>>>>>>>>>>>>
16465>>>>>>>>>>>        Else Begin
16466>>>>>>>>>>>            Get phoWebNeighborHood to hoNeighborhood
16467>>>>>>>>>>>            If (hoNeighborhood <> C_WebUnresolvedObject) Begin
16469>>>>>>>>>>>                Get IsLoaded of hoNeighborhood to bIsLoaded
16470>>>>>>>>>>>            End
16470>>>>>>>>>>>>
16470>>>>>>>>>>>        End
16470>>>>>>>>>>>>
16470>>>>>>>>>>>            
16470>>>>>>>>>>>        Function_Return bIsLoaded
16471>>>>>>>>>>>    End_Function

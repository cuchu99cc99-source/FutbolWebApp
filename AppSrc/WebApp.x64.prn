27655>>>>>>>>>        
27655>>>>>>>>>        Get CreateNamed of Self (RefClass(cWebContextMenu)) "oDefaultHeaderMenu" to hoDefaultHeaderMenu
27656>>>>>>>>>        Set piWidth of hoDefaultHeaderMenu to 220
27657>>>>>>>>>        Get CreateNamed of hoDefaultHeaderMenu (RefClass(cWebMenuColumnList)) "oColumnList" to hoChild
27658>>>>>>>>>        Get CreateNamed of hoDefaultHeaderMenu (RefClass(cWebMenuColumnRestorer)) "oColumnRestorer" to hoChild
27659>>>>>>>>>        Get CreateNamed of hoDefaultHeaderMenu (RefClass(cWebMenuGroupingSelector)) "oGroupingSelector" to hoChild
27660>>>>>>>>>
27660>>>>>>>>>        If (bShowHeader and not(bUseHeaderMenuOnWholeList)) Begin
27662>>>>>>>>>            Set peContext of hoDefaultHeaderMenu to C_WebUIContextListHead
27663>>>>>>>>>        End
27663>>>>>>>>>>
27663>>>>>>>>>        Else Begin
27664>>>>>>>>>            Set peContext of hoDefaultHeaderMenu to C_WebUIContextListFull
27665>>>>>>>>>        End
27665>>>>>>>>>>
27665>>>>>>>>>        
27665>>>>>>>>>        Set phPrivateDefaultHeaderMenu to hoDefaultHeaderMenu
27666>>>>>>>>>    End_Procedure

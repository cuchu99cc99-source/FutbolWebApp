23844>>>>>>>>>>>>>>>>>>>Class cBaseDEO_Mixin is a Mixin
23845>>>>>>>>>>>>>>>>>>>    
23845>>>>>>>>>>>>>>>>>>>    Procedure Define_cBaseDEO_Mixin
23847>>>>>>>>>>>>>>>>>>>        
23847>>>>>>>>>>>>>>>>>>>        Property Boolean Auto_Fill_State False       // Used to tell DDO's whether first record should be found automatically after a clear.
23848>>>>>>>>>>>>>>>>>>>        Property Boolean pbAutoFillOnInit False       // Used to tell DDO's that we want autofill on initialization when DEO is attaching
23849>>>>>>>>>>>>>>>>>>>        
23849>>>>>>>>>>>>>>>>>>>        Property Integer private_Server 0
23850>>>>>>>>>>>>>>>>>>>        Property Integer Watched_Servers 0          // Handle to Broadcaster object broacasting tos server DDO's
23851>>>>>>>>>>>>>>>>>>>        // used to send Set Changed_State to "foreign" servers, while Watched_Servers
23851>>>>>>>>>>>>>>>>>>>        // is used for sending messages from the DDO to DEOs (there are more of them)
23851>>>>>>>>>>>>>>>>>>>        Property Integer ChangedStateWatched_Servers     0
23852>>>>>>>>>>>>>>>>>>>        Property Integer private_pbServersScanned 0
23853>>>>>>>>>>>>>>>>>>>        
23853>>>>>>>>>>>>>>>>>>>        // added to support DEO request-delegation. This is set true if the
23853>>>>>>>>>>>>>>>>>>>        // server is explicitly set in this DEO (normally via a USING parameter).
23853>>>>>>>>>>>>>>>>>>>        Property Integer Explicit_Server_State False
23854>>>>>>>>>>>>>>>>>>>        
23854>>>>>>>>>>>>>>>>>>>        // Since this package's SET changed_state is using change_disabled_state
23854>>>>>>>>>>>>>>>>>>>        // we might as well Define it here. This gets changed by Clear_mx to support
23854>>>>>>>>>>>>>>>>>>>        // setting of defaults without changing the objects changed_state.
23854>>>>>>>>>>>>>>>>>>>        //
23854>>>>>>>>>>>>>>>>>>>        // This stops changed_state from getting changed. It allows item_changed_state
23854>>>>>>>>>>>>>>>>>>>        // to change without the object's changed_state getting changed. This Should
23854>>>>>>>>>>>>>>>>>>>        // be considered protected (i.e., likely to change). The new messages Entry_Defaults
23854>>>>>>>>>>>>>>>>>>>        // and Set Default_Value are both public and Use this. Try to use these messages
23854>>>>>>>>>>>>>>>>>>>        // instead of this Property.
23854>>>>>>>>>>>>>>>>>>>        Property Integer Change_Disabled_State False
23855>>>>>>>>>>>>>>>>>>>        
23855>>>>>>>>>>>>>>>>>>>        Property Boolean Extended_DEO_State False    // Defines DEO behavior according to Extended_DEO_State of the server DDO
23856>>>>>>>>>>>>>>>>>>>        
23856>>>>>>>>>>>>>>>>>>>        Property Boolean Active_State False          // True when the DEO has been attached to the DDO
23857>>>>>>>>>>>>>>>>>>>                
23857>>>>>>>>>>>>>>>>>>>        // these can be set via entry_item command....
23857>>>>>>>>>>>>>>>>>>>        Property Integer private_Data_File 0    // The binding table
23858>>>>>>>>>>>>>>>>>>>        Property Integer private_Data_Field 0   // The binding table column
23859>>>>>>>>>>>>>>>>>>>        
23859>>>>>>>>>>>>>>>>>>>        Set pbDataBindable to True
23860>>>>>>>>>>>>>>>>>>>        
23860>>>>>>>>>>>>>>>>>>>    End_Procedure
23861>>>>>>>>>>>>>>>>>>>    
23861>>>>>>>>>>>>>>>>>>>    Procedure OnSetCalculatedValue String ByRef sValue
23863>>>>>>>>>>>>>>>>>>>        // To be augmented by the user
23863>>>>>>>>>>>>>>>>>>>    End_Procedure
23864>>>>>>>>>>>>>>>>>>>    
23864>>>>>>>>>>>>>>>>>>>    // This procedure adds the specified object id (hoServer) to this object's
23864>>>>>>>>>>>>>>>>>>>    // set of database agents who are merely 'watched', and establishes a
23864>>>>>>>>>>>>>>>>>>>    // connection between the database agent and this object.
23864>>>>>>>>>>>>>>>>>>>    //
23864>>>>>>>>>>>>>>>>>>>    Procedure Add_Watched_Server Integer hoServer
23866>>>>>>>>>>>>>>>>>>>        Integer iIndex
23866>>>>>>>>>>>>>>>>>>>        Handle hoWatchedServers
23866>>>>>>>>>>>>>>>>>>>        
23866>>>>>>>>>>>>>>>>>>>        Get Watched_Servers to hoWatchedServers
23867>>>>>>>>>>>>>>>>>>>        If (hoWatchedServers = 0) Begin
23869>>>>>>>>>>>>>>>>>>>            Get Create of Desktop U_Broadcaster to hoWatchedServers // modern syntax
23870>>>>>>>>>>>>>>>>>>>            Set Watched_Servers to hoWatchedServers
23871>>>>>>>>>>>>>>>>>>>        End
23871>>>>>>>>>>>>>>>>>>>>
23871>>>>>>>>>>>>>>>>>>>        
23871>>>>>>>>>>>>>>>>>>>        Set Broadcast_State of hoWatchedServers to False
23872>>>>>>>>>>>>>>>>>>>        Get Find_Element of hoWatchedServers hoServer to iIndex
23873>>>>>>>>>>>>>>>>>>>        
23873>>>>>>>>>>>>>>>>>>>        If (iIndex < 0) Begin
23875>>>>>>>>>>>>>>>>>>>            Send Add_Element to hoWatchedServers hoServer
23876>>>>>>>>>>>>>>>>>>>        End
23876>>>>>>>>>>>>>>>>>>>>
23876>>>>>>>>>>>>>>>>>>>        
23876>>>>>>>>>>>>>>>>>>>        Set Broadcast_State of hoWatchedServers to True
23877>>>>>>>>>>>>>>>>>>>        
23877>>>>>>>>>>>>>>>>>>>        If (iIndex < 0 and Active_State(Self)) Begin
23879>>>>>>>>>>>>>>>>>>>            Send Add_User_Interface to hoServer Self True // TRUE for watchers
23880>>>>>>>>>>>>>>>>>>>        End
23880>>>>>>>>>>>>>>>>>>>>
23880>>>>>>>>>>>>>>>>>>>    End_Procedure
23881>>>>>>>>>>>>>>>>>>>    
23881>>>>>>>>>>>>>>>>>>>    Procedure Add_ChangedStateWatched_Server Integer hoServer
23883>>>>>>>>>>>>>>>>>>>        Integer iIndex
23883>>>>>>>>>>>>>>>>>>>        Handle hoWatchedServers
23883>>>>>>>>>>>>>>>>>>>        
23883>>>>>>>>>>>>>>>>>>>        Get ChangedStateWatched_Servers to hoWatchedServers
23884>>>>>>>>>>>>>>>>>>>        If (hoWatchedServers = 0) Begin
23886>>>>>>>>>>>>>>>>>>>            Get Create of Desktop U_Broadcaster to hoWatchedServers // modern syntax
23887>>>>>>>>>>>>>>>>>>>            Set ChangedStateWatched_Servers to hoWatchedServers
23888>>>>>>>>>>>>>>>>>>>        End
23888>>>>>>>>>>>>>>>>>>>>
23888>>>>>>>>>>>>>>>>>>>        
23888>>>>>>>>>>>>>>>>>>>        Set Broadcast_State of hoWatchedServers to False
23889>>>>>>>>>>>>>>>>>>>        Get Find_Element of hoWatchedServers hoServer to iIndex
23890>>>>>>>>>>>>>>>>>>>        
23890>>>>>>>>>>>>>>>>>>>        If (iIndex < 0) Begin
23892>>>>>>>>>>>>>>>>>>>            Send Add_Element to hoWatchedServers hoServer
23893>>>>>>>>>>>>>>>>>>>        End
23893>>>>>>>>>>>>>>>>>>>>
23893>>>>>>>>>>>>>>>>>>>        
23893>>>>>>>>>>>>>>>>>>>        Set Broadcast_State of hoWatchedServers to True
23894>>>>>>>>>>>>>>>>>>>    End_Procedure
23895>>>>>>>>>>>>>>>>>>>    
23895>>>>>>>>>>>>>>>>>>>    
23895>>>>>>>>>>>>>>>>>>>    // Expects the class to understand the Active_State property. Relies on the pbDataBindable interface.
23895>>>>>>>>>>>>>>>>>>>    Procedure Attach_Deo_To_Server
23897>>>>>>>>>>>>>>>>>>>        Integer iFile iField
23897>>>>>>>>>>>>>>>>>>>        Boolean bDataBindable bServerScan
23897>>>>>>>>>>>>>>>>>>>        Handle hoServer hoFileDDO hoWatchedServers
23897>>>>>>>>>>>>>>>>>>>        
23897>>>>>>>>>>>>>>>>>>>        Get Server to hoServer
23898>>>>>>>>>>>>>>>>>>>        Get Data_File  to iFile
23899>>>>>>>>>>>>>>>>>>>        Get Data_Field to iField
23900>>>>>>>>>>>>>>>>>>>        Get pbDataBindable to bDataBindable        
23901>>>>>>>>>>>>>>>>>>>        
23901>>>>>>>>>>>>>>>>>>>        If (hoServer <> 0) Begin
23903>>>>>>>>>>>>>>>>>>>            Send Add_User_Interface to hoServer Self
23904>>>>>>>>>>>>>>>>>>>            // Extended_DEO_State is used to determine whether the object receives the data binding related
23904>>>>>>>>>>>>>>>>>>>            // message interface from the server DDO...
23904>>>>>>>>>>>>>>>>>>>            Set Extended_DEO_State to (Extended_DSO_State(hoServer) and bDataBindable)
23905>>>>>>>>>>>>>>>>>>>        End
23905>>>>>>>>>>>>>>>>>>>>
23905>>>>>>>>>>>>>>>>>>>        
23905>>>>>>>>>>>>>>>>>>>        Get private_pbServersScanned to bServerScan
23906>>>>>>>>>>>>>>>>>>>        If (not(bServerScan)) Begin
23908>>>>>>>>>>>>>>>>>>>            Send Scan_Servers
23909>>>>>>>>>>>>>>>>>>>        End
23909>>>>>>>>>>>>>>>>>>>>
23909>>>>>>>>>>>>>>>>>>>        
23909>>>>>>>>>>>>>>>>>>>        Get Watched_Servers to hoWatchedServers
23910>>>>>>>>>>>>>>>>>>>        If hoWatchedServers Begin
23912>>>>>>>>>>>>>>>>>>>            Send Add_User_Interface to hoWatchedServers Self True // True for watchers
23913>>>>>>>>>>>>>>>>>>>        End
23913>>>>>>>>>>>>>>>>>>>>
23913>>>>>>>>>>>>>>>>>>>        
23913>>>>>>>>>>>>>>>>>>>        Set Active_State to True
23914>>>>>>>>>>>>>>>>>>>    End_Procedure
23915>>>>>>>>>>>>>>>>>>>    
23915>>>>>>>>>>>>>>>>>>>    // Changed so that this respects Change_disabled_state. I don't
23915>>>>>>>>>>>>>>>>>>>    // like this here but its the best I can think of. Therefore, all
23915>>>>>>>>>>>>>>>>>>>    // objects using server.pkg must understand Change_disabled_state.
23915>>>>>>>>>>>>>>>>>>>    //
23915>>>>>>>>>>>>>>>>>>>    // Changed to not remove from server if static.
23915>>>>>>>>>>>>>>>>>>>    Procedure Set Changed_State Integer newVal
23917>>>>>>>>>>>>>>>>>>>        Integer hoServer hoWatchedServers
23917>>>>>>>>>>>>>>>>>>>        
23917>>>>>>>>>>>>>>>>>>>        If not (Change_Disabled_State(Self)) Begin
23919>>>>>>>>>>>>>>>>>>>            Forward Set Changed_State to newVal
23921>>>>>>>>>>>>>>>>>>>            Get server to hoServer
23922>>>>>>>>>>>>>>>>>>>            
23922>>>>>>>>>>>>>>>>>>>            If (newVal and hoServer) Begin
23924>>>>>>>>>>>>>>>>>>>                Set Changed_State of hoServer to True
23925>>>>>>>>>>>>>>>>>>>                // We also set changed_state of all "foreign" servers. These
23925>>>>>>>>>>>>>>>>>>>                // are the ones whose Data_File is a parent File
23925>>>>>>>>>>>>>>>>>>>                Get ChangedStateWatched_Servers to hoWatchedServers
23926>>>>>>>>>>>>>>>>>>>                If hoWatchedServers ;                    Set Changed_State of hoWatchedServers to True
23929>>>>>>>>>>>>>>>>>>>            End
23929>>>>>>>>>>>>>>>>>>>>
23929>>>>>>>>>>>>>>>>>>>        End
23929>>>>>>>>>>>>>>>>>>>>
23929>>>>>>>>>>>>>>>>>>>    End_Procedure
23930>>>>>>>>>>>>>>>>>>>    
23930>>>>>>>>>>>>>>>>>>>    // returns the table's status for the refresh event. A table can either be
23930>>>>>>>>>>>>>>>>>>>    // cleared, found or not touched by the operation. This can only be called while
23930>>>>>>>>>>>>>>>>>>>    // within Refresh. This was created to hide the private is_file_included command
23930>>>>>>>>>>>>>>>>>>>    Function DDRefreshTableStatus Integer iTable Returns Integer
23932>>>>>>>>>>>>>>>>>>>        Boolean bIncluded
23932>>>>>>>>>>>>>>>>>>>        is_file_included iTable 1 to bIncluded // see if main file is in find done array
23934>>>>>>>>>>>>>>>>>>>        If bIncluded Begin
23936>>>>>>>>>>>>>>>>>>>            Function_Return ddrtsFound
23937>>>>>>>>>>>>>>>>>>>        End
23937>>>>>>>>>>>>>>>>>>>>
23937>>>>>>>>>>>>>>>>>>>        is_file_included iTable 0 to bIncluded // see if main file is in clear done array
23939>>>>>>>>>>>>>>>>>>>        If bIncluded Begin
23941>>>>>>>>>>>>>>>>>>>            Function_Return ddrtsCleared
23942>>>>>>>>>>>>>>>>>>>            
23942>>>>>>>>>>>>>>>>>>>        End
23942>>>>>>>>>>>>>>>>>>>>
23942>>>>>>>>>>>>>>>>>>>        Function_Return ddrtsNone
23943>>>>>>>>>>>>>>>>>>>    End_Function
23944>>>>>>>>>>>>>>>>>>>    
23944>>>>>>>>>>>>>>>>>>>    //   This procedure empties the Watched_Servers broadcaster, after
23944>>>>>>>>>>>>>>>>>>>    //   detaching this object from all of the broadcaster's elements.
23944>>>>>>>>>>>>>>>>>>>    //   This procedure is invoked by Find_Servers_to_Watch, in preparation
23944>>>>>>>>>>>>>>>>>>>    //   for a scan.
23944>>>>>>>>>>>>>>>>>>>    Procedure Delete_Watched_Servers
23946>>>>>>>>>>>>>>>>>>>        Integer hoWatchedServers
23946>>>>>>>>>>>>>>>>>>>        
23946>>>>>>>>>>>>>>>>>>>        Get Watched_Servers to hoWatchedServers
23947>>>>>>>>>>>>>>>>>>>        If hoWatchedServers Begin
23949>>>>>>>>>>>>>>>>>>>            Send Remove_User_Interface to hoWatchedServers Self True // detach from all, TRUE for watchers
23950>>>>>>>>>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to False
23951>>>>>>>>>>>>>>>>>>>            Send Delete_Data to hoWatchedServers                     // empty it
23952>>>>>>>>>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to True
23953>>>>>>>>>>>>>>>>>>>        End
23953>>>>>>>>>>>>>>>>>>>>
23953>>>>>>>>>>>>>>>>>>>        
23953>>>>>>>>>>>>>>>>>>>        Get ChangedStateWatched_Servers to hoWatchedServers
23954>>>>>>>>>>>>>>>>>>>        If hoWatchedServers Begin
23956>>>>>>>>>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to False
23957>>>>>>>>>>>>>>>>>>>            Send Delete_Data to hoWatchedServers                     // empty it
23958>>>>>>>>>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to True
23959>>>>>>>>>>>>>>>>>>>        End
23959>>>>>>>>>>>>>>>>>>>>
23959>>>>>>>>>>>>>>>>>>>    End_Procedure
23960>>>>>>>>>>>>>>>>>>>    
23960>>>>>>>>>>>>>>>>>>>    // Required DD/DEO interface. Indicates if this DEO is a data bindable control or a container.
23960>>>>>>>>>>>>>>>>>>>    // For cWebControls, this is just another way of querying pbDataBindable, used by DD's
23960>>>>>>>>>>>>>>>>>>>    Function DEO_Control_Object Returns Boolean
23962>>>>>>>>>>>>>>>>>>>        Boolean bDataBindable
23962>>>>>>>>>>>>>>>>>>>        Get pbDataBindable to bDataBindable
23963>>>>>>>>>>>>>>>>>>>        Function_Return bDataBindable
23964>>>>>>>>>>>>>>>>>>>    End_Function
23965>>>>>>>>>>>>>>>>>>>    
23965>>>>>>>>>>>>>>>>>>>    // Required DD/DEO interface. Indicates that this DEO understands the DEO Request_Find protocol
23965>>>>>>>>>>>>>>>>>>>    Function DEO_Find_Object Returns Boolean
23967>>>>>>>>>>>>>>>>>>>        Function_Return False
23968>>>>>>>>>>>>>>>>>>>    End_Function
23969>>>>>>>>>>>>>>>>>>>    
23969>>>>>>>>>>>>>>>>>>>    // Used to determine if the object understands the DEO interface.
23969>>>>>>>>>>>>>>>>>>>    // Probably not used in Ajax WebApps.
23969>>>>>>>>>>>>>>>>>>>    Function DEO_Object Returns Boolean
23971>>>>>>>>>>>>>>>>>>>        Function_Return True
23972>>>>>>>>>>>>>>>>>>>    End_Function
23973>>>>>>>>>>>>>>>>>>>    
23973>>>>>>>>>>>>>>>>>>>    // This only gets called when the developer is killing this object. During application
23973>>>>>>>>>>>>>>>>>>>    // shut-down, only destroy_object is called. This augmentation destroys the watched broadcaster
23973>>>>>>>>>>>>>>>>>>>    // (which is sitting on the desktop). During program shut down we don't care if this is called
23973>>>>>>>>>>>>>>>>>>>    // because it is getting destroyed anyway. We are making the assumption that a developer controlled
23973>>>>>>>>>>>>>>>>>>>    // destroy will always be called with the watcher still existing.
23973>>>>>>>>>>>>>>>>>>>    Procedure Destroy
23975>>>>>>>>>>>>>>>>>>>        Handle hoWatched
23975>>>>>>>>>>>>>>>>>>>        Set Changed_State to False //   is this really needed anymore???
23976>>>>>>>>>>>>>>>>>>>        // if non 0, The watched server, must still exist.
23976>>>>>>>>>>>>>>>>>>>        Get Watched_Servers to hoWatched
23977>>>>>>>>>>>>>>>>>>>        If hoWatched Begin
23979>>>>>>>>>>>>>>>>>>>            Set Broadcast_State of hoWatched to False
23980>>>>>>>>>>>>>>>>>>>            Send Destroy of hoWatched     // destroy the broadcaster
23981>>>>>>>>>>>>>>>>>>>        End
23981>>>>>>>>>>>>>>>>>>>>
23981>>>>>>>>>>>>>>>>>>>        // if non 0, The bound watched server, must still exist.
23981>>>>>>>>>>>>>>>>>>>        Get ChangedStateWatched_Servers to hoWatched
23982>>>>>>>>>>>>>>>>>>>        If hoWatched Begin
23984>>>>>>>>>>>>>>>>>>>            Set Broadcast_State of hoWatched to False
23985>>>>>>>>>>>>>>>>>>>            Send Destroy of hoWatched     // destroy the broadcaster
23986>>>>>>>>>>>>>>>>>>>        End
23986>>>>>>>>>>>>>>>>>>>>
23986>>>>>>>>>>>>>>>>>>>        Forward Send Destroy
23988>>>>>>>>>>>>>>>>>>>    End_Procedure
23989>>>>>>>>>>>>>>>>>>>    
23989>>>>>>>>>>>>>>>>>>>    // Required DD/DEO interface
23989>>>>>>>>>>>>>>>>>>>    // sent by DD before a find and save. We only care about DD finds which
23989>>>>>>>>>>>>>>>>>>>    // means DoAll is 1
23989>>>>>>>>>>>>>>>>>>>    Procedure Entry_Update Integer iFile Integer iDoAll
23991>>>>>>>>>>>>>>>>>>>    End_Procedure
23992>>>>>>>>>>>>>>>>>>>    
23992>>>>>>>>>>>>>>>>>>>    //   This procedure scans the fields of this object's items to determine
23992>>>>>>>>>>>>>>>>>>>    //   what other database agents (data_sets) other than this object's Server
23992>>>>>>>>>>>>>>>>>>>    //   should be 'watched' (for data changes).
23992>>>>>>>>>>>>>>>>>>>    //
23992>>>>>>>>>>>>>>>>>>>    //   iTableFlag is a boolean determining whether this object relies on a
23992>>>>>>>>>>>>>>>>>>>    //   prototype row (TRUE) or an item list (FALSE).
23992>>>>>>>>>>>>>>>>>>>    //   [JVH] VDF 17.0 - Ignored in this class.
23992>>>>>>>>>>>>>>>>>>>    //
23992>>>>>>>>>>>>>>>>>>>    //   This object must understand pbDataBindable, and have a private
23992>>>>>>>>>>>>>>>>>>>    //   boolean property named Private_pbServersScanned to note the event.
23992>>>>>>>>>>>>>>>>>>>    //
23992>>>>>>>>>>>>>>>>>>>    // Notes
23992>>>>>>>>>>>>>>>>>>>    //
23992>>>>>>>>>>>>>>>>>>>    //   This procedure is invoked once per object, the first time the object
23992>>>>>>>>>>>>>>>>>>>    //   is activated.  If the data_file, data_field, and/or main_file of this
23992>>>>>>>>>>>>>>>>>>>    //   object are changed (don't change them while this object is active!),
23992>>>>>>>>>>>>>>>>>>>    //   set Private_pbServersScanned to FALSE to force this object to scan
23992>>>>>>>>>>>>>>>>>>>    //   again (when it is next activated).
23992>>>>>>>>>>>>>>>>>>>    //
23992>>>>>>>>>>>>>>>>>>>    
23992>>>>>>>>>>>>>>>>>>>    // 17.0: The logic has been retooled to add more watched servers to the DDOs. This is done so
23992>>>>>>>>>>>>>>>>>>>    // DD operations will send Refresh to these additional watched-servers. There are two changes:
23992>>>>>>>>>>>>>>>>>>>    // 1. Containers are now made watched servers for the Server and all parent servers
23992>>>>>>>>>>>>>>>>>>>    // 2. Non-file.field DEOs (e.g., expressions) are made watched servers for the server (which it
23992>>>>>>>>>>>>>>>>>>>    //    already did and for all parent servers. Without this, parent entry_item expressions were not
23992>>>>>>>>>>>>>>>>>>>    //    getting updated
23992>>>>>>>>>>>>>>>>>>>    // Here is how watched-servers works.
23992>>>>>>>>>>>>>>>>>>>    // Each DEO attaches and detaches from its Server by sending Add_User_interface and Remove_User_interface
23992>>>>>>>>>>>>>>>>>>>    // to the server DD. Once attached, the DD knows about this DEO and sends messages to it as needed (Refresh,
23992>>>>>>>>>>>>>>>>>>>    // Entry_Update, etc.). In addition, a DEO may need to attach a parent DDO so that changes in that parent DD
23992>>>>>>>>>>>>>>>>>>>    // results in those messages being sent. This is needed if the binding table in entry_item refers to a parent
23992>>>>>>>>>>>>>>>>>>>    // table. So we need to send Add_User_interface and Remove_User_interface to that parent server as well. If a DEO
23992>>>>>>>>>>>>>>>>>>>    // has multiple, there could be multiple parent servers. As of 17.0, we are also attaching to parent servers if
23992>>>>>>>>>>>>>>>>>>>    // we are unsure about how the DEO is being used. If an expression is used, it might need to be updated when
23992>>>>>>>>>>>>>>>>>>>    // a parent (or any ancestor) changes. Each DEO keeps track of servers that it attaches to and this is referred
23992>>>>>>>>>>>>>>>>>>>    // to as the watched_server list. This list is maintained so the DEO knows which DDOs to attach and detach to.
23992>>>>>>>>>>>>>>>>>>>    //
23992>>>>>>>>>>>>>>>>>>>    // [JVH] VDF 17.1 cWebAppDEOServer_mixin Notes:
23992>>>>>>>>>>>>>>>>>>>    // - Modified to support only 1 item per control. Get Item_Count interface not supported.
23992>>>>>>>>>>>>>>>>>>>    // - Modified to not support the Prototype_Object interface (old windows Table class).
23992>>>>>>>>>>>>>>>>>>>    Procedure Find_Servers_To_Watch Integer iTableFlag
23994>>>>>>>>>>>>>>>>>>>        Integer iFileNum iServerFile
23994>>>>>>>>>>>>>>>>>>>        Handle hoServer hoDataSet
23994>>>>>>>>>>>>>>>>>>>        Boolean bDataBindable
23994>>>>>>>>>>>>>>>>>>>        
23994>>>>>>>>>>>>>>>>>>>        Get pbDataBindable to bDataBindable
23995>>>>>>>>>>>>>>>>>>>        Set Private_pbServersScanned to True
23996>>>>>>>>>>>>>>>>>>>        Get Server to hoServer
23997>>>>>>>>>>>>>>>>>>>        
23997>>>>>>>>>>>>>>>>>>>        If (hoServer = 0) Begin
23999>>>>>>>>>>>>>>>>>>>            Procedure_Return
24000>>>>>>>>>>>>>>>>>>>        End
24000>>>>>>>>>>>>>>>>>>>>
24000>>>>>>>>>>>>>>>>>>>        
24000>>>>>>>>>>>>>>>>>>>        Send Delete_Watched_Servers  // empty Watched_Servers broadcaster first
24001>>>>>>>>>>>>>>>>>>>        Get Main_File of hoServer to iServerFile  // data-set's main-file
24002>>>>>>>>>>>>>>>>>>>        
24002>>>>>>>>>>>>>>>>>>>        If (not(bDataBindable)) Begin
24004>>>>>>>>>>>>>>>>>>>            // containers should get added to all parent DDOs
24004>>>>>>>>>>>>>>>>>>>            Send WatchAllParentServers hoServer
24005>>>>>>>>>>>>>>>>>>>            Procedure_Return
24006>>>>>>>>>>>>>>>>>>>        End
24006>>>>>>>>>>>>>>>>>>>>
24006>>>>>>>>>>>>>>>>>>>        
24006>>>>>>>>>>>>>>>>>>>        Get Data_File to iFileNum
24007>>>>>>>>>>>>>>>>>>>        // we need watched server if file exists, it is not the main file
24007>>>>>>>>>>>>>>>>>>>        // and is not an updating file (as opposed to updating data-set).
24007>>>>>>>>>>>>>>>>>>>        If (iFileNum > 0 and iFileNum <> iServerFile) Begin
24009>>>>>>>>>>>>>>>>>>>            Get Which_Data_Set of hoServer iFileNum to hoDataSet
24010>>>>>>>>>>>>>>>>>>>            If (hoDataSet <> 0 and hoDataSet <> hoServer) Begin
24012>>>>>>>>>>>>>>>>>>>                Send Add_Watched_Server hoDataSet
24013>>>>>>>>>>>>>>>>>>>                Send Add_ChangedStateWatched_Server hoDataSet
24014>>>>>>>>>>>>>>>>>>>            End
24014>>>>>>>>>>>>>>>>>>>>
24014>>>>>>>>>>>>>>>>>>>        End
24014>>>>>>>>>>>>>>>>>>>>
24014>>>>>>>>>>>>>>>>>>>        Else If (iFileNum = 0) Begin
24017>>>>>>>>>>>>>>>>>>>            // if no file (e.g., expression) we don't know when it changes so we tell all servers
24017>>>>>>>>>>>>>>>>>>>            // that this is a watcher
24017>>>>>>>>>>>>>>>>>>>            Send WatchAllParentServers hoServer
24018>>>>>>>>>>>>>>>>>>>        End
24018>>>>>>>>>>>>>>>>>>>>
24018>>>>>>>>>>>>>>>>>>>    End_Procedure
24019>>>>>>>>>>>>>>>>>>>    
24019>>>>>>>>>>>>>>>>>>>    // This function returns the object id of the database agent of this object,
24019>>>>>>>>>>>>>>>>>>>    // or 0.
24019>>>>>>>>>>>>>>>>>>>    Function Locate_Server Returns Integer
24021>>>>>>>>>>>>>>>>>>>        Handle hoServer
24021>>>>>>>>>>>>>>>>>>>        Get Server to hoServer
24022>>>>>>>>>>>>>>>>>>>        Function_Return hoServer
24023>>>>>>>>>>>>>>>>>>>    End_Function
24024>>>>>>>>>>>>>>>>>>>    
24024>>>>>>>>>>>>>>>>>>>    Procedure Refresh Integer eMode
24026>>>>>>>>>>>>>>>>>>>    End_Procedure
24027>>>>>>>>>>>>>>>>>>>    
24027>>>>>>>>>>>>>>>>>>>    //   This procedure discontinues the connection between this object and its
24027>>>>>>>>>>>>>>>>>>>    //   database agent(s) (Server and Watched_Servers).
24027>>>>>>>>>>>>>>>>>>>    Procedure Remove_DEO_From_Server
24029>>>>>>>>>>>>>>>>>>>        Integer hoServer hoWatchedServers
24029>>>>>>>>>>>>>>>>>>>        
24029>>>>>>>>>>>>>>>>>>>        Get Server to hoServer
24030>>>>>>>>>>>>>>>>>>>        
24030>>>>>>>>>>>>>>>>>>>        If (hoServer <> 0) Begin
24032>>>>>>>>>>>>>>>>>>>            Send Remove_User_Interface to hoServer Self
24033>>>>>>>>>>>>>>>>>>>        End
24033>>>>>>>>>>>>>>>>>>>>
24033>>>>>>>>>>>>>>>>>>>        
24033>>>>>>>>>>>>>>>>>>>        // Only send if watched-server exists
24033>>>>>>>>>>>>>>>>>>>        Get Watched_Servers to hoWatchedServers
24034>>>>>>>>>>>>>>>>>>>        
24034>>>>>>>>>>>>>>>>>>>        If hoWatchedServers Begin
24036>>>>>>>>>>>>>>>>>>>            Send Remove_User_Interface to hoWatchedServers Self True // TRUE for watchers
24037>>>>>>>>>>>>>>>>>>>        End
24037>>>>>>>>>>>>>>>>>>>>
24037>>>>>>>>>>>>>>>>>>>        
24037>>>>>>>>>>>>>>>>>>>        // when removed the deo is no longer up to date.
24037>>>>>>>>>>>>>>>>>>>        Set Refresh_Dirty_State to True
24038>>>>>>>>>>>>>>>>>>>    End_Procedure
24039>>>>>>>>>>>>>>>>>>>    
24039>>>>>>>>>>>>>>>>>>>    //   This procedure removes the specified object id (hoServer) from this object's
24039>>>>>>>>>>>>>>>>>>>    //   set of database agents who are merely 'watched', and destroys the
24039>>>>>>>>>>>>>>>>>>>    //   connection between the database agent and this object.
24039>>>>>>>>>>>>>>>>>>>    Procedure Remove_Watched_Server Integer hoServer
24041>>>>>>>>>>>>>>>>>>>        Integer iIndex
24041>>>>>>>>>>>>>>>>>>>        Handle hoWatchedServers
24041>>>>>>>>>>>>>>>>>>>        
24041>>>>>>>>>>>>>>>>>>>        Get Watched_Servers to hoWatchedServers
24042>>>>>>>>>>>>>>>>>>>        // Only if w server exists
24042>>>>>>>>>>>>>>>>>>>        If hoWatchedServers Begin
24044>>>>>>>>>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to False
24045>>>>>>>>>>>>>>>>>>>            Get find_element of hoWatchedServers hoServer to iIndex
24046>>>>>>>>>>>>>>>>>>>            If (iIndex >= 0) Begin
24048>>>>>>>>>>>>>>>>>>>                Send remove_element to hoWatchedServers hoServer
24049>>>>>>>>>>>>>>>>>>>            End
24049>>>>>>>>>>>>>>>>>>>>
24049>>>>>>>>>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to True
24050>>>>>>>>>>>>>>>>>>>            If (iIndex >= 0 and Active_State(Self)) Begin
24052>>>>>>>>>>>>>>>>>>>                Send Remove_User_Interface to hoServer Self True // TRUE for watchers
24053>>>>>>>>>>>>>>>>>>>            End
24053>>>>>>>>>>>>>>>>>>>>
24053>>>>>>>>>>>>>>>>>>>        End
24053>>>>>>>>>>>>>>>>>>>>
24053>>>>>>>>>>>>>>>>>>>    End_Procedure
24054>>>>>>>>>>>>>>>>>>>    
24054>>>>>>>>>>>>>>>>>>>    // This function returns the object id of the database agent of this object, or 0.
24054>>>>>>>>>>>>>>>>>>>    // If this object's Server is 0, this object's parent's Server is returned, if any.
24054>>>>>>>>>>>>>>>>>>>    // This function is used to allow nested data-entry objects to use the
24054>>>>>>>>>>>>>>>>>>>    // database agent defined by their parent object.
24054>>>>>>>>>>>>>>>>>>>    Function Server Returns Integer
24056>>>>>>>>>>>>>>>>>>>        Integer hoServer
24056>>>>>>>>>>>>>>>>>>>        Get private_Server to hoServer
24057>>>>>>>>>>>>>>>>>>>        If (hoServer = 0) Begin
24059>>>>>>>>>>>>>>>>>>>            Function_Return (Locate_Server(parent(Self)))
24060>>>>>>>>>>>>>>>>>>>        End
24060>>>>>>>>>>>>>>>>>>>>
24060>>>>>>>>>>>>>>>>>>>        Function_Return hoServer
24061>>>>>>>>>>>>>>>>>>>    End_Function
24062>>>>>>>>>>>>>>>>>>>    
24062>>>>>>>>>>>>>>>>>>>    // This procedure sets the value of the Server property of this object,
24062>>>>>>>>>>>>>>>>>>>    // notifying child-objects of the change, and destroying and creating
24062>>>>>>>>>>>>>>>>>>>    // connections with database agents, as required.
24062>>>>>>>>>>>>>>>>>>>    // If the Server of this object is changed while this object is inactive,
24062>>>>>>>>>>>>>>>>>>>    // no notification of child-objects is required or performed.
24062>>>>>>>>>>>>>>>>>>>    Procedure Set Server Integer newVal
24064>>>>>>>>>>>>>>>>>>>        Integer oldVal
24064>>>>>>>>>>>>>>>>>>>        
24064>>>>>>>>>>>>>>>>>>>        Set Explicit_Server_State to (newVal <> 0)
24065>>>>>>>>>>>>>>>>>>>        Get Server to oldVal
24066>>>>>>>>>>>>>>>>>>>        
24066>>>>>>>>>>>>>>>>>>>        If (newVal <> 0) Begin
24068>>>>>>>>>>>>>>>>>>>            Set private_Server to (object_id(newVal))
24069>>>>>>>>>>>>>>>>>>>        End
24069>>>>>>>>>>>>>>>>>>>>
24069>>>>>>>>>>>>>>>>>>>        Else Begin
24070>>>>>>>>>>>>>>>>>>>            Set private_Server to newVal
24071>>>>>>>>>>>>>>>>>>>        End
24071>>>>>>>>>>>>>>>>>>>>
24071>>>>>>>>>>>>>>>>>>>        
24071>>>>>>>>>>>>>>>>>>>        If (Active_State(Self)) Begin
24073>>>>>>>>>>>>>>>>>>>            Broadcast Send server_changed oldVal newVal
24075>>>>>>>>>>>>>>>>>>>            If (oldVal <> 0) Begin
24077>>>>>>>>>>>>>>>>>>>                Send Remove_DEO_From_Server  // detach from current server
24078>>>>>>>>>>>>>>>>>>>            End
24078>>>>>>>>>>>>>>>>>>>>
24078>>>>>>>>>>>>>>>>>>>            If (newval <> 0) Begin
24080>>>>>>>>>>>>>>>>>>>                Send Attach_Deo_To_Server    // attach to new server
24081>>>>>>>>>>>>>>>>>>>            End
24081>>>>>>>>>>>>>>>>>>>>
24081>>>>>>>>>>>>>>>>>>>        End
24081>>>>>>>>>>>>>>>>>>>>
24081>>>>>>>>>>>>>>>>>>>    End_Procedure
24082>>>>>>>>>>>>>>>>>>>    
24082>>>>>>>>>>>>>>>>>>>    //   This procedure servers as notification of a change in the connection
24082>>>>>>>>>>>>>>>>>>>    //   of this object's parent to its database agent.  If this object uses
24082>>>>>>>>>>>>>>>>>>>    //   its parent's database agent by default (see the Server and Find_Server
24082>>>>>>>>>>>>>>>>>>>    //   functions, above), it must disconnect from the old agent and connect
24082>>>>>>>>>>>>>>>>>>>    //   with the new agent.
24082>>>>>>>>>>>>>>>>>>>    Procedure Server_Changed Integer oldVal Integer newVal
24084>>>>>>>>>>>>>>>>>>>        Integer oldSrvr
24084>>>>>>>>>>>>>>>>>>>        
24084>>>>>>>>>>>>>>>>>>>        Get private_Server to oldSrvr
24085>>>>>>>>>>>>>>>>>>>        If (oldSrvr = 0) Begin  //assumes Server(self) = oldVal by deleg
24087>>>>>>>>>>>>>>>>>>>            If (oldVal <> 0) ;                Send remove_user_interface to oldVal Self
24090>>>>>>>>>>>>>>>>>>>            If (newVal <> 0) ;                Send add_user_interface to newVal Self
24093>>>>>>>>>>>>>>>>>>>        End
24093>>>>>>>>>>>>>>>>>>>>
24093>>>>>>>>>>>>>>>>>>>    End_Procedure
24094>>>>>>>>>>>>>>>>>>>    
24094>>>>>>>>>>>>>>>>>>>    // return the DEO that sets the server
24094>>>>>>>>>>>>>>>>>>>    Function ServerDEO Returns Handle
24096>>>>>>>>>>>>>>>>>>>        Handle hoServer hoServerDeo
24096>>>>>>>>>>>>>>>>>>>        Boolean bExplicitServer
24096>>>>>>>>>>>>>>>>>>>        Get Server to hoServer
24097>>>>>>>>>>>>>>>>>>>        If (hoServer) Begin
24099>>>>>>>>>>>>>>>>>>>            Get Explicit_Server_State to bExplicitServer
24100>>>>>>>>>>>>>>>>>>>            If (bExplicitServer) Begin
24102>>>>>>>>>>>>>>>>>>>                Move Self to hoServerDeo
24103>>>>>>>>>>>>>>>>>>>            End
24103>>>>>>>>>>>>>>>>>>>>
24103>>>>>>>>>>>>>>>>>>>            Else Begin
24104>>>>>>>>>>>>>>>>>>>                Delegate Get ServerDEO to hoServerDeo
24106>>>>>>>>>>>>>>>>>>>            End
24106>>>>>>>>>>>>>>>>>>>>
24106>>>>>>>>>>>>>>>>>>>        End
24106>>>>>>>>>>>>>>>>>>>>
24106>>>>>>>>>>>>>>>>>>>        Function_Return hoServerDeo
24107>>>>>>>>>>>>>>>>>>>    End_Function
24108>>>>>>>>>>>>>>>>>>>    
24108>>>>>>>>>>>>>>>>>>>    //   This procedure causes the scanning of this object's items' fields,
24108>>>>>>>>>>>>>>>>>>>    //   and the production of a set of database agents who should be 'watched'.
24108>>>>>>>>>>>>>>>>>>>    Procedure Scan_Servers
24110>>>>>>>>>>>>>>>>>>>        Send Find_Servers_To_Watch False
24111>>>>>>>>>>>>>>>>>>>    End_Procedure

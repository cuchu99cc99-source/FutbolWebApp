19437>>>>>>>>>>>>>>>    
19437>>>>>>>>>>>>>>>    // Sent after each DEO Object has been attached to its DDO server and had all the DDO field settings
19437>>>>>>>>>>>>>>>    // applied to its published properties. We will set default values to any cWebControl properties that
19437>>>>>>>>>>>>>>>    // are still unassigned...
19437>>>>>>>>>>>>>>>    Procedure AfterAttachDDO
19439>>>>>>>>>>>>>>>        Integer iValue
19439>>>>>>>>>>>>>>>        String sValue
19439>>>>>>>>>>>>>>>        
19439>>>>>>>>>>>>>>>        // Set default values for any unassigned properties
19439>>>>>>>>>>>>>>>        Get pbServerOnAutoFind to iValue
19440>>>>>>>>>>>>>>>        If (iValue = C_WebDefault) Begin
19442>>>>>>>>>>>>>>>            Set pbServerOnAutoFind to False
19443>>>>>>>>>>>>>>>        End
19443>>>>>>>>>>>>>>>>
19443>>>>>>>>>>>>>>>
19443>>>>>>>>>>>>>>>        Get pbCapslock to iValue
19444>>>>>>>>>>>>>>>        If (iValue = C_WebDefault) Begin
19446>>>>>>>>>>>>>>>            Set pbCapslock to False
19447>>>>>>>>>>>>>>>        End
19447>>>>>>>>>>>>>>>>
19447>>>>>>>>>>>>>>>
19447>>>>>>>>>>>>>>>        Get pbRequired to iValue
19448>>>>>>>>>>>>>>>        If (iValue = C_WebDefault) Begin
19450>>>>>>>>>>>>>>>            Set pbRequired to False
19451>>>>>>>>>>>>>>>        End
19451>>>>>>>>>>>>>>>>
19451>>>>>>>>>>>>>>>
19451>>>>>>>>>>>>>>>        Get peDataType to iValue
19452>>>>>>>>>>>>>>>        If (iValue = C_WebDefault) Begin
19454>>>>>>>>>>>>>>>            Set peDataType to typeASCII
19455>>>>>>>>>>>>>>>        End
19455>>>>>>>>>>>>>>>>
19455>>>>>>>>>>>>>>>
19455>>>>>>>>>>>>>>>        Get piMaxLength to iValue
19456>>>>>>>>>>>>>>>        If (iValue = C_WebDefault) Begin
19458>>>>>>>>>>>>>>>            Set piMaxLength to 32768
19459>>>>>>>>>>>>>>>        End
19459>>>>>>>>>>>>>>>>
19459>>>>>>>>>>>>>>>
19459>>>>>>>>>>>>>>>        Get piPrecision to iValue
19460>>>>>>>>>>>>>>>        If (iValue = C_WebDefault) Begin
19462>>>>>>>>>>>>>>>            Set piPrecision to 0
19463>>>>>>>>>>>>>>>        End
19463>>>>>>>>>>>>>>>>
19463>>>>>>>>>>>>>>>        
19463>>>>>>>>>>>>>>>        Get psMask to sValue
19464>>>>>>>>>>>>>>>        If (sValue = String(C_WebDefault)) Begin
19466>>>>>>>>>>>>>>>            Set psMask to ""
19467>>>>>>>>>>>>>>>        End
19467>>>>>>>>>>>>>>>>
19467>>>>>>>>>>>>>>>    End_Procedure
19468>>>>>>>>>>>>>>>
19468>>>>>>>>>>>>>>>    // Augmented to set all of the various properties controlled by the DDO. This is triggered when a data-bound
19468>>>>>>>>>>>>>>>    // control 
19468>>>>>>>>>>>>>>>    Procedure Attach_Deo_To_Server
19470>>>>>>>>>>>>>>>        Integer iFile iField iMaxLength iPrecision iDDOOptions iValue
19470>>>>>>>>>>>>>>>        Integer eFieldType eMaskType eDataType iValidateMSG
19470>>>>>>>>>>>>>>>        String sMask sLabel sTooltip sValue
19470>>>>>>>>>>>>>>>        Boolean bAutoFind bAutoFindGE bCapslock bRequired bNoEnter bZeroSuppress bFindRequired
19470>>>>>>>>>>>>>>>        Boolean bAutoLabelState bStatic
19470>>>>>>>>>>>>>>>        Handle hoDDO hoFileDDO
19470>>>>>>>>>>>>>>>
19470>>>>>>>>>>>>>>>        Forward Send Attach_Deo_To_Server
19472>>>>>>>>>>>>>>>
19472>>>>>>>>>>>>>>>        Get Server to hoDDO
19473>>>>>>>>>>>>>>>        Get Data_File  to iFile
19474>>>>>>>>>>>>>>>        Get Data_Field to iField
19475>>>>>>>>>>>>>>>        
19475>>>>>>>>>>>>>>>        // If we are attached to a data binding then apply all the data dictionary attributes....
19475>>>>>>>>>>>>>>>        If ((hoDDO <> 0) and (iFile <> 0)) Begin
19477>>>>>>>>>>>>>>>            Get Data_Set of hoDDO iFile to hoFileDDO    // Get the file's DDO
19478>>>>>>>>>>>>>>>            
19478>>>>>>>>>>>>>>>            // Field Options
19478>>>>>>>>>>>>>>>            Get File_Field_Options of hoDDO iFile iField to iDDOOptions
19479>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_AutoFind, iDDOOptions))      to bAutoFind
19480>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_AutoFind_GE, iDDOOptions))   to bAutoFindGE
19481>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_CapsLock, iDDOOptions))      to bCapslock
19482>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_NoEnter, iDDOOptions))       to bNoEnter
19483>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_Required, iDDOOptions))      to bRequired
19484>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_Zero_Suppress, iDDOOptions)) to bZeroSuppress
19485>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_FindReq, iDDOOptions))       to bFindRequired
19486>>>>>>>>>>>>>>>
19486>>>>>>>>>>>>>>>            // Set the DEO properties....
19486>>>>>>>>>>>>>>>            Get pbServerOnAutoFind to iValue
19487>>>>>>>>>>>>>>>            If (iValue = C_WebDefault) Begin
19489>>>>>>>>>>>>>>>                Set pbServerOnAutoFind to (bAutoFind or bAutoFindGE)
19490>>>>>>>>>>>>>>>            End
19490>>>>>>>>>>>>>>>>
19490>>>>>>>>>>>>>>>            
19490>>>>>>>>>>>>>>>            Get pbCapslock to iValue
19491>>>>>>>>>>>>>>>            If (iValue = C_WebDefault) Begin
19493>>>>>>>>>>>>>>>                Set pbCapslock to bCapslock
19494>>>>>>>>>>>>>>>            End
19494>>>>>>>>>>>>>>>>
19494>>>>>>>>>>>>>>>            
19494>>>>>>>>>>>>>>>            Get pbRequired to iValue
19495>>>>>>>>>>>>>>>            If (iValue = C_WebDefault) Begin
19497>>>>>>>>>>>>>>>                /*                We do not set pbRequired for parent fields because this will prevent clearing of                 the parent using autofind. We will set pbServerOnValidate to true so that the DD                 will still give the error when tabbing out of the field (the DD also looks at the                 changed-state to determine if it is really nessecary).                */
19497>>>>>>>>>>>>>>>                Set pbRequired to (bRequired and (hoFileDDO = hoDDO))
19498>>>>>>>>>>>>>>>            End
19498>>>>>>>>>>>>>>>>
19498>>>>>>>>>>>>>>>            
19498>>>>>>>>>>>>>>>            Get pbEnabledStatic to bStatic
19499>>>>>>>>>>>>>>>            If (not(bStatic) and bNoEnter) Begin
19501>>>>>>>>>>>>>>>                // Only disable if bNoEnter is True. Otherwise respect the current pbEnabled state...
19501>>>>>>>>>>>>>>>                Set pbEnabled to False
19502>>>>>>>>>>>>>>>            End
19502>>>>>>>>>>>>>>>>
19502>>>>>>>>>>>>>>>           
19502>>>>>>>>>>>>>>>            // handle tool tip...
19502>>>>>>>>>>>>>>>            Get psToolTip to sToolTip
19503>>>>>>>>>>>>>>>            If (sToolTip = "") Begin    // only change the tooltip if it is not already set
19505>>>>>>>>>>>>>>>                Get File_Field_Status_Help of hoDDO iFile iField to sToolTip
19506>>>>>>>>>>>>>>>                Set psToolTip to sToolTip
19507>>>>>>>>>>>>>>>            End
19507>>>>>>>>>>>>>>>>
19507>>>>>>>>>>>>>>>            
19507>>>>>>>>>>>>>>>            // Set peDataType, psMask, piMaxLength, piPrecision
19507>>>>>>>>>>>>>>>            Get_Attribute DF_FIELD_TYPE   of iFile iField to eFieldType    // the type of the column
19510>>>>>>>>>>>>>>>            Get_Attribute DF_FIELD_LENGTH of iFile iField to iMaxLength    // max number of characters of the column
19513>>>>>>>>>>>>>>>            Get File_Field_Mask_Type of hoDDO iFile iField to eMaskType    // the type specified in the DDO
19514>>>>>>>>>>>>>>>            Get File_Field_Mask      of hoDDO iFile iField to sMask        // the mask string specified in the DDO
19515>>>>>>>>>>>>>>>
19515>>>>>>>>>>>>>>>            Case Begin
19515>>>>>>>>>>>>>>>                Case (eFieldType = DF_BCD)
19517>>>>>>>>>>>>>>>                    Get_Attribute DF_FIELD_PRECISION of iFile iField to iPrecision
19520>>>>>>>>>>>>>>>                    Move typeNumber to eDataType 
19521>>>>>>>>>>>>>>>                    Case Break
19522>>>>>>>>>>>>>>>                   
19522>>>>>>>>>>>>>>>                Case (eFieldType = DF_DATE)
19525>>>>>>>>>>>>>>>                    Move typeDate to eDataType
19526>>>>>>>>>>>>>>>                    Move 10 to iMaxLength
19527>>>>>>>>>>>>>>>                    Case Break
19528>>>>>>>>>>>>>>>                   
19528>>>>>>>>>>>>>>>                Case (eFieldType = DF_DATETIME)
19531>>>>>>>>>>>>>>>                    Move typeDateTime to eDataType
19532>>>>>>>>>>>>>>>                    Move 26 to iMaxLength              // should be enough for "mm/dd/yyyy hh:mm:ss.fff pm"
19533>>>>>>>>>>>>>>>                    Case Break
19534>>>>>>>>>>>>>>>          
19534>>>>>>>>>>>>>>>                Case (eFieldType = DF_ASCII)
19537>>>>>>>>>>>>>>>                Case Else
19537>>>>>>>>>>>>>>>                    Move typeASCII to eDataType
19538>>>>>>>>>>>>>>>                    Case Break
19539>>>>>>>>>>>>>>>            Case End           
19539>>>>>>>>>>>>>>>
19539>>>>>>>>>>>>>>>            // if the mask is blank but the field type is numeric or currency
19539>>>>>>>>>>>>>>>            // we will build an automatic mask based on our default mask
19539>>>>>>>>>>>>>>>            If (eMaskType = Mask_Numeric_Window or eMaskType = Mask_Currency_Window and sMask = '') Begin
19541>>>>>>>>>>>>>>>                If (eMaskType = Mask_Numeric_Window) Begin
19543>>>>>>>>>>>>>>>                    Move (Field_Number_Default_Mask( iFile, iField, "*")) to sMask
19544>>>>>>>>>>>>>>>                End
19544>>>>>>>>>>>>>>>>
19544>>>>>>>>>>>>>>>                Else Begin
19545>>>>>>>>>>>>>>>                    Move (Field_Number_Default_Mask( iFile, iField, "&curren;,*;(&curren;,*)")) to sMask
19546>>>>>>>>>>>>>>>                End
19546>>>>>>>>>>>>>>>>
19546>>>>>>>>>>>>>>>            End
19546>>>>>>>>>>>>>>>>
19546>>>>>>>>>>>>>>>
19546>>>>>>>>>>>>>>>            // If zero-suppress add a "Z" to first char of mask only if Z is not already there.
19546>>>>>>>>>>>>>>>            If (bZeroSuppress) Begin
19548>>>>>>>>>>>>>>>                If ((sMask <> "") and (Left(sMask,1) <> "Z") ) Begin
19550>>>>>>>>>>>>>>>                    Move ("Z" + sMask) to sMask
19551>>>>>>>>>>>>>>>                End
19551>>>>>>>>>>>>>>>>
19551>>>>>>>>>>>>>>>            End
19551>>>>>>>>>>>>>>>>
19551>>>>>>>>>>>>>>>            
19551>>>>>>>>>>>>>>>            // Enable server side validation if Field_Validate_msg available
19551>>>>>>>>>>>>>>>            Move 0 to iValidateMSG
19552>>>>>>>>>>>>>>>            If (hoDDO = hoFileDDO) Begin    // If this is not a "foreign-field"
19554>>>>>>>>>>>>>>>                Get Field_Validate_msg of hoDDO iField to iValidateMSG
19555>>>>>>>>>>>>>>>            End
19555>>>>>>>>>>>>>>>>
19555>>>>>>>>>>>>>>>            
19555>>>>>>>>>>>>>>>            Get pbServerOnValidate to iValue
19556>>>>>>>>>>>>>>>            If (iValue = C_WebDefault) Begin
19558>>>>>>>>>>>>>>>                //  We enable pbServerOnValidate for required parent fields because they can't use client-side pbRequired validation
19558>>>>>>>>>>>>>>>                Set pbServerOnValidate to ((iValidateMSG <> 0) or bFindRequired or (bRequired and (hoFileDDO <> hoDDO)))
19559>>>>>>>>>>>>>>>            End
19559>>>>>>>>>>>>>>>>
19559>>>>>>>>>>>>>>>
19559>>>>>>>>>>>>>>>            // Set the DEO properties
19559>>>>>>>>>>>>>>>            Get peDataType to iValue
19560>>>>>>>>>>>>>>>            If (iValue = C_WebDefault) Begin
19562>>>>>>>>>>>>>>>                Set peDataType to eDataType
19563>>>>>>>>>>>>>>>            End
19563>>>>>>>>>>>>>>>>
19563>>>>>>>>>>>>>>>
19563>>>>>>>>>>>>>>>            Get piMaxLength to iValue
19564>>>>>>>>>>>>>>>            If (iValue = C_WebDefault) Begin
19566>>>>>>>>>>>>>>>                Set piMaxLength to iMaxLength
19567>>>>>>>>>>>>>>>            End
19567>>>>>>>>>>>>>>>>
19567>>>>>>>>>>>>>>>    
19567>>>>>>>>>>>>>>>            Get piPrecision to iValue
19568>>>>>>>>>>>>>>>            If (iValue = C_WebDefault) Begin
19570>>>>>>>>>>>>>>>                Set piPrecision to iPrecision
19571>>>>>>>>>>>>>>>            End
19571>>>>>>>>>>>>>>>>
19571>>>>>>>>>>>>>>>            
19571>>>>>>>>>>>>>>>            Get psMask to sValue
19572>>>>>>>>>>>>>>>            If (sValue = "") Begin
19574>>>>>>>>>>>>>>>                Set psMask to sMask
19575>>>>>>>>>>>>>>>            End
19575>>>>>>>>>>>>>>>>
19575>>>>>>>>>>>>>>>        End
19575>>>>>>>>>>>>>>>>
19575>>>>>>>>>>>>>>>    End_Procedure
19576>>>>>>>>>>>>>>>
19576>>>>>>>>>>>>>>>    
19576>>>>>>>>>>>>>>>    // Private: Returns the autofind mode for the column's data binding.
19576>>>>>>>>>>>>>>>    // (See DoAutoFind)
19576>>>>>>>>>>>>>>>    Function AutoFindMode Returns Integer
19578>>>>>>>>>>>>>>>        Handle hoDD 
19578>>>>>>>>>>>>>>>        Integer iFile iField iOpts bOn
19578>>>>>>>>>>>>>>>
19578>>>>>>>>>>>>>>>        Get Data_File to iFile
19579>>>>>>>>>>>>>>>        Get Data_Field to iField
19580>>>>>>>>>>>>>>>        Get Server to hoDD
19581>>>>>>>>>>>>>>>        
19581>>>>>>>>>>>>>>>        If (hoDD <> 0 and iFile <> 0) Begin
19583>>>>>>>>>>>>>>>            Get File_Field_Options of hoDD iFile iField to iOpts
19584>>>>>>>>>>>>>>>            
19584>>>>>>>>>>>>>>>            If ((iOpts iand DD_AUTOFIND_GE) = DD_AUTOFIND_GE) ;                Function_Return amAutoFindGE
19587>>>>>>>>>>>>>>>            Else If ((iOpts iand DD_AUTOFIND) = DD_AUTOFIND) ;                Function_Return amAutoFindEQ
19591>>>>>>>>>>>>>>>        End
19591>>>>>>>>>>>>>>>>
19591>>>>>>>>>>>>>>>        Function_Return amNoAutoFind
19592>>>>>>>>>>>>>>>    End_Function
19593>>>>>>>>>>>>>>>
19593>>>>>>>>>>>>>>>
19593>>>>>>>>>>>>>>>    // this will be sent by the Entry_item command
19593>>>>>>>>>>>>>>>    Procedure Bind_Data Integer iFile Integer iField
19595>>>>>>>>>>>>>>>        Set Data_File to iFile
19596>>>>>>>>>>>>>>>        Set Data_Field to iField
19597>>>>>>>>>>>>>>>    End_Procedure
19598>>>>>>>>>>>>>>>    
19598>>>>>>>>>>>>>>>    
19598>>>>>>>>>>>>>>>    // required DD/DEO interface
19598>>>>>>>>>>>>>>>    Function Checkbox_Item_State Integer iItem Returns Integer
19600>>>>>>>>>>>>>>>        // not used in cWebControl
19600>>>>>>>>>>>>>>>    End_Function  
19601>>>>>>>>>>>>>>>
19601>>>>>>>>>>>>>>>    Function ConvertFromTransport Handle hmGetter String sValue Integer eType Returns String
19603>>>>>>>>>>>>>>>        // This function converts a Web Property value from the generic format appropriate for
19603>>>>>>>>>>>>>>>        // transport. For example a data value should be converted from XML transport format 
19603>>>>>>>>>>>>>>>        // for dates. e.g. European "2013-03-24" is converted into "24/03/2013"
19603>>>>>>>>>>>>>>>        //                 USA      "2013-03-24" is converted into "03/24/2013"
19603>>>>>>>>>>>>>>>        // The parameters sName, sValue are the property name and property value being sent from the client.
19603>>>>>>>>>>>>>>>        // Returns the property value that is converted to server format.
19603>>>>>>>>>>>>>>>        // For most properties this function does nothing. You can augment this function to do special
19603>>>>>>>>>>>>>>>        // conversions for new WebProperties that you create.
19603>>>>>>>>>>>>>>>        // See also ConvertToTransport.
19603>>>>>>>>>>>>>>>        String sReturn
19603>>>>>>>>>>>>>>>        Integer eDataType
19603>>>>>>>>>>>>>>>        
19603>>>>>>>>>>>>>>>        Forward Get ConvertFromTransport hmGetter sValue eType to sReturn
19605>>>>>>>>>>>>>>>
19605>>>>>>>>>>>>>>>        // Test for special property "psValue"....
19605>>>>>>>>>>>>>>>        If (hmGetter = RefFunc(psValue)) Begin
19607>>>>>>>>>>>>>>>            // Test if the value represents a number, date or datetime. If so we must convert
19607>>>>>>>>>>>>>>>            // the value into a universal format for transferring it to the client....
19607>>>>>>>>>>>>>>>            Get peDataType to eDataType   // If the object supports psValue it should also support peDataType. If not peDataType will get delegated to ghoWebApp and return typeASCII.
19608>>>>>>>>>>>>>>>            // Note: For efficienty we do not WebGet peDataType! In other words we do not
19608>>>>>>>>>>>>>>>            // get the "synchronized copy of peDataType (if there is one). This is much more
19608>>>>>>>>>>>>>>>            // efficient but it also assumes that a control's peDataType does not change 
19608>>>>>>>>>>>>>>>            // dynamically. This should be OK....
19608>>>>>>>>>>>>>>>            CVTLOCALIZATION ON      //  WebGet turns localization OFF, but for psValue we want it ON as this is a string property
19609>>>>>>>>>>>>>>>                                    //  Note: This means that we have to keep CVTLOCALIZATION private, since we now turn it ON twice 
19609>>>>>>>>>>>>>>>                                    //  while turning it OFF once. That is no problem as it never goes below 0, until other code will start using it.
19609>>>>>>>>>>>>>>>            Move (ConvertFromClient(eDataType, sValue)) to sReturn
19610>>>>>>>>>>>>>>>            
19610>>>>>>>>>>>>>>>        End
19610>>>>>>>>>>>>>>>>
19610>>>>>>>>>>>>>>>        
19610>>>>>>>>>>>>>>>        Function_Return sReturn
19611>>>>>>>>>>>>>>>    End_Function
19612>>>>>>>>>>>>>>>
19612>>>>>>>>>>>>>>>    Function ConvertToTransport Handle hmGetter Variant vValue Integer iType  Returns String
19614>>>>>>>>>>>>>>>        // This function converts a Web Property value into a generic format appropriate for
19614>>>>>>>>>>>>>>>        // transport to the client. For example a data value should be converted into XML transport format 
19614>>>>>>>>>>>>>>>        // for dates. e.g. European "24/03/2013" is converted into "2013-03-24"
19614>>>>>>>>>>>>>>>        //                 USA      "03/24/2013" is converted into "2013-03-24"
19614>>>>>>>>>>>>>>>        // The parameters sName, sValue are the property name and property value being sent to the client.
19614>>>>>>>>>>>>>>>        // Returns the property value that is converted for transport.
19614>>>>>>>>>>>>>>>        // For most properties this function does nothing. You can augment this function to do special
19614>>>>>>>>>>>>>>>        // conversions for new WebProperties that you create.
19614>>>>>>>>>>>>>>>        // See also ConvertFromTransport.
19614>>>>>>>>>>>>>>>        String sReturn
19614>>>>>>>>>>>>>>>        Integer eDataType
19614>>>>>>>>>>>>>>>        
19614>>>>>>>>>>>>>>>        // Test for special property "psValue"....
19614>>>>>>>>>>>>>>>        If (hmGetter = RefFunc(psValue)) Begin
19616>>>>>>>>>>>>>>>            // Test if the value represents a number, date or datetime. If so we must convert
19616>>>>>>>>>>>>>>>            // the value into a universal format for transferring it to the client....
19616>>>>>>>>>>>>>>>            Get peDataType to eDataType   // If the object supports psValue it should also support peDataType. If not peDataType will get delegated to ghoWebApp and return typeASCII.
19617>>>>>>>>>>>>>>>            // Note: For efficienty we do not WebGet peDataType! In other words we do not
19617>>>>>>>>>>>>>>>            // get the "synchronized copy of peDataType (if there is one). This is much more
19617>>>>>>>>>>>>>>>            // efficient but it also assumes that a control's peDataType does not change 
19617>>>>>>>>>>>>>>>            // dynamically. This should be OK....
19617>>>>>>>>>>>>>>>            CVTLOCALIZATION ON      //  SerializeObject turns localization OFF, but for psValue we want it ON as this is a string property
19618>>>>>>>>>>>>>>>                        //  Note: This means that we have to keep CVTLOCALIZATION private, since we now turn it ON twice 
19618>>>>>>>>>>>>>>>                        //  while turning it OFF once. That is no problem as it never goes below 0, until other code will start using it.
19618>>>>>>>>>>>>>>>            Move (ConvertToClient(eDataType, vValue)) to sReturn
19619>>>>>>>>>>>>>>>        End
19619>>>>>>>>>>>>>>>>
19619>>>>>>>>>>>>>>>        Else Begin
19620>>>>>>>>>>>>>>>            Forward Get ConvertToTransport hmGetter vValue iType  to sReturn
19622>>>>>>>>>>>>>>>        End
19622>>>>>>>>>>>>>>>>
19622>>>>>>>>>>>>>>>        
19622>>>>>>>>>>>>>>>        Function_Return sReturn
19623>>>>>>>>>>>>>>>    End_Function
19624>>>>>>>>>>>>>>>    
19624>>>>>>>>>>>>>>>    
19624>>>>>>>>>>>>>>>    // These are needed because Get Data_File and Get Data_Field expects the Item interface to be present
19624>>>>>>>>>>>>>>>    // so these cannot be declared as straight properties.        
19624>>>>>>>>>>>>>>>    Procedure Set Data_File Integer iItem Integer iFile
19626>>>>>>>>>>>>>>>        Set private_Data_File to iFile
19627>>>>>>>>>>>>>>>    End_Procedure
19628>>>>>>>>>>>>>>>    
19628>>>>>>>>>>>>>>>    Procedure Set Data_Field Integer iItem Integer iField
19630>>>>>>>>>>>>>>>        Set private_Data_Field to iField
19631>>>>>>>>>>>>>>>    End_Procedure
19632>>>>>>>>>>>>>>>    
19632>>>>>>>>>>>>>>>    Function Data_File Integer iItem Returns Integer
19634>>>>>>>>>>>>>>>        Function_Return (private_Data_File(Self))
19635>>>>>>>>>>>>>>>    End_Function
19636>>>>>>>>>>>>>>>    
19636>>>>>>>>>>>>>>>    Function Data_Field Integer iItem Returns Integer
19638>>>>>>>>>>>>>>>        Function_Return (private_Data_Field(Self))
19639>>>>>>>>>>>>>>>    End_Function
19640>>>>>>>>>>>>>>>
19640>>>>>>>>>>>>>>>    // Performs an autofind if there is an autofind DD setting and the field is changed.
19640>>>>>>>>>>>>>>>    // As soon as a succuessful autofind occurs, the field is reset.
19640>>>>>>>>>>>>>>>    Procedure DoAutoFind
19642>>>>>>>>>>>>>>>        Integer bChanged eAuto iCur
19642>>>>>>>>>>>>>>>        Handle hoDD hoServer 
19642>>>>>>>>>>>>>>>        Handle[] hoDDs
19643>>>>>>>>>>>>>>>        Integer iFile iField
19643>>>>>>>>>>>>>>>        Boolean bAllowNull bNull bNoFindOnMain
19643>>>>>>>>>>>>>>>        Integer iStat
19643>>>>>>>>>>>>>>>        String sValue
19643>>>>>>>>>>>>>>>        
19643>>>>>>>>>>>>>>>        Get Server to hoServer
19644>>>>>>>>>>>>>>>        Get Data_File  to iFile
19645>>>>>>>>>>>>>>>        Get Data_Field to iField       
19646>>>>>>>>>>>>>>>        
19646>>>>>>>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
19648>>>>>>>>>>>>>>>            
19648>>>>>>>>>>>>>>>            // We only do an autofind check if the DD field value is changed and it is an autofind field
19648>>>>>>>>>>>>>>>                    
19648>>>>>>>>>>>>>>>            Get File_Field_Changed_state of hoServer iFile iField to bChanged
19649>>>>>>>>>>>>>>>            If (bChanged) Begin
19651>>>>>>>>>>>>>>>                Get AutoFindMode to eAuto
19652>>>>>>>>>>>>>>>                If (eAuto<>0) Begin
19654>>>>>>>>>>>>>>>                   Get Which_Data_Set of hoServer iFile to hoDD
19655>>>>>>>>>>>>>>>                   If (hoDD and hoDD<>hoServer) Begin
19657>>>>>>>>>>>>>>>                       Get Field_Current_Value of hoDD iField to sValue
19658>>>>>>>>>>>>>>>                       Get IsEmptyField of hoDD iField sValue to bNull
19659>>>>>>>>>>>>>>>                       // if this is an empty value this may be a null parent. See if the
19659>>>>>>>>>>>>>>>                       // child that is below this parent supports null parents for this file
19659>>>>>>>>>>>>>>>                       If bNull Begin
19661>>>>>>>>>>>>>>>                           Send DDOServerPath of hoServer hoDD (&hoDDs) // if hoDDs returns items, 0 is hoDD and 1 is its child
19662>>>>>>>>>>>>>>>                           If (SizeOfArray(hoDDs)) Begin
19664>>>>>>>>>>>>>>>                              Get IsNullParentAllowed of hoDDs[1] iFile to bAllowNull                    
19665>>>>>>>>>>>>>>>                           End
19665>>>>>>>>>>>>>>>>
19665>>>>>>>>>>>>>>>                       End
19665>>>>>>>>>>>>>>>>
19665>>>>>>>>>>>>>>>                   End
19665>>>>>>>>>>>>>>>>
19665>>>>>>>>>>>>>>>                   Else Begin
19666>>>>>>>>>>>>>>>                        If (not(HasRecord(hoServer))) Begin
19668>>>>>>>>>>>>>>>                            // if a main file autofind, see if we allow this with new records
19668>>>>>>>>>>>>>>>                            Get IsViewNoFindOnMain to bNoFindOnMain
19669>>>>>>>>>>>>>>>                        End
19669>>>>>>>>>>>>>>>>
19669>>>>>>>>>>>>>>>                   End
19669>>>>>>>>>>>>>>>>
19669>>>>>>>>>>>>>>>                   If (bNull and bAllowNull) Begin
19671>>>>>>>>>>>>>>>                        Send Request_ClearBindingTable // if null, do a clear (essentially a find nothing)
19672>>>>>>>>>>>>>>>                   End
19672>>>>>>>>>>>>>>>>
19672>>>>>>>>>>>>>>>                   Else If (bNoFindOnMain) Begin
19675>>>>>>>>>>>>>>>                        // if here, this is the anti-autofind. If an autofind would succeed, it's a duplicate record error 
19675>>>>>>>>>>>>>>>                        // This is used by drilldowns when a find or autofind is not appropriate because it
19675>>>>>>>>>>>>>>>                        // will find a record. This should only occur with new records 
19675>>>>>>>>>>>>>>>                        Clear iFile
19676>>>>>>>>>>>>>>>                        // this will be a deferred (read) find.
19676>>>>>>>>>>>>>>>                        Send File_Field_Find of hoServer EQ iFile iField True False True
19677>>>>>>>>>>>>>>>                        Get_Attribute DF_FILE_STATUS of iFile to iStat
19680>>>>>>>>>>>>>>>                        If (iStat = DF_FILE_ACTIVE) Begin
19682>>>>>>>>>>>>>>>                            Send Data_set_error of hoServer iField DFERR_ENTER_VALID_REC_ID "Duplicate Record Id not allowed"
19683>>>>>>>>>>>>>>>                        End
19683>>>>>>>>>>>>>>>>
19683>>>>>>>>>>>>>>>                        Else Begin
19684>>>>>>>>>>>>>>>                            Send HideAllControlErrors DFERR_ENTER_VALID_REC_ID                             
19685>>>>>>>>>>>>>>>                        End
19685>>>>>>>>>>>>>>>>
19685>>>>>>>>>>>>>>>                   End
19685>>>>>>>>>>>>>>>>
19685>>>>>>>>>>>>>>>                   Else Begin
19686>>>>>>>>>>>>>>>                      Send File_Field_AutoFind of hoServer iFile iField (If(eAuto=amAutoFindGE, GE, EQ)) 
19687>>>>>>>>>>>>>>>                   End
19687>>>>>>>>>>>>>>>>
19687>>>>>>>>>>>>>>>                End
19687>>>>>>>>>>>>>>>>
19687>>>>>>>>>>>>>>>            End
19687>>>>>>>>>>>>>>>>
19687>>>>>>>>>>>>>>>        End
19687>>>>>>>>>>>>>>>>
19687>>>>>>>>>>>>>>>    End_Procedure
19688>>>>>>>>>>>>>>>
19688>>>>>>>>>>>>>>>
19688>>>>>>>>>>>>>>>
19688>>>>>>>>>>>>>>>    // Notify DEO that DDO label has changed.
19688>>>>>>>>>>>>>>>    Procedure File_Field_Label_Changed Integer iFile Integer iField Boolean bLong String sLabel
19690>>>>>>>>>>>>>>>        // Do nothing
19690>>>>>>>>>>>>>>>    End_Procedure  
19691>>>>>>>>>>>>>>>    
19691>>>>>>>>>>>>>>>
19691>>>>>>>>>>>>>>>    // Notify DEO that DDO mask has changed.
19691>>>>>>>>>>>>>>>    Procedure File_Field_Mask_Changed Integer iFile Integer iField String sMask
19693>>>>>>>>>>>>>>>        // Do nothing
19693>>>>>>>>>>>>>>>    End_Procedure  
19694>>>>>>>>>>>>>>>    
19694>>>>>>>>>>>>>>>    //  Notify DEO that a field option has changed in the DDO.
19694>>>>>>>>>>>>>>>    Procedure File_Field_Option_Changed Integer iFile Integer iField Integer iOptions Integer bClear
19696>>>>>>>>>>>>>>>        // Do nothing
19696>>>>>>>>>>>>>>>    End_Procedure
19697>>>>>>>>>>>>>>>    
19697>>>>>>>>>>>>>>>    
19697>>>>>>>>>>>>>>>    // Sent by DDOs to all DEOs whenever a DDO file/field value is changed.
19697>>>>>>>>>>>>>>>    // If the file/filed value matches then it means this DEO is attached to
19697>>>>>>>>>>>>>>>    // the same file/Field that got changed. Set the Object's synchronized 
19697>>>>>>>>>>>>>>>    // psValue according to the passed value.
19697>>>>>>>>>>>>>>>    Procedure File_Field_Value_Changed Integer iFile Integer iField String sValue Integer iChangeDisabled
19699>>>>>>>>>>>>>>>        Integer iDataFile iDataField
19699>>>>>>>>>>>>>>>        Boolean bSynchingFieldDefaults
19699>>>>>>>>>>>>>>>        
19699>>>>>>>>>>>>>>>        // Protect agains re-entrant calls....
19699>>>>>>>>>>>>>>>        If (private_pbIgnoreOnValueChanged(Self)) Begin
19701>>>>>>>>>>>>>>>            Procedure_Return
19702>>>>>>>>>>>>>>>        End
19702>>>>>>>>>>>>>>>>
19702>>>>>>>>>>>>>>>        
19702>>>>>>>>>>>>>>>        // Do not process if this was triggered during synching of DD field defaults...
19702>>>>>>>>>>>>>>>        Delegate Get SynchingFieldDefaults to bSynchingFieldDefaults
19704>>>>>>>>>>>>>>>        If (bSynchingFieldDefaults) Begin
19706>>>>>>>>>>>>>>>            Procedure_Return
19707>>>>>>>>>>>>>>>        End
19707>>>>>>>>>>>>>>>>
19707>>>>>>>>>>>>>>>        
19707>>>>>>>>>>>>>>>        Get Data_File to iDataFile
19708>>>>>>>>>>>>>>>
19708>>>>>>>>>>>>>>>        If (iDataFile = iFile) Begin
19710>>>>>>>>>>>>>>>            Get Data_Field to iDataField
19711>>>>>>>>>>>>>>>            
19711>>>>>>>>>>>>>>>            If (iDataField = iField) Begin
19713>>>>>>>>>>>>>>>                WebSet psValue to sValue
19714>>>>>>>>>>>>>>>                Send HideAllControlErrors
19715>>>>>>>>>>>>>>>                If not iChangeDisabled Begin
19717>>>>>>>>>>>>>>>                    WebSet pbChanged to True
19718>>>>>>>>>>>>>>>                End
19718>>>>>>>>>>>>>>>>
19718>>>>>>>>>>>>>>>                Else Begin
19719>>>>>>>>>>>>>>>                    WebSet pbFieldDefault to True
19720>>>>>>>>>>>>>>>                End
19720>>>>>>>>>>>>>>>>
19720>>>>>>>>>>>>>>>            End
19720>>>>>>>>>>>>>>>>
19720>>>>>>>>>>>>>>>        End
19720>>>>>>>>>>>>>>>>
19720>>>>>>>>>>>>>>>    End_Procedure
19721>>>>>>>>>>>>>>>
19721>>>>>>>>>>>>>>>
19721>>>>>>>>>>>>>>>    Procedure File_Field_Pointer_Value_Changed Integer iFile Integer iField Pointer pValue Integer iChangeDisabled
19723>>>>>>>>>>>>>>>        // called by the DD to support text fields?
19723>>>>>>>>>>>>>>>        Integer iDataFile iDataField
19723>>>>>>>>>>>>>>>        String sValue
19723>>>>>>>>>>>>>>>        
19723>>>>>>>>>>>>>>>        If (private_pbIgnoreOnValueChanged(Self)) Begin
19725>>>>>>>>>>>>>>>            Procedure_Return
19726>>>>>>>>>>>>>>>        End
19726>>>>>>>>>>>>>>>>
19726>>>>>>>>>>>>>>>        
19726>>>>>>>>>>>>>>>        Get Data_File to iDataFile
19727>>>>>>>>>>>>>>>
19727>>>>>>>>>>>>>>>        If (iDataFile = iFile) Begin
19729>>>>>>>>>>>>>>>            Get Data_Field to iDataField
19730>>>>>>>>>>>>>>>            
19730>>>>>>>>>>>>>>>            If (iDataField = iField) Begin
19732>>>>>>>>>>>>>>>                Move (PointerToString(pValue)) to sValue    // get the string at this pointer value
19733>>>>>>>>>>>>>>>                WebSet psValue to sValue
19734>>>>>>>>>>>>>>>                Send HideAllControlErrors
19735>>>>>>>>>>>>>>>                
19735>>>>>>>>>>>>>>>                If (not(iChangeDisabled)) Begin
19737>>>>>>>>>>>>>>>                    WebSet pbChanged to True
19738>>>>>>>>>>>>>>>                End
19738>>>>>>>>>>>>>>>>
19738>>>>>>>>>>>>>>>                Else Begin
19739>>>>>>>>>>>>>>>                    WebSet pbFieldDefault to True
19740>>>>>>>>>>>>>>>                End
19740>>>>>>>>>>>>>>>>
19740>>>>>>>>>>>>>>>            End
19740>>>>>>>>>>>>>>>>
19740>>>>>>>>>>>>>>>        End
19740>>>>>>>>>>>>>>>>
19740>>>>>>>>>>>>>>>    End_Procedure
19741>>>>>>>>>>>>>>>
19741>>>>>>>>>>>>>>>    // Returns True if the table column is configured to be "commitable".
19741>>>>>>>>>>>>>>>    // i.e. once saved should not be changed.
19741>>>>>>>>>>>>>>>    Function IsCommitable Returns Boolean
19743>>>>>>>>>>>>>>>        Integer iFile iField iDDOOptions
19743>>>>>>>>>>>>>>>        Integer iClients iClient iMain
19743>>>>>>>>>>>>>>>        Handle hoServer hoOwner hoChild     
19743>>>>>>>>>>>>>>>        Boolean bCommitable
19743>>>>>>>>>>>>>>>        
19743>>>>>>>>>>>>>>>        Get Data_File to iFile
19744>>>>>>>>>>>>>>>        Get Data_Field to iField
19745>>>>>>>>>>>>>>>        Get Server to hoServer
19746>>>>>>>>>>>>>>>        Move False to bCommitable
19747>>>>>>>>>>>>>>>        
19747>>>>>>>>>>>>>>>        If (iFile and hoServer) Begin
19749>>>>>>>>>>>>>>>            // the purpose is to determine if this is a commitable field....
19749>>>>>>>>>>>>>>>            Get Which_Data_Set of hoServer iFile to hoOwner
19750>>>>>>>>>>>>>>>            
19750>>>>>>>>>>>>>>>            // if this is the main file, we check the DD_Commit flag....
19750>>>>>>>>>>>>>>>            If (hoOwner = hoServer) Begin 
19752>>>>>>>>>>>>>>>                Get File_Field_Options of hoServer iFile iField to iDDOOptions
19753>>>>>>>>>>>>>>>                Move (IsFlagIn(DD_COMMIT, iDDOOptions)) to bCommitable
19754>>>>>>>>>>>>>>>            End
19754>>>>>>>>>>>>>>>>
19754>>>>>>>>>>>>>>>            // if this is a parent, we test for a child NoSwitchIfCommitted flag
19754>>>>>>>>>>>>>>>            Else If (hoOwner) Begin
19757>>>>>>>>>>>>>>>                Get Data_Set_Client_Count of hoOwner to iClients
19758>>>>>>>>>>>>>>>                Get Main_File of hoOwner to iMain
19759>>>>>>>>>>>>>>>                Move 0 to iClient
19760>>>>>>>>>>>>>>>                
19760>>>>>>>>>>>>>>>                While (not(bCommitable) and iClient < iClients)
19764>>>>>>>>>>>>>>>                    Get Data_Set_Client of hoOwner iClient to hoChild
19765>>>>>>>>>>>>>>>                    Get ParentNoSwitchIfCommitted of hoChild iMain to bCommitable
19766>>>>>>>>>>>>>>>                    Increment iClient
19767>>>>>>>>>>>>>>>                Loop
19768>>>>>>>>>>>>>>>>
19768>>>>>>>>>>>>>>>            End
19768>>>>>>>>>>>>>>>>
19768>>>>>>>>>>>>>>>        End
19768>>>>>>>>>>>>>>>>
19768>>>>>>>>>>>>>>>        
19768>>>>>>>>>>>>>>>        Function_Return bCommitable
19769>>>>>>>>>>>>>>>    End_Function
19770>>>>>>>>>>>>>>>
19770>>>>>>>>>>>>>>>
19770>>>>>>>>>>>>>>>    // If there is no data binding (no Entry_Item command) but the DEO is served by a DDO then the DEO is 
19770>>>>>>>>>>>>>>>    // a calculated value. The initial data is filled by sending the OnSetCalculatedValue event. This is fired
19770>>>>>>>>>>>>>>>    // whenever the DDO performs a find, clear or delete operation.
19770>>>>>>>>>>>>>>>    //
19770>>>>>>>>>>>>>>>    // sValue - [out] a ByRef value which this event should fill with the calculated value.
19770>>>>>>>>>>>>>>>    Procedure OnSetCalculatedValue String ByRef sValue
19772>>>>>>>>>>>>>>>        // To be augmented by the user
19772>>>>>>>>>>>>>>>    End_Procedure
19773>>>>>>>>>>>>>>>    
19773>>>>>>>>>>>>>>>    // call to invoke a prompt list
19773>>>>>>>>>>>>>>>    // with drilldown apps, we always returns 0 for PromptObject and we 
19773>>>>>>>>>>>>>>>    // always do nothing with prompt. We expect you to handle this all via
19773>>>>>>>>>>>>>>>    // pbPromptButton and OnPrompt. This resolves forward reference issues and
19773>>>>>>>>>>>>>>>    // in the long run is more flexible
19773>>>>>>>>>>>>>>>    Procedure Prompt
19775>>>>>>>>>>>>>>>        Handle hoPrompt
19775>>>>>>>>>>>>>>>        Integer eStyle
19775>>>>>>>>>>>>>>>        Delegate Get WebViewStyle to eStyle
19777>>>>>>>>>>>>>>>        If (eStyle=wvsDesktop or eStyle=wvsDialog) Begin
19779>>>>>>>>>>>>>>>            Get PromptObject to hoPrompt
19780>>>>>>>>>>>>>>>            If hoPrompt Begin
19782>>>>>>>>>>>>>>>                Get WebViewStyle of hoPrompt to eStyle
19783>>>>>>>>>>>>>>>                If (eStyle =wvsDrillDown) Begin
19785>>>>>>>>>>>>>>>                    Error DFERR_PROGRAM "Cannot Prompt to a drill down object from a desktop view"
19786>>>>>>>>>>>>>>>>
19786>>>>>>>>>>>>>>>                End
19786>>>>>>>>>>>>>>>>
19786>>>>>>>>>>>>>>>                Else Begin
19787>>>>>>>>>>>>>>>                    Send Popup of hoPrompt Self
19788>>>>>>>>>>>>>>>                End
19788>>>>>>>>>>>>>>>>
19788>>>>>>>>>>>>>>>            end
19788>>>>>>>>>>>>>>>>
19788>>>>>>>>>>>>>>>        End
19788>>>>>>>>>>>>>>>>
19788>>>>>>>>>>>>>>>    End_Procedure
19789>>>>>>>>>>>>>>>
19789>>>>>>>>>>>>>>>    // called by prompt lists as part of callback to customize a list
19789>>>>>>>>>>>>>>>    Procedure Prompt_Callback Handle hoPrompt
19791>>>>>>>>>>>>>>>    End_Procedure
19792>>>>>>>>>>>>>>>
19792>>>>>>>>>>>>>>>    // returns PromptObject. returns phoPrompt
19792>>>>>>>>>>>>>>>    Function PromptObject Returns Handle
19794>>>>>>>>>>>>>>>        Handle hoPrompt
19794>>>>>>>>>>>>>>>        Integer eStyle
19794>>>>>>>>>>>>>>>        Delegate Get WebViewStyle to eStyle
19796>>>>>>>>>>>>>>>        If (eStyle = wvsDesktop or eStyle=wvsDialog) Begin
19798>>>>>>>>>>>>>>>            Get phoPrompt to hoPrompt
19799>>>>>>>>>>>>>>>        End
19799>>>>>>>>>>>>>>>>
19799>>>>>>>>>>>>>>>        Function_Return hoPrompt
19800>>>>>>>>>>>>>>>    End_Function    
19801>>>>>>>>>>>>>>>   
19801>>>>>>>>>>>>>>>    
19801>>>>>>>>>>>>>>>    // Sent by DDO when there is a clear/find/save/delete.
19801>>>>>>>>>>>>>>>    // This should Set all necessary web properties of the control
19801>>>>>>>>>>>>>>>    // For example psValue, pbEnabled, pbChanged.
19801>>>>>>>>>>>>>>>    //
19801>>>>>>>>>>>>>>>    // eMode - Determines the type of DDO operation which generated this refresh message. 
19801>>>>>>>>>>>>>>>    //         It may be one of the following:
19801>>>>>>>>>>>>>>>    //         Mode_Clear:             Used only for DEOs attached to the DDO that was the
19801>>>>>>>>>>>>>>>    //                                 "origin" of a Clear operation, (i.e., the DDO received
19801>>>>>>>>>>>>>>>    //                                 the original Clear message). All other DDOs Send their 
19801>>>>>>>>>>>>>>>    //                                 DEOs the refresh message passing mode_find_or_clear_set.  
19801>>>>>>>>>>>>>>>    //         Mode_Find_or_Clear_Set: Used for DEOs attached to DDOs which have Found and/or cleared records.  
19801>>>>>>>>>>>>>>>    //         Mode_Clear_All:         Used for DEOs attached to any DDO that participated in a clear_all operation.  
19801>>>>>>>>>>>>>>>    //         Mode_Delete:            Used for DEOs attached to any DDO that performed a successful deletion. 
19801>>>>>>>>>>>>>>>    //                                 DDOs that were merely updated as the result of a deletion Use Mode_Find_or_Clear_Set.  
19801>>>>>>>>>>>>>>>    //         Mode_Save:              Used for DEOs attached to any DDO involved in a successful Save operation. 
19801>>>>>>>>>>>>>>>    Procedure Refresh Integer eMode
19803>>>>>>>>>>>>>>>        Handle hoDDO
19803>>>>>>>>>>>>>>>        Integer iFile iField iDDOOptions eRTS eDataType
19803>>>>>>>>>>>>>>>        Boolean bActive bAppSynching bNoEnter bCommitable
19803>>>>>>>>>>>>>>>        Boolean bFieldChanged
19803>>>>>>>>>>>>>>>        String sValue sOldValue
19803>>>>>>>>>>>>>>>        Time tTimeVal tTimeNull
19803>>>>>>>>>>>>>>>        
19803>>>>>>>>>>>>>>>        Forward Send Refresh eMode
19805>>>>>>>>>>>>>>>        
19805>>>>>>>>>>>>>>>        Get Active_State to bActive
19806>>>>>>>>>>>>>>>        Get AppSynching of (Host(Self)) to bAppSynching
19807>>>>>>>>>>>>>>>    
19807>>>>>>>>>>>>>>>        If (bActive and not(bAppSynching)) Begin
19809>>>>>>>>>>>>>>>            Get Server to hoDDO
19810>>>>>>>>>>>>>>>            Get Data_File to iFile
19811>>>>>>>>>>>>>>>            Get Data_Field to iField
19812>>>>>>>>>>>>>>>            
19812>>>>>>>>>>>>>>>            Case Begin
19812>>>>>>>>>>>>>>>                Case (eMode = MODE_FIND_OR_CLEAR_SET)
19814>>>>>>>>>>>>>>>                Case (eMode = MODE_CLEAR)
19817>>>>>>>>>>>>>>>                Case (eMode = MODE_CLEAR_ALL)
19820>>>>>>>>>>>>>>>                Case (eMode = MODE_DELETE)
19823>>>>>>>>>>>>>>>                Case (eMode = MODE_SAVE)
19826>>>>>>>>>>>>>>>                    If (iFile <> 0) Begin
19828>>>>>>>>>>>>>>>                        Get DDRefreshTableStatus iFile to eRTS // see if this table is part of the DD's request
19829>>>>>>>>>>>>>>>    
19829>>>>>>>>>>>>>>>                        If (eRTS <> ddrtsNone or eMode = MODE_CLEAR_ALL or eMode = MODE_FIND_OR_CLEAR_SET) Begin
19831>>>>>>>>>>>>>>>                            // Handle dynamic switching of Enabled_State. This would only happen if the
19831>>>>>>>>>>>>>>>                            // file/field is commitable in the DDO....
19831>>>>>>>>>>>>>>>                            // only do commit check if the field is design-time enabled
19831>>>>>>>>>>>>>>>                            If (pbEnabled(Self)) Begin
19833>>>>>>>>>>>>>>>                                Send SetDynamicEnabled
19834>>>>>>>>>>>>>>>                            End            
19834>>>>>>>>>>>>>>>>
19834>>>>>>>>>>>>>>>                            
19834>>>>>>>>>>>>>>>                            //  Do security check
19834>>>>>>>>>>>>>>>                            If (not(FillDEOAllowed(Self))) Begin
19836>>>>>>>>>>>>>>>                                Procedure_Return
19837>>>>>>>>>>>>>>>                            End
19837>>>>>>>>>>>>>>>>
19837>>>>>>>>>>>>>>>                            
19837>>>>>>>>>>>>>>>                            // Refresh should read from the global file buffers unless doing a clear and there are
19837>>>>>>>>>>>>>>>                            // default values waiting in the DDO buffer....
19837>>>>>>>>>>>>>>>    
19837>>>>>>>>>>>>>>>                            If (eRTS = ddrtsCleared or eMode = MODE_CLEAR_ALL) Begin
19839>>>>>>>>>>>>>>>                                // if the DD's field changed state is true, we must have a default value to use
19839>>>>>>>>>>>>>>>                                Get File_Field_Changed_State of hoDDO iFile iField to bFieldChanged
19840>>>>>>>>>>>>>>>                            End
19840>>>>>>>>>>>>>>>>
19840>>>>>>>>>>>>>>>                            Else Begin
19841>>>>>>>>>>>>>>>                                Move False to bFieldChanged
19842>>>>>>>>>>>>>>>                            End
19842>>>>>>>>>>>>>>>>
19842>>>>>>>>>>>>>>>            
19842>>>>>>>>>>>>>>>                            If (bFieldChanged) Begin
19844>>>>>>>>>>>>>>>                                // The DD buffer value has changed after a clear. That means there is a default
19844>>>>>>>>>>>>>>>                                // value to read from the DDO buffer....
19844>>>>>>>>>>>>>>>                                Get File_Field_Current_Value of hoDDO iFile iField to sValue
19845>>>>>>>>>>>>>>>                            End
19845>>>>>>>>>>>>>>>>
19845>>>>>>>>>>>>>>>                            Else Begin
19846>>>>>>>>>>>>>>>                                // In all other cases we read the value directly from the file buffer....
19846>>>>>>>>>>>>>>>                                Get_Field_Value iFile iField to sValue 
19849>>>>>>>>>>>>>>>                                
19849>>>>>>>>>>>>>>>                                // If this was a DDO Clear and the value is "0" for a numeric field
19849>>>>>>>>>>>>>>>                                // then we will Set psValue to "" instead of "0". This simulates 
19849>>>>>>>>>>>>>>>                                // Windows DEO behavior.
19849>>>>>>>>>>>>>>>                                If (eRTS = ddrtsCleared) Begin
19851>>>>>>>>>>>>>>>                                    Get peDataType to eDataType   // If the object supports psValue it should also support peDataType. If not peDataType will get delegated to ghoWebApp and return typeASCII.
19852>>>>>>>>>>>>>>>                                    
19852>>>>>>>>>>>>>>>                                    If (eDataType = typeNumber and Number(sValue) = 0) Begin
19854>>>>>>>>>>>>>>>                                        Move "" to sValue
19855>>>>>>>>>>>>>>>                                    End
19855>>>>>>>>>>>>>>>>
19855>>>>>>>>>>>>>>>                                    
19855>>>>>>>>>>>>>>>                                    If (eDataType = typeTime) Begin
19857>>>>>>>>>>>>>>>                                        Move (NullDateTime()) to tTimeNull
19858>>>>>>>>>>>>>>>                                        Move sValue to tTimeVal
19859>>>>>>>>>>>>>>>                                        If (tTimeNull = tTimeVal) Begin
19861>>>>>>>>>>>>>>>                                            Move "" to sValue
19862>>>>>>>>>>>>>>>                                        End
19862>>>>>>>>>>>>>>>>
19862>>>>>>>>>>>>>>>                                    End
19862>>>>>>>>>>>>>>>>
19862>>>>>>>>>>>>>>>                                End
19862>>>>>>>>>>>>>>>>
19862>>>>>>>>>>>>>>>                            End
19862>>>>>>>>>>>>>>>>
19862>>>>>>>>>>>>>>>                        
19862>>>>>>>>>>>>>>>                            Move (Rtrim(sValue)) to sValue
19863>>>>>>>>>>>>>>>                           
19863>>>>>>>>>>>>>>>    
19863>>>>>>>>>>>>>>>                            // Set the value and changed flag web properties....
19863>>>>>>>>>>>>>>>                            Send HideAllControlErrors
19864>>>>>>>>>>>>>>>                            WebSet psValue to sValue
19865>>>>>>>>>>>>>>>                            WebSet pbChanged to False
19866>>>>>>>>>>>>>>>                            WebSet pbFieldDefault to bFieldChanged // if true, a default is set
19867>>>>>>>>>>>>>>>                        End
19867>>>>>>>>>>>>>>>>
19867>>>>>>>>>>>>>>>                    End
19867>>>>>>>>>>>>>>>>
19867>>>>>>>>>>>>>>>                    Else Begin
19868>>>>>>>>>>>>>>>                        WebGet psValue to sValue
19869>>>>>>>>>>>>>>>                        Move sValue to sOldValue
19870>>>>>>>>>>>>>>>                        Send OnSetCalculatedValue (&sValue)
19871>>>>>>>>>>>>>>>                
19871>>>>>>>>>>>>>>>                        // Set the value and changed flag web properties. In the case of a Clear
19871>>>>>>>>>>>>>>>                        // we will unconditionally set the value/changed flag because a clear always
19871>>>>>>>>>>>>>>>                        // occurs during InitForShow. During InitForShow we have no idea what is 
19871>>>>>>>>>>>>>>>                        // stored on the client so therefore we must make sure that the cleared
19871>>>>>>>>>>>>>>>                        // value is forced to update the client otherwise the current client value
19871>>>>>>>>>>>>>>>                        // would just stay there. 
19871>>>>>>>>>>>>>>>                        If (sValue <> sOldValue or eMode = MODE_CLEAR_ALL) Begin
19873>>>>>>>>>>>>>>>                            WebSet psValue to sValue
19874>>>>>>>>>>>>>>>                            WebSet pbChanged to False
19875>>>>>>>>>>>>>>>                            WebSet pbFieldDefault to False
19876>>>>>>>>>>>>>>>                        End
19876>>>>>>>>>>>>>>>>
19876>>>>>>>>>>>>>>>                    End
19876>>>>>>>>>>>>>>>>
19876>>>>>>>>>>>>>>>                    Case Break
19877>>>>>>>>>>>>>>>            Case End
19877>>>>>>>>>>>>>>>        End
19877>>>>>>>>>>>>>>>>
19877>>>>>>>>>>>>>>>    End_Procedure
19878>>>>>>>>>>>>>>>    
19878>>>>>>>>>>>>>>>    /*    Refresh event during intialization of FlexTron controls. Latches onto the current record buffer     which may not have been recently found.    */
19878>>>>>>>>>>>>>>>    Procedure InitialRefresh
19880>>>>>>>>>>>>>>>        Send Refresh MODE_FIND_OR_CLEAR_SET
19881>>>>>>>>>>>>>>>    End_Procedure
19882>>>>>>>>>>>>>>>    
19882>>>>>>>>>>>>>>>    // helper function returns true if any child DDO relates to this
19882>>>>>>>>>>>>>>>    Function IsConstrainingParent Handle hoDDO Returns Boolean
19884>>>>>>>>>>>>>>>        Integer iClients i iFile
19884>>>>>>>>>>>>>>>        Handle hoClient
19884>>>>>>>>>>>>>>>        Boolean bRelates
19884>>>>>>>>>>>>>>>        Get Main_File of hoDDO to iFile
19885>>>>>>>>>>>>>>>        Get Data_Set_Client_Count of hoDDO to iClients
19886>>>>>>>>>>>>>>>        For i from 0 to (iClients-1)
19892>>>>>>>>>>>>>>>>
19892>>>>>>>>>>>>>>>            Get Data_Set_Client of hoDDO i to hoClient
19893>>>>>>>>>>>>>>>            Get IsRelatesToConstrained of hoClient iFile to bRelates
19894>>>>>>>>>>>>>>>            If bRelates Begin
19896>>>>>>>>>>>>>>>                Function_Return True
19897>>>>>>>>>>>>>>>            End
19897>>>>>>>>>>>>>>>>
19897>>>>>>>>>>>>>>>        Loop
19898>>>>>>>>>>>>>>>>
19898>>>>>>>>>>>>>>>        Function_Return False
19899>>>>>>>>>>>>>>>    End_Function
19900>>>>>>>>>>>>>>>    
19900>>>>>>>>>>>>>>>    // returns true if control supports prompt buttons and the prompt button
19900>>>>>>>>>>>>>>>    // default property value (not webproperty) is enabled. Augmented in cWebBaseForm 
19900>>>>>>>>>>>>>>>    Function HasPromptButton Returns Boolean
19902>>>>>>>>>>>>>>>        Function_Return False
19903>>>>>>>>>>>>>>>    End_Function
19904>>>>>>>>>>>>>>>    
19904>>>>>>>>>>>>>>>    // this figures out if a control *should* be dynamically enabled/disabled.
19904>>>>>>>>>>>>>>>    // Typically used by SetDynamicEnabled to webset pbEnabled but can be called
19904>>>>>>>>>>>>>>>    // at any time.
19904>>>>>>>>>>>>>>>    Function IsDynamicEnabled Returns Boolean
19906>>>>>>>>>>>>>>>        Handle hoServer
19906>>>>>>>>>>>>>>>        Handle hoDDO
19906>>>>>>>>>>>>>>>        Integer iFile iField
19906>>>>>>>>>>>>>>>        Boolean bHasRecord bNoEnter bNoPut bKeyField bDisable bAutoFind bAutoFindGe 
19906>>>>>>>>>>>>>>>        Boolean bCommitable bNoFind bIsReadOnly bPromptButton
19906>>>>>>>>>>>>>>>        Integer iDDOOptions
19906>>>>>>>>>>>>>>>    
19906>>>>>>>>>>>>>>>        Get Server to hoServer
19907>>>>>>>>>>>>>>>        Get Data_File to iFile        
19908>>>>>>>>>>>>>>>        Get Data_Field to iField        
19909>>>>>>>>>>>>>>>        If (not(hoServer) or not (iFile)) Begin
19911>>>>>>>>>>>>>>>            Error DFERR_PROGRAM "Server / Data_File required"
19912>>>>>>>>>>>>>>>>
19912>>>>>>>>>>>>>>>            Function_Return True
19913>>>>>>>>>>>>>>>        End
19913>>>>>>>>>>>>>>>>
19913>>>>>>>>>>>>>>>    
19913>>>>>>>>>>>>>>>        Get IsViewReadOnly to bIsReadOnly
19914>>>>>>>>>>>>>>>        
19914>>>>>>>>>>>>>>>        If (bIsReadOnly) Begin
19916>>>>>>>>>>>>>>>            Move True to bDisable                      
19917>>>>>>>>>>>>>>>        End
19917>>>>>>>>>>>>>>>>
19917>>>>>>>>>>>>>>>        Else Begin
19918>>>>>>>>>>>>>>>            Get Data_Set of hoServer iFile to hoDDO
19919>>>>>>>>>>>>>>>            
19919>>>>>>>>>>>>>>>            If (not(hoDDO)) Begin
19921>>>>>>>>>>>>>>>                Error DFERR_PROGRAM "DDO for binding data_file not found"
19922>>>>>>>>>>>>>>>>
19922>>>>>>>>>>>>>>>                Function_Return True
19923>>>>>>>>>>>>>>>            End
19923>>>>>>>>>>>>>>>>
19923>>>>>>>>>>>>>>>            
19923>>>>>>>>>>>>>>>            // this will handle main and foreign options but not commit options
19923>>>>>>>>>>>>>>>            Get File_Field_Options of hoServer iFile iField to iDDOOptions
19924>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_NoEnter, iDDOOptions)) to bNoEnter
19925>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_NoPut, iDDOOptions)) to bNoPut
19926>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_AUTOFIND, iDDOOptions)) to bAutoFind
19927>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_AUTOFIND_GE, iDDOOptions)) to bAutoFindGe
19928>>>>>>>>>>>>>>>            Get HasPromptButton to bPromptButton
19929>>>>>>>>>>>>>>>            
19929>>>>>>>>>>>>>>>            // if main file ddo
19929>>>>>>>>>>>>>>>            If (hoServer = hoDDO) Begin
19931>>>>>>>>>>>>>>>                Get IsViewNoFindOnMain to bNoFind
19932>>>>>>>>>>>>>>>                Get HasRecord of hoServer to bHasRecord
19933>>>>>>>>>>>>>>>                Get Key_Field_State of hoServer iField to bKeyField
19934>>>>>>>>>>>>>>>                If (bNoEnter) Begin
19936>>>>>>>>>>>>>>>                    Move True to bDisable                      
19937>>>>>>>>>>>>>>>                End
19937>>>>>>>>>>>>>>>>
19937>>>>>>>>>>>>>>>                Else If (bHasRecord and bNoFind and (bNoPut or bKeyField or bAutoFind or bAutoFindGe)) Begin
19940>>>>>>>>>>>>>>>                    Move True to bDisable                      
19941>>>>>>>>>>>>>>>                End
19941>>>>>>>>>>>>>>>>
19941>>>>>>>>>>>>>>>                Else If (not(bHasRecord) and bNoFind and bNoPut) Begin
19944>>>>>>>>>>>>>>>                    Move True to bDisable 
19945>>>>>>>>>>>>>>>                End
19945>>>>>>>>>>>>>>>>
19945>>>>>>>>>>>>>>>                Else Begin
19946>>>>>>>>>>>>>>>                    Get IsCommitable to bCommitable
19947>>>>>>>>>>>>>>>                    If (bCommitable) Begin
19949>>>>>>>>>>>>>>>                        Get File_Field_Committed_Options of hoServer iFile iField to iDDOOptions  // possible NoPut, NoEnter additions
19950>>>>>>>>>>>>>>>                        If bNoFind Begin
19952>>>>>>>>>>>>>>>                            Move (iDDOOptions) to bDisable
19953>>>>>>>>>>>>>>>                        End
19953>>>>>>>>>>>>>>>>
19953>>>>>>>>>>>>>>>                        Else Begin
19954>>>>>>>>>>>>>>>                            Move (IsFlagIn(DD_NoEnter, iDDOOptions)) to bDisable
19955>>>>>>>>>>>>>>>                        End
19955>>>>>>>>>>>>>>>>
19955>>>>>>>>>>>>>>>                    End
19955>>>>>>>>>>>>>>>>
19955>>>>>>>>>>>>>>>                End
19955>>>>>>>>>>>>>>>>
19955>>>>>>>>>>>>>>>            End
19955>>>>>>>>>>>>>>>>
19955>>>>>>>>>>>>>>>            // if parent
19955>>>>>>>>>>>>>>>            Else Begin
19956>>>>>>>>>>>>>>>                If (bNoEnter) Begin
19958>>>>>>>>>>>>>>>                    Move True to bDisable
19959>>>>>>>>>>>>>>>                End
19959>>>>>>>>>>>>>>>>
19959>>>>>>>>>>>>>>>                If (bNoPut and not(bPromptButton)) Begin
19961>>>>>>>>>>>>>>>                    Move True to bDisable
19962>>>>>>>>>>>>>>>                End
19962>>>>>>>>>>>>>>>>
19962>>>>>>>>>>>>>>>                Else Begin
19963>>>>>>>>>>>>>>>                    Get IsViewNoFindOnConstrainedParent to bNoFind
19964>>>>>>>>>>>>>>>                    If bNoFind Begin
19966>>>>>>>>>>>>>>>                        Get IsConstrainingParent hoDDO to bDisable
19967>>>>>>>>>>>>>>>                    End
19967>>>>>>>>>>>>>>>>
19967>>>>>>>>>>>>>>>                    If not bDisable Begin
19969>>>>>>>>>>>>>>>                        Get IsCommitable to bCommitable
19970>>>>>>>>>>>>>>>                        If (bCommitable) Begin
19972>>>>>>>>>>>>>>>                            Get File_Field_Committed_Options of hoServer iFile iField to iDDOOptions  // possible NoPut, NoEnter additions
19973>>>>>>>>>>>>>>>                            Move (IsFlagIn(DD_NoEnter, iDDOOptions)) to bDisable
19974>>>>>>>>>>>>>>>                        End
19974>>>>>>>>>>>>>>>>
19974>>>>>>>>>>>>>>>                    End
19974>>>>>>>>>>>>>>>>
19974>>>>>>>>>>>>>>>                End
19974>>>>>>>>>>>>>>>>
19974>>>>>>>>>>>>>>>            End
19974>>>>>>>>>>>>>>>>
19974>>>>>>>>>>>>>>>        End
19974>>>>>>>>>>>>>>>>
19974>>>>>>>>>>>>>>>        Function_Return bDisable
19975>>>>>>>>>>>>>>>    End_Function
19976>>>>>>>>>>>>>>>    
19976>>>>>>>>>>>>>>>    Procedure SetDynamicEnabledDesktopStyle
19978>>>>>>>>>>>>>>>        Handle hoServer
19978>>>>>>>>>>>>>>>        Integer iFile iField iDDOOPtions
19978>>>>>>>>>>>>>>>        Boolean bDisable bNoEnter bCommitable
19978>>>>>>>>>>>>>>>        
19978>>>>>>>>>>>>>>>        Get Server to hoServer
19979>>>>>>>>>>>>>>>        Get Data_File to iFile        
19980>>>>>>>>>>>>>>>        If (not(hoServer) or not (iFile)) Begin
19982>>>>>>>>>>>>>>>            Procedure_Return
19983>>>>>>>>>>>>>>>        End
19983>>>>>>>>>>>>>>>>
19983>>>>>>>>>>>>>>>        
19983>>>>>>>>>>>>>>>        Get IsCommitable to bCommitable
19984>>>>>>>>>>>>>>>        If (bCommitable) Begin
19986>>>>>>>>>>>>>>>            Get Data_Field to iField
19987>>>>>>>>>>>>>>>            Get File_Field_DynamicEntryOptions of hoServer iFile iField to iDDOOptions
19988>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_NoEnter, iDDOOptions)) to bNoEnter
19989>>>>>>>>>>>>>>>            WebSet pbEnabled to (not(bNoEnter))
19990>>>>>>>>>>>>>>>        End
19990>>>>>>>>>>>>>>>>
19990>>>>>>>>>>>>>>>    End_Procedure
19991>>>>>>>>>>>>>>>
19991>>>>>>>>>>>>>>>    Procedure SetDynamicEnabledDrillDownStyle
19993>>>>>>>>>>>>>>>        Handle hoServer
19993>>>>>>>>>>>>>>>        Integer iFile
19993>>>>>>>>>>>>>>>        Boolean bDisable
19993>>>>>>>>>>>>>>>        Get Server to hoServer
19994>>>>>>>>>>>>>>>        Get Data_File to iFile        
19995>>>>>>>>>>>>>>>        If (not(hoServer) or not (iFile)) Begin
19997>>>>>>>>>>>>>>>            Procedure_Return
19998>>>>>>>>>>>>>>>        End
19998>>>>>>>>>>>>>>>>
19998>>>>>>>>>>>>>>>        
19998>>>>>>>>>>>>>>>        Get IsDynamicEnabled to bDisable
19999>>>>>>>>>>>>>>>        WebSet pbEnabled to (not(bDisable))
20000>>>>>>>>>>>>>>>    End_Procedure
20001>>>>>>>>>>>>>>>    
20001>>>>>>>>>>>>>>>    // this websets the enabled state based on the state of the
20001>>>>>>>>>>>>>>>    // web view and the control. This is usually called during Refresh
20001>>>>>>>>>>>>>>>    Procedure SetDynamicEnabled
20003>>>>>>>>>>>>>>>        Integer eWebViewStyle
20003>>>>>>>>>>>>>>>        Boolean bStatic
20003>>>>>>>>>>>>>>>    
20003>>>>>>>>>>>>>>>        Get pbEnabledStatic to bStatic
20004>>>>>>>>>>>>>>>        If (not(bStatic)) Begin
20006>>>>>>>>>>>>>>>            Delegate Get WebViewStyle to eWebViewStyle
20008>>>>>>>>>>>>>>>            If (eWebViewStyle = wvsDrillDown) Begin
20010>>>>>>>>>>>>>>>                Send SetDynamicEnabledDrillDownStyle
20011>>>>>>>>>>>>>>>            End
20011>>>>>>>>>>>>>>>>
20011>>>>>>>>>>>>>>>            Else Begin
20012>>>>>>>>>>>>>>>                Send SetDynamicEnabledDesktopStyle
20013>>>>>>>>>>>>>>>            End
20013>>>>>>>>>>>>>>>>
20013>>>>>>>>>>>>>>>        End                
20013>>>>>>>>>>>>>>>>
20013>>>>>>>>>>>>>>>    End_Procedure
20014>>>>>>>>>>>>>>>
20014>>>>>>>>>>>>>>>    
20014>>>>>>>>>>>>>>>    Procedure Request_Find Integer eFindMode
20016>>>>>>>>>>>>>>>        // Generic request find method for handling Request_Find
20016>>>>>>>>>>>>>>>        // eFindMode - Can be one of... lt, le, eq, ge, gt, or it may be either Next_Record, First_Record, or Last_Record
20016>>>>>>>>>>>>>>>        Integer iField iFile iMainIndex
20016>>>>>>>>>>>>>>>        Handle hoServer
20016>>>>>>>>>>>>>>>
20016>>>>>>>>>>>>>>>        Get Server to hoServer
20017>>>>>>>>>>>>>>>        
20017>>>>>>>>>>>>>>>        If (hoServer <> 0) Begin
20019>>>>>>>>>>>>>>>            Get Data_File to iFile
20020>>>>>>>>>>>>>>>            Get Data_Field to iField
20021>>>>>>>>>>>>>>>            
20021>>>>>>>>>>>>>>>            If (iFile > 0) Begin
20023>>>>>>>>>>>>>>>                Send Item_Find to hoServer eFindMode iFile iField True False False   // Entry Update = True, Show find error = True, Deferred State = False
20024>>>>>>>>>>>>>>>            End
20024>>>>>>>>>>>>>>>>
20024>>>>>>>>>>>>>>>        End
20024>>>>>>>>>>>>>>>>
20024>>>>>>>>>>>>>>>    End_Procedure
20025>>>>>>>>>>>>>>>    
20025>>>>>>>>>>>>>>>    // Reads the synchronized psValue and pbChanged properties and updates the DDO data binding appropriately.
20025>>>>>>>>>>>>>>>    // Sent if pbDataBindable is True. Called during the AJAX Call's SynchronizeDDOs stage.
20025>>>>>>>>>>>>>>>    Procedure UpdateDataBinding
20027>>>>>>>>>>>>>>>        Integer iField iFile
20027>>>>>>>>>>>>>>>        Handle hoServer
20027>>>>>>>>>>>>>>>        Boolean bChanged bDefault
20027>>>>>>>>>>>>>>>        String sValue
20027>>>>>>>>>>>>>>>        Boolean bNoPut bNoEnter
20027>>>>>>>>>>>>>>>        Integer iDDOOptions
20027>>>>>>>>>>>>>>>        
20027>>>>>>>>>>>>>>>        If (not(UpdateDDAllowed(Self))) Begin
20029>>>>>>>>>>>>>>>            Procedure_Return
20030>>>>>>>>>>>>>>>        End
20030>>>>>>>>>>>>>>>>
20030>>>>>>>>>>>>>>>        
20030>>>>>>>>>>>>>>>        Get Server to hoServer
20031>>>>>>>>>>>>>>>        
20031>>>>>>>>>>>>>>>        If (hoServer <> 0) Begin
20033>>>>>>>>>>>>>>>            Get Data_File to iFile
20034>>>>>>>>>>>>>>>            Get Data_Field to iField
20035>>>>>>>>>>>>>>>            
20035>>>>>>>>>>>>>>>            If (iFile > 0) Begin
20037>>>>>>>>>>>>>>>                WebGet pbChanged to bChanged
20038>>>>>>>>>>>>>>>                WebGet pbFieldDefault to bDefault
20039>>>>>>>>>>>>>>>                
20039>>>>>>>>>>>>>>>                Get File_Field_DynamicEntryOptions of hoServer iFile iField to iDDOOptions
20040>>>>>>>>>>>>>>>                If (bChanged or bDefault or IsFlagIn(DD_FORCEPUT, iDDOOptions)) Begin
20042>>>>>>>>>>>>>>>                    WebGet psValue to sValue
20043>>>>>>>>>>>>>>>                    
20043>>>>>>>>>>>>>>>                    Set private_pbIgnoreOnValueChanged to True                        // Don't process the DDO's File_Field_Value_Changed event!
20044>>>>>>>>>>>>>>>                    
20044>>>>>>>>>>>>>>>                    If (bChanged) ;                        Set File_Field_Changed_Value of hoServer iFile iField to sValue   // Use File_Field because the field doesn't have to be in the server
20047>>>>>>>>>>>>>>>                    Else If (IsFlagIn(DD_FORCEPUT, iDDOOptions)) ;                        Set File_Field_Current_Value of hoServer iFile iField to sValue
20051>>>>>>>>>>>>>>>                    Else ;  // if bDefault                        Set File_Field_default_Value of hoServer iFile iField to sValue
20053>>>>>>>>>>>>>>>    
20053>>>>>>>>>>>>>>>                    Move (IsFlagIn(DD_NoPut, iDDOOptions)) to bNoPut
20054>>>>>>>>>>>>>>>                    If (bNoPut) Begin
20056>>>>>>>>>>>>>>>                        // this tells the DD that this is a DEO update on a noput field, which should only
20056>>>>>>>>>>>>>>>                        // happen with foreign index fields (noput=T,noenter=F). This stops the save update
20056>>>>>>>>>>>>>>>                        Set File_Field_NoPutValueChangedByDeo of hoServer iFile iField to True
20057>>>>>>>>>>>>>>>                    End
20057>>>>>>>>>>>>>>>>
20057>>>>>>>>>>>>>>>                    Set private_pbIgnoreOnValueChanged to False
20058>>>>>>>>>>>>>>>                End    
20058>>>>>>>>>>>>>>>>
20058>>>>>>>>>>>>>>>            End
20058>>>>>>>>>>>>>>>>
20058>>>>>>>>>>>>>>>        End
20058>>>>>>>>>>>>>>>>
20058>>>>>>>>>>>>>>>    End_Procedure
20059>>>>>>>>>>>>>>>    
20059>>>>>>>>>>>>>>>    Function ExecFileFieldMessage Handle hMsg Returns Integer
20061>>>>>>>>>>>>>>>        Integer iFile iField iResult
20061>>>>>>>>>>>>>>>        Handle hoDDO
20061>>>>>>>>>>>>>>>        Get Server to hoDDO
20062>>>>>>>>>>>>>>>        Get Data_File  to iFile
20063>>>>>>>>>>>>>>>        Get Data_Field to iField       
20064>>>>>>>>>>>>>>>        If ((hoDDO <> 0) and (iFile <> 0)) Begin
20066>>>>>>>>>>>>>>>            Get Exec_File_Field_Message of hoDDO iFile iField hMsg to iResult
20067>>>>>>>>>>>>>>>        End
20067>>>>>>>>>>>>>>>>
20067>>>>>>>>>>>>>>>        Function_Return iResult
20068>>>>>>>>>>>>>>>    End_Function
20069>>>>>>>>>>>>>>>    
20069>>>>>>>>>>>>>>>    // Set the field_changed_value of the the DD Field for this DEO
20069>>>>>>>>>>>>>>>
20069>>>>>>>>>>>>>>>    Procedure DDSetChangedValue String sValue
20071>>>>>>>>>>>>>>>        Integer iFile iField
20071>>>>>>>>>>>>>>>        Handle hoDDO
20071>>>>>>>>>>>>>>>        Get Server to hoDDO
20072>>>>>>>>>>>>>>>        Get Data_File  to iFile
20073>>>>>>>>>>>>>>>        Get Data_Field to iField       
20074>>>>>>>>>>>>>>>        If ((hoDDO <> 0) and (iFile <> 0)) Begin
20076>>>>>>>>>>>>>>>            Set File_Field_Changed_Value of hoDDO iFile iField to sValue
20077>>>>>>>>>>>>>>>        End
20077>>>>>>>>>>>>>>>>
20077>>>>>>>>>>>>>>>    End_Procedure
20078>>>>>>>>>>>>>>>

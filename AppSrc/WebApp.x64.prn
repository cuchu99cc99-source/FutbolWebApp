36264>>>>>>>    End_Procedure
36265>>>>>>>    
36265>>>>>>>    
36265>>>>>>>    // Prepends a dynamic object at the beginning of its parent's list of children.
36265>>>>>>>    Procedure PrependDynamicObject String sDynamicObjectId
36267>>>>>>>        String sParentId
36267>>>>>>>        String[] aParams aChildren aEmptyParams aObjects
36271>>>>>>>        Integer iIndex iRemoveIndex
36271>>>>>>>        Boolean bSendCommand
36271>>>>>>>        Handle hoObj hoQueuedSyncPropsJson hoObjectJson
36271>>>>>>>        tWebDynamicObject tDynamicObject
36271>>>>>>>        tWebDynamicObject tDynamicObject
36271>>>>>>>        tWebDynamicObject[] aDynamicObjects
36271>>>>>>>        tWebDynamicObject[] aDynamicObjects
36272>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36272>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36273>>>>>>>        
36273>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36274>>>>>>>        
36274>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36275>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36276>>>>>>>        If (iIndex <> -1) Begin
36278>>>>>>>            // Retrieve parent
36278>>>>>>>            Move aDynamicObjects[iIndex].sParentId to sParentId
36279>>>>>>>            
36279>>>>>>>            // Find parent object
36279>>>>>>>            Move sParentId to tDynamicObject.sId
36280>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects)) to iIndex
36281>>>>>>>            If (iIndex <> -1) Begin
36283>>>>>>>                
36283>>>>>>>                // Remove previously appended object (in CreateDynamicObject)
36283>>>>>>>                Move (SearchArray(sDynamicObjectId, aDynamicObjects[iIndex].aChildren)) to iRemoveIndex
36284>>>>>>>                Move (RemoveFromArray(aDynamicObjects[iIndex].aChildren, iRemoveIndex)) to aChildren
36285>>>>>>>                
36285>>>>>>>                // Insert object at beginning of the array
36285>>>>>>>                Move (InsertInArray(aChildren, 0, sDynamicObjectId)) to aChildren
36286>>>>>>>                Move aChildren to aDynamicObjects[iIndex].aChildren
36287>>>>>>>                
36287>>>>>>>                WebSet paDynamicObjects to aDynamicObjects 
36288>>>>>>>                Move True to bSendCommand
36289>>>>>>>            End
36289>>>>>>>>
36289>>>>>>>            Else Begin
36290>>>>>>>                Error DFERR_PROGRAM (SFormat(C_$DynamicParentNotFound, sParentId))
36291>>>>>>>>
36291>>>>>>>            End
36291>>>>>>>>
36291>>>>>>>        End
36291>>>>>>>>
36291>>>>>>>        
36291>>>>>>>        // Finally, send an insert command to the client
36291>>>>>>>        If (bSendCommand) Begin
36293>>>>>>>            Send ConnectRadioButtons
36294>>>>>>>            
36294>>>>>>>            Get DynamicObject sDynamicObjectId to hoObj
36295>>>>>>>            Get SerializeDynamicObject hoObj aDynamicObjects to hoObjectJson
36296>>>>>>>            WebGet paSyncPropsQueue to aSyncPropsQueue
36297>>>>>>>            
36297>>>>>>>            // Convert queued sync props to JSON
36297>>>>>>>            Get Create (RefClass(cJsonObject)) to hoQueuedSyncPropsJson
36298>>>>>>>            Send DataTypeToJson of hoQueuedSyncPropsJson aSyncPropsQueue 
36299>>>>>>>            
36299>>>>>>>            // Convert object definition to JSON
36299>>>>>>>            Get DynamicParent sDynamicObjectId to hoObj
36300>>>>>>>            Get WebObjectName of hoObj to aParams[0]
36301>>>>>>>            
36301>>>>>>>            // Send actions to the client
36301>>>>>>>            Send ClientActionEx "loadQueuedSyncProps" aEmptyParams hoQueuedSyncPropsJson
36302>>>>>>>            Send ClientActionEx "prependDynamicObject" aParams hoObjectJson
36303>>>>>>>        
36303>>>>>>>            Send Destroy of hoObjectJson
36304>>>>>>>            Send Destroy of hoQueuedSyncPropsJson
36305>>>>>>>    
36305>>>>>>>            Move sDynamicObjectId to aObjects[0]
36306>>>>>>>            Send FinishRendering aObjects
36307>>>>>>>        End
36307>>>>>>>>
36307>>>>>>>    End_Procedure
36308>>>>>>>
36308>>>>>>>  
36308>>>>>>>    // Destroys the given dynamic object and removes it from the container.
36308>>>>>>>    Procedure DestroyDynamicObject String sDynamicObjectId
36310>>>>>>>        String sParentId sName sRadioGroup
36310>>>>>>>        String[] aParams aChildren
36312>>>>>>>        Handle hoObj
36312>>>>>>>        Integer iIndex iChildIndex iTotal iNum icObjects iObject
36312>>>>>>>        Variant vResult
36312>>>>>>>        tWebDynamicObject tDynamicObject
36312>>>>>>>        tWebDynamicObject tDynamicObject
36312>>>>>>>        tWebDynamicObject[] aDynamicObjects
36312>>>>>>>        tWebDynamicObject[] aDynamicObjects
36313>>>>>>>        tWebSyncProps tSyncProp
36313>>>>>>>        tWebSyncProps tSyncProp
36313>>>>>>>        tWebSyncPropsWrapper tSyncPropsWrapper
36313>>>>>>>        tWebSyncPropsWrapper tSyncPropsWrapper
36313>>>>>>>        tWebAdvSyncProp tAdvSyncProp
36313>>>>>>>        tWebAdvSyncProp tAdvSyncProp
36313>>>>>>>        tWebAdvSyncPropsWrapper tAdvSyncPropsWrapper
36313>>>>>>>        tWebAdvSyncPropsWrapper tAdvSyncPropsWrapper
36313>>>>>>>        tQueuedSyncProp tTest
36313>>>>>>>        tQueuedSyncProp tTest
36313>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36313>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36314>>>>>>>        tWebClientAction[] aClientActionsQueue
36314>>>>>>>        tWebClientAction[] aClientActionsQueue
36315>>>>>>>        tWebDynamicRadioGroup[] aRadioGroups
36315>>>>>>>        tWebDynamicRadioGroup[] aRadioGroups
36316>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36316>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36317>>>>>>>        tObjectInMemory tObjectInMemory
36317>>>>>>>        tObjectInMemory tObjectInMemory
36317>>>>>>>        
36317>>>>>>>        Get DynamicObject sDynamicObjectId to hoObj
36318>>>>>>>        Get WebObjectName of hoObj to sName
36319>>>>>>>        
36319>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36320>>>>>>>           
36320>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36321>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36322>>>>>>>        If (iIndex <> -1) Begin
36324>>>>>>>            Move aDynamicObjects[iIndex] to tDynamicObject
36325>>>>>>>            
36325>>>>>>>            // Destroy the object's children
36325>>>>>>>            Move tDynamicObject.aChildren to aChildren
36326>>>>>>>            Move (SizeOfArray(aChildren)) to icObjects
36327>>>>>>>            For iObject from 0 to (icObjects - 1)
36333>>>>>>>>
36333>>>>>>>                Send DestroyDynamicObject aChildren[iObject]
36334>>>>>>>            Loop
36335>>>>>>>>
36335>>>>>>>            
36335>>>>>>>            // We need to do a WebGet again, because the array might have changed while children were being destroyed
36335>>>>>>>            WebGet paDynamicObjects to aDynamicObjects
36336>>>>>>>            
36336>>>>>>>            // The index also needs to be updated
36336>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36337>>>>>>>            
36337>>>>>>>            // Destroy the dynamic object itself
36337>>>>>>>            Move tDynamicObject.sParentId to sParentId
36338>>>>>>>            Move (RemoveFromArray(aDynamicObjects, iIndex)) to aDynamicObjects
36339>>>>>>>            
36339>>>>>>>            // Remove it from its parent's list of children
36339>>>>>>>            Move sParentId to tDynamicObject.sId
36340>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36341>>>>>>>            If (iIndex <> -1) Begin
36343>>>>>>>                Move (SearchArray(sDynamicObjectId, aDynamicObjects[iIndex].aChildren)) to iChildIndex
36344>>>>>>>                If (iChildIndex <> -1) Begin
36346>>>>>>>                    Move (RemoveFromArray(aDynamicObjects[iIndex].aChildren, iChildIndex)) to aDynamicObjects[iIndex].aChildren
36347>>>>>>>                End
36347>>>>>>>>
36347>>>>>>>            End
36347>>>>>>>>
36347>>>>>>>            
36347>>>>>>>            WebSet paDynamicObjects to aDynamicObjects
36348>>>>>>>            
36348>>>>>>>            // Optional: remove radio button from its group
36348>>>>>>>            If (IsObjectOfClass(hoObj, (RefClass(cWebRadio)))) Begin
36350>>>>>>>                WebGet paRadioGroups to aRadioGroups
36351>>>>>>>                
36351>>>>>>>                Move (SizeOfArray(aRadioGroups)) to iTotal
36352>>>>>>>                For iNum from 0 to (iTotal - 1)
36358>>>>>>>>
36358>>>>>>>                    Move (SearchArray(sDynamicObjectId, aRadioGroups[iNum].aRadioButtons)) to iIndex
36359>>>>>>>                    If (iIndex <> -1) Begin
36361>>>>>>>                        Move (RemoveFromArray(aRadioGroups[iNum].aRadioButtons, iIndex)) to aRadioGroups[iNum].aRadioButtons
36362>>>>>>>                    End
36362>>>>>>>>
36362>>>>>>>                Loop
36363>>>>>>>>
36363>>>>>>>                
36363>>>>>>>                WebSet paRadioGroups to aRadioGroups
36364>>>>>>>            End  
36364>>>>>>>>
36364>>>>>>>            
36364>>>>>>>            // Destroy the local object in memory (we can't leave this untill OnCallEnd as destructors and SyncDDO could change props)
36364>>>>>>>            Get paDynamicObjectsInMemory to aDynamicObjectsInMemory
36365>>>>>>>            Move sDynamicObjectId to tObjectInMemory.sDynamicObjectId
36366>>>>>>>            
36366>>>>>>>            Move (BinarySearchArray(tObjectInMemory, aDynamicObjectsInMemory, False)) to iIndex
36367>>>>>>>            If (iIndex <> -1) Begin
36369>>>>>>>                Send Destroy of aDynamicObjectsInMemory[iIndex].hoObj
36370>>>>>>>                Move (RemoveFromArray(aDynamicObjectsInMemory, iIndex)) to aDynamicObjectsInMemory
36371>>>>>>>                Set paDynamicObjectsInMemory to aDynamicObjectsInMemory
36372>>>>>>>            End
36372>>>>>>>>
36372>>>>>>>            Move 0 to hoObj
36373>>>>>>>            // Remove client properties
36373>>>>>>>            WebGet ptSyncPropsWrapper to tSyncPropsWrapper
36374>>>>>>>            Move (SortArray(tSyncPropsWrapper.aSyncProps, False)) to tSyncPropsWrapper.aSyncProps
36375>>>>>>>            
36375>>>>>>>            Move sName to tSyncProp.sO
36376>>>>>>>            Move (BinarySearchArray(tSyncProp, tSyncPropsWrapper.aSyncProps, False)) to iIndex
36377>>>>>>>            If (iIndex <> -1) Begin
36379>>>>>>>                Move (RemoveFromArray(tSyncPropsWrapper.aSyncProps, iIndex)) to tSyncPropsWrapper.aSyncProps
36380>>>>>>>                WebSet ptSyncPropsWrapper to tSyncPropsWrapper
36381>>>>>>>            End
36381>>>>>>>>
36381>>>>>>>            // Remove server properties
36381>>>>>>>            WebGet ptSyncServerPropsWrapper to tSyncPropsWrapper
36382>>>>>>>            Move (BinarySearchArray(tSyncProp, tSyncPropsWrapper.aSyncProps, False)) to iIndex
36383>>>>>>>            If (iIndex <> -1) Begin
36385>>>>>>>                Move (RemoveFromArray(tSyncPropsWrapper.aSyncProps, iIndex)) to tSyncPropsWrapper.aSyncProps
36386>>>>>>>                WebSet ptSyncServerPropsWrapper to tSyncPropsWrapper
36387>>>>>>>            End
36387>>>>>>>>
36387>>>>>>>            
36387>>>>>>>            
36387>>>>>>>            
36387>>>>>>>            // Remove advanced properties
36387>>>>>>>            WebGet ptAdvSyncPropsWrapper to tAdvSyncPropsWrapper
36388>>>>>>>            Move sName to tAdvSyncProp.sO
36389>>>>>>>            Move (SearchArray(tAdvSyncProp, tAdvSyncPropsWrapper.aAdvSyncProps)) to iIndex
36390>>>>>>>            If (iIndex <> -1) Begin
36392>>>>>>>                While (iIndex <> -1)
36396>>>>>>>                    Move (RemoveFromArray(tAdvSyncPropsWrapper.aAdvSyncProps, iIndex)) to tAdvSyncPropsWrapper.aAdvSyncProps
36397>>>>>>>                    Move (SearchArray(tAdvSyncProp, tAdvSyncPropsWrapper.aAdvSyncProps)) to iIndex
36398>>>>>>>                Loop
36399>>>>>>>>
36399>>>>>>>                WebSet ptAdvSyncPropsWrapper to tAdvSyncPropsWrapper
36400>>>>>>>            End
36400>>>>>>>>
36400>>>>>>>            
36400>>>>>>>            // Remove advanced server properties
36400>>>>>>>            WebGet ptAdvServerSyncPropsWrapper to tAdvSyncPropsWrapper
36401>>>>>>>            Move (SearchArray(tAdvSyncProp, tAdvSyncPropsWrapper.aAdvSyncProps)) to iIndex
36402>>>>>>>            If (iIndex <> -1) Begin
36404>>>>>>>                While (iIndex <> -1)
36408>>>>>>>                    Move (RemoveFromArray(tAdvSyncPropsWrapper.aAdvSyncProps, iIndex)) to tAdvSyncPropsWrapper.aAdvSyncProps
36409>>>>>>>                    Move (SearchArray(tAdvSyncProp, tAdvSyncPropsWrapper.aAdvSyncProps)) to iIndex
36410>>>>>>>                Loop
36411>>>>>>>>
36411>>>>>>>                WebSet ptAdvServerSyncPropsWrapper to tAdvSyncPropsWrapper      
36412>>>>>>>            End
36412>>>>>>>>
36412>>>>>>>            
36412>>>>>>>            // Remove advanced server session properties
36412>>>>>>>            WebGet ptAdvServerSessionSyncPropsWrapper to tAdvSyncPropsWrapper
36413>>>>>>>            Move (SearchArray(tAdvSyncProp, tAdvSyncPropsWrapper.aAdvSyncProps)) to iIndex
36414>>>>>>>            If (iIndex <> -1) Begin
36416>>>>>>>                While (iIndex <> -1)
36420>>>>>>>                    Move (RemoveFromArray(tAdvSyncPropsWrapper.aAdvSyncProps, iIndex)) to tAdvSyncPropsWrapper.aAdvSyncProps
36421>>>>>>>                    Move (SearchArray(tAdvSyncProp, tAdvSyncPropsWrapper.aAdvSyncProps)) to iIndex
36422>>>>>>>                Loop
36423>>>>>>>>
36423>>>>>>>                WebSet ptAdvServerSessionSyncPropsWrapper to tAdvSyncPropsWrapper
36424>>>>>>>            End
36424>>>>>>>>
36424>>>>>>>            
36424>>>>>>>            // Remove queued sync props for this object
36424>>>>>>>            WebGet paSyncPropsQueue to aSyncPropsQueue            
36425>>>>>>>            Move (SizeOfArray(aSyncPropsQueue)) to iTotal
36426>>>>>>>            For iNum from 0 to (iTotal - 1)
36432>>>>>>>>
36432>>>>>>>                If (aSyncPropsQueue[iNum].sO = sName) Begin
36434>>>>>>>                    Move (RemoveFromArray(aSyncPropsQueue, iNum)) to aSyncPropsQueue
36435>>>>>>>                    
36435>>>>>>>                    // This is necessary to keep the loop running correctly
36435>>>>>>>                    Decrement iNum
36436>>>>>>>                    Decrement iTotal
36437>>>>>>>                End
36437>>>>>>>>
36437>>>>>>>            Loop
36438>>>>>>>>
36438>>>>>>>            WebSet paSyncPropsQueue to aSyncPropsQueue
36439>>>>>>>            
36439>>>>>>>            // Remove queued client actions for this object
36439>>>>>>>            Get paClientActionsQueue to aClientActionsQueue
36440>>>>>>>            Move (SizeOfArray(aClientActionsQueue)) to iTotal
36441>>>>>>>            For iNum from 0 to (iTotal - 1)
36447>>>>>>>>
36447>>>>>>>                If (aClientActionsQueue[iNum].sName = sName) Begin
36449>>>>>>>                    Move (RemoveFromArray(aClientActionsQueue, iNum)) to aClientActionsQueue
36450>>>>>>>                    
36450>>>>>>>                    // This is necessary to keep the loop running correctly
36450>>>>>>>                    Decrement iNum
36451>>>>>>>                    Decrement iTotal
36452>>>>>>>                End
36452>>>>>>>>
36452>>>>>>>            Loop
36453>>>>>>>>
36453>>>>>>>            
36453>>>>>>>            // Update client
36453>>>>>>>            Move sName to aParams[0]
36454>>>>>>>            Send ClientAction "destroyDynamicObject" aParams
36455>>>>>>>        End
36455>>>>>>>>
36455>>>>>>>    End_Procedure
36456>>>>>>>                
36456>>>>>>>    // Appends a child object to the end of the parent's list of children.
36456>>>>>>>    Procedure AppendToSiblings String sDynamicObjectId
36458>>>>>>>        String sParentId
36458>>>>>>>        Integer iIndex iSize
36458>>>>>>>        Handle hoObj
36458>>>>>>>        tWebDynamicObject tDynamicObject
36458>>>>>>>        tWebDynamicObject tDynamicObject
36458>>>>>>>        tWebDynamicObject[] aDynamicObjects
36458>>>>>>>        tWebDynamicObject[] aDynamicObjects
36459>>>>>>>        
36459>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36460>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36461>>>>>>>        
36461>>>>>>>        // First get parent of the object
36461>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36462>>>>>>>        If (iIndex <> -1) Begin
36464>>>>>>>            Move aDynamicObjects[iIndex].sParentId to sParentId
36465>>>>>>>            Move sParentId to tDynamicObject.sId
36466>>>>>>>            
36466>>>>>>>            // Search for parent object
36466>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36467>>>>>>>            If (iIndex = -1) Begin
36469>>>>>>>                // Root object is not yet in the list of objects, so add it now
36469>>>>>>>                Move (BinarySearchInsertPos()) to iIndex 
36470>>>>>>>                Move (InsertInArray(aDynamicObjects, iIndex, tDynamicObject)) to aDynamicObjects
36471>>>>>>>            End
36471>>>>>>>>
36471>>>>>>>           
36471>>>>>>>            Move (SizeOfArray(aDynamicObjects[iIndex].aChildren)) to iSize
36472>>>>>>>            Move sDynamicObjectId to aDynamicObjects[iIndex].aChildren[iSize]
36473>>>>>>>            WebSet paDynamicObjects to aDynamicObjects
36474>>>>>>>        End
36474>>>>>>>>
36474>>>>>>>    End_Procedure
36475>>>>>>>    
36475>>>>>>>       
36475>>>>>>>    // =======================
36475>>>>>>>    // DYNAMIC OBJECT QUERYING
36475>>>>>>>    // =======================
36475>>>>>>>
36475>>>>>>>    // Checks whether the given object should always create its children when it is being created.
36475>>>>>>>    // Currently, this is true if the object is a subclass of:
36475>>>>>>>    //      - cWebList
36475>>>>>>>    //      - cWebCardContainer
36475>>>>>>>     Function RequiresChildren Handle hoObj Returns Boolean
36477>>>>>>>        Integer iClass icClasses
36477>>>>>>>        Integer[] aClassIds
36478>>>>>>>        Boolean bResult
36478>>>>>>>        
36478>>>>>>>        Move False to bResult
36479>>>>>>>        
36479>>>>>>>        Move (RefClass(cWebList)) to aClassIds[SizeOfArray(aClassIds)]
36480>>>>>>>        Move (RefClass(cWebCardContainer)) to aClassIds[SizeOfArray(aClassIds)]
36481>>>>>>>        
36481>>>>>>>        Move (SizeOfArray(aClassIds)) to icClasses
36482>>>>>>>        For iClass from 0 to (icClasses - 1)
36488>>>>>>>>
36488>>>>>>>            If (IsObjectOfClass(hoObj, aClassIds[iClass])) Begin
36490>>>>>>>                Move True to bResult
36491>>>>>>>            End
36491>>>>>>>>
36491>>>>>>>            
36491>>>>>>>            If bResult ;                Break
36494>>>>>>>        Loop
36495>>>>>>>>
36495>>>>>>>        
36495>>>>>>>        Function_Return bResult
36496>>>>>>>    End_Function
36497>>>>>>>    
36497>>>>>>>    
36497>>>>>>>    // Creates all child objects for the given dynamic object in memory
36497>>>>>>>    Procedure CreateChildren String sDynamicObjectId
36499>>>>>>>        Integer iIndex
36499>>>>>>>        Handle hoObj
36499>>>>>>>        tWebDynamicObject tDynamicObject
36499>>>>>>>        tWebDynamicObject tDynamicObject
36499>>>>>>>        tWebDynamicObject[] aDynamicObjects
36499>>>>>>>        tWebDynamicObject[] aDynamicObjects
36500>>>>>>>        String[] aChildren
36501>>>>>>>        
36501>>>>>>>        //  Find the dynamic object        
36501>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36502>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36503>>>>>>>
36503>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36504>>>>>>>        If (iIndex >= 0) Begin
36506>>>>>>>            //  Loop over its children
36506>>>>>>>            Move aDynamicObjects[iIndex].aChildren to aChildren
36507>>>>>>>            For iIndex from 0 to (SizeOfArray(aChildren) - 1)
36513>>>>>>>>
36513>>>>>>>                Get CreateLocal aChildren[iIndex] to hoObj
36514>>>>>>>            Loop
36515>>>>>>>>
36515>>>>>>>        End
36515>>>>>>>>
36515>>>>>>>    End_Procedure
36516>>>>>>>    
36516>>>>>>>    
36516>>>>>>>    //  This function searches the object handle of a dynamic object using its public name.
36516>>>>>>>    //      sObjectName - Name of the web object.
36516>>>>>>>    Function FindWebObject String sObjectName Boolean bOptErr Returns Handle
36518>>>>>>>        Integer iIndex
36518>>>>>>>        String sDynamicObjectId
36518>>>>>>>        Handle hoObj
36518>>>>>>>        
36518>>>>>>>        // Only the actual name of the object (without parentage) is saved.
36518>>>>>>>        // Therefore, we first need to remove the parentage from the name
36518>>>>>>>        // of the object.
36518>>>>>>>        Get TruncateName sObjectName to sDynamicObjectId
36519>>>>>>>        
36519>>>>>>>        Get DynamicObject sDynamicObjectId to hoObj
36520>>>>>>>        Function_Return hoObj
36521>>>>>>>    End_Function
36522>>>>>>>    
36522>>>>>>>    
36522>>>>>>>    /*    Converts a name received from the client into the identifier used in the dynamic object id     its registration. Dynamic objects their names are prefixed with a # when they are created, so     when a name comes from the client it will include the #.        So a full object name for a dynamic object will be:    oDynamicContainer@#dynamicobjectid  => dynamicobjectid        But a static child will be:    oDynamicContainer@#dynamicobjectid.oStaticChild  => dynamicobjectid.oStaticChild        But it can also be nested dynamic obects:    oDynamicContainer@#dynamicobjectid.#nesteddynamicobject  => #nesteddynamicobject    oDynamicContainer@#dynamicobjectid.#nesteddynamicobject.oStaticChild  => #nesteddynamicobject.oStaticChild        Note that usually oDynamicContainer@ is already stripped off when this function is called, but     for compatibility we still check for that if we do not find a #.        */
36522>>>>>>>    Function TruncateName String sObjectName Returns String
36524>>>>>>>        Integer iPos
36524>>>>>>>        
36524>>>>>>>        Move (RightPos("#", sObjectName)) to iPos
36525>>>>>>>        
36525>>>>>>>        If (iPos = 0) ;            Move (RightPos("$", sObjectName)) to iPos
36528>>>>>>>        
36528>>>>>>>        If (iPos > 0) ;            Function_Return (Right(sObjectName, (Length(sObjectName) - iPos)))
36531>>>>>>>        
36531>>>>>>>        Function_Return sObjectName
36532>>>>>>>    End_Function
36533>>>>>>>    
36533>>>>>>>    
36533>>>>>>>    // Returns the dynamic object with the given ID. Creates the object
36533>>>>>>>    // in memory if it doesn't exist yet.
36533>>>>>>>    Function DynamicObject String sDynamicObjectId Returns Handle
36535>>>>>>>        Handle hoObj
36535>>>>>>>        
36535>>>>>>>        Get DynamicObjectEx sDynamicObjectId to hoObj
36536>>>>>>>        
36536>>>>>>>        If (hoObj = C_WebUnresolvedObject) ;            Error DFERR_PROGRAM (SFormat(C_$DynamicObjectNotRegistered, sDynamicObjectId))
36539>>>>>>>            
36539>>>>>>>        Function_Return hoObj
36540>>>>>>>    End_Function
36541>>>>>>>    
36541>>>>>>>    // Static children of dynamic objects are registered as "<dynamicparentid>.oChild.oChild". 
36541>>>>>>>    // Dynamic children are registered under their ID which is also set as their name, so then this 
36541>>>>>>>    // function is called with "<dynamicparentid>.<dynamicchildid>" while we should search for
36541>>>>>>>    // "<dynamicchildid>". So this function just tries to find them both ways.
36541>>>>>>>    //
36541>>>>>>>    // Worst case scenario is that we get collisions when people use the "." in dynamic object id's.
36541>>>>>>>    //
36541>>>>>>>    // This function is called by the cWebControlLocator.
36541>>>>>>>    Function OwnerFindWebObject String sObjectName Returns Handle
36543>>>>>>>        Handle hoObj
36543>>>>>>>        String sDynamicObjectId
36543>>>>>>>        
36543>>>>>>>        // If this is a root object or static child
36543>>>>>>>        Get TruncateName sObjectName to sDynamicObjectId
36544>>>>>>>        
36544>>>>>>>        Get DynamicObjectEx sDynamicObjectId to hoObj
36545>>>>>>>        
36545>>>>>>>        If (hoObj <> C_WebUnresolvedObject) ;            Function_Return hoObj
36548>>>>>>>        
36548>>>>>>>        Function_Return hoObj
36549>>>>>>>    End_Function
36550>>>>>>>    
36550>>>>>>>    // DynamicObject function that does not give an error.
36550>>>>>>>    Function DynamicObjectEx String sDynamicObjectId Returns Handle
36552>>>>>>>        Integer iObjectIndex
36552>>>>>>>        Handle hoObj
36552>>>>>>>        tWebDynamicObject tDynamicObject
36552>>>>>>>        tWebDynamicObject tDynamicObject
36552>>>>>>>        tWebDynamicObject[] aDynamicObjects
36552>>>>>>>        tWebDynamicObject[] aDynamicObjects
36553>>>>>>>        
36553>>>>>>>        // Check if the object we are looking for is the top-parent object:
36553>>>>>>>        // the container itself.
36553>>>>>>>        If (sDynamicObjectId = "") Begin
36555>>>>>>>            Function_Return Self
36556>>>>>>>        End
36556>>>>>>>>
36556>>>>>>>        
36556>>>>>>>        WebGet paDynamicObjects to aDynamicObjects  
36557>>>>>>>           
36557>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36558>>>>>>>     
36558>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iObjectIndex
36559>>>>>>>        If (iObjectIndex <> -1) Begin
36561>>>>>>>            Get StoredHandle sDynamicObjectId to hoObj
36562>>>>>>>            
36562>>>>>>>            If (hoObj = 0) Begin
36564>>>>>>>                // This means the object is not yet loaded, so load it now.
36564>>>>>>>                Get CreateLocal sDynamicObjectId to hoObj
36565>>>>>>>            End
36565>>>>>>>>
36565>>>>>>>        End
36565>>>>>>>>
36565>>>>>>>        Else Begin
36566>>>>>>>            Move C_WebUnresolvedObject to hoObj 
36567>>>>>>>        End
36567>>>>>>>>
36567>>>>>>>        
36567>>>>>>>        Function_Return hoObj
36568>>>>>>>    End_Function
36569>>>>>>>    
36569>>>>>>>    
36569>>>>>>>    // Returns the dynamic parent of a dynamic object. 
36569>>>>>>>    Function DynamicParent String sDynamicObjectId Returns Handle
36571>>>>>>>        String sParentId
36571>>>>>>>        Integer iObjectIndex iParentIndex
36571>>>>>>>        Handle hoParent
36571>>>>>>>        tWebDynamicObject tDynamicObject
36571>>>>>>>        tWebDynamicObject tDynamicObject
36571>>>>>>>        tWebDynamicObject[] aDynamicObjects
36571>>>>>>>        tWebDynamicObject[] aDynamicObjects
36572>>>>>>>        
36572>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36573>>>>>>>        
36573>>>>>>>        Get TruncateName sDynamicObjectId to sDynamicObjectId
36574>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36575>>>>>>>        
36575>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iObjectIndex
36576>>>>>>>        If (iObjectIndex <> -1) Begin
36578>>>>>>>            Move aDynamicObjects[iObjectIndex].sParentId to sParentId
36579>>>>>>>            
36579>>>>>>>            If (sParentId = "") ;                Function_Return (Self)
36582>>>>>>>                
36582>>>>>>>            Move sParentId to tDynamicObject.sId
36583>>>>>>>                
36583>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iParentIndex
36584>>>>>>>            If (iParentIndex <> -1) Begin
36586>>>>>>>                Get DynamicObject sParentId to hoParent
36587>>>>>>>            End
36587>>>>>>>>
36587>>>>>>>            Else ;                Error DFERR_PROGRAM (SFormat(C_$DynamicObjectNotRegistered, sParentId))
36589>>>>>>>        End
36589>>>>>>>>
36589>>>>>>>        Else ;            Error DFERR_PROGRAM (SFormat(C_$DynamicObjectNotRegistered, sDynamicObjectId))
36591>>>>>>>            
36591>>>>>>>        Function_Return hoParent
36592>>>>>>>    End_Function
36593>>>>>>>    
36593>>>>>>>    
36593>>>>>>>        
36593>>>>>>>    // Returns the list of children for an object.
36593>>>>>>>    Function DynamicChildren String sDynamicObjectId Returns String[]
36595>>>>>>>        String[] aResult
36596>>>>>>>        Integer iIndex
36596>>>>>>>        tWebDynamicObject tDynamicObject
36596>>>>>>>        tWebDynamicObject tDynamicObject
36596>>>>>>>        tWebDynamicObject[] aDynamicObjects
36596>>>>>>>        tWebDynamicObject[] aDynamicObjects
36597>>>>>>>        
36597>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36598>>>>>>>        
36598>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36599>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36600>>>>>>>        If (iIndex <> -1) Begin
36602>>>>>>>            Function_Return aDynamicObjects[iIndex].aChildren
36603>>>>>>>        End
36603>>>>>>>>
36603>>>>>>>        Else Begin
36604>>>>>>>            If (sDynamicObjectId <> "") ;                Error DFERR_PROGRAM (SFormat(C_$DynamicObjectNotRegistered, sDynamicObjectId)) 
36607>>>>>>>        End
36607>>>>>>>>
36607>>>>>>>        Function_Return aResult
36608>>>>>>>    End_Function
36609>>>>>>>
36609>>>>>>>    
36609>>>>>>>    // =========================
36609>>>>>>>    // PROCESS MEMORY MANAGEMENT
36609>>>>>>>    // =========================
36609>>>>>>>    
36609>>>>>>>    // Loads all dynamic objects in memory. This method is often called
36609>>>>>>>    // before rendering, so that all inter-object connections are set
36609>>>>>>>    // up properly.
36609>>>>>>>    Procedure CreateAllLocal 
36611>>>>>>>        Integer icObjects iObject
36611>>>>>>>        tWebDynamicObject[] aDynamicObjects
36611>>>>>>>        tWebDynamicObject[] aDynamicObjects
36612>>>>>>>        Handle hoObj
36612>>>>>>>        
36612>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36613>>>>>>>        
36613>>>>>>>        Move (SizeOfArray(aDynamicObjects)) to icObjects
36614>>>>>>>        For iObject from 0 to (icObjects - 1)
36620>>>>>>>>
36620>>>>>>>            Get DynamicObject aDynamicObjects[iObject].sId to hoObj
36621>>>>>>>        Loop
36622>>>>>>>>
36622>>>>>>>    End_Procedure
36623>>>>>>>    
36623>>>>>>>    
36623>>>>>>>    Function CreateLongNameUsingParents Handle hoDynamicObject Handle hoMaxParent Returns String
36625>>>>>>>        String sName
36625>>>>>>>        Handle hoParent hoCurrent
36625>>>>>>>        
36625>>>>>>>        Move hoDynamicObject to hoCurrent
36626>>>>>>>        Get Parent of hoMaxParent to hoMaxParent
36627>>>>>>>        
36627>>>>>>>        While (hoCurrent <> hoMaxParent and hoCurrent <> Self)
36631>>>>>>>            If (hoCurrent = hoDynamicObject) ;                Move (Object_Label(hoCurrent)) to sName
36634>>>>>>>            Else ;                Move (Object_Label(hoCurrent) + "." + sName) to sName
36636>>>>>>>            
36636>>>>>>>            Get Parent of hoCurrent to hoCurrent
36637>>>>>>>        Loop
36638>>>>>>>>
36638>>>>>>>        
36638>>>>>>>        
36638>>>>>>>        
36638>>>>>>>        If (Left(sName, 1) = "#") ;            Move (Remove(sName, 1, 1)) to sName
36641>>>>>>>            
36641>>>>>>>        Function_Return sName
36642>>>>>>>    End_Function
36643>>>>>>>    
36643>>>>>>>    Function SyncDynamicDDOs Handle hoDynamicObj Returns Integer
36645>>>>>>>        // Override in cWebWidgetContainer
36645>>>>>>>        Function_Return 0
36646>>>>>>>    End_Procedure
36647>>>>>>>    
36647>>>>>>>    Procedure StoreDynamicDDOs Handle hoDynamicObj
36649>>>>>>>        // Override in cWebWidgetContainer
36649>>>>>>>    End_Procedure
36650>>>>>>>    
36650>>>>>>>    
36650>>>>>>>    // Creates an object in memory. Due to process pooling, it can not
36650>>>>>>>    // be guaranteed that all objects are always loaded in memory. 
36650>>>>>>>    // This method creates an object in the memory of the current process.
36650>>>>>>>    Function CreateLocal String sDynamicObjectId Returns Handle
36652>>>>>>>        String sName
36652>>>>>>>        Boolean bRequiresChildren
36652>>>>>>>        Integer iObjectIndex iHandleIndex iClassId iParentIndex icObjects iObject iWebRadioClass iSyncRequestResponse
36652>>>>>>>        Handle hoObj hoParent hoChild   
36652>>>>>>>        tObjectInMemory tObject
36652>>>>>>>        tObjectInMemory tObject
36652>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36652>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36653>>>>>>>        tWebDynamicObject tDynamicObject
36653>>>>>>>        tWebDynamicObject tDynamicObject
36653>>>>>>>        tWebDynamicObject[] aDynamicObjects
36653>>>>>>>        tWebDynamicObject[] aDynamicObjects
36654>>>>>>>
36654>>>>>>>        Get paDynamicObjectsInMemory to aDynamicObjectsInMemory
36655>>>>>>>        
36655>>>>>>>        Move sDynamicObjectId to tObject.sDynamicObjectId
36656>>>>>>>
36656>>>>>>>        Move (BinarySearchArray(tObject, aDynamicObjectsInMemory, False)) to iHandleIndex
36657>>>>>>>        If (iHandleIndex = -1) Begin
36659>>>>>>>            WebGet paDynamicObjects to aDynamicObjects
36660>>>>>>>            
36660>>>>>>>            Move sDynamicObjectId to tDynamicObject.sId
36661>>>>>>>            
36661>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iObjectIndex
36662>>>>>>>            If (iObjectIndex <> -1) Begin
36664>>>>>>>                Move aDynamicObjects[iObjectIndex].iClassId to iClassId
36665>>>>>>>                Get DynamicParent sDynamicObjectId to hoParent
36666>>>>>>>                // DynamicParent might already have created the object. We either retrieve the created object.
36666>>>>>>>                // Or we do an in-place CreateNamed.
36666>>>>>>>                Send RetrieveOrCreateHandle sDynamicObjectId (&hoObj) hoParent iClassId
36667>>>>>>>
36667>>>>>>>                // Check WebObject
36667>>>>>>>                If (not(IsAjaxWebObject(hoObj))) Begin
36669>>>>>>>                    Error DFERR_PROGRAM (SFormat("Class %1 is not a valid cWebObject and can't be used with CreateDynamicObject.", iClassId))
36670>>>>>>>>
36670>>>>>>>                    Send Destroy of hoObj
36671>>>>>>>                    Function_Return C_WebUnresolvedObject
36672>>>>>>>                End
36672>>>>>>>>
36672>>>>>>>                
36672>>>>>>>                If (Pos(".", sDynamicObjectId) > 0) Begin
36674>>>>>>>                    // This is a static child so it has been created by DynamicParent which means that all processing below is already done
36674>>>>>>>                    Function_Return hoObj
36675>>>>>>>                End
36675>>>>>>>>
36675>>>>>>>                
36675>>>>>>>                Set psDynamicObjectId of hoObj to sDynamicObjectId
36676>>>>>>>                Set phoOwner of hoObj to (Self)
36677>>>>>>>                
36677>>>>>>>                Send ApplyDynamicProps sDynamicObjectId hoObj
36678>>>>>>>                
36678>>>>>>>                // Call to attempt to sync DDO's
36678>>>>>>>                Get SyncDynamicDDOs hoObj to iSyncRequestResponse
36679>>>>>>>                If (iSyncRequestResponse = -1) Begin
36681>>>>>>>                    // Request response -1 means no access, so we should destroy this object to prevent any possible calls
36681>>>>>>>                    Send DestroyDynamicObject sDynamicObjectId
36682>>>>>>>                    Procedure_Return
36683>>>>>>>                End
36683>>>>>>>>
36683>>>>>>>                
36683>>>>>>>                // Process belated childs.
36683>>>>>>>                Send CreateLocalOfChildren hoObj hoObj
36684>>>>>>>                
36684>>>>>>>                //  All data bindable objects need AfterAttachDDO message (even through Data awareness is not supported on dynamic objects for now)
36684>>>>>>>                If (pbDataBindable(hoObj)) Begin
36686>>>>>>>                    Send AfterAttachDDO of hoObj
36687>>>>>>>                End         
36687>>>>>>>>
36687>>>>>>>                
36687>>>>>>>                // WebRadio's require slightly different logic. Here we check if the 
36687>>>>>>>                // object we want to create is a cWebRadio. 
36687>>>>>>>                Move (RefClass(cWebRadio)) to iWebRadioClass
36688>>>>>>>                If (IsObjectOfClass(hoObj, iWebRadioClass)) Begin
36690>>>>>>>                    Send RegisterRadio hoObj   
36691>>>>>>>                End   
36691>>>>>>>>
36691>>>>>>>            End
36691>>>>>>>>
36691>>>>>>>            Else ;                Error DFERR_PROGRAM (SFormat(C_$DynamicObjectNotRegistered, sDynamicObjectId))
36693>>>>>>>        End
36693>>>>>>>>
36693>>>>>>>        Else Begin
36694>>>>>>>            Get StoredHandle sDynamicObjectId to hoObj
36695>>>>>>>        End
36695>>>>>>>>
36695>>>>>>>        
36695>>>>>>>        // In addition to creating the object itself, we also want to create all child objects (for some objects).
36695>>>>>>>        // This solves issues with objects that have embedded children (such as cWebList).
36695>>>>>>>        Get RequiresChildren hoObj to bRequiresChildren
36696>>>>>>>        If (bRequiresChildren) Begin      
36698>>>>>>>            Send CreateChildren sDynamicObjectId
36699>>>>>>>        End
36699>>>>>>>>
36699>>>>>>>  
36699>>>>>>>        Function_Return hoObj
36700>>>>>>>    End_Function
36701>>>>>>>                
36701>>>>>>>    // This function is only called from a createlocal with static children (should be guarded by DynamicObjectsInMemory).
36701>>>>>>>    // It registers the dynamic object if it has to and sets a mangled name on the child to make it unique.
36701>>>>>>>    // It then recurses down.
36701>>>>>>>    Procedure CreateLocalFor Handle hoObj Handle hoParent Handle hoMaxParent
36703>>>>>>>        Integer iIndex iSyncRequestResponse
36703>>>>>>>        Boolean bRequiresChildren
36703>>>>>>>        tWebDynamicObject tDynamicObject
36703>>>>>>>        tWebDynamicObject tDynamicObject
36703>>>>>>>        tWebDynamicObject[] aDynamicObjects  
36703>>>>>>>        tWebDynamicObject[] aDynamicObjects  
36704>>>>>>>        
36704>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36705>>>>>>>        
36705>>>>>>>        // Get parent info.
36705>>>>>>>        Get psDynamicObjectId of hoParent to tDynamicObject.sParentId
36706>>>>>>>        Get CreateLongNameUsingParents hoObj hoMaxParent to tDynamicObject.sId
36707>>>>>>>        
36707>>>>>>>        // Find a registration.
36707>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36708>>>>>>>        If (iIndex = -1) Begin
36710>>>>>>>            // Dynamic object has not been registered before, so append it  
36710>>>>>>>            Move (BinarySearchInsertPos()) to iIndex
36711>>>>>>>            Get ObjectClass of hoObj to tDynamicObject.iClassId
36712>>>>>>>            Move False to tDynamicObject.bRendered
36713>>>>>>>            
36713>>>>>>>            Move (InsertInArray(aDynamicObjects, iIndex, tDynamicObject)) to aDynamicObjects
36714>>>>>>>            
36714>>>>>>>            WebSet paDynamicObjects to aDynamicObjects
36715>>>>>>>        End
36715>>>>>>>>
36715>>>>>>>        
36715>>>>>>>        // Now apply state.
36715>>>>>>>        Set psDynamicObjectId of hoObj to tDynamicObject.sId
36716>>>>>>>        Set phoOwner of hoObj to Self
36717>>>>>>>        
36717>>>>>>>        Send ApplyDynamicProps tDynamicObject.sId hoObj
36718>>>>>>>        Send StoreDirectHandle tDynamicObject.sId hoObj
36719>>>>>>>        
36719>>>>>>>        // Call to attempt to sync DDO's
36719>>>>>>>        Get SyncDynamicDDOs hoObj to iSyncRequestResponse
36720>>>>>>>        If (iSyncRequestResponse = -1) Begin
36722>>>>>>>            // Request response -1 means no access, so we should destroy this object to prevent any possible calls
36722>>>>>>>            Send DestroyDynamicObject tDynamicObject.sId
36723>>>>>>>            Procedure_Return
36724>>>>>>>        End
36724>>>>>>>>
36724>>>>>>>
36724>>>>>>>        // Process belated childs.
36724>>>>>>>        Send CreateLocalOfChildren hoObj hoMaxParent
36725>>>>>>>        
36725>>>>>>>        //  All data bindable objects need AfterAttachDDO message (even through Data awareness is not supported on dynamic objects for now)
36725>>>>>>>        If (pbDataBindable(hoObj)) Begin
36727>>>>>>>            Send AfterAttachDDO of hoObj
36728>>>>>>>        End
36728>>>>>>>>
36728>>>>>>>        
36728>>>>>>>        // WebRadio's require slightly different logic. Here we check if the 
36728>>>>>>>        // object we want to create is a cWebRadio. 
36728>>>>>>>        If (IsObjectOfClass(hoObj, (RefClass(cWebRadio)))) Begin
36730>>>>>>>            Send RegisterRadio hoObj
36731>>>>>>>        End
36731>>>>>>>>
36731>>>>>>>        
36731>>>>>>>        Get RequiresChildren hoObj to bRequiresChildren
36732>>>>>>>        If (bRequiresChildren) Begin      
36734>>>>>>>            Send CreateChildren tDynamicObject.sId
36735>>>>>>>        End
36735>>>>>>>>
36735>>>>>>>        
36735>>>>>>>        // Insert object at end of parent's child structure
36735>>>>>>>        If (pbIsCreating(Self)) Begin
36737>>>>>>>            Send AppendToSiblings tDynamicObject.sId
36738>>>>>>>        End
36738>>>>>>>>
36738>>>>>>>    End_Procedure
36739>>>>>>>    
36739>>>>>>>    
36739>>>>>>>    Procedure CreateLocalOfChildren Handle hoParent Handle hoMaxParent
36741>>>>>>>        Integer iIndex
36741>>>>>>>        Handle hoChild
36741>>>>>>>        
36741>>>>>>>        For iIndex from 0 to (Child_Count(hoParent) - 1)
36747>>>>>>>>
36747>>>>>>>            Get ChildByIndex of hoParent iIndex to hoChild
36748>>>>>>>            If (IsObjectOfClass(hoChild, RefClass(cWebObject))) Begin
36750>>>>>>>                Send CreateLocalFor hoChild hoParent hoMaxParent
36751>>>>>>>            End
36751>>>>>>>>
36751>>>>>>>        Loop
36752>>>>>>>>
36752>>>>>>>    End_Procedure
36753>>>>>>>    
36753>>>>>>>     
36753>>>>>>>    // Destroys all dynamic objects on the server. This procedure is
36753>>>>>>>    // executed after every call from the client to prevent spawning too 
36753>>>>>>>    // many objects in complex applications.
36753>>>>>>>    Procedure DestroyLocalObjects
36755>>>>>>>        Handle hoChild
36755>>>>>>>        Integer iObject
36755>>>>>>>        String sDynamicObjectName
36755>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36755>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36756>>>>>>>        tWebClientAction[] aClientActions
36756>>>>>>>        tWebClientAction[] aClientActions
36757>>>>>>>            
36757>>>>>>>        Get paDynamicObjectsInMemory to aDynamicObjectsInMemory
36758>>>>>>>        
36758>>>>>>>        For iObject from 0 to (Child_Count(Self) - 1)
36764>>>>>>>>
36764>>>>>>>            Get ChildByIndex iObject to hoChild
36765>>>>>>>            If (IsObjectOfClass(hoChild, RefClass(cWebObject))) Begin
36767>>>>>>>                Get psDynamicObjectId of hoChild to sDynamicObjectName
36768>>>>>>>                If (IsDynamicObject(hoChild) and SizeOfString(sDynamicObjectName)) Begin
36770>>>>>>>                    Send StoreDynamicDDOs hoChild
36771>>>>>>>                    Send Destroy of hoChild
36772>>>>>>>                    Decrement iObject
36773>>>>>>>                End
36773>>>>>>>>
36773>>>>>>>            End
36773>>>>>>>>
36773>>>>>>>        Loop
36774>>>>>>>>
36774>>>>>>>        
36774>>>>>>>        Move (ResizeArray(aDynamicObjectsInMemory, 0)) to aDynamicObjectsInMemory
36775>>>>>>>        Set paDynamicObjectsInMemory to aDynamicObjectsInMemory
36776>>>>>>>        Set paClientActionsQueue to aClientActions  // Should be empty, clear to preven cross session leakage
36777>>>>>>>    End_Procedure
36778>>>>>>>    
36778>>>>>>>    
36778>>>>>>>    // Returns the handle of a dynamic object from memory. Does not guarantee
36778>>>>>>>    // the object exists or is loaded. Do not use this method to get the handle
36778>>>>>>>    // of a dynamic object in applications. Use 'Get DynamicObject' instead.
36778>>>>>>>    Function StoredHandle String sDynamicObjectId Returns Handle
36780>>>>>>>        Integer iObjectIndex iHandleIndex
36780>>>>>>>        Handle hoObj
36780>>>>>>>        tObjectInMemory tObject
36780>>>>>>>        tObjectInMemory tObject
36780>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36780>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36781>>>>>>>
36781>>>>>>>        Get paDynamicObjectsInMemory to aDynamicObjectsInMemory
36782>>>>>>>        
36782>>>>>>>        Move sDynamicObjectId to tObject.sDynamicObjectId
36783>>>>>>>        
36783>>>>>>>        Move (BinarySearchArray(tObject, aDynamicObjectsInMemory, False)) to iHandleIndex
36784>>>>>>>        If (iHandleIndex <> -1) Begin
36786>>>>>>>            Move aDynamicObjectsInMemory[iHandleIndex].hoObj to hoObj
36787>>>>>>>        End
36787>>>>>>>>
36787>>>>>>>        
36787>>>>>>>        Function_Return hoObj
36788>>>>>>>    End_Function
36789>>>>>>>    
36789>>>>>>>    // Saves the handle for a dynamic object in memory.
36789>>>>>>>    Procedure StoreDirectHandle String sDynamicObjectId Handle hoObj
36791>>>>>>>        Integer iHandleIndex iIndex
36791>>>>>>>        tObjectInMemory tObject
36791>>>>>>>        tObjectInMemory tObject
36791>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36791>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36792>>>>>>>        
36792>>>>>>>        Get paDynamicObjectsInMemory to aDynamicObjectsInMemory
36793>>>>>>>        
36793>>>>>>>        Move sDynamicObjectId to tObject.sDynamicObjectId
36794>>>>>>>        
36794>>>>>>>        Move (BinarySearchArray(tObject, aDynamicObjectsInMemory, False)) to iHandleIndex
36795>>>>>>>        If (iHandleIndex <> -1) Begin
36797>>>>>>>            // Update handle
36797>>>>>>>            Move hoObj to aDynamicObjectsInMemory[iHandleIndex].hoObj
36798>>>>>>>        End
36798>>>>>>>>
36798>>>>>>>        Else Begin
36799>>>>>>>            // Set new handle
36799>>>>>>>            Move (BinarySearchInsertPos()) to iIndex
36800>>>>>>>            Move sDynamicObjectId to tObject.sDynamicObjectId
36801>>>>>>>            Move hoObj to tObject.hoObj
36802>>>>>>>            
36802>>>>>>>            Move (InsertInArray(aDynamicObjectsInMemory, iIndex, tObject)) to aDynamicObjectsInMemory
36803>>>>>>>        End  
36803>>>>>>>>
36803>>>>>>>        
36803>>>>>>>        Set paDynamicObjectsInMemory to aDynamicObjectsInMemory
36804>>>>>>>    End_Procedure
36805>>>>>>>    
36805>>>>>>>    // Saves the handle for a dynamic object in memory.
36805>>>>>>>    Procedure RetrieveOrCreateHandle String sDynamicObjectId Handle ByRef hoObj Handle hoParent Integer iClassId 
36807>>>>>>>        Integer iHandleIndex iIndex
36807>>>>>>>        tObjectInMemory tObject
36807>>>>>>>        tObjectInMemory tObject
36807>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36807>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36808>>>>>>>        
36808>>>>>>>        Get paDynamicObjectsInMemory to aDynamicObjectsInMemory
36809>>>>>>>        
36809>>>>>>>        Move sDynamicObjectId to tObject.sDynamicObjectId
36810>>>>>>>        
36810>>>>>>>        Move (BinarySearchArray(tObject, aDynamicObjectsInMemory, False)) to iHandleIndex
36811>>>>>>>        If (iHandleIndex <> -1) Begin
36813>>>>>>>            // Retrieve handle
36813>>>>>>>            Move aDynamicObjectsInMemory[iHandleIndex].hoObj to hoObj            
36814>>>>>>>        End
36814>>>>>>>>
36814>>>>>>>        Else Begin
36815>>>>>>>            // Create new handle
36815>>>>>>>            Move (BinarySearchInsertPos()) to iIndex
36816>>>>>>>            Move sDynamicObjectId to tObject.sDynamicObjectId
36817>>>>>>>            
36817>>>>>>>            Get CreateNamed of hoParent iClassId ("#" + sDynamicObjectId) to hoObj
36818>>>>>>>            Move hoObj to tObject.hoObj
36819>>>>>>>            
36819>>>>>>>            Move (InsertInArray(aDynamicObjectsInMemory, iIndex, tObject)) to aDynamicObjectsInMemory
36820>>>>>>>        End  
36820>>>>>>>>
36820>>>>>>>        
36820>>>>>>>        Set paDynamicObjectsInMemory to aDynamicObjectsInMemory
36821>>>>>>>    End_Procedure
36822>>>>>>>    
36822>>>>>>>    
36822>>>>>>>    // ==========================================
36822>>>>>>>    // SYNCHRONIZED PROPERTY HANDLING (3RD LEVEL)
36822>>>>>>>    // ==========================================
36822>>>>>>>    
36822>>>>>>>    // Dynamic objects have three levels of properties. The first level contains properties that
36822>>>>>>>    // are set in the subclass definition of the object. The second level properties (called 
36822>>>>>>>    // dynamic properties) can be different for individual instances of objects. Two dynamic
36822>>>>>>>    // buttons of the same class can have different initial properties. The third and final 
36822>>>>>>>    // level contains properties that are changed at runtime. This is done using regular
36822>>>>>>>    // WebGet/WebSet operations.
36822>>>>>>>    
36822>>>>>>>    
36822>>>>>>>    // Sets a synchronized property.
36822>>>>>>>    Procedure OwnerSetSyncProp Handle hoObj tWebPropMetaData ByRef pubProp Variant vPropValue
36824>>>>>>>        Integer iPubPropIndex
36824>>>>>>>        String sObjName sDynamicObjectId
36824>>>>>>>        Boolean bIsRendered bAdvanced bIsAjaxWebObject
36824>>>>>>>        tWebNameValue tProp
36824>>>>>>>        tWebNameValue tProp
36824>>>>>>>        tWebAdvSyncProp tAdvProp
36824>>>>>>>        tWebAdvSyncProp tAdvProp
36824>>>>>>>        tQueuedSyncProp tQueuedProp
36824>>>>>>>        tQueuedSyncProp tQueuedProp
36824>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36824>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36825>>>>>>>
36825>>>>>>>                
36825>>>>>>>        // Test that the target object is a cWebObject....
36825>>>>>>>        Get IsAjaxWebObject of hoObj to bIsAjaxWebObject
36826>>>>>>>        
36826>>>>>>>        If (not(bIsAjaxWebObject)) Begin
36828>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppNotWebObject, Name(hoObj), "WebSet " + pubProp.sName, C_NewLine+C_NewLine))
36829>>>>>>>>
36829>>>>>>>            Procedure_Return
36830>>>>>>>        End
36830>>>>>>>>
36830>>>>>>>               
36830>>>>>>>        
36830>>>>>>>        Get WebObjectName of hoObj to sObjName
36831>>>>>>>        Get psDynamicObjectId of hoObj to sDynamicObjectId
36832>>>>>>>        Move False to bAdvanced
36833>>>>>>>        
36833>>>>>>>        // Check if property is advanced
36833>>>>>>>        If (pubProp.eType = cArgArray or pubProp.eType = cArgStruct) Begin
36835>>>>>>>            Move True to bAdvanced
36836>>>>>>>        End
36836>>>>>>>>
36836>>>>>>>        
36836>>>>>>>        // If the object has not been rendered yet, it is not known to the client.
36836>>>>>>>        // Therefore, all properties set before an object is rendered will be added
36836>>>>>>>        // to a special queue, so they are initialized when the object is created.
36836>>>>>>>        Get IsRendered sDynamicObjectId to bIsRendered
36837>>>>>>>        If (not(bIsRendered) and (pubProp.eMode = wptClient or pubProp.eMode = wptClientProtected)) Begin
36839>>>>>>>            WebGet paSyncPropsQueue to aSyncPropsQueue
36840>>>>>>>            
36840>>>>>>>            Move sObjName to tQueuedProp.sO
36841>>>>>>>            Move pubProp.sName to tQueuedProp.sP
36842>>>>>>>            
36842>>>>>>>            If (bAdvanced) Begin
36844>>>>>>>                Move True to tQueuedProp.bA
36845>>>>>>>                ValueTreeSerializeParameter vPropValue to tQueuedProp.tVT  
36846>>>>>>>            End
36846>>>>>>>>
36846>>>>>>>            Else Begin
36847>>>>>>>                Move False to tQueuedProp.bA
36848>>>>>>>                Get ConvertToTransport of hoObj pubProp.hmGetter vPropValue pubProp.eType to tQueuedProp.sV
36849>>>>>>>            End
36849>>>>>>>>
36849>>>>>>>            
36849>>>>>>>            Move tQueuedProp to aSyncPropsQueue[SizeOfArray(aSyncPropsQueue)]
36850>>>>>>>            WebSet paSyncPropsQueue to aSyncPropsQueue
36851>>>>>>>            
36851>>>>>>>            If (pubProp.eMode = wptClient) ;                Procedure_Return
36854>>>>>>>        End
36854>>>>>>>>
36854>>>>>>>        
36854>>>>>>>        // This function accepts both advanced and regular properties.        
36854>>>>>>>        If (bAdvanced) Begin
36856>>>>>>>            ValueTreeSerializeParameter vPropValue to tAdvProp.tV
36857>>>>>>>            Move sObjName to tAdvProp.sO
36858>>>>>>>            Move pubProp.sName to tAdvProp.sP
36859>>>>>>>            
36859>>>>>>>            If (pubProp.eMode = wptClientProtected) Begin
36861>>>>>>>                Send SetAdvPropInWrapper wptClient (&tAdvProp)
36862>>>>>>>                Send SetAdvPropInWrapper wptServerPage (&tAdvProp)
36863>>>>>>>            End
36863>>>>>>>>
36863>>>>>>>            Else Begin
36864>>>>>>>                Send SetAdvPropInWrapper pubProp.eMode (&tAdvProp)
36865>>>>>>>            End
36865>>>>>>>>
36865>>>>>>>        End
36865>>>>>>>>
36865>>>>>>>        Else Begin
36866>>>>>>>            Move pubProp.sName to tProp.sN
36867>>>>>>>            Get ConvertToTransport of hoObj pubProp.hmGetter vPropValue pubProp.eType to  tProp.sV
36868>>>>>>>           
36868>>>>>>>            If (pubProp.eMode = wptClientProtected) Begin
36870>>>>>>>                If (bIsRendered) ;                    Send SetPropInWrapper wptClient sObjName (&tProp)
36873>>>>>>>                Send SetPropInWrapper wptServerPage sObjName (&tProp)
36874>>>>>>>            End
36874>>>>>>>>
36874>>>>>>>            Else Begin
36875>>>>>>>                Send SetPropInWrapper pubProp.eMode sObjName (&tProp)
36876>>>>>>>            End
36876>>>>>>>>
36876>>>>>>>           
36876>>>>>>>        End 
36876>>>>>>>>
36876>>>>>>>    End_Procedure
36877>>>>>>>    
36877>>>>>>>    Procedure SetPropInWrapper Integer eMode String sObjectName tWebNameValue ByRef newProp
36879>>>>>>>        tWebSyncPropsWrapper wrapper
36879>>>>>>>        tWebSyncPropsWrapper wrapper
36879>>>>>>>        tWebSyncProps objProps
36879>>>>>>>        tWebSyncProps objProps
36879>>>>>>>        Integer iObjectIndex iPropIndex
36879>>>>>>>        
36879>>>>>>>        If (eMode = wptClient) Begin
36881>>>>>>>            WebGet ptSyncPropsWrapper to wrapper
36882>>>>>>>            Move (SortArray(wrapper.aSyncProps, False)) to wrapper.aSyncProps
36883>>>>>>>        End
36883>>>>>>>>
36883>>>>>>>        Else If (eMode = wptServerPage) Begin
36886>>>>>>>            WebGet ptSyncServerPropsWrapper to wrapper
36887>>>>>>>        End
36887>>>>>>>>
36887>>>>>>>        Else If (eMode = wptServerSession) Begin
36890>>>>>>>            WebGet ptSyncServerSessionPropsWrapper to wrapper 
36891>>>>>>>        End
36891>>>>>>>>
36891>>>>>>>        
36891>>>>>>>        
36891>>>>>>>        Move sObjectName to objProps.sO
36892>>>>>>>        
36892>>>>>>>        // First find the object containing all properties for a dynamic object            
36892>>>>>>>        Move (BinarySearchArray(objProps, wrapper.aSyncProps, False)) to iObjectIndex
36893>>>>>>>        If (iObjectIndex <> -1) Begin
36895>>>>>>>            Move (BinarySearchArray(newProp, wrapper.aSyncProps[iObjectIndex].aP, False)) to iPropIndex
36896>>>>>>>            If (iPropIndex <> -1) Begin
36898>>>>>>>                // Update property value
36898>>>>>>>                Move newProp.sV to wrapper.aSyncProps[iObjectIndex].aP[iPropIndex].sV
36899>>>>>>>            End
36899>>>>>>>>
36899>>>>>>>            Else Begin
36900>>>>>>>                // Add new property
36900>>>>>>>                Move (BinarySearchInsertPos()) to iPropIndex
36901>>>>>>>                
36901>>>>>>>                Move (InsertInArray(wrapper.aSyncProps[iObjectIndex].aP, iPropIndex, newProp)) to wrapper.aSyncProps[iObjectIndex].aP
36902>>>>>>>            End
36902>>>>>>>>
36902>>>>>>>        End
36902>>>>>>>>
36902>>>>>>>        Else Begin
36903>>>>>>>            // Object has no synchronized properties yet, so add an entry for this object
36903>>>>>>>            Move (BinarySearchInsertPos()) to iObjectIndex
36904>>>>>>>            
36904>>>>>>>            Move newProp to objProps.aP[0]
36905>>>>>>>            
36905>>>>>>>            Move (InsertInArray(wrapper.aSyncProps, iObjectIndex, objProps)) to wrapper.aSyncProps
36906>>>>>>>        End
36906>>>>>>>>
36906>>>>>>>        
36906>>>>>>>        If (eMode = wptClient) Begin
36908>>>>>>>            WebSet ptSyncPropsWrapper to wrapper
36909>>>>>>>            Move (SortArray(wrapper.aSyncProps, False)) to wrapper.aSyncProps
36910>>>>>>>        End
36910>>>>>>>>
36910>>>>>>>        Else If (eMode = wptServerPage) Begin
36913>>>>>>>            WebSet ptSyncServerPropsWrapper to wrapper
36914>>>>>>>        End
36914>>>>>>>>
36914>>>>>>>        Else If (eMode = wptServerSession) Begin
36917>>>>>>>            WebSet ptSyncServerSessionPropsWrapper to wrapper 
36918>>>>>>>        End        
36918>>>>>>>>
36918>>>>>>>    End_Procedure
36919>>>>>>>    
36919>>>>>>>    Procedure SetAdvPropInWrapper  Integer eMode tWebAdvSyncProp ByRef newProp
36921>>>>>>>        tWebAdvSyncPropsWrapper wrapper
36921>>>>>>>        tWebAdvSyncPropsWrapper wrapper
36921>>>>>>>        Integer iPropIndex
36921>>>>>>>        
36921>>>>>>>        If (eMode = wptClient) Begin
36923>>>>>>>            WebGet ptAdvSyncPropsWrapper to wrapper
36924>>>>>>>        End
36924>>>>>>>>
36924>>>>>>>        Else If (eMode = wptServerPage) Begin
36927>>>>>>>            WebGet ptAdvServerSyncPropsWrapper to wrapper
36928>>>>>>>        End
36928>>>>>>>>
36928>>>>>>>        Else If (eMode = wptServerSession) Begin
36931>>>>>>>            WebGet ptAdvServerSessionSyncPropsWrapper to wrapper 
36932>>>>>>>        End
36932>>>>>>>>
36932>>>>>>>
36932>>>>>>>        
36932>>>>>>>        
36932>>>>>>>        // First find the object containing all advanced properties for a dynamic object            
36932>>>>>>>        Move (SearchArray(newProp, wrapper.aAdvSyncProps, Self, RefFunc(CompareAdvProp))) to iPropIndex
36933>>>>>>>        Move newProp to wrapper.aAdvSyncProps[iPropIndex]
36934>>>>>>>        
36934>>>>>>>        If (eMode = wptClient) Begin
36936>>>>>>>            WebSet ptAdvSyncPropsWrapper to wrapper
36937>>>>>>>        End
36937>>>>>>>>
36937>>>>>>>        Else If (eMode = wptServerPage) Begin
36940>>>>>>>            WebSet ptAdvServerSyncPropsWrapper to wrapper
36941>>>>>>>        End
36941>>>>>>>>
36941>>>>>>>        Else If (eMode = wptServerSession) Begin
36944>>>>>>>            WebSet ptAdvServerSessionSyncPropsWrapper to wrapper 
36945>>>>>>>        End
36945>>>>>>>>
36945>>>>>>>    End_Procedure
36946>>>>>>>    
36946>>>>>>>    
36946>>>>>>>    
36946>>>>>>>    // Gets a synchronized property.
36946>>>>>>>    Function OwnerGetSyncProp Handle hoObj tWebPropMetaData ByRef pubProp Returns String
36948>>>>>>>        String sResult
36948>>>>>>>        Integer iObjectIndex iPropIndex 
36948>>>>>>>        String sObjName sDynamicObjectId
36948>>>>>>>        Boolean bExists bIsRendered bIsAjaxWebObject
36948>>>>>>>        tWebNameValue tProp tCompareProp
36948>>>>>>>        tWebNameValue tProp tCompareProp
36948>>>>>>>        tWebValueTree tVT
36948>>>>>>>        tWebValueTree tVT
36948>>>>>>>        tWebSyncProps tCompareSyncProps
36948>>>>>>>        tWebSyncProps tCompareSyncProps
36948>>>>>>>        tWebSyncProps[] aSyncProps
36948>>>>>>>        tWebSyncProps[] aSyncProps
36949>>>>>>>        tWebSyncPropsWrapper wrapper
36949>>>>>>>        tWebSyncPropsWrapper wrapper
36949>>>>>>>        tQueuedSyncProp tQueuedProp
36949>>>>>>>        tQueuedSyncProp tQueuedProp
36949>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue 
36949>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue 
36950>>>>>>>        
36950>>>>>>>        // Test that the target object is a cWebObject....
36950>>>>>>>        Get IsAjaxWebObject of hoObj to bIsAjaxWebObject
36951>>>>>>>        
36951>>>>>>>        If (not(bIsAjaxWebObject)) Begin
36953>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppNotWebObject, Name(hoObj), "WebSet " + pubProp.sName, C_NewLine+C_NewLine))
36954>>>>>>>>
36954>>>>>>>            Procedure_Return
36955>>>>>>>        End
36955>>>>>>>>
36955>>>>>>>        
36955>>>>>>>        
36955>>>>>>>        Get WebObjectName of hoObj to sObjName
36956>>>>>>>        Get psDynamicObjectId of hoObj to sDynamicObjectId
36957>>>>>>>        
36957>>>>>>>        
36957>>>>>>>        // If the object has not been rendered yet, it is not known to the client.
36957>>>>>>>        // Therefore, all properties set before an object is rendered are added
36957>>>>>>>        // to a special queue, so they are initialized when the object is created.
36957>>>>>>>        Get IsRendered sDynamicObjectId to bIsRendered
36958>>>>>>>        If (not(bIsRendered) and pubProp.eMode = wptClient) Begin
36960>>>>>>>            WebGet paSyncPropsQueue to aSyncPropsQueue
36961>>>>>>>            
36961>>>>>>>            Move sObjName to tQueuedProp.sO
36962>>>>>>>            Move pubProp.sName to tQueuedProp.sP
36963>>>>>>>            Move (SearchArray(tQueuedProp, aSyncPropsQueue, (Self), (RefFunc(CompareQueuedSyncProps)))) to iPropIndex
36964>>>>>>>            If (iPropIndex <> -1) Begin
36966>>>>>>>                Move aSyncPropsQueue[iPropIndex].sV to sResult
36967>>>>>>>                
36967>>>>>>>                Function_Return sResult
36968>>>>>>>            End
36968>>>>>>>>
36968>>>>>>>            
36968>>>>>>>            // This code is only reached if the property is not synchronized. Therefore, 
36968>>>>>>>            // return the default value of the property.
36968>>>>>>>            Get pubProp.hmGetter of hoObj to sResult
36969>>>>>>>            Function_Return sResult  
36970>>>>>>>        End
36970>>>>>>>>
36970>>>>>>>        
36970>>>>>>>        // This function accepts only scalar properties
36970>>>>>>>        If (pubProp.eMode = wptClient) Begin
36972>>>>>>>            WebGet ptSyncPropsWrapper to wrapper
36973>>>>>>>            Move (SortArray(wrapper.aSyncProps, False)) to wrapper.aSyncProps
36974>>>>>>>        End
36974>>>>>>>>
36974>>>>>>>        Else If (pubProp.eMode = wptServerPage or pubProp.eMode = wptClientProtected) Begin
36977>>>>>>>            WebGet ptSyncServerPropsWrapper to wrapper
36978>>>>>>>        End
36978>>>>>>>>
36978>>>>>>>        Else If (pubProp.eMode = wptServerSession) Begin
36981>>>>>>>            WebGet ptSyncServerSessionPropsWrapper to wrapper 
36982>>>>>>>        End
36982>>>>>>>>
36982>>>>>>>        
36982>>>>>>>        Move sObjName to tCompareSyncProps.sO
36983>>>>>>>        
36983>>>>>>>        // Check if object has any synchronized properties
36983>>>>>>>        Move (BinarySearchArray(tCompareSyncProps, wrapper.aSyncProps, False)) to iObjectIndex
36984>>>>>>>        If (iObjectIndex <> -1) Begin    
36986>>>>>>>            Move pubProp.sName to tCompareProp.sN
36987>>>>>>>                  
36987>>>>>>>            // Check if object has given synchronized property
36987>>>>>>>            Move (BinarySearchArray(tCompareProp, wrapper.aSyncProps[iObjectIndex].aP, False)) to iPropIndex
36988>>>>>>>            If (iPropIndex <> -1) Begin
36990>>>>>>>                Get ConvertFromTransport of hoObj pubProp.hmGetter wrapper.aSyncProps[iObjectIndex].aP[iPropIndex].sV pubProp.eType to sResult
36991>>>>>>>                Function_Return sResult
36992>>>>>>>            End
36992>>>>>>>>
36992>>>>>>>        End
36992>>>>>>>>
36992>>>>>>>        
36992>>>>>>>        // This code is only reached if the property is not synchronized. Therefore, 
36992>>>>>>>        // return the default value of the property.
36992>>>>>>>        Get pubProp.hmGetter of hoObj to sResult
36993>>>>>>>        Function_Return sResult             
36994>>>>>>>    End_Function
36995>>>>>>>   
36995>>>>>>>   
36995>>>>>>>    // Gets a synchronized property.
36995>>>>>>>    Function OwnerGetAdvSyncProp Handle hoObj tWebPropMetaData ByRef pubProp Returns Variant
36997>>>>>>>        Variant vResult
36997>>>>>>>        Integer iPropIndex iPubPropIndex iGetterIndex
36997>>>>>>>        String sObjName sDynamicObjectId
36997>>>>>>>        Boolean bExists bIsRendered bIsAjaxWebObject
36997>>>>>>>        tWebAdvSyncProp tCompareAdvProp 
36997>>>>>>>        tWebAdvSyncProp tCompareAdvProp 
36997>>>>>>>        tWebAdvSyncPropsWrapper wrapper
36997>>>>>>>        tWebAdvSyncPropsWrapper wrapper
36997>>>>>>>        tQueuedSyncProp tQueuedProp
36997>>>>>>>        tQueuedSyncProp tQueuedProp
36997>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue 
36997>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue 
36998>>>>>>>                
36998>>>>>>>        // Test that the target object is a cWebObject....
36998>>>>>>>        Get IsAjaxWebObject of hoObj to bIsAjaxWebObject
36999>>>>>>>        
36999>>>>>>>        If (not(bIsAjaxWebObject)) Begin
37001>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppNotWebObject, Name(hoObj), "WebSet " + pubProp.sName, C_NewLine+C_NewLine))
37002>>>>>>>>
37002>>>>>>>            Procedure_Return
37003>>>>>>>        End
37003>>>>>>>>
37003>>>>>>>        
37003>>>>>>>        
37003>>>>>>>        Get WebObjectName of hoObj to sObjName
37004>>>>>>>        Get psDynamicObjectId of hoObj to sDynamicObjectId
37005>>>>>>>            
37005>>>>>>>        // If the object has not been rendered yet, it is not known to the client.
37005>>>>>>>        // Therefore, all properties set before an object is rendered are added
37005>>>>>>>        // to a special queue, so they are initialized when the object is created.
37005>>>>>>>        Get IsRendered sDynamicObjectId to bIsRendered
37006>>>>>>>        If (not(bIsRendered) and pubProp.eMode = wptClient) Begin
37008>>>>>>>            WebGet paSyncPropsQueue to aSyncPropsQueue
37009>>>>>>>            
37009>>>>>>>            Move sObjName to tQueuedProp.sO
37010>>>>>>>            Move pubProp.sName to tQueuedProp.sP
37011>>>>>>>            Move (SearchArray(tQueuedProp, aSyncPropsQueue, (Self), (RefFunc(CompareQueuedSyncProps)))) to iPropIndex
37012>>>>>>>            If (iPropIndex <> -1) Begin
37014>>>>>>>                Get pubProp.hmGetter of hoObj to vResult
37015>>>>>>>                ValueTreeDeserializeParameter aSyncPropsQueue[iPropIndex].tVT to vResult
37016>>>>>>>            
37016>>>>>>>                Function_Return vResult
37017>>>>>>>            End
37017>>>>>>>>
37017>>>>>>>            
37017>>>>>>>            // This code is only reached if the property is not synchronized. Therefore, 
37017>>>>>>>            // return the default value of the property.
37017>>>>>>>            Get pubprop.hmGetter of hoObj to vResult
37018>>>>>>>            Function_Return vResult  
37019>>>>>>>        End
37019>>>>>>>>
37019>>>>>>>        
37019>>>>>>>        // This function accepts only non-scalar(advanced)
37019>>>>>>>        If (pubProp.eMode = wptClient) Begin
37021>>>>>>>            WebGet ptAdvSyncPropsWrapper to wrapper
37022>>>>>>>            Move (SortArray(wrapper.aAdvSyncProps, False)) to wrapper.aAdvSyncProps
37023>>>>>>>        End
37023>>>>>>>>
37023>>>>>>>        Else If (pubProp.eMode = wptServerPage or pubProp.eMode = wptClientProtected) Begin
37026>>>>>>>            WebGet ptAdvServerSyncPropsWrapper to wrapper
37027>>>>>>>        End
37027>>>>>>>>
37027>>>>>>>        Else If (pubProp.eMode = wptServerSession) Begin
37030>>>>>>>            WebGet ptAdvServerSessionSyncPropsWrapper to wrapper 
37031>>>>>>>        End
37031>>>>>>>>
37031>>>>>>>        
37031>>>>>>>        Move sObjName to tCompareAdvProp.sO
37032>>>>>>>        Move pubProp.sName to tCompareAdvProp.sP
37033>>>>>>>        
37033>>>>>>>        // Check if object has any advanced synchronized properties
37033>>>>>>>        Move (SearchArray(tCompareAdvProp, wrapper.aAdvSyncProps, Self, (RefFunc(CompareAdvProp)))) to iPropIndex
37034>>>>>>>        If (iPropIndex <> -1) Begin 
37036>>>>>>>            
37036>>>>>>>            Get pubProp.hmGetter of hoObj to vResult
37037>>>>>>>            ValueTreeDeserializeParameter wrapper.aAdvSyncProps[iPropIndex].tV to vResult
37038>>>>>>>        
37038>>>>>>>            Function_Return vResult
37039>>>>>>>        End
37039>>>>>>>>
37039>>>>>>>        
37039>>>>>>>        
37039>>>>>>>        // This code is only reached if the property is not synchronized. Therefore, 
37039>>>>>>>        // return the default value of the property.
37039>>>>>>>        Get pubProp.hmGetter of hoObj to vResult
37040>>>>>>>        Function_Return vResult             
37041>>>>>>>    End_Function
37042>>>>>>>    
37042>>>>>>>    // =====================================
37042>>>>>>>    // DYNAMIC PROPERTY HANDLING (2ND LEVEL)
37042>>>>>>>    // =====================================
37042>>>>>>>    
37042>>>>>>>    // Sets a dynamic property.
37042>>>>>>>    Procedure SetDynamicProp Handle hoObj tWebPropMetaData pubProp Variant vPropValue
37044>>>>>>>        Integer iObjectIndex iPropIndex iSize iIndex
37044>>>>>>>        String sDynamicObjectId sName
37044>>>>>>>        Boolean bAdvanced
37044>>>>>>>        Handle hmGetter
37044>>>>>>>        tWebNameValue   tCompareProp
37044>>>>>>>        tWebNameValue   tCompareProp
37044>>>>>>>        tWebAdvSyncProp tCompareAdvProp
37044>>>>>>>        tWebAdvSyncProp tCompareAdvProp
37044>>>>>>>        tWebValueTree tVT
37044>>>>>>>        tWebValueTree tVT
37044>>>>>>>        tWebDynamicObject tDynamicObject
37044>>>>>>>        tWebDynamicObject tDynamicObject
37044>>>>>>>        tWebDynamicObject[] aDynamicObjects
37044>>>>>>>        tWebDynamicObject[] aDynamicObjects
37045>>>>>>>        Get WebObjectName to sName
37046>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
37047>>>>>>>        Get psDynamicObjectId of hoObj to sDynamicObjectId
37048>>>>>>>
37048>>>>>>>        
37048>>>>>>>        If (pubProp.eType = cArgArray or pubProp.eType = cArgStruct) Begin
37050>>>>>>>            Move True to bAdvanced
37051>>>>>>>        End
37051>>>>>>>>
37051>>>>>>>        
37051>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
37052>>>>>>>        
37052>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iObjectIndex
37053>>>>>>>        If (iObjectIndex <> -1) Begin    
37055>>>>>>>            If (bAdvanced) Begin         
37057>>>>>>>                Move pubProp.sName to tCompareAdvProp.sP
37058>>>>>>>                ValueTreeSerializeParameter vPropValue to tVT
37059>>>>>>>                
37059>>>>>>>                // Then find the advanced property we are looking for
37059>>>>>>>                Move (BinarySearchArray(tCompareAdvProp, aDynamicObjects[iObjectIndex].aAdvProps, Self, RefFunc(CompareAdvPropNames))) to iPropIndex
37060>>>>>>>                If (iPropIndex <> -1) Begin
37062>>>>>>>                    // Update property value
37062>>>>>>>                    Move tVT to aDynamicObjects[iObjectIndex].aAdvProps[iPropIndex].tV
37063>>>>>>>                End
37063>>>>>>>>
37063>>>>>>>                Else Begin
37064>>>>>>>                    // Add new property     
37064>>>>>>>                    Move (BinarySearchInsertPos()) to iIndex
37065>>>>>>>                    
37065>>>>>>>                    Move pubProp.sName to tCompareAdvProp.sP
37066>>>>>>>                    Move tVT       to tCompareAdvProp.tV
37067>>>>>>>                    Move (InsertInArray(aDynamicObjects[iObjectIndex].aAdvProps, iIndex, tCompareAdvProp)) to aDynamicObjects[iObjectIndex].aAdvProps
37068>>>>>>>                End
37068>>>>>>>>
37068>>>>>>>                
37068>>>>>>>                WebSet paDynamicObjects to aDynamicObjects
37069>>>>>>>            End
37069>>>>>>>>
37069>>>>>>>            Else Begin              
37070>>>>>>>                Move pubProp.sName to tCompareProp.sN
37071>>>>>>>                
37071>>>>>>>                // Find the property we are looking for
37071>>>>>>>                Move (BinarySearchArray(tCompareProp, aDynamicObjects[iObjectIndex].aProps, False)) to iPropIndex
37072>>>>>>>                If (iPropIndex <> -1) Begin
37074>>>>>>>                    // Update prop value
37074>>>>>>>                    Move pubProp.sName to aDynamicObjects[iObjectIndex].aProps[iPropIndex].sN
37075>>>>>>>                    Move (String(vPropValue)) to aDynamicObjects[iObjectIndex].aProps[iPropIndex].sV
37076>>>>>>>                End
37076>>>>>>>>
37076>>>>>>>                Else Begin
37077>>>>>>>                    // Add new property                   
37077>>>>>>>                    Move (BinarySearchInsertPos()) to iIndex
37078>>>>>>>                    
37078>>>>>>>                    Move pubProp.sName to tCompareProp.sN
37079>>>>>>>                    Move (String(vPropValue)) to tCompareProp.sV
37080>>>>>>>                    Move (InsertInArray(aDynamicObjects[iObjectIndex].aProps, iIndex, tCompareProp)) to aDynamicObjects[iObjectIndex].aProps
37081>>>>>>>                End
37081>>>>>>>>
37081>>>>>>>                
37081>>>>>>>                WebSet paDynamicObjects to aDynamicObjects
37082>>>>>>>            End
37082>>>>>>>>
37082>>>>>>>        End
37082>>>>>>>>
37082>>>>>>>    End_Procedure
37083>>>>>>>    
37083>>>>>>>    
37083>>>>>>>    // Updates the given object with all set dynamic properties
37083>>>>>>>    Procedure ApplyDynamicProps String sDynamicObjectId Handle hoObj
37085>>>>>>>        String sPropName sPropValue sObject
37085>>>>>>>        Integer iObjectIndex icProps iProp iPubPropIndex
37085>>>>>>>        Variant vPropValue
37085>>>>>>>        Handle hmSetter hmGetter
37085>>>>>>>        tWebDynamicObject tDynamicObject
37085>>>>>>>        tWebDynamicObject tDynamicObject
37085>>>>>>>        tWebDynamicObject[] aDynamicObjects
37085>>>>>>>        tWebDynamicObject[] aDynamicObjects
37086>>>>>>>        String[] aParams
37087>>>>>>>        tWebPropMetaData pubProp
37087>>>>>>>        tWebPropMetaData pubProp
37087>>>>>>>        
37087>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
37088>>>>>>>        
37088>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
37089>>>>>>>        
37089>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iObjectIndex
37090>>>>>>>        If (iObjectIndex <> -1) Begin           
37092>>>>>>>            // Apply regular props
37092>>>>>>>            Move (SizeOfArray(aDynamicObjects[iObjectIndex].aProps)) to icProps
37093>>>>>>>            For iProp from 0 to (icProps - 1) 
37099>>>>>>>>
37099>>>>>>>                Move aDynamicObjects[iObjectIndex].aProps[iProp].sN to sPropName
37100>>>>>>>                Move aDynamicObjects[iObjectIndex].aProps[iProp].sV to sPropValue
37101>>>>>>>                
37101>>>>>>>                Get FindWebPropertyMetaByName of hoObj sPropName to pubProp
37102>>>>>>>                Set pubProp.hmSetter of hoObj to sPropValue
37103>>>>>>>            Loop
37104>>>>>>>>
37104>>>>>>>            
37104>>>>>>>            // Apply advanced props
37104>>>>>>>            Move (SizeOfArray(aDynamicObjects[iObjectIndex].aAdvProps)) to icProps
37105>>>>>>>            For iProp from 0 to (icProps - 1)
37111>>>>>>>>
37111>>>>>>>                Move aDynamicObjects[iObjectIndex].aAdvProps[iProp].sP to sPropName
37112>>>>>>>                Get FindWebPropertyMetaByName of hoObj sPropName to pubProp
37113>>>>>>>                
37113>>>>>>>                If (pubProp.hmGetter <= 0) Begin
37115>>>>>>>                    Get Object_Label of hoObj to sObject
37116>>>>>>>                    Error DFERR_PROGRAM (SFormat(C_$WebAppPropertyNotPublished, "WebSet", sPropName, sObject, C_NewLine+C_NewLine))        
37117>>>>>>>>
37117>>>>>>>                    Function_Return
37118>>>>>>>                End
37118>>>>>>>>
37118>>>>>>>                
37118>>>>>>>                // This step is important, as otherwise the system won't know
37118>>>>>>>                // the actual type of the variant.
37118>>>>>>>                Get pubProp.hmGetter of hoObj to vPropValue
37119>>>>>>>                ValueTreeDeserializeParameter aDynamicObjects[iObjectIndex].aAdvProps[iProp].tV to vPropValue
37120>>>>>>>                Set pubprop.hmSetter of hoObj to vPropValue
37121>>>>>>>            Loop
37122>>>>>>>>
37122>>>>>>>        End
37122>>>>>>>>
37122>>>>>>>    End_Procedure   
37123>>>>>>>    
37123>>>>>>>    
37123>>>>>>>    // =========================
37123>>>>>>>    // DYNAMIC OBJECTS RENDERING
37123>>>>>>>    // =========================
37123>>>>>>>   
37123>>>>>>>    // This function either loads all dynamic objects for the first time, 
37123>>>>>>>    // or it performs an incremental update by inserting a new object.
37123>>>>>>>    Procedure Activate
37125>>>>>>>        Boolean bActivated
37125>>>>>>>        Integer iIndex
37125>>>>>>>        String[] aEmptyArray aChildren
37127>>>>>>>        Handle hoQueuedSyncPropsJson hoObjectsJson
37127>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
37127>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
37128>>>>>>>        tWebDynamicObject tDynamicObject
37128>>>>>>>        tWebDynamicObject tDynamicObject
37128>>>>>>>        tWebDynamicObject[] aDynamicObjects
37128>>>>>>>        tWebDynamicObject[] aDynamicObjects
37129>>>>>>>        
37129>>>>>>>        WebGet pbActivated to bActivated
37130>>>>>>>        
37130>>>>>>>        If (not(bActivated)) Begin
37132>>>>>>>            Send ConnectRadioButtons
37133>>>>>>>            
37133>>>>>>>            Get SerializeContainer to hoObjectsJson 
37134>>>>>>>            WebGet paSyncPropsQueue to aSyncPropsQueue
37135>>>>>>>            
37135>>>>>>>            // Send objects to client
37135>>>>>>>            Get Create (RefClass(cJsonObject)) to hoQueuedSyncPropsJson
37136>>>>>>>            Send DataTypeToJson of hoQueuedSyncPropsJson aSyncPropsQueue 
37137>>>>>>>
37137>>>>>>>            Send ClientActionEx "loadQueuedSyncProps" aEmptyArray hoQueuedSyncPropsJson
37138>>>>>>>            Send ClientActionEx "loadDynamicObjects" aEmptyArray hoObjectsJson
37139>>>>>>>            
37139>>>>>>>            Send Destroy of hoQueuedSyncPropsJson
37140>>>>>>>            Send Destroy of hoObjectsJson
37141>>>>>>>              
37141>>>>>>>            // Finish rendering
37141>>>>>>>            WebGet paDynamicObjects to aDynamicObjects
37142>>>>>>>            Move "" to tDynamicObject.sId
37143>>>>>>>            
37143>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
37144>>>>>>>            If (iIndex <> -1) Begin
37146>>>>>>>                Move aDynamicObjects[iIndex].aChildren to aChildren
37147>>>>>>>                Send FinishRendering aChildren
37148>>>>>>>            End
37148>>>>>>>>
37148>>>>>>>        End
37148>>>>>>>>
37148>>>>>>>    End_Procedure
37149>>>>>>>    
37149>>>>>>>    
37149>>>>>>>    // Checks if the given object is currently rendered.
37149>>>>>>>    Function IsRendered String sDynamicObjectId Returns Boolean
37151>>>>>>>        Integer iObjectIndex
37151>>>>>>>        Boolean bReturn
37151>>>>>>>        tWebDynamicObject tDynamicObject
37151>>>>>>>        tWebDynamicObject tDynamicObject
37151>>>>>>>        tWebDynamicObject[]  aDynamicObjects
37151>>>>>>>        tWebDynamicObject[]  aDynamicObjects
37152>>>>>>>        
37152>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
37153>>>>>>>        
37153>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
37154>>>>>>>        
37154>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iObjectIndex
37155>>>>>>>        If (iObjectIndex <> -1) Begin
37157>>>>>>>            Move aDynamicObjects[iObjectIndex].bRendered to bReturn
37158>>>>>>>        End
37158>>>>>>>>
37158>>>>>>>        
37158>>>>>>>        Function_Return bReturn
37159>>>>>>>    End_Function
37160>>>>>>>    
37160>>>>>>>    
37160>>>>>>>    // Marks the given dynamic object as rendered client-side.
37160>>>>>>>    Procedure SetRendered String sDynamicObjectId Boolean bRendered tWebDynamicObject[] ByRef aDynamicObjects Boolean bChildren 
37162>>>>>>>        Integer iObjectIndex iChild icChildren
37162>>>>>>>        tWebDynamicObject tDynamicObject
37162>>>>>>>        tWebDynamicObject tDynamicObject
37162>>>>>>>        
37162>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
37163>>>>>>>        
37163>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iObjectIndex
37164>>>>>>>        If (iObjectIndex <> -1) Begin
37166>>>>>>>            Move bRendered to aDynamicObjects[iObjectIndex].bRendered
37167>>>>>>>        End
37167>>>>>>>>
37167>>>>>>>        
37167>>>>>>>        If (bChildren) Begin
37169>>>>>>>            Move (SizeOfArray(aDynamicObjects[iObjectIndex].aChildren)) to icChildren
37170>>>>>>>            For iChild from 0 to (icChildren - 1)
37176>>>>>>>>
37176>>>>>>>                Send SetRendered aDynamicObjects[iObjectIndex].aChildren[iChild] bRendered (&aDynamicObjects) bChildren
37177>>>>>>>            Loop
37178>>>>>>>>
37178>>>>>>>        End
37178>>>>>>>>
37178>>>>>>>    End_Procedure
37179>>>>>>>    
37179>>>>>>>    
37179>>>>>>>    // Serializes the container to a tWebValueTree.
37179>>>>>>>    Function SerializeContainer Returns Handle
37181>>>>>>>        Integer iIndex icObjects iObject icBuffers iBuffer iSize
37181>>>>>>>        String sDynamicObjectId
37181>>>>>>>        Handle hoObj
37181>>>>>>>        tWebDynamicObject tDynamicObject
37181>>>>>>>        tWebDynamicObject tDynamicObject
37181>>>>>>>        tWebDynamicObject[] aDynamicObjects
37181>>>>>>>        tWebDynamicObject[] aDynamicObjects
37182>>>>>>>        String[] aObjectList
37183>>>>>>>        
37183>>>>>>>        Handle[] aClasses
37184>>>>>>>        Handle hjWrapper hjClasses hjObjects hjObjectDef
37184>>>>>>>        
37184>>>>>>>        
37184>>>>>>>        Get Create (RefClass(cJsonObject)) to hjWrapper
37185>>>>>>>        Get Create (RefClass(cJsonObject)) to hjClasses
37186>>>>>>>        Get Create (RefClass(cJsonObject)) to hjObjects
37187>>>>>>>        Send InitializeJsonType of hjWrapper jsonTypeObject
37188>>>>>>>        Send InitializeJsonType of hjClasses jsonTypeArray
37189>>>>>>>        Send InitializeJsonType of hjObjects jsonTypeArray
37190>>>>>>>        
37190>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
37191>>>>>>>        
37191>>>>>>>        Move "" to tDynamicObject.sId
37192>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
37193>>>>>>>        If (iIndex <> -1) Begin
37195>>>>>>>            Move aDynamicObjects[iIndex].aChildren to aObjectList
37196>>>>>>>            
37196>>>>>>>            Move (SizeOfArray(aObjectList)) to icObjects
37197>>>>>>>            For iObject from 0 to (icObjects - 1)
37203>>>>>>>>
37203>>>>>>>                Get DynamicObject aObjectList[iObject] to hoObj
37204>>>>>>>                Get DoSerializeObject of hoObj hjClasses (&aClasses) to hjObjectDef 
37205>>>>>>>                Send AddMember of hjObjects hjObjectDef
37206>>>>>>>                Send Destroy of hjObjectDef
37207>>>>>>>            Loop
37208>>>>>>>>
37208>>>>>>>        End
37208>>>>>>>>
37208>>>>>>>        
37208>>>>>>>        Send SetMember of hjWrapper "aClasses" hjClasses
37209>>>>>>>        Send SetMember of hjWrapper "aObjects" hjObjects
37210>>>>>>>        Send Destroy of hjClasses
37211>>>>>>>        Send Destroy of hjObjects
37212>>>>>>>        
37212>>>>>>>        Function_Return hjWrapper
37213>>>>>>>    End_Function
37214>>>>>>>    
37214>>>>>>>    
37214>>>>>>>    // Serializes the given dynamic object.
37214>>>>>>>    Function SerializeDynamicObject Handle hoObj tWebDynamicObject[] aDynamicObjects Returns Handle
37216>>>>>>>        Handle hjObjectDef
37216>>>>>>>        
37216>>>>>>>        Get SerializeObject of hoObj to hjObjectDef
37217>>>>>>>
37217>>>>>>>        Function_Return hjObjectDef
37218>>>>>>>    End_Function
37219>>>>>>>    
37219>>>>>>>    
37219>>>>>>>    // =============
37219>>>>>>>    // RADIO BUTTONS
37219>>>>>>>    // =============
37219>>>>>>>    
37219>>>>>>>    // Radio buttons require some additional logic to work properly.
37219>>>>>>>    
37219>>>>>>>    Procedure AddRadio Handle hoRadio
37221>>>>>>>        // We just want to interrupt the delegation of this procedure here. The actual
37221>>>>>>>        // registration of the radio object happens in cWebDynamicObjectContainer:CreateLocal(1).
37221>>>>>>>        Procedure_Return
37222>>>>>>>    End_Procedure  
37223>>>>>>>    
37223>>>>>>>    
37223>>>>>>>    // Registers the passed cWebRadio object. The object's group is determined and the radio
37223>>>>>>>    // is registered with the rest of the objects in that group. If this is the first radio
37223>>>>>>>    // object in the group then it will become the "master" radio object for that group.
37223>>>>>>>    Procedure RegisterRadio Handle hoRadio
37225>>>>>>>        String sGroupName sName
37225>>>>>>>        Integer iGroup icGroup icRadio iSize iIndex
37225>>>>>>>        String[] aRadioGroupNames
37226>>>>>>>        String[] aRegisteredRadios
37227>>>>>>>        String[] aConnectQueue
37228>>>>>>>        tWebDynamicRadioGroup[] aRadioGroups
37228>>>>>>>        tWebDynamicRadioGroup[] aRadioGroups
37229>>>>>>>        
37229>>>>>>>        Get psDynamicObjectId of hoRadio to sName
37230>>>>>>>        
37230>>>>>>>        Get psGroupName of hoRadio to sGroupName
37231>>>>>>>        WebGet paRadioGroups to aRadioGroups
37232>>>>>>>        WebGet paRadioGroupNames to aRadioGroupNames
37233>>>>>>>        
37233>>>>>>>        // Is this a new group?....
37233>>>>>>>        Move (SearchArray(sGroupName, aRadioGroupNames, Desktop, RefFunc(DFSTRICMP))) to iGroup   // case insensitive search
37234>>>>>>>        
37234>>>>>>>        If (iGroup = -1) Begin
37236>>>>>>>            // Create a new group and make this radio button the master....
37236>>>>>>>            Move (SizeOfArray(aRadioGroups)) to icGroup
37237>>>>>>>
37237>>>>>>>            Move sName      to aRadioGroups[icGroup].sMaster
37238>>>>>>>            Move sName      to aRadioGroups[icGroup].aRadioButtons[0]
37239>>>>>>>            Move sGroupName to aRadioGroups[icGroup].sGroupName
37240>>>>>>>            Move sGroupName to aRadioGroupNames[icGroup]
37241>>>>>>>            
37241>>>>>>>            // Save the changes....
37241>>>>>>>            WebSet paRadioGroups to aRadioGroups
37242>>>>>>>            WebSet paRadioGroupNames to aRadioGroupNames
37243>>>>>>>        End
37243>>>>>>>>
37243>>>>>>>        Else Begin
37244>>>>>>>            Move (SearchArray(sName, aRadioGroups[iGroup].aRadioButtons, Desktop, RefFunc(DFSTRICMP))) to iIndex
37245>>>>>>>            
37245>>>>>>>            If (iIndex <> -1) ;                Procedure_Return
37248>>>>>>>            
37248>>>>>>>            // Add this radio to the existing group....
37248>>>>>>>            Move sName to aRadioGroups[iGroup].aRadioButtons[-1]
37249>>>>>>>            
37249>>>>>>>            // Save the changes....
37249>>>>>>>            WebSet paRadioGroups to aRadioGroups
37250>>>>>>>            
37250>>>>>>>            // Save current group name
37250>>>>>>>            Move aRadioGroupNames[iGroup] to sGroupName
37251>>>>>>>        End 
37251>>>>>>>>
37251>>>>>>>        
37251>>>>>>>        // Add the group name to the list of groups that are to be connected
37251>>>>>>>        WebGet paRadioConnectQueue to aConnectQueue
37252>>>>>>>        Move (SearchArray(sGroupName, aConnectQueue)) to iIndex
37253>>>>>>>        If (iIndex = -1) Begin
37255>>>>>>>            Move sGroupName to aConnectQueue[-1]
37256>>>>>>>            WebSet paRadioConnectQueue to aConnectQueue
37257>>>>>>>        End
37257>>>>>>>>
37257>>>>>>>    End_Procedure
37258>>>>>>>    
37258>>>>>>>    
37258>>>>>>>    Procedure ConnectRadioButtons
37260>>>>>>>        // Radio button Helper:
37260>>>>>>>        //
37260>>>>>>>        // Iterate all of the registered radio groups and connect the cWebRadio objects to their master
37260>>>>>>>        // radio buttons.
37260>>>>>>>        String sValue sTemp sMaster sRadio sMasterFullName
37260>>>>>>>        String[] aConnectQueue aRadioGroupNames
37262>>>>>>>        Handle hoRadio hoMaster
37262>>>>>>>        Integer iGroup icGroup iQueuedGroup

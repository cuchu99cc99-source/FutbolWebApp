26620>>>>>>>>>//        
26620>>>>>>>>>//        is_file_included iTable 1 to bIncluded // see if main file is in find done array
26620>>>>>>>>>//        If bIncluded Begin
26620>>>>>>>>>//            Function_Return ddrtsFound
26620>>>>>>>>>//        End
26620>>>>>>>>>//        is_file_included iTable 0 to bIncluded // see if main file is in clear done array
26620>>>>>>>>>//        If bIncluded Begin
26620>>>>>>>>>//            Function_Return ddrtsCleared            
26620>>>>>>>>>//        End
26620>>>>>>>>>//        Function_Return ddrtsNone
26620>>>>>>>>>//    End_Function
26620>>>>>>>>>
26620>>>>>>>>>
26620>>>>>>>>>    // Sent by DDOs to all DEOs whenever a DDO file/field value is changed.
26620>>>>>>>>>    // Do nothing: This message is handled by each cWebColumn object.
26620>>>>>>>>>    Procedure File_Field_Value_Changed Integer iFile Integer iField String sValue Integer iChangeDisabled
26622>>>>>>>>>        // Do nothing!
26622>>>>>>>>>    End_Procedure
26623>>>>>>>>>    
26623>>>>>>>>>    
26623>>>>>>>>>    // Returns the column object handle of the passed column ID
26623>>>>>>>>>    Function GetColumnObject Integer iColumnID Returns Handle
26625>>>>>>>>>        Handle[] hoColumnObjects
26626>>>>>>>>>        
26626>>>>>>>>>        Get phoColumnObjects to hoColumnObjects
26627>>>>>>>>>        Function_Return hoColumnObjects[iColumnID]
26628>>>>>>>>>    End_Function
26629>>>>>>>>>
26629>>>>>>>>>
26629>>>>>>>>>    // Send this message to fire an action on the client telling it to refresh the grid.
26629>>>>>>>>>    Procedure GridRefresh
26631>>>>>>>>>        Boolean bFirst bLast
26631>>>>>>>>>        tWebListData listData
26631>>>>>>>>>        tWebListData listData
26631>>>>>>>>>        String[] asParams
26632>>>>>>>>>        Handle hoJsonData
26632>>>>>>>>>                
26632>>>>>>>>>        //  We cancel previous gridRefresh client actions that might be queued before
26632>>>>>>>>>        Send CancelClientAction "gridRefresh"
26633>>>>>>>>>        
26633>>>>>>>>>        // Forward call to the load data
26633>>>>>>>>>        Get LoadData "page" "" (&bFirst) (&bLast) to listData
26634>>>>>>>>>        WebSet pbUnOrdered to False
26635>>>>>>>>>        
26635>>>>>>>>>        //  Convert data to JSON
26635>>>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJsonData
26636>>>>>>>>>        Send DataTypeToJson of hoJsonData listData
26637>>>>>>>>>
26637>>>>>>>>>        //  Call client action with new data page
26637>>>>>>>>>        Move bFirst         to asParams[0]
26638>>>>>>>>>        Move bLast          to asParams[1]
26639>>>>>>>>>        Send ClientActionEx "gridRefresh" asParams hoJsonData
26640>>>>>>>>>        
26640>>>>>>>>>        Send Destroy of hoJsonData
26641>>>>>>>>>    End_Procedure
26642>>>>>>>>>
26642>>>>>>>>>    
26642>>>>>>>>>    // Does a empty grid refresh
26642>>>>>>>>>    Procedure EmptyGridRefresh
26644>>>>>>>>>        String[] asParams
26645>>>>>>>>>        tWebListData listData
26645>>>>>>>>>        tWebListData listData
26645>>>>>>>>>        
26645>>>>>>>>>        //  We cancel previous gridRefresh client actions that might be queued before
26645>>>>>>>>>        Send CancelClientAction "gridRefresh"
26646>>>>>>>>>        
26646>>>>>>>>>        //  Call client action with empty data set
26646>>>>>>>>>        Move True to asParams[0]
26647>>>>>>>>>        Move True to asParams[1]
26648>>>>>>>>>        Send ClientAction "gridRefresh" asParams listData
26649>>>>>>>>>    End_Procedure
26650>>>>>>>>>    
26650>>>>>>>>>    
26650>>>>>>>>>    // This message is sent by the client to load a page of data. Usually caused by the user 
26650>>>>>>>>>    // scrolling to the end of the virtual list.
26650>>>>>>>>>    Procedure LoadDataPage String sType String sStartRowID
26652>>>>>>>>>        Boolean bFirst bLast
26652>>>>>>>>>        tWebListData listData
26652>>>>>>>>>        tWebListData listData
26652>>>>>>>>>        Handle hoJsonData
26652>>>>>>>>>        String[] asParams
26653>>>>>>>>>        
26653>>>>>>>>>        //  Forward call to the load data
26653>>>>>>>>>        Get LoadData sType sStartRowID (&bFirst) (&bLast) to listData
26654>>>>>>>>>        
26654>>>>>>>>>        //  Convert data to JSON
26654>>>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJsonData
26655>>>>>>>>>        Send DataTypeToJson of hoJsonData listData
26656>>>>>>>>>        
26656>>>>>>>>>        //  Call client action with new data page
26656>>>>>>>>>        Move sType          to asParams[0]
26657>>>>>>>>>        Move sStartRowId    to asParams[1]
26658>>>>>>>>>        Move bFirst         to asParams[2]
26659>>>>>>>>>        Move bLast          to asParams[3]
26660>>>>>>>>>        Send ClientActionEx "handleDataPage" asParams hoJsonData
26661>>>>>>>>>        
26661>>>>>>>>>        Send Destroy of hoJsonData
26662>>>>>>>>>    End_Procedure
26663>>>>>>>>>    
26663>>>>>>>>>    // OnManualLoadData is False - DDO LoadData
26663>>>>>>>>>    // Returns a set of data to be passed back to the client side grid.
26663>>>>>>>>>    // sType - is the type of data to be loaded. Options are: 
26663>>>>>>>>>    //         "page": returns a set of records around (above and below) the current row
26663>>>>>>>>>    //         "first": loads the first page of data
26663>>>>>>>>>    //         "last": loads the last page of data
26663>>>>>>>>>    //         "next": loads the next page of data relative to the passed sStartRowID
26663>>>>>>>>>    //         "prev": loads the previous page of data relative to the passed sStartRowID
26663>>>>>>>>>    //         Note that these values are case sensitive.
26663>>>>>>>>>    // sStartRowID - Is the server table's RowID to begin from when loading "next" or "prev" pages.
26663>>>>>>>>>    // bFirst - [out] True if the returned data is the first page in the total data set.
26663>>>>>>>>>    // bLast - [out] true if the returned data is the last page in the total data set.
26663>>>>>>>>>    //
26663>>>>>>>>>    // OnManualLoadData is True - Manual Load Data
26663>>>>>>>>>    // Populates list via OnManualLoadData and sets bFirst & bLast to True
26663>>>>>>>>>    //
26663>>>>>>>>>    // Returns - the requested page of data.
26663>>>>>>>>>    Function LoadData String sType String sStartRowID Boolean ByRef bFirst Boolean ByRef bLast Returns tWebListData
26665>>>>>>>>>        tWebListData listData
26665>>>>>>>>>        tWebListData listData
26665>>>>>>>>>        Handle hoDD
26665>>>>>>>>>        Integer iMainFile iPageSize iHalfPageSize iOrdering
26665>>>>>>>>>        Integer iRow iCol icColumn iFile iField iLimit
26665>>>>>>>>>        RowID riRowID
26665>>>>>>>>>        String sValue sRowID
26665>>>>>>>>>        Boolean bUsePageSize bReverseOrdering bDataAware bLastFound bScrollable
26665>>>>>>>>>        Integer eDBGridType
26665>>>>>>>>>        Variant vFilterState
26665>>>>>>>>>
26665>>>>>>>>>        // Test if OnManualLoadData has been agumented. If this event returns True then we
26665>>>>>>>>>        // will use that to populate the grid and the DDO (data-aware) grid loading will be
26665>>>>>>>>>        // skipped.  
26665>>>>>>>>>        Get pbDataAware to bDataAware
26666>>>>>>>>>        Get peDbGridType to eDBGridType
26667>>>>>>>>>        Get pbScroll to bScrollable
26668>>>>>>>>>        
26668>>>>>>>>>        // Data is loaded manually if the data is not-data aware or if
26668>>>>>>>>>        // it is data aware and manual loaded.
26668>>>>>>>>>        If (not(bDataAware) or (eDBGridType=gtManual)) Begin      
26670>>>>>>>>>            WebGet psCurrentRowId to sRowID
26671>>>>>>>>>                
26671>>>>>>>>>            Send OnManualLoadData (&listData.aRows) (&sRowID) (&listData.aGroups) (&listData.aGroupHeaders)
26672>>>>>>>>>        
26672>>>>>>>>>            Move True to bFirst
26673>>>>>>>>>            Move True to bLast
26674>>>>>>>>>            WebSet psCurrentRowId to sRowID
26675>>>>>>>>>            Function_Return listData 
26676>>>>>>>>>        End
26676>>>>>>>>>>
26676>>>>>>>>>        
26676>>>>>>>>>        Get ReadingServer to hoDD
26677>>>>>>>>>        Get IndexOrder to iOrdering
26678>>>>>>>>>        WebGet pbReverseOrdering to bReverseOrdering
26679>>>>>>>>>        WebGet piLimitRows to iLimit
26680>>>>>>>>>
26680>>>>>>>>>        Move False to bFirst
26681>>>>>>>>>        Move False to bLast
26682>>>>>>>>>
26682>>>>>>>>>        If (hoDD) Begin
26684>>>>>>>>>            Send ApplyFilter hoDD (&vFilterState)
26685>>>>>>>>>            Move 0 to iRow
26686>>>>>>>>>            Get piPageSize to iPageSize
26687>>>>>>>>>            Move (eDBGridType=gtAutomatic and bScrollable and (iPageSize > 0)) to bUsePageSize
26688>>>>>>>>>            Get Main_File of hoDD to iMainFile
26689>>>>>>>>>            
26689>>>>>>>>>            WebGet psCurrentRowId to sRowID    // Get the RowID of the current row
26690>>>>>>>>>            Move (DeserializeRowID(sRowID)) to riRowID
26691>>>>>>>>>            If (IsNullRowID(riRowID)) Begin
26693>>>>>>>>>                // if no row id, we don't do anything. We return an empty set of rows
26693>>>>>>>>>                // and indicate that we have all the records we can find
26693>>>>>>>>>                Move True to bFirst
26694>>>>>>>>>                Move True to bLast
26695>>>>>>>>>            End
26695>>>>>>>>>>
26695>>>>>>>>>            Else Begin
26696>>>>>>>>>                // Handle the different request "types"
26696>>>>>>>>>                
26696>>>>>>>>>                // "page" request type (usually initial request) returns records 
26696>>>>>>>>>                // above and below the current row
26696>>>>>>>>>                If (sType = "page") Begin
26698>>>>>>>>>                    
26698>>>>>>>>>                    // Find half a page reading backwards from the current row
26698>>>>>>>>>                    Send ReadByRowId of hoDD iMainFile riRowID     // Read the current row
26699>>>>>>>>>    
26699>>>>>>>>>                    Send EstablishDDFindMode LT hoDD iOrdering bReverseOrdering
26700>>>>>>>>>                    Send Locate_Next to hoDD
26701>>>>>>>>>                    Move Found to bLastFound
26702>>>>>>>>>                    Move (iPageSize / 2) to iHalfPageSize
26703>>>>>>>>>                                        
26703>>>>>>>>>                    While (bLastFound and (not(bUsePageSize) or (iRow < iHalfPageSize)) and (iLimit = 0 or iRow < iLimit))
26707>>>>>>>>>                        If (OnCheckCustomConstrains(Self)) Begin
26709>>>>>>>>>                            Get LoadGridRow to listData.aRows[iRow]
26710>>>>>>>>>                            Increment iRow
26711>>>>>>>>>                        End
26711>>>>>>>>>>
26711>>>>>>>>>                        
26711>>>>>>>>>                        Send Locate_Next to hoDD
26712>>>>>>>>>                        Move Found to bLastFound    //  Store Found value since LoadGridRow triggers user events that might change the Found indicator
26713>>>>>>>>>                    Loop
26714>>>>>>>>>>
26714>>>>>>>>>                    
26714>>>>>>>>>                    Move (not(bLastFound) or (iLimit > 0 and iRow >= iLimit)) to bFirst              // Determine 'bFirst'
26715>>>>>>>>>                    Move (ReverseArray(listData.aRows)) to listData.aRows  // Now reverse the array and add the rows below the current row
26716>>>>>>>>>    
26716>>>>>>>>>                    // load the current record
26716>>>>>>>>>                    Send ReadByRowId of hoDD iMainFile riRowID
26717>>>>>>>>>                    Move Found to bLastFound
26718>>>>>>>>>                    If (OnCheckCustomConstrains(Self)) Begin
26720>>>>>>>>>                        Get LoadGridRow to listData.aRows[iRow]
26721>>>>>>>>>                        Increment iRow
26722>>>>>>>>>                    End
26722>>>>>>>>>>
26722>>>>>>>>>    
26722>>>>>>>>>                    // Find the remaining records
26722>>>>>>>>>                    Send EstablishDDFindMode GT  hoDD iOrdering bReverseOrdering
26723>>>>>>>>>                    While ((not(bUsePageSize) or (iRow < iPageSize)) and (iLimit = 0 or iRow < iLimit))
26727>>>>>>>>>                        Send Locate_Next to hoDD
26728>>>>>>>>>                        Move Found to bLastFound
26729>>>>>>>>>                        If (not(Found)) ;                            Break
26732>>>>>>>>>                        If (OnCheckCustomConstrains(Self)) Begin
26734>>>>>>>>>                            Get LoadGridRow to listData.aRows[iRow]
26735>>>>>>>>>                            Increment iRow
26736>>>>>>>>>                        End
26736>>>>>>>>>>
26736>>>>>>>>>                    Loop
26737>>>>>>>>>>
26737>>>>>>>>>                    
26737>>>>>>>>>                    // Set the bLast flag
26737>>>>>>>>>                    Move (not(bLastFound) or (iLimit > 0 and  iRow >= iLimit)) to bLast      
26738>>>>>>>>>                End
26738>>>>>>>>>>
26738>>>>>>>>>                Else Begin
26739>>>>>>>>>                    Case Begin
26739>>>>>>>>>                        Case (sType = "first")
26741>>>>>>>>>                            //  Load the first record
26741>>>>>>>>>                            // NOTE: Request_Read when called during DEO Refresh (or any other DDO operation) from DDO will screw up the
26741>>>>>>>>>                            // DDO's ability to track the array of DDO's in the DDO structure who need to be listeners to the DDO operation!
26741>>>>>>>>>                            // Therefore make sure that this case never gets called indirectly via a DDO to DEO Refresh
26741>>>>>>>>>                            Get ReadDDFirstRecord hoDD iOrdering bReverseOrdering to riRowID
26742>>>>>>>>>                            Move True to bFirst
26743>>>>>>>>>                            Case Break
26744>>>>>>>>>                        
26744>>>>>>>>>                        Case (sType = "last")
26747>>>>>>>>>                            //  Load the last record
26747>>>>>>>>>                            // NOTE: Request_Read when called during DEO Refresh (or any other DDO operation) from DDO will screw up the
26747>>>>>>>>>                            // DDO's ability to track the array of DDO's in the DDO structure who need to be listeners to the DDO operation!
26747>>>>>>>>>                            // Therefore make sure that this case never gets called indirectly via a DDO to DEO Refresh
26747>>>>>>>>>                            Get ReadDDLastRecord hoDD iOrdering bReverseOrdering to riRowID
26748>>>>>>>>>                            Move True to bLast
26749>>>>>>>>>                            Case Break
26750>>>>>>>>>                    
26750>>>>>>>>>                        Case (sType = "next")
26753>>>>>>>>>                            //  Load the start record
26753>>>>>>>>>                            Move (DeserializeRowID(sStartRowId)) to riRowID
26754>>>>>>>>>                            Send ReadByRowId of hoDD iMainFile riRowID
26755>>>>>>>>>                            Send EstablishDDFindMode GT  hoDD iOrdering bReverseOrdering
26756>>>>>>>>>                            Send Locate_Next of hoDD
26757>>>>>>>>>                            Case Break
26758>>>>>>>>>                    
26758>>>>>>>>>                        Case (sType = "prev")
26761>>>>>>>>>                            //  Load the start record
26761>>>>>>>>>                            Move (DeserializeRowID(sStartRowId)) to riRowID
26762>>>>>>>>>                            Send ReadByRowId of hoDD iMainFile riRowID
26763>>>>>>>>>                            Send EstablishDDFindMode LT  hoDD iOrdering bReverseOrdering
26764>>>>>>>>>                            Send Locate_Next of hoDD
26765>>>>>>>>>                    Case End
26765>>>>>>>>>                    Move Found to bLastFound
26766>>>>>>>>>                    
26766>>>>>>>>>                    //  Find remaining records
26766>>>>>>>>>                    While (Found and (not(bUsePageSize) or (iRow < iPageSize)) and (iLimit = 0 or iRow < iLimit))
26770>>>>>>>>>                        If (OnCheckCustomConstrains(Self)) Begin
26772>>>>>>>>>                            Get LoadGridRow to listData.aRows[iRow]
26773>>>>>>>>>                            Increment iRow
26774>>>>>>>>>                        End
26774>>>>>>>>>>
26774>>>>>>>>>                        Send Locate_Next to hoDD
26775>>>>>>>>>                        Move Found to bLastFound
26776>>>>>>>>>                    Loop
26777>>>>>>>>>>
26777>>>>>>>>>                
26777>>>>>>>>>                    // Set the bLast and bFirst flags
26777>>>>>>>>>                    If (not(bLastFound) or (iLimit > 0 and  iRow >= iLimit)) Begin
26779>>>>>>>>>                        If (sType = "next" or sType = "first") Begin
26781>>>>>>>>>                            Move True to bLast
26782>>>>>>>>>                        End
26782>>>>>>>>>>
26782>>>>>>>>>                        Else Begin
26783>>>>>>>>>                            Move True to bFirst
26784>>>>>>>>>                        End
26784>>>>>>>>>>
26784>>>>>>>>>                    End            
26784>>>>>>>>>>
26784>>>>>>>>>                End
26784>>>>>>>>>>
26784>>>>>>>>>            End
26784>>>>>>>>>>
26784>>>>>>>>>
26784>>>>>>>>>            Send DisregardFilter vFilterState
26785>>>>>>>>>        End
26785>>>>>>>>>>
26785>>>>>>>>>        Else Begin
26786>>>>>>>>>            //  Stop the list from trying to find records while there is no DD
26786>>>>>>>>>            Move True to bLast
26787>>>>>>>>>            Move True to bFirst
26788>>>>>>>>>        End
26788>>>>>>>>>>
26788>>>>>>>>>
26788>>>>>>>>>        Function_Return listData
26789>>>>>>>>>    End_Function
26790>>>>>>>>>    
26790>>>>>>>>>    
26790>>>>>>>>>    // Sent by LoadData. User hook to manually populate the grid. To use this create some loop where each
26790>>>>>>>>>    // iteration populates one row of the grid.
26790>>>>>>>>>    // aTheRows      - [out] Array of tWebRow members to be populated. This is the grid data. 
26790>>>>>>>>>    //                 The aValues member should contain one array member for each column, starting with
26790>>>>>>>>>    //                 array member 1 for column one. aValues[0] should be populated with a unique RowID.
26790>>>>>>>>>    // sCurrentRowID - [out] Set this to the unique rowID of the row you wish to become the currently 
26790>>>>>>>>>    //                 selected row after the grid data is sent to the client.
26790>>>>>>>>>    Procedure OnManualLoadData tWebRow[] ByRef aTheRows String ByRef sCurrentRowID tWebGroupConfig[] ByRef aTheGroups tWebGroupHeader[] ByRef aTheGroupHeaders
26792>>>>>>>>>        
26792>>>>>>>>>    End_Procedure
26793>>>>>>>>>
26793>>>>>>>>>    
26793>>>>>>>>>    // Populates a single row of data.
26793>>>>>>>>>    // This is sent by LoadData when loading data from DDO server.
26793>>>>>>>>>    // It assumes that the global record buffers contain the grid row data that we want to display
26793>>>>>>>>>    // in the returned tWebGridRow.s
26793>>>>>>>>>
26793>>>>>>>>>    Function LoadGridRow Returns tWebRow
26795>>>>>>>>>        Boolean bDataAware
26795>>>>>>>>>        RowID riRowID
26795>>>>>>>>>        Integer iFile iField iCol icColumn eDataType iMainFile
26795>>>>>>>>>        String sValue
26795>>>>>>>>>        Handle hoDD
26795>>>>>>>>>        Handle[] aColumns
26796>>>>>>>>>        tWebRow tRow
26796>>>>>>>>>        tWebRow tRow
26796>>>>>>>>>        
26796>>>>>>>>>        Get pbDataAware to bDataAware
26797>>>>>>>>>        Get Server to hoDD
26798>>>>>>>>>        
26798>>>>>>>>>        Get phoColumnObjects to aColumns
26799>>>>>>>>>        Move (SizeOfArray(aColumns)) to icColumn
26800>>>>>>>>>        Move (ResizeArray(tRow.aCells, icColumn)) to tRow.aCells
26801>>>>>>>>>        Move -1 to tRow.iGroupHeaderIndex
26802>>>>>>>>>        
26802>>>>>>>>>        If (bDataAware) Begin
26804>>>>>>>>>            Get Main_File of hoDD to iMainFile
26805>>>>>>>>>            
26805>>>>>>>>>            Move (GetRowID(iMainFile)) to riRowID
26806>>>>>>>>>            Move (SerializeRowID(riRowID)) to tRow.sRowID
26807>>>>>>>>>            
26807>>>>>>>>>            // Iterate the grid columns
26807>>>>>>>>>            For iCol from 0 to (icColumn-1)
26813>>>>>>>>>>
26813>>>>>>>>>                Send LoadGridCell of aColumns[iCol] (&tRow.aCells[iCol])
26814>>>>>>>>>            Loop
26815>>>>>>>>>>
26815>>>>>>>>>        End
26815>>>>>>>>>>
26815>>>>>>>>>        Else Begin
26816>>>>>>>>>            WebGet psCurrentRowId to tRow.sRowID
26817>>>>>>>>>            
26817>>>>>>>>>            //  Determine if a value was changed
26817>>>>>>>>>            For iCol from 0 to (icColumn-1)
26823>>>>>>>>>>
26823>>>>>>>>>                Send LoadGridCell of aColumns[iCol] (&tRow.aCells[iCol])
26824>>>>>>>>>            Loop
26825>>>>>>>>>>
26825>>>>>>>>>        End
26825>>>>>>>>>>
26825>>>>>>>>>        
26825>>>>>>>>>        Send OnDefineRowCssClass (&tRow.sCssClassName)
26826>>>>>>>>>        
26826>>>>>>>>>        Function_Return tRow
26827>>>>>>>>>    End_Function 
26828>>>>>>>>>    
26828>>>>>>>>>    
26828>>>>>>>>>    // Loads the row posted from the action data into the buffer. It gets the row from a the 
26828>>>>>>>>>    // paActionData property and updates the psValue from the colums with its values. It also sets 
26828>>>>>>>>>    // the psCurrentRowId to the new row.
26828>>>>>>>>>    Procedure FillFromActionData
26830>>>>>>>>>        Handle[] aColumns
26831>>>>>>>>>        tWebRow[] aActionData
26831>>>>>>>>>        tWebRow[] aActionData
26832>>>>>>>>>        Handle hoJson
26832>>>>>>>>>        tWebRow tSelectRow
26832>>>>>>>>>        tWebRow tSelectRow
26832>>>>>>>>>        Integer iCol
26832>>>>>>>>>        String sValue
26832>>>>>>>>>        Boolean bCol
26832>>>>>>>>>        
26832>>>>>>>>>        //  Get the row from the action data
26832>>>>>>>>>        Get phoActionJsonData to hoJson
26833>>>>>>>>>        Get JsonToDataType of hoJson to aActionData
26834>>>>>>>>>        
26834>>>>>>>>>        If (SizeOfArray(aActionData) > 0) Begin
26836>>>>>>>>>            Move aActionData[0] to tSelectRow
26837>>>>>>>>>            
26837>>>>>>>>>            //  Update rowid
26837>>>>>>>>>            WebSet psCurrentRowId to tSelectRow.sRowID
26838>>>>>>>>>            
26838>>>>>>>>>            //  Update the DEO's (columns)
26838>>>>>>>>>            Get phoColumnObjects to aColumns
26839>>>>>>>>>            For iCol from 0 to (SizeOfArray(aColumns) - 1)
26845>>>>>>>>>>
26845>>>>>>>>>                Get pbIsWebColumn of aColumns[iCol] to bCol
26846>>>>>>>>>                If (bCol) Begin
26848>>>>>>>>>                    Get ConvertFromTransport of aColumns[iCol] (RefFunc(psValue)) tSelectRow.aCells[iCol].sValue cArgStr to sValue
26849>>>>>>>>>                    WebSet psValue of aColumns[iCol] to sValue
26850>>>>>>>>>                    
26850>>>>>>>>>                    WebSet pbChanged of aColumns[iCol] to False
26851>>>>>>>>>                End
26851>>>>>>>>>>
26851>>>>>>>>>            Loop
26852>>>>>>>>>>
26852>>>>>>>>>                            
26852>>>>>>>>>        End
26852>>>>>>>>>>
26852>>>>>>>>>        Else Begin
26853>>>>>>>>>            Error DFERR_PROGRAM "Assert: No row data in a action data."
26854>>>>>>>>>>
26854>>>>>>>>>        End
26854>>>>>>>>>>
26854>>>>>>>>>    End_Procedure
26855>>>>>>>>>    
26855>>>>>>>>>    // Sent by ChangeCurrentRow. User hook to perform processing when when the client navigates the
26855>>>>>>>>>    // focus from one row to another.
26855>>>>>>>>>    Procedure OnChangeCurrentRow String sFromRowID String sToRowID
26857>>>>>>>>>        
26857>>>>>>>>>    End_Procedure
26858>>>>>>>>>    
26858>>>>>>>>>    
26858>>>>>>>>>    // Alternative name for piOrdering (depreciated). Used for concistency with VDF Windows classes. See also piOrdering
26858>>>>>>>>>    Procedure Set Ordering Integer iOrdering
26860>>>>>>>>>        Set piOrdering to iOrdering
26861>>>>>>>>>    End_Procedure
26862>>>>>>>>>    
26862>>>>>>>>>    Function Ordering Returns Integer
26864>>>>>>>>>        Integer iOrdering
26864>>>>>>>>>        Get piOrdering to iOrdering
26865>>>>>>>>>        Function_Return iOrdering
26866>>>>>>>>>    End_Function

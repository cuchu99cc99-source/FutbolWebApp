21096>>>>>>>>>    // Client Actions: Sends an error to the client so it can be displayed.
21096>>>>>>>>>    Procedure ShowError Integer iErrNum Integer iErrLine String sErrText String sCaption Boolean bUserError
21098>>>>>>>>>        String[] aParams
21099>>>>>>>>>        
21099>>>>>>>>>        Move iErrNum    to aParams[0]
21100>>>>>>>>>        Move iErrLine   to aParams[1]
21101>>>>>>>>>        Move sErrText   to aParams[2]
21102>>>>>>>>>        Move sCaption   to aParams[3]
21103>>>>>>>>>        Move bUserError to aParams[4]
21104>>>>>>>>>        
21104>>>>>>>>>        Send ClientAction "showError" aParams
21105>>>>>>>>>    End_Procedure    

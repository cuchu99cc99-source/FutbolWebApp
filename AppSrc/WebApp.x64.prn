38973>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
38975>>>>>        Handle hoUserDD
38975>>>>>        Integer iErr
38975>>>>>        Get phoUserDD to hoUserDD
38976>>>>>        
38976>>>>>        //  Find the user
38976>>>>>        Send Clear of hoUserDD
38977>>>>>        Move sLoginName to WebAppUser.LoginName
38978>>>>>        Send Find of hoUserDD EQ Index.1
38979>>>>>        If (Found) Begin
38981>>>>>            Send Clear of hoUserDD
38982>>>>>            Function_Return False
38983>>>>>        End
38983>>>>>>
38983>>>>>        
38983>>>>>        Send Clear of hoUserDD
38984>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
38985>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
38986>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
38988>>>>>            Send Clear of hoUserDD
38989>>>>>            Function_Return False
38990>>>>>        End
38990>>>>>>
38990>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
38991>>>>>        Get Request_Validate of hoUserDD to iErr
38992>>>>>        If (iErr) Begin
38994>>>>>            Send Clear of hoUserDD
38995>>>>>            Function_Return False
38996>>>>>        End
38996>>>>>>
38996>>>>>        
38996>>>>>        Send Request_Save of hoUserDD
38997>>>>>        Function_Return (not(Err))
38998>>>>>    End_Function
38999>>>>>    
38999>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
39001>>>>>        String sSessionKey sUserPassword
39001>>>>>        Handle hoSessionDD hoUserDD
39001>>>>>        Boolean bMatch bUpgrade
39001>>>>>        
39001>>>>>        Get phoSessionDD to hoSessionDD
39002>>>>>        Get phoUserDD to hoUserDD
39003>>>>>        Integer iErr eLoginMode
39003>>>>>        
39003>>>>>        // Refind session record
39003>>>>>        Get psSessionKey to sSessionKey
39004>>>>>        Send Clear of hoSessionDD
39005>>>>>        Move sSessionKey to WebAppSession.SessionKey
39006>>>>>        Send Find of hoSessionDD EQ Index.1
39007>>>>>        
39007>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
39009>>>>>            Get peLoginMode to eLoginMode
39010>>>>>            
39010>>>>>            //  Find the user
39010>>>>>            Move sLoginName to WebAppUser.LoginName
39011>>>>>            Send Find of hoUserDD EQ Index.1
39012>>>>>            
39012>>>>>            // Check username and password
39012>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
39014>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
39015>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
39016>>>>>                
39016>>>>>                If (bMatch) Begin
39018>>>>>                    // Store the login
39018>>>>>                    If (bUpgrade) Begin
39020>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
39021>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
39024>>>>>                    End
39024>>>>>>
39024>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
39025>>>>>                    Get Request_Validate of hoSessionDD to iErr
39026>>>>>                    If (iErr) Begin
39028>>>>>                        // this should not happen. If it does its a programming error
39028>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
39029>>>>>>
39029>>>>>                        Function_Return False
39030>>>>>                    End
39030>>>>>>
39030>>>>>                    
39030>>>>>                    Send Request_Save of hoSessionDD
39031>>>>>                    
39031>>>>>                    // Update session properties
39031>>>>>                    Send UpdateSessionProperties False
39032>>>>>                    Send NotifyChangeRights
39033>>>>>                    Function_Return True
39034>>>>>                End
39034>>>>>>
39034>>>>>                Else Begin
39035>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
39035>>>>>                    Send Clear of hoUserDD
39036>>>>>                End
39036>>>>>>
39036>>>>>            End
39036>>>>>>
39036>>>>>            Else Begin
39037>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
39037>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
39038>>>>>            End
39038>>>>>>
39038>>>>>        End
39038>>>>>>
39038>>>>>        Else Begin
39039>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
39039>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
39040>>>>>        End
39040>>>>>>
39040>>>>>          
39040>>>>>        Function_Return False
39041>>>>>    End_Function

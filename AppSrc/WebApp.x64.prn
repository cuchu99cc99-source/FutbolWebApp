12395>>>>>>>
12395>>>>>>>//          Part 1:  Base Document Logic Specialized For Templates
12395>>>>>>>
12395>>>>>>>//
12395>>>>>>>//  XML Collections
12395>>>>>>>//
12395>>>>>>>//  Collection mixin has common functions to both node lists and named node maps
12395>>>>>>>//
12395>>>>>>>
12395>>>>>>>// This provides functions required of all XMLDOM objects.
12395>>>>>>>//
12395>>>>>>>Class cXMLDOMMixin is a Mixin
12396>>>>>>>    
12396>>>>>>>    // Create an XML object of passed class Id and bind passed interface. returns
12396>>>>>>>    // the object handle. All dynamic XML object can be created using this syntax
12396>>>>>>>    
12396>>>>>>>    Function CreateXMLObject Integer iClassId Handle hinfXMLInterface Returns Handle
12398>>>>>>>        Handle hoId hoDocument
12398>>>>>>>        // We will always create objects at the DOMDocument level.
12398>>>>>>>        Get DocumentObject to hoDocument
12399>>>>>>>        If (hoDocument=0) Begin  // this should never happen.
12401>>>>>>>            Error DFERR_XML_INTERNAL_ERROR C_$XmlFailedNoDocObject
12402>>>>>>>>
12402>>>>>>>            Function_Return 0
12403>>>>>>>        End
12403>>>>>>>>
12403>>>>>>>        If hinfXMLInterface Begin
12405>>>>>>>            Get Create of hoDocument iClassId to hoID
12406>>>>>>>            Set XMLInterface of hoID to hinfXMLInterface
12407>>>>>>>        End
12407>>>>>>>>
12407>>>>>>>        Function_Return hoID
12408>>>>>>>    End_Function
12409>>>>>>>    
12409>>>>>>>    // create an XML Node object based on the interface type.
12409>>>>>>>    // this will convert the interface to the proper type and will create
12409>>>>>>>    // an appropriate DF object.
12409>>>>>>>    // This requires that a DocumentObject exists
12409>>>>>>>    
12409>>>>>>>    Function CreateXMLNode Handle hinfc Returns Handle
12411>>>>>>>        Integer iType iClassId
12411>>>>>>>        Handle  hoDocument hoNode
12411>>>>>>>        // Get the node type of the infc handle w/o creating a DF object
12411>>>>>>>        Move (invokexml(DF_IXMLDOMNODE, GET_piNodeType, hinfc, 0, 0, 0, 0)) to iType
12412>>>>>>>        Move (invokexml(DF_IXMLDOMNODE, GET_ChangeNodeType, hinfc, iType, 1, 0, 0)) to hInfc
12413>>>>>>>        If (hinfc=0) Begin
12415>>>>>>>            // this should not happen and we would need to know about this.
12415>>>>>>>            Error DFERR_XML_INTERNAL_ERROR (C_$XmlFailedNoDocObject + String(iType))
12416>>>>>>>>
12416>>>>>>>            Function_Return 0
12417>>>>>>>        End
12417>>>>>>>>
12417>>>>>>>        Get DocumentObject to hoDocument
12418>>>>>>>        // you can augment your class IDs in a single place.
12418>>>>>>>        Get NodeClassId of hoDocument iType to iClassId
12419>>>>>>>        Get CreateXMLObject of hoDocument iClassId hinfc to hoNode
12420>>>>>>>        
12420>>>>>>>        Function_Return hoNode
12421>>>>>>>    End_Function
12422>>>>>>>    
12422>>>>>>>    
12422>>>>>>>    // Change object's class. This let's you change the class id of an object
12422>>>>>>>    // on an object by object basis. This would let you create nodes (e.g. elements)
12422>>>>>>>    // that have a custom interface for each node type. Normally, this would be sent
12422>>>>>>>    // after a node has been created using one of the default classes
12422>>>>>>>    Function ChangeNodeClass Handle hoNode Integer iClassID Returns Handle
12424>>>>>>>        Integer iType
12424>>>>>>>        Handle  hinfcNew
12424>>>>>>>        Get piNodeType of hoNode to iType
12425>>>>>>>        Get ChangeNodeType of hoNode iType False to hInfcNew
12426>>>>>>>        Send Destroy to hoNode // destroy object and old infc handle.
12427>>>>>>>        Get CreateXMLObject iClassId hinfcNew to hoNode
12428>>>>>>>        Function_Return hoNode
12429>>>>>>>    End_Function
12430>>>>>>>    
12430>>>>>>>End_Class
12431>>>>>>>
12431>>>>>>>
12431>>>>>>>Class cXMLDOMCollectionMixin is a Mixin
12432>>>>>>>    
12432>>>>>>>    Import_Class_Protocol cXMLDOMMixin
12433>>>>>>>    
12433>>>>>>>    //  Returns number of items in the collection
12433>>>>>>>    //
12433>>>>>>>    Function NodeListLength Returns Integer
12435>>>>>>>        Integer iLength
12435>>>>>>>        Get piLength to iLength
12436>>>>>>>        Function_Return iLength
12437>>>>>>>    End_Function
12438>>>>>>>    
12438>>>>>>>    // Returns an XML node object for pass item
12438>>>>>>>    //
12438>>>>>>>    Function CollectionNode Integer I Returns Handle
12440>>>>>>>        Handle hoNewNode
12440>>>>>>>        Handle infcItem
12440>>>>>>>        Get phItem i to infcItem
12441>>>>>>>        If (infcItem) ;            Get CreateXMLNode infcItem to hoNewNode
12444>>>>>>>        Function_Return hoNewNode
12445>>>>>>>    End_Function
12446>>>>>>>    
12446>>>>>>>    
12446>>>>>>>End_Class
12447>>>>>>>
12447>>>>>>>// Simple declarations of collections.
12447>>>>>>>
12447>>>>>>>Class cXMLDOMNodeList is a BaseXmlDomNodeList
12448>>>>>>>    Import_Class_Protocol cXMLDOMCollectionMixin
12449>>>>>>>End_Class
12450>>>>>>>
12450>>>>>>>Class cXMLDOMNamedNodeMap is a BaseXmlDomNamedNodeMap
12451>>>>>>>    
12451>>>>>>>    Import_Class_Protocol cXMLDOMCollectionMixin
12452>>>>>>>    
12452>>>>>>>    // returns a node attribute that matches passed name, zero if none
12452>>>>>>>    Function NamedNode String sName Returns Handle
12454>>>>>>>        Handle hoNewNode
12454>>>>>>>        Handle infcItem
12454>>>>>>>        Get NamedItem sName to infcItem
12455>>>>>>>        If infcItem ;            Get CreateXMLNode infcItem to hoNewNode
12458>>>>>>>        Function_Return hoNewNode
12459>>>>>>>    End_Function
12460>>>>>>>    
12460>>>>>>>    // Adds or changes a node attribute
12460>>>>>>>    // This should return the passed object Id which is now bound to the attribute. If an error, returns 0
12460>>>>>>>    Function SetNamedNode Handle hoNode Returns Handle
12462>>>>>>>        Handle hinfcNode hinfcItem
12462>>>>>>>        Get XMLInterface of hoNode to hinfcNode // node of passed attribute
12463>>>>>>>        Get SetNamedItem hinfcNode to hinfcItem
12464>>>>>>>        If hinfcItem ;            Set XMLInterface of hoNode to hinfcItem
12467>>>>>>>        Else ;            Move 0 to hoNode // zero indicates error
12469>>>>>>>        Function_Return hoNode
12470>>>>>>>    End_Function
12471>>>>>>>    
12471>>>>>>>    // removes named attribute, Returns handle of removed node or zero if not found.
12471>>>>>>>    // Note that returned object must be disposed of or moved somewhere else.
12471>>>>>>>    Function RemoveNamedNode String sName Returns Handle
12473>>>>>>>        Handle hoNewNode
12473>>>>>>>        Handle infcItem
12473>>>>>>>        Get RemoveNamedItem sName to infcItem
12474>>>>>>>        If infcItem ;            Get CreateXMLNode infcItem to hoNewNode
12477>>>>>>>        Function_Return hoNewNode
12478>>>>>>>    End_Function
12479>>>>>>>    
12479>>>>>>>    Function QualifiedNode String sNameSpace String sBaseName Returns Handle
12481>>>>>>>        Handle hoNewNode
12481>>>>>>>        Handle infcItem
12481>>>>>>>        Get QualifiedItem  sBaseName sNameSpace  to infcItem
12482>>>>>>>        If infcItem ;            Get CreateXMLNode infcItem to hoNewNode
12485>>>>>>>        Function_Return hoNewNode
12486>>>>>>>    End_Function
12487>>>>>>>    
12487>>>>>>>    Function RemoveQualifiedNode String sNameSpace String sBaseName Returns Handle
12489>>>>>>>        Handle hoNewNode
12489>>>>>>>        Handle infcItem
12489>>>>>>>        Get RemoveQualifiedItem sBaseName sNameSpace to infcItem
12490>>>>>>>        If infcItem ;            Get CreateXMLNode infcItem to hoNewNode
12493>>>>>>>        Function_Return hoNewNode
12494>>>>>>>    End_Function
12495>>>>>>>    
12495>>>>>>>End_Class
12496>>>>>>>
12496>>>>>>>
12496>>>>>>>
12496>>>>>>>// Mixin for nodes.
12496>>>>>>>//
12496>>>>>>>//  First the declaration of functions that have no object references.
12496>>>>>>>//
12496>>>>>>>
12496>>>>>>>
12496>>>>>>>Class cXMLDOMNodeMixin is a Mixin
12497>>>>>>>    
12497>>>>>>>    Import_Class_Protocol cXMLDOMMixin
12498>>>>>>>    
12498>>>>>>>    //  Append Node to the end of list. Returns passed Object handle if Ok, 0 if error
12498>>>>>>>    
12498>>>>>>>    Function AppendNode Handle hoNode Returns Handle
12500>>>>>>>        Handle hinfcNode
12500>>>>>>>        Handle infcReturned
12500>>>>>>>        // Get COM Interface to call Append child.
12500>>>>>>>        Get XMLInterface of hoNode to hinfcNode
12501>>>>>>>        If (hinfcNode=0) ;            Function_Return 0
12504>>>>>>>        Get AppendChild hinfcNode to infcReturned
12505>>>>>>>        // Interface returned is stored in DataFlex object.
12505>>>>>>>        If (infcReturned=0) ;            Function_Return 0
12508>>>>>>>        Set XMLInterface of hoNode to infcReturned
12509>>>>>>>        Function_Return hoNode
12510>>>>>>>    End_Function
12511>>>>>>>    
12511>>>>>>>    //  Insert NewNode before Node. Returns passed newnode Object handle if Ok, 0 if error
12511>>>>>>>    
12511>>>>>>>    Function InsertBeforeNode Handle hoNewNode Handle hoNode Returns Handle
12513>>>>>>>        Handle hinfcNewNode hinfcNode hoRefNode infcReturned
12513>>>>>>>        Integer iType
12513>>>>>>>        // DOM says if no refnode argument passed or it is 0, append to end
12513>>>>>>>        If (Num_Arguments=1) ;            Move 0 to hoRefNode
12516>>>>>>>        Else ;            Move hoNode to hoRefNode
12518>>>>>>>        Get XMLInterface of hoNewNode to hinfcNewNode
12519>>>>>>>        If (hinfcNewNode=0) ;            Function_Return 0
12522>>>>>>>        If hoRefNode Begin
12524>>>>>>>            Get XMLInterface of hoRefNode to hinfcNode
12525>>>>>>>            If (hinfcNode=0) ;                Function_Return 0
12528>>>>>>>        End
12528>>>>>>>>
12528>>>>>>>        Get InsertBefore hinfcNewNode hinfcNode to infcReturned
12529>>>>>>>        If (infcReturned=0) ;            Function_Return 0
12532>>>>>>>        // Interface returned is stored in DataFlex object.
12532>>>>>>>        Set XMLInterface of hoNewNode to infcReturned
12533>>>>>>>        Function_Return hoNewNode
12534>>>>>>>    End_Function
12535>>>>>>>    
12535>>>>>>>    //  Remove Node. Returns object Id of removed node, zero if error
12535>>>>>>>    //  Important: The node is not destroyed! This lets you move it elsewhere if you want
12535>>>>>>>    
12535>>>>>>>    Function RemoveNode Handle hoNode Returns Handle
12537>>>>>>>        Handle hInfcNode
12537>>>>>>>        Get XMLInterface of hoNode to hInfcNode
12538>>>>>>>        If (hinfcNode=0) ;            Function_Return 0
12541>>>>>>>        Get RemoveChild hInfcNode to hinfcNode
12542>>>>>>>        If (hinfcNode=0) ;            Function_Return 0
12545>>>>>>>        Set XMLInterface of hoNode to hinfcNode
12546>>>>>>>        Function_Return hoNode
12547>>>>>>>    End_Function
12548>>>>>>>    
12548>>>>>>>    //  Replace Node. Returns object Id of replaced node, zero if error
12548>>>>>>>    //  Important: The replaced node is not destroyed! This lets you move it elsewhere if you want
12548>>>>>>>    
12548>>>>>>>    Function ReplaceNode Handle hoNewNode Handle hoNodeToReplace Returns Handle
12550>>>>>>>        Handle hInfcNewNode hinfcNodetoReplace hinfcNode
12550>>>>>>>        Get XMLInterface of hoNewNode       to hInfcNewNode
12551>>>>>>>        Get XMLInterface of hoNodetoReplace to hInfcNodetoreplace
12552>>>>>>>        If (hinfcNewNode=0 or hInfcNodeToReplace=0) ;            Function_Return 0
12555>>>>>>>        Get ReplaceChild hInfcNewNode hinfcNodeToReplace to hinfcNode
12556>>>>>>>        If (hinfcNode=0) ;            Function_Return 0
12559>>>>>>>        Set XMLInterface of hoNodetoReplace to hinfcNode
12560>>>>>>>        Function_Return hoNodetoReplace
12561>>>>>>>    End_Function
12562>>>>>>>    
12562>>>>>>>    // Remove the named node. Returns handle to removed node. You must destroy
12562>>>>>>>    // or move this removed object as needed
12562>>>>>>>    
12562>>>>>>>    Function RemoveNamedNode String sQueryString Returns Handle
12564>>>>>>>        Handle hoNode
12564>>>>>>>        Handle hInfcTemplate hinfcNode
12564>>>>>>>        Integer iRet
12564>>>>>>>        Get SelectSingleNode sQueryString to hinfcTemplate
12565>>>>>>>        If (hinfcTemplate) Begin
12567>>>>>>>            // Remove child returns an interface to the disassociated node.
12567>>>>>>>            // It should be disposed by setting it to an object and then calling destroy
12567>>>>>>>            Get RemoveChild hInfcTemplate to hInfcNode
12568>>>>>>>            // Even if hInfcTemplate and hInfcNode are the same their reference count will be incremented.
12568>>>>>>>            // Therefore we must destroy one the interfaces which will decrement the reference count thus
12568>>>>>>>            // avoding a memory leak
12568>>>>>>>            Move (invokexml(DF_IXMLDOMNODE, DESTROY_XML_INTERFACE, hInfcTemplate, 0, 0, 0, 0)) to iRet
12569>>>>>>>            If hInfcNode ;                Get CreateXMLNode hinfcNode to hoNode
12572>>>>>>>        End
12572>>>>>>>>
12572>>>>>>>        Function_Return hoNode
12573>>>>>>>    End_Function
12574>>>>>>>    
12574>>>>>>>    // This function creates a clone of the passed Node. if bRecurse all child nodes are also
12574>>>>>>>    // cloned. The object Id of the new clone object is returned.
12574>>>>>>>    // The interface of the object returned can be used in AppendChild to add
12574>>>>>>>    // the node to the XML Document.
12574>>>>>>>    
12574>>>>>>>    Function CloneNode Integer bRecurse Returns Handle
12576>>>>>>>        Handle hoNewNode
12576>>>>>>>        Handle hinfcNewNode
12576>>>>>>>        Get CloneInfcNode (If(bRecurse,-1,0)) to hinfcNewNode
12577>>>>>>>        If hinfcNewNode ;            Get CreateXMLNode hinfcNewNode to hoNewNode
12580>>>>>>>        Function_Return hoNewNode
12581>>>>>>>    End_Function
12582>>>>>>>    
12582>>>>>>>    //  Create a collection of all nodes. returns handle of a cXMLDomNodeList
12582>>>>>>>    
12582>>>>>>>    Function ChildNodes Returns Handle
12584>>>>>>>        Handle infcNodeList
12584>>>>>>>        Handle hoNodeList
12584>>>>>>>        Get phChildNodes to infcNodeList
12585>>>>>>>        If (infcNodeList) ;            Get CreateXMLObject U_cXMLDOMNodeList infcNodeList to hoNodeList
12588>>>>>>>        Function_Return hoNodeList
12589>>>>>>>    End_Function
12590>>>>>>>    
12590>>>>>>>    //  Create a collection of all attributes. returns handle of a cXMLDomNodeMapList
12590>>>>>>>    
12590>>>>>>>    Function AttributeNodes Returns Handle
12592>>>>>>>        Handle hoCollectionId   // Object to hold collection
12592>>>>>>>        Handle hinfcAttributes  // XML Interface for collection
12592>>>>>>>        Get phAttributes to hinfcAttributes
12593>>>>>>>        If (hinfcAttributes) ;            Get CreateXMLObject U_cXMLDOMNamedNodeMap hinfcAttributes to hoCollectionId
12596>>>>>>>        Function_Return hoCollectionId
12597>>>>>>>    End_Function
12598>>>>>>>    
12598>>>>>>>    //  Create a collection of all attributes for the temporary attribute node object.
12598>>>>>>>    //  Using this saves a small amount of time creating and destroying this object but
12598>>>>>>>    //  it must be used with care. This binding is temporary!
12598>>>>>>>    Function TempAttributeNodes Returns Handle
12600>>>>>>>        Handle hoCollectionId hoDocument
12600>>>>>>>        Handle hinfcAttributes  // XML Interface for collection
12600>>>>>>>        Get phAttributes to hinfcAttributes
12601>>>>>>>        If (hinfcAttributes) Begin
12603>>>>>>>            Get DocumentObject to hoDocument
12604>>>>>>>            Get phoTempDomNodeMap of hoDocument to hoCollectionId
12605>>>>>>>            Set XMLInterface of hoCollectionId to hinfcAttributes
12606>>>>>>>        End
12606>>>>>>>>
12606>>>>>>>        Function_Return hoCollectionId
12607>>>>>>>    End_Function
12608>>>>>>>    
12608>>>>>>>    
12608>>>>>>>    // Returns a collection of just elements
12608>>>>>>>    
12608>>>>>>>    Function ElementNodes String sQueryString Returns Handle
12610>>>>>>>        Handle hoNodeList
12610>>>>>>>        Handle hinfcNodeList
12610>>>>>>>        Get ElementsByTagName sQueryString to hinfcNodeList
12611>>>>>>>        If (hinfcNodeList <> 0) ;            Get CreateXMLObject U_cXMLDOMNodeList hinfcNodeList to hoNodeList
12614>>>>>>>        Function_Return hoNodeList
12615>>>>>>>    End_Function
12616>>>>>>>    
12616>>>>>>>    
12616>>>>>>>    
12616>>>>>>>    // Return object handle for query.
12616>>>>>>>    
12616>>>>>>>    Function FindNode String sQueryString Returns Handle
12618>>>>>>>        Handle hoNode
12618>>>>>>>        Handle hinfcNode
12618>>>>>>>        Get SelectSingleNode sQueryString to hinfcNode
12619>>>>>>>        If (hinfcNode <> 0) ;            Get CreateXMLNode hInfcNode to hoNode
12622>>>>>>>        Function_Return hoNode
12623>>>>>>>    End_Function
12624>>>>>>>    
12624>>>>>>>    // Return object handle for a collection node.
12624>>>>>>>    
12624>>>>>>>    
12624>>>>>>>    Function FindNodeList String sQueryString Returns Handle
12626>>>>>>>        Handle hoNodeList
12626>>>>>>>        Handle hinfcNodeList
12626>>>>>>>        Get SelectNodes sQueryString to hinfcNodeList
12627>>>>>>>        If (hinfcNodeList <> 0) ;            Get CreateXMLObject U_cXMLDOMNodeList hinfcNodeList to hoNodeList
12630>>>>>>>        Function_Return hoNodeList
12631>>>>>>>    End_Function
12632>>>>>>>    
12632>>>>>>>    // The CreatexxxxxNode messages creates an node object for the type specified. Both
12632>>>>>>>    // the interface and the object or of the correct type (i.e. element, comment)
12632>>>>>>>    // These all return an object handle which can be used to place the object via
12632>>>>>>>    // appendNode or InsertBeforeNode
12632>>>>>>>    
12632>>>>>>>    // This function creates a child element, returning a dataflex object.
12632>>>>>>>    // The interface of the object returned can be used in AppendChild to add
12632>>>>>>>    // the element to the XML Document.
12632>>>>>>>    
12632>>>>>>>    Function CreateElementNode String sTagName String sValue Returns Handle
12634>>>>>>>        Handle hoNewElement
12634>>>>>>>        Handle hoDocumentObject
12634>>>>>>>        Handle infcNewElement
12634>>>>>>>        Integer iClassId
12634>>>>>>>        // The DataFlex objects are created inside the nodes (elements).
12634>>>>>>>        // Create an element in the document and assign its interface to the new DF object.
12634>>>>>>>        Get DocumentObject to hoDocumentObject
12635>>>>>>>        Get createElement of hoDocumentObject sTagName to infcNewElement
12636>>>>>>>        If infcNewElement Begin // if there was an error, no infc handle would be returned
12638>>>>>>>            Get NodeClassId of hoDocumentObject NODE_ELEMENT to iClassId
12639>>>>>>>            Get CreateXMLObject iClassId infcNewElement to hoNewElement
12640>>>>>>>            If hoNewElement ; // very unlikely this will be zero                Set psText of hoNewElement to sValue
12643>>>>>>>        End
12643>>>>>>>>
12643>>>>>>>        Function_Return hoNewElement
12644>>>>>>>    End_Function
12645>>>>>>>    
12645>>>>>>>    // This function creates an attribute in a document. Attributes are _NOT_ children of an element.
12645>>>>>>>    // A DataFlex object is returned. An attribute can be added to an xml document using
12645>>>>>>>    // get AddAttributeNode.
12645>>>>>>>    
12645>>>>>>>    Function CreateAttributeNode String sName String sValue Returns Handle
12647>>>>>>>        Handle hoNewAttribute
12647>>>>>>>        Handle hoDocumentObject
12647>>>>>>>        Handle infcNewAttribute
12647>>>>>>>        Integer iClassId
12647>>>>>>>        Get DocumentObject to hoDocumentObject
12648>>>>>>>        // Create an Attribute in the document and assign its interface to the new DF object.
12648>>>>>>>        Get createAttribute of hoDocumentObject sName to infcNewAttribute
12649>>>>>>>        If infcNewAttribute Begin // if there was an error, no infc handle would be returned
12651>>>>>>>            Get NodeClassId of hoDocumentObject NODE_ATTRIBUTE to iClassId
12652>>>>>>>            Get CreateXMLObject iClassId infcNewAttribute to hoNewAttribute
12653>>>>>>>            // Set the value of the attribute.
12653>>>>>>>            If hoNewAttribute ; // very unlikely this will be 0                Set psText of hoNewAttribute to sValue
12656>>>>>>>        End
12656>>>>>>>>
12656>>>>>>>        Function_Return hoNewAttribute
12657>>>>>>>    End_Function
12658>>>>>>>    
12658>>>>>>>    // This function creates a child comment, returning a dataflex object.
12658>>>>>>>    // The interface of the object returned can be used in AppendChild to add
12658>>>>>>>    // the comment to the XML Document.
12658>>>>>>>    
12658>>>>>>>    Function CreateChildComment String sValue Returns Handle
12660>>>>>>>        Handle hoNewComment
12660>>>>>>>        Handle hoDocumentObject
12660>>>>>>>        Handle infcNewComment
12660>>>>>>>        Integer iClassID
12660>>>>>>>        Get DocumentObject to hoDocumentObject
12661>>>>>>>        // Create an Comment in the document and assign its interface to the new DF object.
12661>>>>>>>        Get createComment of hoDocumentObject sValue to infcNewComment
12662>>>>>>>        If infcNewComment Begin // if there was an error, no infc handle would be returned
12664>>>>>>>            Get NodeClassId of hoDocumentObject NODE_COMMENT to iClassId
12665>>>>>>>            Get CreateXMLObject iClassId infcNewComment to hoNewComment
12666>>>>>>>            If hoNewComment ; // very unlikely this will be 0                Set psText of hoNewComment to sValue
12669>>>>>>>        End
12669>>>>>>>>
12669>>>>>>>        Function_Return hoNewComment
12670>>>>>>>    End_Function
12671>>>>>>>    
12671>>>>>>>    // This function creates a child processing instruction, returning a dataflex object.
12671>>>>>>>    // The interface of the object returned can be used in AppendChild to add
12671>>>>>>>    // the processing instruction to the XML Document.
12671>>>>>>>    
12671>>>>>>>    Function CreateChildProcessingInstruction String sTarget String sValue Returns Handle
12673>>>>>>>        Handle hoNewProcessingInstruction
12673>>>>>>>        Handle hoDocumentObject
12673>>>>>>>        Handle infcNewProcessingInstruction
12673>>>>>>>        Integer iClassID
12673>>>>>>>        Get DocumentObject to hoDocumentObject
12674>>>>>>>        // Create an ProcessingInstruction in the document and assign its interface to the new DF object.
12674>>>>>>>        Get createProcessingInstruction of hoDocumentObject sTarget sValue to infcNewProcessingInstruction
12675>>>>>>>        If infcNewProcessingInstruction  Begin // if there was an error, no infc handle would be returned
12677>>>>>>>            Get NodeClassId of hoDocumentObject NODE_PROCESSING_INSTRUCTION to iClassId
12678>>>>>>>            Get CreateXMLObject iClassID infcNewProcessingInstruction to hoNewProcessingInstruction
12679>>>>>>>        End
12679>>>>>>>>
12679>>>>>>>        Function_Return hoNewProcessingInstruction
12680>>>>>>>    End_Function
12681>>>>>>>    
12681>>>>>>>    // This function creates a child text node, returning a dataflex object.
12681>>>>>>>    // The interface of the object returned can be used in AppendChild to add
12681>>>>>>>    // the text node to the XML Document.
12681>>>>>>>    
12681>>>>>>>    Function CreateChildTextNode String sValue Returns Handle
12683>>>>>>>        Handle hoNewTextNode
12683>>>>>>>        Handle hoDocumentObject
12683>>>>>>>        Handle infcNewTextNode
12683>>>>>>>        Integer iClassID
12683>>>>>>>        Get DocumentObject to hoDocumentObject
12684>>>>>>>        // Create an TextNode in the document and assign its interface to the new DF object.
12684>>>>>>>        Get createTextNode of hoDocumentObject sValue to infcNewTextNode
12685>>>>>>>        If infcNewTextNode Begin // if there was an error, no infc handle would be returned
12687>>>>>>>            Get NodeClassId of hoDocumentObject NODE_TEXT to iClassId
12688>>>>>>>            Get CreateXMLObject iClassId infcNewTextNode to hoNewTextNode
12689>>>>>>>        End
12689>>>>>>>>
12689>>>>>>>        Function_Return hoNewTextNode
12690>>>>>>>    End_Function
12691>>>>>>>    
12691>>>>>>>    // This function creates a cdata text node, returning a dataflex object.
12691>>>>>>>    // The interface of the object returned can be used in AppendChild to add
12691>>>>>>>    // the cdata node to the XML Document.
12691>>>>>>>    
12691>>>>>>>    Function CreateCDATASectionNode String sValue Returns Handle
12693>>>>>>>        Handle hoNewNode
12693>>>>>>>        Handle hoDocumentObject
12693>>>>>>>        Handle infcNewNode
12693>>>>>>>        Integer iClassId
12693>>>>>>>        // The DataFlex objects are created inside the nodes (elements).
12693>>>>>>>        // Create an element in the document and assign its interface to the new DF object.
12693>>>>>>>        Get DocumentObject to hoDocumentObject
12694>>>>>>>        Get createCDATASection of hoDocumentObject sValue to infcNewNode
12695>>>>>>>        If infcNewNode Begin
12697>>>>>>>            Get NodeClassId of hoDocumentObject NODE_CDATA_SECTION to iClassId
12698>>>>>>>            Get CreateXMLObject iClassId infcNewNode to hoNewNode
12699>>>>>>>        End
12699>>>>>>>>
12699>>>>>>>        Function_Return hoNewNode

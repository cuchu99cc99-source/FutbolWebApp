25105>>>>>>>>>>>>>>>    Procedure FindSuggestions String sFilter Integer iPage Integer iAdditionalItems
25107>>>>>>>>>>>>>>>        tSelectionItem[] aItems
25107>>>>>>>>>>>>>>>        tSelectionItem[] aItems
25108>>>>>>>>>>>>>>>        Handle hoJson hoSelectionSource
25108>>>>>>>>>>>>>>>        Boolean bLast bIsObj bAllData bSuggestions bPaged
25108>>>>>>>>>>>>>>>        tSelectionItem prevItem
25108>>>>>>>>>>>>>>>        tSelectionItem prevItem
25108>>>>>>>>>>>>>>>        String[] aParams
25109>>>>>>>>>>>>>>>        Integer iPageSize
25109>>>>>>>>>>>>>>>            
25109>>>>>>>>>>>>>>>        Get phoSelectionSource to hoSelectionSource
25110>>>>>>>>>>>>>>>        if (hoSelectionSource > 0) Begin
25112>>>>>>>>>>>>>>>            Get pbAllData of hoSelectionSource to bAllData
25113>>>>>>>>>>>>>>>            Get pbSuggestions of hoSelectionSource to bSuggestions
25114>>>>>>>>>>>>>>>            Get pbPaged of hoSelectionSource to bPaged
25115>>>>>>>>>>>>>>>        End
25115>>>>>>>>>>>>>>>>
25115>>>>>>>>>>>>>>>        Else Begin
25116>>>>>>>>>>>>>>>            WebGet pbAllData to bAllData
25117>>>>>>>>>>>>>>>            WebGet pbSuggestions to bSuggestions
25118>>>>>>>>>>>>>>>            WebGet pbPaged to bPaged
25119>>>>>>>>>>>>>>>        End
25119>>>>>>>>>>>>>>>>
25119>>>>>>>>>>>>>>>        WebGet piPageSize to iPageSize
25120>>>>>>>>>>>>>>>        Send ValidateSuggestionMode bAllData bSuggestions bPaged
25121>>>>>>>>>>>>>>>        
25121>>>>>>>>>>>>>>>        If (not(bPaged)) Begin
25123>>>>>>>>>>>>>>>            Move 0 to iPage
25124>>>>>>>>>>>>>>>        End
25124>>>>>>>>>>>>>>>>
25124>>>>>>>>>>>>>>>        If (not(bPaged) and not(bSuggestions)) Begin
25126>>>>>>>>>>>>>>>            Move 0 to iAdditionalItems
25127>>>>>>>>>>>>>>>        End
25127>>>>>>>>>>>>>>>>
25127>>>>>>>>>>>>>>>
25127>>>>>>>>>>>>>>>        // Additional items are required when selected tags are filtered out client-side.
25127>>>>>>>>>>>>>>>        If (bPaged or bSuggestions) ;            Move (iPageSize + iAdditionalItems) to iPageSize
25130>>>>>>>>>>>>>>>        
25130>>>>>>>>>>>>>>>        Get phoActionJsonData to hoJson
25131>>>>>>>>>>>>>>>        If (hoJson > 0) Begin
25133>>>>>>>>>>>>>>>            Get JsonToDataType of hoJson to prevItem
25134>>>>>>>>>>>>>>>        End
25134>>>>>>>>>>>>>>>>
25134>>>>>>>>>>>>>>>        If (not(bPaged)) Begin
25136>>>>>>>>>>>>>>>            Move (ResizeArray(prevItem.aValues, 0)) to prevItem.aValues
25137>>>>>>>>>>>>>>>            Move "" to prevItem.sRowId
25138>>>>>>>>>>>>>>>            Move "" to prevItem.sCssClassName
25139>>>>>>>>>>>>>>>            Move False to prevItem.bServer
25140>>>>>>>>>>>>>>>        End
25140>>>>>>>>>>>>>>>>
25140>>>>>>>>>>>>>>>        
25140>>>>>>>>>>>>>>>        If (hoSelectionSource > 0) Begin
25142>>>>>>>>>>>>>>>            Send FetchItems of hoSelectionSource (&aItems) (&bLast) sFilter prevItem iPageSize iPage
25143>>>>>>>>>>>>>>>            If (pbAllData(hoSelectionSource)) Begin
25145>>>>>>>>>>>>>>>                Move True to bLast
25146>>>>>>>>>>>>>>>            End
25146>>>>>>>>>>>>>>>>
25146>>>>>>>>>>>>>>>        End
25146>>>>>>>>>>>>>>>>
25146>>>>>>>>>>>>>>>        
25146>>>>>>>>>>>>>>>        Send OnFindSuggestions (&aItems) (&bLast) sFilter prevItem iPage
25147>>>>>>>>>>>>>>>        If (bSuggestions) Begin
25149>>>>>>>>>>>>>>>            Move True to bLast
25150>>>>>>>>>>>>>>>        End
25150>>>>>>>>>>>>>>>>
25150>>>>>>>>>>>>>>>        
25150>>>>>>>>>>>>>>>        Send InitializeCustomButtons (&aItems) bLast sFilter
25151>>>>>>>>>>>>>>>        
25151>>>>>>>>>>>>>>>        Move sFilter to aParams[0]
25152>>>>>>>>>>>>>>>        Move (String(bLast)) to aParams[1]
25153>>>>>>>>>>>>>>>        Send ClientAction "suggestHandle" aParams aItems iPage
25154>>>>>>>>>>>>>>>    End_Procedure
25155>>>>>>>>>>>>>>>    
25155>>>>>>>>>>>>>>>    Procedure AddCustomActionButton tSelectionItem[] ByRef aItems String sRowId String sText
25157>>>>>>>>>>>>>>>        tSelectionItem tCustomItem

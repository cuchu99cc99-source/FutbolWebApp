13228>>>>>>>Class cXMLDOMDocument is an BaseXmlDomDocument
13229>>>>>>>    
13229>>>>>>>    Import_Class_Protocol cXMLDOMNodeMixin
13230>>>>>>>    
13230>>>>>>>    Procedure Construct_Object
13232>>>>>>>        Handle hInfc
13232>>>>>>>        Forward Send Construct_Object
13234>>>>>>>        Property String psDocumentName ""
13235>>>>>>>        Property Integer phPrivateDocumentElement 0
13236>>>>>>>        Property Handle phoTempDomNode (Create(Self,U_cXMLDomNode))
13237>>>>>>>        Property Handle phoTempDomNodeMap (Create(Self,U_cXMLDOMNamedNodeMap))
13238>>>>>>>        
13238>>>>>>>        // added in 15.1. If no COM pointer, msxml6 is most likely not installed. This will
13238>>>>>>>        // raise an unhandled error, which could be augmented to do something else.
13238>>>>>>>        Get XmlInterface to hInfc
13239>>>>>>>        If (hInfc=0) Begin
13241>>>>>>>            Send ErrorCreatingXMLObject
13242>>>>>>>        End
13242>>>>>>>>
13242>>>>>>>        
13242>>>>>>>        // as of 18.0 pbAsync now defaults to False. In most cases, this is what you want
13242>>>>>>>        Set pbAsync to False
13243>>>>>>>    End_Procedure
13244>>>>>>>    
13244>>>>>>>    // returns the classId for the passed NodeType. This is a good augmentation point. All nodes
13244>>>>>>>    // within an xml document come here to get a class. So, if you want to augment and return a
13244>>>>>>>    // different class, just check the node type and return whatever -- else forward
13244>>>>>>>    
13244>>>>>>>    Function NodeClassId Integer iType Returns Integer
13246>>>>>>>        Integer iClassId
13246>>>>>>>        Case Begin
13246>>>>>>>            Case (iType=NODE_ELEMENT) ;                Move U_cXMLDOMElement      to iClassId
13249>>>>>>>            Case (iType=NODE_ATTRIBUTE) ;                Move U_cXMLDOMAttribute    to iClassId
13253>>>>>>>            Case (iType=NODE_TEXT) ;                Move U_cXMLDOMTextNode     to iClassId
13257>>>>>>>            Case (iType=NODE_CDATA_SECTION) ;                Move U_cXMLDOMCDATASection to iClassId
13261>>>>>>>            Case (iType=NODE_ENTITY_REFERENCE) ;                Move U_cXMLDOMEntityReference to iClassId
13265>>>>>>>            Case (iType=NODE_ENTITY) ;                Move U_cXMLDOMEntity       to iClassId
13269>>>>>>>            Case (iType=NODE_PROCESSING_INSTRUCTION) ;                Move U_cXMLDOMProcessingInstruction to iClassId
13273>>>>>>>            Case (iType=NODE_COMMENT) ;                Move U_cXMLDOMComment      to iClassId
13277>>>>>>>            Case (iType=NODE_DOCUMENT) ;                Move U_cXMLDOMDocument     to iClassId
13281>>>>>>>            Case (iType=NODE_DOCUMENT_TYPE) ;                Move U_cXMLDOMDocumentType to iClassId
13285>>>>>>>            Case (iType=NODE_DOCUMENT_FRAGMENT) ;                Move U_cXMLDOMDocumentFragment to iClassId
13289>>>>>>>            Case (iType=NODE_NOTATION) ;                Move U_cXMLDOMNotation     to iClassId
13293>>>>>>>            Case (iType=0) ;                Move 0                     to iClassId // this is an error!!
13297>>>>>>>            Case Else ;                Move U_cXMLDOMNode         to iClassId
13299>>>>>>>        Case End
13299>>>>>>>        Function_Return iClassId
13300>>>>>>>    End_Function
13301>>>>>>>    
13301>>>>>>>    // Load an XML Document. The name of the document is stored in a property
13301>>>>>>>    // that must be set for this function to work correctly.
13301>>>>>>>    
13301>>>>>>>    Function LoadXMLDocument Returns Integer
13303>>>>>>>        String sDocumentName
13303>>>>>>>        Integer bRetVal
13303>>>>>>>        Get psDocumentName to sDocumentName
13304>>>>>>>        Get LoadDocument sDocumentName to bRetVal

27685>>>>>>>// Models a data entry view panel. This is a container for...
27685>>>>>>>// - A DDO structure
27685>>>>>>>// - Panel layout
27685>>>>>>>// - Child DEO and non-DEO controls.
27685>>>>>>>//
27685>>>>>>>// Adds support for...
27685>>>>>>>// - DDO Container,
27685>>>>>>>// - DDO request interface
27685>>>>>>>Class cWebView is a cWebWindow
27686>>>>>>>    
27686>>>>>>>    Procedure Construct_Object
27688>>>>>>>        Integer eStyle 
27688>>>>>>>        String sName
27688>>>>>>>        
27688>>>>>>>        Forward Send Construct_Object
27690>>>>>>>        
27690>>>>>>>        
27690>>>>>>>        
27690>>>>>>>        // this determines if request_save should validate all items or stop at the first error. The default
27690>>>>>>>        // for web applicaitions is to validate all.
27690>>>>>>>        // For now this is private, as this may never be needed.  
27690>>>>>>>        Property Boolean pbRequesteValidateAll True
27691>>>>>>>
27691>>>>>>>        // This is set to true during SyncDDOs, specifically while trying to re-establish the DDO's Field_Defaults.
27691>>>>>>>        // Typically the flag is used to protect DEO's during this process so that the Field_Default is re-established
27691>>>>>>>        // only in the actual DDO (where it is needed) and not in the DEO (where the value may have changed already).        
27691>>>>>>>        Property Boolean pbSynchingFieldDefaults False
27692>>>>>>>        
27692>>>>>>>        Property Boolean pbFindKeys True
27693>>>>>>>        Property Boolean pbClearKeys True
27694>>>>>>>        Property Boolean pbDeleteKeys True
27695>>>>>>>        Property Boolean pbSaveKeys True
27696>>>>>>>        
27696>>>>>>>        // set true if constrain_file change in data dictionaries for each client instance
27696>>>>>>>        // This is only applied with drilldown style views
27696>>>>>>>        Property Boolean pbDrillDownDynamicConstraints True 
27697>>>>>>>        
27697>>>>>>>        
27697>>>>>>>        
27697>>>>>>>        // Published Properties
27697>>>>>>>        Property Boolean pbServerOnSubmit False    // Set to true to trigger server OnSubmit event
27700>>>>>>>        Property String psClientOnSubmit ""        // Name of client side OnSubmit event handler
27703>>>>>>>        
27703>>>>>>>        Property Boolean pbServerOnResizeWindow False
27706>>>>>>>        Property String psClientOnResizeWindow ""
27709>>>>>>>         
27709>>>>>>>        Property Boolean pbFillHeight False
27712>>>>>>>        
27712>>>>>>>        // this gets set during object construction by looking at the cWebApp's application type.  
27712>>>>>>>        Property Integer peWebViewStyle wvsDesktop
27713>>>>>>>
27713>>>>>>>        Property Integer peViewType vtUndefined   // General purpose of this view: i.e. vtZoom or vtSelect
27714>>>>>>>        
27714>>>>>>>        // if drillDown should Request_Save attempt to save a new unchanged record?
27714>>>>>>>        // with drill down this makes the most sense. With Desktop style this is ignored.
27714>>>>>>>        // Currently marked private. Might be exposed if it turns out to be needed
27714>>>>>>>        Property Boolean pbAlwaysSaveWhenNewDrillDown True
27715>>>>>>>
27715>>>>>>>        // what to do when closing a changed view. This is called by
27715>>>>>>>        // GetChangedViewExitAction, which can be augmented to handle more dynamic actions
27715>>>>>>>        Property Integer peChangedViewExitAction cveConfirmSaveClearCancel
27716>>>>>>>        
27716>>>>>>>        Property Handle Verify_SaveClearCancel_msg (RefProc(SaveClearCancelConfirmation))
27717>>>>>>>
27717>>>>>>>        Property String psNavigateDataCallbackObj ""   // Private: Used by NavigateClose_Callback. Stores the callback object to populate the navigate data when navigating back. This is usually the object that invoked NavigateBack
27720>>>>>>>        
27720>>>>>>>        Property tWebNavigateData pNavigateData
27723>>>>>>>
27723>>>>>>>        Property String psNavigateBackView
27726>>>>>>>
27726>>>>>>>        Property String psInvokingObject ""        
27729>>>>>>>        
27729>>>>>>>        Property String psInvokingStateHash ""          //  Used to store the state hash of the invoking view for drill-down
27732>>>>>>>        Property Boolean pbNavReinitError False         //  Used to communicate issues back to NavigateInitialize
27733>>>>>>>        Property Boolean pbNavigating False           //  True while inside navigation messages
27734>>>>>>>        Property Boolean pbInitForShow False         //  True while inside initforshow
27735>>>>>>>        
27735>>>>>>>        Property Boolean pbStateRestoreRecord True      //  If true record ids will be part of the state hash for desktop-style
27736>>>>>>>        Property Boolean pbStateReplace False           //  If true the current view will not add a new history item but replace the current item in history
27737>>>>>>>        Property Integer peStateMode vsmDefault         //  Configures how the state hash for this view built
27738>>>>>>>        Property String psStateNewRecordId ""           //  Configures how new records will be represented in the state hash
27739>>>>>>>
27739>>>>>>>        
27739>>>>>>>        /*        A view is preloaded using delayloadview, this basically puts the view 'in sync' but it         loads the view details later. This is an optimization added for history management where it         has to rebuild the entire view stack for drill down applications. It now only fully loads         the visible view and the others are loaded in the background using delayloadview, but it         does need to refind records so InitForShow is already executed and should not be executed         again. pbPreLoaded indicates that it should skip InitForShow.                */
27739>>>>>>>        Property Boolean pbPreLoaded False
27742>>>>>>>                
27742>>>>>>>        Get Object_Label to sName
27743>>>>>>>        Property String psStateViewName sName
27744>>>>>>>               
27744>>>>>>>        // the constructor will set the style based on the application setting of this.
27744>>>>>>>        // this can be changed during object construction but most not be changed
27744>>>>>>>        // after the object is created (i.e., after end_construct_object)
27744>>>>>>>        Get peApplicationStyle of (Host(Self)) to eStyle
27745>>>>>>>        Set peWebViewStyle to eStyle
27746>>>>>>>        Set pbScroll to True
27747>>>>>>>
27747>>>>>>>        Set psJSClass to "df.WebView"

32251>>>>>>>>>    
32251>>>>>>>>>    
32251>>>>>>>>>    // Adds a new combo item to the combo list. Use this in the OnFill event.
32251>>>>>>>>>    //
32251>>>>>>>>>    // Note: If you are adding many combo items then it is more efficient/faster to
32251>>>>>>>>>    // manually populate the combo items array directly in OnFill.
32251>>>>>>>>>    Procedure AddComboItem String sValue String sDescription
32253>>>>>>>>>        Integer iCount
32253>>>>>>>>>        tWebComboItem[] aComboItems
32253>>>>>>>>>        tWebComboItem[] aComboItems
32254>>>>>>>>>        
32254>>>>>>>>>        Get paComboItems to aComboItems
32255>>>>>>>>>        Move (SizeOfArray(aComboItems)) to iCount
32256>>>>>>>>>        Move sValue to aComboItems[iCount].sValue
32257>>>>>>>>>        Move sDescription to aComboItems[iCount].sDescription
32258>>>>>>>>>        Set paComboItems to aComboItems
32259>>>>>>>>>    End_Procedure
32260>>>>>>>>>
32260>>>>>>>>>
32260>>>>>>>>>    // Private: Sent by DDO when populating the combo list.
32260>>>>>>>>>    Procedure ComboFillItem Integer iItem String sValue String sDescription Integer iFile RowID riId
32262>>>>>>>>>        Integer iCount
32262>>>>>>>>>        RowID[] aRowIDs
32263>>>>>>>>>        // Review: This technique is called for every member of the combo list. This causes an array resize for two array properties for each combo item added! It would be better to add all of the combo items in a single loop
32263>>>>>>>>>        If (sDescription = '') Begin
32265>>>>>>>>>            Move sValue to sDescription
32266>>>>>>>>>        End
32266>>>>>>>>>>
32266>>>>>>>>>        Send AddComboItem sValue sDescription
32267>>>>>>>>>        
32267>>>>>>>>>        // Add the row IDs....
32267>>>>>>>>>        Get private_paRowIDs to aRowIDs
32268>>>>>>>>>        Move (SizeOfArray(aRowIDs)) to iCount
32269>>>>>>>>>        Move riId to aRowIDs[iCount]
32270>>>>>>>>>        Set private_paRowIDs to aRowIDs
32271>>>>>>>>>    End_Procedure
32272>>>>>>>>>    
32272>>>>>>>>>    Procedure FillFromDDO
32274>>>>>>>>>        // Fills the combo list according to the data dictionary settings of the data binding. Normally sent during Attach_To_DDO
32274>>>>>>>>>        // but can be sent at other times
32274>>>>>>>>>        Integer iFile iField
32274>>>>>>>>>        Handle hoServer
32274>>>>>>>>>        Boolean bAddEmptyItem
32274>>>>>>>>>        tWebComboItem[] atEmpty
32274>>>>>>>>>        tWebComboItem[] atEmpty
32275>>>>>>>>>        String sEmptyItemDescription
32275>>>>>>>>>        
32275>>>>>>>>>        Get pbAddEmptyItem to bAddEmptyItem
32276>>>>>>>>>
32276>>>>>>>>>        Set paComboItems to atEmpty
32277>>>>>>>>>        Set private_paRowIDs to (ResizeArray(private_paRowIDs(Self),0))    // zero the row IDs array
32278>>>>>>>>>
32278>>>>>>>>>        Get Server to hoServer
32279>>>>>>>>>        Get Data_File  to iFile
32280>>>>>>>>>        Get Data_Field to iField
32281>>>>>>>>>
32281>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
32283>>>>>>>>>            //  Do security check
32283>>>>>>>>>            If (not(FillDEOAllowed(Self))) Begin
32285>>>>>>>>>                Procedure_Return
32286>>>>>>>>>            End
32286>>>>>>>>>>
32286>>>>>>>>>            
32286>>>>>>>>>            // if your DD does not have a default value you need to include an empty value. Even if you have a default
32286>>>>>>>>>            // it is fine to allow a blank line, which will probably fail upon validation (unless the DD allows blanks)
32286>>>>>>>>>            If (bAddEmptyItem) Begin
32288>>>>>>>>>                Get psEmptyItemDescription to sEmptyItemDescription
32289>>>>>>>>>                Send ComboFillItem 0 "" sEmptyItemDescription 0 (NullRowID()) 
32290>>>>>>>>>            End
32290>>>>>>>>>>
32290>>>>>>>>>            
32290>>>>>>>>>            Send File_Field_Fill_List to hoServer iFile iField Self msg_ComboFillItem
32291>>>>>>>>>        End
32291>>>>>>>>>>
32291>>>>>>>>>    End_Procedure
32292>>>>>>>>>    
32292>>>>>>>>>    
32292>>>>>>>>>    Procedure OnFill
32294>>>>>>>>>        // OnFill event stub. Fired whenever the combo list is to be filled.
32294>>>>>>>>>    End_Procedure
32295>>>>>>>>>    
32295>>>>>>>>>    
32295>>>>>>>>>    // Send this to trigger OnFill event to populate the combo list.
32295>>>>>>>>>    // Note: we wanted to call this method "Fill" but this symbol is already used in FMAC
32295>>>>>>>>>    //       which means we cannot register it using WebPublishMethod
32295>>>>>>>>>    Procedure Refill
32297>>>>>>>>>        String[] aParams
32298>>>>>>>>>        tWebComboItem[] aEmptyItems aItems
32298>>>>>>>>>        tWebComboItem[] aEmptyItems aItems
32300>>>>>>>>>        
32300>>>>>>>>>        Send FillFromDDO
32301>>>>>>>>>        Send OnFill                // trigger user event to populate paComboItems
32302>>>>>>>>>        
32302>>>>>>>>>        // Send paComboItems to the client....
32302>>>>>>>>>        Get ComboData to aItems
32303>>>>>>>>>        Send ClientAction "fill" aParams aItems       
32304>>>>>>>>>    End_Procedure
32305>>>>>>>>>    
32305>>>>>>>>>    
32305>>>>>>>>>    // Returns the combo list as an array of tWebRow structs where the first value is the value and 
32305>>>>>>>>>    // the second is the description.
32305>>>>>>>>>    Function ComboData Returns tWebComboItem[]
32307>>>>>>>>>        tWebComboItem[] aComboItems
32307>>>>>>>>>        tWebComboItem[] aComboItems
32308>>>>>>>>>        
32308>>>>>>>>>        // Iterate the combo items....
32308>>>>>>>>>        Get paComboItems to aComboItems
32309>>>>>>>>>        
32309>>>>>>>>>        Function_Return aComboItems
32310>>>>>>>>>    End_Function
32311>>>>>>>>>    
32311>>>>>>>>>    //  Augmented to fixate psMask

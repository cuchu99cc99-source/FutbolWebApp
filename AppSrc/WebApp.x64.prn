1132>>>>>>>>>// This is a recursive function. It will create the directory sDir, but if the parent directory
1132>>>>>>>>>// of sDir does not exist, then it is created first. This is necessary because Make_Directory needs
1132>>>>>>>>>// the parent directory to be already there or it will fail.
1132>>>>>>>>>//
1132>>>>>>>>>// Returns True if the directory already exists or if it was successfully created.
1132>>>>>>>>>Function CreateDirectoryRecursive Global String sDir Returns Boolean
1134>>>>>>>>>    Integer iPos iCount
1134>>>>>>>>>    String sParent sSep
1134>>>>>>>>>    Boolean bResult
1134>>>>>>>>>    Move (SysConf(SYSCONF_DIR_SEPARATOR)) to sSep   // i.e. sSep = "\"
1135>>>>>>>>>
1135>>>>>>>>>    Move True         to bResult
1136>>>>>>>>>    Move (Trim(sDir)) to sDir
1137>>>>>>>>>    Move 1            to iPos  // This is "really" important so that the recursion can break out if the Path name is invalid
1138>>>>>>>>>
1138>>>>>>>>>    // Stop now if sDir is already a directory....
1138>>>>>>>>>    If (IsDirectory(sDir)) ;        Function_Return True
1141>>>>>>>>>
1141>>>>>>>>>    // break out of the recursion if sDir is a drive designator,
1141>>>>>>>>>    // or a "\".
1141>>>>>>>>>    If ((sDir = sSep) or (Right(sDir,1) = ":") or (sDir = "")) ;        Function_Return False
1144>>>>>>>>>
1144>>>>>>>>>    // Find the last "\" position (not counting the last character).
1144>>>>>>>>>    If (Right(sDir ,1) = sSep) Begin
1146>>>>>>>>>        Move (Left(sDir, Length(sDir) - 1)) to sDir
1147>>>>>>>>>    End
1147>>>>>>>>>>
1147>>>>>>>>>
1147>>>>>>>>>    For iCount from 1 to (Length(sDir))
1153>>>>>>>>>>
1153>>>>>>>>>        If (Mid(sDir,1,iCount) = sSep) ;            Move iCount to iPos
1156>>>>>>>>>    Loop
1157>>>>>>>>>>
1157>>>>>>>>>
1157>>>>>>>>>    // get the parent directory.
1157>>>>>>>>>    Move (Left(sDir, iPos - 1)) to sParent
1158>>>>>>>>>
1158>>>>>>>>>    // Test if the Parent directory exists. If not, create it....
1158>>>>>>>>>    If (not(IsDirectory(sParent))) Begin
1160>>>>>>>>>        Move (CreateDirectoryRecursive(sParent)) to bResult
1161>>>>>>>>>    End
1161>>>>>>>>>>
1161>>>>>>>>>
1161>>>>>>>>>    // Now the parent should be built so try to build the passed directory...
1161>>>>>>>>>    If (bResult) Begin
1163>>>>>>>>>        Move False to Err
1164>>>>>>>>>        Make_Directory sDir
1165>>>>>>>>>
1165>>>>>>>>>        If (Err) Begin
1167>>>>>>>>>            Move False to bResult
1168>>>>>>>>>        End
1168>>>>>>>>>>
1168>>>>>>>>>    End
1168>>>>>>>>>>
1168>>>>>>>>>
1168>>>>>>>>>    Function_Return bResult
1169>>>>>>>>>End_Function

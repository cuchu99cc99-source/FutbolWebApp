8139>>>>>>>>>    Function PathAtIndex String sPaths Integer iIndex Returns String
8141>>>>>>>>>        // Returns the path at the 1-based index of passed paths.
8141>>>>>>>>>        // If the path contains a trailing "\", it will be removed
8141>>>>>>>>>        Integer iChar icPath iPath iPos
8141>>>>>>>>>        String sPath
8141>>>>>>>>>        
8141>>>>>>>>>        Move (sPaths +";") to sPaths
8142>>>>>>>>>        For iPath from 1 to iIndex
8148>>>>>>>>>>
8148>>>>>>>>>            Move (Pos(";", sPaths)) to iPos
8149>>>>>>>>>            If iPos Begin
8151>>>>>>>>>                Move (Left(sPaths, iPos -1)) to sPath
8152>>>>>>>>>                If (Right(sPath,1) = '\') ;                    Move (Left(sPath, Length(sPath) -1)) to sPath
8155>>>>>>>>>                Move (Right(sPaths, Length(sPaths) -iPos)) to sPaths
8156>>>>>>>>>            End
8156>>>>>>>>>>
8156>>>>>>>>>            Else ;                Function_Return "" // index past number of paths
8158>>>>>>>>>        Loop
8159>>>>>>>>>>
8159>>>>>>>>>        
8159>>>>>>>>>        Function_Return sPath
8160>>>>>>>>>    End_Function

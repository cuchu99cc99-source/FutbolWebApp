33003>>>>>>>    Procedure RequestClearExec
33005>>>>>>>        String sCurrentRowID
33005>>>>>>>        RowID riCurrentRowID
33005>>>>>>>        Handle hoDD
33005>>>>>>>        Integer iMainFile
33005>>>>>>>        Boolean bOldGridAction bContinue bDataAware bSuccess
33005>>>>>>>
33005>>>>>>>        WebGet psCurrentRowId to sCurrentRowID
33006>>>>>>>        Get OnClearRow sCurrentRowID to bContinue
33007>>>>>>>        
33007>>>>>>>        Get pbDataAware to bDataAware
33008>>>>>>>        If (bDataAware) Begin
33010>>>>>>>            // db-aware....
33010>>>>>>>            If (bContinue) Begin
33012>>>>>>>                //  Set to prevent the entire grid from refreshing
33012>>>>>>>                Get Server to hoDD        
33013>>>>>>>                Move (DeserializeRowID(sCurrentRowID)) to riCurrentRowID
33014>>>>>>>                Get pbNotifyingExternalDD to bOldGridAction
33015>>>>>>>                Set pbNotifyingExternalDD to True
33016>>>>>>>                
33016>>>>>>>                //  Refind the current record
33016>>>>>>>                If (IsNullRowID(riCurrentRowID)) Begin
33018>>>>>>>                    Send Clear of hoDD
33019>>>>>>>                End
33019>>>>>>>>
33019>>>>>>>                Else Begin
33020>>>>>>>                    Get Main_File of hoDD to iMainFile
33021>>>>>>>                    Get FindByRowIdEx of hoDD iMainFile riCurrentRowID to bSuccess
33022>>>>>>>                    If not bSuccess Begin
33024>>>>>>>                        Set pbNotifyingExternalDD to False
33025>>>>>>>                        Send ReportCacheError
33026>>>>>>>                    End
33026>>>>>>>>
33026>>>>>>>                End
33026>>>>>>>>
33026>>>>>>>            
33026>>>>>>>                Set pbNotifyingExternalDD to bOldGridAction
33027>>>>>>>            End
33027>>>>>>>>
33027>>>>>>>        End
33027>>>>>>>>
33027>>>>>>>        Else Begin
33028>>>>>>>            // non-db aware...
33028>>>>>>>            If (bContinue) Begin
33030>>>>>>>                Send ClearRow sCurrentRowID
33031>>>>>>>            End
33031>>>>>>>>
33031>>>>>>>        End
33031>>>>>>>>
33031>>>>>>>    End_Procedure
33032>>>>>>>
33032>>>>>>>    
33032>>>>>>>    // Clear Logic which basically means refinding the current record.
33032>>>>>>>    // returns True if the clear was successful, False if we are not sure because there is a callback or clear actually failed
33032>>>>>>>    Function ClearSelectedRow Returns Integer
33034>>>>>>>        Handle hoDD hmVerify
33034>>>>>>>        String sCurrentRowID
33034>>>>>>>        Boolean bDataAware bChanged
33034>>>>>>>        Integer iReturn
33034>>>>>>>
33034>>>>>>>        // Manual data handling?
33034>>>>>>>        Get Verify_Data_Loss_Msg to hmVerify
33035>>>>>>>        WebGet psCurrentRowId to sCurrentRowID
33036>>>>>>>        Get pbDataAware to bDataAware
33037>>>>>>>        
33037>>>>>>>        Get ShouldSaveRow to bChanged
33038>>>>>>>        
33038>>>>>>>        If (bChanged) Begin
33040>>>>>>>            If (bDataAware) Begin
33042>>>>>>>                // db-aware..
33042>>>>>>>                Get Server to hoDD
33043>>>>>>>                If (hoDD <> 0) Begin
33045>>>>>>>                    If hmVerify Begin
33047>>>>>>>                        Send VerifyRequest (RefProc(RequestClearCallBack)) (RefFunc(Verify_Data_Loss_Msg))
33048>>>>>>>                        Function_Return sroPending // this means there is a verification so we don't know yet
33049>>>>>>>                    End
33049>>>>>>>>
33049>>>>>>>                    Else Begin
33050>>>>>>>                        Send RequestClearExec
33051>>>>>>>                        If (Should_Save_Row(hoDD)) Begin
33053>>>>>>>                            Function_Return sroFail // this means it actually failed
33054>>>>>>>                        End
33054>>>>>>>>
33054>>>>>>>                    End
33054>>>>>>>>
33054>>>>>>>                End
33054>>>>>>>>
33054>>>>>>>                Function_Return sroSucceed
33055>>>>>>>            End
33055>>>>>>>>
33055>>>>>>>            Else Begin
33056>>>>>>>                // non db-aware..
33056>>>>>>>                If hmVerify Begin
33058>>>>>>>                    Send VerifyRequest (RefProc(RequestClearCallBack)) (RefFunc(Verify_Data_Loss_Msg))
33059>>>>>>>                    Function_Return sroPending // this means there is a verification so we don't know yet
33060>>>>>>>                End
33060>>>>>>>>
33060>>>>>>>                Else Begin
33061>>>>>>>                    Send RequestClearExec
33062>>>>>>>                    // Currently we always consider that a clear succeeds. This is probably as safe
33062>>>>>>>                    // assumption but might be revisited in the future.
33062>>>>>>>                    Function_Return sroSucceed
33063>>>>>>>                End
33063>>>>>>>>
33063>>>>>>>            End
33063>>>>>>>>
33063>>>>>>>        End
33063>>>>>>>>
33063>>>>>>>      
33063>>>>>>>        Function_Return sroSucceed
33064>>>>>>>    End_Function
33065>>>>>>>    
33065>>>>>>>    // Client action to remove the passed row from the cache. 
33065>>>>>>>    Procedure ClearRow String sRowID
33067>>>>>>>        String[] aParams
33068>>>>>>>        
33068>>>>>>>        Move sRowID to aParams[0]
33069>>>>>>>        Send ClientAction "clearRow" aParams    
33070>>>>>>>    End_Procedure
33071>>>>>>>
33071>>>>>>>
33071>>>>>>>    
33071>>>>>>>    Procedure RequestSaveExec
33073>>>>>>>        Handle hoServer 
33073>>>>>>>        String sCurrentRowID sOrigRowID
33073>>>>>>>        Boolean bDataAware bContinue bError bUnOrdered bAutoRegenerate
33073>>>>>>>
33073>>>>>>>        WebGet psCurrentRowId to sOrigRowID
33074>>>>>>>        Move sOrigRowID to sCurrentRowID
33075>>>>>>>        
33075>>>>>>>        Get OnSaveRow (&sCurrentRowID) to bContinue
33076>>>>>>>        WebSet psCurrentRowId to sCurrentRowID   
33077>>>>>>>        
33077>>>>>>>        // db-aware....
33077>>>>>>>        Move (not(bContinue)) to bError
33078>>>>>>>        Get pbDataAware to bDataAware
33079>>>>>>>        
33079>>>>>>>        If (bDataAware and bContinue) Begin
33081>>>>>>>            // Validate the row... 
33081>>>>>>>            Get Server to hoServer
33082>>>>>>>            Get ValidateRow to bError
33083>>>>>>>            If (bError) Begin
33085>>>>>>>                Procedure_Return
33086>>>>>>>            End    
33086>>>>>>>>
33086>>>>>>>    
33086>>>>>>>            // Perform the save....
33086>>>>>>>            Move False to  Err
33087>>>>>>>            Send Request_Save to hoServer
33088>>>>>>>            Move Err to bError
33089>>>>>>>            If not bError Begin
33091>>>>>>>                // if a successful save see if we need to refresh the list. We do i
33091>>>>>>>                // pbAutoRegenerate is True and a save has rendered it possible unordered.
33091>>>>>>>                WebGet pbUnOrdered to bUnOrdered
33092>>>>>>>                Get pbAutoRegenerate to bAutoRegenerate
33093>>>>>>>                If (bUnOrdered and bAutoRegenerate) Begin
33095>>>>>>>                    Send RefreshListFromDD
33096>>>>>>>                End
33096>>>>>>>>
33096>>>>>>>            End
33096>>>>>>>>
33096>>>>>>>        End
33096>>>>>>>>
33096>>>>>>>        
33096>>>>>>>        // Force the client to refresh the saved row (in case any values were changed).
33096>>>>>>>        If (not(bError)) Begin
33098>>>>>>>            Send UpdateRow sOrigRowID 
33099>>>>>>>        End
33099>>>>>>>>
33099>>>>>>>    End_Procedure
33100>>>>>>>        
33100>>>>>>>    // Returns sroSucceed if the save was successful. Called by Request_Save.
33100>>>>>>>    Function SaveSelectedRow Returns Integer
33102>>>>>>>        Handle hoDD hmVerify
33102>>>>>>>        RowID riCurrentRowID riTestRowID
33102>>>>>>>        String sCurrentRowID
33102>>>>>>>        Boolean bDataAware bChanged bError
33102>>>>>>>        Integer iReturn
33102>>>>>>>
33102>>>>>>>        // Manual data handling?
33102>>>>>>>        WebGet psCurrentRowId to sCurrentRowID
33103>>>>>>>        Get pbDataAware to bDataAware
33104>>>>>>>        
33104>>>>>>>        // db-aware data handling....
33104>>>>>>>        If (bDataAware) Begin
33106>>>>>>>            Get Server to hoDD
33107>>>>>>>            
33107>>>>>>>            If (hoDD <> 0) Begin
33109>>>>>>>                Move (DeserializeRowID(sCurrentRowID)) to riCurrentRowID
33110>>>>>>>                Get CurrentRowId of hoDD to riTestRowID
33111>>>>>>>                
33111>>>>>>>                If (not(IsSameRowID(riCurrentRowID, riTestRowID))) Begin
33113>>>>>>>                    Error DFERR_PROGRAM "Assert: Server DDO's current record does not match psCurrentRowId"
33114>>>>>>>>
33114>>>>>>>                    Function_Return sroFail
33115>>>>>>>                End
33115>>>>>>>>
33115>>>>>>>                
33115>>>>>>>                // Verify that we are allowed to save....
33115>>>>>>>                If (Read_Only_State(hoDD)) Begin
33117>>>>>>>                    Function_Return sroFail         // the view should not allow this to happen
33118>>>>>>>                End
33118>>>>>>>>
33118>>>>>>>            End
33118>>>>>>>>
33118>>>>>>>        End
33118>>>>>>>>
33118>>>>>>>        
33118>>>>>>>        // If there is nothing to save, do nothing....
33118>>>>>>>        Get ShouldSaveRow to bChanged
33119>>>>>>>        If (not(bChanged)) Begin
33121>>>>>>>            Function_Return sroSucceed
33122>>>>>>>        End
33122>>>>>>>>
33122>>>>>>>        
33122>>>>>>>        // Validate the row... 
33122>>>>>>>        Get ValidateRow to bError
33123>>>>>>>        If (bError) Begin
33125>>>>>>>            Function_Return sroFail
33126>>>>>>>        End   
33126>>>>>>>>
33126>>>>>>>        
33126>>>>>>>        // perform verify callback or save now...
33126>>>>>>>        Get Verify_Save_msg to hmVerify
33127>>>>>>>        If (hmVerify) Begin
33129>>>>>>>            WebSet pbSaveCallbackActive to True
33130>>>>>>>            Send VerifyRequest (RefProc(RequestSaveCallBack)) (RefFunc(Verify_Save_msg))
33131>>>>>>>            Function_Return sroPending
33132>>>>>>>        End
33132>>>>>>>>
33132>>>>>>>        Else Begin
33133>>>>>>>            Send RequestSaveExec
33134>>>>>>>            If (bDataAware and Should_Save_Row(hoDD)) Begin
33136>>>>>>>                Function_Return sroFail
33137>>>>>>>            End
33137>>>>>>>>
33137>>>>>>>        End
33137>>>>>>>>
33137>>>>>>>        
33137>>>>>>>        Function_Return sroSucceed
33138>>>>>>>    End_Function
33139>>>>>>>    
33139>>>>>>>    // Determines if the current row has changed values in which case it should be saved. For 
33139>>>>>>>    // data-aware grids the DDO is asked to determine this. For non-data-aware grids the individual
33139>>>>>>>    // changed states of columns are queried.
33139>>>>>>>    Function ShouldSaveRow Returns Boolean
33141>>>>>>>        Handle[] aColumns
33142>>>>>>>        Integer iCol
33142>>>>>>>        Boolean bChanged
33142>>>>>>>      
33142>>>>>>>        // Test for Data-Aware grid...
33142>>>>>>>        If (pbDataAware(Self)) Begin
33144>>>>>>>            Function_Return (Should_Save_Row(Server(Self)))            
33145>>>>>>>        End
33145>>>>>>>>
33145>>>>>>>        Else Begin
33146>>>>>>>            //  Determine if a value was changed
33146>>>>>>>            Get phoColumnObjects to aColumns
33147>>>>>>>            For iCol from 0 to (SizeOfArray(aColumns) - 1)
33153>>>>>>>>
33153>>>>>>>                WebGet pbChanged of aColumns[iCol] to bChanged
33154>>>>>>>                
33154>>>>>>>                If (bChanged) Begin
33156>>>>>>>                    Function_Return True
33157>>>>>>>                End
33157>>>>>>>>
33157>>>>>>>            Loop
33158>>>>>>>>
33158>>>>>>>            
33158>>>>>>>            Function_Return False
33159>>>>>>>        End
33159>>>>>>>>
33159>>>>>>>    End_Function
33160>>>>>>>
33160>>>>>>>    // Returns true if you can move off of the selected row.
33160>>>>>>>    // This gets called during a row change and returns true if the row change is allowed. You are allowed
33160>>>>>>>    // to make changes to the row such as saving or clearing before returning if the row change is allowed.
33160>>>>>>>    //
33160>>>>>>>    // The following actions are performed here:
33160>>>>>>>    // [1] - ShouldSaveRow is tested. This will test if the current row needs saving.
33160>>>>>>>    // [2] - If the row needs saving it is saved if validation passes. If not then we stop here.
33160>>>>>>>    // [3] - If we are moving to a new row then the row is cleared, loaded with default values,
33160>>>>>>>    //       and the OnNewRow event gets fired.
33160>>>>>>>    Function AllowChangeSelectedRow String sGotoRow String sToRowID Returns Boolean
33162>>>>>>>        Handle hoDD hoColumn
33162>>>>>>>        Handle hmVerify
33162>>>>>>>       
33162>>>>>>>        RowID riCurrentRowID riTestRowID
33162>>>>>>>        String sCurrentRowID
33162>>>>>>>        Boolean bAutoSave bDataAware bChanged bResult bOldGridAction
33162>>>>>>>        Integer eSelectedRowOperation iCol iTo iRowIndex
33162>>>>>>>
33162>>>>>>>        Get Server to hoDD
33163>>>>>>>        Get pbAutoSave to bAutoSave
33164>>>>>>>        Get pbDataAware to bDataAware
33165>>>>>>>        
33165>>>>>>>        //  Assertions
33165>>>>>>>        If (bDataAware) Begin
33167>>>>>>>            If (hoDD <> 0) Begin
33169>>>>>>>                WebGet psCurrentRowId to sCurrentRowID
33170>>>>>>>                Move (DeserializeRowID(sCurrentRowID)) to riCurrentRowID
33171>>>>>>>                Get CurrentRowId of hoDD to riTestRowID
33172>>>>>>>                
33172>>>>>>>                If (not(IsSameRowID(riCurrentRowID, riTestRowID))) Begin
33174>>>>>>>                    Error DFERR_PROGRAM "Assert: Server DDO's current record does not match psCurrentRowId"
33175>>>>>>>>
33175>>>>>>>                    Function_Return False
33176>>>>>>>                End
33176>>>>>>>>
33176>>>>>>>            End
33176>>>>>>>>
33176>>>>>>>            Else Begin
33177>>>>>>>                Function_Return False
33178>>>>>>>            End
33178>>>>>>>>
33178>>>>>>>        End
33178>>>>>>>>
33178>>>>>>>        
33178>>>>>>>        // Save if needed, test also if the grid is currently cleared (no rows to save)....
33178>>>>>>>        WebGet piCurrentRowIndex to iRowIndex
33179>>>>>>>        
33179>>>>>>>        If (iRowIndex = -1) Begin
33181>>>>>>>            Move False to bChanged
33182>>>>>>>        End
33182>>>>>>>>
33182>>>>>>>        Else Begin
33183>>>>>>>            Get ShouldSaveRow to bChanged
33184>>>>>>>        End
33184>>>>>>>>
33184>>>>>>>
33184>>>>>>>        If (bChanged) Begin
33186>>>>>>>            // Verify that we are allowed to save....
33186>>>>>>>            If (bDataAware and Read_Only_State(hoDD)) Begin
33188>>>>>>>                Function_Return False         // the view should not allow this to happen
33189>>>>>>>            End
33189>>>>>>>>
33189>>>>>>>            
33189>>>>>>>            // Auto-save gets precedence over data-loss/clear
33189>>>>>>>            If bAutoSave Begin
33191>>>>>>>                Get SaveSelectedRow to eSelectedRowOperation
33192>>>>>>>            End
33192>>>>>>>>
33192>>>>>>>            Else Begin
33193>>>>>>>                Get ClearSelectedRow to eSelectedRowOperation
33194>>>>>>>            End
33194>>>>>>>>
33194>>>>>>>            
33194>>>>>>>            // we only allow a row change if we are sure we succeeded in the save or clear. If a confirmation verification
33194>>>>>>>            // is required the above will return sroPending, which we will treat as a no.
33194>>>>>>>            If (not(eSelectedRowOperation=sroSucceed)) Begin
33196>>>>>>>                Function_Return False
33197>>>>>>>            End
33197>>>>>>>>
33197>>>>>>>        End
33197>>>>>>>>
33197>>>>>>>        
33197>>>>>>>        //  Handle changing to a new row
33197>>>>>>>        If (sGotoRow = "new") Begin
33199>>>>>>>            If (bDataAware) Begin
33201>>>>>>>                // data-aware: Clear the DD
33201>>>>>>>                Get Server to hoDD
33202>>>>>>>                // find the row that we are going to...
33202>>>>>>>                Get pbNotifyingExternalDD to bOldGridAction
33203>>>>>>>                Set pbNotifyingExternalDD to True
33204>>>>>>>                
33204>>>>>>>                Send Clear of hoDD
33205>>>>>>>                
33205>>>>>>>                Set pbNotifyingExternalDD to bOldGridAction
33206>>>>>>>            End
33206>>>>>>>>
33206>>>>>>>            Else Begin
33207>>>>>>>                // non-data-aware: Use the data received from the client
33207>>>>>>>                Send FillFromActionData
33208>>>>>>>            End
33208>>>>>>>>
33208>>>>>>>            
33208>>>>>>>            //  Trigger event
33208>>>>>>>            Send OnNewRow
33209>>>>>>>        End
33209>>>>>>>>
33209>>>>>>>        
33209>>>>>>>        Function_Return True
33210>>>>>>>    End_Function
33211>>>>>>>    
33211>>>>>>>    
33211>>>>>>>    // Validates the selected row. 
33211>>>>>>>    // Returns True if Error, False if Ok
33211>>>>>>>    Function ValidateRow Returns Boolean
33213>>>>>>>        Handle hoDD
33213>>>>>>>        Handle[] hoColumnObjects
33214>>>>>>>        Boolean bError bRequestValidateAll bDataAware bOk
33214>>>>>>>        Integer icColumn iCol
33214>>>>>>>        
33214>>>>>>>        Get pbRequesteValidateAll to bRequestValidateAll
33215>>>>>>>        
33215>>>>>>>        Get pbDataAware to bDataAware
33216>>>>>>>        
33216>>>>>>>        // if not data aware perform validation here
33216>>>>>>>        If (not(bDataAware)) Begin
33218>>>>>>>    
33218>>>>>>>            // Validate each column....
33218>>>>>>>            Get phoColumnObjects to hoColumnObjects
33219>>>>>>>            Move (SizeOfArray(hoColumnObjects)) to icColumn
33220>>>>>>>            
33220>>>>>>>            For iCol from 0 to (icColumn-1)
33226>>>>>>>>
33226>>>>>>>                Get OnValidate of hoColumnObjects[iCol] to bOk
33227>>>>>>>                If not bOk Begin
33229>>>>>>>                    If not bRequestValidateAll Begin
33231>>>>>>>                        Function_Return True
33232>>>>>>>                    End
33232>>>>>>>>
33232>>>>>>>                    Else Begin
33233>>>>>>>                        Move True to bError
33234>>>>>>>                    End
33234>>>>>>>>
33234>>>>>>>                End
33234>>>>>>>>
33234>>>>>>>            Loop
33235>>>>>>>>
33235>>>>>>>            Function_Return bError
33236>>>>>>>        End
33236>>>>>>>>
33236>>>>>>>        
33236>>>>>>>        // if data aware, perform validation through the DDs
33236>>>>>>>        Get Server to hoDD
33237>>>>>>>        If (hoDD <> 0) Begin
33239>>>>>>>            Get pbRequesteValidateAll to bRequestValidateAll
33240>>>>>>>            If bRequestValidateAll Begin
33242>>>>>>>                Get Request_Validate_All of hoDD to bError
33243>>>>>>>            End
33243>>>>>>>>
33243>>>>>>>            Else Begin
33244>>>>>>>                Get Request_Validate of hoDD to bError
33245>>>>>>>            End
33245>>>>>>>>
33245>>>>>>>            
33245>>>>>>>        End
33245>>>>>>>>
33245>>>>>>>        Function_Return bError
33246>>>>>>>    End_Function
33247>>>>>>>
33247>>>>>>>
33247>>>>>>>    // Client action that updates a grid row with the passed data.
33247>>>>>>>    Procedure UpdateRow String sRowID
33249>>>>>>>        tWebRow[] aData
33249>>>>>>>        tWebRow[] aData
33250>>>>>>>        String[] aParams
33251>>>>>>>
33251>>>>>>>        Get LoadGridRow to aData[0]
33252>>>>>>>        

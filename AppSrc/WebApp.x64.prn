35543>>>>>>>    
35543>>>>>>>    //  The default implementation of the OnChange will perform the find operation so if 
35543>>>>>>>    //  pbServerOnChange is enabled changing the combo will immediately update other fields from 
35543>>>>>>>    //  the parent that might be displayed.
35543>>>>>>>    Procedure OnChange String sNewValue String sOldValue
35545>>>>>>>        Integer iFile
35545>>>>>>>        RowID riNewRow
35545>>>>>>>        Handle hoDD hoServer
35545>>>>>>>        Boolean bAllowFind
35545>>>>>>>        
35545>>>>>>>        Forward Send OnChange sNewValue sOldValue
35547>>>>>>>        
35547>>>>>>>        Get Server to hoServer
35548>>>>>>>        Get Data_File to iFile
35549>>>>>>>        
35549>>>>>>>        If (hoServer > 0 and iFile > 0) Begin
35551>>>>>>>            //  Do security check
35551>>>>>>>            If (not(FillDEOAllowed(Self))) Begin
35553>>>>>>>                Procedure_Return
35554>>>>>>>            End
35554>>>>>>>>
35554>>>>>>>            
35554>>>>>>>            Get Data_Set of hoServer iFile to hoDD
35555>>>>>>>            
35555>>>>>>>            If (hoDD > 0) Begin
35557>>>>>>>                Get AllowParentFind of hoDD to bAllowFind
35558>>>>>>>                
35558>>>>>>>                If (bAllowFind) Begin
35560>>>>>>>                    Move (DeserializeRowID(sNewValue)) to riNewRow
35561>>>>>>>                    
35561>>>>>>>                    If (not(IsNullRowID(riNewRow))) Begin
35563>>>>>>>                        Send FindByRowId of hoDD (Main_File(hoDD)) riNewRow
35564>>>>>>>                    End
35564>>>>>>>>
35564>>>>>>>                    Else Begin
35565>>>>>>>                        Send Clear of hoDD  
35566>>>>>>>                    End
35566>>>>>>>>
35566>>>>>>>                End
35566>>>>>>>>
35566>>>>>>>            End
35566>>>>>>>>
35566>>>>>>>        End
35566>>>>>>>>
35566>>>>>>>    End_Procedure
35567>>>>>>>    
35567>>>>>>>    //  Override the UpdateDataBinding and instead of setting the field its changed-value it 
35567>>>>>>>    //  performs a find to select the right parent.
35567>>>>>>>    Procedure UpdateDataBinding
35569>>>>>>>        Integer iFile
35569>>>>>>>        String sRowId
35569>>>>>>>        RowID riNewRow
35569>>>>>>>        Handle hoDD hoServer
35569>>>>>>>        Boolean bAllowFind
35569>>>>>>>        
35569>>>>>>>        WebGet psValue to sRowId
35570>>>>>>>        Get Server to hoServer
35571>>>>>>>        Get Data_File to iFile
35572>>>>>>>        
35572>>>>>>>        If (hoServer > 0 and iFile > 0) Begin        
35574>>>>>>>            //  Do security check
35574>>>>>>>            If (not(UpdateDDAllowed(Self))) Begin
35576>>>>>>>                Procedure_Return
35577>>>>>>>            End
35577>>>>>>>>
35577>>>>>>>            
35577>>>>>>>            Get Data_Set of hoServer iFile to hoDD
35578>>>>>>>            
35578>>>>>>>            If (hoDD > 0) Begin
35580>>>>>>>                Get AllowParentFind of hoDD to bAllowFind
35581>>>>>>>                
35581>>>>>>>                If (bAllowFind) Begin
35583>>>>>>>                    Move (DeserializeRowID(sRowId)) to riNewRow
35584>>>>>>>                    
35584>>>>>>>                    If (not(IsSameRowID(CurrentRowId(hoDD), riNewRow))) Begin
35586>>>>>>>                        If (not(IsNullRowID(riNewRow))) Begin
35588>>>>>>>                            Send FindByRowId of hoDD (Main_File(hoDD)) riNewRow
35589>>>>>>>                        End
35589>>>>>>>>
35589>>>>>>>                        Else Begin
35590>>>>>>>                            Send Clear of hoDD  
35591>>>>>>>                        End
35591>>>>>>>>
35591>>>>>>>                    End
35591>>>>>>>>
35591>>>>>>>                End
35591>>>>>>>>
35591>>>>>>>            End 
35591>>>>>>>>
35591>>>>>>>        End
35591>>>>>>>>
35591>>>>>>>    End_Procedure
35592>>>>>>>    
35592>>>>>>>    //  We don't look at the field options as the parent combo only alters the relationship and not the field itself,

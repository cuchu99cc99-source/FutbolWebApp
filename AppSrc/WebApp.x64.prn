2398>>>>>>>    // SQL Helper functions that return SQL Filters strings that can be used in a where clause
2398>>>>>>>
2398>>>>>>>    // Escape character to escape LIKE wildcards
2398>>>>>>>
2398>>>>>>>    Function SQLEscapedStr String sSQL Returns String
2400>>>>>>>        String sEscapedSQL
2400>>>>>>>        // Replace one single quote by 2 single quotes
2400>>>>>>>        Move (Replaces("'",sSQL,"''")) to sEscapedSQL
2401>>>>>>>        Function_Return sEscapedSQL
2402>>>>>>>    End_Function
2403>>>>>>>
2403>>>>>>>    Function SQLEscapeLikeWildcards String sSQL Returns String
2405>>>>>>>        // Escape the wildcard characters than can be used in a LIKE
2405>>>>>>>        If (Pos("%",sSQL)) ;            Move (Replaces("%",sSQL,(SQL_LIKE_ESC + "%"))) to sSQL
2408>>>>>>>        If (Pos("_",sSQL)) ;            Move (Replaces("_",sSQL,(SQL_LIKE_ESC + "_"))) to sSQL
2411>>>>>>>
2411>>>>>>>        Function_Return sSQL
2412>>>>>>>    End_Function
2413>>>>>>>
2413>>>>>>>    // Creates an SQL Like Filter for this field and search target
2413>>>>>>>    Function SQLStrLike Integer iField String sSearch Returns String
2415>>>>>>>        String sFilter sOrigFilter sField
2415>>>>>>>        Integer iFile
2415>>>>>>>        Integer iHasLikeEscape
2415>>>>>>>        String  sPrefix
2415>>>>>>>
2415>>>>>>>        Delegate Get Main_File to iFile
2417>>>>>>>        Delegate Get psSQLFilter to sOrigFilter
2419>>>>>>>        Get SQLStrFieldName iField to sField
2420>>>>>>>        Get SQLEscapedStr sSearch to sSearch
2421>>>>>>>
2421>>>>>>>        Move (Pos(SQL_LIKE_ESC,sSearch)) to iHasLikeEscape
2422>>>>>>>        If (not(iHasLikeEscape)) Begin
2424>>>>>>>            Get SQLEscapeLikeWildcards sSearch to sSearch
2425>>>>>>>        End
2425>>>>>>>>
2425>>>>>>>
2425>>>>>>>        // Add the N prefix to properly handle Unicode data
2425>>>>>>>        Move 'N' to sPrefix
2426>>>>>>>        Move (sField + " LIKE " + sPrefix + "'%" + sSearch + "%'") to sFilter
2427>>>>>>>
2427>>>>>>>        If (not(iHasLikeEscape)) Begin
2429>>>>>>>            If (Pos(SQL_LIKE_ESC,sFilter)) Begin
2431>>>>>>>                Move (sFilter + " ESCAPE '" + SQL_LIKE_ESC + "' "  ) to sFilter
2432>>>>>>>            End
2432>>>>>>>>
2432>>>>>>>        End
2432>>>>>>>>
2432>>>>>>>
2432>>>>>>>        Function_Return sFilter
2433>>>>>>>    End_Function
2434>>>>>>>
2434>>>>>>>    // Appends two Filters with an AND clause. Both or either can be empty
2434>>>>>>>    Function SQLStrAppend String sOrigFilter String sFilter Returns String
2436>>>>>>>        If (sOrigFilter<>"" and sFilter<>"") Begin
2438>>>>>>>            Move ( "(" + sOrigFilter + ") AND (" + sFilter + ")") to sFilter
2439>>>>>>>        End
2439>>>>>>>>
2439>>>>>>>        Else If (sFilter="") Begin
2442>>>>>>>            Move sOrigFilter to sFilter
2443>>>>>>>        End
2443>>>>>>>>
2443>>>>>>>        Function_Return sFilter
2444>>>>>>>    End_Function
2445>>>>>>>
2445>>>>>>>    // Appends two filters with an or clause. Both or either can be empty.
2445>>>>>>>    // This may be used in OnConstrain methods when building SQL WHERE clauses in string values.
2445>>>>>>>    Function SQLStrAppendOr String sOrigFilter String sFilter Returns String
2447>>>>>>>        If (sOrigFilter<>"" and sFilter<>"") Begin
2449>>>>>>>            Move ("(" + sOrigFilter + ") OR (" + sFilter + ")") to sFilter
2450>>>>>>>        End
2450>>>>>>>>
2450>>>>>>>        Else If (sFilter="") Begin
2453>>>>>>>            Move sOrigFilter to sFilter
2454>>>>>>>        End
2454>>>>>>>>
2454>>>>>>>            Function_Return sFilter
2455>>>>>>>    End_Function

11189>>>>>>>>>Class cSQLTokenProvider is a cObject
11190>>>>>>>>>    
11190>>>>>>>>>    Procedure Construct_Object
11192>>>>>>>>>        Forward Send Construct_Object
11194>>>>>>>>>
11194>>>>>>>>>        Property Boolean pbSQLTokenLogin True
11195>>>>>>>>>        
11195>>>>>>>>>        Property String psSQLAccessToken ""
11196>>>>>>>>>
11196>>>>>>>>>        Property String psSQLRefreshToken ""                           
11197>>>>>>>>>
11197>>>>>>>>>    End_Procedure
11198>>>>>>>>>
11198>>>>>>>>>    Procedure GetAccessToken
11200>>>>>>>>>       
11200>>>>>>>>>        // Call the get accesstoken function here        
11200>>>>>>>>>    End_Procedure
11201>>>>>>>>>    
11201>>>>>>>>>    Procedure RefreshAccessToken String sRefreshToken
11203>>>>>>>>>        
11203>>>>>>>>>        // Call the refresh accesstoken function here
11203>>>>>>>>>    End_Procedure
11204>>>>>>>>>    
11204>>>>>>>>>    // Procedure to initialize the token values in the driver
11204>>>>>>>>>    Procedure SQLInitTokenAccess String sDriver String sServer
11206>>>>>>>>>        Integer iVoid, iLogin
11206>>>>>>>>>        String  sAccessToken, sRefreshToken
11206>>>>>>>>>        
11206>>>>>>>>>        If (Uppercase(sDriver) = "MSSQLDRV") Begin                      
11208>>>>>>>>>            Move "" to sAccessToken
11209>>>>>>>>>            Move "" to sRefreshToken
11210>>>>>>>>>            Get pbSQLTokenLogin to iLogin
11211>>>>>>>>>                    
11211>>>>>>>>>            Call_Driver 0 sDriver Function FUNC_SQLTOKENLOGIN ;                Callback Self ;                Passing sAccessToken sRefreshToken iLogin ;                Result iVoid
11216>>>>>>>>>        End               
11216>>>>>>>>>>
11216>>>>>>>>>    End_Procedure
11217>>>>>>>>>    
11217>>>>>>>>>    // Procedure to update the token values in the driver
11217>>>>>>>>>    Procedure SQLUpdateAccessTokens
11219>>>>>>>>>        Integer iVoid, iLogin
11219>>>>>>>>>        String  sAccessToken, sRefreshToken
11219>>>>>>>>>                         
11219>>>>>>>>>        Get psSQLAccessToken to sAccessToken
11220>>>>>>>>>        Get psSQLRefreshToken to sRefreshToken
11221>>>>>>>>>        Get pbSQLTokenLogin to iLogin
11222>>>>>>>>>                
11222>>>>>>>>>        Call_Driver 0 "MSSQLDRV" Function FUNC_SQLTOKENLOGIN ;            Callback Self ;            Passing sAccessToken sRefreshToken iLogin ;            Result iVoid               
11227>>>>>>>>>    End_Procedure    
11228>>>>>>>>>
11228>>>>>>>>>    // Callback function from the driver for accesstoken login, refresh and error
11228>>>>>>>>>    Function Callback String CallbackMessage Integer CallbackType Returns Integer
11230>>>>>>>>>        Integer iResult
11230>>>>>>>>>        
11230>>>>>>>>>        Move False to iResult
11231>>>>>>>>>     
11231>>>>>>>>>        If (CallbackType = DF_MESSAGE_SQL_TOKEN_LOGIN) Begin
11233>>>>>>>>>            Send SQLGetAccessToken
11234>>>>>>>>>        End
11234>>>>>>>>>>
11234>>>>>>>>>        Else If (CallbackType = DF_MESSAGE_SQL_TOKEN_REFRESH) Begin
11237>>>>>>>>>            Send SQLRefreshAccessToken CallbackMessage
11238>>>>>>>>>        End
11238>>>>>>>>>>
11238>>>>>>>>>        Else If (CallbackType = DF_MESSAGE_ERROR) Begin
11241>>>>>>>>>            Send SQLAccessTokenError CallbackMessage
11242>>>>>>>>>        End
11242>>>>>>>>>>
11242>>>>>>>>>                 
11242>>>>>>>>>        Function_Return iResult
11243>>>>>>>>>    End_Function
11244>>>>>>>>>    
11244>>>>>>>>>    // Procedure to get a new access and refresh token i.e. signin 
11244>>>>>>>>>    Procedure SQLGetAccessToken
11246>>>>>>>>>        String sAccessToken
11246>>>>>>>>>                         
11246>>>>>>>>>        Get psSQLAccessToken to sAccessToken        
11247>>>>>>>>>        If (sAccessToken = "") Begin
11249>>>>>>>>>            Send GetAccessToken                           
11250>>>>>>>>>        End
11250>>>>>>>>>>
11250>>>>>>>>>                
11250>>>>>>>>>        Send SQLUpdateAccessTokens        
11251>>>>>>>>>    End_Procedure
11252>>>>>>>>>    
11252>>>>>>>>>    // Procedure to refresh the tokens when access token is expired
11252>>>>>>>>>    Procedure SQLRefreshAccessToken String sRefreshToken
11254>>>>>>>>>           
11254>>>>>>>>>        Send RefreshAccessToken sRefreshToken
11255>>>>>>>>>                
11255>>>>>>>>>        Send SQLUpdateAccessTokens  
11256>>>>>>>>>    End_Procedure
11257>>>>>>>>>    
11257>>>>>>>>>    Procedure SQLAccessTokenError String sError
11259>>>>>>>>>        //Optional: Handle token errors here
11259>>>>>>>>>    End_Procedure
11260>>>>>>>>>End_Class
11261>>>>>>>
11261>>>>>>>// constants
11261>>>>>>>Define C_ConnectionId for "DFCONNID=" // symbol used in INT/SERVER for connection Id
11261>>>>>>>Define C_ConnectionIdCmdLineName for "dfconnid=" // left side of name used in command line argument for dfconnid.ini file
11261>>>>>>>Define C_ConnectionIniFileName for "DFConnId.ini" // default name of connections INI file.
11261>>>>>>>Define C_ConnectionIniSectionBaseName for "connection" // normally assumes a suffix like connection1, conneciton 2, etc.
11261>>>>>>>Define C_ConnectionIniSectionId for "id" // Name of connection id
11261>>>>>>>Define C_ConnectionIniSectionDriver for "driver" // left side of [id] section for driver
11261>>>>>>>Define C_ConnectionIniSectionConnection for "connection" // left side of [id] section for connection
11261>>>>>>>Define C_ConnectionIniSectionUID for "UID"
11261>>>>>>>Define C_ConnectionIniSectionPWD for "PWD"
11261>>>>>>>Define C_ConnectionIniSectionTrusted for "trusted_connection"
11261>>>>>>>Define C_ConnectionIniSectionDisabled for "disabled"
11261>>>>>>>
11261>>>>>>>// connection ID information
11261>>>>>>>Struct tConnection
11261>>>>>>>    String sId                // connection id
11261>>>>>>>    String sString            // server-string as added via the ini file
11261>>>>>>>    String sUID               // User Id
11261>>>>>>>    String sPWD               // non-encrypted password
11261>>>>>>>    Boolean bTrustedConnection // Trusted connection
11261>>>>>>>    Integer iOptions          // connection ID options (don't use)
11261>>>>>>>    String sDriver            // name of driver
11261>>>>>>>    Integer iDriverIndex      // loaded driver index (is 1 based, 0 if none)
11261>>>>>>>    String sConnectionString  // Full connection string assembled from various strings
11261>>>>>>>    String sSection           // this is usually the section name as it appears
11261>>>>>>>    // in the connections ini file (e.g., [Connection1])
11261>>>>>>>    Boolean bDisabled         // if set, this is not an active Id
11261>>>>>>>    Handle  hTokenProvider    // Handle to the token provider
11261>>>>>>>End_Struct
11261>>>>>>>
11261>>>>>>>// used to search loaded (registered) drivers to find CLI connection handle
11261>>>>>>>Struct tDriverCLIDictionary
11261>>>>>>>    String sDriver // registered driver name
11261>>>>>>>    Handle hoCLI   // CLI handle of object created when driver was loaded
11261>>>>>>>End_Struct
11261>>>>>>>
11261>>>>>>>// privately used to write INI sections
11261>>>>>>>Struct tConnectionIniSection
11261>>>>>>>    String sSection // section INI name. Should be unique
11261>>>>>>>    String[] Keys
11261>>>>>>>    String[] Values
11261>>>>>>>End_Struct
11261>>>>>>>
11261>>>>>>>// token connection information
11261>>>>>>>Struct tTokenConnection
11261>>>>>>>    String sConnectionID
11261>>>>>>>    String sTokenConnectionID
11261>>>>>>>    Handle hTokenProvider
11261>>>>>>>End_Struct
11261>>>>>>>
11261>>>>>>>// searches tConnection by case insensitive ID
11261>>>>>>>Function ComparetConnectionById Desktop tConnection C1 tConnection C2 Returns Integer
11263>>>>>>>    String sId1 sId2
11263>>>>>>>    Move (Uppercase(C1.sId)) to sId1
11264>>>>>>>    Move (Uppercase(C2.sId)) to sId2
11265>>>>>>>    If (sId1>sId2) Begin
11267>>>>>>>        Function_Return (GT)
11268>>>>>>>    End
11268>>>>>>>>
11268>>>>>>>    Else If (sId1<sId2) Begin
11271>>>>>>>        Function_Return (LT)
11272>>>>>>>    End
11272>>>>>>>>
11272>>>>>>>    Function_Return (EQ)
11273>>>>>>>End_Function
11274>>>>>>>
11274>>>>>>>Class cConnection is a cObject
11275>>>>>>>    
11275>>>>>>>    Procedure Construct_Object
11277>>>>>>>        Forward Send Construct_Object
11279>>>>>>>        
11279>>>>>>>        // if you want to do this all manually set this False
11279>>>>>>>        Property Boolean pbUseConnectionIni True
11280>>>>>>>        
11280>>>>>>>        // when using managed logins, login again if already logged in?
11280>>>>>>>        Property Boolean pbSkipDuplicateLogin True
11281>>>>>>>        
11281>>>>>>>        // can be set to false, to require a login before an open. This gets
11281>>>>>>>        // set when the driver is registered.
11281>>>>>>>        Property Boolean private_pbLoginOnOpen True
11282>>>>>>>        
11282>>>>>>>        // name of connections ini file. Only set this if you want to override
11282>>>>>>>        // the normal mechanism of getting a name.
11282>>>>>>>        Property String psConnectionIni ""
11283>>>>>>>        
11283>>>>>>>        // as a scurity precaution this can be disabled so someone cannot run a
11283>>>>>>>        // cmdline option that redirects to a different database
11283>>>>>>>        Property Boolean pbCmdLineIniAllowed True
11284>>>>>>>        
11284>>>>>>>        // normally this is dfconnid="name" but it can be customized in the case where
11284>>>>>>>        // an application would have a conflict with this.
11284>>>>>>>        Property String psConnectionIdCmdLine C_ConnectionIdCmdLineName
11285>>>>>>>        
11285>>>>>>>        // determines AutoConnect behavior (usually sent by cApplication after workspace
11285>>>>>>>        // is opened. Default is to RegisterAll and LoginAll and abort if error). If set
11285>>>>>>>        // false, nothing happens.
11285>>>>>>>        Property Boolean pbAutoConnect True
11286>>>>>>>        
11286>>>>>>>        // is a login dialog used? If so, it must be created and registered in ghoLoginConnectDialog
11286>>>>>>>        Property Boolean pbLoginDialogRequired True
11287>>>>>>>        
11287>>>>>>>        // is encryption used? If so, it must be created and registered in ghoLoginEncryption
11287>>>>>>>        Property Boolean pbEncryptPassword True
11288>>>>>>>        
11288>>>>>>>        // class to use for driver connection objects. Advanced use for sub-classing
11288>>>>>>>        Property Handle phcDriverConnection (RefClass(cCLIHandler))
11289>>>>>>>        
11289>>>>>>>        // can be used by error trapping / handling
11289>>>>>>>        Property Integer piErrorNumber
11290>>>>>>>        Property Integer piErrorLine
11291>>>>>>>        Property String psErrorText
11292>>>>>>>        Property Handle phoOldError
11293>>>>>>>        
11293>>>>>>>        Property tDriverCLIDictionary[] pRegisteredDriversDict
11294>>>>>>>        
11294>>>>>>>        Property tConnection[] pConnections
11295>>>>>>>
11295>>>>>>>        // application name that is passed in the connectionstring (APP=)
11295>>>>>>>        // if empty, will be set to the program name
11295>>>>>>>        Property String psConnectionAppName ""
11296>>>>>>>        
11296>>>>>>>        Property tTokenConnection[] pTokenConnections
11297>>>>>>>        
11297>>>>>>>        Move Self to ghoConnection
11298>>>>>>>        
11298>>>>>>>    End_Procedure
11299>>>>>>>    
11299>>>>>>>    // error trapping for this object
11299>>>>>>>    Procedure Error_Report Integer iErrorNumber Integer iErrorLine String sErrorText
11301>>>>>>>        Set piErrorLine to iErrorLine
11302>>>>>>>        Set piErrorNumber to iErrorNumber
11303>>>>>>>        Set psErrorText to sErrorText
11304>>>>>>>    End_Procedure
11305>>>>>>>    
11305>>>>>>>    Procedure TrapErrors
11307>>>>>>>        If (Error_Object_Id = Self) Begin
11309>>>>>>>            Error DFERR_PROGRAM "ASSERT: cConnection: TrapErrors called twice!"
11310>>>>>>>>
11310>>>>>>>            Procedure_Return
11311>>>>>>>        End
11311>>>>>>>>
11311>>>>>>>        Set phoOldError to Error_Object_Id
11312>>>>>>>        Set piErrorNumber to 0
11313>>>>>>>        Move Self to Error_Object_Id
11314>>>>>>>    End_Procedure
11315>>>>>>>    
11315>>>>>>>    Procedure UnTrapErrors
11317>>>>>>>        Get phoOldError to Error_Object_Id
11318>>>>>>>    End_Procedure
11319>>>>>>>    
11319>>>>>>>    // reports a connection configuration error as a handled user error

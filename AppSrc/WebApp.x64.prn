12950>>>>>>>    
12950>>>>>>>    // return an object that is the parent of the current node
12950>>>>>>>    Function ParentNode Returns Handle
12952>>>>>>>        Handle hoId
12952>>>>>>>        Handle hinfcXMLInterface
12952>>>>>>>        Get phParentNode to hinfcXMLInterface
12953>>>>>>>        If (hinfcXMLInterface) ;            Get CreateXmlNode hinfcXMLInterface to hoID
12956>>>>>>>        Function_Return hoID
12957>>>>>>>    End_Function
12958>>>>>>>    
12958>>>>>>>    // Same as NextSibling except it uses or destroys the current node
12958>>>>>>>    //
12958>>>>>>>    // optimized version does not destroy/create object unless it needs to.
12958>>>>>>>    // if the next node is the same node type we will resuse this object
12958>>>>>>>    // else this object is destroyed
12958>>>>>>>    Function NextNode Returns Handle
12960>>>>>>>        Handle hoNode hoDocument
12960>>>>>>>        Handle hInfc
12960>>>>>>>        Get phNextSibling to hInfc
12961>>>>>>>        If hInfc Begin
12963>>>>>>>            Get DocumentObject to hoDocument
12964>>>>>>>            Move Self to hoNode
12965>>>>>>>            Send BindXMLInfc of hoDocument hInfc (&hoNode)
12966>>>>>>>        End
12966>>>>>>>>
12966>>>>>>>        Else Begin
12967>>>>>>>            Send Destroy
12968>>>>>>>            Move 0 to hoNode
12969>>>>>>>        End
12969>>>>>>>>
12969>>>>>>>        Function_Return hoNode
12970>>>>>>>    End_Function
12971>>>>>>>    
12971>>>>>>>    
12971>>>>>>>    // Enumerate through all nodes.
12971>>>>>>>    
12971>>>>>>>    Procedure EnumerateNodes Integer iMsg Handle hoReceiver String sVal1 String sVal2
12973>>>>>>>        Integer i iLen
12973>>>>>>>        Handle hoNode
12973>>>>>>>        Handle hoNodeCollection
12973>>>>>>>        Get ChildNodes to hoNodeCollection
12974>>>>>>>        If (hoNodeCollection <> 0) Begin
12976>>>>>>>            Get NodeListLength of hoNodeCollection to iLen
12977>>>>>>>            Decrement iLen
12978>>>>>>>            For i from 0 to iLen
12984>>>>>>>>
12984>>>>>>>                // For each record, process its fields.
12984>>>>>>>                Get CollectionNode of hoNodeCollection i to hoNode
12985>>>>>>>                Send iMsg of hoReceiver hoNode sVal1 sVal2
12986>>>>>>>                Send Destroy of hoNode
12987>>>>>>>            Loop
12988>>>>>>>>
12988>>>>>>>            Send Destroy of hoNodeCollection
12989>>>>>>>        End
12989>>>>>>>>
12989>>>>>>>    End_Procedure
12990>>>>>>>    
12990>>>>>>>    // Enumerate through all elements.
12990>>>>>>>    
12990>>>>>>>    Procedure EnumerateElements Integer iMsg Handle hoReceiver String sVal1 String sVal2
12992>>>>>>>        Integer i iLen
12992>>>>>>>        Handle hoNode
12992>>>>>>>        Handle hoNodeCollection
12992>>>>>>>        Get ChildNodes to hoNodeCollection
12993>>>>>>>        If (hoNodeCollection <> 0) Begin
12995>>>>>>>            Get NodeListLength of hoNodeCollection to iLen
12996>>>>>>>            Decrement iLen
12997>>>>>>>            For i from 0 to iLen
13003>>>>>>>>
13003>>>>>>>                // For each record, process its fields.
13003>>>>>>>                Get CollectionNode of hoNodeCollection i to hoNode
13004>>>>>>>                If (piNodeType(hoNode)=NODE_ELEMENT) ;                    Send iMsg of hoReceiver hoNode sVal1 sVal2
13007>>>>>>>                Send Destroy of hoNode
13008>>>>>>>            Loop
13009>>>>>>>>
13009>>>>>>>            Send Destroy of hoNodeCollection
13010>>>>>>>        End
13010>>>>>>>>
13010>>>>>>>    End_Procedure
13011>>>>>>>    
13011>>>>>>>    
13011>>>>>>>    // enumerate through all attributes. There is no recurse here because attributes will not
13011>>>>>>>    // contain attributes.
13011>>>>>>>    
13011>>>>>>>    Procedure EnumerateAttributes Integer iMsg Handle hoReceiver String sSomeValue
13013>>>>>>>        Integer i iLen
13013>>>>>>>        Handle hoNode
13013>>>>>>>        Handle hoNodeMapCollection
13013>>>>>>>        // we don't use tempattributenodes because we don't know what the enum message will do.
13013>>>>>>>        Get AttributeNodes to hoNodeMapCollection
13014>>>>>>>        If (hoNodeMapCollection <> 0) Begin
13016>>>>>>>            Get NodeListLength of hoNodeMapCollection to iLen
13017>>>>>>>            Decrement iLen
13018>>>>>>>            For i from 0 to iLen
13024>>>>>>>>
13024>>>>>>>                // For each record, process its fields.
13024>>>>>>>                Get CollectionNode of hoNodeMapCollection i to hoNode
13025>>>>>>>                Send iMsg of hoReceiver hoNode sSomeValue
13026>>>>>>>                Send Destroy of hoNode
13027>>>>>>>            Loop
13028>>>>>>>>
13028>>>>>>>            Send Destroy of hoNodeMapCollection
13029>>>>>>>        End
13029>>>>>>>>
13029>>>>>>>    End_Procedure
13030>>>>>>>    
13030>>>>>>>    
13030>>>>>>>    Function XSLTransformation Handle hoXSLDocument Returns String
13032>>>>>>>        Handle infcXSLStartAt
13032>>>>>>>        String sBuffer
13032>>>>>>>        // Transformation is of current object using passed XSLDocument.
13032>>>>>>>        Get XMLInterface of hoXSLDocument to infcXSLStartAt
13033>>>>>>>        Get TransformNode infcXSLStartAt to sBuffer
13034>>>>>>>        Function_Return sBuffer
13035>>>>>>>    End_Function
13036>>>>>>>    
13036>>>>>>>    // This allows for transformations not limited to the size of the string buffer
13036>>>>>>>    //
13036>>>>>>>    // Note that it is up to the programmer to dispose of the memory allocated at pBuffer
13036>>>>>>>    // by using the free(pBuffer) function
13036>>>>>>>    //
13036>>>>>>>    Function XSLTransformationToAddress Handle hoXSLDocument Returns Pointer
13038>>>>>>>        Handle infcXSLStartAt
13038>>>>>>>        Pointer pBuffer
13038>>>>>>>        // Transformation is of current object using passed XSLDocument.
13038>>>>>>>        Get XMLInterface of hoXSLDocument to infcXSLStartAt
13039>>>>>>>        Get TransformNodeToAddress infcXSLStartAt to pBuffer
13040>>>>>>>        Function_Return pBuffer
13041>>>>>>>    End_Function
13042>>>>>>>    
13042>>>>>>>    
13042>>>>>>>    // extract base name from string. e.g.: ns:name --> name
13042>>>>>>>    //
13042>>>>>>>    Function BaseNameFromQName String sName Returns String
13044>>>>>>>        Integer iPos
13044>>>>>>>        Move (Pos(":",sName)) to iPos
13045>>>>>>>        If iPos Begin
13047>>>>>>>            Move (remove(sName,1,iPos)) to sName
13048>>>>>>>        End
13048>>>>>>>>
13048>>>>>>>        Function_Return sName
13049>>>>>>>    End_Function
13050>>>>>>>    
13050>>>>>>>    // extract prefix name from string. e.g.: ns:name --> ns
13050>>>>>>>    //
13050>>>>>>>    Function PrefixNameFromQName String sName Returns String
13052>>>>>>>        String sPreFix
13052>>>>>>>        Integer iPos
13052>>>>>>>        Move (Pos(":",sName)) to iPos
13053>>>>>>>        If iPos Begin
13055>>>>>>>            Move (Left(sName,iPos-1)) to sPreFix
13056>>>>>>>        End
13056>>>>>>>>
13056>>>>>>>        Function_Return sPreFix
13057>>>>>>>    End_Function
13058>>>>>>>    
13058>>>>>>>    
13058>>>>>>>    // Returns true if node is element and namespace and base name match
13058>>>>>>>    //
13058>>>>>>>    Function IsElementNS String sNamespaceURI String sBaseName Returns Boolean
13060>>>>>>>        Function_Return (piNodeType(Self)=NODE_ELEMENT and ;            psNameSpaceURI(Self)=sNamespaceURI and ;            psBaseName(Self)=sBaseName )
13061>>>>>>>    End_Function
13062>>>>>>>    
13062>>>>>>>    // Returns node of first occurence of child node matching namespace and base name
13062>>>>>>>    //
13062>>>>>>>    Function ChildElementNS String sNameSpaceURI String sBaseName Returns Handle
13064>>>>>>>        Handle hoNode
13064>>>>>>>        Get FirstChild to hoNode
13065>>>>>>>        While (hoNode and not(IsElementNS(hoNode, sNameSpaceURI, sBaseName)))
13069>>>>>>>            Get NextNode of hoNode to hoNode
13070>>>>>>>        Loop
13071>>>>>>>>
13071>>>>>>>        Function_Return hoNode
13072>>>>>>>    End_Function
13073>>>>>>>    
13073>>>>>>>    Function NextElementNS String sNameSpaceURI String sBaseName Returns Handle
13075>>>>>>>        Handle hoNode
13075>>>>>>>        // NextNode may return the same object or it may destroy the object and
13075>>>>>>>        // return nothing or a different object
13075>>>>>>>        Get NextNode to hoNode
13076>>>>>>>        While (hoNode and not(IsElementNS(hoNode, sNameSpaceURI, sBaseName)))
13080>>>>>>>            // use of hoNode is required. This can be different than self
13080>>>>>>>            Get NextNode of hoNode to hoNode
13081>>>>>>>        Loop
13082>>>>>>>>
13082>>>>>>>        
13082>>>>>>>        Function_Return hoNode
13083>>>>>>>    End_Function
13084>>>>>>>    
13084>>>>>>>    
13084>>>>>>>    // Returns value (string) first occurence of child node matching namespace and base name
13084>>>>>>>    //
13084>>>>>>>    Function ChildElementValueNS String sNameSpaceURI String sBaseName Returns String
13086>>>>>>>        Handle hoNext
13086>>>>>>>        String sText
13086>>>>>>>        Get ChildElementNS sNameSpaceURI sBaseName to hoNext
13087>>>>>>>        If hoNext Begin
13089>>>>>>>            Get psText of hoNext to sText
13090>>>>>>>            Send destroy of hoNext
13091>>>>>>>        End
13091>>>>>>>>
13091>>>>>>>        Function_Return sText
13092>>>>>>>    End_Function
13093>>>>>>>    
13093>>>>>>>    Procedure SetChildElementValueNS String sNameSpaceURI String sBaseName String sValue
13095>>>>>>>        Handle hoNode
13095>>>>>>>        Handle hinfcTempNode
13095>>>>>>>        Get ChildElementNS sNameSpaceURI sBaseName to hoNode
13096>>>>>>>        If (hoNode=0) Begin
13098>>>>>>>            Send AddElementNS sNameSpaceURI sBaseName sValue
13099>>>>>>>        End
13099>>>>>>>>
13099>>>>>>>        Else Begin
13100>>>>>>>            Set psText of hoNode to sValue
13101>>>>>>>            Send destroy of hoNode
13102>>>>>>>        End
13102>>>>>>>>
13102>>>>>>>    End_Procedure
13103>>>>>>>    
13103>>>>>>>    // pass a prefix and try to finds its NameSpaceURI. Start at current node and work up to parent.
13103>>>>>>>    // This can be useful when a qualified name is found in an attribute value
13103>>>>>>>    //
13103>>>>>>>    Function PrefixToNamespaceURI String sPrefix Returns String
13105>>>>>>>        Handle hoNode
13105>>>>>>>        Integer i iNodes
13105>>>>>>>        Handle hoNodes hoParentNode hoAttNode
13105>>>>>>>        Boolean bDone bParent
13105>>>>>>>        String sAttPrefix sName sNameSpace
13105>>>>>>>        
13105>>>>>>>        Move Self to hoNode
13106>>>>>>>        While not bDone
13110>>>>>>>            Get TempAttributeNodes of hoNode to hoNodes
13111>>>>>>>            If (hoNodes <> 0) Begin
13113>>>>>>>                Get NodeListLength of hoNodes to iNodes
13114>>>>>>>                For i from 0 to (iNodes-1)
13120>>>>>>>>
13120>>>>>>>                    // For each record, process its fields.
13120>>>>>>>                    Get CollectionNode of hoNodes i to hoAttNode
13121>>>>>>>                    Get psPrefix of hoAttNode to sAttPrefix
13122>>>>>>>                    Get psBaseName of hoAttNode to sName
13123>>>>>>>                    // with legacy msxml, xmlns="foo" returns psPrefix="xmlns" and pbBaseName=""
13123>>>>>>>                    // with newer msxml, xmlns="foo" returns psPrefix="" and pbBaseName="xmlns"
13123>>>>>>>                    // We handle both cases here.
13123>>>>>>>                    
13123>>>>>>>                    If ( (sAttPrefix="xmlns" and sName=sPrefix) or ; // if a normal xmlns:xx="foo" match (sPrefix="xx") or a legacy xmlns="foo" match (sPrefix="")                        (sPrefix="" and sAttPrefix="" and sName="xmlns") ) Begin // special test for newer msxml xmlns="foo" match (sPrefix="")
13125>>>>>>>                        
13125>>>>>>>                        Get Value of hoAttNode to sNameSpace
13126>>>>>>>                        Move True to bDone
13127>>>>>>>                        Move (iNodes-1) to i
13128>>>>>>>                        
13128>>>>>>>                    End
13128>>>>>>>>
13128>>>>>>>                    
13128>>>>>>>                    Send Destroy of hoAttNode
13129>>>>>>>                Loop
13130>>>>>>>>
13130>>>>>>>                Set XMLInterface of hoNodes to 0
13131>>>>>>>            End
13131>>>>>>>>
13131>>>>>>>            
13131>>>>>>>            Get ParentNode of hoNode to hoParentNode
13132>>>>>>>            If bParent ;                Send destroy of hoNode
13135>>>>>>>            If not bDone Begin
13137>>>>>>>                If not hoParentNode ;                    Move True to bDone
13140>>>>>>>                Else Begin
13141>>>>>>>                    Move True to bParent
13142>>>>>>>                    Move hoParentNode to hoNode
13143>>>>>>>                End
13143>>>>>>>>
13143>>>>>>>            End
13143>>>>>>>>
13143>>>>>>>        Loop
13144>>>>>>>>
13144>>>>>>>        Function_Return sNameSpace
13145>>>>>>>    End_Function
13146>>>>>>>    
13146>>>>>>>    
13146>>>>>>>    
13146>>>>>>>End_Class

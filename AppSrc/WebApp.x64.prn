7314>>>>>>>>>>>        
7314>>>>>>>>>>>        Send ClearData
7315>>>>>>>>>>>        Get private_psFileName to sFileName
7316>>>>>>>>>>>        
7316>>>>>>>>>>>        //  Checks
7316>>>>>>>>>>>        If (Trim(sFileName)="") Begin
7318>>>>>>>>>>>            Error DFERR_INI_FILE "Ini file name not defined"
7319>>>>>>>>>>>>
7319>>>>>>>>>>>            Function_Return False
7320>>>>>>>>>>>        End
7320>>>>>>>>>>>>
7320>>>>>>>>>>>        
7320>>>>>>>>>>>        File_Exist sFileName bExists
7321>>>>>>>>>>>        If (not(bExists)) Begin
7323>>>>>>>>>>>            If (pbReportReadErrors(Self)) ;                Error DFERR_INI_FILE "Could not open file for reading, file does not exist."
7326>>>>>>>>>>>            Function_Return False
7327>>>>>>>>>>>        End
7327>>>>>>>>>>>>
7327>>>>>>>>>>>        
7327>>>>>>>>>>>        //  Read the file
7327>>>>>>>>>>>        Get Seq_New_Channel to iChnl
7328>>>>>>>>>>>        If (iChnl = DF_SEQ_CHANNEL_NOT_AVAILABLE) Begin
7330>>>>>>>>>>>            If (pbReportReadErrors(Self)) ;                Error DFERR_INI_FILE "Could not open file, no channel available."
7333>>>>>>>>>>>            Function_Return False
7334>>>>>>>>>>>        End
7334>>>>>>>>>>>>
7334>>>>>>>>>>>                
7334>>>>>>>>>>>        Direct_Input channel iChnl sFileName
7336>>>>>>>>>>>        

38738>>>>>>>        
38738>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
38739>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
38740>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
38743>>>>>>>        
38743>>>>>>>        Case Begin
38743>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
38745>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
38746>>>>>>>                Move True to bRequireTimeCost
38747>>>>>>>                Case Break
38748>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
38751>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
38752>>>>>>>                Move True to bRequireTimeCost
38753>>>>>>>                Case Break
38754>>>>>>>            Case Else
38754>>>>>>>                Error 8710 "Invalid algorithm selected."
38755>>>>>>>>
38755>>>>>>>                Function_Return 0
38756>>>>>>>        Case End
38756>>>>>>>        
38756>>>>>>>        // calculate base64 in a non-floating-manner
38756>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
38757>>>>>>>        
38757>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
38758>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
38759>>>>>>>        If (bRequireTimeCost) Begin
38761>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
38762>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
38763>>>>>>>        End
38763>>>>>>>>
38763>>>>>>>        Else Begin
38764>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
38765>>>>>>>        End
38765>>>>>>>>
38765>>>>>>>        
38765>>>>>>>        Function_Return ullSize
38766>>>>>>>    End_Function
38767>>>>>>>End_Class

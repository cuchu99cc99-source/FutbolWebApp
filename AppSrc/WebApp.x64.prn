16565>>>>>>>>>>>    
16565>>>>>>>>>>>    // Adds a client action to the array of client actions that is returned to the client. The 
16565>>>>>>>>>>>    // action will address this web object on the client.
16565>>>>>>>>>>>    // Interface for requesting a client side action to be sent back in the CallAction response.
16565>>>>>>>>>>>    // sName        - Name of the method to call on client
16565>>>>>>>>>>>    // aParams      - [optional] Parameters to pass to the client method
16565>>>>>>>>>>>    // vActionData  - [optional] Additional struct with action data sent to the client. This can be
16565>>>>>>>>>>>    //              any struct that is serializable to JSON using DataTypeToJson.
16565>>>>>>>>>>>    Procedure ClientAction String sName String[] aOptParams Variant vActionData
16567>>>>>>>>>>>        Handle hoJsonObj
16567>>>>>>>>>>>        
16567>>>>>>>>>>>        If (num_arguments > 2) Begin
16569>>>>>>>>>>>            Get Create (RefClass(cJsonObject)) to hoJsonObj
16570>>>>>>>>>>>            Send DataTypeToJson of hoJsonObj vActionData
16571>>>>>>>>>>>            
16571>>>>>>>>>>>            Send ClientActionEx sName aOptParams hoJsonObj
16572>>>>>>>>>>>            Send Destroy of hoJsonObj    
16573>>>>>>>>>>>        End
16573>>>>>>>>>>>>
16573>>>>>>>>>>>        Else If (num_arguments > 1) Begin
16576>>>>>>>>>>>            Send ClientActionEx sName aOptParams
16577>>>>>>>>>>>        End
16577>>>>>>>>>>>>
16577>>>>>>>>>>>        Else Begin
16578>>>>>>>>>>>            Send ClientActionEx sName
16579>>>>>>>>>>>        End
16579>>>>>>>>>>>>
16579>>>>>>>>>>>    End_Procedure
16580>>>>>>>>>>>    
16580>>>>>>>>>>>    // Adds a client action to the array of client actions that is returned to the client. The 
16580>>>>>>>>>>>    // action will address this web object on the client.
16580>>>>>>>>>>>    // Interface for requesting a client side action to be sent back in the CallAction response.
16580>>>>>>>>>>>    // sName        - Name of the method to call on client
16580>>>>>>>>>>>    // aParams      - [optional] Parameters to pass to the client method
16580>>>>>>>>>>>    // vActionData  - [optional] Additional struct with action data sent to the client. This can be
16580>>>>>>>>>>>    //              any struct that is serializable to JSON using DataTypeToJson.
16580>>>>>>>>>>>    Procedure ClientActionEarly String sName String[] aOptParams Handle hjActionData
16582>>>>>>>>>>>        tWebClientAction tClientAction
16582>>>>>>>>>>>        tWebClientAction tClientAction
16582>>>>>>>>>>>        
16582>>>>>>>>>>>        Move ctExecEarly to tClientAction.eType
16583>>>>>>>>>>>        
16583>>>>>>>>>>>        Move sName   to tClientAction.sName
16584>>>>>>>>>>>        Get WebObjectName to tClientAction.sTarget
16585>>>>>>>>>>>        
16585>>>>>>>>>>>        If (num_arguments > 1) Begin
16587>>>>>>>>>>>            Move aOptParams to tClientAction.aParams
16588>>>>>>>>>>>        End
16588>>>>>>>>>>>>
16588>>>>>>>>>>>        
16588>>>>>>>>>>>        Move 0 to tClientAction.iAttached
16589>>>>>>>>>>>        If (num_arguments > 2) Begin
16591>>>>>>>>>>>            Get AddResponseAttachment of (Host(Self)) hjActionData to tClientAction.iAttached
16592>>>>>>>>>>>        End
16592>>>>>>>>>>>>
16592>>>>>>>>>>>
16592>>>>>>>>>>>        Send AddClientAction of (Owner(Self)) tClientAction
16593>>>>>>>>>>>    End_Procedure
16594>>>>>>>>>>>    
16594>>>>>>>>>>>    // Extended ClientAction API. Adds a client action to the response that will be executed on the
16594>>>>>>>>>>>    // client. A client action executes a JavaScript function on a specific object. If no object
16594>>>>>>>>>>>    // (window. or this.) is specified it will be executed on the JavaScript object presentation of
16594>>>>>>>>>>>    // this web object. Client actions are asynchronous!
16594>>>>>>>>>>>    // sName        - Name of the method to call on the client (can contain object specification
16594>>>>>>>>>>>    //              like this. or window.)
16594>>>>>>>>>>>    // aParams      - [optional] Parameters to pass to the client method
16594>>>>>>>>>>>    // hoOptJsonAttachment  - Handle to a cJsonObject that is sent as attachment and will be 
16594>>>>>>>>>>>    //                      available as _tActionData on the client during the ClientAction.
16594>>>>>>>>>>>    Procedure ClientActionEx String sName String[] aOptParams Handle hoOptJsonAttachment
16596>>>>>>>>>>>        tWebClientAction tClientAction
16596>>>>>>>>>>>        tWebClientAction tClientAction
16596>>>>>>>>>>>        
16596>>>>>>>>>>>        If (pbGhost(Self)) ;            Procedure_Return
16599>>>>>>>>>>>        Get OwnerActionState of (Owner(Self)) Self to tClientAction.eType
16600>>>>>>>>>>>        
16600>>>>>>>>>>>        Move sName   to tClientAction.sName
16601>>>>>>>>>>>        Get WebObjectName to tClientAction.sTarget
16602>>>>>>>>>>>        
16602>>>>>>>>>>>        If (num_arguments > 1) Begin
16604>>>>>>>>>>>            Move aOptParams to tClientAction.aParams
16605>>>>>>>>>>>        End
16605>>>>>>>>>>>>
16605>>>>>>>>>>>        
16605>>>>>>>>>>>        Move 0 to tClientAction.iAttached
16606>>>>>>>>>>>        If (num_arguments > 2) Begin
16608>>>>>>>>>>>            Get AddResponseAttachment of (Host(Self)) hoOptJsonAttachment to tClientAction.iAttached
16609>>>>>>>>>>>        End
16609>>>>>>>>>>>>
16609>>>>>>>>>>>
16609>>>>>>>>>>>        Send AddClientAction of (Owner(Self)) tClientAction
16610>>>>>>>>>>>    End_Procedure
16611>>>>>>>>>>>    
16611>>>>>>>>>>>    // This procedure cancels all client actions with the specified name for this object. In some 
16611>>>>>>>>>>>    // cases only the last client action really makes sense for the component. An example is a 
16611>>>>>>>>>>>    // gridRefresh where sending multiple refreshes immediately after each other are just 
16611>>>>>>>>>>>    // inefficient.
16611>>>>>>>>>>>    // sName - Name of the method to call on client
16611>>>>>>>>>>>    Procedure CancelClientAction String sName
16613>>>>>>>>>>>        If (pbGhost(Self)) ;            Procedure_Return
16616>>>>>>>>>>>        Send OwnerCancelClientAction of (Owner(Self)) Self sName
16617>>>>>>>>>>>    End_Procedure
16618>>>>>>>>>>>    
16618>>>>>>>>>>>    /*    Converts a web property value from the unlocalized string format into the proper format, before    returning it as a string which will then be in the localized format.    */
16618>>>>>>>>>>>    Function ConvertFromTransport Handle hmGetter String sValue Integer eType Returns String
16620>>>>>>>>>>>        Date dateVal
16620>>>>>>>>>>>        Real realVal
16620>>>>>>>>>>>        DateTime datetimeVal
16620>>>>>>>>>>>        Number numberVal
16620>>>>>>>>>>>        Time timeVal
16620>>>>>>>>>>>        Currency currencyVal
16620>>>>>>>>>>>        TimeSpan timespanVal
16620>>>>>>>>>>>        Decimal decimalVal
16620>>>>>>>>>>>        Float floatVal        
16620>>>>>>>>>>>        
16620>>>>>>>>>>>        Case Begin
16620>>>>>>>>>>>            Case (eType = cArgDate)
16622>>>>>>>>>>>                CvtLocalization Off
16623>>>>>>>>>>>                Move sValue to dateVal
16624>>>>>>>>>>>                CvtLocalization On
16625>>>>>>>>>>>                Function_Return dateVal
16626>>>>>>>>>>>            Case (eType = cArgReal)
16629>>>>>>>>>>>                CvtLocalization Off
16630>>>>>>>>>>>                Move sValue to realVal
16631>>>>>>>>>>>                CvtLocalization On
16632>>>>>>>>>>>                Function_Return realVal
16633>>>>>>>>>>>            Case (eType = cArgTime)
16636>>>>>>>>>>>                CvtLocalization Off
16637>>>>>>>>>>>                Move sValue to timeVal
16638>>>>>>>>>>>                CvtLocalization On
16639>>>>>>>>>>>                Function_Return timeVal
16640>>>>>>>>>>>            Case (eType = cArgDateTime)
16643>>>>>>>>>>>                ConvertFromXml xsDatetime sValue to datetimeVal
16644>>>>>>>>>>>                Function_Return datetimeVal
16645>>>>>>>>>>>            Case (eType = cArgFloat)
16648>>>>>>>>>>>                CvtLocalization Off
16649>>>>>>>>>>>                Move sValue to floatVal
16650>>>>>>>>>>>                CvtLocalization On
16651>>>>>>>>>>>                Function_Return floatVal
16652>>>>>>>>>>>            Case (eType = cArgNum)
16655>>>>>>>>>>>                CvtLocalization Off
16656>>>>>>>>>>>                Move sValue to numberVal
16657>>>>>>>>>>>                CvtLocalization On
16658>>>>>>>>>>>                Function_Return numberVal
16659>>>>>>>>>>>            Case (eType = cArgCurrency)
16662>>>>>>>>>>>                CvtLocalization Off
16663>>>>>>>>>>>                Move sValue to currencyVal
16664>>>>>>>>>>>                CvtLocalization On
16665>>>>>>>>>>>                Function_Return currencyVal
16666>>>>>>>>>>>            Case (eType = cArgTimeSpan)
16669>>>>>>>>>>>                CvtLocalization Off
16670>>>>>>>>>>>                Move sValue to timespanVal
16671>>>>>>>>>>>                CvtLocalization On
16672>>>>>>>>>>>                Function_Return timespanVal
16673>>>>>>>>>>>            Case (eType = cArgDecimal)
16676>>>>>>>>>>>                CvtLocalization Off
16677>>>>>>>>>>>                Move sValue to decimalVal
16678>>>>>>>>>>>                CvtLocalization On
16679>>>>>>>>>>>                Function_Return decimalVal
16680>>>>>>>>>>>            Case Else
16680>>>>>>>>>>>                Function_Return sValue
16681>>>>>>>>>>>        Case End
16681>>>>>>>>>>>    End_Function
16682>>>>>>>>>>>
16682>>>>>>>>>>>
16682>>>>>>>>>>>    /*    Converts web property values to a transportable format (string) in a fixed unlocalized format.     Do this it first makes sure the value is converted to its actual type before converting it     into a string.    */
16682>>>>>>>>>>>    Function ConvertToTransport Handle hmGetter Variant vValue Integer eType  Returns String
16684>>>>>>>>>>>        String sValue
16684>>>>>>>>>>>        Date dateVal
16684>>>>>>>>>>>        Real realVal
16684>>>>>>>>>>>        DateTime datetimeVal
16684>>>>>>>>>>>        Number numberVal
16684>>>>>>>>>>>        Time timeVal
16684>>>>>>>>>>>        Currency currencyVal
16684>>>>>>>>>>>        TimeSpan timespanVal
16684>>>>>>>>>>>        Decimal decimalVal
16684>>>>>>>>>>>        Float floatVal
16684>>>>>>>>>>>        
16684>>>>>>>>>>>        Case Begin
16684>>>>>>>>>>>            Case (eType = cArgDate)
16686>>>>>>>>>>>                Move vValue to dateVal
16687>>>>>>>>>>>                CvtLocalization Off
16688>>>>>>>>>>>                Move dateVal to sValue
16689>>>>>>>>>>>                Cvtlocalization On
16690>>>>>>>>>>>                Break
16691>>>>>>>>>>>            Case (eType = cArgReal)
16694>>>>>>>>>>>                Move vValue to realVal
16695>>>>>>>>>>>                CvtLocalization Off
16696>>>>>>>>>>>                Move realVal to sValue
16697>>>>>>>>>>>                Cvtlocalization On
16698>>>>>>>>>>>                Break
16699>>>>>>>>>>>            Case (eType = cArgTime)
16702>>>>>>>>>>>                Move vValue to timeVal
16703>>>>>>>>>>>                CvtLocalization Off
16704>>>>>>>>>>>                Move timeVal to sValue
16705>>>>>>>>>>>                Cvtlocalization On
16706>>>>>>>>>>>                Break
16707>>>>>>>>>>>            Case (eType = cArgDateTime)
16710>>>>>>>>>>>                Move vValue to datetimeVal
16711>>>>>>>>>>>                ConvertToXml xsDatetime datetimeVal to sValue
16712>>>>>>>>>>>                Break
16713>>>>>>>>>>>            Case (eType = cArgFloat)
16716>>>>>>>>>>>                Move vValue to floatVal
16717>>>>>>>>>>>                CvtLocalization Off
16718>>>>>>>>>>>                Move floatVal to sValue
16719>>>>>>>>>>>                Cvtlocalization On
16720>>>>>>>>>>>                Break
16721>>>>>>>>>>>            Case (eType = cArgNum)
16724>>>>>>>>>>>                Move vValue to numberVal
16725>>>>>>>>>>>                CvtLocalization Off
16726>>>>>>>>>>>                Move numberVal to sValue
16727>>>>>>>>>>>                CvtLocalization On
16728>>>>>>>>>>>                Break
16729>>>>>>>>>>>            Case (eType = cArgCurrency)
16732>>>>>>>>>>>                Move vValue to currencyVal
16733>>>>>>>>>>>                CvtLocalization Off
16734>>>>>>>>>>>                Move currencyVal to sValue
16735>>>>>>>>>>>                Cvtlocalization On
16736>>>>>>>>>>>                Break
16737>>>>>>>>>>>            Case (eType = cArgTimeSpan)
16740>>>>>>>>>>>                Move vValue to timespanVal
16741>>>>>>>>>>>                CvtLocalization Off
16742>>>>>>>>>>>                Move timespanVal to sValue
16743>>>>>>>>>>>                Cvtlocalization On
16744>>>>>>>>>>>                Break
16745>>>>>>>>>>>            Case (eType = cArgDecimal)
16748>>>>>>>>>>>                Move vValue to decimalVal
16749>>>>>>>>>>>                CvtLocalization Off
16750>>>>>>>>>>>                Move decimalVal to sValue
16751>>>>>>>>>>>                Cvtlocalization On
16752>>>>>>>>>>>                Break
16753>>>>>>>>>>>            Case Else
16753>>>>>>>>>>>                CvtLocalization Off
16754>>>>>>>>>>>                Move vValue to sValue
16755>>>>>>>>>>>                CvtLocalization On
16756>>>>>>>>>>>        Case End
16756>>>>>>>>>>>        
16756>>>>>>>>>>>        Function_Return sValue
16757>>>>>>>>>>>    End_Function
16758>>>>>>>>>>>
16758>>>>>>>>>>>    Function DEO_Object Returns Boolean
16760>>>>>>>>>>>        // all web objects should understand this message. Will be set True in sub-classes
16760>>>>>>>>>>>        Function_Return False
16761>>>>>>>>>>>    End_Function
16762>>>>>>>>>>>
16762>>>>>>>>>>>    
16762>>>>>>>>>>>    // Returns the addressed web property value. (see also SetSyncProp)
16762>>>>>>>>>>>    // Forwards the message to the central singleton ghoSyncPropHandler after having determined if 
16762>>>>>>>>>>>    // it is scalar or non scalar property type. This separation is made here as non scalars are 
16762>>>>>>>>>>>    // passed as variants and doing so with scalar types (especially string) will perform
16762>>>>>>>>>>>    // unnessecary conversions. The function return type is variant but when returning a string
16762>>>>>>>>>>>    // value the runtime does only convert it the return value is actually placed in a variant
16762>>>>>>>>>>>    // variable (which is very unlikely).
16762>>>>>>>>>>>    // hoObject  - Is handle to the object which ownes the property.
16762>>>>>>>>>>>    // hmSetter  - Is a handle to the property's setter message.
16762>>>>>>>>>>>    // sPropName - Is the (case sensitive) property name.
16762>>>>>>>>>>>    // Returns   - The property value as a string.
16762>>>>>>>>>>>    //
16762>>>>>>>>>>>    // Use the WebGet command instead of sending this message.
16762>>>>>>>>>>>    Function GetSyncProp Handle hoObject Handle hmSetter String sPropName Returns Variant
16764>>>>>>>>>>>        Variant vReturn
16764>>>>>>>>>>>        String sReturn sObject
16764>>>>>>>>>>>        tWebPropMetaData pubProp
16764>>>>>>>>>>>        tWebPropMetaData pubProp
16764>>>>>>>>>>>        
16764>>>>>>>>>>>        //  Find property index
16764>>>>>>>>>>>        Get FindWebPropertyMetaBySetter hmSetter to pubProp
16765>>>>>>>>>>>        
16765>>>>>>>>>>>        If (pubProp.hmGetter <= 0) Begin
16767>>>>>>>>>>>            Get Object_Label to sObject
16768>>>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppPropertyNotPublished, "WebGet", sPropName, sObject, C_NewLine+C_NewLine))        
16769>>>>>>>>>>>>
16769>>>>>>>>>>>            Function_Return
16770>>>>>>>>>>>        End
16770>>>>>>>>>>>>
16770>>>>>>>>>>>        
16770>>>>>>>>>>>        //  Switch between scalar and non-scalar (advanced) web properties
16770>>>>>>>>>>>        If (pubProp.eType = cArgArray or pubProp.eType = cArgStruct) Begin
16772>>>>>>>>>>>            Get OwnerGetAdvSyncProp of (Owner(Self)) hoObject (&pubProp) to vReturn
16773>>>>>>>>>>>            Function_Return vReturn
16774>>>>>>>>>>>        End
16774>>>>>>>>>>>>
16774>>>>>>>>>>>        Else Begin
16775>>>>>>>>>>>            Get OwnerGetSyncProp of (Owner(Self)) hoObject (&pubProp) to sReturn  
16776>>>>>>>>>>>            Function_Return sReturn // Explicitly return a string to prevent conversion (this wins from the return type, confirmed in runtime @DF20)
16777>>>>>>>>>>>        End
16777>>>>>>>>>>>>
16777>>>>>>>>>>>        
16777>>>>>>>>>>>        Function_Return sReturn
16778>>>>>>>>>>>    End_Function
16779>>>>>>>>>>>
16779>>>>>>>>>>>    
16779>>>>>>>>>>>    // This method is received by the Web Control that is the target of a CallAction that is sent
16779>>>>>>>>>>>    // from the client. The requested action must belong to the control's collection of published
16779>>>>>>>>>>>    // methods.
16779>>>>>>>>>>>    Function HandleAction String sAction String[] aParams Handle hoAttachment Returns String
16781>>>>>>>>>>>        Integer iIndex i icParameters
16781>>>>>>>>>>>        Integer eDataType
16781>>>>>>>>>>>        Boolean bAllow
16781>>>>>>>>>>>        String sReturnVal
16781>>>>>>>>>>>        Handle[] aPubMethodHandles
16782>>>>>>>>>>>        String[] aPubMethodNames
16783>>>>>>>>>>>        Boolean[] aPubMethodIsFunction
16784>>>>>>>>>>>        Boolean bInScope
16784>>>>>>>>>>>        
16784>>>>>>>>>>>        //  Security Check: Only allow actions if object is in scope!
16784>>>>>>>>>>>        Get IsInCallActionScope to bInScope
16785>>>>>>>>>>>        If (not(bInScope)) Begin
16787>>>>>>>>>>>            Error DFERR_PROGRAM (SFormat("Object '%2' being accessed by server action '%1' not in scope!", sAction, Object_Label(Self)))
16788>>>>>>>>>>>>
16788>>>>>>>>>>>            Function_Return ""
16789>>>>>>>>>>>        End
16789>>>>>>>>>>>>
16789>>>>>>>>>>>        
16789>>>>>>>>>>>        //  Get published methods
16789>>>>>>>>>>>        Get paPubMethodHandles    to aPubMethodHandles    
16790>>>>>>>>>>>        Get paPubMethodNames      to aPubMethodNames      
16791>>>>>>>>>>>        Get paPubMethodIsFunction to aPubMethodIsFunction
16792>>>>>>>>>>>        
16792>>>>>>>>>>>        // Lookup the passed action....
16792>>>>>>>>>>>        Move (SearchArray(Uppercase(sAction), aPubMethodNames)) to iIndex
16793>>>>>>>>>>>        
16793>>>>>>>>>>>        If (iIndex = -1) Begin
16795>>>>>>>>>>>            // Unregistered methods cannot be called by client (security)
16795>>>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppMethodNotPublished, sAction, Object_Label(Self)))
16796>>>>>>>>>>>>
16796>>>>>>>>>>>        End
16796>>>>>>>>>>>>
16796>>>>>>>>>>>        Else Begin            
16797>>>>>>>>>>>            //  Perform security check
16797>>>>>>>>>>>            Move True to bAllow
16798>>>>>>>>>>>            Send AllowServerAction (&bAllow) aPubMethodNames[iIndex] aPubMethodHandles[iIndex] aPubMethodIsFunction[iIndex] (&aParams)
16799>>>>>>>>>>>            If (not(bAllow)) Begin
16801>>>>>>>>>>>                
16801>>>>>>>>>>>                Error DFERR_WEBAPP_ACTION_NOT_ALLOWED (SFormat(C_$WebAppMethodNotAllowed, aPubMethodNames[iIndex], Object_Label(Self)))
16802>>>>>>>>>>>>
16802>>>>>>>>>>>                Function_Return ""
16803>>>>>>>>>>>            End
16803>>>>>>>>>>>>
16803>>>>>>>>>>>            
16803>>>>>>>>>>>            
16803>>>>>>>>>>>            //  Store the action data in a property so it is accessible for the action method
16803>>>>>>>>>>>            Set phoActionJsonData to hoAttachment
16804>>>>>>>>>>>            
16804>>>>>>>>>>>            // Get the parameter count....
16804>>>>>>>>>>>            Move (SizeOfArray(aParams)) to icParameters
16805>>>>>>>>>>>            
16805>>>>>>>>>>>            // Special Case: OnChange
16805>>>>>>>>>>>            If (Uppercase(sAction) = "ONCHANGE") Begin
16807>>>>>>>>>>>                // If the action is an OnChange event then we must test if the data type is a number, 
16807>>>>>>>>>>>                // Date or DateTime. If so we must convert each parameter value from the universal 
16807>>>>>>>>>>>                // transfer format
16807>>>>>>>>>>>                Get peDataType to eDataType   // If the object supports psValue it should also support peDataType. If not peDataType will get delegated to ghoWebApp and return typeASCII.
16808>>>>>>>>>>>                // Note: For efficienty we do not WebGet peDataType! In other words we do not
16808>>>>>>>>>>>                // get the "synchronized copy of peDataType (if there is one). This is much more
16808>>>>>>>>>>>                // efficient but it also assumes that a control's peDataType does not change 
16808>>>>>>>>>>>                // dynamically. This should be OK....
16808>>>>>>>>>>>                For i from 0 to (icParameters - 1)
16814>>>>>>>>>>>>
16814>>>>>>>>>>>                    Move (ConvertFromClient(eDataType, aParams[i])) to aParams[i]
16815>>>>>>>>>>>                Loop
16816>>>>>>>>>>>>
16816>>>>>>>>>>>            End
16816>>>>>>>>>>>>
16816>>>>>>>>>>>           
16816>>>>>>>>>>>            // Call the action
16816>>>>>>>>>>>            If (aPubMethodIsFunction[iIndex]) Begin
16818>>>>>>>>>>>                Case Begin
16818>>>>>>>>>>>                    Case (icParameters = 0)
16820>>>>>>>>>>>                        Get aPubMethodHandles[iIndex] to sReturnVal     // calls the function
16821>>>>>>>>>>>                        Case Break
16822>>>>>>>>>>>                    Case (icParameters = 1)
16825>>>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] to sReturnVal
16826>>>>>>>>>>>                        Case Break
16827>>>>>>>>>>>                    Case (icParameters = 2)
16830>>>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] aParams[1] to sReturnVal
16831>>>>>>>>>>>                        Case Break
16832>>>>>>>>>>>                    Case (icParameters = 3)
16835>>>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] to sReturnVal
16836>>>>>>>>>>>                        Case Break
16837>>>>>>>>>>>                    Case (icParameters = 4)
16840>>>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] to sReturnVal
16841>>>>>>>>>>>                        Case Break
16842>>>>>>>>>>>                    Case (icParameters = 5)
16845>>>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] to sReturnVal
16846>>>>>>>>>>>                        Case Break
16847>>>>>>>>>>>                    Case (icParameters = 6)
16850>>>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] to sReturnVal
16851>>>>>>>>>>>                        Case Break
16852>>>>>>>>>>>                    Case (icParameters = 7)
16855>>>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] aParams[6] to sReturnVal
16856>>>>>>>>>>>                        Case Break
16857>>>>>>>>>>>                    Case (icParameters = 8)
16860>>>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] aParams[6] aParams[7] to sReturnVal
16861>>>>>>>>>>>                        Case Break
16862>>>>>>>>>>>                    Case (icParameters = 9)
16865>>>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] aParams[6] aParams[7] aParams[8] to sReturnVal
16866>>>>>>>>>>>                        Case Break
16867>>>>>>>>>>>                    Case (icParameters = 10)
16870>>>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] aParams[6] aParams[7] aParams[8] aParams[9] to sReturnVal
16871>>>>>>>>>>>                        Case Break
16872>>>>>>>>>>>                    Case (icParameters = 11)
16875>>>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] aParams[6] aParams[7] aParams[8] aParams[9] aParams[10] to sReturnVal
16876>>>>>>>>>>>                        Case Break
16877>>>>>>>>>>>                    Case (icParameters = 12)
16880>>>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] aParams[6] aParams[7] aParams[8] aParams[9] aParams[10] aParams[11] to sReturnVal
16881>>>>>>>>>>>                        Case Break
16882>>>>>>>>>>>                    Case (icParameters = 13)
16885>>>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] aParams[6] aParams[7] aParams[8] aParams[9] aParams[10] aParams[11] aParams[12] to sReturnVal
16886>>>>>>>>>>>                        Case Break
16887>>>>>>>>>>>                    Case (icParameters = 14)
16890>>>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] aParams[6] aParams[7] aParams[8] aParams[9] aParams[10] aParams[11] aParams[12] aParams[13] to sReturnVal
16891>>>>>>>>>>>                        Case Break
16892>>>>>>>>>>>                    Case (icParameters = 15)
16895>>>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] aParams[6] aParams[7] aParams[8] aParams[9] aParams[10] aParams[11] aParams[12] aParams[13] aParams[14] to sReturnVal
16896>>>>>>>>>>>                        Case Break
16897>>>>>>>>>>>                    Case (icParameters = 16)
16900>>>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] aParams[6] aParams[7] aParams[8] aParams[9] aParams[10] aParams[11] aParams[12] aParams[13] aParams[14] aParams[15] to sReturnVal
16901>>>>>>>>>>>                        Case Break
16902>>>>>>>>>>>                    Case Else
16902>>>>>>>>>>>                        Error DFERR_PROGRAM (SFormat(C_$WebAppTooManyParameters,sAction))
16903>>>>>>>>>>>>
16903>>>>>>>>>>>                Case End
16903>>>>>>>>>>>            End
16903>>>>>>>>>>>>
16903>>>>>>>>>>>            Else Begin
16904>>>>>>>>>>>                Move "" to sReturnVal
16905>>>>>>>>>>>                
16905>>>>>>>>>>>                Case Begin
16905>>>>>>>>>>>                    Case (icParameters = 0)
16907>>>>>>>>>>>                        Send aPubMethodHandles[iIndex]                  // calls the procedure
16908>>>>>>>>>>>                        Case Break
16909>>>>>>>>>>>                    Case (icParameters = 1)
16912>>>>>>>>>>>                        Send aPubMethodHandles[iIndex] aParams[0]
16913>>>>>>>>>>>                        Case Break
16914>>>>>>>>>>>                    Case (icParameters = 2)
16917>>>>>>>>>>>                        Send aPubMethodHandles[iIndex] aParams[0] aParams[1]
16918>>>>>>>>>>>                        Case Break
16919>>>>>>>>>>>                    Case (icParameters = 3)
16922>>>>>>>>>>>                        Send aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2]
16923>>>>>>>>>>>                        Case Break
16924>>>>>>>>>>>                    Case (icParameters = 4)
16927>>>>>>>>>>>                        Send aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3]
16928>>>>>>>>>>>                        Case Break
16929>>>>>>>>>>>                    Case (icParameters = 5)
16932>>>>>>>>>>>                        Send aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4]
16933>>>>>>>>>>>                        Case Break
16934>>>>>>>>>>>                    Case (icParameters = 6)
16937>>>>>>>>>>>                        Send aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5]
16938>>>>>>>>>>>                        Case Break
16939>>>>>>>>>>>                    Case (icParameters = 7)
16942>>>>>>>>>>>                        Send aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] aParams[6]
16943>>>>>>>>>>>                        Case Break
16944>>>>>>>>>>>                    Case (icParameters = 8)
16947>>>>>>>>>>>                        Send aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] aParams[6] aParams[7]
16948>>>>>>>>>>>                        Case Break
16949>>>>>>>>>>>                    Case (icParameters = 9)
16952>>>>>>>>>>>                        Send aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] aParams[6] aParams[7] aParams[8]
16953>>>>>>>>>>>                        Case Break
16954>>>>>>>>>>>                    Case (icParameters = 10)
16957>>>>>>>>>>>                        Send aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] aParams[6] aParams[7] aParams[8] aParams[9]
16958>>>>>>>>>>>                        Case Break
16959>>>>>>>>>>>                    Case (icParameters = 11)
16962>>>>>>>>>>>                        Send aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] aParams[6] aParams[7] aParams[8] aParams[9] aParams[10]
16963>>>>>>>>>>>                        Case Break
16964>>>>>>>>>>>                    Case (icParameters = 12)
16967>>>>>>>>>>>                        Send aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] aParams[6] aParams[7] aParams[8] aParams[9] aParams[10] aParams[11]
16968>>>>>>>>>>>                        Case Break
16969>>>>>>>>>>>                    Case (icParameters = 13)
16972>>>>>>>>>>>                        Send aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] aParams[6] aParams[7] aParams[8] aParams[9] aParams[10] aParams[11] aParams[12]
16973>>>>>>>>>>>                        Case Break
16974>>>>>>>>>>>                    Case (icParameters = 14)
16977>>>>>>>>>>>                        Send aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] aParams[6] aParams[7] aParams[8] aParams[9] aParams[10] aParams[11] aParams[12] aParams[13]
16978>>>>>>>>>>>                        Case Break
16979>>>>>>>>>>>                    Case (icParameters = 15)
16982>>>>>>>>>>>                        Send aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] aParams[6] aParams[7] aParams[8] aParams[9] aParams[10] aParams[11] aParams[12] aParams[13] aParams[14]
16983>>>>>>>>>>>                        Case Break
16984>>>>>>>>>>>                    Case (icParameters = 16)
16987>>>>>>>>>>>                        Send aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] aParams[6] aParams[7] aParams[8] aParams[9] aParams[10] aParams[11] aParams[12] aParams[13] aParams[14] aParams[15]
16988>>>>>>>>>>>                        Case Break
16989>>>>>>>>>>>                    Case Else
16989>>>>>>>>>>>                        Error DFERR_PROGRAM (SFormat(C_$WebAppTooManyParameters,sAction))
16990>>>>>>>>>>>>
16990>>>>>>>>>>>                Case End
16990>>>>>>>>>>>            End
16990>>>>>>>>>>>>
16990>>>>>>>>>>>            
16990>>>>>>>>>>>            //  Clear action data array
16990>>>>>>>>>>>            Set phoActionJsonData to C_WebUnresolvedObject
16991>>>>>>>>>>>        End
16991>>>>>>>>>>>>
16991>>>>>>>>>>>        
16991>>>>>>>>>>>        Function_Return sReturnVal
16992>>>>>>>>>>>    End_Function

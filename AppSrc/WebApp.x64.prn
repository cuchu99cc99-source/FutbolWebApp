21892>>>>>>>>>>>>>        If (hoDefaultView <> C_WebUnresolvedObject and peStateMode(hoDefaultView) = vsmOff) Begin
21894>>>>>>>>>>>>>            Move hoDefaultView to hoInvoking
21895>>>>>>>>>>>>>            
21895>>>>>>>>>>>>>            Get AllowViewAccess hoDefaultView to bAllowAccess
21896>>>>>>>>>>>>>            
21896>>>>>>>>>>>>>            If (not(bAllowAccess)) Begin

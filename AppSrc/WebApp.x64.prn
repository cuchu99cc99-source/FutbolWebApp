23732>>>>>>>>>>>>>>>>>        Property Boolean pbPassword False             // If True then the textbox acts like a password entry box.
23735>>>>>>>>>>>>>>>>>        Property Integer pbPromptButton C_WebDefault  // If True a prompt button is drawn (see also pbServerOnPrompt, psClientOnPrompt)
23738>>>>>>>>>>>>>>>>>        Property Boolean pbServerOnPrompt True        // Set to true to trigger server OnPrompt event when the prompt button is clicked (see also pbPromptButton)
23741>>>>>>>>>>>>>>>>>        Property String psClientOnPrompt ""           // Name of client side OnPrompt event handler. See also pbPromptButton.
23744>>>>>>>>>>>>>>>>>
23744>>>>>>>>>>>>>>>>>        Property String psPlaceHolder ""              // Placeholder value shown inside the form when it doesn't have a value. Note that this feature only works on Internet Explorer 10 and higher.
23747>>>>>>>>>>>>>>>>>
23747>>>>>>>>>>>>>>>>>        Property Boolean pbAutoTab False              // Automatically tab to the next control when the maxlenght is reached
23750>>>>>>>>>>>>>>>>>
23750>>>>>>>>>>>>>>>>>        Property String psInputMode ""                // Hints the browser as to what virtual keyboard should be used ("none", "text", "decimal", "numeric", "tel", "search", "email")
23753>>>>>>>>>>>>>>>>>                                                      // If empty it will automatically be set to "decimal" or "numeric" for numeric fields
23753>>>>>>>>>>>>>>>>>

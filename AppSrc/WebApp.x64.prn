7177>>>>>>>>>>>    
7177>>>>>>>>>>>    If (iChannel <= DF_SEQ_CHANNEL_ERROR) Begin
7179>>>>>>>>>>>        If (Seq_Channel_Error_Mode() = DF_SEQ_CHANNEL_ERROR_MODE_ALL) Begin
7181>>>>>>>>>>>            Error DFERR_CANT_OPEN_OUTPUT_FILE (sChannel + ":" *C_$ChannelNotAvailable)
7182>>>>>>>>>>>>
7182>>>>>>>>>>>            Move DF_SEQ_CHANNEL_ERROR to iChannel
7183>>>>>>>>>>>        End
7183>>>>>>>>>>>>
7183>>>>>>>>>>>        
7183>>>>>>>>>>>        Function_Return iChannel
7184>>>>>>>>>>>    End
7184>>>>>>>>>>>>
7184>>>>>>>>>>>    
7184>>>>>>>>>>>    Move False to Err
7185>>>>>>>>>>>    Direct_Output channel iChannel sChannel
7187>>>>>>>>>>>    
7187>>>>>>>>>>>    If (Err) Begin
7189>>>>>>>>>>>        Send Seq_Release_Channel iChannel
7190>>>>>>>>>>>        Function_Return DF_SEQ_CHANNEL_ERROR
7191>>>>>>>>>>>    End
7191>>>>>>>>>>>>
7191>>>>>>>>>>>    
7191>>>>>>>>>>>    Set Seq_Channel_Mode iChannel to DF_SEQ_CHANNEL_MODE_OUTPUT
7192>>>>>>>>>>>    
7192>>>>>>>>>>>    Function_Return iChannel
7193>>>>>>>>>>>End_Function

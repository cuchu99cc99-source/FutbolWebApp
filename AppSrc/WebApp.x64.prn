5095>>>>>>>    // Augmented to test updating connections.
5095>>>>>>>    // If error report it.
5095>>>>>>>    Procedure Request_Save
5097>>>>>>>        Integer iRval
5097>>>>>>>        String sTable
5097>>>>>>>        If (OPERATION_MODE=MODE_WAITING) Begin
5099>>>>>>>            Send Update_Focus_Field_For_Operation MODE_SAVING // added in 12.1/15.1
5100>>>>>>>            Get Validate_Save_Structure False to iRval
5101>>>>>>>            If iRval Begin
5103>>>>>>>                Get ErrorMessageTableName iRval to sTable
5104>>>>>>>                Move (String(iRval) * "(" - sTable -")") to sTable
5105>>>>>>>                Send Data_Set_Error -1 DFERR_PROGRAM DD_INVALID_SAVE_STRUCTURE sTable
5106>>>>>>>                Procedure_Return
5107>>>>>>>            End
5107>>>>>>>>
5107>>>>>>>        End
5107>>>>>>>>
5107>>>>>>>        Forward Send Request_Save
5109>>>>>>>    End_Procedure
5110>>>>>>>

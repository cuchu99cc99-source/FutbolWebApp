10>>>>>>>>>>>// Since DF allows the imbedding of binary zeros in strings, strings
10>>>>>>>>>>>// passed back to DF (via reference pointers) often need to be sized
10>>>>>>>>>>>// based on the position of the zero terminator.  This function will
10>>>>>>>>>>>// a valid DF string from a 'C' string.
10>>>>>>>>>>>
10>>>>>>>>>>>Function UCharToString Global UChar uByte Returns String
12>>>>>>>>>>>    // Construct string value via UChar array
12>>>>>>>>>>>    UChar[] ucResult
13>>>>>>>>>>>    Move uByte to ucResult[0]
14>>>>>>>>>>>    Function_Return (UCharArrayToString(ucResult,1))
15>>>>>>>>>>>End_Function
16>>>>>>>>>>>
16>>>>>>>>>>>Function DWORDtoBytes Global Integer aDWORD Returns String
18>>>>>>>>>>>    // Construct string value via UChar array
18>>>>>>>>>>>    UChar[] ucResult
19>>>>>>>>>>>    Move (low(aDWORD) iand 255) to ucResult[0]
20>>>>>>>>>>>    Move (low(aDWORD) / 256)    to ucResult[1]
21>>>>>>>>>>>    Move (hi(aDWORD) iand 255)  to ucResult[2]
22>>>>>>>>>>>    Move (hi(aDWORD) / 256)     to ucResult[3]
23>>>>>>>>>>>    Function_Return (UCharArrayToString(ucResult,4))
24>>>>>>>>>>>End_Function
25>>>>>>>>>>>
25>>>>>>>>>>>Function SHORTtoBytes Global Integer aSHORT Returns String
27>>>>>>>>>>>    // Construct string value via UChar array
27>>>>>>>>>>>    UChar[] ucResult
28>>>>>>>>>>>    Move (aSHORT iand 255) to ucResult[0]
29>>>>>>>>>>>    Move (aSHORT / 256)    to ucResult[1]
30>>>>>>>>>>>    Function_Return (UCharArrayToString(ucResult,4))
31>>>>>>>>>>>End_Function

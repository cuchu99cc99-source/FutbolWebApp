34447>>>>>>>    // Otherwise we can't properly update the viewstack whenever a user cancels with the x button.
34447>>>>>>>    Procedure NavigateForward2 Handle hoInvokingObject tWebNavigateData NavigateData Integer eNavMode
34449>>>>>>>        Forward Send NavigateForward2 hoInvokingObject NavigateData eNavMode
34451>>>>>>>        WebSet pbServerOnEscape to True 
34452>>>>>>>    End_Procedure
34453>>>>>>>    
34453>>>>>>>    //Helper procedure that closes a dialog with either hide or navigateclose/cancel based on how it was opened

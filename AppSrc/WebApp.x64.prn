13173>>>>>>>        Get TempAttributeNodes to hoAttrs
13174>>>>>>>        If hoAttrs Begin
13176>>>>>>>            Get RemoveQualifiedNode of hoAttrs sNamespace sBaseName to hoAttr
13177>>>>>>>            Set XMLInterface of hoAttrs to 0
13178>>>>>>>            If hoAttr ;                Send destroy of hoAttr
13181>>>>>>>        End
13181>>>>>>>>
13181>>>>>>>    End_Procedure

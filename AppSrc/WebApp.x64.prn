34080>>>>>>>            If (bEnabled <> bAllowAccess) Begin
34082>>>>>>>                WebSet pbEnabled to bAllowAccess
34083>>>>>>>            End
34083>>>>>>>>
34083>>>>>>>        End
34083>>>>>>>>
34083>>>>>>>    End_Procedure

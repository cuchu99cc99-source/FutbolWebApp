21486>>>>>>>>>    Function SyncDDOs  Returns Boolean
21488>>>>>>>>>        // Synchronize the servers DDO's with the record ID's passed from the client.
21488>>>>>>>>>        String sDDOName sCheck
21488>>>>>>>>>        Integer i icDDO icAdditionalDDO iIndex iMainFile iConstrainFile
21488>>>>>>>>>        Handle hoDDO hoMainDD hoParentDDO hoBadDDO hoFirstBadDDO
21488>>>>>>>>>        RowID riRowID
21488>>>>>>>>>        Handle[] aAdditionalDDOStructures aDDOQueue
21490>>>>>>>>>        tNameHandlePair[] aDDOIndex
21490>>>>>>>>>        tNameHandlePair[] aDDOIndex
21491>>>>>>>>>        tNameHandlePair searchItem
21491>>>>>>>>>        tNameHandlePair searchItem
21491>>>>>>>>>        tWebDDO[] aDDOs
21491>>>>>>>>>        tWebDDO[] aDDOs
21492>>>>>>>>>        Boolean bFound bTestSyncDDO
21492>>>>>>>>>        RowID riCrnt
21492>>>>>>>>>        tWebDDODef tDDODef
21492>>>>>>>>>        tWebDDODef tDDODef
21492>>>>>>>>>        tDDChangedInfo DDChangedInfo EmptyDDChangedInfo
21492>>>>>>>>>        tDDChangedInfo DDChangedInfo EmptyDDChangedInfo
21492>>>>>>>>>        Integer iSrvr 
21492>>>>>>>>>        
21492>>>>>>>>>        If (Operation_Mode <> MODE_WAITING) Begin
21494>>>>>>>>>            Error DFERR_PROGRAM "Reentrancy issue, the DDO's are not ready for synchronization."
21495>>>>>>>>>>
21495>>>>>>>>>            Function_Return False
21496>>>>>>>>>        End
21496>>>>>>>>>>
21496>>>>>>>>>        
21496>>>>>>>>>        // Clear the DDOs....
21496>>>>>>>>>        Get Main_DD to hoMainDD
21497>>>>>>>>>        
21497>>>>>>>>>        If (hoMainDD <> 0) Begin
21499>>>>>>>>>            Send ReSyncClearAll of hoMainDD
21500>>>>>>>>>        End
21500>>>>>>>>>>
21500>>>>>>>>>        
21500>>>>>>>>>        // Now clear the main dd of any 'additional' DDO structures
21500>>>>>>>>>        Get paAdditionalDDOStructures to aAdditionalDDOStructures
21501>>>>>>>>>        Move (SizeOfArray(aAdditionalDDOStructures)) to icAdditionalDDO
21502>>>>>>>>>        
21502>>>>>>>>>        For i from 0 to (icAdditionalDDO - 1)
21508>>>>>>>>>>
21508>>>>>>>>>            If (aAdditionalDDOStructures[i] <> 0) Begin
21510>>>>>>>>>                Send ReSyncClearAll of aAdditionalDDOStructures[i]
21511>>>>>>>>>            End
21511>>>>>>>>>>
21511>>>>>>>>>        Loop
21512>>>>>>>>>>
21512>>>>>>>>>        
21512>>>>>>>>>        //  Load the stats
21512>>>>>>>>>        WebGet ptDDOStates to tDDODef
21513>>>>>>>>>        
21513>>>>>>>>>        //  Check if this view was already active
21513>>>>>>>>>        If (not(tDDODef.bA)) Begin
21515>>>>>>>>>            Function_Return True
21516>>>>>>>>>        End
21516>>>>>>>>>>
21516>>>>>>>>>        
21516>>>>>>>>>        Move tDDODef.aDDOs to aDDOs
21517>>>>>>>>>        Move (SizeOfArray(aDDOs)) to icDDO
21518>>>>>>>>>        
21518>>>>>>>>>        Get paDDOIndex to aDDOIndex
21519>>>>>>>>>
21519>>>>>>>>>        // reset all constrain_Files in the DDOs if this view does that
21519>>>>>>>>>        For i from 0 to (icDDO - 1)
21525>>>>>>>>>>
21525>>>>>>>>>            If (aDDOs[i].iConstrainFile<>-1) Begin
21527>>>>>>>>>                
21527>>>>>>>>>                // Get an index to the DDO handle....
21527>>>>>>>>>                Move aDDOs[i].sName to searchItem.sName
21528>>>>>>>>>                Move (BinarySearchArray(searchItem, aDDOIndex, False)) to iIndex
21529>>>>>>>>>                If (iIndex = -1) Begin
21531>>>>>>>>>                    Error DFERR_PROGRAM ("Client DDO " + aDDOs[i].sName + " not found on server")
21532>>>>>>>>>>
21532>>>>>>>>>                    Function_Return False 
21533>>>>>>>>>                End
21533>>>>>>>>>>
21533>>>>>>>>>                Set Constrain_File of aDDOIndex[iIndex].hValue to aDDOs[i].iConstrainFile
21534>>>>>>>>>            End
21534>>>>>>>>>>
21534>>>>>>>>>        Loop
21535>>>>>>>>>>
21535>>>>>>>>>        
21535>>>>>>>>>        // establish constraints for this instance before refinding DDOs
21535>>>>>>>>>        Send RebuildDDConstraints
21536>>>>>>>>>
21536>>>>>>>>>        // Iterate the client DDO collection. This collection is sorted by: the view's Main_DD,
21536>>>>>>>>>        // followed by the child DDO tree, then the parent DDO tree.
21536>>>>>>>>>        For i from 0 to (icDDO - 1)
21542>>>>>>>>>>
21542>>>>>>>>>            // Get an index to the DDO handle....
21542>>>>>>>>>            Move aDDOs[i].sName to searchItem.sName
21543>>>>>>>>>            Move (BinarySearchArray(searchItem, aDDOIndex, False)) to iIndex
21544>>>>>>>>>            If (iIndex = -1) Begin
21546>>>>>>>>>                Error DFERR_PROGRAM ("Client DDO " + aDDOs[i].sName + " not found on server")
21547>>>>>>>>>>
21547>>>>>>>>>                Function_Return False 
21548>>>>>>>>>            End
21548>>>>>>>>>>
21548>>>>>>>>>            Move aDDOIndex[iIndex].hValue to hoDDO
21549>>>>>>>>>            // each ddo in the structure needs to know the rowid to find and 
21549>>>>>>>>>            // various parent_changed_state info.
21549>>>>>>>>>            Set prFindRowId of hoDDO to (DeserializeRowID(aDDOs[i].sRowID))
21550>>>>>>>>>            Set pDDDefaults of hoDDO to aDDOs[i].aRemembered
21551>>>>>>>>>            
21551>>>>>>>>>            // set changed state and parent changed state info
21551>>>>>>>>>            Move EmptyDDChangedInfo to DDChangedInfo 
21552>>>>>>>>>            Move (aDDOs[i].bChanged) to DDChangedInfo.bChanged
21553>>>>>>>>>            For iSrvr from 0 to (SizeOfArray(aDDOs[i].aParentChanged)-1)
21559>>>>>>>>>>
21559>>>>>>>>>                Move aDDOs[i].aParentChanged[iSrvr].iTable to DDChangedInfo.ParentChanged[iSrvr].iTable
21560>>>>>>>>>                Move aDDOs[i].aParentChanged[iSrvr].bSwitched to DDChangedInfo.ParentChanged[iSrvr].bSwitched
21561>>>>>>>>>            Loop    
21562>>>>>>>>>>
21562>>>>>>>>>            Set pDDChangedInfo of hoDDO to DDChangedInfo
21563>>>>>>>>>
21563>>>>>>>>>            Move hoDDO to aDDOQueue[i] 
21564>>>>>>>>>        Loop
21565>>>>>>>>>>
21565>>>>>>>>>
21565>>>>>>>>>        
21565>>>>>>>>>        If hoMainDD Begin
21567>>>>>>>>>            If (hoMainDD<>aDDOQueue[0]) Begin
21569>>>>>>>>>                Error DFERR_PROGRAM "Assert: SynchDDO hoMainDD issue"                 
21570>>>>>>>>>>
21570>>>>>>>>>            End
21570>>>>>>>>>>
21570>>>>>>>>>            // this will resync all records in DDO structure and return
21570>>>>>>>>>            // the 0 or the first DDO where it could not find the record
21570>>>>>>>>>            Get ReSyncRecords of hoMainDD True to hoBadDDO
21571>>>>>>>>>        End
21571>>>>>>>>>>
21571>>>>>>>>>
21571>>>>>>>>>        // if additional DDO structures do the same.
21571>>>>>>>>>        For i from 0 to (icAdditionalDDO - 1)
21577>>>>>>>>>>
21577>>>>>>>>>            If (aAdditionalDDOStructures[i] <> 0) Begin
21579>>>>>>>>>                Get ReSyncRecords of aAdditionalDDOStructures[i] True to hoFirstBadDDO
21580>>>>>>>>>                If (hoFirstBadDDO <> 0) ;                    Move hoFirstBadDDO to hoBadDDO
21583>>>>>>>>>            End
21583>>>>>>>>>>
21583>>>>>>>>>        Loop
21584>>>>>>>>>>
21584>>>>>>>>>
21584>>>>>>>>>        If (icDDO) Begin
21586>>>>>>>>>            // Field defaults might get cleared by above operation so we reset them here
21586>>>>>>>>>            For i from 0 to (icDDO - 1)
21592>>>>>>>>>>
21592>>>>>>>>>                Move aDDOQueue[i] to hoDDO
21593>>>>>>>>>    
21593>>>>>>>>>                // Refresh field defaults in constrained child DDOs.
21593>>>>>>>>>                // Constrained children of the main DDO do not refresh the field defaults
21593>>>>>>>>>                // during Clear_All (at the beginning of SyncDDOs).
21593>>>>>>>>>                
21593>>>>>>>>>                Get Constrain_File of hoDDO to iConstrainFile
21594>>>>>>>>>                If (iConstrainFile <> 0 and IsNullRowId(prFindRowId(hoDDO))) Begin
21596>>>>>>>>>                    Send SetDDFieldDefaults hoDDO
21597>>>>>>>>>                End
21597>>>>>>>>>>
21597>>>>>>>>>            Loop
21598>>>>>>>>>>
21598>>>>>>>>>    
21598>>>>>>>>>            Get pbTestSyncDDO to bTestSyncDDO
21599>>>>>>>>>            If bTestSyncDDO Begin
21601>>>>>>>>>
21601>>>>>>>>>                // Test to see if all DDOs were visited and that all records were found.
21601>>>>>>>>>                // At some point we may not want to keep this as it is checking if our logic
21601>>>>>>>>>                // is correct and there may not be a need to add this overhead to deployed applications.
21601>>>>>>>>>                For i from 0 to (icDDO - 1)
21607>>>>>>>>>>
21607>>>>>>>>>                    Move aDDOQueue[i] to hoDDO
21608>>>>>>>>>                    Move (DeserializeRowID(aDDOs[i].sRowID)) to riRowID
21609>>>>>>>>>                    Get CurrentRowId of hoDDO to riCrnt
21610>>>>>>>>>                    
21610>>>>>>>>>                    // all ddos should have been visited. If not, it's probably a DAW logic error
21610>>>>>>>>>                    If (not(Visited_State(hoDDO))) Begin
21612>>>>>>>>>                        Error DFERR_PROGRAM ("DDO " + aDDOs[i].sName + " not visited in syncDDOs")
21613>>>>>>>>>>
21613>>>>>>>>>                        Function_Return False
21614>>>>>>>>>                    End
21614>>>>>>>>>>
21614>>>>>>>>>                    
21614>>>>>>>>>                    // Normally the expected record should now be in the DDO, but not always!
21614>>>>>>>>>                    // If a record has been deleted or is constraint invalid, we will have a mismatch.
21614>>>>>>>>>                    // If this happened, hoBadDDO should have been set or current rowid is null.
21614>>>>>>>>>                    // If not, we have a logic flaw 
21614>>>>>>>>>                    If (not(IsSameRowID(riRowID,riCrnt))) Begin
21616>>>>>>>>>                        // If mismatch but an error, we are ok.
21616>>>>>>>>>                        // If a mismtach and the current RowId is null, this is probably a child
21616>>>>>>>>>                        // relates to constraint failure that was cleared, we are ok.
21616>>>>>>>>>                        // Else we have a logic Error                    
21616>>>>>>>>>                        If (not(hoBadDDO) and not(IsNullRowID(riCrnt))) Begin
21618>>>>>>>>>                            Error DFERR_PROGRAM ("Client DDO " + aDDOs[i].sName + " cannot set the rowid on server(2")
21619>>>>>>>>>>
21619>>>>>>>>>                            Function_Return False
21620>>>>>>>>>                        End
21620>>>>>>>>>>
21620>>>>>>>>>                    End
21620>>>>>>>>>>
21620>>>>>>>>>                    
21620>>>>>>>>>                Loop
21621>>>>>>>>>>
21621>>>>>>>>>            End
21621>>>>>>>>>>
21621>>>>>>>>>        
21621>>>>>>>>>        End
21621>>>>>>>>>>
21621>>>>>>>>>        
21621>>>>>>>>>        If hoBadDDO Begin
21623>>>>>>>>>            Send OnSyncDDOsRefindError hoBadDDO
21624>>>>>>>>>        End
21624>>>>>>>>>>
21624>>>>>>>>>        
21624>>>>>>>>>        Function_Return True
21625>>>>>>>>>    End_Function
21626>>>>>>>>>    
21626>>>>>>>>>    // sets defaults for passed DDO. 
21626>>>>>>>>>    // This is only used by the DDO syncing process and it will change
21626>>>>>>>>>    Procedure SetDDFieldDefaults Handle hoDDO
21628>>>>>>>>>        Boolean bOldState
21628>>>>>>>>>        Set pbSynchingFieldDefaults to True                // indicate that we are in the process of syncing a DDO's field_defaults
21629>>>>>>>>>        Get Change_Disabled_State of hoDDO to bOldState
21630>>>>>>>>>        Set Change_Disabled_State of hoDDO to True
21631>>>>>>>>>        Send Private_Field_Defaults of hoDDO
21632>>>>>>>>>        Send Field_Defaults of hoDDO
21633>>>>>>>>>        Send AssignDynamicDefaults of hoDDO
21634>>>>>>>>>        Set Change_Disabled_State of hoDDO to bOldState
21635>>>>>>>>>        Set pbSynchingFieldDefaults to False
21636>>>>>>>>>    End_Procedure
21637>>>>>>>>>    
21637>>>>>>>>>    
21637>>>>>>>>>    Procedure WriteDDOCache
21639>>>>>>>>>        // Stores the DDO object array and creates a corresponding array of DDO object names.
21639>>>>>>>>>        // Both arrays are sorted according the object names. This cache can then be used for fast
21639>>>>>>>>>        // lookups of DDO object name to DDO handle.
21639>>>>>>>>>        //
21639>>>>>>>>>        // Note: Must be called after Main_DD has been set.
21639>>>>>>>>>        Handle hoMain_DD
21639>>>>>>>>>        Integer i icDDO iIndex iCount
21639>>>>>>>>>        tNameHandlePair[] aDDOIndex
21639>>>>>>>>>        tNameHandlePair[] aDDOIndex
21640>>>>>>>>>        
21640>>>>>>>>>        String[] aNames aSortedNames
21642>>>>>>>>>        Handle[] aDDOHandles aSortedDDOs aAdditionalDDOStructures
21645>>>>>>>>>        
21645>>>>>>>>>        // Get all the DDOs in the main DDO structure
21645>>>>>>>>>        Get Main_DD to hoMain_DD
21646>>>>>>>>>        
21646>>>>>>>>>        If (hoMain_DD <> 0) Begin
21648>>>>>>>>>            // returns the DDO tree structure Main DD, followed by child DD tree, then parent DD tree
21648>>>>>>>>>            Send FindDataDictionaries hoMain_DD (&aDDOHandles)
21649>>>>>>>>>        End
21649>>>>>>>>>>
21649>>>>>>>>>        
21649>>>>>>>>>        // Get all "additional" DDO structures
21649>>>>>>>>>        Get paAdditionalDDOStructures to aAdditionalDDOStructures
21650>>>>>>>>>        Move (SizeOfArray(aAdditionalDDOStructures)) to iCount
21651>>>>>>>>>        
21651>>>>>>>>>        For i from 0 to (iCount - 1)
21657>>>>>>>>>>
21657>>>>>>>>>            // returns the DDO tree structure Main DD, followed by child DD tree, then parent DD tree
21657>>>>>>>>>            Send FindDataDictionaries aAdditionalDDOStructures[i] (&aDDOHandles)
21658>>>>>>>>>        Loop
21659>>>>>>>>>>
21659>>>>>>>>>    
21659>>>>>>>>>        
21659>>>>>>>>>        //  Build the search index
21659>>>>>>>>>        Move (SizeOfArray(aDDOHandles)) to icDDO
21660>>>>>>>>>        If (icDDO > 0) Begin
21662>>>>>>>>>            Move (ResizeArray(aDDOIndex, icDDO)) to aDDOIndex
21663>>>>>>>>>            For i from 0 to (icDDO - 1)
21669>>>>>>>>>>
21669>>>>>>>>>                Get DDIdentity aDDOHandles[i] to aDDOIndex[i].sName
21670>>>>>>>>>                Move aDDOHandles[i] to aDDOIndex[i].hValue
21671>>>>>>>>>            Loop
21672>>>>>>>>>>
21672>>>>>>>>>            
21672>>>>>>>>>            Move (SortArray(aDDOIndex, False)) to aDDOIndex
21673>>>>>>>>>        End
21673>>>>>>>>>>
21673>>>>>>>>>        
21673>>>>>>>>>        // Save the arrays....
21673>>>>>>>>>        Set paDDOIndex to aDDOIndex
21674>>>>>>>>>        Set paDDOHandlesTree to aDDOHandles     // Store the DDO tree structure Main DD, followed by child DD tree, then parent DD tree
21675>>>>>>>>>    End_Procedure
21676>>>>>>>>>    
21676>>>>>>>>>    // Returns the DDO object handle in this view for the passed table number.
21676>>>>>>>>>    // Returns 0 if the passed table is not the main table of "any" DDO in this view.
21676>>>>>>>>>    Function FindDDOForTable Integer iTable Returns Handle
21678>>>>>>>>>        Integer iDDO icDDO
21678>>>>>>>>>        Integer iMainFile
21678>>>>>>>>>        tNameHandlePair[] aDDOIndex
21678>>>>>>>>>        tNameHandlePair[] aDDOIndex
21679>>>>>>>>>        
21679>>>>>>>>>        Get paDDOIndex to aDDOIndex
21680>>>>>>>>>        Move (SizeOfArray(aDDOIndex)) to icDDO
21681>>>>>>>>>        

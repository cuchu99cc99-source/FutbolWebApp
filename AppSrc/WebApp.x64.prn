26155>>>>>>>>>>>    Function OnCheckCustomConstrains Returns Boolean
26157>>>>>>>>>>>        Integer iColumn iField iFile
26157>>>>>>>>>>>        String sValue sFieldValue
26157>>>>>>>>>>>        Boolean bSearchHiddenColumns bHidden
26157>>>>>>>>>>>        Handle[] ahoColumns
26158>>>>>>>>>>>
26158>>>>>>>>>>>        WebGet psSearchTerm to sValue
26159>>>>>>>>>>>        If (sValue = "") Function_Return True
26162>>>>>>>>>>>
26162>>>>>>>>>>>        Get phoColumnObjects to ahoColumns
26163>>>>>>>>>>>        WebGet pbSearchHiddenColumns to bSearchHiddenColumns
26164>>>>>>>>>>>
26164>>>>>>>>>>>        Move (Lowercase(sValue)) to sValue
26165>>>>>>>>>>>        
26165>>>>>>>>>>>        While (iColumn < SizeOfArray(ahoColumns))
26169>>>>>>>>>>>            WebGet pbHidden of ahoColumns[iColumn] to bHidden
26170>>>>>>>>>>>            If (bSearchHiddenColumns or not(bHidden)) Begin
26172>>>>>>>>>>>                Get Data_File of ahoColumns[iColumn] to iFile
26173>>>>>>>>>>>                Get Data_Field of ahoColumns[iColumn] to iField
26174>>>>>>>>>>>
26174>>>>>>>>>>>                If (iField) Begin
26176>>>>>>>>>>>                    Get_Field_Value iFile iField to sFieldValue
26179>>>>>>>>>>>                    If (Lowercase(sFieldValue) contains sValue) Begin
26181>>>>>>>>>>>                        Move (SizeOfArray(ahoColumns)) to iColumn
26182>>>>>>>>>>>                        Function_Return True
26183>>>>>>>>>>>                    End
26183>>>>>>>>>>>>
26183>>>>>>>>>>>                End
26183>>>>>>>>>>>>
26183>>>>>>>>>>>            End
26183>>>>>>>>>>>>
26183>>>>>>>>>>>
26183>>>>>>>>>>>            Increment iColumn
26184>>>>>>>>>>>        Loop
26185>>>>>>>>>>>>
26185>>>>>>>>>>>
26185>>>>>>>>>>>        Function_Return False
26186>>>>>>>>>>>    End_Function

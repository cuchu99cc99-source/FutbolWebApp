39255>>>>>/*The resource manager facilitates file streaming for files outside of the AppHtml folder. It can generate URLs that allow downloading of files that are not server directly by IIS. These URLs can be bound to a specific session (so they will only work for that specific browser session). Note that folders need to be registered before download URLs or upload keys can be generated.*/
39255>>>>>Class cWebResourceManager is a cWebComponent
39256>>>>>    
39256>>>>>    Procedure Construct_Object
39258>>>>>        Forward Send Construct_Object
39260>>>>>        
39260>>>>>        Send Define_cWebResourceManager_mixin
39261>>>>>        
39261>>>>>        Move Self to ghoWebResourceManager
39262>>>>>        Delegate Set phoResourceManager to Self
39264>>>>>        
39264>>>>>        //  Used for encryption of the keys by EncryptKey & DecryptKey
39264>>>>>        Object oDataCrypter is a cCryptographerEx
39266>>>>>            Set piHash to CALG_SHA_256
39267>>>>>            Set piCipher to CALG_AES_256
39268>>>>>            Set psProvider to ""    //  Not providing a specific provider gives the default provider for the provider type
39269>>>>>            Set piProvider to PROV_RSA_AES
39270>>>>>        End_Object
39271>>>>>        
39271>>>>>        Property Integer piDownloadTimeout 0                //  The number of hours that the download URL stays valid (0 = infinite)
39272>>>>>        Property Boolean pbDownloadBindSession True         //  If true the download URL will only work for this session
39273>>>>>        
39273>>>>>        Property Boolean pbAllowNonSessionDownloads False   //  If true non session bound download URLs are allowed
39274>>>>>    End_Procedure
39275>>>>>    
39275>>>>>    Import_Class_Protocol cWebResourceManager_mixin
39276>>>>>    
39276>>>>>    // Generates a download URL for a local file. This URL will point to a handler that will 
39276>>>>>    // stream the file to the client.
39276>>>>>    //
39276>>>>>    // Params:
39276>>>>>    //      sPath   The absolute local file path.
39276>>>>>    Function DownloadURL String sPath Returns String
39278>>>>>        String sUrl
39278>>>>>        Integer iTimout
39278>>>>>        Boolean bBindSession
39278>>>>>        
39278>>>>>        Get piDownloadTimeout to iTimout
39279>>>>>        Get pbDownloadBindSession to bBindSession
39280>>>>>        
39280>>>>>        Get CustomDownloadURL sPath False "" bBindSession iTimout to sUrl
39281>>>>>        
39281>>>>>        Function_Return sUrl
39282>>>>>    End_Function
39283>>>>>    
39283>>>>>    // Advanced method for generating a download URL for a local file. This URL will point to a 
39283>>>>>    // handler that will stream the file to the client.
39283>>>>>    //
39283>>>>>    // {psResourceUrl}/{sDownloadFileName}?attach={bAttachment}&key={hash}  
39283>>>>>    //
39283>>>>>    // Params:
39283>>>>>    //      sPath               The absolute local file path.
39283>>>>>    //      bAttachment         Determines if the file will be streamed as attachment or inline. 
39283>>>>>    //                          Streaming as attachment will show the 'save as' dialog.
39283>>>>>    //      sDownloadFileName   Allows to send the file with a custom name instead of a default 
39283>>>>>    //                          file name.
39283>>>>>    //      bBindSession        If true the download URL will only work for the current session.
39283>>>>>    //      iTimeout            Number of hours that the URL stays valid.
39283>>>>>    //
39283>>>>>    Function CustomDownloadURL String sPath Boolean bAttachment String sDownloadFileName Boolean bBindSession Integer iTimeout Returns String
39285>>>>>        String sVal sCode sKey sResource sUrl
39285>>>>>        DateTime dtTimeout
39285>>>>>        Date dChanged
39285>>>>>        TimeSpan tsDiff
39285>>>>>        Boolean bExists bValid
39285>>>>>        Integer iH iM iSec iTime iPos
39285>>>>>        
39285>>>>>        //  Check if exists
39285>>>>>        File_Exist sPath bExists
39286>>>>>        If (not(pbAllowInvalidDownloadUrl(Self))) Begin
39288>>>>>            If (not(bExists)) Begin
39290>>>>>                Error DFERR_PROGRAM "Generating url for file that does not exist"
39291>>>>>>
39291>>>>>                Function_Return ""
39292>>>>>            End
39292>>>>>>
39292>>>>>            
39292>>>>>            //  Check if valid download folder
39292>>>>>            Get IsAllowedDownloadFolder sPath to bValid
39293>>>>>            If (not(bValid)) Begin
39295>>>>>                Error DFERR_PROGRAM "Generating url for unregistered download folder"
39296>>>>>>
39296>>>>>                Function_Return ""
39297>>>>>            End
39297>>>>>>
39297>>>>>        End
39297>>>>>>
39297>>>>>        
39297>>>>>        //  If the resource is session bound we add the session key to the hash for verificiation
39297>>>>>        If (bBindSession) Begin
39299>>>>>            Move "1" to sCode
39300>>>>>            Get psSessionKey of (SessionManager(Self)) to sVal
39301>>>>>                         
39301>>>>>            Move (sVal + "||") to sKey
39302>>>>>        End
39302>>>>>>
39302>>>>>        Else Begin
39303>>>>>            Move "0" to sCode
39304>>>>>        End
39304>>>>>>
39304>>>>>        
39304>>>>>        //  If the resource is only temporary available we add the expiration date & time
39304>>>>>        If (iTimeout > 0) Begin
39306>>>>>            Move (sCode + "1") to sCode    
39307>>>>>            Move (DateSetDay(tsDiff, iTimeout / 24)) to tsDiff
39308>>>>>            Move (DateSetHour(tsDiff, Mod(iTimeout, 24))) to tsDiff
39309>>>>>            Move (CurrentDateTime() + tsDiff) to dtTimeout
39310>>>>>            Move (sKey + String(dtTimeout) + "||") to sKey
39311>>>>>        End
39311>>>>>>
39311>>>>>        Else Begin
39312>>>>>            Move (sCode + "0") to sCode
39313>>>>>        End
39313>>>>>>
39313>>>>>        
39313>>>>>        
39313>>>>>        //  Add code to the key
39313>>>>>        Move (sCode + "||" + sKey + sPath) to sKey
39314>>>>>        
39314>>>>>        
39314>>>>>        //  Add file changed date-time to the key to prevent caching issues
39314>>>>>        If (bExists) Begin
39316>>>>>            Get_File_Mod_Time sPath to dChanged iH iM iSec
39320>>>>>            Move ((iH * 3600) + (iM * 60) + iSec) to iTime
39321>>>>>        End
39321>>>>>>
39321>>>>>        Move (sKey + "||" + String(Integer(dChanged)) + "-" + String(iTime)) to sKey
39322>>>>>                
39322>>>>>        //  Encrypt the key
39322>>>>>        Get EncryptKey sKey to sResource
39323>>>>>        
39323>>>>>        //  If no download name is given we use actual name
39323>>>>>        If (sDownloadFileName = "") Begin
39325>>>>>            Move (RightPos("\", sPath)) to iPos
39326>>>>>            Move (Right(sPath, Length(sPath) - iPos)) to sDownloadFileName
39327>>>>>        End
39327>>>>>>
39327>>>>>        
39327>>>>>        //  Assemble URL
39327>>>>>        Get psResourceUrl to sUrl
39328>>>>>        If (Right(sUrl, 1) <> "/") Begin
39330>>>>>            Move (sUrl + "/") to sUrl
39331>>>>>        End
39331>>>>>>
39331>>>>>        
39331>>>>>        Function_Return (sUrl + sDownloadFileName + "?" + If(bAttachment, "attach=true&", "") + "key=" + sResource)
39332>>>>>    End_Function

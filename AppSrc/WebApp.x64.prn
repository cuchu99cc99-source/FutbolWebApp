32589>>>>>>>>>    Procedure SuggestionsSQLFullText String sSearch tSuggestion[] ByRef aSuggestions
32591>>>>>>>>>        Integer iFile iField iIndex iRow iMax
32591>>>>>>>>>        Handle hoServer
32591>>>>>>>>>        Boolean bContinue bOrigActive  bOldRelate bNeedsRelate
32591>>>>>>>>>        String sVal sOrigFilter sFilter sFile sField
32591>>>>>>>>>        
32591>>>>>>>>>        Get Server to hoServer
32592>>>>>>>>>        Get Data_File  to iFile
32593>>>>>>>>>        Get Data_Field to iField       
32594>>>>>>>>>        
32594>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
32596>>>>>>>>>            
32596>>>>>>>>>            // make sure we send DD messages to owner DDO
32596>>>>>>>>>            Get Which_Data_Set of hoServer iFile to hoServer
32597>>>>>>>>>            If (hoServer=0) Begin
32599>>>>>>>>>                Procedure_Return
32600>>>>>>>>>            End
32600>>>>>>>>>>
32600>>>>>>>>>            
32600>>>>>>>>>            WebGet piMaxResults to iMax
32601>>>>>>>>>            Get piFindIndex to iIndex
32602>>>>>>>>>            If (iIndex <= 0) Begin
32604>>>>>>>>>                Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
32607>>>>>>>>>            End
32607>>>>>>>>>>
32607>>>>>>>>>            
32607>>>>>>>>>            //  Determine current filter settings
32607>>>>>>>>>            Get psSQLFilter of hoServer to sOrigFilter
32608>>>>>>>>>            Get pbUseDDSqlFilters of hoServer to bOrigActive
32609>>>>>>>>>            
32609>>>>>>>>>            // generate the Like filter string
32609>>>>>>>>>            Get SQLStrLike of hoServer iField sSearch to sFilter
32610>>>>>>>>>            // If filtering was active append this to what's there
32610>>>>>>>>>            If (bOrigActive) Begin
32612>>>>>>>>>                Get SQLStrAppend of hoServer sOrigFilter sFilter to sFilter
32613>>>>>>>>>            End
32613>>>>>>>>>>
32613>>>>>>>>>            
32613>>>>>>>>>            //  Set filter
32613>>>>>>>>>            Set psSQLFilter of hoServer to sFilter
32614>>>>>>>>>            Set pbUseDDSqlFilters of hoServer to True
32615>>>>>>>>>            
32615>>>>>>>>>            
32615>>>>>>>>>            // this will optimize No_relate. If your DF constraint does not
32615>>>>>>>>>            // need a post-relate test, we will disabled relates for this
32615>>>>>>>>>            Get No_Relate_State of hoServer to bOldRelate
32616>>>>>>>>>            Get DDOConstraintNeedsRelate of hoServer iIndex to bNeedsRelate
32617>>>>>>>>>            Set No_Relate_State of hoServer to (not(bNeedsRelate))
32618>>>>>>>>>
32618>>>>>>>>>            //  Find records
32618>>>>>>>>>            Move True to bContinue
32619>>>>>>>>>            Move 0 to iRow
32620>>>>>>>>>            
32620>>>>>>>>>            Send Request_Read of hoServer FIRST_RECORD iFile iIndex
32621>>>>>>>>>            
32621>>>>>>>>>            While (bContinue)
32625>>>>>>>>>                Get_Field_Value iFile iField to sVal
32628>>>>>>>>>                
32628>>>>>>>>>                If (Found) Begin // and ((bCase and sVal contains sSearch) or (not(bCase) and Lowercase(sVal) contains sLowSearch))) Begin
32630>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile)))  to aSuggestions[iRow].sRowId
32631>>>>>>>>>                    Move (Trim(sVal))                       to aSuggestions[iRow].aValues[0]
32632>>>>>>>>>                    Increment iRow
32633>>>>>>>>>                    
32633>>>>>>>>>                    Move (iRow < iMax) to bContinue
32634>>>>>>>>>                   
32634>>>>>>>>>                    Send Request_Read of hoServer GT iFile iIndex 
32635>>>>>>>>>                End
32635>>>>>>>>>>
32635>>>>>>>>>                Else Begin
32636>>>>>>>>>                    Move False to bContinue
32637>>>>>>>>>                End
32637>>>>>>>>>>
32637>>>>>>>>>                
32637>>>>>>>>>            Loop
32638>>>>>>>>>>
32638>>>>>>>>>            
32638>>>>>>>>>            //  Restore filters
32638>>>>>>>>>            Set psSQLFilter of hoServer to sOrigFilter
32639>>>>>>>>>            Set pbUseDDSqlFilters of hoServer to bOrigActive
32640>>>>>>>>>            Set No_Relate_State of hoServer to bOldRelate
32641>>>>>>>>>        End
32641>>>>>>>>>>
32641>>>>>>>>>    End_Procedure
32642>>>>>>>>>    
32642>>>>>>>>>    Procedure SuggestionsValidation String sSearch tSuggestion[] ByRef aSuggestions Boolean bFullText
32644>>>>>>>>>        Handle hoServer hoTable
32644>>>>>>>>>        Integer iFile iField iRow iCount iFound iMax iLen
32644>>>>>>>>>        Variant[][] aData
32645>>>>>>>>>        Boolean bCaseSensitive bContinue
32645>>>>>>>>>        String sDescr sVal
32645>>>>>>>>>        
32645>>>>>>>>>        Get Server to hoServer
32646>>>>>>>>>        Get Data_File  to iFile
32647>>>>>>>>>        Get Data_Field to iField       
32648>>>>>>>>>        
32648>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
32650>>>>>>>>>            Get File_Field_Table_Object of hoServer iFile iField to hoTable
32651>>>>>>>>>            If (hoTable <> 0) Begin
32653>>>>>>>>>                Get tabledata of hoTable to aData
32654>>>>>>>>>        
32654>>>>>>>>>                WebGet piMaxResults to iMax
32655>>>>>>>>>                WebGet pbCaseSensitive to bCaseSensitive  
32656>>>>>>>>>            
32656>>>>>>>>>                If (not(bCaseSensitive)) Begin
32658>>>>>>>>>                    Move (Lowercase(sSearch)) to sSearch
32659>>>>>>>>>                End
32659>>>>>>>>>>
32659>>>>>>>>>                
32659>>>>>>>>>                
32659>>>>>>>>>                Move (SizeOfArray(aData)) to iCount
32660>>>>>>>>>                Move 0 to iRow
32661>>>>>>>>>                Move (Length(sSearch)) to iLen
32662>>>>>>>>>                Move True to bContinue
32663>>>>>>>>>                
32663>>>>>>>>>            
32663>>>>>>>>>                While (iFound < iMax and iRow < iCount and bContinue)
32667>>>>>>>>>                    If (not(bCaseSensitive)) Begin
32669>>>>>>>>>                        Move (Lowercase(aData[iRow][0])) to sVal
32670>>>>>>>>>                        Move (Lowercase(aData[iRow][1])) to sDescr
32671>>>>>>>>>                    End
32671>>>>>>>>>>
32671>>>>>>>>>                    Else Begin
32672>>>>>>>>>                        Move aData[iRow][0] to sVal
32673>>>>>>>>>                        Move aData[iRow][1] to sDescr
32674>>>>>>>>>                    End
32674>>>>>>>>>>
32674>>>>>>>>>                    
32674>>>>>>>>>                    If ((bFullText and (sVal contains sSearch)) or (not(bFullText) and (Left(sVal, iLen) = sSearch))) Begin
32676>>>>>>>>>                        Move aData[iRow][0] to aSuggestions[iFound].sRowId
32677>>>>>>>>>                        Move aData[iRow][0] to aSuggestions[iFound].aValues[0]
32678>>>>>>>>>                        Move aData[iRow][1] to aSuggestions[iFound].aValues[1]
32679>>>>>>>>>                        Increment iFound
32680>>>>>>>>>                    End
32680>>>>>>>>>>
32680>>>>>>>>>                    Else Begin
32681>>>>>>>>>                        Move (bFullText or iFound = 0) to bContinue
32682>>>>>>>>>                    End
32682>>>>>>>>>>
32682>>>>>>>>>                    
32682>>>>>>>>>                    Increment iRow
32683>>>>>>>>>                Loop
32684>>>>>>>>>>
32684>>>>>>>>>            End
32684>>>>>>>>>>
32684>>>>>>>>>        End
32684>>>>>>>>>>
32684>>>>>>>>>         
32684>>>>>>>>>    End_Procedure

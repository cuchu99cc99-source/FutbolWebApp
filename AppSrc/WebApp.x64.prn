35409>>>>>>>    Procedure DisplayExistingFile String sPath
35411>>>>>>>        Boolean bExists
35411>>>>>>>        Integer iChnl iSize iPos
35411>>>>>>>        String sFileName
35411>>>>>>>        
35411>>>>>>>        Move 0 to iSize
35412>>>>>>>        
35412>>>>>>>        File_Exist sPath bExists
35413>>>>>>>        
35413>>>>>>>        Move (RightPos("\", sPath)) to iPos
35414>>>>>>>        Move (Right(sPath, Length(sPath) - iPos)) to sFileName
35415>>>>>>>        
35415>>>>>>>        
35415>>>>>>>        If (bExists) Begin
35417>>>>>>>            //  Determine file size
35417>>>>>>>            Move (Seq_New_Channel()) to iChnl
35418>>>>>>>            If (iChnl >= 0) Begin
35420>>>>>>>                Direct_Input channel iChnl sPath
35422>>>>>>>                Get_Channel_Size iChnl to iSize
35423>>>>>>>                Close_Input iChnl
35424>>>>>>>                Send Seq_Release_Channel iChnl
35425>>>>>>>            End
35425>>>>>>>>
35425>>>>>>>            Else If (iChnl = -1) Begin
35428>>>>>>>                Error DFErr_Program "I/O Channel Error"
35429>>>>>>>>
35429>>>>>>>            End
35429>>>>>>>>
35429>>>>>>>            Else If (iChnl = -2) Begin
35432>>>>>>>                Error DFErr_Program "No I/O Channel Available"
35433>>>>>>>>
35433>>>>>>>            End
35433>>>>>>>>
35433>>>>>>>        End
35433>>>>>>>>
35433>>>>>>>        
35433>>>>>>>        WebSet psFileName to sFileName
35434>>>>>>>        WebSet piFileSize to iSize
35435>>>>>>>        WebSet psFileMime to ""
35436>>>>>>>        WebSet peState to ciUploadStateDisplay
35437>>>>>>>        
35437>>>>>>>        Send ClientAction "updateDetails"
35438>>>>>>>    End_Procedure

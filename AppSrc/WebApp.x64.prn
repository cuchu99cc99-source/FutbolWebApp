38230>>>>>>>    Procedure OnSelectSuggestion tSuggestion Suggestion
38232>>>>>>>        Handle hoServer hoSelectionSource
38232>>>>>>>        Integer iFile
38232>>>>>>>        Boolean bSuccess bSourceIsValidationTable
38232>>>>>>>        RowID rRowId
38232>>>>>>>        
38232>>>>>>>        Get Server to hoServer
38233>>>>>>>        
38233>>>>>>>        If ((hoServer <> 0)) Begin
38235>>>>>>>            Get Data_File to iFile     
38236>>>>>>>            Get phoSelectionSource to hoSelectionSource 
38237>>>>>>>            Get pbSourceIsValidationTable of hoSelectionSource to bSourceIsValidationTable
38238>>>>>>>            
38238>>>>>>>            If (not(bSourceIsValidationTable) and (iFile <> 0)) Begin
38240>>>>>>>                Move (DeserializeRowID(Suggestion.sRowId)) to rRowId    
38241>>>>>>>                If (not(IsNullRowID(rRowId))) Begin
38243>>>>>>>                    Get FindByRowIdEx of hoServer iFile rRowId to bSuccess
38244>>>>>>>                    // this is very unlikely
38244>>>>>>>                    If (not (bSuccess)) Begin
38246>>>>>>>                        Error DFERR_CANT_REFIND_RECORD
38247>>>>>>>>
38247>>>>>>>                    End
38247>>>>>>>>
38247>>>>>>>                End
38247>>>>>>>>
38247>>>>>>>            End
38247>>>>>>>>
38247>>>>>>>            Else Begin
38248>>>>>>>                WebSet psValue to Suggestion.aValues[0]
38249>>>>>>>                WebSet pbChanged to True
38250>>>>>>>            End 
38250>>>>>>>>
38250>>>>>>>        End
38250>>>>>>>>
38250>>>>>>>        Else Begin
38251>>>>>>>            WebSet psValue to Suggestion.aValues[0]
38252>>>>>>>            WebSet pbChanged to True
38253>>>>>>>        End
38253>>>>>>>>
38253>>>>>>>    End_Procedure
38254>>>>>>>    

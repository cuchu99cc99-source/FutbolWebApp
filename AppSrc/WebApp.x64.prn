776>>>>>>>>>>>    Else If (DfltBtn = 1 or DfltBtn = MB_DEFBUTTON2);        Move MB_DEFBUTTON2 to Dflt
780>>>>>>>>>>>    Else ;        Move MB_DEFBUTTON3 to Dflt
782>>>>>>>>>>>    

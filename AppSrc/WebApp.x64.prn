29587>>>>>>>>>>>    
29587>>>>>>>>>>>        // Parses a content-type header string and splits it into just the content-type (put into 
29587>>>>>>>>>>>    // sContenttype passed by reference) and returns an array of name value pairs that were in the 
29587>>>>>>>>>>>    // content-type string.
29587>>>>>>>>>>>    Function ParseContentType String ByRef sContentType Returns tNameValuePair[]
29589>>>>>>>>>>>        tNameValuePair[] aValues
29589>>>>>>>>>>>        tNameValuePair[] aValues
29590>>>>>>>>>>>        String[] aParts aPair
29592>>>>>>>>>>>        Integer iPart iVal
29592>>>>>>>>>>>        
29592>>>>>>>>>>>        Move (StrSplitToArray(sContentType, ";")) to aParts
29593>>>>>>>>>>>        If (SizeOfArray(aParts) > 0) Begin
29595>>>>>>>>>>>            Move aParts[0] to sContentType
29596>>>>>>>>>>>            
29596>>>>>>>>>>>            For iPart from 1 to (SizeOfArray(aParts) - 1)
29602>>>>>>>>>>>>
29602>>>>>>>>>>>                Move (StrSplitToArray(aParts[iPart], "=")) to aPair
29603>>>>>>>>>>>                If (SizeOfArray(aPair) > 1) Begin
29605>>>>>>>>>>>                    Move (Trim(Uppercase(aPair[0]))) to aValues[iVal].sName
29606>>>>>>>>>>>                    Move (Trim(aPair[1])) to aValues[iVal].sValue
29607>>>>>>>>>>>                End
29607>>>>>>>>>>>>
29607>>>>>>>>>>>            Loop
29608>>>>>>>>>>>>
29608>>>>>>>>>>>        End
29608>>>>>>>>>>>>
29608>>>>>>>>>>>        
29608>>>>>>>>>>>        Function_Return aValues
29609>>>>>>>>>>>    End_Function

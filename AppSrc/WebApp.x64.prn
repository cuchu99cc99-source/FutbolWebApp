34807>>>>>>>    // Returns server to use for reading and constraints.
34807>>>>>>>    // If pbAutoServer is set, return the matching DD from the invoking DEO's view.
34807>>>>>>>    // if not set, the server is also the reading server.
34807>>>>>>>    Function ReadingServer Returns Handle
34809>>>>>>>        Handle hoDD hoInvokingDEO hoInvokingDD
34809>>>>>>>        Integer iMain
34809>>>>>>>        Boolean bAutoServer
34809>>>>>>>
34809>>>>>>>        Get Server to hoDD
34810>>>>>>>
34810>>>>>>>        Get pbAutoServer to bAutoServer
34811>>>>>>>        If bAutoServer Begin           
34813>>>>>>>            Get GetInvokingObject to hoInvokingDEO
34814>>>>>>>            If hoInvokingDEO Begin
34816>>>>>>>                Get Main_File of hoDD to iMain
34817>>>>>>>                Get Server of hoInvokingDEO to hoInvokingDD
34818>>>>>>>                Get Which_Data_Set of hoInvokingDD iMain to hoInvokingDD
34819>>>>>>>                If hoInvokingDD Begin
34821>>>>>>>                    Move hoInvokingDD to hoDD
34822>>>>>>>                End
34822>>>>>>>>
34822>>>>>>>            End
34822>>>>>>>>
34822>>>>>>>        End
34822>>>>>>>>
34822>>>>>>>        Function_Return hoDD
34823>>>>>>>    End_Function
34824>>>>>>>
34824>>>>>>>    // this must be augmented to handle auto-server searches
34824>>>>>>>    Procedure OnSearch String sSearchText
34826>>>>>>>        Integer iCol 
34826>>>>>>>        Boolean bReverseOrdering bFound bAutoServer
34826>>>>>>>        Integer iOrdering iFile
34826>>>>>>>        Handle hoCol hoServer hoReadingServer
34826>>>>>>>        
34826>>>>>>>        Get pbAutoServer to bAutoServer
34827>>>>>>>        If not bAutoServer Begin
34829>>>>>>>            Forward Send OnSearch sSearchText
34831>>>>>>>        End
34831>>>>>>>>
34831>>>>>>>        Else Begin
34832>>>>>>>            WebGet piSortColumn to iCol
34833>>>>>>>            
34833>>>>>>>            If (iCol>=0) Begin
34835>>>>>>>                Get GetColumnObject iCol to hoCol
34836>>>>>>>                Get Server to hoServer               // the prompt lists server
34837>>>>>>>                Get ReadingServer to hoReadingServer // invoking server used for constained reads
34838>>>>>>>                If (hoServer=0) Begin
34840>>>>>>>                    Procedure_Return
34841>>>>>>>                End
34841>>>>>>>>
34841>>>>>>>                            
34841>>>>>>>                Send DDSetChangedValue of hoCol sSearchText
34842>>>>>>>                WebGet pbReverseOrdering to bReverseOrdering
34843>>>>>>>                Get IndexOrder to iOrdering
34844>>>>>>>                Get Main_File of hoServer to iFile
34845>>>>>>>                
34845>>>>>>>                // entry update based on the prompt list server (that's where the search value is)
34845>>>>>>>                Send Request_Entry_Update of hoServer iFile 1
34846>>>>>>>                
34846>>>>>>>                // read record for reading server (the invoking server)
34846>>>>>>>                Get ReadDDRecordInBuffer hoReadingServer iOrdering bReverseOrdering to bFound
34847>>>>>>>                
34847>>>>>>>                If bFound Begin
34849>>>>>>>                    // tell prompt list server about this record. This will update the list
34849>>>>>>>                    Send Request_Assign of hoServer
34850>>>>>>>                End
34850>>>>>>>>
34850>>>>>>>            End
34850>>>>>>>>
34850>>>>>>>        End
34850>>>>>>>>
34850>>>>>>>    End_Procedure
34851>>>>>>>End_Class

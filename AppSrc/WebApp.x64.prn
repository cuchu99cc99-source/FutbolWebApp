33839>>>>>>>    // Delete Logic to delete the current row pointed to by psCurrentRowId.
33839>>>>>>>    // returns True if the delete was successful.
33839>>>>>>>    Function DeleteSelectedRow Returns Integer
33841>>>>>>>        Handle hmVerify
33841>>>>>>>        Boolean bContinue
33841>>>>>>>        
33841>>>>>>>        Get pbAllowDeleteRow to bContinue
33842>>>>>>>        If (not(bContinue)) Begin
33844>>>>>>>            Error DFERR_OPERATION_NOT_ALLOWED
33845>>>>>>>>
33845>>>>>>>            Procedure_Return
33846>>>>>>>        End
33846>>>>>>>>
33846>>>>>>>        
33846>>>>>>>        Get Verify_Delete_msg to hmVerify
33847>>>>>>>        If (hmVerify) Begin
33849>>>>>>>            WebSet pbDeleteCallbackActive to True
33850>>>>>>>            Send VerifyRequest (RefProc(RequestDeleteCallBack)) (RefFunc(Verify_Delete_Msg))
33851>>>>>>>            Function_Return sroPending
33852>>>>>>>        End
33852>>>>>>>>
33852>>>>>>>        Else Begin
33853>>>>>>>            Send RequestDeleteExec
33854>>>>>>>            // we actually don't know if this will work or not, since this finds another row. For now, we say success
33854>>>>>>>        End
33854>>>>>>>>
33854>>>>>>>        Function_Return sroSucceed
33855>>>>>>>    End_Function
33856>>>>>>>    
33856>>>>>>>    Procedure RequestDeleteExec
33858>>>>>>>        Handle hoDD
33858>>>>>>>        RowID riSelectedRow
33858>>>>>>>        String[] aSelection
33859>>>>>>>        Integer iIndex iMainFile iOrdering
33859>>>>>>>        Boolean bDataAware bContinue bReverseOrdering
33859>>>>>>>
33859>>>>>>>        Get ListSelection to aSelection
33860>>>>>>>        If (SizeOfArray(aSelection) = 0) Begin
33862>>>>>>>            Procedure_Return
33863>>>>>>>        End
33863>>>>>>>>
33863>>>>>>>        
33863>>>>>>>        Get pbAllowDeleteRow to bContinue
33864>>>>>>>        If (not(bContinue)) Begin
33866>>>>>>>            Error DFERR_OPERATION_NOT_ALLOWED
33867>>>>>>>>
33867>>>>>>>            Procedure_Return
33868>>>>>>>        End
33868>>>>>>>>
33868>>>>>>>        
33868>>>>>>>        Get pbDataAware to bDataAware
33869>>>>>>>        
33869>>>>>>>        If (bDataAware) Begin
33871>>>>>>>            // Perform the db-aware delete
33871>>>>>>>            Get ReadingServer to hoDD
33872>>>>>>>            Get Main_File of hoDD to iMainFile
33873>>>>>>>                
33873>>>>>>>            While (iIndex < SizeOfArray(aSelection))
33877>>>>>>>                Move (DeserializeRowID(aSelection[iIndex])) to riSelectedRow
33878>>>>>>>                
33878>>>>>>>                Get FindByRowIdEx of hoDD iMainFile riSelectedRow to bContinue
33879>>>>>>>                If (bContinue) Begin
33881>>>>>>>                    Get OnDeleteRow aSelection[iIndex] to bContinue
33882>>>>>>>                    If (bContinue) Begin
33884>>>>>>>                        Send Request_Delete to hoDD       // Perform the delete
33885>>>>>>>                        If (not(Err)) Begin
33887>>>>>>>                            Send RemoveRow aSelection[iIndex]      // Tell the client to remove the deleted row.
33888>>>>>>>                            Move (RemoveFromArray(aSelection, iIndex)) to aSelection
33889>>>>>>>                        End
33889>>>>>>>>
33889>>>>>>>                        Else Begin
33890>>>>>>>                            Increment iIndex
33891>>>>>>>                        End
33891>>>>>>>>
33891>>>>>>>                    End
33891>>>>>>>>
33891>>>>>>>                    Else Begin
33892>>>>>>>                        Increment iIndex
33893>>>>>>>                    End
33893>>>>>>>>
33893>>>>>>>                End
33893>>>>>>>>
33893>>>>>>>                Else Begin
33894>>>>>>>                    Increment iIndex
33895>>>>>>>                End
33895>>>>>>>>
33895>>>>>>>            Loop
33896>>>>>>>>
33896>>>>>>>            
33896>>>>>>>            // Select the next logical row
33896>>>>>>>            Get IndexOrder to iOrdering
33897>>>>>>>            WebGet pbReverseOrdering to bReverseOrdering
33898>>>>>>>    
33898>>>>>>>            If (bReverseOrdering) Begin
33900>>>>>>>                Send Establish_Find_Direction of hoDD LT iMainFile iOrdering 
33901>>>>>>>            End
33901>>>>>>>>
33901>>>>>>>            Else Begin
33902>>>>>>>                Send Establish_Find_Direction of hoDD GT iMainFile iOrdering 
33903>>>>>>>            End
33903>>>>>>>>
33903>>>>>>>            
33903>>>>>>>            Send Locate_Next of hoDD    // Try to find the row below the deleted row.
33904>>>>>>>            
33904>>>>>>>            If (not(Found)) Begin
33906>>>>>>>                // If the row below the deleted row was not found then it means we deleted the
33906>>>>>>>                // last row. Now we will try to load the new last row. If there are no remaining
33906>>>>>>>                // rows in the dataset then the buffer will be automatically cleared (which is 
33906>>>>>>>                // what we want)
33906>>>>>>>                If (bReverseOrdering) Begin
33908>>>>>>>                    Send Request_Read of hoDD FIRST_RECORD iMainFile iOrdering
33909>>>>>>>                End
33909>>>>>>>>
33909>>>>>>>                Else Begin
33910>>>>>>>                    Send Request_Read of hoDD LAST_RECORD iMainFile iOrdering
33911>>>>>>>                End
33911>>>>>>>>
33911>>>>>>>            End
33911>>>>>>>>
33911>>>>>>>            
33911>>>>>>>            If (Found) Begin
33913>>>>>>>                Send Request_Assign of hoDD iMainFile
33914>>>>>>>            End
33914>>>>>>>>
33914>>>>>>>            Else Begin
33915>>>>>>>                Send ClearGrid
33916>>>>>>>            End
33916>>>>>>>>
33916>>>>>>>            
33916>>>>>>>            Send UpdateCurrentRowID
33917>>>>>>>        End
33917>>>>>>>>
33917>>>>>>>        Else Begin
33918>>>>>>>            While (iIndex < SizeOfArray(aSelection))
33922>>>>>>>                Get OnDeleteRow aSelection[iIndex] to bContinue
33923>>>>>>>                If (bContinue) Begin
33925>>>>>>>                    Send RemoveRow aSelection[iIndex]      // Tell the client to remove the deleted row.
33926>>>>>>>                    Move (RemoveFromArray(aSelection, iIndex)) to aSelection
33927>>>>>>>                End
33927>>>>>>>>
33927>>>>>>>                Else Begin
33928>>>>>>>                    Increment iIndex
33929>>>>>>>                End
33929>>>>>>>>
33929>>>>>>>            Loop
33930>>>>>>>>
33930>>>>>>>        End
33930>>>>>>>>
33930>>>>>>>            
33930>>>>>>>        If (iIndex) Begin
33932>>>>>>>            Send OnMultipleRowsDeletionError aSelection
33933>>>>>>>        End
33933>>>>>>>>
33933>>>>>>>        
33933>>>>>>>        WebSet pbAllSelected to False
33934>>>>>>>        Set ListSelection to aSelection
33935>>>>>>>    End_Procedure
33936>>>>>>>    
33936>>>>>>>    Procedure OnMultipleRowsDeletionError String[] aNonDeletedSelection
33938>>>>>>>        If (pbThrowErrorIfDeleteFails(Self)) Begin
33940>>>>>>>            Error DFERR_CANT_DELETE_RECORD (SFormat(C_$FailedToDeleteNrRecords, SizeOfArray(aNonDeletedSelection)))
33941>>>>>>>>
33941>>>>>>>        End
33941>>>>>>>>
33941>>>>>>>    End_Procedure
33942>>>>>>>
33942>>>>>>>End_Class

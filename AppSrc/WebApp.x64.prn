25253>>>>>>>>>>>>>    Function StrSplitToArrayUnescapedWithTrim String sStr String sDel Returns String[]
25255>>>>>>>>>>>>>        Integer iCounter iLast iLength iDelLength iEscapedLength
25255>>>>>>>>>>>>>        String sEscapedDel
25255>>>>>>>>>>>>>        String[] aValues
25256>>>>>>>>>>>>>        
25256>>>>>>>>>>>>>        Move 1 to iLast
25257>>>>>>>>>>>>>        Move (Length(sStr)) to iLength
25258>>>>>>>>>>>>>        Move (Length(sDel)) to iDelLength
25259>>>>>>>>>>>>>        Move ("\" + sDel) to sEscapedDel
25260>>>>>>>>>>>>>        Move (Length(sEscapedDel)) to iEscapedLength
25261>>>>>>>>>>>>>        
25261>>>>>>>>>>>>>        If (iLength = 0) Begin
25263>>>>>>>>>>>>>             Function_Return aValues
25264>>>>>>>>>>>>>        End
25264>>>>>>>>>>>>>>
25264>>>>>>>>>>>>>        
25264>>>>>>>>>>>>>        For iCounter from 1 to iLength
25270>>>>>>>>>>>>>>
25270>>>>>>>>>>>>>            If (Mid(sStr, iDelLength, iCounter) = sDel and ;                Mid(sStr, iEscapedLength, iCounter - 1) <> sEscapedDel) Begin
25272>>>>>>>>>>>>>                Move (Trim(Replaces(sEscapedDel, Mid(sStr, iCounter - iLast, iLast), sDel))) to aValues[SizeOfArray(aValues)]
25273>>>>>>>>>>>>>                Move (iCounter + 1) to iLast
25274>>>>>>>>>>>>>            End
25274>>>>>>>>>>>>>>
25274>>>>>>>>>>>>>        Loop
25275>>>>>>>>>>>>>>
25275>>>>>>>>>>>>>        Move (Trim(Replaces(sEscapedDel, Mid(sStr, iCounter - iLast, iLast), sDel))) to aValues[SizeOfArray(aValues)]
25276>>>>>>>>>>>>>        Function_Return aValues
25277>>>>>>>>>>>>>    End_Function
25278>>>>>>>>>>>>>    
25278>>>>>>>>>>>>>    Function StrReplacesUnescaped String sReplace String sStr String sWith Returns String
25280>>>>>>>>>>>>>        Integer iCounter iLast iDelLength iEscapedLength
25280>>>>>>>>>>>>>        String sEscapedDel sPre sPost
25280>>>>>>>>>>>>>        
25280>>>>>>>>>>>>>        Move 1 to iLast
25281>>>>>>>>>>>>>        Move (Length(sReplace)) to iDelLength
25282>>>>>>>>>>>>>        Move ("\" + sReplace) to sEscapedDel
25283>>>>>>>>>>>>>        Move (Length(sEscapedDel)) to iEscapedLength
25284>>>>>>>>>>>>>        
25284>>>>>>>>>>>>>        If ((Length(sStr)) = 0) Begin
25286>>>>>>>>>>>>>            Function_Return sStr
25287>>>>>>>>>>>>>        End
25287>>>>>>>>>>>>>>
25287>>>>>>>>>>>>>        
25287>>>>>>>>>>>>>        While (iCounter <= Length(sStr))
25291>>>>>>>>>>>>>            If (Mid(sStr, iDelLength, iCounter) = sReplace and Mid(sStr, iEscapedLength, iCounter - 1) <> sEscapedDel) Begin
25293>>>>>>>>>>>>>                Move (Left(sStr, iCounter - iDelLength) + sWith + Mid(sStr, (Length(sStr)) - iCounter, iCounter + 1)) to sStr
25294>>>>>>>>>>>>>                Move (iCounter + iEscapedLength - 1) to iCounter
25295>>>>>>>>>>>>>                Move (iCounter + 1) to iLast
25296>>>>>>>>>>>>>            End
25296>>>>>>>>>>>>>>
25296>>>>>>>>>>>>>            Increment iCounter
25297>>>>>>>>>>>>>        Loop
25298>>>>>>>>>>>>>>
25298>>>>>>>>>>>>>        Function_Return sStr
25299>>>>>>>>>>>>>    End_Function

33757>>>>>>>    Procedure FindAllRecords String[] ByRef aSelection
33759>>>>>>>        Integer iMainFile iPrimaryIndex
33759>>>>>>>        Boolean bOk
33759>>>>>>>        Handle hoDD
33759>>>>>>>
33759>>>>>>>        Get ReadingServer to hoDD
33760>>>>>>>        Get Main_File of hoDD to iMainFile
33761>>>>>>>        Get_Attribute DF_FILE_PRIMARY_INDEX of iMainFile to iPrimaryIndex
33764>>>>>>>
33764>>>>>>>        Send Request_Read of hoDD FIRST_RECORD iMainFile iPrimaryIndex
33765>>>>>>>        Move Found to bOk
33766>>>>>>>
33766>>>>>>>        While (bOk)
33770>>>>>>>            Move (SerializeRowID (GetRowID(iMainFile))) to aSelection[-1]
33771>>>>>>>
33771>>>>>>>            Send Request_Read of hoDD GT iMainFile iPrimaryIndex
33772>>>>>>>            Move Found to bOk
33773>>>>>>>        Loop

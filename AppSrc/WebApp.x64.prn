25077>>>>>>>>>>>>>>>    Procedure CreateNewByValue String sValue
25079>>>>>>>>>>>>>>>        tSelectionItem oNewItem
25079>>>>>>>>>>>>>>>        tSelectionItem oNewItem
25079>>>>>>>>>>>>>>>        Boolean bCancel bFound bErr bAllowCreate bSuccess
25079>>>>>>>>>>>>>>>        Integer iFile iField
25079>>>>>>>>>>>>>>>        Handle hoSelectionSource hoServer hoTable
25079>>>>>>>>>>>>>>>        
25079>>>>>>>>>>>>>>>        Get pbAllowCreate to bAllowCreate
25080>>>>>>>>>>>>>>>        If (not(bAllowCreate)) ;            Procedure_Return
25083>>>>>>>>>>>>>>>        
25083>>>>>>>>>>>>>>>        Move sValue to oNewItem.aValues[0]
25084>>>>>>>>>>>>>>>        Send OnCreate (&oNewItem) (&bCancel)
25085>>>>>>>>>>>>>>>        
25085>>>>>>>>>>>>>>>        If (bCancel) ;            Procedure_Return
25088>>>>>>>>>>>>>>>        
25088>>>>>>>>>>>>>>>        Get phoSelectionSource to hoSelectionSource
25089>>>>>>>>>>>>>>>        
25089>>>>>>>>>>>>>>>        If (hoSelectionSource > 0) Begin
25091>>>>>>>>>>>>>>>            If (pbAutoCreate(hoSelectionSource)) Begin
25093>>>>>>>>>>>>>>>                Get CreateItem of hoSelectionSource (&oNewItem) oNewItem.aValues[0] to bSuccess
25094>>>>>>>>>>>>>>>                If (not(bSuccess)) ;                    Procedure_Return
25097>>>>>>>>>>>>>>>            End

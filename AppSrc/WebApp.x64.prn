14551>>>>>>>>>    // As of 9.1, we no longer Augment messages that require OEM/ASNI translation.
14551>>>>>>>>>    // Flexcom now does this for us. This only affects string parameters.
14551>>>>>>>>>    // Note that all data passed through VDFISData already is properly converted
14551>>>>>>>>>    
14551>>>>>>>>>    Procedure OutputHTMLtoTestFile String sHtml
14553>>>>>>>>>        String sFile
14553>>>>>>>>>        Get psHtmlOutPutFileName to sFile
14554>>>>>>>>>        If (sFile<>"") Begin
14556>>>>>>>>>            If (not(pbFirstTimeOpen(Self))) Begin
14558>>>>>>>>>                Direct_Output channel C_HtmlOutputFileChannel sFile
14560>>>>>>>>>                Set pbFirstTimeOpen to True
14561>>>>>>>>>            End
14561>>>>>>>>>>
14561>>>>>>>>>            Else ;                Append_Output channel C_HtmlOutputFileChannel sFile
14564>>>>>>>>>        End
14564>>>>>>>>>>
14564>>>>>>>>>        Write channel C_HtmlOutputFileChannel sHtml
14566>>>>>>>>>        Close_Output channel C_HtmlOutputFileChannel
14568>>>>>>>>>    End_Procedure
14569>>>>>>>>>    
14569>>>>>>>>>    Procedure OutputHtml String sHtml
14571>>>>>>>>>        Integer iOut
14571>>>>>>>>>        Get peHtmlOutput to iOut
14572>>>>>>>>>        If (iOut iand C_hoNormal) ;            Forward Send OutputHtml sHtml
14576>>>>>>>>>        If (iOut iand C_hoConsole) ;            Showln sHtml
14580>>>>>>>>>        If (iOut iand C_hoFile) ;            Send OutPutHtmltoTestFile sHtml
14583>>>>>>>>>    End_Procedure
14584>>>>>>>>>    
14584>>>>>>>>>    Procedure OutputPlainText String sText

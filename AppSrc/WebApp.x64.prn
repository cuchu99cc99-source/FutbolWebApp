22123>>>>>>>>>>>>>    //  Escapes disallowed characters in a view state partial with their hexadecimal values between
22123>>>>>>>>>>>>>    //  ~ characters. The / and - are escaped because they are used to concatenate the different 
22123>>>>>>>>>>>>>    // pieces.
22123>>>>>>>>>>>>>    //
22123>>>>>>>>>>>>>    // Params:
22123>>>>>>>>>>>>>    //      sHash   The partial hash to escape.
22123>>>>>>>>>>>>>    // Returns:
22123>>>>>>>>>>>>>    //      The escaped partial view state hash.
22123>>>>>>>>>>>>>    Function EscapeViewStatePartial String sHash Returns String
22125>>>>>>>>>>>>>        //  Encode characters used elsewhere in URLs
22125>>>>>>>>>>>>>        Move (Replaces("-", Replaces("/", sHash, "~2f~"), "~5f~")) to sHash
22126>>>>>>>>>>>>>        
22126>>>>>>>>>>>>>        Move (UrlEncode(sHash, True)) to sHash
22127>>>>>>>>>>>>>        
22127>>>>>>>>>>>>>        Function_Return sHash
22128>>>>>>>>>>>>>    End_Function    
22129>>>>>>>>>>>>>    
22129>>>>>>>>>>>>>    // Unescapes a view state partial that has been escaped by EscapeViewStatePartial.
22129>>>>>>>>>>>>>    //
22129>>>>>>>>>>>>>    // Params:
22129>>>>>>>>>>>>>    //      sHash   The partial hash to unescape.
22129>>>>>>>>>>>>>    // Returns:
22129>>>>>>>>>>>>>    //      The unescaped partial view state hash.
22129>>>>>>>>>>>>>    Function UnescapeViewStatePartial String sHash Returns String
22131>>>>>>>>>>>>>        Move (UrlDecode(sHash)) to sHash
22132>>>>>>>>>>>>>        
22132>>>>>>>>>>>>>        //  Decode characters used elsehwere in urls
22132>>>>>>>>>>>>>        Move (Replaces("~5f~", Replaces("~2f~", sHash, "/"), "-")) to sHash
22133>>>>>>>>>>>>>        
22133>>>>>>>>>>>>>        Function_Return sHash
22134>>>>>>>>>>>>>    End_Function 

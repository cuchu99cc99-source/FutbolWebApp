753>>>>>>>>>>>    If (Num_Arguments = 1 or sTitle = '') ;        Move C_$Question to sCaption
756>>>>>>>>>>>    Else ;        Move sTitle     to sCaption
758>>>>>>>>>>>    
758>>>>>>>>>>>    If (Num_Arguments < 3 or DfltBtn = 0 or DfltBtn = MB_DEFBUTTON1);        Move MB_DEFBUTTON1 to Dflt
761>>>>>>>>>>>    Else ;        Move MB_DEFBUTTON2 to Dflt
763>>>>>>>>>>>    
763>>>>>>>>>>>    Move (Message_Box(sMessage, sCaption, MB_YESNO, (MB_ICONQUESTION ior Dflt))) to rval
764>>>>>>>>>>>    
764>>>>>>>>>>>    Function_Return rval
765>>>>>>>>>>>End_Function

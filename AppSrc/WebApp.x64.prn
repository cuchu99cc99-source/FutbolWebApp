38490>>>>>>>    //
38490>>>>>>>    //  Converts the given time to an string that can be saved in the database.
38490>>>>>>>    //
38490>>>>>>>    //  Params:
38490>>>>>>>    //      dtTime  Time to convert
38490>>>>>>>    //  Returns:
38490>>>>>>>    //      String with "HH:MM:SS" format
38490>>>>>>>    //
38490>>>>>>>    Function TimeToString DateTime dtTime Returns String
38492>>>>>>>        String sHours sMinutes sSeconds
38492>>>>>>>        
38492>>>>>>>        //  Extract parts
38492>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
38493>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
38494>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
38495>>>>>>>        
38495>>>>>>>        //  Fill out with 0
38495>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
38498>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
38501>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
38504>>>>>>>        
38504>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
38505>>>>>>>    End_Function
38506>>>>>>>    
38506>>>>>>>    //
38506>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
38506>>>>>>>    //
38506>>>>>>>    //  Params:
38506>>>>>>>    //      dtTime  Datetime variable to add time to
38506>>>>>>>    //      sTimeString String with time in the format "HH:MM:SS"
38506>>>>>>>    //  Returns:
38506>>>>>>>    //      dtDateTime with the loaded time
38506>>>>>>>    //
38506>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
38508>>>>>>>        String sHours sMinutes sSeconds
38508>>>>>>>        
38508>>>>>>>        //  Extract parts
38508>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
38509>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
38510>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
38511>>>>>>>        
38511>>>>>>>        //  Set to DateTime
38511>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
38512>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
38513>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
38514>>>>>>>        
38514>>>>>>>        Function_Return dtTime
38515>>>>>>>    End_Function
38516>>>>>>>End_Class

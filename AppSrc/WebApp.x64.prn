17616>>>>>>>// with this object
17616>>>>>>>Class cWebControlLocator is a cObject
17617>>>>>>>    Procedure Construct_Object
17619>>>>>>>        Forward Send Construct_Object
17621>>>>>>>        
17621>>>>>>>        // Object Reference Arrays
17621>>>>>>>        
17621>>>>>>>        // These two arrays have synchronized members. This means that paWebControlNames
17621>>>>>>>        // can be searched to lookup the corresponding object handle.
17621>>>>>>>        Property tWebControlMapItem[] paWebControls
17622>>>>>>>        
17622>>>>>>>        Property Handle phoWebHost C_WebUnresolvedObject //    Handle to the host (cWebApp / cLocalWebControlHost)
17623>>>>>>>    End_Procedure

38280>>>>>Class cLoginEncryption is a cObject
38281>>>>>    
38281>>>>>    Procedure Construct_Object
38283>>>>>        Forward Send Construct_Object
38285>>>>>        // this must be set to a multi (40ish) character random key
38285>>>>>        Property String psEncryptPassword ""
38286>>>>>        
38286>>>>>        Object oDataCrypter is a cCryptographerEx
38288>>>>>            Set piHash to CALG_SHA_256
38289>>>>>            Set piCipher to CALG_AES_256
38290>>>>>            Set psProvider to "" //  Not providing a specific provider gives the default provider for the provider type
38291>>>>>            Set piProvider to PROV_RSA_AES
38292>>>>>        End_Object
38293>>>>>    End_Procedure
38294>>>>>    
38294>>>>>    // This can be augmented to return a password encryption key using any
38294>>>>>    // hidden mechanism desired.
38294>>>>>    Function GetEncryptionPassword Returns String
38296>>>>>        String sPassword
38296>>>>>        Get psEncryptPassword to sPassword
38297>>>>>        Function_Return sPassword
38298>>>>>    End_Function
38299>>>>>    
38299>>>>>    // Encrypts a string into an unreadable hash that can later be decrypted using DecryptKey.
38299>>>>>    //
38299>>>>>    // Params:
38299>>>>>    //   sPlainText     String to encrypt.
38299>>>>>    // Returns:
38299>>>>>    //   Base64 encoded hash.
38299>>>>>    Function EncryptPassword String sPlainText Returns String
38301>>>>>        String sEncryptPassword sBase64
38301>>>>>        UChar[] ucBinary
38302>>>>>        Pointer pBase64
38302>>>>>        Integer iVoid
38302>>>>>        
38302>>>>>        //  Encrypt Key
38302>>>>>        Get GetEncryptionPassword to sEncryptPassword
38303>>>>>        If (sEncryptPassword = "") Begin
38305>>>>>            Error DFERR_PROGRAM "No encryption password set"
38306>>>>>>
38306>>>>>        End
38306>>>>>>
38306>>>>>        
38306>>>>>        Get Encrypt of oDataCrypter (StringToUCharArray(sEncryptPassword)) (StringToUCharArray(sPlainText)) to ucBinary
38307>>>>>        
38307>>>>>        If (SizeOfArray(ucBinary) = 0) Begin
38309>>>>>            Error DFERR_PROGRAM "Unable to encrypt database login password"
38310>>>>>>
38310>>>>>            Function_Return ""
38311>>>>>        End
38311>>>>>>
38311>>>>>        
38311>>>>>        //  Encode binary hash to Base64
38311>>>>>        Move (Base64Encode(AddressOf(ucBinary), SizeOfArray(ucBinary))) to pBase64
38312>>>>>        Move (PointerToString(pBase64)) to sBase64
38313>>>>>        Move (Free(pBase64)) to iVoid
38314>>>>>        
38314>>>>>        Function_Return sBase64
38315>>>>>    End_Function
38316>>>>>    
38316>>>>>    
38316>>>>>    // Decrypts the unreadable hash generated by EncryptKey into a readable string.
38316>>>>>    //
38316>>>>>    // Params:
38316>>>>>    //   sBase64EncryptedPassword       Base64 Encrypted password
38316>>>>>    // Returns:
38316>>>>>    //   Readable plain text password
38316>>>>>    Function DecryptPassword String sBase64EncryptedPassword Returns String
38318>>>>>        String sEncryptPassword
38318>>>>>        UChar[] ucBinary ucPlain
38320>>>>>        Boolean bIsHex
38320>>>>>        Integer iLen iVoid
38320>>>>>        Pointer pBinary
38320>>>>>        
38320>>>>>        If (sBase64EncryptedPassword <> "") Begin
38322>>>>>            //  Decode from Base64
38322>>>>>            Move (Base64Decode(AddressOf(sBase64EncryptedPassword), &iLen)) to pBinary
38323>>>>>            
38323>>>>>            Move (ResizeArray(ucBinary, iLen, 0)) to ucBinary
38324>>>>>            Move (MemCopy(AddressOf(ucBinary), pBinary, iLen)) to iVoid
38325>>>>>                        
38325>>>>>            Move (Free(pBinary)) to iVoid
38326>>>>>            
38326>>>>>            //  Encrypted binary hash to string
38326>>>>>            Get GetEncryptionPassword to sEncryptPassword
38327>>>>>            Get Decrypt of oDataCrypter (StringToUCharArray(sEncryptPassword)) ucBinary to ucPlain
38328>>>>>        End
38328>>>>>>
38328>>>>>        
38328>>>>>        Function_Return (UCharArrayToString(ucPlain))
38329>>>>>    End_Function
38330>>>>>End_Class
38331>>>
38331>>>Object oLoginEncryption is a cLoginEncryption
38333>>>
38333>>>    // this must be created in your appsrc directory and must contain an encryption
38333>>>    // key that is set to psEncryptPassword. It will look something like this
38333>>>    //

5114>>>>>>>            Send Update_Focus_Field_For_Operation MODE_DELETING // added to 12.1/15.1
5115>>>>>>>            Get Validate_Delete_Structure False to iRval
5116>>>>>>>            If iRval Begin
5118>>>>>>>                Get ErrorMessageTableName iRval to sTable
5119>>>>>>>                Move (String(iRval) * "(" - sTable -")") to sTable
5120>>>>>>>                Send data_Set_Error -1 DFERR_PROGRAM DD_INVALID_DELETE_STRUCTURE sTable
5121>>>>>>>                Procedure_Return
5122>>>>>>>            End
5122>>>>>>>>
5122>>>>>>>        End
5122>>>>>>>>
5122>>>>>>>        Forward Send Request_Delete
5124>>>>>>>    End_Procedure

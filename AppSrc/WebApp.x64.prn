33275>>>>>>>    Procedure MoveToColumnObject Handle hoColumn
33277>>>>>>>        Handle[] aColumnObjects
33278>>>>>>>        Integer iColumnIndex
33278>>>>>>>        String[] aParams
33279>>>>>>>        

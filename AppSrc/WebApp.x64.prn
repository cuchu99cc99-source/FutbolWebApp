16536>>>>>>>>>>>    // Initializes a dynamic property. Dynamic properties hold
16536>>>>>>>>>>>    // the values of properties for dynamic objects that are
16536>>>>>>>>>>>    // different from their class-defined values. 
16536>>>>>>>>>>>    //
16536>>>>>>>>>>>    //This should be compared to setting properties inside object definition:
16536>>>>>>>>>>>    // Object oButton is a cWebButton
16536>>>>>>>>>>>    //     Set psCaption to ...
16536>>>>>>>>>>>    //     Set piColumnIndex to ...
16536>>>>>>>>>>>    // End_Object
16536>>>>>>>>>>>    Procedure InitDynamicProp String sPropName Variant vPropValue
16538>>>>>>>>>>>        String sName
16538>>>>>>>>>>>        Integer iPubPropIndex
16538>>>>>>>>>>>        Handle hoOwner hmSetter
16538>>>>>>>>>>>        Boolean bIsDynamicObject
16538>>>>>>>>>>>        tWebPropMetaData pubProp
16538>>>>>>>>>>>        tWebPropMetaData pubProp
16538>>>>>>>>>>>        
16538>>>>>>>>>>>        Get IsDynamicObject to bIsDynamicObject
16539>>>>>>>>>>>        
16539>>>>>>>>>>>        If (bIsDynamicObject) Begin
16541>>>>>>>>>>>            Get FindWebPropertyMetaByName sPropName to pubProp
16542>>>>>>>>>>>            
16542>>>>>>>>>>>            If (pubProp.hmGetter > 0) Begin        
16544>>>>>>>>>>>                Get Owner to hoOwner
16545>>>>>>>>>>>                Set pubProp.hmSetter to vPropValue
16546>>>>>>>>>>>                Send SetDynamicProp of hoOwner (Self) pubProp vPropValue
16547>>>>>>>>>>>            End
16547>>>>>>>>>>>>
16547>>>>>>>>>>>            Else Begin
16548>>>>>>>>>>>                Get Name to sName
16549>>>>>>>>>>>                Error DFERR_PROGRAM (SFormat(C_$PropertyDoesNotExist, sPropName, sName))
16550>>>>>>>>>>>>
16550>>>>>>>>>>>            End        
16550>>>>>>>>>>>>
16550>>>>>>>>>>>        End
16550>>>>>>>>>>>>
16550>>>>>>>>>>>        Else Begin
16551>>>>>>>>>>>            Get Name to sName
16552>>>>>>>>>>>            Error DFERR_PROGRAM (SFormat("Object '%1' is not a dynamic object", sName))
16553>>>>>>>>>>>>
16553>>>>>>>>>>>        End
16553>>>>>>>>>>>>
16553>>>>>>>>>>>    End_Procedure

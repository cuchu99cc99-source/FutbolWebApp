7352>>>>>>>>>>>    /*    Parses the passed ini data into memory.    */
7352>>>>>>>>>>>    Procedure ParseString String sIniData
7354>>>>>>>>>>>        String[] aLines
7355>>>>>>>>>>>        
7355>>>>>>>>>>>        Send ClearData
7356>>>>>>>>>>>        
7356>>>>>>>>>>>        // Normalize line endings to single LF
7356>>>>>>>>>>>        Move (Replaces(Character(13) + Character(10), sIniData, Character(10))) to sIniData
7357>>>>>>>>>>>        

21362>>>>>>>>>    Procedure Define_cWebDDOSync_mixin
21364>>>>>>>>>        Property Handle Main_DD 0
21365>>>>>>>>>
21365>>>>>>>>>        /*        This array is used to cache the DDO structure of the view. It is initialized during         End_Construct_Object and is sorted alphabetically. The name is generated using the         DDIdentity which makes it unique within the view. Used for fast searches of DDO object name         to DDO handle.        */
21365>>>>>>>>>        Property tNameHandlePair[] paDDOIndex
21366>>>>>>>>>        
21366>>>>>>>>>        // This array is used for traversing the DDO structure in order of Main DD, then the child DDO structure followed by the parent DDO structure.
21366>>>>>>>>>        Property Handle[] paDDOHandlesTree  // Handle to each DDO in the DDO Structure - sorted by: Main DD, Child DD tree, Parent DD tree
21367>>>>>>>>>        
21367>>>>>>>>>        // This array stores the Main_DD of one or more alternative DDO structures. This is used to
21367>>>>>>>>>        // append multiple DDO structures to the set of DDO structures that are synchronized at the client.
21367>>>>>>>>>        // Note: you do not need to add the View's Main_DD to this array. Its DDO structure is automatically
21367>>>>>>>>>        // added to the synchronized list.
21367>>>>>>>>>        Property Handle[] paAdditionalDDOStructures
21368>>>>>>>>>        
21368>>>>>>>>>        Property tWebDDODef ptDDOStates
21371>>>>>>>>>    End_Procedure
21372>>>>>>>>>    
21372>>>>>>>>>    Procedure AddDDOStructure Handle hoMain_DD
21374>>>>>>>>>        // If your view has two or more independant DDO Structures then send this message to add
21374>>>>>>>>>        // each additional DDO structure to the set of DDO structures that are synchronized with
21374>>>>>>>>>        // the client. Do not Send this to add the view's main DDO structure, that will be added
21374>>>>>>>>>        // automatically. Pass the Main_DD of the DDO structure as the parameter.
21374>>>>>>>>>        Handle[] aAdditionalDDOStructures
21375>>>>>>>>>        
21375>>>>>>>>>        Get paAdditionalDDOStructures to aAdditionalDDOStructures
21376>>>>>>>>>        Move hoMain_DD to aAdditionalDDOStructures[SizeOfArray(aAdditionalDDOStructures)]
21377>>>>>>>>>        Set paAdditionalDDOStructures to aAdditionalDDOStructures
21378>>>>>>>>>    End_Procedure
21379>>>>>>>>>    
21379>>>>>>>>>    
21379>>>>>>>>>     Procedure FindDataDictionaries Handle hoCurrentDD Handle[] ByRef aDDOHandles
21381>>>>>>>>>        // Recursive function to iterate the structure of data dictionary objects in this view
21381>>>>>>>>>        // returning an array of DD object handles in the ByRef parameter.
21381>>>>>>>>>        //
21381>>>>>>>>>        // To start the search call this method with hoCurrentDD set to the view's Main DD
21381>>>>>>>>>        // and hDataDictionaries passed as an empty array.
21381>>>>>>>>>        //
21381>>>>>>>>>        // Returns an array of DDO object handles: first the Main DD, followed by the child DD tree, then the parent DD tree
21381>>>>>>>>>        Handle hoNextDD
21381>>>>>>>>>        Integer iCounter iCount
21381>>>>>>>>>        
21381>>>>>>>>>        // Append the passed data dictionary to the array.....
21381>>>>>>>>>        Move hoCurrentDD to aDDOHandles[(SizeOfArray(aDDOHandles))]
21382>>>>>>>>>    
21382>>>>>>>>>        // Add the client ddo's....
21382>>>>>>>>>        Get Data_Set_Client_Count of hoCurrentDD to iCount
21383>>>>>>>>>        
21383>>>>>>>>>        For iCounter from 0 to (iCount - 1)
21389>>>>>>>>>>
21389>>>>>>>>>            Get Data_Set_Client of hoCurrentDD iCounter to hoNextDD
21390>>>>>>>>>            
21390>>>>>>>>>            If (SearchArray(hoNextDD, aDDOHandles) < 0) Begin
21392>>>>>>>>>               Send FindDataDictionaries hoNextDD (&aDDOHandles)
21393>>>>>>>>>            End
21393>>>>>>>>>>
21393>>>>>>>>>        Loop
21394>>>>>>>>>>
21394>>>>>>>>>        
21394>>>>>>>>>        // Add the server ddo's....
21394>>>>>>>>>        Get Data_Set_Server_Count of hoCurrentDD to iCount
21395>>>>>>>>>        
21395>>>>>>>>>        For iCounter from 0 to (iCount-1)
21401>>>>>>>>>>
21401>>>>>>>>>            Get Data_Set_Server of hoCurrentDD iCounter to hoNextDD
21402>>>>>>>>>    
21402>>>>>>>>>            If (SearchArray(hoNextDD, aDDOHandles) < 0) Begin
21404>>>>>>>>>               Send FindDataDictionaries hoNextDD (&aDDOHandles)
21405>>>>>>>>>            End
21405>>>>>>>>>>
21405>>>>>>>>>        Loop
21406>>>>>>>>>>
21406>>>>>>>>>    End_Procedure
21407>>>>>>>>>    
21407>>>>>>>>>    /*    Returns unique name for DDO object within this view, which is basically the long object name     not including the view name. This allows duplicate DD object names (as long as they are not     siblings!). This name is used in the synchronization logic.    */
21407>>>>>>>>>    Function DDIdentity Handle hoDD Returns String
21409>>>>>>>>>        Function_Return (Right(Name(hoDD), Length(Name(hoDD)) - Length(Name(Self)) - 1))
21410>>>>>>>>>    End_Function
21411>>>>>>>>>    
21411>>>>>>>>>    /*    Finds a DD object by its DD Identity string and returns the handle. Returns     C_WebUnresolvedObject if not found.    */

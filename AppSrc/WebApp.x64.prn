34521>>>>>>>
34521>>>>>>>    // Seeds data and finds a record. Returns true if a seed/find succeeded.
34521>>>>>>>    Function SeedData Handle hoUpdateColumn Handle hoInitialColumn Returns Boolean
34523>>>>>>>        Handle hoInvokingObject hoInvokingServer hoServer
34523>>>>>>>        Handle hmSeedBuffer
34523>>>>>>>        Integer iField iFile eUpdateMode iStat iOrdering
34523>>>>>>>        Boolean bAutoSeed bReadRecord bChanged bSeeded bReverseOrdering bAutoServer
34523>>>>>>>        String sValue
34523>>>>>>>
34523>>>>>>>        WebGet peUpdateMode to eUpdateMode
34524>>>>>>>        Get GetInvokingObject to hoInvokingObject
34525>>>>>>>        WebGet pbAutoSeed to bAutoSeed
34526>>>>>>>        Get phmPromptSeedBufferCallback to hmSeedBuffer
34527>>>>>>>        Get pbAutoServer to bAutoServer
34528>>>>>>>        
34528>>>>>>>        Get ReadingServer to hoServer
34529>>>>>>>        Get Main_File of hoServer to iFile
34530>>>>>>>        Get Server of hoInvokingObject to hoInvokingServer
34531>>>>>>>        
34531>>>>>>>        // if autoserver, we need to make sure the file buffers are set for
34531>>>>>>>        // the invoking DDOs. This may be needed for relates-to constraints
34531>>>>>>>        If (bAutoServer) Begin
34533>>>>>>>            Send Refind_Records of hoInvokingServer
34534>>>>>>>        End
34534>>>>>>>>
34534>>>>>>>        // if a seed message is created, we assume that this should override anything else and that
34534>>>>>>>        // you will use this and only this for seeding
34534>>>>>>>        If (eUpdateMode<>umPromptNonInvoking and hmSeedBuffer) Begin
34536>>>>>>>            Clear iFile    // First clear the main_file buffer
34537>>>>>>>            Send hmSeedBuffer of hoInvokingObject Self
34538>>>>>>>            // if we come back with a non-edited, record we assume the seed did a find
34538>>>>>>>            // and we will use that record. Otherwise we want to do a find
34538>>>>>>>            Get_Attribute DF_FILE_STATUS of iFile to iStat
34541>>>>>>>            If (iStat=DF_FILE_ACTIVE) Begin
34543>>>>>>>                Move True to bSeeded
34544>>>>>>>            End
34544>>>>>>>>
34544>>>>>>>            Else Begin             
34545>>>>>>>                Move True to bReadRecord
34546>>>>>>>            End
34546>>>>>>>>
34546>>>>>>>        End
34546>>>>>>>>
34546>>>>>>>        // if relational we will seed if autoseed and if it really is relational
34546>>>>>>>        Else If (eUpdateMode=umPromptRelational and bAutoSeed) Begin
34549>>>>>>>            Clear iFile    // First clear the main_file buffer
34550>>>>>>>            // Default action is to perform an entry update just like a find
34550>>>>>>>            // key would do. If we have a server allow the server to control this.
34550>>>>>>>            Send Request_Entry_Update to hoInvokingServer iFile 1
34551>>>>>>>            Move True to bReadRecord
34552>>>>>>>        End
34552>>>>>>>>
34552>>>>>>>        // if value or custom, we seed if auto seed and we have an update column
34552>>>>>>>        Else If (bAutoSeed and hoUpdateColumn) Begin
34555>>>>>>>            WebGet psSeedValue to sValue
34556>>>>>>>            Get Data_File of hoUpdateColumn to iFile
34557>>>>>>>            Get Data_Field of hoUpdateColumn to iField
34558>>>>>>>            Clear iFile    // First clear the main_file buffer
34559>>>>>>>            Set_Field_Value iFile iField to sValue 
34562>>>>>>>            Move True to bReadRecord
34563>>>>>>>        End
34563>>>>>>>>
34563>>>>>>>        
34563>>>>>>>        // only find a record if there is a change. If the buffer is unchanged we leave
34563>>>>>>>        // it as is. This uncleared always start at the top of the list and if a custom
34563>>>>>>>        // seed was used to find the record, we will use that id
34563>>>>>>>        If bReadRecord Begin
34565>>>>>>>            Get_Attribute DF_FILE_CHANGED of iFile to bChanged
34568>>>>>>>            If bChanged Begin
34570>>>>>>>                WebGet pbReverseOrdering to bReverseOrdering
34571>>>>>>>                Get IndexOrder to iOrdering
34572>>>>>>>                Get ReadDDRecordInBuffer hoServer iOrdering bReverseOrdering to bSeeded
34573>>>>>>>            End
34573>>>>>>>>
34573>>>>>>>        End
34573>>>>>>>>
34573>>>>>>>        
34573>>>>>>>        Function_Return bSeeded
34574>>>>>>>    End_Function
34575>>>>>>>    
34575>>>>>>>    Procedure RestoreDefaults
34577>>>>>>>        Integer iVal
34577>>>>>>>        String sVal

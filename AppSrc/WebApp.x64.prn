38807>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
38808>>>>>    
38808>>>>>    Procedure Construct_Object
38810>>>>>        Handle hoObj
38810>>>>>        
38810>>>>>        Forward Send Construct_Object
38812>>>>>        
38812>>>>>        Set pbSessionCookieHttpOnly to True
38813>>>>>        
38813>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
38814>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
38815>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
38816>>>>>        
38816>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
38817>>>>>        Set phoUserDD to hoObj
38818>>>>>        
38818>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
38819>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
38820>>>>>        Set phoSessionDD to hoObj
38821>>>>>        
38821>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
38822>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
38823>>>>>        Set phoCrypto to hoObj
38824>>>>>        
38824>>>>>        Property Boolean pbPasswordHashing True
38825>>>>>        
38825>>>>>        Property Boolean pbCreatingNewSession False
38826>>>>>        Property String psLoginName
38827>>>>>        Property String psUserName ""
38828>>>>>        Property Integer piUserRights 0
38829>>>>>    End_Procedure
38830>>>>>    
38830>>>>>    Procedure End_Construct_Object
38832>>>>>        Boolean bPasswordHashing
38832>>>>>        Handle hoCrypto
38832>>>>>        Integer iFieldLen iRequiredBufferSize
38832>>>>>        String sErrorText
38832>>>>>
38832>>>>>        Forward Send End_Construct_Object
38834>>>>>        
38834>>>>>        Get pbPasswordHashing to bPasswordHashing
38835>>>>>        If (bPasswordHashing) Begin
38837>>>>>            Get phoCrypto to hoCrypto
38838>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
38841>>>>>            Get RequiredBufferSize of hoCrypto to iRequiredBufferSize
38842>>>>>            Move (iRequiredBufferSize + 3) to iRequiredBufferSize
38843>>>>>            If (iFieldLen < iRequiredBufferSize) Begin
38845>>>>>                Move (SFormat (C_$PasswordFieldNotLargeEnough, iRequiredBufferSize)) To sErrorText
38846>>>>>                Error DFERR_PROGRAM sErrorText
38847>>>>>>
38847>>>>>            End
38847>>>>>>
38847>>>>>        End
38847>>>>>>
38847>>>>>    End_Procedure
38848>>>>>    
38848>>>>>    Function CreateSession String sRemoteAddress Returns String
38850>>>>>        String sSessionKey
38850>>>>>        Integer iErr
38850>>>>>        Boolean bLogWebSession
38850>>>>>        Handle hoSessionDD       
38850>>>>>        Get phoSessionDD to hoSessionDD
38851>>>>>        
38851>>>>>        //  Get session key
38851>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
38853>>>>>        
38853>>>>>        Get pbLogWebSession to bLogWebSession
38854>>>>>        If not bLogWebSession Begin
38856>>>>>            Function_Return sSessionKey        
38857>>>>>        End
38857>>>>>>
38857>>>>>
38857>>>>>        //  Store session
38857>>>>>        Send Clear of hoSessionDD
38858>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
38859>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
38860>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
38861>>>>>        Get Request_Validate of hoSessionDD to iErr
38862>>>>>        If (iErr) Begin
38864>>>>>            // this should not happen. If it does its a programming error
38864>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
38865>>>>>>
38865>>>>>            Function_Return ""
38866>>>>>        End
38866>>>>>>
38866>>>>>        Send Request_Save of hoSessionDD
38867>>>>>        If (Err) Begin
38869>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
38869>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
38870>>>>>>
38870>>>>>            Function_Return ""
38871>>>>>        End
38871>>>>>>
38871>>>>>       
38871>>>>>        Function_Return sSessionKey        
38872>>>>>    End_Function
38873>>>>>    
38873>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
38875>>>>>        DateTime dtLastAccess dtCurrent
38875>>>>>        TimeSpan tsDiff
38875>>>>>        Integer iErr iSessionTimeout iSpanMinutes
38875>>>>>        Boolean bResult bCreatingNewSession
38875>>>>>        Boolean bLogWebSession bLoadWebApp
38875>>>>>        Integer eLoginMode
38875>>>>>        String sTime
38875>>>>>        Handle hoSessionDD hoUserDD       
38875>>>>>        
38875>>>>>        Move False to bLoadWebApp
38876>>>>>        If (num_arguments >= 2) Begin
38878>>>>>            Move bOptLoadWebApp to bLoadWebApp
38879>>>>>        End
38879>>>>>>
38879>>>>>        
38879>>>>>        Get phoSessionDD to hoSessionDD
38880>>>>>        Get phoUserDD to hoUserDD
38881>>>>>        
38881>>>>>        Get pbLogWebSession to bLogWebSession
38882>>>>>        Get peLoginMode to eLoginMode
38883>>>>>        
38883>>>>>        // for this object, you can only disable logging if login completely is disabled
38883>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
38885>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
38886>>>>>>
38886>>>>>            Function_Return False
38887>>>>>        End
38887>>>>>>
38887>>>>>
38887>>>>>        //  Clear session properties
38887>>>>>        Set psSessionKey to ""
38888>>>>>        Send UpdateSessionProperties True
38889>>>>>        
38889>>>>>        If not bLogWebSession Begin
38891>>>>>            Forward Get ValidateSession sSessionKey to bResult
38893>>>>>            Function_Return bResult
38894>>>>>        End        
38894>>>>>>
38894>>>>>        
38894>>>>>        Move False to bResult
38895>>>>>        Get piSessionTimeout to iSessionTimeout 
38896>>>>>        
38896>>>>>        //  Check if session exists
38896>>>>>        Send Clear of hoSessionDD
38897>>>>>        Move sSessionKey to WebAppSession.SessionKey
38898>>>>>        Send Find of hoSessionDD EQ Index.1
38899>>>>>            
38899>>>>>        If (Found) Begin
38901>>>>>            //  Calculate timespan between now and last access time
38901>>>>>            Move (CurrentDateTime()) to dtCurrent
38902>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
38903>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
38904>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
38905>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
38906>>>>>            
38906>>>>>            //  Check if session didn't time out
38906>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
38908>>>>>                Forward Get ValidateSession sSessionKey to bResult
38910>>>>>                   
38910>>>>>                If (bResult) Begin
38912>>>>>                    //  Update session record
38912>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
38913>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
38914>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
38915>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
38916>>>>>                    Get Request_Validate of hoSessionDD to iErr
38917>>>>>                    If (iErr) Begin
38919>>>>>                        // this should not happen. If it does its a programming error
38919>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
38920>>>>>>
38920>>>>>                        Function_Return False
38921>>>>>                    End
38921>>>>>>
38921>>>>>                    Send Request_Save of hoSessionDD
38922>>>>>                    
38922>>>>>                    //  Update user properties
38922>>>>>                    Send UpdateSessionProperties False
38923>>>>>                End
38923>>>>>>
38923>>>>>            End
38923>>>>>>
38923>>>>>            Else Begin
38924>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
38924>>>>>                Get pbCreatingNewSession to bCreatingNewSession
38925>>>>>                
38925>>>>>                If (not(bCreatingNewSession)) Begin
38927>>>>>                    If (not(bLoadWebApp)) Begin
38929>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
38930>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
38931>>>>>>
38931>>>>>                        Send NavigateRefresh of (Host(Self))          // refresh the WebApp at the client (triggers a login)
38932>>>>>                    End
38932>>>>>>
38932>>>>>                    Else Begin
38933>>>>>                        Set pbCreatingNewSession to True                    
38934>>>>>                        Get RecreateSession of (Host(Self)) to bResult 
38935>>>>>                        Set pbCreatingNewSession to False                        
38936>>>>>                    End
38936>>>>>>
38936>>>>>                End
38936>>>>>>
38936>>>>>            End
38936>>>>>>
38936>>>>>        End
38936>>>>>>
38936>>>>>        Else Begin
38937>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
38938>>>>>>
38938>>>>>        End
38938>>>>>>
38938>>>>>        
38938>>>>>        Function_Return bResult
38939>>>>>    End_Function
38940>>>>>    
38940>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
38942>>>>>        If (not(pbPasswordHashing(Self))) Begin
38944>>>>>            Move sPassword to sHash
38945>>>>>            Function_Return True
38946>>>>>        End
38946>>>>>>
38946>>>>>        
38946>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
38948>>>>>            Function_Return False
38949>>>>>        End
38949>>>>>>
38949>>>>>        Move ("V1$" + sHash) to sHash
38950>>>>>        Function_Return True
38951>>>>>    End_Function
38952>>>>>    
38952>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
38954>>>>>        If (not(pbPasswordHashing(Self))) Begin
38956>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
38959>>>>>            Function_Return (sUserPassword = sEnteredPassword)
38960>>>>>        End
38960>>>>>>
38960>>>>>        
38960>>>>>        String sVersion
38960>>>>>        Move (Left(sUserPassword, 3)) to sVersion
38961>>>>>        If (sVersion = "V1$") Begin
38963>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
38966>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
38967>>>>>        End
38967>>>>>>
38967>>>>>        Else Begin
38968>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
38971>>>>>            Function_Return False
38972>>>>>        End
38972>>>>>>
38972>>>>>    End_Function

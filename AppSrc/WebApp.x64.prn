7364>>>>>>>>>>>        For iLine from 0 to iLineTo
7370>>>>>>>>>>>>
7370>>>>>>>>>>>            Move emptyVal to newVal
7371>>>>>>>>>>>            Move False to bSkip
7372>>>>>>>>>>>            Move (Ltrim(aLines[iLine])) to sLine
7373>>>>>>>>>>>            Move (Left(sLine, 1)) to sChar
7374>>>>>>>>>>>            
7374>>>>>>>>>>>            If (sChar = "[") Begin
7376>>>>>>>>>>>                Move (Pos("]", sLine)) to iPos
7377>>>>>>>>>>>                If (iPos > 0) Begin
7379>>>>>>>>>>>                    Move (Trim(Mid(sLine, iPos - 2, 2))) to newSec.sName
7380>>>>>>>>>>>                    If (not(pbCaseSensitive(Self))) Begin
7382>>>>>>>>>>>                        Move newSec.sName to newSec.sCaseName
7383>>>>>>>>>>>                        Move (Uppercase(newSec.sName)) to newSec.sName
7384>>>>>>>>>>>                    End
7384>>>>>>>>>>>>
7384>>>>>>>>>>>                    
7384>>>>>>>>>>>                    Move (SearchArray(newSec, aIniData, False)) to iSection
7385>>>>>>>>>>>                    If (iSection = -1) Begin
7387>>>>>>>>>>>                        Move (SizeOfArray(aIniData)) to iSection
7388>>>>>>>>>>>                        Move newSec to aIniData[iSection]
7389>>>>>>>>>>>                    End
7389>>>>>>>>>>>>
7389>>>>>>>>>>>                                                            
7389>>>>>>>>>>>                    Move True to bSkip
7390>>>>>>>>>>>                End
7390>>>>>>>>>>>>
7390>>>>>>>>>>>            End
7390>>>>>>>>>>>>
7390>>>>>>>>>>>            
7390>>>>>>>>>>>            If (not(bSkip)) Begin
7392>>>>>>>>>>>                If (sChar  = ";" or sChar = "#") ; // Skip comment lines                    Move True to newVal.bComment
7395>>>>>>>>>>>                Else ;                    Move (Pos(psAssignChar(Self), sLine)) to iPos
7397>>>>>>>>>>>                
7397>>>>>>>>>>>                Move -1 to iValue
7398>>>>>>>>>>>                If (not(newVal.bComment) and iPos > 0) Begin
7400>>>>>>>>>>>                    Move (Trim(Left(sLine, iPos - 1))) to newVal.sName
7401>>>>>>>>>>>                    Move (LTrim(Right(sLine, Length(sLine) - iPos))) to newVal.sValue
7402>>>>>>>>>>>                    
7402>>>>>>>>>>>                    If (not(pbCaseSensitive(Self))) Begin
7404>>>>>>>>>>>                         Move newVal.sName to newVal.sCaseName
7405>>>>>>>>>>>                         Move (Uppercase(newVal.sName)) to newVal.sName
7406>>>>>>>>>>>                    End
7406>>>>>>>>>>>>
7406>>>>>>>>>>>                    
7406>>>>>>>>>>>                    If (SizeOfArray(aIniData) > iSection) ;                        Move (SearchArray(newVal, aIniData[iSection].aValues)) to iValue
7409>>>>>>>>>>>                End
7409>>>>>>>>>>>>
7409>>>>>>>>>>>                Else Begin
7410>>>>>>>>>>>                    // Probably whitespace or garbage, just preserve it
7410>>>>>>>>>>>                    Move sLine to newVal.sValue
7411>>>>>>>>>>>                    Move True to newVal.bComment
7412>>>>>>>>>>>                End
7412>>>>>>>>>>>>
7412>>>>>>>>>>>                
7412>>>>>>>>>>>                Move newVal to aIniData[iSection].aValues[iValue]
7413>>>>>>>>>>>            End
7413>>>>>>>>>>>>
7413>>>>>>>>>>>        Loop
7414>>>>>>>>>>>>
7414>>>>>>>>>>>        
7414>>>>>>>>>>>        Set paIniData to aIniData

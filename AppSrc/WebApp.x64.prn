10043>>>>>>>>>            // in the next FUNC_SQLCOLUMNVALUE call.
10043>>>>>>>>>            // If hdbc and hstmt have not changed since the last call we don't have to set it.
10043>>>>>>>>>            If (ihstmt <> giLastSQLhstmt or ihdbc <> giLastSQLhdbc) Begin
10045>>>>>>>>>                // Setup function arguments

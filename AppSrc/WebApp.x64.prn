15649>>>>>>>>>    // Interface to support attaching and detaching WBOs and WebApps from sessions
15649>>>>>>>>>    
15649>>>>>>>>>    // Clear the contents of all open files, except system files
15649>>>>>>>>>    Procedure DoDetachAllTables
15651>>>>>>>>>        Handle hFile
15651>>>>>>>>>        Integer bIsSys
15651>>>>>>>>>        Move 0 to hFile
15652>>>>>>>>>        Repeat
15652>>>>>>>>>>
15652>>>>>>>>>            Get_Attribute DF_FILE_NEXT_OPENED of hFile to hFile
15655>>>>>>>>>            If (hFile>0) Begin
15657>>>>>>>>>                Get_Attribute DF_FILE_IS_SYSTEM_FILE of hFile to bIsSys
15660>>>>>>>>>                If not bIsSys ;                    Clear hFile // do not clear system files
15663>>>>>>>>>            End
15663>>>>>>>>>>
15663>>>>>>>>>        Until (hFile=0)
15665>>>>>>>>>    End_Procedure
15666>>>>>>>>>    
15666>>>>>>>>>    Procedure DoDetachProcess
15668>>>>>>>>>        Integer eAttachStatus
15668>>>>>>>>>        Integer bOldQueueErrors bOldAllErrorsToHtml
15668>>>>>>>>>        Integer i iWBOs eWebAppEndPointEnvironment
15668>>>>>>>>>        Handle hWBO
15668>>>>>>>>>        
15668>>>>>>>>>        // See notes about change in DoAttachProcess.
15668>>>>>>>>>
15668>>>>>>>>>        // Set error handling settings to report all errors, but not to html
15668>>>>>>>>>        Get pbAllErrorsToHtml of ghInetSession to bOldAllErrorsToHtml
15669>>>>>>>>>        Get pbQueueErrors     of ghInetSession to bOldQueueErrors
15670>>>>>>>>>        Set pbAllErrorsToHtml of ghInetSession to False // no error output to html
15671>>>>>>>>>        Set pbQueueErrors     of ghInetSession to False // do not queue errors, report them.
15672>>>>>>>>>
15672>>>>>>>>>        // the status before a detach should always C_asAttached. Check
15672>>>>>>>>>        Get peAttachStatus to eAttachStatus
15673>>>>>>>>>        If (eAttachStatus<>C_asAttached) ;            Send LogEvent 101 (SFormat(C_$WrongDoDetachStatus, eAttachStatus))
15676>>>>>>>>>
15676>>>>>>>>>        Set peAttachStatus to C_asDetaching
15677>>>>>>>>>        
15677>>>>>>>>>        // User hook
15677>>>>>>>>>        Send OnDetachProcess
15678>>>>>>>>>        
15678>>>>>>>>>        // send DoDetachProcess to all legacy WBOs
15678>>>>>>>>>        Get WBOCount to iWBOs
15679>>>>>>>>>        Decrement iWBOs
15680>>>>>>>>>        For i from 0 to iWBOs
15686>>>>>>>>>>
15686>>>>>>>>>            Get WBOHandle i to hWBO
15687>>>>>>>>>            Send DoDetachProcess of hWBO
15688>>>>>>>>>        Loop
15689>>>>>>>>>>
15689>>>>>>>>>        
15689>>>>>>>>>        // For ASP we do not wait for OnReleaseProcess, since that does not get triggered after each detach
15689>>>>>>>>>        Get CurrentWebAppEnvironment of ghInetSession to eWebAppEndPointEnvironment
15690>>>>>>>>>        If (eWebAppEndPointEnvironment = WebAppEnvASP) Begin
15692>>>>>>>>>            Set peAttachStatus to C_asDetached
15693>>>>>>>>>        End
15693>>>>>>>>>>
15693>>>>>>>>>        
15693>>>>>>>>>
15693>>>>>>>>>        // restore error handling settings
15693>>>>>>>>>        Set pbQueueErrors     of ghInetSession to bOldQueueErrors
15694>>>>>>>>>        Set pbAllErrorsToHtml of ghInetSession to bOldAllErrorsToHtml
15695>>>>>>>>>    End_Procedure
15696>>>>>>>>>    
15696>>>>>>>>>
15696>>>>>>>>>    Function DoAttachProcess Returns Integer
15698>>>>>>>>>        Integer eAttachStatus
15698>>>>>>>>>        Integer bOldQueueErrors bOldAllErrorsToHtml
15698>>>>>>>>>        Integer iWBOs i iError
15698>>>>>>>>>        Handle hWBO
15698>>>>>>>>>        
15698>>>>>>>>>        // We used to send OnAttachProcess to all Web objects but not send this to Web service objects. 
15698>>>>>>>>>        // This seems like too much and too little. We now Send OnAttachProcess
15698>>>>>>>>>        // to just the cWebApp object for all types of calls (WO, WSO, HTTP). However, we still send it for
15698>>>>>>>>>        // WO (asp) calls, for the sake of backwards compatibility. Unless you use a cWebBusinessProcess this does
15698>>>>>>>>>        // nothing. In addition, we used to Send DoDetachAllTables
15698>>>>>>>>>        // to clear all tables with old style WebApps. We no longer do that for any type of webapp. The messages is
15698>>>>>>>>>        // still there so if you need to do this you can do this yourself in OnAttachProcess. 
15698>>>>>>>>>
15698>>>>>>>>>        // Set error handling settings to report all errors, but not to html
15698>>>>>>>>>        Get pbAllErrorsToHtml of ghInetSession to bOldAllErrorsToHtml
15699>>>>>>>>>        Get pbQueueErrors     of ghInetSession to bOldQueueErrors
15700>>>>>>>>>        Set pbAllErrorsToHtml of ghInetSession to False // no error output to html
15701>>>>>>>>>        Set pbQueueErrors     of ghInetSession to False // do not queue errors, report them.
15702>>>>>>>>>
15702>>>>>>>>>        Get peAttachStatus to eAttachStatus
15703>>>>>>>>>        If (eAttachStatus<>C_asDetached and eAttachStatus<>C_asUndefined) Begin
15705>>>>>>>>>            Send LogEvent 102 (SFormat(C_$WrongDoAttachStatus, eAttachStatus))
15706>>>>>>>>>            Function_Return 1
15707>>>>>>>>>        End
15707>>>>>>>>>>
15707>>>>>>>>>
15707>>>>>>>>>        Set peAttachStatus to C_asAttaching
15708>>>>>>>>>
15708>>>>>>>>>        // send DoAttachProcess to all legacy WBOs.
15708>>>>>>>>>        Get WBOCount to iWBOs
15709>>>>>>>>>        Decrement iWBOs
15710>>>>>>>>>        For i from 0 to iWBOs
15716>>>>>>>>>>
15716>>>>>>>>>            Get WBOHandle i to hWBO
15717>>>>>>>>>            // note that cWebAspClassicObjects will get this but do nothing. cWebBusinessProcess will
15717>>>>>>>>>            // get this and do stuff which should be considered private and legacy.
15717>>>>>>>>>            Send DoAttachProcess of hWBO
15718>>>>>>>>>        Loop
15719>>>>>>>>>>
15719>>>>>>>>>        
15719>>>>>>>>>            Set peAttachStatus to C_asAttached
15720>>>>>>>>>                
15720>>>>>>>>>        // restore error handling settings
15720>>>>>>>>>        Set pbQueueErrors     of ghInetSession to bOldQueueErrors
15721>>>>>>>>>        Set pbAllErrorsToHtml of ghInetSession to bOldAllErrorsToHtml
15722>>>>>>>>>        
15722>>>>>>>>>        Function_Return 0
15723>>>>>>>>>    End_Function
15724>>>>>>>>>    
15724>>>>>>>>>    Procedure DoReleaseProcess
15726>>>>>>>>>        // User hook
15726>>>>>>>>>        Send OnReleaseProcess
15727>>>>>>>>>        
15727>>>>>>>>>        Set peAttachStatus to C_asDetached
15728>>>>>>>>>    End_Procedure
15729>>>>>>>>>    
15729>>>>>>>>>    Procedure DoTriggerAttachProcess String lllpszSessionID
15731>>>>>>>>>        // User hook
15731>>>>>>>>>        Send OnAttachProcess lllpszSessionID
15732>>>>>>>>>    End_Procedure

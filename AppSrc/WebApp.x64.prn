23389>>>>>>>>>
23389>>>>>>>>>    // Send this to the stack view to Navigate Back down the View Stack to this view.
23389>>>>>>>>>    // The target view can be in any position in the current view stack, but 
23389>>>>>>>>>    // it must belong to the current view stack.
23389>>>>>>>>>    //
23389>>>>>>>>>    // Each view in the view stack, above the target view, will be tested for
23389>>>>>>>>>    // data loss (pending saves). If one of the higher views requires a save
23389>>>>>>>>>    // then it will be activated instead and the "save changes" message will
23389>>>>>>>>>    // be shown.
23389>>>>>>>>>    //
23389>>>>>>>>>    // Typically, this message will be called by a breadcrumb navigation control.
23389>>>>>>>>>    //
23389>>>>>>>>>    Procedure NavigateBack Handle hoTargetView Boolean bUnconditional
23391>>>>>>>>>        Handle hoView hoInvokingView hoTopView  
23391>>>>>>>>>        Integer iIndex
23391>>>>>>>>>        Boolean bTopChanged
23391>>>>>>>>>        Integer iStackViews
23391>>>>>>>>>        tWebViewInfo[] aViewStack
23391>>>>>>>>>        tWebViewInfo[] aViewStack
23392>>>>>>>>>        
23392>>>>>>>>>        Get TopViewHandle to hoTopView
23393>>>>>>>>>        If not hoTopView Begin
23395>>>>>>>>>            Procedure_Return
23396>>>>>>>>>        End
23396>>>>>>>>>>
23396>>>>>>>>>        
23396>>>>>>>>>        Get GetViewIndex hoTargetView to iIndex
23397>>>>>>>>>        If (iIndex=-1) Begin
23399>>>>>>>>>            Error DFERR_PROGRAM "Target view not in view stack"
23400>>>>>>>>>>
23400>>>>>>>>>            Procedure_Return
23401>>>>>>>>>        End
23401>>>>>>>>>>
23401>>>>>>>>>
23401>>>>>>>>>        If bUnconditional Begin
23403>>>>>>>>>            Move hoTargetView to hoView
23404>>>>>>>>>        End
23404>>>>>>>>>>
23404>>>>>>>>>        Else Begin
23405>>>>>>>>>            Get InvokingViewHandle to hoInvokingView
23406>>>>>>>>>    
23406>>>>>>>>>            If (hoTargetView = hoInvokingView) Begin
23408>>>>>>>>>                Send NavigateCancel of hoTopView
23409>>>>>>>>>                Procedure_Return
23410>>>>>>>>>            End
23410>>>>>>>>>>
23410>>>>>>>>>    
23410>>>>>>>>>            // If we are not the current top then make sure we are not popping off
23410>>>>>>>>>            // any views that have pending changes (should save)...
23410>>>>>>>>>            Get IsViewChanged of hoTopView to bTopChanged
23411>>>>>>>>>            Get CanCloseViews hoTargetView True to hoView
23412>>>>>>>>>            If (hoView = hoTargetView and bTopChanged) Begin
23414>>>>>>>>>               Send NavigateCancelTo of hoTopView hoView 
23415>>>>>>>>>               Procedure_Return
23416>>>>>>>>>            End
23416>>>>>>>>>>
23416>>>>>>>>>            Else If (bTopChanged) Begin
23419>>>>>>>>>               Move hoTopView to hoView 
23420>>>>>>>>>            End
23420>>>>>>>>>>
23420>>>>>>>>>    
23420>>>>>>>>>            If (hoView <> hoTargetView) Begin
23422>>>>>>>>>                Send CantCloseChangedViewError
23423>>>>>>>>>            End
23423>>>>>>>>>>
23423>>>>>>>>>        End
23423>>>>>>>>>>
23423>>>>>>>>>        // finish the navigation back to the view
23423>>>>>>>>>        If (hoView <> hoTopView) Begin
23425>>>>>>>>>            Send NavigateBackToHere of hoView True 0
23426>>>>>>>>>        End
23426>>>>>>>>>>
23426>>>>>>>>>    End_Procedure
23427>>>>>>>>>
23427>>>>>>>>>    // navigate back to named view.
23427>>>>>>>>>    Procedure NavigateBackByName String sViewName
23429>>>>>>>>>        Handle hoView hoTopView
23429>>>>>>>>>        If (sViewName <> "") Begin
23431>>>>>>>>>            Get WebObjectByName sViewName to hoView
23432>>>>>>>>>            Get TopViewHandle to hoTopView
23433>>>>>>>>>            If (hoView > 0 and hoView <> hoTopView) Begin
23435>>>>>>>>>                Send NavigateBack hoView False
23436>>>>>>>>>            End
23436>>>>>>>>>>
23436>>>>>>>>>        End
23436>>>>>>>>>>
23436>>>>>>>>>    End_Procedure

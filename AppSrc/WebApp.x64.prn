15535>>>>>>>    
15535>>>>>>>    Function UrlParameter String sName Returns String
15537>>>>>>>        String[] aParams aParam
15539>>>>>>>        String sQueryString
15539>>>>>>>        WString wsUnescape
15539>>>>>>>        Integer i iVoid
15539>>>>>>>        
15539>>>>>>>        Get psRequestQueryString to sQueryString
15540>>>>>>>        Move (Lowercase(sName)) to sName
15541>>>>>>>        
15541>>>>>>>        Get StrSplitToArray sQueryString "&" to aParams
15542>>>>>>>        For i from 0 to (SizeOfArray(aParams) - 1)
15548>>>>>>>>
15548>>>>>>>            Get StrSplitToArray aParams[i] "=" to aParam
15549>>>>>>>            
15549>>>>>>>            If (SizeOfArray(aParam) > 1) Begin
15551>>>>>>>                Move aParam[0] to wsUnescape
15552>>>>>>>                If (SizeOfWString(wsUnescape) > 0) Begin
15554>>>>>>>                    Move (UrlUnescapeW(AddressOf(wsUnescape), 0, 0, URL_UNESCAPE_INPLACE ior URL_UNESCAPE_AS_UTF8)) to iVoid
15555>>>>>>>                End
15555>>>>>>>>
15555>>>>>>>                If (Lowercase(Trim(CString(wsUnescape))) = sName) Begin
15557>>>>>>>                    Move aParam[1] to wsUnescape
15558>>>>>>>                    If (SizeOfWString(wsUnescape) > 0) Begin
15560>>>>>>>                        Move (UrlUnescapeW(AddressOf(wsUnescape), 0, 0, URL_UNESCAPE_INPLACE ior URL_UNESCAPE_AS_UTF8)) to iVoid
15561>>>>>>>                    End
15561>>>>>>>>
15561>>>>>>>                    Function_Return (CString(wsUnescape))
15562>>>>>>>                End 
15562>>>>>>>>
15562>>>>>>>            End
15562>>>>>>>>
15562>>>>>>>        Loop
15563>>>>>>>>
15563>>>>>>>        
15563>>>>>>>        Function_Return ""
15564>>>>>>>    End_Function
15565>>>>>>>    
15565>>>>>>>    Procedure SetResponseStatus UShort usStatusCode String sReason UShort usStatusSubCode
15567>>>>>>>        UShort usSubCode
15567>>>>>>>        
15567>>>>>>>        Move 0 to usSubCode
15568>>>>>>>        If (num_arguments > 2) Begin
15570>>>>>>>            Move usStatusSubCode to usSubCode
15571>>>>>>>        End
15571>>>>>>>>
15571>>>>>>>        
15571>>>>>>>        If (pbDataSent(Self)) Begin
15573>>>>>>>            Error DFERR_OPERATOR "Data has already been sent. SetResponseStatus should be called before OutputString or OutputUChar is used."
15574>>>>>>>>
15574>>>>>>>        End
15574>>>>>>>>
15574>>>>>>>        
15574>>>>>>>        Send SetResponseStatus of ghInetSession usStatusCode sReason usSubCode
15575>>>>>>>    End_Procedure

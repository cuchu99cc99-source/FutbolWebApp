31059>>>>>>>>>    
31059>>>>>>>>>    //
31059>>>>>>>>>    //  Converts the given time to an string that can be saved in the database.
31059>>>>>>>>>    //
31059>>>>>>>>>    //  Params:
31059>>>>>>>>>    //      dtTime  Time to convert
31059>>>>>>>>>    //  Returns:
31059>>>>>>>>>    //      String with "HH:MM:SS" format
31059>>>>>>>>>    //
31059>>>>>>>>>    Function TimeToString DateTime dtTime Returns String
31061>>>>>>>>>        String sHours sMinutes sSeconds sMillis
31061>>>>>>>>>        
31061>>>>>>>>>        //  Extract parts
31061>>>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
31062>>>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
31063>>>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
31064>>>>>>>>>        Move (String(DateGetMillisecond(dtTime))) to sMillis
31065>>>>>>>>>        
31065>>>>>>>>>        //  Fill out with 0
31065>>>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
31068>>>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
31071>>>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
31074>>>>>>>>>        Move (Right("00" + sMillis, 3)) to sMillis
31075>>>>>>>>>        
31075>>>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds + "." + sMillis)
31076>>>>>>>>>    End_Function
31077>>>>>>>>>
31077>>>>>>>>>
31077>>>>>>>>>    //
31077>>>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
31077>>>>>>>>>    //
31077>>>>>>>>>    //  Params:
31077>>>>>>>>>    //      dtTime  Datetime variable to add time to
31077>>>>>>>>>    //      sTimeString String with time in the format "HH:MM:SS"
31077>>>>>>>>>    //  Returns:
31077>>>>>>>>>    //      dtDateTime with the loaded time
31077>>>>>>>>>    //
31077>>>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
31079>>>>>>>>>        String sHours sMinutes sSeconds sMillis
31079>>>>>>>>>        
31079>>>>>>>>>        //  Extract parts
31079>>>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
31080>>>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
31081>>>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
31082>>>>>>>>>        Move (Right(sTimeString, 3)) to sMillis
31083>>>>>>>>>        
31083>>>>>>>>>        //  Set to DateTime
31083>>>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours))))   to dtTime
31084>>>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
31085>>>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
31086>>>>>>>>>        Move (DateSetMillisecond(dtTime, (Integer(sMillis)))) to dtTime
31087>>>>>>>>>        
31087>>>>>>>>>        Function_Return dtTime
31088>>>>>>>>>    End_Function
31089>>>>>>>>>    

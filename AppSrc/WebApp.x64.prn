9958>>>>>>>>>        tSQLColumn[] aSQLColumns
9959>>>>>>>>>        
9959>>>>>>>>>        Integer ihdbc
9959>>>>>>>>>        Integer ihstmt
9959>>>>>>>>>        Integer iResult iVoid
9959>>>>>>>>>        Integer iColCount iCol
9959>>>>>>>>>        String  sDrvrId

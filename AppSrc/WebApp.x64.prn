9596>>>>>>>>>    // Returns true if this is a user error (i.e. "find past end of file")
9596>>>>>>>>>    Function IsUserError Integer iError Returns Boolean
9598>>>>>>>>>        Integer[] aUserErrors
9599>>>>>>>>>        Get paUserErrors to aUserErrors
9600>>>>>>>>>        Function_Return (BinarySearchArray(iError, aUserErrors) <> -1)
9601>>>>>>>>>    End_Function
9602>>>>>>>>>    
9602>>>>>>>>>        // returns true if this is an unhandled error (i.e., not a user error
9602>>>>>>>>>    Function IsUnhandledError Integer iError Returns Boolean
9604>>>>>>>>>        Integer[] UserErrors
9605>>>>>>>>>        Get paUserErrors to UserErrors
9606>>>>>>>>>        Function_Return (SearchArray(iError,UserErrors)=-1)
9607>>>>>>>>>    End_Function
9608>>>>>>>>>    
9608>>>>>>>>>    Procedure AddUserError Integer iError
9610>>>>>>>>>        // adds a user error to the collection of defined 'user errors'
9610>>>>>>>>>        Integer[] aUserErrors
9611>>>>>>>>>        Get paUserErrors to aUserErrors
9612>>>>>>>>>        
9612>>>>>>>>>        If (BinarySearchArray(iError, aUserErrors) = -1) Begin
9614>>>>>>>>>            Move (InsertInArray(aUserErrors, BinarySearchInsertPos(), iError)) to aUserErrors         // Keep the array sorted. Makes searching fast, adding slower.
9615>>>>>>>>>            Set paUserErrors to aUserErrors
9616>>>>>>>>>        End
9616>>>>>>>>>>
9616>>>>>>>>>    End_Procedure
9617>>>>>>>>>    
9617>>>>>>>>>    Procedure RemoveUserError Integer iError
9619>>>>>>>>>        // Removes the passed error number from the set of user errors.
9619>>>>>>>>>        Integer iIndex
9619>>>>>>>>>        Integer[] aUserErrors
9620>>>>>>>>>        
9620>>>>>>>>>        Get paUserErrors to aUserErrors
9621>>>>>>>>>        Move (BinarySearchArray(iError, aUserErrors)) to iIndex
9622>>>>>>>>>        
9622>>>>>>>>>        If (iIndex <> -1) Begin
9624>>>>>>>>>            Move (RemoveFromArray(aUserErrors, iIndex)) to aUserErrors
9625>>>>>>>>>            Set paUserErrors to aUserErrors
9626>>>>>>>>>        End
9626>>>>>>>>>>
9626>>>>>>>>>    End_Procedure

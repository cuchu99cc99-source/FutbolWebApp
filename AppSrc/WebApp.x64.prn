14984>>>>>>>>>    // Create variant string from data buffer. data buffer is encoded by eCharType
14984>>>>>>>>>    
14984>>>>>>>>>    Function VariantStrFromBuffer Pointer pSource Integer eCodeType Returns Variant
14986>>>>>>>>>        Variant vValue
14986>>>>>>>>>        Pointer pvValue
14986>>>>>>>>>        Boolean bOk
14986>>>>>>>>>        Pointer pWStr
14986>>>>>>>>>        Move "" to vValue
14987>>>>>>>>>        If (pSource) Begin
14989>>>>>>>>>            //Initialize pWstr variable so it has the correct type and AddressOf will return a proper pointer
14989>>>>>>>>>            Move 0 to pWStr
14990>>>>>>>>>            //Convert the Ansi string to Unicode
14990>>>>>>>>>            Move (MultiToWideBuffer( eCodeType, pSource, CStringSize(pSource), AddressOf(pWStr))) to bOk
14991>>>>>>>>>            //Initialize vValue variable so it has the correct type and AddressOf will return a proper pointer
14991>>>>>>>>>            Move 0 to vValue
14992>>>>>>>>>            Move (AddressOf(vValue)) to pvValue
14993>>>>>>>>>            //Change the Variant type to VT_BSTR
14993>>>>>>>>>            Move (StoreDw(pvValue,0,OLE_VT_Bstr)) to bOk
14994>>>>>>>>>            //Allocate a proper COM BSTR, assign the Unicode string, and store the BSTR in the Variant variable
14994>>>>>>>>>            Move (StorePtr(pvValue,8,SysAllocString(pWStr))) to bOk
14995>>>>>>>>>            //Now clear up the Unicode string, the Variant owns a BSTR copy of the string
14995>>>>>>>>>            Move (Free(pWStr)) to bOk
14996>>>>>>>>>        End
14996>>>>>>>>>>
14996>>>>>>>>>        Function_Return vValue
14997>>>>>>>>>    End_Function

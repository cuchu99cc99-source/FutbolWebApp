27589>>>>>>>>>    
27589>>>>>>>>>    Function SupportsDropAction Integer eAction Returns Boolean
27591>>>>>>>>>        Boolean bSupported
27591>>>>>>>>>        
27591>>>>>>>>>        Forward Get SupportsDropAction eAction to bSupported
27593>>>>>>>>>        
27593>>>>>>>>>        If (not(bSupported)) Begin
27595>>>>>>>>>            If (eAction = C_WebDropListRow) Begin
27597>>>>>>>>>                Move True to bSupported
27598>>>>>>>>>            End
27598>>>>>>>>>>
27598>>>>>>>>>        End
27598>>>>>>>>>>
27598>>>>>>>>>        
27598>>>>>>>>>        Function_Return bSupported
27599>>>>>>>>>    End_Function
27600>>>>>>>>>
27600>>>>>>>>>    // this exposed so developers can create their own error text
27600>>>>>>>>>    Procedure ReportCacheError
27602>>>>>>>>>        Error DFERR_CANT_REFIND_RECORD C_$InvalidRowInCache
27603>>>>>>>>>>
27603>>>>>>>>>    End_Procedure
27604>>>>>>>>>
27604>>>>>>>>>    // called when a record in the cache cannot be refound. Most likely this was deleted
27604>>>>>>>>>    // by another user.
27604>>>>>>>>>    // optionally report the error and do a refresh based around the current DD
27604>>>>>>>>>    Procedure HandleCacheError
27606>>>>>>>>>        Boolean bSuppressCacheError
27606>>>>>>>>>        
27606>>>>>>>>>        Get pbSuppressCacheError to bSuppressCacheError
27607>>>>>>>>>        If not bSuppressCacheError Begin 
27609>>>>>>>>>            Send ReportCacheError
27610>>>>>>>>>        End
27610>>>>>>>>>>
27610>>>>>>>>>        // reload the list based on current DD (this may also fail)
27610>>>>>>>>>        Send RefreshListFromDD        
27611>>>>>>>>>    End_Procedure
27612>>>>>>>>>    
27612>>>>>>>>>    
27612>>>>>>>>>    // This method is received by the Web Control that is the target of a CallAction that is sent
27612>>>>>>>>>    // from the client. Augmented to perform format conversion for parameters passed to OnSearch.
27612>>>>>>>>>    // methods.
27612>>>>>>>>>    Function HandleAction String sAction String[] aParams Handle hoAttachment Returns String
27614>>>>>>>>>        Integer i icParameters iCol
27614>>>>>>>>>        Integer eDataType
27614>>>>>>>>>        Handle hoCol
27614>>>>>>>>>        String sReturnVal
27614>>>>>>>>>        
27614>>>>>>>>>        // Get the parameter count
27614>>>>>>>>>        Move (SizeOfArray(aParams)) to icParameters
27615>>>>>>>>>        
27615>>>>>>>>>        // Special Case: OnChange
27615>>>>>>>>>        If (Uppercase(sAction) = "ONSEARCH") Begin
27617>>>>>>>>>            // If the action is an OnSearch event then we must test if the data type is a number, 
27617>>>>>>>>>            // Date or DateTime. If so we must convert each parameter value from the universal 
27617>>>>>>>>>            // transfer format
27617>>>>>>>>>            WebGet piSortColumn to iCol
27618>>>>>>>>>    
27618>>>>>>>>>            If (iCol >= 0) Begin
27620>>>>>>>>>                // Query the data type of the current sort column
27620>>>>>>>>>                Get GetColumnObject iCol to hoCol
27621>>>>>>>>>                Get peDataType of hoCol to eDataType
27622>>>>>>>>>                // Note: For efficienty we do not WebGet peDataType! In other words we do not
27622>>>>>>>>>                // get the "synchronized copy of peDataType (if there is one). This is much more
27622>>>>>>>>>                // efficient but it also assumes that a control's peDataType does not change 
27622>>>>>>>>>                // dynamically. This should be OK
27622>>>>>>>>>                
27622>>>>>>>>>                // Send Hook for converting the value to format for transport.
27622>>>>>>>>>                For i from 0 to (icParameters - 1)
27628>>>>>>>>>>
27628>>>>>>>>>                    Move (ConvertFromClient(eDataType, aParams[i])) to aParams[i]
27629>>>>>>>>>                Loop
27630>>>>>>>>>>
27630>>>>>>>>>            End
27630>>>>>>>>>>
27630>>>>>>>>>        End
27630>>>>>>>>>>
27630>>>>>>>>>        
27630>>>>>>>>>        // Now call the superclass's implementation of HandleAction 
27630>>>>>>>>>        Forward Get HandleAction sAction aParams hoAttachment to sReturnVal
27632>>>>>>>>>        
27632>>>>>>>>>        Function_Return sReturnVal
27633>>>>>>>>>    End_Function
27634>>>>>>>>>    
27634>>>>>>>>>    // Augment to make sure LoadDataPage is allowed when the control is disabled as well.
27634>>>>>>>>>    Procedure AllowServerAction Boolean  ByRef bAllow String sMethodName Handle hoMessage Boolean bIsFunction
27636>>>>>>>>>        If (hoMessage = RefProc(LoadDataPage)) Begin
27638>>>>>>>>>            Get IsControlAccessible False True to bAllow
27639>>>>>>>>>        End
27639>>>>>>>>>>
27639>>>>>>>>>        Else Begin
27640>>>>>>>>>            Forward Send AllowServerAction (&bAllow) sMethodName hoMessage bIsFunction
27642>>>>>>>>>        End
27642>>>>>>>>>>
27642>>>>>>>>>    End_Procedure
27643>>>>>>>>>        
27643>>>>>>>>>    // This function is called when serializing the object to client. We augment it here to 
27643>>>>>>>>>    // determine psKeyBuddy object name based on the handle set to phoKeyBuddy.
27643>>>>>>>>>    Procedure PreSerializeObject
27645>>>>>>>>>        Handle hoObj
27645>>>>>>>>>        String sObj
27645>>>>>>>>>        
27645>>>>>>>>>        Get phoKeyBuddy to hoObj
27646>>>>>>>>>        If (hoObj <> C_WebUnresolvedObject) Begin
27648>>>>>>>>>            Get WebObjectName of hoObj to sObj            
27649>>>>>>>>>        End
27649>>>>>>>>>>
27649>>>>>>>>>        Set psKeyBuddy to sObj
27650>>>>>>>>>    End_Procedure
27651>>>>>>>>>    
27651>>>>>>>>>    Procedure OnCreateDefaultHeaderMenu
27653>>>>>>>>>        Boolean bShowHeader bUseHeaderMenuOnWholeList
27653>>>>>>>>>        Handle hoDefaultHeaderMenu hoChild

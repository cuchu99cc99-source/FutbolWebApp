747>>>>>>>>>>>    Else ;        Move sTitle to sCaption
749>>>>>>>>>>>    Move (Message_Box(sMessage, sCaption, MB_OK, MB_ICONHAND)) to rval
750>>>>>>>>>>>End_Procedure

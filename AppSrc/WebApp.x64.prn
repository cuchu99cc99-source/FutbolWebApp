25387>>>>>>>>>>>>>    Procedure InsertTagBefore String sNextTag String sInsertTag
25389>>>>>>>>>>>>>        Send InsertTagRelative sNextTag True sInsertTag
25390>>>>>>>>>>>>>    End_Procedure
25391>>>>>>>>>>>>>    
25391>>>>>>>>>>>>>    Procedure InsertTagAfter String sPrevTag String sInsertTag
25393>>>>>>>>>>>>>        Send InsertTagRelative sPrevTag False sInsertTag
25394>>>>>>>>>>>>>    End_Procedure
25395>>>>>>>>>>>>>        
25395>>>>>>>>>>>>>    Procedure InsertTagRelative String sRelativeTag Boolean bToLeft String sInsertTag
25397>>>>>>>>>>>>>        Integer iIndex iOffset
25397>>>>>>>>>>>>>        Boolean bAdded bCaseSensitive
25397>>>>>>>>>>>>>        String sNormalizedInsertTag sNormalizedCacheTag
25397>>>>>>>>>>>>>        String[] asTags
25398>>>>>>>>>>>>>        Handle hoSelectionSource
25398>>>>>>>>>>>>>        
25398>>>>>>>>>>>>>        // We need to trim both parameters to be sure we comply to the client parsing.
25398>>>>>>>>>>>>>        Move (Trim(sRelativeTag)) to sRelativeTag
25399>>>>>>>>>>>>>        Move (Trim(sInsertTag)) to sInsertTag
25400>>>>>>>>>>>>>        
25400>>>>>>>>>>>>>        Get phoSelectionSource to hoSelectionSource
25401>>>>>>>>>>>>>        
25401>>>>>>>>>>>>>        // Lower if specified.
25401>>>>>>>>>>>>>        Get pbCaseSensitive of hoSelectionSource to bCaseSensitive
25402>>>>>>>>>>>>>        If (not(bCaseSensitive)) Begin
25404>>>>>>>>>>>>>            Move (Uppercase(sRelativeTag)) to sRelativeTag
25405>>>>>>>>>>>>>            Move (Uppercase(sInsertTag)) to sNormalizedInsertTag
25406>>>>>>>>>>>>>        End
25406>>>>>>>>>>>>>>
25406>>>>>>>>>>>>>        Else ;            Move sInsertTag to sNormalizedInsertTag
25408>>>>>>>>>>>>>        
25408>>>>>>>>>>>>>        // Skip if both are the same or if any is empty.
25408>>>>>>>>>>>>>        If (sRelativeTag = sNormalizedInsertTag or ;            Length(sRelativeTag) = 0 or ;            Length(sNormalizedInsertTag) = 0) ;            Procedure_Return
25411>>>>>>>>>>>>>            
25411>>>>>>>>>>>>>        // Set the offset
25411>>>>>>>>>>>>>        Move (If(bToLeft, 0, 1)) to iOffset
25412>>>>>>>>>>>>>        
25412>>>>>>>>>>>>>        // Initialize the tags
25412>>>>>>>>>>>>>        Move False to bAdded
25413>>>>>>>>>>>>>        Get GetTags to asTags
25414>>>>>>>>>>>>>        
25414>>>>>>>>>>>>>        // Loop the tags till we find our target; if not found we insert it at the end [not(bBreak)].
25414>>>>>>>>>>>>>        While (iIndex < SizeOfArray(asTags))
25418>>>>>>>>>>>>>            // Normalize current tag; the relative is already normalized.
25418>>>>>>>>>>>>>            Move asTags[iIndex] to sNormalizedCacheTag
25419>>>>>>>>>>>>>            If (not(bCaseSensitive)) ;                Move (Uppercase(sNormalizedCacheTag)) to sNormalizedCacheTag
25422>>>>>>>>>>>>>            
25422>>>>>>>>>>>>>            // If it is the tag we insert it and skip the inserted tag and the next othrwise it would cause recursion.
25422>>>>>>>>>>>>>            If (sNormalizedCacheTag = sRelativeTag) Begin
25424>>>>>>>>>>>>>                Move (InsertInArray(asTags, iIndex + iOffset, sInsertTag)) to asTags
25425>>>>>>>>>>>>>                Move True to bAdded
25426>>>>>>>>>>>>>                Move (iIndex + 2) to iIndex
25427>>>>>>>>>>>>>            End
25427>>>>>>>>>>>>>>
25427>>>>>>>>>>>>>            // If we find the same instances we remove it since the client would do it either way.
25427>>>>>>>>>>>>>            Else If (sNormalizedCacheTag = sNormalizedInsertTag) Begin
25430>>>>>>>>>>>>>                Move (RemoveFromArray(asTags, iIndex)) to asTags
25431>>>>>>>>>>>>>            End
25431>>>>>>>>>>>>>>
25431>>>>>>>>>>>>>            Else ;                Increment iIndex
25433>>>>>>>>>>>>>        Loop
25434>>>>>>>>>>>>>>
25434>>>>>>>>>>>>>        
25434>>>>>>>>>>>>>        If (not(bAdded)) ;            Move sInsertTag to asTags[SizeOfArray(asTags)]
25437>>>>>>>>>>>>>            
25437>>>>>>>>>>>>>        // Update the tags.
25437>>>>>>>>>>>>>        Send UpdateTags asTags
25438>>>>>>>>>>>>>    End_Procedure

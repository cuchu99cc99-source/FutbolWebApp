13317>>>>>>>    
13317>>>>>>>    // Load an XML from a string. This aguments the C message to ret 1 if Ok and 0 if error.
13317>>>>>>>    //
13317>>>>>>>    Function LoadXML String sXML Returns Integer
13319>>>>>>>        Integer bRetVal
13319>>>>>>>        // for some reason the parser will not work properly with embedded double quotes.
13319>>>>>>>        // Change all " to ' in document.
13319>>>>>>>        //Move (replaces('"',sXML,"'")) to sXML  // removed this. Bad Idea.
13319>>>>>>>        Forward Get LoadXml sXML to bRetVal
13321>>>>>>>        If (bRetVal = 0) ;            Function_Return True
13324>>>>>>>        Else;            Function_Return False
13326>>>>>>>    End_Function
13327>>>>>>>    
13327>>>>>>>    // Load an XML string from an address. This aguments the C message to ret 1 if Ok and 0 if error.
13327>>>>>>>    //
13327>>>>>>>    Function LoadXMLFromAddress Pointer pXML Returns Integer
13329>>>>>>>        Integer bRetVal
13329>>>>>>>        Forward Get LoadXmlFromAddress pXML to bRetVal
13331>>>>>>>        If (bRetVal = 0) ;            Function_Return True
13334>>>>>>>        Else;            Function_Return False
13336>>>>>>>    End_Function
13337>>>>>>>    
13337>>>>>>>    
13337>>>>>>>    // Allow Nodes and Node node lists to get the parent document.
13337>>>>>>>    
13337>>>>>>>    Function DocumentObject Returns Handle
13339>>>>>>>        Function_Return Self
13340>>>>>>>    End_Function
13341>>>>>>>    
13341>>>>>>>    // Access to the root node allows for searches and iterations.
13341>>>>>>>    // The root node is a cNode.
13341>>>>>>>    
13341>>>>>>>    Function DocumentElement Returns Handle
13343>>>>>>>        Handle hNewNode       // Object ID of Root Node
13343>>>>>>>        Handle infcNode   // XML Element Interface
13343>>>>>>>        Get phDocumentElement to infcNode
13344>>>>>>>        If infcNode Begin
13346>>>>>>>            Get CreateXMLObject U_cXMLDOMElement infcNode to hNewNode
13347>>>>>>>            Set phPrivateDocumentElement to hNewNode // we no longer use this at all
13348>>>>>>>        End
13348>>>>>>>>
13348>>>>>>>        Function_Return hNewNode
13349>>>>>>>    End_Function
13350>>>>>>>    
13350>>>>>>>    //  CreateRootNode is used to set up the first element in a document.
13350>>>>>>>    //  It should only be used when creating new files.
13350>>>>>>>    
13350>>>>>>>    Function CreateDocumentElement String sTagName Returns Handle
13352>>>>>>>        Handle hNewNode       // Object ID of Root Node
13352>>>>>>>        Handle infcNode   // XML Element Interface
13352>>>>>>>        // Call XML to create an element in the document.
13352>>>>>>>        Get CreateElement sTagName to infcNode
13353>>>>>>>        // Tie the element interface to the DataFlex object.
13353>>>>>>>        If infcNode ;            Get CreateXMLObject U_cXMLDOMElement infcNode to hNewNode
13356>>>>>>>        // Call XML to set the root element of the document.
13356>>>>>>>        Set phDocumentElement to infcNode
13357>>>>>>>        Set phPrivateDocumentElement to hNewNode
13358>>>>>>>        Function_Return hNewNode
13359>>>>>>>    End_Function
13360>>>>>>>    
13360>>>>>>>    Function CreateDocumentElementNS String sNamespace String sTagName Returns Handle
13362>>>>>>>        Handle hNewNode       // Object ID of Root Node
13362>>>>>>>        Handle infcNode iType  // XML Element Interface
13362>>>>>>>        Get CreateElementNodeNS sNameSpace sTagName "" to hNewNode
13363>>>>>>>        Get XmlInterface of hNewNode to infcNode
13364>>>>>>>        Set phDocumentElement to infcNode
13365>>>>>>>        Set phPrivateDocumentElement to hNewNode
13366>>>>>>>        Function_Return hNewNode
13367>>>>>>>    End_Function
13368>>>>>>>    
13368>>>>>>>    
13368>>>>>>>    
13368>>>>>>>    // return the DocType as a document-type object. Returns 0 if no dtd
13368>>>>>>>    // Access to information from the doc type object is limited. Use get psXML
13368>>>>>>>    Function DocTypeNode Returns Handle
13370>>>>>>>        Handle hinfcDocType hoDocType
13370>>>>>>>        Get phDocType to hinfcDocType
13371>>>>>>>        If hinfcDocType ;            Get CreateXMLObject U_cXMLDOMDocumentType hinfcDocType to hoDocType
13374>>>>>>>        Function_Return hoDocType

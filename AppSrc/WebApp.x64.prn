7288>>>>>>>>>>>        Property Boolean pbCaseSensitive False
7289>>>>>>>>>>>        
7289>>>>>>>>>>>        /*        Determines if errors should be thrown if the ini file does not exist. Overriden by the         cIniFile compatibility class.        */
7289>>>>>>>>>>>        Property Boolean pbReportReadErrors True 
7290>>>>>>>>>>>        

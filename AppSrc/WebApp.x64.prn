9655>>>>>>>>>    // Used to fetch the default error description.
9655>>>>>>>>>    //
9655>>>>>>>>>    // iError   - Error number
9655>>>>>>>>>    // sMessage - Additional error message
9655>>>>>>>>>    // Returns  - Complete error message
9655>>>>>>>>>    Function ErrorDescription Integer iError String sMessage Returns String
9657>>>>>>>>>        String sDescription
9657>>>>>>>>>        Boolean bAvailable
9657>>>>>>>>>        
9657>>>>>>>>>        //  Fetch system error text
9657>>>>>>>>>        Get Error_Text of Desktop iError to sDescription
9658>>>>>>>>>        Get Error_Text_Available of Desktop iError to bAvailable
9659>>>>>>>>>        
9659>>>>>>>>>        //  Trim both messages
9659>>>>>>>>>        Move (Trim(sDescription)) to sDescription
9660>>>>>>>>>        Move (Trim(sMessage)) to sMessage
9661>>>>>>>>>        
9661>>>>>>>>>        //  Append message if needed
9661>>>>>>>>>        If (sMessage <> "") Begin
9663>>>>>>>>>            If (sDescription <> "" and bAvailable) Begin
9665>>>>>>>>>                Move (sDescription + Character(13) + Character(13) + sMessage) to sDescription
9666>>>>>>>>>            End
9666>>>>>>>>>>
9666>>>>>>>>>            Else Begin
9667>>>>>>>>>                Move sMessage to sDescription
9668>>>>>>>>>            End
9668>>>>>>>>>>
9668>>>>>>>>>        End
9668>>>>>>>>>>
9668>>>>>>>>>        
9668>>>>>>>>>        Function_Return sDescription
9669>>>>>>>>>    End_Function
9670>>>>>>>>>    

785>>>>>>>>>>>// This provides a single call global procedure call to get windows help.
785>>>>>>>>>>>//
785>>>>>>>>>>>// Send gDoWinHelp iHelpType {sHelpFile {String sContext}}
785>>>>>>>>>>>//
785>>>>>>>>>>>// Where iHelpType can be:
785>>>>>>>>>>>//        WH_STRINGCONTEXT  - find by passed context keyword string
785>>>>>>>>>>>//        WH_INTCONTEXT     - find by passed context integer id
785>>>>>>>>>>>//        WH_FINDER         - load help topics dialog
785>>>>>>>>>>>//        WH_HELPONHELP     - windows help on help
785>>>>>>>>>>>//
785>>>>>>>>>>>// This is used by DfHlpCl.pkg (HelpSystem class) to make a API call. You are encouraged to use the
785>>>>>>>>>>>// messages provided by the HelpSystem class. You ARE STRONGLY DISCOURAGED from making direct
785>>>>>>>>>>>// calls to gDoWinHelp!
785>>>>>>>>>>>//
785>>>>>>>>>>>
785>>>>>>>>>>>Use DLL.pkg
785>>>>>>>>>>>
785>>>>>>>>>>>// Commands to pass WinHelp
785>>>>>>>>>>>//
785>>>>>>>>>>>
785>>>>>>>>>>>
785>>>>>>>>>>>//  Call Windows Help engine with string parameter (for searching)
785>>>>>>>>>>>//
785>>>>>>>>>>>External_Function WinHelpStr "WinHelpW" user32.dll ;    Handle  hWnd ;    WString lpHelpFile ;    DWord   cmnd ;    WString lpstr ;    Returns Integer
786>>>>>>>>>>>
786>>>>>>>>>>>//  Call Windows Help engine with dword parameter (for context ID)
786>>>>>>>>>>>//
786>>>>>>>>>>>External_Function WinHelpCntx "WinHelpW" user32.dll ;    Handle  hWnd ;    WString lpHelpFile ;    DWord   cmnd ;    ULongptr cntx ;    Returns Integer
787>>>>>>>>>>>
787>>>>>>>>>>>Enumeration_List
787>>>>>>>>>>>    Define WH_STRINGCONTEXT    // find by context string
787>>>>>>>>>>>    Define WH_INTCONTEXT       // find by context integer id
787>>>>>>>>>>>    Define WH_FINDER           // load help topics dialog
787>>>>>>>>>>>    Define WH_HELPONHELP       // help on help
787>>>>>>>>>>>End_Enumeration_List

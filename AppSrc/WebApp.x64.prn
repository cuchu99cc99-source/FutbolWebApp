7766>>>>>>>>>Class cWorkspace is a cObject
7767>>>>>>>>>    
7767>>>>>>>>>    Procedure Construct_Object
7769>>>>>>>>>        Forward Send Construct_Object
7771>>>>>>>>>        
7771>>>>>>>>>        
7771>>>>>>>>>        Property String psAppSrcPath
7772>>>>>>>>>        Property String psBitmapPath
7773>>>>>>>>>        Property String psDataPath
7774>>>>>>>>>        Property String psDdSrcPath
7775>>>>>>>>>        Property String psDescription
7776>>>>>>>>>        Property String psFileList
7777>>>>>>>>>        Property String psHelpPath
7778>>>>>>>>>        Property String psHome
7779>>>>>>>>>        Property String psIdeSrcPath
7780>>>>>>>>>        Property String psProgramPath
7781>>>>>>>>>        Property String psAppHtmlPath
7782>>>>>>>>>        Property String psWorkspaceName
7783>>>>>>>>>        Property String psWorkspaceWSFile
7784>>>>>>>>>        Property String psConnectionIni
7785>>>>>>>>>        
7785>>>>>>>>>        Property String psSystemDfPath // took from the Registry!
7786>>>>>>>>>        Property String psSystemMakePath // took from the Registry!
7787>>>>>>>>>        Property String psDfPath        // Calculated
7788>>>>>>>>>        
7788>>>>>>>>>        Property Boolean pbWorkspaceOpened False // used internally to tell if we are switching workspaces
7789>>>>>>>>>        
7789>>>>>>>>>    End_Procedure
7790>>>>>>>>>    
7790>>>>>>>>>    Function FullPathNames String sShortPathNames Returns String
7792>>>>>>>>>        String sFileName
7792>>>>>>>>>        String sFullPathNames 
7792>>>>>>>>>        WString sFullPathName sShortPathName
7792>>>>>>>>>        Pointer lpsFilePart
7792>>>>>>>>>        Integer icChar // the number of characters returned
7792>>>>>>>>>        Integer iPos
7792>>>>>>>>>        
7792>>>>>>>>>        Move (Pos(";", sShortPathNames)) to iPos
7793>>>>>>>>>        While (length(sShortPathNames) >0)
7797>>>>>>>>>            If (iPos =0) Begin
7799>>>>>>>>>                Move sShortPathNames to sShortPathName
7800>>>>>>>>>                Move "" to sShortPathNames
7801>>>>>>>>>            End
7801>>>>>>>>>>
7801>>>>>>>>>            Else Begin // multiple paths
7802>>>>>>>>>                Move (Left(sShortPathNames, iPos -1)) to sShortPathName
7803>>>>>>>>>                Move (Right(sShortPathNames, length(sShortPathNames) -iPos)) to sShortPathNames // remove this path from the paths
7804>>>>>>>>>            End
7804>>>>>>>>>>
7804>>>>>>>>>            Move (Repeat(character(0), 4096)) to sFullPathName
7805>>>>>>>>>            Move -1 to lpsFilePart
7806>>>>>>>>>            Move (GetFullPathNameW(sShortPathName, 4096, AddressOf(sFullPathName), AddressOf(lpsFilePart))) to icChar
7807>>>>>>>>>            Append sFullPathNames (CString(sFullPathName))
7808>>>>>>>>>            If (sShortPathNames <>"") ;                Append sFullPathNames ";"
7811>>>>>>>>>            Move (Pos(";", sShortPathNames)) to iPos
7812>>>>>>>>>        Loop
7813>>>>>>>>>>
7813>>>>>>>>>        
7813>>>>>>>>>        Function_Return sFullPathNames
7814>>>>>>>>>    End_Function
7815>>>>>>>>>    
7815>>>>>>>>>    Function GetApplicationPath Returns String
7817>>>>>>>>>        // Returns the path of the Application (no trailing "\")
7817>>>>>>>>>        WString wApplicationFileName 
7817>>>>>>>>>        Boolean bRemoved
7817>>>>>>>>>        Integer iNumChars
7817>>>>>>>>>        String sFilename sPath
7817>>>>>>>>>        
7817>>>>>>>>>        Move (Repeat(Character(0), 1024)) to wApplicationFileName
7818>>>>>>>>>        Move (GetModuleFileNameW(0, AddressOf(wApplicationFileName), 1024)) to iNumChars
7819>>>>>>>>>        Move (CString(wApplicationFileName)) to wApplicationFileName
7820>>>>>>>>>        
7820>>>>>>>>>        Move (PathRemoveFileSpecW(AddressOf(wApplicationFileName))) to bRemoved
7821>>>>>>>>>        Move (CString(wApplicationFileName)) to sPath
7822>>>>>>>>>        
7822>>>>>>>>>        If (Right(sPath, 1) ="\") ;            Move (Left(sPath, Length(sPath) -1)) to sPath
7825>>>>>>>>>        Function_Return sPath
7826>>>>>>>>>    End_Function
7827>>>>>>>>>    
7827>>>>>>>>>    Procedure DoClearPaths
7829>>>>>>>>>        // Call this prior to changing from one WorkspAce to another
7829>>>>>>>>>        // if you don't, OpenWorkspaceFile will ignore the new paths.
7829>>>>>>>>>        Set psHome           to ""
7830>>>>>>>>>        Set psAppSrcPath     to ""
7831>>>>>>>>>        Set psBitmapPath     to ""
7832>>>>>>>>>        Set psDataPath       to ""
7833>>>>>>>>>        Set psDdSrcPath      to ""
7834>>>>>>>>>        Set psDescription    to ""
7835>>>>>>>>>        Set psFileList       to ""
7836>>>>>>>>>        Set psHelpPath       to ""
7837>>>>>>>>>        Set psIdeSrcPath     to ""
7838>>>>>>>>>        Set psAppHtmlPath    to ""
7839>>>>>>>>>        Set psProgramPath    to ""
7840>>>>>>>>>        Set psWorkspaceName  to ""
7841>>>>>>>>>        Set psSystemDfPath   to ""
7842>>>>>>>>>        Set psSystemMakePath to ""
7843>>>>>>>>>        Set psWorkspaceWSFile to ""
7844>>>>>>>>>        Set psConnectionIni to ""
7845>>>>>>>>>    End_Procedure
7846>>>>>>>>>    
7846>>>>>>>>>    Function OpenWorkspaceFile String sWorkspaceFile Returns Integer
7848>>>>>>>>>        WString wApplicationStartPath
7848>>>>>>>>>        String sWsName // name of Workspace is inferred from the Workspacefile name
7848>>>>>>>>>        Boolean bRemoved
7848>>>>>>>>>        Handle hoIniFile
7848>>>>>>>>>        Boolean bSuccess // call succeeded?
7848>>>>>>>>>        String sOldDirectory
7848>>>>>>>>>        String sSystemDfPath sSystemMakePath
7848>>>>>>>>>        Boolean bExist // does the WS file exist?
7848>>>>>>>>>        Boolean bChangingWorkspace
7848>>>>>>>>>        
7848>>>>>>>>>        String sHome sAppSrcPath sBitmapPath sDataPath sDdSrcPath sDescription sAppHtmlPath
7848>>>>>>>>>        String sFileList sHelpPath sIdeSrcPath sProgramPath sWorkspaceName sConnectionIni
7848>>>>>>>>>        
7848>>>>>>>>>        Set psWorkspaceWSFile to ""
7849>>>>>>>>>        If (sWorkspaceFile ="") ;            Function_Return wsWorkspaceFileNotFound
7852>>>>>>>>>        
7852>>>>>>>>>        // Append extension if not supplied...
7852>>>>>>>>>        If (Uppercase(Right(Trim(sWorkspaceFile),3)) <> ".WS") Begin
7854>>>>>>>>>            Move (sWorkspaceFile-".ws") to sWorkspaceFile
7855>>>>>>>>>        End
7855>>>>>>>>>>
7855>>>>>>>>>        
7855>>>>>>>>>        Get pbWorkspaceOpened to bChangingWorkspace // if we had an existing workspace. We are changing
7856>>>>>>>>>        
7856>>>>>>>>>        If (IsFilenameQualified(sWorkspaceFile) = False) Begin
7858>>>>>>>>>            // Set the properties to the paths of the Workspace
7858>>>>>>>>>            // Find the WS file (with program)...
7858>>>>>>>>>            Get GetApplicationPath to wApplicationStartPath
7859>>>>>>>>>            
7859>>>>>>>>>            Move sWorkspaceFile to sWsName
7860>>>>>>>>>            Move (wApplicationStartPath +"\" +sWorkspaceFile) to sWorkspaceFile
7861>>>>>>>>>        End
7861>>>>>>>>>>
7861>>>>>>>>>        Else Begin
7862>>>>>>>>>            Move (ExtractFileName(sWorkspaceFile)) to sWsName
7863>>>>>>>>>            
7863>>>>>>>>>            Move sWorkspaceFile to wApplicationStartPath
7864>>>>>>>>>            Move (PathRemoveFileSpecW(AddressOf(wApplicationStartPath))) to bRemoved
7865>>>>>>>>>        End
7865>>>>>>>>>>
7865>>>>>>>>>        
7865>>>>>>>>>        // Ensure that the file can be found...
7865>>>>>>>>>        //File_Exist (ToAnsi(sWorkspaceFile)) bExist        // [JVH] 8.3.8.0 Convert filename to Ansi
7865>>>>>>>>>        // [JVH] Turn off support for
7865>>>>>>>>>        // Ansi extended characters in workspace until we can
7865>>>>>>>>>        // resolve all open issues
7865>>>>>>>>>        Set psWorkspaceWSFile to sWorkspaceFile
7866>>>>>>>>>        File_Exist sWorkspaceFile bExist
7867>>>>>>>>>        If (bExist = False) ;            Function_Return wsWorkspaceFileNotFound
7870>>>>>>>>>        
7870>>>>>>>>>        Get psHome           to sHome
7871>>>>>>>>>        Get psAppSrcPath     to sAppSrcPath
7872>>>>>>>>>        Get psAppHtmlPath    to sAppHtmlPath
7873>>>>>>>>>        Get psBitmapPath     to sBitmapPath
7874>>>>>>>>>        Get psDataPath       to sDataPath
7875>>>>>>>>>        Get psDdSrcPath      to sDdSrcPath
7876>>>>>>>>>        Get psDescription    to sDescription
7877>>>>>>>>>        Get psFileList       to sFileList
7878>>>>>>>>>        Get psHelpPath       to sHelpPath
7879>>>>>>>>>        Get psIdeSrcPath     to sIdeSrcPath
7880>>>>>>>>>        Get psProgramPath    to sProgramPath
7881>>>>>>>>>        Get psSystemDfPath   to sSystemDfPath
7882>>>>>>>>>        Get psSystemMakePath to sSystemMakePath
7883>>>>>>>>>        Get psWorkspaceName  to sWorkspaceName
7884>>>>>>>>>        Get psConnectionIni to sConnectionIni
7885>>>>>>>>>        
7885>>>>>>>>>        Get_Current_Directory to sOldDirectory
7886>>>>>>>>>        // Note- this conversion is temporarily rolled back
7886>>>>>>>>>        //Move (SetCurrentDirectory(ToAnsi(CString(wApplicationStartPath)))) To bSuccess    // [JVH] 8.3.8.0 Convert AppStartPath to ANSI
7886>>>>>>>>>        Move (SetCurrentDirectory(CString(wApplicationStartPath))) to bSuccess
7887>>>>>>>>>        
7887>>>>>>>>>        Get Create U_cIniFile to hoIniFile
7888>>>>>>>>>        Set psFilename of hoIniFile to sWorkspaceFile
7889>>>>>>>>>        
7889>>>>>>>>>        If (sHome ="") ;            Get ReadString of hoIniFile "Workspace" "Home" ""          to sHome
7892>>>>>>>>>        If (sAppSrcPath ="") ;            Get ReadString of hoIniFile "Workspace" "AppSrcPath" ""    to sAppSrcPath
7895>>>>>>>>>        If (sAppHtmlPath ="") ;            Get ReadString of hoIniFile "Workspace" "AppHtmlPath" ""   to sAppHtmlPath
7898>>>>>>>>>        If (sBitmapPath ="") ;            Get ReadString of hoIniFile "Workspace" "BitmapPath" ""    to sBitmapPath
7901>>>>>>>>>        If (sDataPath ="") ;            Get ReadString of hoIniFile "Workspace" "DataPath" ""      to sDataPath
7904>>>>>>>>>        If (sDdSrcPath ="") ;            Get ReadString of hoIniFile "Workspace" "DdSrcPath" ""     to sDdSrcPath
7907>>>>>>>>>        If (sDescription ="") ;            Get ReadString of hoIniFile "Workspace" "Description" ""   to sDescription
7910>>>>>>>>>        If (sFileList ="") ;            Get ReadString of hoIniFile "Workspace" "FileList" ""      to sFileList
7913>>>>>>>>>        If (sHelpPath ="") ;            Get ReadString of hoIniFile "Workspace" "HelpPath" ""      to sHelpPath
7916>>>>>>>>>        If (sIdeSrcPath ="") ;            Get ReadString of hoIniFile "Workspace" "IdeSrcPath" ""    to sIdeSrcPath
7919>>>>>>>>>        If (sProgramPath ="") ;            Get ReadString of hoIniFile "Workspace" "ProgramPath" ""   to sProgramPath
7922>>>>>>>>>        If (sWorkspaceName ="") ;            Move (Left(sWsName, Length(sWsName) -3))                   to sWorkspaceName
7925>>>>>>>>>        If (sConnectionIni ="") ;            Get ReadString of hoIniFile "Workspace" "ConnectionIni" ""   to sConnectionIni
7928>>>>>>>>>        
7928>>>>>>>>>        If (sSystemDfPath ="") ;            Set psSystemDfPath   to (VdfSystemDfPath(Self))
7931>>>>>>>>>        If (sSystemMakePath ="") ;            Set psSystemMakePath to (VdfSystemMakePath(Self))
7934>>>>>>>>>        
7934>>>>>>>>>        Set psHome          to (FullPathNames(Self, sHome))
7935>>>>>>>>>        
7935>>>>>>>>>        // Set CWD to Home...
7935>>>>>>>>>        Move (SetCurrentDirectory(sHome)) to bSuccess
7936>>>>>>>>>        Set psAppSrcPath    to (FullPathNames(Self, sAppSrcPath))
7937>>>>>>>>>        Set psAppHtmlPath   to (FullPathNames(Self, sAppHtmlPath))
7938>>>>>>>>>        Set psBitmapPath    to (FullPathNames(Self, sBitmapPath))
7939>>>>>>>>>        Set psDataPath      to (FullPathNames(Self, sDataPath))
7940>>>>>>>>>        Set psDdSrcPath     to (FullPathNames(Self, sDdSrcPath))
7941>>>>>>>>>        Set psFileList      to (FullPathNames(Self, sFileList))
7942>>>>>>>>>        Set psHelpPath      to (FullPathNames(Self, sHelpPath))
7943>>>>>>>>>        Set psIdeSrcPath    to (FullPathNames(Self, sIdeSrcPath))
7944>>>>>>>>>        Set psProgramPath   to (FullPathNames(Self, sProgramPath))
7945>>>>>>>>>        Set psConnectionIni to (FullPathNames(Self, sConnectionIni))
7946>>>>>>>>>        
7946>>>>>>>>>        Set psWorkspaceName to sWorkspaceName
7947>>>>>>>>>        Set psDescription   to sDescription
7948>>>>>>>>>        
7948>>>>>>>>>        Send Destroy of hoIniFile // destroy dynaically created inifile object
7949>>>>>>>>>        
7949>>>>>>>>>        // Restore CWD...
7949>>>>>>>>>        Move (SetCurrentDirectory(sOldDirectory)) to sOldDirectory
7950>>>>>>>>>        
7950>>>>>>>>>        // Check for error conditions:
7950>>>>>>>>>        // DataPath and FileList must be defined; the FileList entry must point to a valid FileList.cfg
7950>>>>>>>>>        If (psDataPath(Self) = "") ;            Function_Return wsDataPathEmpty
7953>>>>>>>>>        If (psFileList(Self) = "") ;            Function_Return wsFileListEmpty
7956>>>>>>>>>        
7956>>>>>>>>>        Move (DoesFileExist(psFileList(Self))) to bExist
7957>>>>>>>>>        If (bExist = False) ;            Function_Return wsFileListNotExist
7960>>>>>>>>>        
7960>>>>>>>>>        If bChangingWorkspace ;            Close DF_ALL // if there is a WS open, we must close all the files
7963>>>>>>>>>        
7963>>>>>>>>>        Send DoAssignPaths // set psDfPath
7964>>>>>>>>>        Send DoSetPaths    // Set the application's Attributes of Filelist_Name and Open_Path
7965>>>>>>>>>        Set pbWorkspaceOpened to True
7966>>>>>>>>>        
7966>>>>>>>>>        Function_Return wsWorkspaceOpened
7967>>>>>>>>>    End_Function
7968>>>>>>>>>    
7968>>>>>>>>>    Function OpenWorkspace String sWorkspace Returns Integer
7970>>>>>>>>>        // Look in the Workspaces.ini file for the name, then open it by path
7970>>>>>>>>>        
7970>>>>>>>>>        Handle hoSections hoIniFile
7970>>>>>>>>>        Integer iWorkspace eOpened
7970>>>>>>>>>        String sWorkspaceName sPath
7970>>>>>>>>>        String sVdfRootDir
7970>>>>>>>>>        
7970>>>>>>>>>        Get Create U_Array    to hoSections
7971>>>>>>>>>        Get Create U_cIniFile to hoIniFile
7972>>>>>>>>>        
7972>>>>>>>>>        Get_Profile_String "Defaults" "VdfRootDir" to sVdfRootDir
7975>>>>>>>>>        If (Right(sVdfRootDir,1) <>"\") ;            Move (sVdfRootDir +"\") to sVdfRootDir
7978>>>>>>>>>        
7978>>>>>>>>>        Set psFilename of hoIniFile to (sVdfRootDir +"bin\Workspaces.ini")
7979>>>>>>>>>        
7979>>>>>>>>>        Send ReadSections of hoIniFile hoSections
7980>>>>>>>>>        
7980>>>>>>>>>        For iWorkspace from 0 to (Item_Count(hoSections) -1)
7986>>>>>>>>>>
7986>>>>>>>>>            Get Value of hoSections iWorkspace to sWorkspaceName
7987>>>>>>>>>            If (Uppercase(sWorkspaceName) = Uppercase(sWorkspace)) Begin
7989>>>>>>>>>                Get ReadString of hoIniFile sWorkspace "Path" "" to sPath
7990>>>>>>>>>                If (Right(sPath,1) <>"\") ;                    Move (sPath +"\") to sPath
7993>>>>>>>>>                
7993>>>>>>>>>                Get OpenWorkspaceFile (sPath + sWorkspace) to eOpened
7994>>>>>>>>>                Send Destroy of hoSections
7995>>>>>>>>>                Send Destroy of hoIniFile
7996>>>>>>>>>                Function_Return eOpened
7997>>>>>>>>>            End
7997>>>>>>>>>>
7997>>>>>>>>>        Loop
7998>>>>>>>>>>
7998>>>>>>>>>        
7998>>>>>>>>>        Send Destroy of hoSections
7999>>>>>>>>>        Send Destroy of hoIniFile
8000>>>>>>>>>        Function_Return wsWorkspaceNotFound
8001>>>>>>>>>    End_Function
8002>>>>>>>>>    

5985>>>>>>>    Procedure Request_Superfind Integer eFindMode Integer iFile Integer iField
5987>>>>>>>        Boolean bInSuperFind
5987>>>>>>>        // we need to set pbInSuperFind so Entry_update in the DEOs will know that
5987>>>>>>>        // they should perform an entry_update. Superfind entry_updates have never gone through
5987>>>>>>>        // the DD's field buffer.
5987>>>>>>>        Get pbInSuperFind to bInSuperFind
5988>>>>>>>        Set pbInSuperFind to True
5989>>>>>>>        If (OPERATION_MODE=MODE_WAITING) Begin
5991>>>>>>>            Send Update_Focus_Field_For_Operation MODE_FINDING

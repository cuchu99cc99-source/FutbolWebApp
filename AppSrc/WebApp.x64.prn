26187>>>>>>>>>>>    Function BuildFilter Returns String
26189>>>>>>>>>>>        Integer iColumn iField iFile
26189>>>>>>>>>>>        String sSearchValue sFilter sColumnFilter
26189>>>>>>>>>>>        Boolean bSearchHiddenColumns bHidden
26189>>>>>>>>>>>        Handle hoReadingDD
26189>>>>>>>>>>>        Handle[] ahoColumns
26190>>>>>>>>>>>
26190>>>>>>>>>>>        WebGet psSearchTerm to sSearchValue
26191>>>>>>>>>>>        If (sSearchValue = "") Function_Return ""
26194>>>>>>>>>>>
26194>>>>>>>>>>>        Get ReadingServer to hoReadingDD
26195>>>>>>>>>>>        If (hoReadingDD = 0) Function_Return ""
26198>>>>>>>>>>>
26198>>>>>>>>>>>        Get phoColumnObjects to ahoColumns
26199>>>>>>>>>>>        WebGet pbSearchHiddenColumns to bSearchHiddenColumns
26200>>>>>>>>>>>
26200>>>>>>>>>>>        While (iColumn < SizeOfArray(ahoColumns))
26204>>>>>>>>>>>            WebGet pbHidden of ahoColumns[iColumn] to bHidden
26205>>>>>>>>>>>            If (bSearchHiddenColumns or not(bHidden)) Begin
26207>>>>>>>>>>>                Get Data_File of ahoColumns[iColumn] to iFile
26208>>>>>>>>>>>                Get Data_Field of ahoColumns[iColumn] to iField
26209>>>>>>>>>>>
26209>>>>>>>>>>>                If (iFile <> 0 and iField <> 0) Begin
26211>>>>>>>>>>>                    Get BuildFilterExpressionForField hoReadingDD iFile iField sSearchValue to sColumnFilter
26212>>>>>>>>>>>                    If (sColumnFilter <> "") Begin
26214>>>>>>>>>>>                        If (sFilter <> "") Begin
26216>>>>>>>>>>>                            Move (sFilter + " OR ") to sFilter
26217>>>>>>>>>>>                        End
26217>>>>>>>>>>>>
26217>>>>>>>>>>>                        Move (sFilter + sColumnFilter) to sFilter
26218>>>>>>>>>>>                    End
26218>>>>>>>>>>>>
26218>>>>>>>>>>>                End
26218>>>>>>>>>>>>
26218>>>>>>>>>>>            End
26218>>>>>>>>>>>>
26218>>>>>>>>>>>
26218>>>>>>>>>>>            Increment iColumn
26219>>>>>>>>>>>        Loop
26220>>>>>>>>>>>>
26220>>>>>>>>>>>
26220>>>>>>>>>>>        If (sFilter <> "") Begin
26222>>>>>>>>>>>            Move ("(" + sFilter + ")") to sFilter
26223>>>>>>>>>>>        End
26223>>>>>>>>>>>>
26223>>>>>>>>>>>
26223>>>>>>>>>>>        Function_Return sFilter
26224>>>>>>>>>>>    End_Function

13683>>>>>>>>>>>    Function ErrorCount Returns Integer
13685>>>>>>>>>>>        Function_Return (Item_Count(oErrorNumber))
13686>>>>>>>>>>>    End_Function
13687>>>>>>>>>>>    
13687>>>>>>>>>>>    // Pass Err Num, Error Msg, Line#, File, Field and error-type
13687>>>>>>>>>>>    Procedure Set_Error Integer iErrNr String sErrMsg String sFullErrMsg Integer iLineNr Integer iFileNr Integer iFieldNr
13689>>>>>>>>>>>        Integer iCount
13689>>>>>>>>>>>        Get ErrorCount to iCount
13690>>>>>>>>>>>        Set Value of oErrorNumber iCount to iErrNr
13691>>>>>>>>>>>        Set Value of oErrorText   iCount to sErrMsg
13692>>>>>>>>>>>        Set Value of oFullErrorText iCount to sFullErrMsg
13693>>>>>>>>>>>        Set Value of oLineNr      iCount to iLineNr
13694>>>>>>>>>>>        Set Value of oFileNr      iCount to iFileNr
13695>>>>>>>>>>>        Set Value of oFieldNr     iCount to iFieldNr
13696>>>>>>>>>>>    End_Procedure
13697>>>>>>>>>>>    
13697>>>>>>>>>>>    Function Error_ErrNr Integer iItem Returns Integer
13699>>>>>>>>>>>        Function_Return (Value(oErrorNumber,iItem))
13700>>>>>>>>>>>    End_Function
13701>>>>>>>>>>>    
13701>>>>>>>>>>>    Function Error_LineNr Integer iItem Returns Integer
13703>>>>>>>>>>>        Function_Return (Value(oLineNr,iItem))
13704>>>>>>>>>>>    End_Function
13705>>>>>>>>>>>    
13705>>>>>>>>>>>    Function Error_FileNr Integer iItem Returns Integer
13707>>>>>>>>>>>        Function_Return (Value(oFileNr,iItem))
13708>>>>>>>>>>>    End_Function
13709>>>>>>>>>>>    

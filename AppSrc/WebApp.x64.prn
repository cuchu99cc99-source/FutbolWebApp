31862>>>>>    // Gets the value of a URL parameter based on its name. It parses the URL to determine the 
31862>>>>>    // parameters that are sent and returns the value of the requested parameter ("" if not found).
31862>>>>>    Function UrlParameter String sName Returns String
31864>>>>>        Integer iPos iPos2 iVoid
31864>>>>>        String sUrl
31864>>>>>        WString wsUnescape
31864>>>>>        
31864>>>>>        //  Get the URL from the HTTP header
31864>>>>>        Get ServerVariable of (ServiceDispatcher(Self)) "HTTP_REFERER" to sUrl
31865>>>>>        
31865>>>>>        If (Trim(sUrl) <> "") Begin
31867>>>>>            //  Find ? indicating GET parameters
31867>>>>>            Move (Pos("?", sUrl)) to iPos
31868>>>>>            If (iPos > 0) Begin
31870>>>>>                
31870>>>>>                Move (Uppercase(sName)) to sName
31871>>>>>
31871>>>>>                //  Loop over GET parameters
31871>>>>>                Repeat
31871>>>>>>
31871>>>>>                    //  Determine position of the name
31871>>>>>                    Increment iPos  //  Step over the ? or &
31872>>>>>                    Move (Pos("=", sUrl, iPos)) to iPos2
31873>>>>>                    
31873>>>>>                    //  Check the name
31873>>>>>                    Move (Mid(sURl, iPos2 - iPos, iPos)) to wsUnescape
31874>>>>>                    If (SizeOfWString(wsUnescape) > 0) Begin
31876>>>>>                        Move (UrlUnescapeW(AddressOf(wsUnescape), 0, 0, URL_UNESCAPE_INPLACE ior URL_UNESCAPE_AS_UTF8)) to iVoid
31877>>>>>                    End
31877>>>>>>
31877>>>>>                    If (Uppercase(CString(wsUnescape)) = sName) Begin
31879>>>>>                        
31879>>>>>                        //  Determine position of the value
31879>>>>>                        Increment iPos2 //  Step over the =
31880>>>>>                        Move (Pos("&", sUrl, iPos2)) to iPos
31881>>>>>                        
31881>>>>>                        If (iPos > 0) Begin
31883>>>>>                            Move (Mid(sUrl, iPos - iPos2, iPos2)) to wsUnescape
31884>>>>>                        End
31884>>>>>>
31884>>>>>                        Else Begin
31885>>>>>                            Move ((Mid(sUrl, (Length(sUrl) - iPos2 + 1), iPos2))) to wsUnescape
31886>>>>>                        End
31886>>>>>>
31886>>>>>                        If (SizeOfWString(wsUnescape) > 0) Begin
31888>>>>>                            Move (UrlUnescapeW(AddressOf(wsUnescape), 0, 0, URL_UNESCAPE_INPLACE ior URL_UNESCAPE_AS_UTF8)) to iVoid
31889>>>>>                        End
31889>>>>>>
31889>>>>>                        Function_Return (CString(wsUnescape))
31890>>>>>                    End
31890>>>>>>
31890>>>>>                    
31890>>>>>                    Move (Pos("&", sUrl, iPos2)) to iPos
31891>>>>>                Until (not(iPos > 0)) 
31893>>>>>                
31893>>>>>            End
31893>>>>>>
31893>>>>>        End
31893>>>>>>
31893>>>>>        
31893>>>>>        Function_Return ""
31894>>>>>    End_Function

19201>>>>>>>>>>>>>>>>>        // Published Properties
19201>>>>>>>>>>>>>>>>>        Property Boolean pbFillHeight False            // If True, then the control is vertically stretched to fill all available space. In GridLayout, this will cause it to fill the rows this control is occupying (by default, controls have their natural height through CSS styling)
19204>>>>>>>>>>>>>>>>>        Property Integer piHeight 0                 // Is the explicit fixed height of the control (for most controls you leave this set to 0 so the control's style settings determine the height). Ignored when pbFillHeight is True.
19207>>>>>>>>>>>>>>>>>        Property Integer piMinHeight 0              // Minimum control height (ignored unless pbFillHeight is True)ent)
19210>>>>>>>>>>>>>>>>>        
19210>>>>>>>>>>>>>>>>>        Property Boolean pbShowLabel True              // If False, then no space is assigned for the label in the column layout (see psLabel)
19213>>>>>>>>>>>>>>>>>        Property Integer peLabelAlign C_WebDefault     // Label alignment (alLeft, alCenter, alRight aligned)
19216>>>>>>>>>>>>>>>>>        Property Integer peLabelPosition lpLeft         // Label position relative to the control (lpLeft, lpRight, lpTop, lpFloat)
19219>>>>>>>>>>>>>>>>>        Property Integer piColumnIndex C_WebDefault     // Determines the horizontal column position in the parent panel object
19222>>>>>>>>>>>>>>>>>        Property Integer piColumnSpan 1                // Determines how many columns the width of the control will span (i.e. determines the width of the control, 0 will spann the full available space)
19225>>>>>>>>>>>>>>>>>        Property Integer piRowIndex C_WebDefault        // For LayoutType Grid. -1 = auto
19228>>>>>>>>>>>>>>>>>        Property Integer piRowSpan 1                    // For LayoutType Grid. Amount of rows this control will occupy.
19231>>>>>>>>>>>>>>>>>        Property Integer piLabelOffset C_WebDefault    // Label position (in pixels) relative to the control
19234>>>>>>>>>>>>>>>>>        Property String psLabel ""                     // Is the control's label (see pbShowLabel)
19237>>>>>>>>>>>>>>>>>        Property String psLabelColor ""                // CSS Inline Style - Color of label's text      
19240>>>>>>>>>>>>>>>>>        
19240>>>>>>>>>>>>>>>>>        Property String psToolTip ""                 // Tooltip that is displayed when the mouse is hovered over the control. Set by data binding from Status_Help.

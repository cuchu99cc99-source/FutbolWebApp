22060>>>>>>>>>>>>>    // Splits a view state hash string into the different pieces that it can contain.
22060>>>>>>>>>>>>>    //
22060>>>>>>>>>>>>>    // Params:
22060>>>>>>>>>>>>>    //      sStateHash              Complete view state hash.
22060>>>>>>>>>>>>>    //      ByRef sView             Will receive the view name.
22060>>>>>>>>>>>>>    //      Byref sOptRecordId      (optional) Will receive the record id.
22060>>>>>>>>>>>>>    //      ByRef sOptCustomHash    (optional) Will receive the custom hash.
22060>>>>>>>>>>>>>    Procedure ParseViewStateHash String sStateHash String ByRef sView String ByRef sOptRecordId String ByRef sOptCustomHash
22062>>>>>>>>>>>>>        String[] asParts
22063>>>>>>>>>>>>>        
22063>>>>>>>>>>>>>        //  Cut off possible "/" prefix
22063>>>>>>>>>>>>>        If (Left(sStateHash, 1) = "/") Begin
22065>>>>>>>>>>>>>            Move (Right(sStateHash, Length(sStateHash) - 1)) to sStateHash
22066>>>>>>>>>>>>>        End
22066>>>>>>>>>>>>>>
22066>>>>>>>>>>>>>        
22066>>>>>>>>>>>>>        Move "" to sView
22067>>>>>>>>>>>>>        Move (StrSplitToArray(sStateHash, "-")) to asParts
22068>>>>>>>>>>>>>        
22068>>>>>>>>>>>>>        If (num_arguments > 3) Begin        
22070>>>>>>>>>>>>>            Move "" to sOptCustomHash
22071>>>>>>>>>>>>>
22071>>>>>>>>>>>>>            If (SizeOfArray(asParts) > 2) Begin 
22073>>>>>>>>>>>>>                Get UnescapeViewStatePartial asParts[2] to sOptCustomHash
22074>>>>>>>>>>>>>            End
22074>>>>>>>>>>>>>>
22074>>>>>>>>>>>>>        End
22074>>>>>>>>>>>>>>
22074>>>>>>>>>>>>>        
22074>>>>>>>>>>>>>        If (num_arguments > 2) Begin
22076>>>>>>>>>>>>>            Move "" to sOptRecordId
22077>>>>>>>>>>>>>            
22077>>>>>>>>>>>>>            If (SizeOfArray(asParts) > 1) Begin
22079>>>>>>>>>>>>>                Get UnescapeViewStatePartial asParts[1] to sOptRecordId
22080>>>>>>>>>>>>>            End
22080>>>>>>>>>>>>>>
22080>>>>>>>>>>>>>        End
22080>>>>>>>>>>>>>>
22080>>>>>>>>>>>>>        If (SizeOfArray(asParts) > 0) Begin
22082>>>>>>>>>>>>>            Get UnescapeViewStatePartial asParts[0] to sView
22083>>>>>>>>>>>>>        End
22083>>>>>>>>>>>>>>
22083>>>>>>>>>>>>>        
22083>>>>>>>>>>>>>    End_Procedure

29610>>>>>>>>>>>    //  Parses a multipart/form-data post in chunks. First it validates the header, then it will 
29610>>>>>>>>>>>    //  read chunks and separate the elements. It will trigger OnField for regular field values, it
29610>>>>>>>>>>>    //  will trigger OnFileStart, OnFileChunk and OnFileFinished for all file elements.
29610>>>>>>>>>>>    Function ParseMultipartFormData Returns Boolean
29612>>>>>>>>>>>        Integer iOffset iIndex
29612>>>>>>>>>>>        String sBoundary sFieldname sFilename sFileContentType sContentType
29612>>>>>>>>>>>        Boolean bEqual bAbort
29612>>>>>>>>>>>        tMultipartParsingData parsedata
29612>>>>>>>>>>>        tMultipartParsingData parsedata
29612>>>>>>>>>>>        UChar[] ucValue ucNewLine ucChunk
29615>>>>>>>>>>>        tNameValuePair[] aContentValues
29615>>>>>>>>>>>        tNameValuePair[] aContentValues
29616>>>>>>>>>>>        tNameValuePair tSearch
29616>>>>>>>>>>>        tNameValuePair tSearch
29616>>>>>>>>>>>        
29616>>>>>>>>>>>        Set piParseErrorCode to 0
29617>>>>>>>>>>>        Set psParseError to ""
29618>>>>>>>>>>>        
29618>>>>>>>>>>>        //  Parse and validate content type
29618>>>>>>>>>>>        Get GetContentType to sContentType
29619>>>>>>>>>>>        Get ParseContentType (&sContentType) to aContentValues
29620>>>>>>>>>>>        If (sContentType <> "multipart/form-data") Begin
29622>>>>>>>>>>>            Set piParseErrorCode to 1
29623>>>>>>>>>>>            Set psParseError to "Invalid request format: expected multipart/form-data post"
29624>>>>>>>>>>>            Function_Return False
29625>>>>>>>>>>>        End
29625>>>>>>>>>>>>
29625>>>>>>>>>>>        
29625>>>>>>>>>>>        //  Find BOUNDARY value
29625>>>>>>>>>>>        Move "BOUNDARY" to tSearch.sName
29626>>>>>>>>>>>        Move (SearchArray(tSearch, aContentValues)) to iIndex
29627>>>>>>>>>>>        If (iIndex < 0) Begin
29629>>>>>>>>>>>            Set piParseErrorCode to 2
29630>>>>>>>>>>>            Set psParseError to "Invalid request format: expected boundary in content-type"
29631>>>>>>>>>>>            Function_Return False
29632>>>>>>>>>>>        End
29632>>>>>>>>>>>>
29632>>>>>>>>>>>        Move ("--" + Trim(aContentValues[iIndex].sValue)) to sBoundary
29633>>>>>>>>>>>        
29633>>>>>>>>>>>        Move (StringToUCharArray(sBoundary))    to parsedata.ucBoundary
29634>>>>>>>>>>>        Move False                              to parsedata.bAbort
29635>>>>>>>>>>>        Move 0                                  to parsedata.iChunkOffset
29636>>>>>>>>>>>        Move 13 to ucNewLine[0]
29637>>>>>>>>>>>        Move 10 to ucNewLine[1]
29638>>>>>>>>>>>        
29638>>>>>>>>>>>        //Send LogEvent 1 (SFormat("Boundary size: %1, '%2'", SizeOfArray(parsedata.ucBoundary), sBoundary))
29638>>>>>>>>>>>        
29638>>>>>>>>>>>        //  Initialize parsedata by filling the next chunk and calling ReadChunk
29638>>>>>>>>>>>        Get RequestDataUChar HTTP_DEFAULT_CHUNK_SIZE to parsedata.ucNextChunk
29639>>>>>>>>>>>        Move (SizeOfArray(parsedata.ucNextChunk) < HTTP_DEFAULT_CHUNK_SIZE) to parsedata.bEndOfReq
29640>>>>>>>>>>>        Move (SizeOfArray(parsedata.ucNextChunk)) to parsedata.iSize
29641>>>>>>>>>>>        
29641>>>>>>>>>>>        Send ReadChunk (&parsedata)
29642>>>>>>>>>>>        While (ShouldParseContinue(Self, &parsedata))
29646>>>>>>>>>>>        
29646>>>>>>>>>>>            //  Element always starts with boundary
29646>>>>>>>>>>>            Get FindToken (&parsedata) parsedata.ucBoundary True False to iOffset
29647>>>>>>>>>>>            If (iOffset < 0) Begin
29649>>>>>>>>>>>                Set piParseErrorCode to 3
29650>>>>>>>>>>>                Set psParseError to "Invalid request format: expected boundary"
29651>>>>>>>>>>>                Function_Return False
29652>>>>>>>>>>>            End
29652>>>>>>>>>>>>
29652>>>>>>>>>>>            
29652>>>>>>>>>>>            
29652>>>>>>>>>>>            //  Find the next boundary
29652>>>>>>>>>>>            Get FindToken (&parsedata) parsedata.ucBoundary False False to parsedata.iBoundPos
29653>>>>>>>>>>>            
29653>>>>>>>>>>>            //  Parse the element header
29653>>>>>>>>>>>            Get FindToken (&parsedata) (StringToUCharArray("Content-Disposition")) True True to iOffset
29654>>>>>>>>>>>            If (iOffset > 0) Begin
29656>>>>>>>>>>>                
29656>>>>>>>>>>>                
29656>>>>>>>>>>>                //  Extract field name
29656>>>>>>>>>>>                Get FindToken (&parsedata) (StringToUCharArray('name="')) True True to iOffset
29657>>>>>>>>>>>                Get ExtractField (&parsedata) (StringToUCharArray('"')) True to sFieldname
29658>>>>>>>>>>>                
29658>>>>>>>>>>>                //  Look for file name
29658>>>>>>>>>>>                Get FindToken (&parsedata) (StringToUCharArray('filename="')) True True to iOffset
29659>>>>>>>>>>>                
29659>>>>>>>>>>>                //  If a filename is passed we are handling a file
29659>>>>>>>>>>>                If (iOffset >= 0) Begin
29661>>>>>>>>>>>                    Get ExtractField (&parsedata) (StringToUCharArray('"')) True to sFilename
29662>>>>>>>>>>>                    
29662>>>>>>>>>>>                    //  There might be a content-type, if so it should be before a possible boundpos
29662>>>>>>>>>>>                    Move "" to sFileContentType
29663>>>>>>>>>>>                    Get FindToken (&parsedata) (StringToUCharArray('Content-Type:')) False True to iOffset
29664>>>>>>>>>>>                    
29664>>>>>>>>>>>                    If (iOffset >= 0) Begin
29666>>>>>>>>>>>                        Move (iOffset + SizeOfString('Content-Type:')) to parsedata.iChunkRead
29667>>>>>>>>>>>                        Get ExtractField (&parsedata) ucNewLine True to sFileContentType
29668>>>>>>>>>>>                        Move (Trim(sFileContentType)) to sFileContentType
29669>>>>>>>>>>>                    End
29669>>>>>>>>>>>>
29669>>>>>>>>>>>                    Send SkipNewLine (&parsedata)
29670>>>>>>>>>>>                    
29670>>>>>>>>>>>                    Move False to bAbort
29671>>>>>>>>>>>                    Send OnFileStart sFieldname sFilename sFileContentType (&bAbort)
29672>>>>>>>>>>>                    If (bAbort) Begin
29674>>>>>>>>>>>                        Function_Return False
29675>>>>>>>>>>>                    End
29675>>>>>>>>>>>>
29675>>>>>>>>>>>                    
29675>>>>>>>>>>>                    //  Loop over data sending chunks until boundary or end of request
29675>>>>>>>>>>>                    While (parsedata.iBoundPos < 0 and ShouldParseContinue(Self, &parsedata))
29679>>>>>>>>>>>                        If (parsedata.iChunkRead > 0) Begin
29681>>>>>>>>>>>                            Move (CopyArray(parsedata.ucCurrentChunk, parsedata.iChunkRead, SizeOfArray(parsedata.ucCurrentChunk))) to ucChunk
29682>>>>>>>>>>>                            Send OnFileChunk sFieldname (&ucChunk)
29683>>>>>>>>>>>                        End
29683>>>>>>>>>>>>
29683>>>>>>>>>>>                        Else Begin
29684>>>>>>>>>>>                            Send OnFileChunk sFieldname (&parsedata.ucCurrentChunk)
29685>>>>>>>>>>>                        End
29685>>>>>>>>>>>>
29685>>>>>>>>>>>                        
29685>>>>>>>>>>>                        Send ReadChunk (&parsedata)             
29686>>>>>>>>>>>                    End
29687>>>>>>>>>>>>
29687>>>>>>>>>>>                    
29687>>>>>>>>>>>                    //  Handle last chunk
29687>>>>>>>>>>>                    If (parsedata.iBoundPos > 0) Begin
29689>>>>>>>>>>>                        Move (CopyArray(parsedata.ucCurrentChunk, parsedata.iChunkRead, parsedata.iBoundPos - 3)) to ucChunk // Cut off line feed
29690>>>>>>>>>>>                        Send OnFileChunk sFieldname (&ucChunk) 
29691>>>>>>>>>>>                    End
29691>>>>>>>>>>>>
29691>>>>>>>>>>>                    Else Begin
29692>>>>>>>>>>>                        If (parsedata.iChunkRead > 0 and  SizeOfArray(parsedata.ucCurrentChunk) > parsedata.iChunkRead) Begin
29694>>>>>>>>>>>                            Move (CopyArray(parsedata.ucCurrentChunk, parsedata.iChunkRead, SizeOfArray(parsedata.ucCurrentChunk))) to ucChunk
29695>>>>>>>>>>>                            Send OnFileChunk sFieldname (&ucChunk)
29696>>>>>>>>>>>                        End
29696>>>>>>>>>>>>
29696>>>>>>>>>>>                        Else If (SizeOfArray(parsedata.ucCurrentChunk) > 0) Begin
29699>>>>>>>>>>>                            Send OnFileChunk sFieldname (&parsedata.ucCurrentChunk)
29700>>>>>>>>>>>                        End
29700>>>>>>>>>>>>
29700>>>>>>>>>>>                    End
29700>>>>>>>>>>>>
29700>>>>>>>>>>>                    
29700>>>>>>>>>>>                    //  The file is done
29700>>>>>>>>>>>                    Send OnFileFinished sFieldname
29701>>>>>>>>>>>                    
29701>>>>>>>>>>>                End
29701>>>>>>>>>>>>
29701>>>>>>>>>>>                Else Begin
29702>>>>>>>>>>>                    //  This is an ordinary field
29702>>>>>>>>>>>                    Get FindToken (&parsedata) ucNewLine True True to iOffset
29703>>>>>>>>>>>                    Send SkipNewLine (&parsedata)
29704>>>>>>>>>>>                    
29704>>>>>>>>>>>                    Move (ResizeArray(ucValue, 0)) to ucValue
29705>>>>>>>>>>>                    
29705>>>>>>>>>>>                    While (parsedata.iBoundPos < 0 and ShouldParseContinue(Self, &parsedata))
29709>>>>>>>>>>>                        Move (AppendArray(ucValue, CopyArray(parsedata.ucCurrentChunk, parsedata.iChunkRead, SizeOfArray(parsedata.ucCurrentChunk)))) to ucValue
29710>>>>>>>>>>>                        
29710>>>>>>>>>>>                        Send ReadChunk (&parsedata)            
29711>>>>>>>>>>>                    End
29712>>>>>>>>>>>>
29712>>>>>>>>>>>                    
29712>>>>>>>>>>>                    If (parsedata.iBoundPos > 0) Begin
29714>>>>>>>>>>>                        //  Cut off newline
29714>>>>>>>>>>>                        Move (parsedata.iBoundPos - 1) to iOffset
29715>>>>>>>>>>>                        If (Integer(parsedata.ucCurrentChunk[iOffset]) = 10) ;                            Decrement iOffset
29718>>>>>>>>>>>                        If (Integer(parsedata.ucCurrentChunk[iOffset]) = 13) ;                            Decrement iOffset
29721>>>>>>>>>>>                        Move (AppendArray(ucValue, CopyArray(parsedata.ucCurrentChunk, parsedata.iChunkRead, iOffset))) to ucValue
29722>>>>>>>>>>>                    End
29722>>>>>>>>>>>>
29722>>>>>>>>>>>                    Else Begin
29723>>>>>>>>>>>                        Move (AppendArray(ucValue, CopyArray(parsedata.ucCurrentChunk, parsedata.iChunkRead, SizeOfArray(parsedata.ucCurrentChunk)))) to ucValue
29724>>>>>>>>>>>                        Send ReadChunk (&parsedata)
29725>>>>>>>>>>>                    End
29725>>>>>>>>>>>>
29725>>>>>>>>>>>                    
29725>>>>>>>>>>>                    Send OnField sFieldname ucValue
29726>>>>>>>>>>>                End
29726>>>>>>>>>>>>
29726>>>>>>>>>>>            End
29726>>>>>>>>>>>>
29726>>>>>>>>>>>            Else Begin
29727>>>>>>>>>>>                Send ReadChunk (&parsedata)
29728>>>>>>>>>>>            End
29728>>>>>>>>>>>>
29728>>>>>>>>>>>        Loop
29729>>>>>>>>>>>>
29729>>>>>>>>>>>        
29729>>>>>>>>>>>        Function_Return (not(parsedata.bAbort))

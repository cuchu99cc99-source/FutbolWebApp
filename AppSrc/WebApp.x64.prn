10631>>>>>>>>>        Integer iVoid
10631>>>>>>>>>        String  sEmpty
10631>>>>>>>>>        
10631>>>>>>>>>        // Initialize
10631>>>>>>>>>        Move "" to sEmpty
10632>>>>>>>>>        

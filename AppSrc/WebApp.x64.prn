22207>>>>>>>>>>>>>>>// Used for storing non-scalar (advanced) synchronized properties during the AJAX Call. Next
22207>>>>>>>>>>>>>>>// to the tWebAdvSyncProp struct known by the client it also keeps track of 
22207>>>>>>>>>>>>>>>// changes and caches the deserialized value in a variant for repeative access.
22207>>>>>>>>>>>>>>>Struct tWebCacheAdvProp
22207>>>>>>>>>>>>>>>    Handle hoObj
22207>>>>>>>>>>>>>>>    tWebAdvSyncProp tSyncProp
22207>>>>>>>>>>>>>>>    tWebAdvSyncProp tSyncProp
22207>>>>>>>>>>>>>>>    tWebAdvProp tSvrProp    
22207>>>>>>>>>>>>>>>    tWebAdvProp tSvrProp    
22207>>>>>>>>>>>>>>>    Boolean bChanged
22207>>>>>>>>>>>>>>>    Boolean bDeserialized
22207>>>>>>>>>>>>>>>End_Struct
22207>>>>>>>>>>>>>>>
22207>>>>>>>>>>>>>>>
22207>>>>>>>>>>>>>>>// Sync Props Arrays
22207>>>>>>>>>>>>>>>
22207>>>>>>>>>>>>>>>Global_Variable tWebSyncProps[][] gaSyncProps   // This is the main web properties buffer.
22207>>>>>>>>>>>>>>>
22207>>>>>>>>>>>>>>>// gaSyncChangedProps: Changed properties. There is an array member for each object in 
22207>>>>>>>>>>>>>>>// gaSyncProps. If an Object has changed properties then the pbChanged flag is Set to True.
22207>>>>>>>>>>>>>>>Global_Variable tWebChangedProps[][] gaSyncChangedProps
22207>>>>>>>>>>>>>>>
22207>>>>>>>>>>>>>>>// gaSyncObjectHandles: This stores the object handle for each member of gaSyncProps. Used as an index
22207>>>>>>>>>>>>>>>// to gaSyncProps (and gaSyncChangedProps). C_WebUnresolvedObject is stored for an unresolved object handle.
22207>>>>>>>>>>>>>>>Global_Variable Handle[][] gaSyncObjectHandles
22207>>>>>>>>>>>>>>>
22207>>>>>>>>>>>>>>>// gaAdvSyncProps: This is the buffer for advanced web properties.
22207>>>>>>>>>>>>>>>Global_Variable tWebCacheAdvProp[][] gaAdvSyncProps
22207>>>>>>>>>>>>>>>
22207>>>>>>>>>>>>>>>
22207>>>>>>>>>>>>>>>// The basic web property handler implementation that has logic for storing and maintaining web 
22207>>>>>>>>>>>>>>>// properties in set of global variables. The global variables are used as an optimization as 
22207>>>>>>>>>>>>>>>// storing structs in web properties is inefficient in memory management. The subclasses 
22207>>>>>>>>>>>>>>>// (cWebServerPropHandler and cWebClientPropHandler) will actually store and load the web properties.
22207>>>>>>>>>>>>>>>
22207>>>>>>>>>>>>>>>Class cWebBasePropHandler is a cObject
22208>>>>>>>>>>>>>>>    
22208>>>>>>>>>>>>>>>    Procedure Construct_Object
22210>>>>>>>>>>>>>>>        Integer iIndex
22210>>>>>>>>>>>>>>>        
22210>>>>>>>>>>>>>>>        Forward Send Construct_Object
22212>>>>>>>>>>>>>>>        
22212>>>>>>>>>>>>>>>        //  Reserve index in global stores
22212>>>>>>>>>>>>>>>        Move (SizeOfArray(gaSyncProps)) to iIndex
22213>>>>>>>>>>>>>>>        Move (ResizeArray(gaSyncProps, iIndex + 1)) to gaSyncProps
22214>>>>>>>>>>>>>>>        Move (ResizeArray(gaSyncChangedProps, iIndex + 1)) to gaSyncChangedProps
22215>>>>>>>>>>>>>>>        Move (ResizeArray(gaSyncObjectHandles, iIndex + 1)) to gaSyncObjectHandles
22216>>>>>>>>>>>>>>>        Move (ResizeArray(gaAdvSyncProps, iIndex + 1)) to gaAdvSyncProps
22217>>>>>>>>>>>>>>>        Property Integer piStoreIndex iIndex
22218>>>>>>>>>>>>>>>        
22218>>>>>>>>>>>>>>>        Property Boolean pbErrorObjNotFound True
22219>>>>>>>>>>>>>>>        
22219>>>>>>>>>>>>>>>        // Sync Props Arrays - Allocation Optimization Properties
22219>>>>>>>>>>>>>>>        // In order to optimize web properties we allocate in advance empty array 
22219>>>>>>>>>>>>>>>        // slots in gaSyncProps, gaSyncChangedProps and gaSyncObjectHandles.
22219>>>>>>>>>>>>>>>        
22219>>>>>>>>>>>>>>>        // piSize: This is a pointer to the last object in the gaSyncObjectHandles, gaSyncProps
22219>>>>>>>>>>>>>>>        // and gaSyncChangedProps arrays. When this value equals the size of the arrays then more space
22219>>>>>>>>>>>>>>>        // is allocated in these arrays.
22219>>>>>>>>>>>>>>>        Property Integer piSize 0
22220>>>>>>>>>>>>>>>        
22220>>>>>>>>>>>>>>>        // piCapacity: This is the actual size of the gaSyncObjectHandles, gaSyncProps and gaSyncChangedProps
22220>>>>>>>>>>>>>>>        // arrays. When piObjectCount equals this value, more space is allocated in these arrays.
22220>>>>>>>>>>>>>>>        Property Integer piCapacity 0
22221>>>>>>>>>>>>>>>        
22221>>>>>>>>>>>>>>>        // piGrowthFactor: This is the size of the next jump in size of the gaSyncObjectHandles, gaSyncProps
22221>>>>>>>>>>>>>>>        // and gaSyncChangedProps arrays. This value is used to double the size increase each time more space
22221>>>>>>>>>>>>>>>        // is allocated in the arrays.
22221>>>>>>>>>>>>>>>        Property Integer piGrowthFactor 0
22222>>>>>>>>>>>>>>>        
22222>>>>>>>>>>>>>>>        // pbActive: When False, all calls to get or set a web property are ignored.
22222>>>>>>>>>>>>>>>        // This ensures that web properties are only accessed during an AJAX call.
22222>>>>>>>>>>>>>>>        // Otherwise, attempting to access web properties outside an AJAX call can 
22222>>>>>>>>>>>>>>>        // corrupt the web properties system.
22222>>>>>>>>>>>>>>>        Property Boolean pbActive False
22223>>>>>>>>>>>>>>>        
22223>>>>>>>>>>>>>>>        Property Handle phoWebControlLocator 0
22224>>>>>>>>>>>>>>>        Property Handle phoWebHost C_WebUnresolvedObject
22225>>>>>>>>>>>>>>>    End_Procedure
22226>>>>>>>>>>>>>>>    
22226>>>>>>>>>>>>>>>    
22226>>>>>>>>>>>>>>>    //
22226>>>>>>>>>>>>>>>    // Adds the passed object to the global web properties arrays. It is assumed that the object is a cWebObject.
22226>>>>>>>>>>>>>>>    //
22226>>>>>>>>>>>>>>>    // Returns:
22226>>>>>>>>>>>>>>>    //      The object's index to the global sync props array.
22226>>>>>>>>>>>>>>>    Function AddObjectToSyncProps Handle hoObject Returns Integer
22228>>>>>>>>>>>>>>>        String sObjectName
22228>>>>>>>>>>>>>>>        Integer iStoreIndex iSize iCapacity iGrowthFactor iObjectIndex
22228>>>>>>>>>>>>>>>        
22228>>>>>>>>>>>>>>>        Move -1 to iObjectIndex
22229>>>>>>>>>>>>>>>        
22229>>>>>>>>>>>>>>>        If (hoObject > 0) Begin
22231>>>>>>>>>>>>>>>            Get piStoreIndex to iStoreIndex
22232>>>>>>>>>>>>>>>            Get piSize to iSize
22233>>>>>>>>>>>>>>>            Get piCapacity to iCapacity
22234>>>>>>>>>>>>>>>            Get piGrowthFactor to iGrowthFactor
22235>>>>>>>>>>>>>>>            Get WebObjectName of hoObject to sObjectName
22236>>>>>>>>>>>>>>>            
22236>>>>>>>>>>>>>>>            // Determine if we need to increase the array sizes....
22236>>>>>>>>>>>>>>>            If (iSize = iCapacity) Begin
22238>>>>>>>>>>>>>>>                Move (iGrowthFactor + iGrowthFactor) to iGrowthFactor    // double the growth factor
22239>>>>>>>>>>>>>>>                Move (iCapacity + iGrowthFactor) to iCapacity            // increase the capacity
22240>>>>>>>>>>>>>>>    
22240>>>>>>>>>>>>>>>                Set piCapacity to iCapacity
22241>>>>>>>>>>>>>>>                Set piGrowthFactor to iGrowthFactor
22242>>>>>>>>>>>>>>>                
22242>>>>>>>>>>>>>>>                Move (ResizeArray(gaSyncProps[iStoreIndex], iCapacity)) to gaSyncProps[iStoreIndex]
22243>>>>>>>>>>>>>>>                Move (ResizeArray(gaSyncObjectHandles[iStoreIndex], iCapacity)) to gaSyncObjectHandles[iStoreIndex]
22244>>>>>>>>>>>>>>>                Move (ResizeArray(gaSyncChangedProps[iStoreIndex], iCapacity)) to gaSyncChangedProps[iStoreIndex]
22245>>>>>>>>>>>>>>>            End
22245>>>>>>>>>>>>>>>>
22245>>>>>>>>>>>>>>>            
22245>>>>>>>>>>>>>>>            // Add the passed object to gaSyncObjectHandles....
22245>>>>>>>>>>>>>>>            Set piSize       to (iSize + 1)
22246>>>>>>>>>>>>>>>            Move iSize       to iObjectIndex
22247>>>>>>>>>>>>>>>            Move hoObject    to gaSyncObjectHandles[iStoreIndex][iObjectIndex]
22248>>>>>>>>>>>>>>>            Move False       to gaSyncChangedProps[iStoreIndex][iObjectIndex].bContainsChanges    // False so far because we did not find the property yet
22249>>>>>>>>>>>>>>>            Move sObjectName to gaSyncProps[iStoreIndex][iObjectIndex].sO
22250>>>>>>>>>>>>>>>        End
22250>>>>>>>>>>>>>>>>
22250>>>>>>>>>>>>>>>        
22250>>>>>>>>>>>>>>>        Function_Return iObjectIndex
22251>>>>>>>>>>>>>>>    End_Function
22252>>>>>>>>>>>>>>>    
22252>>>>>>>>>>>>>>>    //
22252>>>>>>>>>>>>>>>    // Returns the value for non-scalar (advanced) web properties. These are stored separate from
22252>>>>>>>>>>>>>>>    // the scalar web properties. It looks for the 'synchronized' value in the gaAdvSyncProps store.
22252>>>>>>>>>>>>>>>    //
22252>>>>>>>>>>>>>>>    // Params:
22252>>>>>>>>>>>>>>>    //      hoObject  - Is handle to the object which ownes the property.
22252>>>>>>>>>>>>>>>    //      hmGetter  - Is a handle to the property's getter message.
22252>>>>>>>>>>>>>>>    //      sPropName - Is the (case sensitive) property name.
22252>>>>>>>>>>>>>>>    // Returns:
22252>>>>>>>>>>>>>>>    //      The property value as a variant.
22252>>>>>>>>>>>>>>>    //
22252>>>>>>>>>>>>>>>    // Use the WebGet command instead of sending this message directly. hoObject must belong to the
22252>>>>>>>>>>>>>>>    // set of 'scoped views' in the CallAction otherwise the web property value is considered
22252>>>>>>>>>>>>>>>    // to be "out of scope".
22252>>>>>>>>>>>>>>>    Function GetAdvSyncProp Handle hoObject tWebPropMetaData ByRef pubProp Returns Variant
22254>>>>>>>>>>>>>>>        Integer iObjectIndex icProp iProp iSize iStoreIndex
22254>>>>>>>>>>>>>>>        String sUC_PropName sReturnValue
22254>>>>>>>>>>>>>>>        Variant vReturnValue
22254>>>>>>>>>>>>>>>        Boolean bFoundProp bIsAjaxWebObject bIsObjectInScope
22254>>>>>>>>>>>>>>>            
22254>>>>>>>>>>>>>>>        // Test if we are active....
22254>>>>>>>>>>>>>>>        If (not(pbActive(Self))) Begin
22256>>>>>>>>>>>>>>>            // If not active then we just return the design time value of the property. This is
22256>>>>>>>>>>>>>>>            // safe because we can only get here when the WebApp is being initialized, before any
22256>>>>>>>>>>>>>>>            // clients have loaded the webapp....
22256>>>>>>>>>>>>>>>            Get pubProp.hmGetter of hoObject to vReturnValue
22257>>>>>>>>>>>>>>>            Function_Return vReturnValue
22258>>>>>>>>>>>>>>>        End
22258>>>>>>>>>>>>>>>>
22258>>>>>>>>>>>>>>>        
22258>>>>>>>>>>>>>>>        Get piStoreIndex to iStoreIndex
22259>>>>>>>>>>>>>>>    
22259>>>>>>>>>>>>>>>        Get FindAdvPropCache hoObject pubProp.sName to iProp
22260>>>>>>>>>>>>>>>        If (iProp = -1) Begin
22262>>>>>>>>>>>>>>>            //  Use the raw property
22262>>>>>>>>>>>>>>>            Get pubprop.hmGetter of hoObject to vReturnValue
22263>>>>>>>>>>>>>>>        End
22263>>>>>>>>>>>>>>>>
22263>>>>>>>>>>>>>>>        Else Begin
22264>>>>>>>>>>>>>>>            If (not(gaAdvSyncProps[iStoreIndex][iProp].bDeserialized)) Begin
22266>>>>>>>>>>>>>>>                //  Initialize our variant with an advanced value of the right type to make valuetreedeserialize work (!IMPORTANT)
22266>>>>>>>>>>>>>>>                Get pubProp.hmGetter of hoObject to vReturnValue
22267>>>>>>>>>>>>>>>                ValueTreeDeserializeParameter gaAdvSyncProps[iStoreIndex][iProp].tSyncProp.tV to vReturnValue
22268>>>>>>>>>>>>>>>                
22268>>>>>>>>>>>>>>>                Move vReturnValue to gaAdvSyncProps[iStoreIndex][iProp].tSvrProp.vV
22269>>>>>>>>>>>>>>>                Move True to gaAdvSyncProps[iStoreIndex][iProp].bDeserialized
22270>>>>>>>>>>>>>>>            End
22270>>>>>>>>>>>>>>>>
22270>>>>>>>>>>>>>>>            Else Begin
22271>>>>>>>>>>>>>>>                Move gaAdvSyncProps[iStoreIndex][iProp].tSvrProp.vV to vReturnValue
22272>>>>>>>>>>>>>>>            End
22272>>>>>>>>>>>>>>>>
22272>>>>>>>>>>>>>>>        End
22272>>>>>>>>>>>>>>>>
22272>>>>>>>>>>>>>>>        Function_Return vReturnValue
22273>>>>>>>>>>>>>>>    End_Function
22274>>>>>>>>>>>>>>>    
22274>>>>>>>>>>>>>>>    
22274>>>>>>>>>>>>>>>    //
22274>>>>>>>>>>>>>>>    // Returns the value for scalar web properties. It looks for a synchronized value in the
22274>>>>>>>>>>>>>>>    // global gaSycnProps store.
22274>>>>>>>>>>>>>>>    //
22274>>>>>>>>>>>>>>>    // Params:
22274>>>>>>>>>>>>>>>    //      hoObject  - Is handle to the object which ownes the property.
22274>>>>>>>>>>>>>>>    //      hmGetter  - Is a handle to the property's getter message.
22274>>>>>>>>>>>>>>>    //      sPropName - Is the (case sensitive) property name.
22274>>>>>>>>>>>>>>>    // Returns:
22274>>>>>>>>>>>>>>>    //      The property value as a variant.
22274>>>>>>>>>>>>>>>    //
22274>>>>>>>>>>>>>>>    // Use the WebGet command instead of sending this message directly. hoObject must belong to the
22274>>>>>>>>>>>>>>>    // set of 'scoped views' in the CallAction otherwise the web property value is considered
22274>>>>>>>>>>>>>>>    // to be "out of scope".
22274>>>>>>>>>>>>>>>    Function GetScalarSyncProp Handle hoObject tWebPropMetaData ByRef pubProp Returns String
22276>>>>>>>>>>>>>>>        Integer iObjectIndex icProp iProp iSize iStoreIndex
22276>>>>>>>>>>>>>>>        String sUC_PropName sReturnValue
22276>>>>>>>>>>>>>>>        Boolean bFoundProp bIsObjectInScope
22276>>>>>>>>>>>>>>>            
22276>>>>>>>>>>>>>>>        // Test if we are active....
22276>>>>>>>>>>>>>>>        If (not(pbActive(Self))) Begin
22278>>>>>>>>>>>>>>>            // If not active then we just return the design time value of the property. This is
22278>>>>>>>>>>>>>>>            // safe because we can only get here when the WebApp is being initialized, before any
22278>>>>>>>>>>>>>>>            // clients have loaded the webapp....
22278>>>>>>>>>>>>>>>            Get pubProp.hmGetter of hoObject to sReturnValue
22279>>>>>>>>>>>>>>>            Function_Return sReturnValue
22280>>>>>>>>>>>>>>>        End
22280>>>>>>>>>>>>>>>>
22280>>>>>>>>>>>>>>>        
22280>>>>>>>>>>>>>>>        Get piStoreIndex to iStoreIndex
22281>>>>>>>>>>>>>>>        
22281>>>>>>>>>>>>>>>        // get the sync props index for the passed object handle...
22281>>>>>>>>>>>>>>>        Move (Uppercase(pubProp.sName)) to sUC_PropName
22282>>>>>>>>>>>>>>>        Get piSize to iSize
22283>>>>>>>>>>>>>>>//            Get piSyncObjectIndex of hoObject to iObjectIndex
22283>>>>>>>>>>>>>>>        Get FindObjectIndex hoObject to iObjectIndex
22284>>>>>>>>>>>>>>>        
22284>>>>>>>>>>>>>>>        If (iObjectIndex = -1 or iObjectIndex >= iSize) Begin
22286>>>>>>>>>>>>>>>            // If iObjectIndex = -1 it means that this object does not currently have any web properties.
22286>>>>>>>>>>>>>>>            // It might also mean that this object is out of scope during this CallAction. An object is only in-scope
22286>>>>>>>>>>>>>>>            // if it is a global object cWebApp or its child objects, or the object is part of the stack of views\
22286>>>>>>>>>>>>>>>            // dialog that are passed in the cWebObject's paDDOViews property.
22286>>>>>>>>>>>>>>>            Get IsObjectInCallActionScope hoObject to bIsObjectInScope
22287>>>>>>>>>>>>>>>            
22287>>>>>>>>>>>>>>>            If (bIsObjectInScope) Begin
22289>>>>>>>>>>>>>>>                //  Use the raw property
22289>>>>>>>>>>>>>>>                Get pubprop.hmGetter of hoObject to sReturnValue
22290>>>>>>>>>>>>>>>            End
22290>>>>>>>>>>>>>>>>
22290>>>>>>>>>>>>>>>            Else Begin
22291>>>>>>>>>>>>>>>                Error DFERR_PROGRAM (SFormat(C_$WebAppObjectOutOfScope, If(hoObject > 0, Name(hoObject), ""), "WebGet " + pubProp.sName, C_NewLine))
22292>>>>>>>>>>>>>>>>
22292>>>>>>>>>>>>>>>            End
22292>>>>>>>>>>>>>>>>
22292>>>>>>>>>>>>>>>        End
22292>>>>>>>>>>>>>>>>
22292>>>>>>>>>>>>>>>        Else Begin
22293>>>>>>>>>>>>>>>            // Search for the property name....
22293>>>>>>>>>>>>>>>            Move (SizeOfArray(gaSyncProps[iStoreIndex][iObjectIndex].aP)) to icProp
22294>>>>>>>>>>>>>>>            Move False to bFoundProp
22295>>>>>>>>>>>>>>>            
22295>>>>>>>>>>>>>>>            For iProp from 0 to (icProp - 1)
22301>>>>>>>>>>>>>>>>
22301>>>>>>>>>>>>>>>                If (Uppercase(gaSyncProps[iStoreIndex][iObjectIndex].aP[iProp].sN) = sUC_PropName) Begin
22303>>>>>>>>>>>>>>>                    Move gaSyncProps[iStoreIndex][iObjectIndex].aP[iProp].sV to sReturnValue
22304>>>>>>>>>>>>>>>                    
22304>>>>>>>>>>>>>>>                    // Send Hook for converting the value from format for transport.
22304>>>>>>>>>>>>>>>                    Get ConvertFromTransport of hoObject pubProp.hmGetter sReturnValue pubProp.eType to sReturnValue
22305>>>>>>>>>>>>>>>
22305>>>>>>>>>>>>>>>                    Move True to bFoundProp
22306>>>>>>>>>>>>>>>                End
22306>>>>>>>>>>>>>>>>
22306>>>>>>>>>>>>>>>                If (bFoundProp) ;                    Break
22309>>>>>>>>>>>>>>>            Loop
22310>>>>>>>>>>>>>>>>
22310>>>>>>>>>>>>>>>            
22310>>>>>>>>>>>>>>>            If (not(bFoundProp)) Begin
22312>>>>>>>>>>>>>>>                //  Use the raw property
22312>>>>>>>>>>>>>>>                Get pubprop.hmGetter of hoObject to sReturnValue
22313>>>>>>>>>>>>>>>            End
22313>>>>>>>>>>>>>>>>
22313>>>>>>>>>>>>>>>        End
22313>>>>>>>>>>>>>>>>
22313>>>>>>>>>>>>>>>        
22313>>>>>>>>>>>>>>>        Function_Return sReturnValue
22314>>>>>>>>>>>>>>>    End_Function
22315>>>>>>>>>>>>>>>    
22315>>>>>>>>>>>>>>>    
22315>>>>>>>>>>>>>>>    //
22315>>>>>>>>>>>>>>>    // Called when a request is finished. Marks the handler as inactive.
22315>>>>>>>>>>>>>>>    //
22315>>>>>>>>>>>>>>>    Procedure FinishedCall tWebSyncProps[] ByRef aChangedSyncProps tWebAdvSyncProp[] ByRef aChangedAdvSyncProps
22317>>>>>>>>>>>>>>>        Set pbActive to False
22318>>>>>>>>>>>>>>>    End_Procedure
22319>>>>>>>>>>>>>>>    
22319>>>>>>>>>>>>>>>    
22319>>>>>>>>>>>>>>>    //
22319>>>>>>>>>>>>>>>    // Triggered when a new request comes in.
22319>>>>>>>>>>>>>>>    //
22319>>>>>>>>>>>>>>>    Procedure InitializeCall tWebSyncProps[] aSyncProps tWebAdvSyncProp[] aAdvSyncProps
22321>>>>>>>>>>>>>>>        Set pbActive to True
22322>>>>>>>>>>>>>>>    End_Procedure
22323>>>>>>>>>>>>>>>    
22323>>>>>>>>>>>>>>>    //
22323>>>>>>>>>>>>>>>    // Triggered to clear the data between requests. Resets al data stored during a request.
22323>>>>>>>>>>>>>>>    //
22323>>>>>>>>>>>>>>>    Procedure ClearData
22325>>>>>>>>>>>>>>>        tWebChangedProps[] aEmptyChanged
22325>>>>>>>>>>>>>>>        tWebChangedProps[] aEmptyChanged
22326>>>>>>>>>>>>>>>        tWebSyncProps[] aEmptySync
22326>>>>>>>>>>>>>>>        tWebSyncProps[] aEmptySync
22327>>>>>>>>>>>>>>>        tWebCacheAdvProp[] aEmptyAdv
22327>>>>>>>>>>>>>>>        tWebCacheAdvProp[] aEmptyAdv
22328>>>>>>>>>>>>>>>        Handle[] aEmptyHandle
22329>>>>>>>>>>>>>>>        Integer iStoreIndex
22329>>>>>>>>>>>>>>>        
22329>>>>>>>>>>>>>>>        Get piStoreIndex to iStoreIndex
22330>>>>>>>>>>>>>>>        Move aEmptyChanged to gaSyncChangedProps[iStoreIndex]
22331>>>>>>>>>>>>>>>        Move aEmptySync to gaSyncProps[iStoreIndex]
22332>>>>>>>>>>>>>>>        Move aEmptyAdv to gaAdvSyncProps[iStoreIndex]
22333>>>>>>>>>>>>>>>        Move aEmptyHandle to gaSyncObjectHandles[iStoreIndex]
22334>>>>>>>>>>>>>>>        
22334>>>>>>>>>>>>>>>        Set piSize to 0
22335>>>>>>>>>>>>>>>        Set piCapacity to 0
22336>>>>>>>>>>>>>>>        
22336>>>>>>>>>>>>>>>        Set pbActive to False
22337>>>>>>>>>>>>>>>    End_Procedure
22338>>>>>>>>>>>>>>>    
22338>>>>>>>>>>>>>>>    //
22338>>>>>>>>>>>>>>>    // Determines if an object is in scope for WebGet / WebSet.
22338>>>>>>>>>>>>>>>    //
22338>>>>>>>>>>>>>>>    Function IsObjectInCallActionScope Handle hoObject Returns Boolean
22340>>>>>>>>>>>>>>>        Boolean bResult
22340>>>>>>>>>>>>>>>        
22340>>>>>>>>>>>>>>>        Get IsInCallActionScope of hoObject to bResult
22341>>>>>>>>>>>>>>>        
22341>>>>>>>>>>>>>>>        Function_Return bResult
22342>>>>>>>>>>>>>>>    End_Function
22343>>>>>>>>>>>>>>>    
22343>>>>>>>>>>>>>>>    //
22343>>>>>>>>>>>>>>>    // Stores the passed web properties array and sets up the object to work with
22343>>>>>>>>>>>>>>>    // this data.
22343>>>>>>>>>>>>>>>    //
22343>>>>>>>>>>>>>>>    // Params:
22343>>>>>>>>>>>>>>>    //      aSyncProps   - Is the set of web properties from the client
22343>>>>>>>>>>>>>>>    //
22343>>>>>>>>>>>>>>>    Procedure InitializeSyncProps tWebSyncProps[] aSyncProps
22345>>>>>>>>>>>>>>>        Integer iObj iProp iSize iCapacity iGrowthFactor iStoreIndex
22345>>>>>>>>>>>>>>>        Handle hoObject hoControlLocator
22345>>>>>>>>>>>>>>>        Handle[] aChildObjects
22346>>>>>>>>>>>>>>>        
22346>>>>>>>>>>>>>>>        Get piStoreIndex to iStoreIndex
22347>>>>>>>>>>>>>>>        Get phoWebControlLocator to hoControlLocator
22348>>>>>>>>>>>>>>>        
22348>>>>>>>>>>>>>>>        // Set up the array size management properties....
22348>>>>>>>>>>>>>>>        Move (SizeOfArray(aSyncProps)) to iSize
22349>>>>>>>>>>>>>>>        Move 100                       to iGrowthFactor    // This is the initial growth factor of the arrays. It doubles each time the array is resized.
22350>>>>>>>>>>>>>>>        Move (iSize max iGrowthFactor) to iCapacity
22351>>>>>>>>>>>>>>>        
22351>>>>>>>>>>>>>>>        Set piSize to iSize
22352>>>>>>>>>>>>>>>        Set piGrowthFactor to iGrowthFactor
22353>>>>>>>>>>>>>>>        Set piCapacity to iCapacity
22354>>>>>>>>>>>>>>>        
22354>>>>>>>>>>>>>>>        // Preallocate space for sync properties (plus some growth)....
22354>>>>>>>>>>>>>>>        Move (ResizeArray(aSyncProps, iCapacity)) to aSyncProps
22355>>>>>>>>>>>>>>>        Move (ResizeArray(gaSyncObjectHandles[iStoreIndex], iCapacity)) to gaSyncObjectHandles[iStoreIndex]     // We do not clear the array first. That is because we will just overwrite the old values.
22356>>>>>>>>>>>>>>>        Move (ResizeArray(gaSyncChangedProps[iStoreIndex], 0)) to gaSyncChangedProps[iStoreIndex]               // This global array must be cleared first! We cannot guarantee that the old values will be fully overwritten.
22357>>>>>>>>>>>>>>>        Move (ResizeArray(gaSyncChangedProps[iStoreIndex], iCapacity)) to gaSyncChangedProps[iStoreIndex]       // now size it to the correct value
22358>>>>>>>>>>>>>>>        
22358>>>>>>>>>>>>>>>        // Iterate each member and find the object reference.....
22358>>>>>>>>>>>>>>>        For iObj from 0 to (iSize - 1)
22364>>>>>>>>>>>>>>>>
22364>>>>>>>>>>>>>>>            Get FindWebObject of hoControlLocator aSyncProps[iObj].sO to hoObject
22365>>>>>>>>>>>>>>>            
22365>>>>>>>>>>>>>>>            If (hoObject = C_WebUnresolvedObject) Begin
22367>>>>>>>>>>>>>>>                If (pbErrorObjNotFound(Self)) Begin
22369>>>>>>>>>>>>>>>                    Error DFERR_PROGRAM (SFormat(C_$WebAppTargetObjectNotFound, aSyncProps[iObj].sO))
22370>>>>>>>>>>>>>>>>
22370>>>>>>>>>>>>>>>                End
22370>>>>>>>>>>>>>>>>
22370>>>>>>>>>>>>>>>            End
22370>>>>>>>>>>>>>>>>
22370>>>>>>>>>>>>>>>            Else Begin
22371>>>>>>>>>>>>>>>//                Set piSyncObjectIndex of hoObject to iObj    // Cache the object's index in the object itself
22371>>>>>>>>>>>>>>>            End
22371>>>>>>>>>>>>>>>>
22371>>>>>>>>>>>>>>>            
22371>>>>>>>>>>>>>>>            // Populate the shadow structs....
22371>>>>>>>>>>>>>>>            Move hoObject to gaSyncObjectHandles[iStoreIndex][iObj]
22372>>>>>>>>>>>>>>>            Move False to gaSyncChangedProps[iStoreIndex][iObj].bContainsChanges
22373>>>>>>>>>>>>>>>        Loop
22374>>>>>>>>>>>>>>>>
22374>>>>>>>>>>>>>>>
22374>>>>>>>>>>>>>>>        // Store the web property data....
22374>>>>>>>>>>>>>>>        Move aSyncProps to gaSyncProps[iStoreIndex]
22375>>>>>>>>>>>>>>>    End_Procedure
22376>>>>>>>>>>>>>>>    
22376>>>>>>>>>>>>>>>    
22376>>>>>>>>>>>>>>>    //
22376>>>>>>>>>>>>>>>    // Sets the addressed web property to the passed value. (see also GetScalarSyncProp)
22376>>>>>>>>>>>>>>>    //
22376>>>>>>>>>>>>>>>    // Params:
22376>>>>>>>>>>>>>>>    //      hoObject   - Is handle to the object which owns the property.
22376>>>>>>>>>>>>>>>    //      hmGetter   - Is a handle to the property's getter message.
22376>>>>>>>>>>>>>>>    //      sPropName  - Is the (case sensitive) property name.
22376>>>>>>>>>>>>>>>    //      sPropValue - Is the property value.
22376>>>>>>>>>>>>>>>    //
22376>>>>>>>>>>>>>>>    // Use the WebSet command instead of sending this message.
22376>>>>>>>>>>>>>>>    //
22376>>>>>>>>>>>>>>>    Procedure SetSyncProp Handle hoObject tWebPropMetaData ByRef pubProp Variant vPropValue
22378>>>>>>>>>>>>>>>        Integer iObjectIndex icProp iProp iSyncPropIndex iStoreIndex
22378>>>>>>>>>>>>>>>        Integer icObject iIndex iCount iSize
22378>>>>>>>>>>>>>>>        Boolean bFoundSyncProp bSaveProp bIsAjaxWebObject
22378>>>>>>>>>>>>>>>        String sUC_PropName sObject sPropValue
22378>>>>>>>>>>>>>>>        tWebValueTree tVT
22378>>>>>>>>>>>>>>>        tWebValueTree tVT
22378>>>>>>>>>>>>>>>        Variant vTest
22378>>>>>>>>>>>>>>>        
22378>>>>>>>>>>>>>>>        // Test if we are active....
22378>>>>>>>>>>>>>>>        Get Object_Label of hoObject to sObject
22379>>>>>>>>>>>>>>>
22379>>>>>>>>>>>>>>>        If (not(pbActive(Self))) Begin
22381>>>>>>>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppSynPropsNotReady, sObject, "WebSet " + pubProp.sName))
22382>>>>>>>>>>>>>>>>
22382>>>>>>>>>>>>>>>            Procedure_Return
22383>>>>>>>>>>>>>>>        End
22383>>>>>>>>>>>>>>>>
22383>>>>>>>>>>>>>>>
22383>>>>>>>>>>>>>>>
22383>>>>>>>>>>>>>>>        // Try to find the the sync prop in the published props array...
22383>>>>>>>>>>>>>>>        Get piStoreIndex to iStoreIndex
22384>>>>>>>>>>>>>>>        
22384>>>>>>>>>>>>>>>        //  Determine if advanced (struct / array) property
22384>>>>>>>>>>>>>>>        If (pubProp.eType = cArgArray or pubProp.eType = cArgStruct) Begin
22386>>>>>>>>>>>>>>>            //  Find advanced sync prop in the cache
22386>>>>>>>>>>>>>>>            Get FindAdvPropCache hoObject pubProp.sName to iProp
22387>>>>>>>>>>>>>>>            //  If not found then add it to the cache
22387>>>>>>>>>>>>>>>            If (iProp = -1) Begin
22389>>>>>>>>>>>>>>>                // Add the property....
22389>>>>>>>>>>>>>>>                Get AddToAdvPropCache hoObject pubProp.sName to iProp
22390>>>>>>>>>>>>>>>            End
22390>>>>>>>>>>>>>>>>
22390>>>>>>>>>>>>>>>            
22390>>>>>>>>>>>>>>>            //  Store the value and mark as changed
22390>>>>>>>>>>>>>>>            Move vPropValue to gaAdvSyncProps[iStoreIndex][iProp].tSvrProp.vV
22391>>>>>>>>>>>>>>>            Move True       to gaAdvSyncProps[iStoreIndex][iProp].bDeserialized
22392>>>>>>>>>>>>>>>            Move True       to gaAdvSyncProps[iStoreIndex][iProp].bChanged
22393>>>>>>>>>>>>>>>        End
22393>>>>>>>>>>>>>>>>
22393>>>>>>>>>>>>>>>        Else Begin
22394>>>>>>>>>>>>>>>            // get the sync props index for the passed object handle...
22394>>>>>>>>>>>>>>>            Move (Uppercase(pubProp.sName)) to sUC_PropName
22395>>>>>>>>>>>>>>>            Move False to bSaveProp
22396>>>>>>>>>>>>>>>            Get piSize to iSize
22397>>>>>>>>>>>>>>>//            Get piSyncObjectIndex of hoObject to iObjectIndex
22397>>>>>>>>>>>>>>>            Get FindObjectIndex hoObject to iObjectIndex
22398>>>>>>>>>>>>>>>            
22398>>>>>>>>>>>>>>>            If (iObjectIndex = -1 or iObjectIndex >= iSize) Begin
22400>>>>>>>>>>>>>>>                Get AddObjectToSyncProps hoObject to iObjectIndex
22401>>>>>>>>>>>>>>>            End
22401>>>>>>>>>>>>>>>>
22401>>>>>>>>>>>>>>>            
22401>>>>>>>>>>>>>>>            // Test iObjectIndex again as it might have changed (above)....
22401>>>>>>>>>>>>>>>            If (iObjectIndex <> -1) Begin
22403>>>>>>>>>>>>>>>                // Send Hook for converting the value to format for transport.
22403>>>>>>>>>>>>>>>                Get ConvertToTransport of hoObject pubProp.hmGetter vPropValue pubProp.eType  to sPropValue
22404>>>>>>>>>>>>>>>                
22404>>>>>>>>>>>>>>>                // Search for the property name....
22404>>>>>>>>>>>>>>>                Move (SizeOfArray(gaSyncProps[iStoreIndex][iObjectIndex].aP)) to icProp
22405>>>>>>>>>>>>>>>                Move False to bFoundSyncProp
22406>>>>>>>>>>>>>>>                
22406>>>>>>>>>>>>>>>                For iProp from 0 to (icProp - 1)
22412>>>>>>>>>>>>>>>>
22412>>>>>>>>>>>>>>>                    If (Uppercase(gaSyncProps[iStoreIndex][iObjectIndex].aP[iProp].sN) = sUC_PropName) Begin
22414>>>>>>>>>>>>>>>                        Move iProp to iSyncPropIndex
22415>>>>>>>>>>>>>>>                        Move True to bFoundSyncProp
22416>>>>>>>>>>>>>>>                    End
22416>>>>>>>>>>>>>>>>
22416>>>>>>>>>>>>>>>                    If (bFoundSyncProp) ;                        Break
22419>>>>>>>>>>>>>>>                Loop
22420>>>>>>>>>>>>>>>>
22420>>>>>>>>>>>>>>>                

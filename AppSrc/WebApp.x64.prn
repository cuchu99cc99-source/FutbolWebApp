30810>>>>>>>                    Error DFERR_CANT_CREATE_FILE (SFormat(C_$WebAppReportCacheCreateError, sPath))
30811>>>>>>>>
30811>>>>>>>                    Function_Return ""
30812>>>>>>>                End
30812>>>>>>>>
30812>>>>>>>            End
30812>>>>>>>>
30812>>>>>>>            Else Begin
30813>>>>>>>                // test if the filename exists as something other than a directory
30813>>>>>>>                If (not(IsFlagIn(FILE_ATTRIBUTE_DIRECTORY, iAttributes))) Begin
30815>>>>>>>                    Error DFERR_CANT_CREATE_FILE (SFormat(C_$WebAppReportCacheCreateError, sPath))
30816>>>>>>>>
30816>>>>>>>                    Function_Return ""
30817>>>>>>>                End
30817>>>>>>>>
30817>>>>>>>            End
30817>>>>>>>>
30817>>>>>>>        End
30817>>>>>>>>
30817>>>>>>>        
30817>>>>>>>        Function_Return sPath

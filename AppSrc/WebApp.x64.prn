25173>>>>>>>>>>>>>>>    Procedure InitializeCustomButtons tSelectionItem[] ByRef aItems Boolean bLast String sFilter
25175>>>>>>>>>>>>>>>        Boolean bPaged bAllowCreate
25175>>>>>>>>>>>>>>>        String sText
25175>>>>>>>>>>>>>>>        Handle hoSelectionSource
25175>>>>>>>>>>>>>>>        tSelectionItem tCustomItem       
25175>>>>>>>>>>>>>>>        tSelectionItem tCustomItem       
25175>>>>>>>>>>>>>>>        
25175>>>>>>>>>>>>>>>        Get phoSelectionSource to hoSelectionSource
25176>>>>>>>>>>>>>>>        If (hoSelectionSource) Begin
25178>>>>>>>>>>>>>>>            Get pbPaged of hoSelectionSource to bPaged
25179>>>>>>>>>>>>>>>        End
25179>>>>>>>>>>>>>>>>
25179>>>>>>>>>>>>>>>        Else Begin
25180>>>>>>>>>>>>>>>            WebGet pbPaged to bPaged
25181>>>>>>>>>>>>>>>        End
25181>>>>>>>>>>>>>>>>
25181>>>>>>>>>>>>>>>        WebGet pbAllowCreate to bAllowCreate
25182>>>>>>>>>>>>>>>
25182>>>>>>>>>>>>>>>        If (bPaged and not(bLast)) Begin
25184>>>>>>>>>>>>>>>            WebGet psShowMoreText to sText
25185>>>>>>>>>>>>>>>            Send AddCustomActionButton (&aItems) C_WebBaseSelectionForm_More_Control sText
25186>>>>>>>>>>>>>>>        End
25186>>>>>>>>>>>>>>>>
25186>>>>>>>>>>>>>>>        
25186>>>>>>>>>>>>>>>        If (bAllowCreate and (SizeOfArray(aItems) = 0) and SizeOfString(sFilter) > 0) Begin
25188>>>>>>>>>>>>>>>            WebGet psCreateNewItemText to sText
25189>>>>>>>>>>>>>>>            Send AddCustomActionButton (&aItems) C_WebBaseSelectionForm_CreateNew_Control sText
25190>>>>>>>>>>>>>>>        End
25190>>>>>>>>>>>>>>>>
25190>>>>>>>>>>>>>>>        
25190>>>>>>>>>>>>>>>        If (HasAdvancedSearchPrompt(Self)) Begin
25192>>>>>>>>>>>>>>>            WebGet psAdvancedSearchText to sText
25193>>>>>>>>>>>>>>>            Send AddCustomActionButton (&aItems) C_WebBaseSelectionForm_AdvancedSearch_Control sText
25194>>>>>>>>>>>>>>>        End
25194>>>>>>>>>>>>>>>>
25194>>>>>>>>>>>>>>>        
25194>>>>>>>>>>>>>>>        Send OnAddCustomActionButtons (&aItems) bLast sFilter
25195>>>>>>>>>>>>>>>    End_Procedure

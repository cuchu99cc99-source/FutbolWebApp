8008>>>>>>>>>        If (Right(sVdfRootDir,1) <>"\") ;            Move (sVdfRootDir +"\") to sVdfRootDir
8011>>>>>>>>>        Set psFilename of hoIniFile to (sVdfRootDir +"bin\Workspaces.ini")
8012>>>>>>>>>        Move (SectionExists(hoIniFile, sWorkspace)) to bRegistered
8013>>>>>>>>>        
8013>>>>>>>>>        Send Destroy of hoIniFile
8014>>>>>>>>>        
8014>>>>>>>>>        Function_Return bRegistered
8015>>>>>>>>>    End_Function

30469>>>>>>>>>>>    //  Generates random data and does a base64 encoding to properly present it as a string.
30469>>>>>>>>>>>    Function GenerateRandomString Integer iLength Returns String
30471>>>>>>>>>>>        String sResult
30471>>>>>>>>>>>        UChar[] ucData
30472>>>>>>>>>>>        Pointer pBase64
30472>>>>>>>>>>>        Integer iVoid
30472>>>>>>>>>>>        
30472>>>>>>>>>>>        Get GenerateRandom iLength to ucData
30473>>>>>>>>>>>        
30473>>>>>>>>>>>        Move (Base64Encode(AddressOf(ucData), iLength)) to pBase64
30474>>>>>>>>>>>        Move (PointerToString(pBase64)) to sResult
30475>>>>>>>>>>>        Move (Free(pBase64)) to iVoid
30476>>>>>>>>>>>        
30476>>>>>>>>>>>        Function_Return (Left(sResult, iLength))
30477>>>>>>>>>>>    End_Function

26279>>>>>>>>>>>
26279>>>>>>>>>>>        If (not(bOrigActive)) Begin
26281>>>>>>>>>>>            Procedure_Return
26282>>>>>>>>>>>        End
26282>>>>>>>>>>>>
26282>>>>>>>>>>>
26282>>>>>>>>>>>        Get phoColumnObjects to ahoColumns
26283>>>>>>>>>>>        WebGet pbSearchHiddenColumns to bSearchHiddenColumns
26284>>>>>>>>>>>

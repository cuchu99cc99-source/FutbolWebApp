25905>>>>>>>>>>>    // Return the best index for this column. If -1, there is no good index
25905>>>>>>>>>>>
25905>>>>>>>>>>>    Function DefaultIndex Returns Integer
25907>>>>>>>>>>>        Integer iFile iField iMainFile iIndex iFieldIndex
25907>>>>>>>>>>>        Integer iRelField eRequestFindMode
25907>>>>>>>>>>>        Handle hoDDO
25907>>>>>>>>>>>  
25907>>>>>>>>>>>        Get Server to hoDDO
25908>>>>>>>>>>>        Get Data_File  to iFile
25909>>>>>>>>>>>        Get Data_Field to iField
25910>>>>>>>>>>>        
25910>>>>>>>>>>>        // If we are attached to a data binding then apply the data dictionary attributes....
25910>>>>>>>>>>>        If ((hoDDO = 0) or (iFile = 0)) Begin
25912>>>>>>>>>>>            Function_Return -1
25913>>>>>>>>>>>        End
25913>>>>>>>>>>>>
25913>>>>>>>>>>>
25913>>>>>>>>>>>        Get Main_File of hoDDO to iMainFile
25914>>>>>>>>>>>        
25914>>>>>>>>>>>        // we don't use the DD FieldIndex message because it respects a DD Ordering override
25914>>>>>>>>>>>        If (iField>0) Begin
25916>>>>>>>>>>>            Get_Attribute DF_FIELD_INDEX of iFile iField to iFieldIndex
25919>>>>>>>>>>>            Move (If(iFieldIndex=0,-1,iFieldIndex)) to iIndex
25920>>>>>>>>>>>        End
25920>>>>>>>>>>>>
25920>>>>>>>>>>>        Else Begin
25921>>>>>>>>>>>            Move 0 to iIndex // recnum index
25922>>>>>>>>>>>        End
25922>>>>>>>>>>>>
25922>>>>>>>>>>>        
25922>>>>>>>>>>>        If (iFile <> iMainFile and iIndex<>-1) Begin
25924>>>>>>>>>>>            // if field is not main-file, we normally don't sort but we allow
25924>>>>>>>>>>>            // one special mode for prompt lists that sorts on the main-file's
25924>>>>>>>>>>>            // index that relates to this parent
25924>>>>>>>>>>>            Delegate Get peRequestFindMode to eRequestFindMode
25926>>>>>>>>>>>            If (eRequestFindMode<>rfmFindMainSuper) Begin
25928>>>>>>>>>>>                Move -1 to iIndex
25929>>>>>>>>>>>            End
25929>>>>>>>>>>>>
25929>>>>>>>>>>>            Else Begin
25930>>>>>>>>>>>                // if non-main file and super find allowed we check for a super-find path
25930>>>>>>>>>>>                If (iIndex>=0) Begin
25932>>>>>>>>>>>                    // it has an index, now make that there is a relational link
25932>>>>>>>>>>>                    // between the main server file and this parent file. If not, no index
25932>>>>>>>>>>>                    Get RelatingField iFile to iRelField
25933>>>>>>>>>>>                    If (iRelField=-1) Begin
25935>>>>>>>>>>>                        Move -1 to iIndex
25936>>>>>>>>>>>                    End
25936>>>>>>>>>>>>
25936>>>>>>>>>>>                    Else Begin
25937>>>>>>>>>>>                        Get_Attribute DF_FIELD_INDEX of iMainFile iRelField to iIndex
25940>>>>>>>>>>>                    End
25940>>>>>>>>>>>>
25940>>>>>>>>>>>                End
25940>>>>>>>>>>>>
25940>>>>>>>>>>>
25940>>>>>>>>>>>            End
25940>>>>>>>>>>>>
25940>>>>>>>>>>>        End
25940>>>>>>>>>>>>
25940>>>>>>>>>>>        Function_Return iIndex    
25941>>>>>>>>>>>    End_Function

1464>>>>>>>Use VersionControl.pkg // version control checking commands and procedure
Including file: VersionControl.pkg    (C:\Program Files\DataFlex 26.0\Pkg\VersionControl.pkg)
1464>>>>>>>>>//This is an internal pakcage and is USEd within vdfbase.pkg
1464>>>>>>>>>//
1464>>>>>>>>>//This contains two compiler commands and one Runtime command:
1464>>>>>>>>>//Validate_Fmac Ver# Rev# Build#
1464>>>>>>>>>//    If version number in fmac is not equal to or greater than the value
1464>>>>>>>>>//    passed here, a compile error is declared. This command is invoked within this
1464>>>>>>>>>//    package. The Version numbers are stored in fmac as :
1464>>>>>>>>>//          FMAC_Version FMAC_Revision FMAC_Build
1464>>>>>>>>>//    The required version numbers are defined in dfbase.pkg as:
1464>>>>>>>>>//          Required_FMAC_Version Required_FMAC_Revision Required_FMAC_Build
1464>>>>>>>>>
1464>>>>>>>>>
1464>>>>>>>>>//Validate_Packages Ver# Rev# Build#
1464>>>>>>>>>//    If version number of package is not equal to or greater than the value
1464>>>>>>>>>//    passed here, a compile error is declared. The package number is defined in
1464>>>>>>>>>//    dfbase.pkg as:
1464>>>>>>>>>//          PKG_Version PKG_Revision PKG_Build
1464>>>>>>>>>//    This is not invoked automatically but may be added to a developer's
1464>>>>>>>>>//    program. You must define and pass the minimum required version numbers.
1464>>>>>>>>>
1464>>>>>>>>>//Send ValidateVersion
1464>>>>>>>>>//   This is called at runtime (and is called by this package). It insures that the
1464>>>>>>>>>//   runtime version (which is stored in dfrun.dll) is equal to or greater than the
1464>>>>>>>>>//   minimum required runtime version. The minimum is defined in dfbase.pkg as:
1464>>>>>>>>>//        Required_RT_Version Required_RT_Revision Required_RT_Build
1464>>>>>>>>>Use LanguageText.pkg
1464>>>>>>>>>Use GlobalFunctionsProcedures.pkg
1464>>>>>>>>>
1464>>>>>>>>>// Validate fmac version against a passed minumum
1464>>>>>>>>>
1464>>>>>>>>>// Validate fmac version against a passed minumum
1464>>>>>>>>>
1464>>>>>>>>>Procedure gValidate$Version Global Integer iReqVersion Integer iReqRevision Integer iReqBuild
1466>>>>>>>>>    Integer iVersion iRevision iBuild
1466>>>>>>>>>    Version_Information iVersion iRevision iBuild
1468>>>>>>>>>    //
1468>>>>>>>>>    If (iVersion < iReqVersion or ;        (iVersion=iReqVersion and iRevision<iReqRevision) or ;        (iVersion=iReqVersion and iRevision=iReqRevision and iBuild<iReqBuild) ) Begin
1470>>>>>>>>>        
1470>>>>>>>>>        Error DFERR_WRONG_REVISION (SFormat(C_$RuntimePackageMismatch, iVersion, iRevision, iBuild, iReqVersion, iReqRevision, iReqBuild))
1471>>>>>>>>>>
1471>>>>>>>>>        
1471>>>>>>>>>        Abort
1472>>>>>>>>>>
1472>>>>>>>>>    End
1472>>>>>>>>>>
1472>>>>>>>>>End_Procedure
1473>>>>>>>>>
1473>>>>>>>>>// This will gen compiler error if fmac is too old
1473>>>>>>>>>Validate_Fmac Required_FMAC_Version Required_FMAC_Revision Required_FMAC_Build
1473>>>>>>>>>// This generates a runtime error packages are old
1473>>>>>>>>>Send gValidate$Version Required_RT_Version Required_RT_Revision Required_RT_Build

8939>>>>>>>>>//   Setup a constraint for a file.                                    
8939>>>>>>>>>
8939>>>>>>>>>
8939>>>>>>>>>
8939>>>>>>>>>// Set or get an attribute at driver level. These attributes, when set,
8939>>>>>>>>>// will be set for the remainder of the session or until set again. To 
8939>>>>>>>>>// permanently set driver level attributes change the driver           
8939>>>>>>>>>// configuration file.                                                 
8939>>>>>>>>>
8939>>>>>>>>>
8939>>>>>>>>>
8939>>>>>>>>>
8939>>>>>>>>>
8939>>>>>>>>>
8939>>>>>>>>>
8939>>>>>>>>>// An instance of this class can be used as a broker object to
8939>>>>>>>>>// call several CLI releated methods.                         
8939>>>>>>>>>
8939>>>>>>>>>//Class cCLIHandler is a cObject
8939>>>>>>>>>Class cCLIHandler is an Array
8940>>>>>>>>>    
8940>>>>>>>>>    Procedure Construct_Object 
8942>>>>>>>>>        Forward Send Construct_object 
8944>>>>>>>>>        
8944>>>>>>>>>        Property String  psDriverID        ""
8945>>>>>>>>>    End_Procedure
8946>>>>>>>>>    
8946>>>>>>>>>    
8946>>>>>>>>>    
8946>>>>>>>>>    // The revsion of a CLI Connectivity Kit
8946>>>>>>>>>    Function CKRevision Returns String
8948>>>>>>>>>        String  sDriverID
8948>>>>>>>>>        String  sRevision
8948>>>>>>>>>        String  sVoid
8948>>>>>>>>>        Integer iRetval
8948>>>>>>>>>        
8948>>>>>>>>>        Get psDriverID to sDriverID
8949>>>>>>>>>        If (sDRiverID <> "") Begin
8951>>>>>>>>>            Move (Repeat(" ", 255)) to sRevision
8952>>>>>>>>>            Call_Driver 0 sDRiverID Function CLI_CKREVISION Callback 0 Passing sRevision sVoid 0 Result iRetval
8957>>>>>>>>>        End
8957>>>>>>>>>>
8957>>>>>>>>>        
8957>>>>>>>>>        Function_Return sRevision
8958>>>>>>>>>    End_Function
8959>>>>>>>>>    
8959>>>>>>>>>    
8959>>>>>>>>>    
8959>>>>>>>>>    // Extarct the Nth part of a a.b.c.d revsion string.
8959>>>>>>>>>    // Returns : The part version number or -1 if there is no such part number.
8959>>>>>>>>>    //
8959>>>>>>>>>    Function ExtractPartFromRevision Integer iPartNum String sRevision Returns Integer
8961>>>>>>>>>        Integer iPartRev
8961>>>>>>>>>        Integer iCurrentPart
8961>>>>>>>>>        Integer iSeparatorPos
8961>>>>>>>>>        
8961>>>>>>>>>        If (iPartNum > 4) ;            Function_Return -1
8964>>>>>>>>>        
8964>>>>>>>>>        Move 0 to iCurrentPart
8965>>>>>>>>>        Repeat
8965>>>>>>>>>>
8965>>>>>>>>>            Move (Pos(".", sRevision)) to iSeparatorPos
8966>>>>>>>>>            If (iSeparatorPos > 0) Begin
8968>>>>>>>>>                Move (Left(sRevision, iSeparatorPos - 1)) to iPartRev
8969>>>>>>>>>                Move (Right(sRevision, Length(sRevision) - iSeparatorPos)) to sRevision
8970>>>>>>>>>                Increment iCurrentPart
8971>>>>>>>>>            End
8971>>>>>>>>>>
8971>>>>>>>>>            Else If (sRevision <> "") Begin
8974>>>>>>>>>                Move sRevision to iPartRev
8975>>>>>>>>>                Move "" to sRevision
8976>>>>>>>>>                Increment iCurrentPart
8977>>>>>>>>>            End
8977>>>>>>>>>>
8977>>>>>>>>>            Else ;                Move -1 to iPartRev
8979>>>>>>>>>        Until (iCurrentPart >= iPartNum or iPartRev = -1)
8981>>>>>>>>>        
8981>>>>>>>>>        Function_Return iPartRev
8982>>>>>>>>>    End_Function
8983>>>>>>>>>    
8983>>>>>>>>>    
8983>>>>>>>>>    
8983>>>>>>>>>    // Returns the major revision of the CK
8983>>>>>>>>>    //
8983>>>>>>>>>    Function CKMajorRevision Returns Integer
8985>>>>>>>>>        Function_Return (ExtractPartFromRevision (Self, 1, CKRevision(Self)))
8986>>>>>>>>>    End_Function
8987>>>>>>>>>    
8987>>>>>>>>>    
8987>>>>>>>>>    
8987>>>>>>>>>    // Returns the minor revision of the CK
8987>>>>>>>>>    //
8987>>>>>>>>>    Function CKMinorRevision Returns Integer
8989>>>>>>>>>        Function_Return (ExtractPartFromRevision (Self, 2, CKRevision(Self)))
8990>>>>>>>>>    End_Function
8991>>>>>>>>>    
8991>>>>>>>>>    
8991>>>>>>>>>    
8991>>>>>>>>>    // Returns the release revision of the CK
8991>>>>>>>>>    //
8991>>>>>>>>>    Function CKReleaseRevision Returns Integer
8993>>>>>>>>>        Function_Return (ExtractPartFromRevision (Self, 3, CKRevision(Self)))
8994>>>>>>>>>    End_Function
8995>>>>>>>>>    
8995>>>>>>>>>    
8995>>>>>>>>>    
8995>>>>>>>>>    // Returns the major revision of the CK
8995>>>>>>>>>    //
8995>>>>>>>>>    Function CKBuildRevision Returns Integer
8997>>>>>>>>>        Function_Return (ExtractPartFromRevision (Self, 4, CKRevision(Self)))
8998>>>>>>>>>    End_Function
8999>>>>>>>>>    
8999>>>>>>>>>    
8999>>>>>>>>>    
8999>>>>>>>>>    // Determines if the CK conforms to a passed minimal revsion.
8999>>>>>>>>>    //
8999>>>>>>>>>    Function IsMinimalRevision Integer iMajor Integer iMinor Integer iRelease Integer iBuild Returns Integer
9001>>>>>>>>>        If (iMajor < CKMajorRevision(Self)) ;            Function_Return (True)
9004>>>>>>>>>        Else If (iMajor = CKMajorRevision(Self)) Begin
9007>>>>>>>>>            If (iMinor < CKMinorRevision(Self)) ;                Function_Return (True)
9010>>>>>>>>>            Else If (iMinor = CKMinorRevision(Self)) Begin
9013>>>>>>>>>                If (iRelease < CKReleaseRevision(Self)) ;                    Function_Return (True)
9016>>>>>>>>>                Else If (iRelease = CKReleaseRevision(Self) and iBuild <= CKBuildRevision(Self)) ;                    Function_Return (True)
9020>>>>>>>>>            End
9020>>>>>>>>>>
9020>>>>>>>>>        End
9020>>>>>>>>>>
9020>>>>>>>>>        
9020>>>>>>>>>        Function_Return (False)
9021>>>>>>>>>    End_Function
9022>>>>>>>>>    
9022>>>>>>>>>    
9022>>>>>>>>>    
9022>>>>>>>>>    // Returns the Connectiivty Kit registration name.
9022>>>>>>>>>    //
9022>>>>>>>>>    Function RegistrationName Returns String
9024>>>>>>>>>        String  sRegistration
9024>>>>>>>>>        String  sDRiverId
9024>>>>>>>>>        String  sVoid
9024>>>>>>>>>        Integer iRetval
9024>>>>>>>>>        
9024>>>>>>>>>        Get psDriverID to sDriverID
9025>>>>>>>>>        If (sDRiverID <> "") Begin
9027>>>>>>>>>            Move (Repeat(" ", 255)) to sRegistration
9028>>>>>>>>>            Call_Driver 0 sDRiverID Function CLI_GETREGNAME Callback 0 Passing sRegistration sVoid 0 Result iRetval
9033>>>>>>>>>        End
9033>>>>>>>>>>
9033>>>>>>>>>        
9033>>>>>>>>>        Function_Return sRegistration
9034>>>>>>>>>    End_Function
9035>>>>>>>>>    

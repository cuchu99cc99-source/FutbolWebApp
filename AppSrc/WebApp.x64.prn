26532>>>>>>>>>    // find in DD using eFindMode adjusting for reverse ordering. Use the current index 
26532>>>>>>>>>    Function FindInDD Handle hoDD Integer eMode Returns Boolean
26534>>>>>>>>>        Integer iOrdering
26534>>>>>>>>>        Boolean bReverseOrdering
26534>>>>>>>>>
26534>>>>>>>>>        If (pbNotifyingExternalDD(Self)) Begin
26536>>>>>>>>>            Error DFERR_PROGRAM "Assert: RefreshListFromDD called with pbNotifyingExternalDD set"
26537>>>>>>>>>>
26537>>>>>>>>>        End
26537>>>>>>>>>>
26537>>>>>>>>>
26537>>>>>>>>>        Get IndexOrder to iOrdering
26538>>>>>>>>>        WebGet pbReverseOrdering to bReverseOrdering
26539>>>>>>>>>        Get FindMode eMode bReverseOrdering to eMode
26540>>>>>>>>>        Send Find of hoDD eMode iOrdering    
26541>>>>>>>>>        Function_Return (Found)
26542>>>>>>>>>    End_Function
26543>>>>>>>>>    
26543>>>>>>>>>    // used by public FindFromTop and FindFromBottom
26543>>>>>>>>>    Procedure FindFromTB Boolean bFirst
26545>>>>>>>>>        Handle hoDD
26545>>>>>>>>>        Boolean bDataAware bFound
26545>>>>>>>>>        Get pbDataAware to bDataAware
26546>>>>>>>>>        If bDataAware Begin
26548>>>>>>>>>            Get Server to hoDD
26549>>>>>>>>>            Get FindInDD hoDD (If(bFirst,FIRST_RECORD, LAST_RECORD)) to bFound
26550>>>>>>>>>            If bFound Begin
26552>>>>>>>>>                Send UpdateCurrentRowID
26553>>>>>>>>>            End
26553>>>>>>>>>>
26553>>>>>>>>>            Else Begin
26554>>>>>>>>>                // If not found then the DD didn't change so we must clear the grid.
26554>>>>>>>>>                Send ClearGrid
26555>>>>>>>>>            End
26555>>>>>>>>>>
26555>>>>>>>>>        End
26555>>>>>>>>>>
26555>>>>>>>>>    End_Procedure
26556>>>>>>>>>    
26556>>>>>>>>>    // Server action
26556>>>>>>>>>    //
26556>>>>>>>>>    // Sent when the client navigates the focus from one row to another.
26556>>>>>>>>>    // sGoToRow - Indicates how to treat the second parameter:
26556>>>>>>>>>    //            "row"   - indicates that we are going to a specific row as specified in sToRowID
26556>>>>>>>>>    //            "first" - indicates that we are going to the first row in the data set. Ignore sToRowID.
26556>>>>>>>>>    //            "last"  - indicates that we are going to the last row in the data set. Ignore sToRowID.
26556>>>>>>>>>    //            "new"   - indicates that we are creating a new row. Ignore sToRowID.
26556>>>>>>>>>    // Returns  - True if the navigation is allowed, otherwise returns False.
26556>>>>>>>>>    Function ChangeCurrentRow String sGotoRow String sToRowID Returns Boolean 
26558>>>>>>>>>        Handle hoDD
26558>>>>>>>>>        Integer iMainFile
26558>>>>>>>>>        RowID riRowID
26558>>>>>>>>>        Boolean bReturn bOldGridAction bDataAware bSuccess
26558>>>>>>>>>        String sPreviousRowId
26558>>>>>>>>>        String[] aParams
26559>>>>>>>>>        
26559>>>>>>>>>        Get pbDataAware to bDataAware
26560>>>>>>>>>        WebGet psCurrentRowId to sPreviousRowId
26561>>>>>>>>>        
26561>>>>>>>>>        // Give grid a chance to do its row change logic via AllowChangeSelectedRow
26561>>>>>>>>>        Get AllowChangeSelectedRow sGotoRow sToRowID to bReturn
26562>>>>>>>>>
26562>>>>>>>>>        // load the new row
26562>>>>>>>>>        If (bReturn) Begin   
26564>>>>>>>>>            If (bDataAware) Begin
26566>>>>>>>>>                // data-aware
26566>>>>>>>>>                Get Server to hoDD
26567>>>>>>>>>                
26567>>>>>>>>>                Get pbNotifyingExternalDD to bOldGridAction
26568>>>>>>>>>                If (hoDD) Begin
26570>>>>>>>>>                    Move (Lowercase(sGotoRow)) to sGotoRow
26571>>>>>>>>>                    
26571>>>>>>>>>                    Case Begin
26571>>>>>>>>>                        Case (sGotoRow = "row")
26573>>>>>>>>>                            Set pbNotifyingExternalDD to True // indicate that we are simply in a client row change event.
26574>>>>>>>>>                            // Load the ToRowID's record into the DDO structure. This triggers a refresh to all
26574>>>>>>>>>                            // connected DDO's including cWebColumn objects
26574>>>>>>>>>                            Get Main_File of hoDD to iMainFile
26575>>>>>>>>>                            Move (DeserializeRowID(sToRowID)) to riRowID
26576>>>>>>>>>                            // load the "to" row into the DDO. Should indirectly set psCurrentRowId
26576>>>>>>>>>                            Get FindByRowIdEx of hoDD iMainFile riRowID to bSuccess
26577>>>>>>>>>                            // Handle errors
26577>>>>>>>>>                            If (not(bSuccess)) Begin
26579>>>>>>>>>                                Set pbNotifyingExternalDD to False
26580>>>>>>>>>                                Send HandleCacheError
26581>>>>>>>>>                            End
26581>>>>>>>>>>
26581>>>>>>>>>                            Case Break
26582>>>>>>>>>        
26582>>>>>>>>>                        Case (sGotoRow = "first")
26585>>>>>>>>>                        Case (sGotoRow = "last")
26588>>>>>>>>>                            // With first and last, we do a dd Find, which should refresh the entire grid
26588>>>>>>>>>                            Set pbNotifyingExternalDD to False
26589>>>>>>>>>                            // With first and last, we do a dd Find, which should refresh the entire grid
26589>>>>>>>>>                            If (sGotoRow = "first") Begin
26591>>>>>>>>>                                Get FindInDD hoDD FIRST_RECORD to bSuccess
26592>>>>>>>>>                            End
26592>>>>>>>>>>
26592>>>>>>>>>                            Else Begin
26593>>>>>>>>>                                Get FindInDD hoDD LAST_RECORD to bSuccess
26594>>>>>>>>>                            End
26594>>>>>>>>>>
26594>>>>>>>>>
26594>>>>>>>>>                            //  If not found then the DD didn't cause a refresh so we do it manually here
26594>>>>>>>>>                            If (not(bSuccess)) Begin
26596>>>>>>>>>                                Send ClearGrid
26597>>>>>>>>>                            End
26597>>>>>>>>>>
26597>>>>>>>>>                            
26597>>>>>>>>>                            
26597>>>>>>>>>                            Case Break
26598>>>>>>>>>        
26598>>>>>>>>>                    Case End               
26598>>>>>>>>>                    Set pbNotifyingExternalDD to bOldGridAction
26599>>>>>>>>>                                    
26599>>>>>>>>>                End
26599>>>>>>>>>>
26599>>>>>>>>>                Else Begin
26600>>>>>>>>>                    Error DFERR_PROGRAM C_$WebGridDoesNotHaveDDOServer
26601>>>>>>>>>>
26601>>>>>>>>>                End
26601>>>>>>>>>>
26601>>>>>>>>>            End
26601>>>>>>>>>>
26601>>>>>>>>>            Else Begin
26602>>>>>>>>>                // non-data-aware: We simply load the row sent by the client into the DEOs (columns)
26602>>>>>>>>>                If (sGotoRow = "row") Begin
26604>>>>>>>>>                    Send FillFromActionData 
26605>>>>>>>>>                End
26605>>>>>>>>>>
26605>>>>>>>>>            End
26605>>>>>>>>>>
26605>>>>>>>>>            
26605>>>>>>>>>            //  Fire user event
26605>>>>>>>>>            Send OnChangeCurrentRow sPreviousRowId sToRowID
26606>>>>>>>>>        End
26606>>>>>>>>>>
26606>>>>>>>>>        
26606>>>>>>>>>        //  Send client action that processes the row change (this is done to preserve the order combined with list refreshes)
26606>>>>>>>>>        Move bReturn to aParams[0]
26607>>>>>>>>>        Send ClientAction "handleRowChange" aParams
26608>>>>>>>>>        
26608>>>>>>>>>        Function_Return bReturn
26609>>>>>>>>>    End_Function
26610>>>>>>>>>    
26610>>>>>>>>>    
26610>>>>>>>>>    //  Called by the client when the sorting is changed. The piSortColumn and pbReverseSorting are
26610>>>>>>>>>    //  already updated when it is called.
26610>>>>>>>>>    Procedure ChangeSorting Integer iCol Boolean bReverse Integer iPrevCol Boolean bPrevReverse
26612>>>>>>>>>        Send GridRefresh
26613>>>>>>>>>    End_Procedure
26614>>>>>>>>>    
26614>>>>>>>>>    
26614>>>>>>>>>    // Returns the number of columns 
26614>>>>>>>>>    Function ColumnCount Returns Integer
26616>>>>>>>>>        Handle[] hoColumnObjects
26617>>>>>>>>>        Get phoColumnObjects to hoColumnObjects
26618>>>>>>>>>        Function_Return (SizeOfArray(hoColumnObjects))
26619>>>>>>>>>    End_Function
26620>>>>>>>>>
26620>>>>>>>>>

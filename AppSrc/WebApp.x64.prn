28015>>>>>>>
28015>>>>>>>
28015>>>>>>>    // We provide this because NavigateData is an important web property and these
28015>>>>>>>    // two messages can be accessed via delegation (which WebGet|WebSet pNavigateData cannot).
28015>>>>>>>    Function GetNavigateData Returns tWebNavigateData
28017>>>>>>>        tWebNavigateData NavigateData
28017>>>>>>>        tWebNavigateData NavigateData
28017>>>>>>>        WebGet pNavigateData to NavigateData
28018>>>>>>>        Function_Return NavigateData
28019>>>>>>>    End_Function
28020>>>>>>>
28020>>>>>>>    Procedure SetNavigateData tWebNavigateData NavigateData
28022>>>>>>>        WebSet pNavigateData to NavigateData
28023>>>>>>>    End_Procedure    
28024>>>>>>>
28024>>>>>>>    // helper for ClearConstrainFiles
28024>>>>>>>    Procedure ClearConstrainFile2 Handle hoDD
28026>>>>>>>        Handle hoDDNext
28026>>>>>>>        Integer iCount iMax
28026>>>>>>>        Set Visited_State of hoDD to True
28027>>>>>>>        // First process all server DDs
28027>>>>>>>        Get Data_Set_Server_Count of hoDD to iMax
28028>>>>>>>        For iCount from 0 to (iMax-1)
28034>>>>>>>>
28034>>>>>>>            Get Data_Set_Server of hoDD iCount to hoDDNext
28035>>>>>>>            If not (Visited_state(hoDDNext)) Begin
28037>>>>>>>                Send ClearConstrainFile2 hoDDNext
28038>>>>>>>            End
28038>>>>>>>>
28038>>>>>>>        Loop
28039>>>>>>>>
28039>>>>>>>        Set Constrain_File of hoDD to 0
28040>>>>>>>    End_Procedure
28041>>>>>>>
28041>>>>>>>    // clear all constrain files from the passed main DD on up.
28041>>>>>>>    Procedure ClearConstrainFiles Handle hoMainDD
28043>>>>>>>        If hoMainDD Begin
28045>>>>>>>            Send Initialize_Visited to hoMainDD False False // False=don't clear Column marks
28046>>>>>>>            Send ClearConstrainFile2 hoMainDD
28047>>>>>>>        End
28047>>>>>>>>
28047>>>>>>>    End_Procedure
28048>>>>>>>
28048>>>>>>>    // Returns the invokingobject when used in a drilldown
28048>>>>>>>    // NavigateFoward context. This should be an object within an invoking
28048>>>>>>>    // view or the invoking view. Often this would be the focus object when
28048>>>>>>>    // a prompt action is called.
28048>>>>>>>    Function GetInvokingObject Returns Handle 
28050>>>>>>>        Handle hoInvoker
28050>>>>>>>        String sInvoker
28050>>>>>>>        
28050>>>>>>>        Move C_WebUnresolvedObject to hoInvoker
28051>>>>>>>        
28051>>>>>>>        WebGet psInvokingObject to sInvoker
28052>>>>>>>        If (sInvoker <> "[NULL]") Begin
28054>>>>>>>            Get WebObjectByName sInvoker to hoInvoker
28055>>>>>>>        End
28055>>>>>>>>
28055>>>>>>>        
28055>>>>>>>        Function_Return hoInvoker        
28056>>>>>>>    End_Function
28057>>>>>>>
28057>>>>>>>    // Sets the invoking object for this view to hoInvokingObject.
28057>>>>>>>    Procedure SetInvokingObject Handle hoInvokingObject
28059>>>>>>>        Handle hoView
28059>>>>>>>        String sInvoker
28059>>>>>>>        
28059>>>>>>>        If (hoInvokingObject <> C_WebUnresolvedObject) Begin
28061>>>>>>>            Get WebObjectName of hoInvokingObject to sInvoker
28062>>>>>>>        End
28062>>>>>>>>
28062>>>>>>>        Else Begin
28063>>>>>>>            Move "[NULL]" to sInvoker
28064>>>>>>>        End
28064>>>>>>>>
28064>>>>>>>        
28064>>>>>>>        WebSet psInvokingObject to sInvoker
28065>>>>>>>    End_Procedure
28066>>>>>>>    
28066>>>>>>>    // Unconditionally navigate back to this view.
28066>>>>>>>    // We assume any data-loss checking has been done (if not, it's too late)
28066>>>>>>>    // If bCancel is true this is a Cancel operation (NavigateCancel), else a Close operation (NavigateClose)
28066>>>>>>>    // If a Close a callback, can and should be passed to update the NavigateData data before processing the close.
28066>>>>>>>    // This can be called when this view is not synched, in which case you should not trust the
28066>>>>>>>    // data or the web properties.
28066>>>>>>>    Procedure NavigateBackToHere Boolean bCancel Handle hoCallback
28068>>>>>>>        Handle hoTopView hoInvokingView
28068>>>>>>>        tWebValueTree tVT
28068>>>>>>>        tWebValueTree tVT
28068>>>>>>>        tWebNavigateData NavigateData
28068>>>>>>>        tWebNavigateData NavigateData
28068>>>>>>>        String[] aParams
28069>>>>>>>        
28069>>>>>>>        Get TopViewHandle of (ViewStack(Self)) to hoTopView   // handle to the current top of view
28070>>>>>>>        Get InvokingViewHandle of (ViewStack(Self)) to hoInvokingView // 2nd to top
28071>>>>>>>        
28071>>>>>>>        
28071>>>>>>>        If (not(bCancel) and hoCallback <> 0) Begin
28073>>>>>>>            // Get NavigateData from the view that is being closed
28073>>>>>>>            // start with the NavigateData from the view being closed
28073>>>>>>>            Get GetNavigateData of hoTopView to NavigateData
28074>>>>>>>            // if we are not going back to the invoking view this means you are jumping back several 
28074>>>>>>>            // breadcrumb items. The navigate type is always undefined and it is up to the developer to
28074>>>>>>>            // decide what to do with the returned data in OnNavigateBack
28074>>>>>>>            If (Self <> hoInvokingView) Begin
28076>>>>>>>                Move nfUndefined to NavigateData.eNavigateType
28077>>>>>>>            End
28077>>>>>>>>
28077>>>>>>>            Send GetNavigateBackData to hoCallback Self (&NavigateData)
28078>>>>>>>        End
28078>>>>>>>>
28078>>>>>>>        
28078>>>>>>>        // if we are the invoking object, both the top object and invoking are synched and we can proceed directly
28078>>>>>>>        // or if we are performing a cancel the extra round trip would have no real meaning
28078>>>>>>>        If (bCancel or Self = hoInvokingView) Begin
28080>>>>>>>            Send NavigateBackToHereExec (&NavigateData) bCancel hoCallback
28081>>>>>>>        End
28081>>>>>>>>
28081>>>>>>>        Else Begin
28082>>>>>>>            //  Navigating back multiple levels means that we need another round trip as the view we are navigating towards is nto synchronized
28082>>>>>>>                        
28082>>>>>>>            Move bCancel to aParams[0]
28083>>>>>>>            
28083>>>>>>>            //  Because "" indicates the WebApp object we have an extra boolean indicating if there actually is a callback object
28083>>>>>>>            If (hoCallback > 0) Begin
28085>>>>>>>                Move True to aParams[1]
28086>>>>>>>                Get WebObjectName of hoCallback to aParams[2]
28087>>>>>>>            End
28087>>>>>>>>
28087>>>>>>>            Else Begin
28088>>>>>>>                Move False to aParams[1]
28089>>>>>>>                Move "" to aParams[2]
28090>>>>>>>            End
28090>>>>>>>>
28090>>>>>>>            
28090>>>>>>>            ValueTreeSerializeParameter NavigateData to tVT
28091>>>>>>>            
28091>>>>>>>            //  Perform client action that will call NavigateBackToHere_Callback
28091>>>>>>>            Send ClientAction "navigateBackToHere" aParams tVT
28092>>>>>>>        End
28092>>>>>>>>
28092>>>>>>>        
28092>>>>>>>    End_Procedure
28093>>>>>>>
28093>>>>>>>    //  Actually performs the navigateBackToHere operation, either called directly or asynchronously
28093>>>>>>>    //  by NavigateBackToHere_Callback.
28093>>>>>>>    Procedure NavigateBackToHereExec tWebNavigateData ByRef NavigateData Boolean bCancel Handle hoCallback
28095>>>>>>>        Handle hoTopView 
28095>>>>>>>        Handle hoDD hoMainDD hoTarget hoInvokingObject hoInvokingObjectDD hoInvokingView hoNextView
28095>>>>>>>        String psInvoker sTitle sStateHash
28095>>>>>>>        Integer eViewType eTopViewStyle eViewStyle
28095>>>>>>>        RowID ri
28095>>>>>>>        Boolean bParentLookup bOverrideViewState
28095>>>>>>>        Integer iConstrainingFile eRefindError
28095>>>>>>>        Handle hoConstrainingParent hoRefindError
28095>>>>>>>        RowID riConstrainingParent
28095>>>>>>>        Boolean bSuccess
28095>>>>>>>        
28095>>>>>>>        //  Indicate that we are navigating
28095>>>>>>>        Set pbNavigating to True
28096>>>>>>>        
28096>>>>>>>        Get TopViewHandle of (ViewStack(Self)) to hoTopView   // handle to the current top of view
28097>>>>>>>        Get InvokingViewHandle of (ViewStack(Self)) to hoInvokingView // 2nd to top
28098>>>>>>>        
28098>>>>>>>        If (hoTopView = Self) Begin
28100>>>>>>>            Error DFERR_PROGRAM "NavigateBackToHere is already the top of the stack"
28101>>>>>>>>
28101>>>>>>>        End
28101>>>>>>>>
28101>>>>>>>        
28101>>>>>>>        Get NextViewHandleByView of (ViewStack(Self)) Self to hoNextView
28102>>>>>>>        Get GetInvokingObject of hoNextView to hoInvokingObject 
28103>>>>>>>        
28103>>>>>>>        Get peWebViewStyle to eViewStyle
28104>>>>>>>        Get peWebViewStyle of hoTopView to eTopViewStyle       
28105>>>>>>>        
28105>>>>>>>        // send ShowView directly (this shows the view without clearing the 
28105>>>>>>>        // entire viewstack)
28105>>>>>>>        Get pbOverrideStateOnShow to bOverrideViewState
28106>>>>>>>        Set pbOverrideStateOnShow to False
28107>>>>>>>        // if we navigate from a regular drill down view to a dialog we need to perform some more logic
28107>>>>>>>        If (eTopViewStyle = wvsDrillDown and eViewStyle = wvsDialog) Begin
28109>>>>>>>            Send RestoreDialog
28110>>>>>>>        End
28110>>>>>>>>
28110>>>>>>>        Else Begin
28111>>>>>>>            Send ShowView to (Host(Self)) Self 
28112>>>>>>>        End
28112>>>>>>>>
28112>>>>>>>        
28112>>>>>>>        Set pbOverrideStateOnShow to bOverrideViewState
28113>>>>>>>        // pop all unwanted views off the stack...
28113>>>>>>>        Send PopDownToView of (ViewStack(Self)) Self
28114>>>>>>>        Send UpdateInvokingViewDrillDownStyle
28115>>>>>>>
28115>>>>>>>        
28115>>>>>>>        // In this case we need to consider what to do with the data that
28115>>>>>>>        // is passed back from the previous top view.
28115>>>>>>>        Get peViewType to eViewType
28116>>>>>>>        Get Main_DD to hoMainDD  
28117>>>>>>>        
28117>>>>>>>        If hoMainDD Begin
28119>>>>>>>            Send Refind_Records of hoMainDD
28120>>>>>>>        End
28120>>>>>>>>
28120>>>>>>>
28120>>>>>>>        // if a close / update 
28120>>>>>>>        If (not(bCancel) and hoCallback <> 0) Begin
28122>>>>>>>
28122>>>>>>>            // if navigate from was relational (child, parent or main) we can do refinding
28122>>>>>>>            If (NavigateData.eNavigateType = nfFromChild or NavigateData.eNavigateType = nfFromMain or NavigateData.eNavigateType = nfFromParent) Begin
28124>>>>>>>                Get FindDDOForTable NavigateData.iTable to hoDD
28125>>>>>>>                If hoDD Begin
28127>>>>>>>                    Move (DeserializeRowID(NavigateData.sRowID)) to ri
28128>>>>>>>                    
28128>>>>>>>                    If (eViewType = vtZoom) Begin
28130>>>>>>>                        // This will force constrained parents to update if appropriate
28130>>>>>>>                        
28130>>>>>>>                        // Use the DD of the invoking object as our starting point 
28130>>>>>>>                        If hoInvokingObject Begin
28132>>>>>>>                            Get Server of hoInvokingObject to hoInvokingObjectDD
28133>>>>>>>                        End
28133>>>>>>>>
28133>>>>>>>                        // if no server (unlikely) use the view's main dd 
28133>>>>>>>                        If not (hoInvokingObjectDD) Begin
28135>>>>>>>                            Get Main_DD to hoInvokingObjectDD        
28136>>>>>>>                        End
28136>>>>>>>>
28136>>>>>>>                        If (hoInvokingObjectDD) Begin
28138>>>>>>>                            // assume a parent DD is a parent lookup. If so, we don't update
28138>>>>>>>                            // the rest of the view. If not a lookup, do a clear_all so the
28138>>>>>>>                            // findbyrowid updates all deos 
28138>>>>>>>                            // which_data_Set only searches up.
28138>>>>>>>                            Get Which_Data_Set of hoInvokingObjectDD NavigateData.iTable to hoTarget
28139>>>>>>>                            Move (hoTarget and hoTarget<>hoInvokingObjectDD) to bParentLookup
28140>>>>>>>                            If not bParentLookup Begin
28142>>>>>>>                                // if constrained we will need to constraining parent
28142>>>>>>>                                // DD and row in case this is a null child RowId
28142>>>>>>>                                Get Constrain_File of hoDD to iConstrainingFile
28143>>>>>>>                                If (iConstrainingFile) Begin
28145>>>>>>>                                    Get Which_Data_Set of hoDD iConstrainingFile to hoConstrainingParent
28146>>>>>>>                                    If hoConstrainingParent Begin
28148>>>>>>>                                        Get CurrentRowId of hoConstrainingParent to riConstrainingParent
28149>>>>>>>                                    End
28149>>>>>>>>
28149>>>>>>>                                End
28149>>>>>>>>
28149>>>>>>>                                Send Clear_All of hoDD
28150>>>>>>>                                If (IsNullRowID(ri) and hoConstrainingParent) Begin
28152>>>>>>>                                    Get FindByRowIdEx of hoConstrainingParent iConstrainingFile riConstrainingParent to bSuccess
28153>>>>>>>                                    If not bSuccess Begin
28155>>>>>>>                                        // this is quite unlikely
28155>>>>>>>                                        // This is kind of complex because it means that the constraining parent cannot be
28155>>>>>>>                                        // reloaded. In such a case you probably should not be in the view at all and
28155>>>>>>>                                        // should navigate back
28155>>>>>>>                                        Move hoDD to hoRefindError
28156>>>>>>>                                        Move retCannotRereadConstrainingParent to eRefindError
28157>>>>>>>                                    End
28157>>>>>>>>
28157>>>>>>>                                End
28157>>>>>>>>
28157>>>>>>>                            End
28157>>>>>>>>
28157>>>>>>>                        End
28157>>>>>>>>
28157>>>>>>>                        If (hoRefindError=0) Begin
28159>>>>>>>                            If (IsNullRowID(ri)) Begin
28161>>>>>>>                                // Assume Create New Record
28161>>>>>>>                                Send Clear to hoDD
28162>>>>>>>                            End
28162>>>>>>>>
28162>>>>>>>                            Else Begin
28163>>>>>>>                                // Load up the selected rowID
28163>>>>>>>                                Get FindByRowIdEx of hoDD NavigateData.iTable ri to bSuccess
28164>>>>>>>                                If not bSuccess Begin
28166>>>>>>>                                    // this is quite unlikely
28166>>>>>>>                                    Send Clear of hoDD // this will leave the zoom cleared
28167>>>>>>>                                    Move hoDD to hoRefindError
28168>>>>>>>                                    Move retCannotRereadMain to eRefindError
28169>>>>>>>                                End
28169>>>>>>>>
28169>>>>>>>                            End
28169>>>>>>>>
28169>>>>>>>                        End
28169>>>>>>>>
28169>>>>>>>                    End
28169>>>>>>>>
28169>>>>>>>                    // else... if vtSelect the test below will catch this for any non cancel
28169>>>>>>>                    //         vtSelect. That way we catch hoDD=0 cases and nfundefined.
28169>>>>>>>                End
28169>>>>>>>>
28169>>>>>>>            End
28169>>>>>>>>
28169>>>>>>>
28169>>>>>>>            // This handles all select and weblist closes.        
28169>>>>>>>            // We do this for all view types because a zoom might contain a list
28169>>>>>>>            // If there is a missing hoDD or ri is null it will do a refresh of whatever
28169>>>>>>>            // is in the DD. If there is a rowid, it will refind around that.
28169>>>>>>>            Broadcast Recursive Send RefreshListForBackNavigation bCancel hoDD ri
28171>>>>>>>            
28171>>>>>>>        End
28171>>>>>>>>
28171>>>>>>>        // cancel
28171>>>>>>>        Else Begin
28172>>>>>>>            
28172>>>>>>>            // case of a cancel going back one level
28172>>>>>>>            If (Self = hoInvokingView) Begin
28174>>>>>>>                // This handles all select and weblist cancels.        
28174>>>>>>>                // We do this for all view types because a zoom might contain a list
28174>>>>>>>                Broadcast Recursive Send RefreshListForBackNavigation bCancel 0 (NullRowID())
28176>>>>>>>            End
28176>>>>>>>>
28176>>>>>>>            // if going back multiple levels, we don't do an update on the list because the list is not in scope. 
28176>>>>>>>            // Currently we are choosing not to  incur the overhead of extra roundtrip for a multi-level cancel.
28176>>>>>>>        End
28176>>>>>>>>
28176>>>>>>>            
28176>>>>>>>        
28176>>>>>>>        If hoInvokingObject Begin
28178>>>>>>>            Send ConditionalFocus of hoInvokingObject
28179>>>>>>>        End            
28179>>>>>>>>
28179>>>>>>>
28179>>>>>>>        //  Update the URL      
28179>>>>>>>        Send UpdateStateHash False
28180>>>>>>>        Send UpdatePageTitle
28181>>>>>>>        
28181>>>>>>>        //  We are done navigating now
28181>>>>>>>        Set pbNavigating to False
28182>>>>>>>
28182>>>>>>>        If (hoRefindError) Begin
28184>>>>>>>            // last thing that happens, you can do whatever
28184>>>>>>>            Send OnNavigateBackRefindError hoConstrainingParent eRefindError
28185>>>>>>>        End
28185>>>>>>>>
28185>>>>>>>        Else If (not(bCancel)) Begin
28188>>>>>>>        
28188>>>>>>>            // this is the object within the invoking view that called this
28188>>>>>>>            If (hoInvokingObject and hoCallback) Begin
28190>>>>>>>                // We are now the focus. You can use this to customize the update
28190>>>>>>>                // of to do another navigation 
28190>>>>>>>                Send OnNavigateBack of hoInvokingObject hoCallback NavigateData
28191>>>>>>>            End
28191>>>>>>>>
28191>>>>>>>        End
28191>>>>>>>>
28191>>>>>>>    End_Procedure
28192>>>>>>>    
28192>>>>>>>    //  Published procedure called by the client when it gets the navigateToClient client-action. 
28192>>>>>>>    //  This is done when navigating back multiple levels and the view we are navigating too was 
28192>>>>>>>    //  not synchronized. When this procedure is called the current view and the top view are both
28192>>>>>>>    //  being synchronized.
28192>>>>>>>    Procedure NavigateBackToHere_Callback Boolean bCancel Boolean bCallback String sCallback
28194>>>>>>>        tWebValueTree VT
28194>>>>>>>        tWebValueTree VT
28194>>>>>>>        tWebNavigateData NavigateData
28194>>>>>>>        tWebNavigateData NavigateData
28194>>>>>>>        Handle hoCallback
28194>>>>>>>        
28194>>>>>>>        Get ptActionData to VT
28195>>>>>>>        ValueTreeDeserializeParameter VT to NavigateData
28196>>>>>>>        
28196>>>>>>>        If (bCallback) Begin
28198>>>>>>>            Get WebObjectByName sCallback to hoCallback
28199>>>>>>>        End
28199>>>>>>>>
28199>>>>>>>        
28199>>>>>>>        Send NavigateBackToHereExec NavigateData bCancel hoCallback
28200>>>>>>>        
28200>>>>>>>    End_Procedure
28201>>>>>>>    
28201>>>>>>>    // determine the navigateFrom type based on the view being activated (self) and the
28201>>>>>>>    // invoking view and object (passed)
28201>>>>>>>    Function DetermineNavigateFromType Handle hoInvokingView Handle hoInvokingObject Handle ByRef iNavigateFile Returns Integer
28203>>>>>>>        Handle hoInvokingDD hoMainDD hoDDO
28203>>>>>>>        Integer iInvokingFile iMainFile
28203>>>>>>>        Integer iServers iServer iServerFile
28203>>>>>>>        Boolean bDataBindable
28203>>>>>>>        Move 0 to iNavigateFile
28204>>>>>>>        
28204>>>>>>>        If (hoInvokingView) Begin
28206>>>>>>>            
28206>>>>>>>            If (hoInvokingObject) Begin
28208>>>>>>>                Get Server of hoInvokingObject to hoInvokingDD
28209>>>>>>>            End
28209>>>>>>>>
28209>>>>>>>            Else Begin
28210>>>>>>>                Get Server of hoInvokingView to hoInvokingDD
28211>>>>>>>            End
28211>>>>>>>>
28211>>>>>>>            
28211>>>>>>>            Get Server to hoMainDD
28212>>>>>>>            
28212>>>>>>>            If (hoInvokingDD and hoMainDD) Begin
28214>>>>>>>                Get Main_File of hoInvokingDD to iInvokingFile
28215>>>>>>>                Get Main_File of hoMainDD to iMainFile
28216>>>>>>>                
28216>>>>>>>                If (iInvokingFile = iMainFile) Begin
28218>>>>>>>                    Move iMainFile to iNavigateFile
28219>>>>>>>                    Function_Return nfFromMain
28220>>>>>>>                End
28220>>>>>>>>
28220>>>>>>>                Else If ( Which_Data_Set(hoInvokingDD, iMainFile)) Begin
28223>>>>>>>                    Move iMainFile to iNavigateFile
28224>>>>>>>                    Function_Return nfFromChild
28225>>>>>>>                End
28225>>>>>>>>
28225>>>>>>>                Else Begin
28226>>>>>>>                    Get Data_Set_Server_Count of hoMainDD to iServers
28227>>>>>>>                    For iServer from 0 to (iServers-1)
28233>>>>>>>>
28233>>>>>>>                        Get Data_Set_Server of hoMainDD iServer to hoDDO
28234>>>>>>>                        Get Main_File of hoDDO to iServerFile
28235>>>>>>>                        If (iInvokingFile = iServerFile) Begin
28237>>>>>>>                            Move iInvokingFile to iNavigateFile
28238>>>>>>>                            Function_Return nfFromParent
28239>>>>>>>                        End
28239>>>>>>>>
28239>>>>>>>                    Loop
28240>>>>>>>>
28240>>>>>>>                End
28240>>>>>>>>
28240>>>>>>>            End
28240>>>>>>>>
28240>>>>>>>        End
28240>>>>>>>>
28240>>>>>>>        Function_Return nfUndefined
28241>>>>>>>    End_Function
28242>>>>>>>    
28242>>>>>>>    // Send this to navigate to the target view and add it to the view stack.
28242>>>>>>>    //
28242>>>>>>>    // eNavigateType - The Navigate From Type (i.e. nfFromMain, nfFromParent, etc)
28242>>>>>>>    // hoInvokingObject - This is the control in the "from view" that will populate the Navigate Data.
28242>>>>>>>    //                    The navigate data describes the role this view will play. Typically you will
28242>>>>>>>    //                    pass the object handle of the control that called NavigateForward.
28242>>>>>>>    //                    This control must understand the GetNavigateForwardData callback message.
28242>>>>>>>    Procedure NavigateForward Handle hoInvokingObject
28244>>>>>>>        Handle hoInvokingView hoTestInvokingObject
28244>>>>>>>        tWebNavigateData NavigateData
28244>>>>>>>        tWebNavigateData NavigateData
28244>>>>>>>        Integer iExpectedTable eNavigateType// eAppStateMode eTestNavType iTestTable
28244>>>>>>>        
28244>>>>>>>        // temporary for conversion. This will raise an error for older style NavigateFoward
28244>>>>>>>        // which passed two arguments. 
28244>>>>>>>        If (num_arguments<>1) Begin
28246>>>>>>>            Error DFERR_PROGRAM "NavigateForward has wrong number of parameters. Probably old style call"
28247>>>>>>>>
28247>>>>>>>            Procedure_Return
28248>>>>>>>        End
28248>>>>>>>>
28248>>>>>>>        
28248>>>>>>>        Get NamedValueAdd NavigateData.NamedValues "Init_Mode" initStateDefault to NavigateData.NamedValues
28249>>>>>>>        
28249>>>>>>>        Send NavigateForward2 hoInvokingObject NavigateData ntNavigateForward
28250>>>>>>>    End_Procedure
28251>>>>>>>
28251>>>>>>>    // Just like NavigateForward but it always makes this an nfUndefined navigation. This provides a way
28251>>>>>>>    // for developers to perform a custom forward navigation (nfUndefined) when the natural navigation would be
28251>>>>>>>    // some other navigation. When doing a custom navigation, the only option is nfUndefined because allowing a 
28251>>>>>>>    // developer to assign any other navigate-from type when it is not what is expected will probably not work.
28251>>>>>>>    // Note that the NavigateData data can be further customized in OnGetNavigateForwardData
28251>>>>>>>    // this is for advanced use - normally NavigateForward is used.
28251>>>>>>>    Procedure NavigateForwardCustom Handle hoInvokingObject
28253>>>>>>>        tWebNavigateData NavigateData
28253>>>>>>>        tWebNavigateData NavigateData
28253>>>>>>>        
28253>>>>>>>        Get NamedValueAdd NavigateData.NamedValues "Init_Mode" initStateDefault to NavigateData.NamedValues
28254>>>>>>>        
28254>>>>>>>        Send NavigateForward2 hoInvokingObject NavigateData ntNavigateForwardCustom
28255>>>>>>>    End_Procedure
28256>>>>>>>    
28256>>>>>>>    
28256>>>>>>>    // Navigates into this view when restoring a state. This means that most likely the view will 
28256>>>>>>>    // not be shown but is just initialzed to correct the view stack. The view will be loaded to 
28256>>>>>>>    // the client asynchronously to optimize performance.
28256>>>>>>>    //
28256>>>>>>>    // Params:
28256>>>>>>>    //      bTopView    If true this is the topmost view that will be displayed.
28256>>>>>>>    //      sMainId     Record ID of the main DD (from the state hash).
28256>>>>>>>    //      sStateHash  The full state hash for this view.
28256>>>>>>>    // Returns:
28256>>>>>>>    //      False if the main ID is not a valid record.
28256>>>>>>>    Function NavigateInitialize Handle hoInvokingObject Boolean bTopView String sStateHash Integer eNavMode Returns Boolean
28258>>>>>>>        tWebNavigateData NavigateData
28258>>>>>>>        tWebNavigateData NavigateData
28258>>>>>>>        Handle hoInvokingView hoMainDD
28258>>>>>>>        RowID rRowId
28258>>>>>>>        Boolean bFound bSuccess bIsDynamic
28258>>>>>>>        
28258>>>>>>>        
28258>>>>>>>        // Add extra properties used during initialization
28258>>>>>>>        Get NamedValueAdd NavigateData.NamedValues "Init_Mode" (If(bTopView, initStateReinitializeTopView, initStateReinitialize)) to NavigateData.NamedValues
28259>>>>>>>        Get NamedValueAdd NavigateData.NamedValues "Init_StateHash" sStateHash to NavigateData.NamedValues
28260>>>>>>>        
28260>>>>>>>        // Get into the standard initialization
28260>>>>>>>        Set pbNavReinitError to False
28261>>>>>>>        Send NavigateForward2 hoInvokingObject NavigateData eNavMode
28262>>>>>>>        Get pbNavReinitError to bSuccess
28263>>>>>>>        Move (not(bSuccess)) to bSuccess
28264>>>>>>>        
28264>>>>>>>        Function_Return bSuccess
28265>>>>>>>    End_Function
28266>>>>>>>    
28266>>>>>>>    // Reads the record id from the statehash and puts it in the NavigateData struct, this is called during 
28266>>>>>>>    // the forward navigation (only for NavigateInitialize).
28266>>>>>>>    //
28266>>>>>>>    // Params:
28266>>>>>>>    //      NavigateData    Byreference navigationdata struct (so it can be altered).
28266>>>>>>>    Procedure NavigateInitializeUpdateRowId tWebNavigateData ByRef NavigateData
28268>>>>>>>        String sHash sMainId sView sCustom
28268>>>>>>>        Integer eStateMode iTable
28268>>>>>>>        Handle hoMainDD
28268>>>>>>>        RowID rRowID
28268>>>>>>>        Boolean bSuccess
28268>>>>>>>        
28268>>>>>>>        Get peStateMode to eStateMode
28269>>>>>>>        Get Main_DD to hoMainDD
28270>>>>>>>        
28270>>>>>>>        Get NamedValueGet NavigateData.NamedValues "Init_StateHash" to sHash
28271>>>>>>>        Send ParseViewStateHash of (Host(Self)) sHash (&sView) (&sMainId) (&sCustom)
28272>>>>>>>        
28272>>>>>>>        // Set rowid from the state hash
28272>>>>>>>        If ((peViewType(Self) = vtZoom and eStateMode = vsmDefault) or eStateMode = vsmRecord) Begin
28274>>>>>>>            If (hoMainDD <> 0) Begin
28276>>>>>>>                Move (Main_File(hoMainDD)) to iTable
28277>>>>>>>                Get HashRecordIdToRowId iTable sMainId (&rRowId) to bSuccess
28278>>>>>>>                If (bSuccess) Begin
28280>>>>>>>                    Move (SerializeRowID(rRowId)) to NavigateData.sRowID
28281>>>>>>>                    Move iTable to  NavigateData.iTable
28282>>>>>>>                    // Keep new-record state when the state hash contains the configured new-record id.
28282>>>>>>>                    Move (Lowercase(sMainId) = Lowercase(psStateNewRecordId(Self))) to NavigateData.bNewRecord
28283>>>>>>>                End
28283>>>>>>>>
28283>>>>>>>                Else Begin
28284>>>>>>>                    Set pbNavReinitError to True
28285>>>>>>>                    If (pbStateHashInvalidError(Host(Self))) Begin
28287>>>>>>>                        Error DFERR_WEBAPP_INVALID_URL_REC
28288>>>>>>>>
28288>>>>>>>                    End
28288>>>>>>>>
28288>>>>>>>                End
28288>>>>>>>>
28288>>>>>>>            End
28288>>>>>>>>
28288>>>>>>>        End
28288>>>>>>>>
28288>>>>>>>        Else If (eStateMode = vsmDefault) Begin
28291>>>>>>>            If (NavigateData.iTable > 0) Begin
28293>>>>>>>                Get HashRecordIdToRowId NavigateData.iTable sMainId (&rRowId) to bSuccess
28294>>>>>>>                If (bSuccess) Begin
28296>>>>>>>                    Move (SerializeRowID(rRowId)) to NavigateData.sRowID
28297>>>>>>>                End
28297>>>>>>>>
28297>>>>>>>                Else Begin
28298>>>>>>>                    Set pbNavReinitError to True
28299>>>>>>>                    If (pbStateHashInvalidError(Host(Self))) Begin
28301>>>>>>>                        Error DFERR_WEBAPP_INVALID_URL_REC
28302>>>>>>>>
28302>>>>>>>                    End
28302>>>>>>>>
28302>>>>>>>                End
28302>>>>>>>>
28302>>>>>>>            End
28302>>>>>>>>
28302>>>>>>>        End
28302>>>>>>>>
28302>>>>>>>    End_Procedure
28303>>>>>>>    
28303>>>>>>>    // Determines if this view needs to be reininitialized when restoring the state looking at the
28303>>>>>>>    // record id.
28303>>>>>>>    //
28303>>>>>>>    // Params:
28303>>>>>>>    //      sExpectedMainId     Record ID of the main table navigation table to compare to record buffer.
28303>>>>>>>    Function NeedReinitialize String sExpectedMainId Returns Boolean
28305>>>>>>>        tWebNavigateData navData
28305>>>>>>>        tWebNavigateData navData
28305>>>>>>>        Integer eStateMode
28305>>>>>>>        Handle hoMainDD
28305>>>>>>>        RowID rRowId
28305>>>>>>>        Boolean bValid
28305>>>>>>>        
28305>>>>>>>        Get peStateMode to eStateMode
28306>>>>>>>        Get Main_DD to hoMainDD
28307>>>>>>>        
28307>>>>>>>        If ((peViewType(Self) = vtZoom and eStateMode = vsmDefault) or eStateMode = vsmRecord) Begin
28309>>>>>>>            Get GetNavigateData to navData
28310>>>>>>>            
28310>>>>>>>            If (hoMainDD <> 0) Begin
28312>>>>>>>                If (sExpectedMainId <> "" ) Begin    
28314>>>>>>>                    Get HashRecordIdToRowId (navData.iTable) sExpectedMainId (&rRowId) to bValid
28315>>>>>>>                    If (bValid and IsSameRowID(rRowId, CurrentRowId(hoMainDD))) Begin
28317>>>>>>>                        Function_Return False
28318>>>>>>>                    End
28318>>>>>>>>
28318>>>>>>>                End
28318>>>>>>>>
28318>>>>>>>                Else If (navData.bNewRecord and not(HasRecord(hoMainDD))) Begin
28321>>>>>>>                    Function_Return False
28322>>>>>>>                End
28322>>>>>>>>
28322>>>>>>>            End
28322>>>>>>>>
28322>>>>>>>            Else Begin
28323>>>>>>>                Function_Return False
28324>>>>>>>            End
28324>>>>>>>>
28324>>>>>>>        End
28324>>>>>>>>
28324>>>>>>>        Else If (eStateMode = vsmDefault) Begin
28327>>>>>>>            Get GetNavigateData to navData
28328>>>>>>>            
28328>>>>>>>            If (navData.iTable > 0) Begin
28330>>>>>>>                Get HashRecordIdToRowId (navData.iTable) sExpectedMainId (&rRowId) to bValid
28331>>>>>>>                If (bValid and navData.sRowID = SerializeRowID(rRowId)) Begin
28333>>>>>>>                    Function_Return False
28334>>>>>>>                End
28334>>>>>>>>
28334>>>>>>>            End
28334>>>>>>>>
28334>>>>>>>            
28334>>>>>>>            If (navData.eNavigateType = nfUndefined) Begin
28336>>>>>>>                Function_Return False
28337>>>>>>>            End
28337>>>>>>>>
28337>>>>>>>        End
28337>>>>>>>>
28337>>>>>>>        
28337>>>>>>>        Function_Return True
28338>>>>>>>    End_Function
28339>>>>>>>
28339>>>>>>>    // Called back by the LoadViewCallBack procedure that makes sure that the view is actually in 
28339>>>>>>>    // sync (by going back to the client and optionally loading it).
28339>>>>>>>    Procedure NavigateForward_CallBack
28341>>>>>>>        Send NavigateForwardFinish
28342>>>>>>>    End_Procedure
28343>>>>>>>
28343>>>>>>>    // called by NavigateForward and NavigateForwardCustom only 
28343>>>>>>>    Procedure NavigateForward2 Handle hoInvokingObject tWebNavigateData NavigateData Integer eNavMode
28345>>>>>>>        Integer eWebViewStyle eInvokingViewStyle eInitMode iMainFile iStackSize
28345>>>>>>>        Handle hoInvokingObjectTemp hoInvokingView hoMainDD hoInvokingViewDD 
28345>>>>>>>        Boolean bOK bChanged bErr bHasRecord bCancel bHandled
28345>>>>>>>        String sInvokingView sReason sViewName
28345>>>>>>>        tWebViewInfo[] aViewStack
28345>>>>>>>        tWebViewInfo[] aViewStack
28346>>>>>>>        RowID riMainRowId
28346>>>>>>>        
28346>>>>>>>        Get NamedValueGet NavigateData.NamedValues "Init_Mode" to eInitMode
28347>>>>>>>        Get TopViewHandle of (ViewStack(Self)) to hoInvokingView
28348>>>>>>>        Get Main_DD to hoMainDD
28349>>>>>>>                
28349>>>>>>>        // Test Access rights...
28349>>>>>>>        Get AllowAccess to bOK
28350>>>>>>>        If (not(bOK)) Begin
28352>>>>>>>            Get ViewAccessDenied Self False to bHandled
28353>>>>>>>            Procedure_Return
28354>>>>>>>        End
28354>>>>>>>>
28354>>>>>>>        
28354>>>>>>>        // Test for valid view style
28354>>>>>>>        Get peWebViewStyle to eWebViewStyle
28355>>>>>>>        If (eWebViewStyle = wvsDesktop) Begin
28357>>>>>>>            Error DFERR_PROGRAM "Can't navigate forward to a non-drill down view"
28358>>>>>>>>
28358>>>>>>>            Procedure_Return
28359>>>>>>>        End
28359>>>>>>>>
28359>>>>>>>
28359>>>>>>>        // Test that we can actually navigate to this view
28359>>>>>>>        Get CanPushView of (ViewStack(Self)) Self (&sReason) to bOK
28360>>>>>>>        
28360>>>>>>>        If (not(bOK)) Begin
28362>>>>>>>            Get WebObjectName to sViewName
28363>>>>>>>            Error DFERR_PROGRAM ("View stack navigate error: Cannot Navigate to (" + sViewName + "). " + sReason)
28364>>>>>>>>
28364>>>>>>>            Procedure_Return             
28365>>>>>>>        End
28365>>>>>>>>
28365>>>>>>>
28365>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
28366>>>>>>>        Move (SizeOfArray(aViewStack)) to iStackSize
28367>>>>>>>        
28367>>>>>>>        // Populate the Navigate Data struct.
28367>>>>>>>        If (eNavMode = ntNavigateForwardCustom) Begin
28369>>>>>>>            Move nfUndefined to NavigateData.eNavigateType
28370>>>>>>>        End
28370>>>>>>>>
28370>>>>>>>        Else Begin      
28371>>>>>>>            //  Determine navigation type and table
28371>>>>>>>            Get DetermineNavigateFromType hoInvokingView hoInvokingObject (&NavigateData.iTable) to NavigateData.eNavigateType
28372>>>>>>>        End 
28372>>>>>>>>
28372>>>>>>>        
28372>>>>>>>        //  Determine rowid and fire OnGetNavigateForwardData
28372>>>>>>>        If (hoInvokingObject <> C_WebUnresolvedObject) Begin
28374>>>>>>>            Send GetNavigateForwardData of hoInvokingObject Self (&NavigateData)
28375>>>>>>>        End
28375>>>>>>>>
28375>>>>>>>        
28375>>>>>>>        //  Override rowid when initializing from a state hash
28375>>>>>>>        If (eInitMode = initStateReinitialize or eInitMode = initStateReinitializeTopView) Begin
28377>>>>>>>            Send NavigateInitializeUpdateRowId (&NavigateData)
28378>>>>>>>            If (pbNavReinitError(Self)) ;                Procedure_Return
28381>>>>>>>        End
28381>>>>>>>>
28381>>>>>>>        
28381>>>>>>>        //  Give a last change to intervene before actual changes will be made
28381>>>>>>>        Send SetNavigateData NavigateData   // Set the navigationdata so that Refresh reads the right init_mode
28382>>>>>>>        Move False to bCancel
28383>>>>>>>        Send OnNavigating (&NavigateData) hoInvokingView hoInvokingObject (&bCancel)
28384>>>>>>>        If (bCancel) Begin
28386>>>>>>>            Set pbNavReinitError to True
28387>>>>>>>            Procedure_Return
28388>>>>>>>        End
28388>>>>>>>>
28388>>>>>>>        
28388>>>>>>>        // update the top of the stack with what is now the current record which
28388>>>>>>>        // should have been returned in NavigateData
28388>>>>>>>        If (iStackSize and aViewStack[iStackSize-1].iMainTable = NavigateData.iTable) Begin 
28390>>>>>>>            Move (DeserializeRowID(NavigateData.sRowID)) to aViewStack[iStackSize-1].riMainTable
28391>>>>>>>            WebSet paViewStack of (ViewStack(Self)) to aViewStack
28392>>>>>>>        End
28392>>>>>>>>
28392>>>>>>>                
28392>>>>>>>        // Store the NavigateData
28392>>>>>>>        Send SetNavigateData NavigateData
28393>>>>>>>        Send SetInvokingObject hoInvokingObject
28394>>>>>>>        
28394>>>>>>>        // if we must first save, we require a successful save
28394>>>>>>>        // or an existing record with no changes
28394>>>>>>>        If (NavigateData.bSaveBeforeNavigate and eInitMode = initStateDefault) Begin
28396>>>>>>>            Get Server of hoInvokingView to hoInvokingViewDD
28397>>>>>>>            If (hoInvokingViewDD) Begin
28399>>>>>>>                Get HasRecord of hoInvokingViewDD to bHasRecord
28400>>>>>>>            End
28400>>>>>>>>
28400>>>>>>>            Get SaveViewBeforeNavigate of hoInvokingView to bErr
28401>>>>>>>            If bErr Begin
28403>>>>>>>                Set pbNavReinitError to True    //  This should never happen!
28404>>>>>>>                Procedure_Return
28405>>>>>>>            End
28405>>>>>>>>
28405>>>>>>>            // if a new successful save we must udpate navigateData and the
28405>>>>>>>            // top of the view stack with the new record
28405>>>>>>>            If (hoInvokingViewDD and not(bHasRecord)) Begin
28407>>>>>>>                Get Main_File of hoInvokingViewDD to iMainFile
28408>>>>>>>                If (NavigateData.iTable = iMainFile) Begin
28410>>>>>>>                    Get CurrentRowId of hoInvokingViewDD to riMainRowId
28411>>>>>>>                    Move (SerializeRowID(riMainRowId)) to NavigateData.sRowID
28412>>>>>>>                    Send SetNavigateData NavigateData
28413>>>>>>>                    
28413>>>>>>>                    If (iStackSize) Begin 
28415>>>>>>>                        Move riMainRowId to aViewStack[iStackSize-1].riMainTable
28416>>>>>>>                        WebSet paViewStack of (ViewStack(Self)) to aViewStack
28417>>>>>>>                    End
28417>>>>>>>>
28417>>>>>>>                End
28417>>>>>>>>
28417>>>>>>>            End
28417>>>>>>>>
28417>>>>>>>        End
28417>>>>>>>>
28417>>>>>>>        
28417>>>>>>>        //Check if we need to hide a dialog
28417>>>>>>>        If (hoInvokingView <> 0) Begin
28419>>>>>>>           Get peWebViewStyle of hoInvokingView to eInvokingViewStyle
28420>>>>>>>            If (eInvokingViewStyle = wvsDialog and eWebViewStyle <> wvsDialog) Begin
28422>>>>>>>                //If this happens we navigated from a dialog to a view which means we should hide all dialogs.
28422>>>>>>>                Send HideAllDialogs
28423>>>>>>>            End
28423>>>>>>>>
28423>>>>>>>        End
28423>>>>>>>>
28423>>>>>>>        
28423>>>>>>>        //  Finish navigation
28423>>>>>>>        If (eInitMode = initStateReinitialize) Begin
28425>>>>>>>            Send DelayLoadview of (Host(Self)) Self 
28426>>>>>>>            Send NavigateForwardFinish 
28427>>>>>>>        End
28427>>>>>>>>
28427>>>>>>>        Else Begin
28428>>>>>>>            Send ShowView of (Host(Self)) Self (RefProc(NavigateForward_CallBack)) Self
28429>>>>>>>        End
28429>>>>>>>>
28429>>>>>>>    End_Procedure
28430>>>>>>>    
28430>>>>>>>    // This message is sent when navigating into a view (forward navigation) and is the last chance
28430>>>>>>>    // to influence the navigation data before the navigation is performed. It also is the place to 
28430>>>>>>>    // cancel the navigation.
28430>>>>>>>    Procedure OnNavigating tWebNavigateData ByRef NavigateData Handle hoInvokingView Handle hoInvokingObject Boolean ByRef bCancel
28432>>>>>>>    End_Procedure
28433>>>>>>>    
28433>>>>>>>    // The last step of the forward navigation where the view navigating to is in sync and finds 
28433>>>>>>>    // and constraints are performed based on the NavigateDataFinish. This procedure does look at
28433>>>>>>>    // the DDO structure of the invoking view but that shouldn't be a problem.
28433>>>>>>>    Procedure NavigateForwardFinish
28435>>>>>>>        Integer iStackSize iParentTable eInitMode
28435>>>>>>>        Handle hoMainDD hoParentDD hoInvokingView hoInvokingObject hoTopView
28435>>>>>>>        Boolean bOK bHasRecord bPrevNav
28435>>>>>>>        RowID ri
28435>>>>>>>        tWebNavigateData NavigateData
28435>>>>>>>        tWebNavigateData NavigateData
28435>>>>>>>        tWebViewInfo[] aViewStack
28435>>>>>>>        tWebViewInfo[] aViewStack
28436>>>>>>>        Handle[] hoStackDDOs
28437>>>>>>>        RowID[] riStackRowIds
28438>>>>>>>        Boolean bDynamicConstraints bOverrideViewState bFindParent bErr bSuccess
28438>>>>>>>        Integer eWebViewStyle eViewType
28438>>>>>>>        Integer iMainFile iConstrainFile eRefindError
28438>>>>>>>        String sMainRowId sTitle sCustomStateHash
28438>>>>>>>        RowID riMainRowId
28438>>>>>>>        Handle hoInvokingViewDD hoInvokingObjectDD hoRefindError
28438>>>>>>>        
28438>>>>>>>        //  Indicate that we are navigating
28438>>>>>>>        Set pbNavigating to True
28439>>>>>>>        
28439>>>>>>>        Get Main_DD to hoMainDD
28440>>>>>>>        Get TopViewHandle of (ViewStack(Self)) to hoInvokingView
28441>>>>>>>        If (hoInvokingView <> C_WebUnresolvedObject) Begin
28443>>>>>>>            Get GetInvokingObject to hoInvokingObject
28444>>>>>>>        End
28444>>>>>>>>
28444>>>>>>>        
28444>>>>>>>        Get GetNavigateData to NavigateData
28445>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
28446>>>>>>>        Move (SizeOfArray(aViewStack)) to iStackSize
28447>>>>>>>        Get NamedValueGet NavigateData.NamedValues "Init_Mode" to eInitMode
28448>>>>>>>
28448>>>>>>>        
28448>>>>>>>        Get peViewType to eViewType
28449>>>>>>>        Get IsDynamicConstraints to bDynamicConstraints
28450>>>>>>>        
28450>>>>>>>        // Interpret the navigate data 
28450>>>>>>>        
28450>>>>>>>        If hoMainDD Begin
28452>>>>>>>            
28452>>>>>>>            Send Refind_Records of hoMainDD
28453>>>>>>>            
28453>>>>>>>            
28453>>>>>>>            //  We are performing finds on the invoking views here to 'correct' their current records based on our navigate-data
28453>>>>>>>            If (hoInvokingObject <> C_WebUnresolvedObject and eInitMode <> initStateDefault and NavigateData.iTable > 0) Begin
28455>>>>>>>                Handle hoInvokingServer hoInvokingDD
28455>>>>>>>                RowID riNavRowId
28455>>>>>>>                
28455>>>>>>>                Get Server of hoInvokingObject to hoInvokingServer 
28456>>>>>>>                If (hoInvokingServer > 0 and IsInCallActionScope(hoInvokingObject)) Begin
28458>>>>>>>                    Get Data_Set of hoInvokingServer NavigateData.iTable to hoInvokingDD
28459>>>>>>>                    Move (DeserializeRowID(NavigateData.sRowID)) to riNavRowId
28460>>>>>>>                    
28460>>>>>>>                    If (hoinvokingdd > 0 and not(IsSameRowId(CurrentRowId(hoInvokingDD), riNavRowId))) Begin
28462>>>>>>>                        Get pbNavigating of hoInvokingView to bPrevNav
28463>>>>>>>                        Set pbNavigating of hoInvokingView to True
28464>>>>>>>                        If (IsNullRowID(riNavRowId)) Begin
28466>>>>>>>                            Send Clear of hoInvokingDD
28467>>>>>>>                        End
28467>>>>>>>>
28467>>>>>>>                        Else Begin
28468>>>>>>>                            Send FindByRowId of hoInvokingDD NavigateData.iTable riNavRowId
28469>>>>>>>                        End
28469>>>>>>>>
28469>>>>>>>                        Set pbNavigating of hoInvokingView to bPrevNav
28470>>>>>>>                    End
28470>>>>>>>>
28470>>>>>>>                End
28470>>>>>>>>
28470>>>>>>>            End
28470>>>>>>>>
28470>>>>>>>            
28470>>>>>>>            If (bDynamicConstraints) Begin
28472>>>>>>>                // this re-establishes all existing constraints
28472>>>>>>>                Send EstablishConstrainFiles hoMainDD aViewStack (&hoStackDDOs) (&riStackRowIds)    
28473>>>>>>>                
28473>>>>>>>                // Now Set hew highest level constrain_file if needed.
28473>>>>>>>                Move False to bFindParent
28474>>>>>>>                // if fromParent we need a constraint
28474>>>>>>>                If (NavigateData.eNavigateType = nfFromParent and iStackSize>0) Begin
28476>>>>>>>                    Move aViewStack[iStackSize-1].iMainTable to iParentTable
28477>>>>>>>                    // must be an immediate parent of the main DDO or this is an error          
28477>>>>>>>                    Get ParentDDOForTable hoMainDD iParentTable to hoParentDD             
28478>>>>>>>                    If (hoParentDD = 0) Begin
28480>>>>>>>                        Error DFERR_PROGRAM ("Parent DDO not found for table# "+String(iParentTable))
28481>>>>>>>>
28481>>>>>>>                    End
28481>>>>>>>>
28481>>>>>>>                    
28481>>>>>>>                    Set Constrain_File of hoMainDD to iParentTable
28482>>>>>>>                    
28482>>>>>>>                    // find the constraining parent record and its parents
28482>>>>>>>                    Move True to bFindParent
28483>>>>>>>                    Move aViewStack[iStackSize-1].riMainTable to ri
28484>>>>>>>                End
28484>>>>>>>>
28484>>>>>>>                // if fromMain and the parent view is fromParent or a manual constraint
28484>>>>>>>                // we need a constraint added here
28484>>>>>>>                Else If (NavigateData.eNavigateType = nfFromMain) Begin
28487>>>>>>>
28487>>>>>>>                    If (hoInvokingObject) Begin
28489>>>>>>>                        Boolean bIsDynamic bIsDynamicBase
28489>>>>>>>                        Handle hoWidgetObj hoWidgetObjDD
28489>>>>>>>                        
28489>>>>>>>                        If (hoWidgetObj <> 0) Begin
28491>>>>>>>                            Get Server of hoInvokingObject to hoInvokingObjectDD
28492>>>>>>>                            Get Server of hoWidgetObj to hoWidgetObjDD
28493>>>>>>>                            
28493>>>>>>>                            If (hoInvokingObjectDD and hoWidgetObjDD<>hoInvokingObjectDD) Begin
28495>>>>>>>                            
28495>>>>>>>                                Get Constrain_File of hoInvokingObjectDD to iConstrainFile
28496>>>>>>>                                If (hoWidgetObjDD > 0) Begin
28498>>>>>>>                                    Get Main_File of hoWidgetObjDD to iParentTable
28499>>>>>>>                                End
28499>>>>>>>>
28499>>>>>>>                                // if there is an invokingDD constraint, it is a manual constraint. We only support
28499>>>>>>>                                // navigating from this if that cosntraint parent is the invoking view's main dd
28499>>>>>>>                                If (iConstrainFile and iParentTable=iConstrainFile) Begin
28501>>>>>>>                                    // must be an immediate parent of the main DDO or this is an error          
28501>>>>>>>                                    Get ParentDDOForTable hoMainDD iParentTable to hoParentDD             
28502>>>>>>>                                    If (hoParentDD = 0) Begin
28504>>>>>>>                                        Error DFERR_PROGRAM ("Parent DDO not found for table# "+String(iParentTable))
28505>>>>>>>>
28505>>>>>>>                                    End
28505>>>>>>>>
28505>>>>>>>                                    
28505>>>>>>>                                    Set Constrain_File of hoMainDD to iParentTable
28506>>>>>>>                                    
28506>>>>>>>                                    // find the constraining parent record and its parents
28506>>>>>>>                                    Move True to bFindParent
28507>>>>>>>                                    // this is the parent record to refind
28507>>>>>>>                                    Get CurrentRowId of hoWidgetObjDD to ri
28508>>>>>>>                                End
28508>>>>>>>>
28508>>>>>>>                                Else If (hoWidgetObjDD > 0) Begin
28511>>>>>>>                                    // this is a navigate from we don't allow.
28511>>>>>>>                                    Error DFERR_PROGRAM ("Cannot navigate from this invoking manually constrained DDO for table# "+String(iParentTable))
28512>>>>>>>>
28512>>>>>>>                                End
28512>>>>>>>>
28512>>>>>>>                            End
28512>>>>>>>>
28512>>>>>>>                            Else Begin
28513>>>>>>>                                Send Refind_Records of hoInvokingObjectDD
28514>>>>>>>                                Get CurrentRowId of hoInvokingObjectDD to ri
28515>>>>>>>                                Move (SerializeRowID(ri)) to NavigateData.sRowID
28516>>>>>>>                            End
28516>>>>>>>>
28516>>>>>>>                        End
28516>>>>>>>>
28516>>>>>>>                        Else Begin
28517>>>>>>>                            
28517>>>>>>>                            Get Server of hoInvokingObject to hoInvokingObjectDD
28518>>>>>>>                            Get Server of hoInvokingView to hoInvokingViewDD
28519>>>>>>>                            // special fromMain case where the DDO is not the view's main_dd but is
28519>>>>>>>                            // a child DD that has a constraint. If so we only support this one level
28519>>>>>>>                            // deep and the DD must be constrained to the invoking view's main DD.
28519>>>>>>>                            // for example, mavigating from ZoomOrder's detail grid tp a detail zoom
28519>>>>>>>                            If (hoInvokingObjectDD and hoInvokingViewDD<>hoInvokingObjectDD) Begin
28521>>>>>>>                            
28521>>>>>>>                                Get Constrain_File of hoInvokingObjectDD to iConstrainFile
28522>>>>>>>                                If (hoInvokingViewDD > 0) Begin
28524>>>>>>>                                    Get Main_File of hoInvokingViewDD to iParentTable
28525>>>>>>>                                End
28525>>>>>>>>
28525>>>>>>>                                // if there is an invokingDD constraint, it is a manual constraint. We only support
28525>>>>>>>                                // navigating from this if that cosntraint parent is the invoking view's main dd
28525>>>>>>>                                If (iConstrainFile and iParentTable=iConstrainFile) Begin
28527>>>>>>>                                    // must be an immediate parent of the main DDO or this is an error          
28527>>>>>>>                                    Get ParentDDOForTable hoMainDD iParentTable to hoParentDD             
28528>>>>>>>                                    If (hoParentDD = 0) Begin
28530>>>>>>>                                        Error DFERR_PROGRAM ("Parent DDO not found for table# "+String(iParentTable))
28531>>>>>>>>
28531>>>>>>>                                    End
28531>>>>>>>>
28531>>>>>>>                                    
28531>>>>>>>                                    Set Constrain_File of hoMainDD to iParentTable
28532>>>>>>>                                    
28532>>>>>>>                                    // find the constraining parent record and its parents
28532>>>>>>>                                    Move True to bFindParent
28533>>>>>>>                                    // this is the parent record to refind
28533>>>>>>>                                    Get CurrentRowId of hoInvokingViewDD to ri
28534>>>>>>>                                End
28534>>>>>>>>
28534>>>>>>>                                Else If (hoInvokingViewDD > 0) Begin
28537>>>>>>>                                    // this is a navigate from we don't allow.
28537>>>>>>>                                    Error DFERR_PROGRAM ("Cannot navigate from this invoking manually constrained DDO for table# "+String(iParentTable))
28538>>>>>>>>
28538>>>>>>>                                End
28538>>>>>>>>
28538>>>>>>>                            End
28538>>>>>>>>
28538>>>>>>>                            
28538>>>>>>>                        End
28538>>>>>>>>
28538>>>>>>>                    End
28538>>>>>>>>
28538>>>>>>>                    // this is a more typical fromMain where invoking view is constrained amd
28538>>>>>>>                    // we want to use that constraint. 
28538>>>>>>>                    If  (not(bFindParent) and aViewStack[iStackSize-1].eNavigateType=nfFromParent and iStackSize>1) Begin
28540>>>>>>>                        Move aViewStack[iStackSize-2].iMainTable to iParentTable
28541>>>>>>>                        // must be an immediate parent of the main DDO or this is an error          
28541>>>>>>>                        Get ParentDDOForTable hoMainDD iParentTable to hoParentDD             
28542>>>>>>>                        If (hoParentDD = 0) Begin
28544>>>>>>>                            Error DFERR_PROGRAM ("Parent DDO not found for table# "+String(iParentTable))
28545>>>>>>>>
28545>>>>>>>                        End
28545>>>>>>>>
28545>>>>>>>                        // note constrain_file should already be set
28545>>>>>>>                        Move True to bFindParent
28546>>>>>>>                        Move aViewStack[iStackSize-2].riMainTable to ri
28547>>>>>>>                    End
28547>>>>>>>>
28547>>>>>>>                End
28547>>>>>>>>
28547>>>>>>>                
28547>>>>>>>            End
28547>>>>>>>>
28547>>>>>>>    
28547>>>>>>>            // Used to set ordering for a List. Do it here so any grid fills will use the right index.
28547>>>>>>>            // Let's do this before any finds occur on the new view. This can be used to set up custom
28547>>>>>>>            // constraints
28547>>>>>>>            Send NavigateForwardPreFindInit NavigateData hoInvokingObject
28548>>>>>>>
28548>>>>>>>            // Now rebuild the constraints
28548>>>>>>>            Send RebuildAllConstraints of hoMainDD
28549>>>>>>>        
28549>>>>>>>            // Now refind the parent if needed.
28549>>>>>>>            // This will only happen with dynamic constraints but this makes our intention clear.
28549>>>>>>>            If (bDynamicConstraints and bFindParent) Begin
28551>>>>>>>                // no autofill stops a child findfirst. We don't need that here  
28551>>>>>>>                Get FindByRowIdExNoAutoFill of hoParentDD iParentTable ri to bSuccess
28552>>>>>>>                // we also consider navigating forward from a null consrained parent an error
28552>>>>>>>                If (not(bSuccess) or IsNullRowID(ri)) Begin
28554>>>>>>>                    // This is kind of complex because it means that the constraining parent cannot be
28554>>>>>>>                    // reloaded. In such a case you probably should not be in the view at all and
28554>>>>>>>                    // should navigate back
28554>>>>>>>                    Move hoParentDD to hoRefindError
28555>>>>>>>                    Move retCannotRereadConstrainingParent to eRefindError    
28556>>>>>>>                End
28556>>>>>>>>
28556>>>>>>>            End
28556>>>>>>>>
28556>>>>>>>
28556>>>>>>>            If (hoRefindError=0) Begin
28558>>>>>>>                
28558>>>>>>>                // now find main file as needed
28558>>>>>>>                If ( (NavigateData.eNavigateType = nfFromMain or ;                      NavigateData.eNavigateType = nfFromChild or ;                      NavigateData.eNavigateType = nfUndefined)  ;                     and NavigateData.iTable=Main_File(hoMainDD) and iStackSize>0) Begin
28560>>>>>>>                    
28560>>>>>>>                    Move (DeserializeRowID(NavigateData.sRowID)) to ri
28561>>>>>>>                    If (IsNullRowID(ri) or NavigateData.bNewRecord) Begin
28563>>>>>>>                        // Assume Create New Record
28563>>>>>>>                        Send Clear to hoMainDD
28564>>>>>>>                    End
28564>>>>>>>>
28564>>>>>>>                    Else Begin
28565>>>>>>>                        // Populate the list around the passed row ID
28565>>>>>>>                        Get FindByRowIdEx of hoMainDD (Main_File(hoMainDD)) ri to bSuccess
28566>>>>>>>                        If not bSuccess Begin
28568>>>>>>>                            Send Clear of hoMainDD
28569>>>>>>>                            Move hoMainDD to hoRefindError
28570>>>>>>>                            Move retCannotRereadMain to eRefindError    
28571>>>>>>>                        End
28571>>>>>>>>
28571>>>>>>>                    End
28571>>>>>>>>
28571>>>>>>>                End
28571>>>>>>>>
28571>>>>>>>                Else If (eViewType=vtZoom and  NavigateData.eNavigateType = nfFromParent and iStackSize>0) Begin
28574>>>>>>>                    // Assume Create New Record
28574>>>>>>>                    Send Clear to hoMainDD
28575>>>>>>>                End
28575>>>>>>>>
28575>>>>>>>    
28575>>>>>>>                // finally, if a select view and we don't have a record tell the grid to
28575>>>>>>>                // do an init
28575>>>>>>>                If (eInitMode <> initStateReinitialize and hoRefindError=0 and eViewType=vtSelect) Begin
28577>>>>>>>                    Get HasRecord of hoMainDD to bOK
28578>>>>>>>                    If not bOK Begin
28580>>>>>>>                        Broadcast Recursive Send InitGrid NavigateData hoInvokingObject
28582>>>>>>>                    End
28582>>>>>>>>
28582>>>>>>>                End
28582>>>>>>>>
28582>>>>>>>    
28582>>>>>>>            End
28582>>>>>>>>
28582>>>>>>>        End
28582>>>>>>>>
28582>>>>>>>        
28582>>>>>>>        // Update the View Stack
28582>>>>>>>        Send PushView to (ViewStack(Self)) Self NavigateData.eNavigateType
28583>>>>>>>        Send UpdateInvokingViewDrillDownStyle 
28584>>>>>>>        
28584>>>>>>>
28584>>>>>>>        
28584>>>>>>>        
28584>>>>>>>        //  Cleanup navigation data
28584>>>>>>>        Get NamedValueRemove NavigateData.NamedValues "Init_Mode" to NavigateData.NamedValues
28585>>>>>>>        Send SetNavigateData NavigateData
28586>>>>>>>        
28586>>>>>>>        // if a find error, reverse the navigation. We assume that navigating to a view with
28586>>>>>>>        // records that cannot be found should be reversed. 
28586>>>>>>>        If hoRefindError Begin
28588>>>>>>>            If (eInitMode = initStateReinitialize or eInitMode = initStateReinitializeTopView) Begin
28590>>>>>>>                Set pbNavReinitError to True
28591>>>>>>>                If (pbStateHashInvalidError(Host(Self))) Begin
28593>>>>>>>                    Error DFERR_WEBAPP_INVALID_URL_REC
28594>>>>>>>>
28594>>>>>>>                End
28594>>>>>>>>
28594>>>>>>>            End
28594>>>>>>>>
28594>>>>>>>            Else Begin
28595>>>>>>>                Send OnNavigateForwardRefindError hoRefindError eRefindError
28596>>>>>>>            End
28596>>>>>>>>
28596>>>>>>>        End
28596>>>>>>>>
28596>>>>>>>        Else Begin
28597>>>>>>>            Send OnNavigateForward NavigateData hoInvokingView hoInvokingObject    // Hook to modify the view before opening it 
28598>>>>>>>        End
28598>>>>>>>>
28598>>>>>>>        
28598>>>>>>>        //  We are done navigating now
28598>>>>>>>        Set pbNavigating to False
28599>>>>>>>        
28599>>>>>>>        // Update URL (check if still the topview, OnNavigateForward might have done a navigation)
28599>>>>>>>        Get TopViewHandle of (ViewStack(Self)) to hoTopView
28600>>>>>>>        If (eInitMode <> initStateReinitialize and hoTopView = Self) Begin 
28602>>>>>>>            Send UpdateStateHash (eInitMode = initStateReinitializeTopView or pbStateReplace(Self))
28603>>>>>>>                        
28603>>>>>>>            Send UpdatePageTitle
28604>>>>>>>        End
28604>>>>>>>>
28604>>>>>>>    End_Procedure
28605>>>>>>>    
28605>>>>>>>    
28605>>>>>>>    
28605>>>>>>>    // set ordering for a List. Do it here so any grid fills will use the right index.
28605>>>>>>>    // Let's do this before any finds occur on the new view
28605>>>>>>>    Procedure NavigateForwardPreFindInit tWebNavigateData NavigateData Handle hoInvokingObject
28607>>>>>>>        Integer eViewType
28607>>>>>>>        Get peViewType to eViewType
28608>>>>>>>        If (eViewType=vtSelect) Begin
28610>>>>>>>            Broadcast Recursive Send InitOrdering NavigateData hoInvokingObject
28612>>>>>>>        End
28612>>>>>>>>
28612>>>>>>>        Send OnNavigateForwardPreFindInit NavigateData hoInvokingObject
28613>>>>>>>    End_Procedure
28614>>>>>>>    
28614>>>>>>>    // This is called during NavigateForward after the automatic constraints have been applied but
28614>>>>>>>    // before the constraints have been rebuilt and any records have been found for the view.
28614>>>>>>>    // This primarily exists to give you a chance to apply any additional constraints for the view. You can
28614>>>>>>>    // also use this to set any finding properties such as piSortCol, etc.
28614>>>>>>>    // You should not use this to find DD records or fill the DDOs yourself - it won't work!
28614>>>>>>>    Procedure OnNavigateForwardPreFindInit  tWebNavigateData NavigateData Handle hoInvokingObject
28616>>>>>>>    End_Procedure
28617>>>>>>>    
28617>>>>>>>    // use to navigate to the start of the stack. If there is a default view it
28617>>>>>>>    // will navigate to there.
28617>>>>>>>    // if bUnconditional, do this without checking for changed states
28617>>>>>>>    Procedure NavigateBegin Handle hoInvokingObject Boolean bUnconditional
28619>>>>>>>        Boolean bOk
28619>>>>>>>        Handle hoTop hoDefault
28619>>>>>>>        
28619>>>>>>>        Get GetDefaultView of (Host(Self)) to hoDefault
28620>>>>>>>        
28620>>>>>>>        // reset the breadcrumb stack respecting the default view
28620>>>>>>>        Get Reset of (ViewStack(Self)) (hoDefault <> Self) bUnconditional to bOK
28621>>>>>>>        If (bOK) Begin
28623>>>>>>>            Send NavigateForward hoInvokingObject // note that we do not pass on the invoking object to preven the navigation logic from making wrong assumptions
28624>>>>>>>        End
28624>>>>>>>>
28624>>>>>>>    End_Procedure
28625>>>>>>>
28625>>>>>>>    // Send this to change the default caption that is shown for this view
28625>>>>>>>    // in a breadcrumb.
28625>>>>>>>    Procedure SetBreadcrumbCaption String sCaption
28627>>>>>>>        Send SetCaption of (ViewStack(Self)) Self sCaption
28628>>>>>>>    End_Procedure
28629>>>>>>>
28629>>>>>>>    // this gets the breadcrumb caption 
28629>>>>>>>    Function GetBreadcrumbCaption Returns String
28631>>>>>>>        String sCaption
28631>>>>>>>        Get GetCaption of (ViewStack(Self)) Self to sCaption
28632>>>>>>>        Function_Return sCaption
28633>>>>>>>    End_Function
28634>>>>>>>
28634>>>>>>>    // Send this to change the default caption that is shown for this view
28634>>>>>>>    // in a "heading". Typically used by a breadcrumb object when it is simply
28634>>>>>>>    // displaying a view heading rather than the entire breadcrumb.
28634>>>>>>>    Procedure SetHeaderCaption String sCaption
28636>>>>>>>        Send SetHeaderCaption of (ViewStack(Self)) Self sCaption
28637>>>>>>>        
28637>>>>>>>        Send UpdatePageTitle
28638>>>>>>>    End_Procedure
28639>>>>>>>
28639>>>>>>>    // this gets the breadcrumb heading scaption 
28639>>>>>>>    Function GetHeaderCaption Returns String
28641>>>>>>>        String sCaption
28641>>>>>>>        Get GetHeaderCaption of (ViewStack(Self)) Self to sCaption
28642>>>>>>>        Function_Return sCaption
28643>>>>>>>    End_Function
28644>>>>>>>
28644>>>>>>>    // if a view is changed, how do we close this?
28644>>>>>>>    // This uses peChangedViewAction and a corresponding
28644>>>>>>>    // Verify_Data_Loss_Msg / Verify_SaveClearCancel_msg to
28644>>>>>>>    // determine the action. Therefore setting the Verify_xxx_msg overrides
28644>>>>>>>    // the peChangedViewExitAction and force a non-verified abandoning of changes  
28644>>>>>>>    Function GetChangedViewExitAction Returns Integer
28646>>>>>>>        Integer iMsg eCloseAction
28646>>>>>>>        
28646>>>>>>>        Get peChangedViewExitAction to eCloseAction
28647>>>>>>>        If (eCloseAction=cveConfirmAbandonChanges) Begin
28649>>>>>>>            Get Verify_Data_Loss_Msg to iMsg
28650>>>>>>>            If (iMsg=0) Begin
28652>>>>>>>                Move cveAbandonChanges to eCloseAction
28653>>>>>>>            End
28653>>>>>>>>
28653>>>>>>>        End
28653>>>>>>>>
28653>>>>>>>        Else If (eCloseAction=cveConfirmSaveClearCancel) Begin
28656>>>>>>>            Get Verify_SaveClearCancel_msg to iMsg
28657>>>>>>>            If (iMsg=0) Begin
28659>>>>>>>                Move cveAbandonChanges to eCloseAction
28660>>>>>>>            End
28660>>>>>>>>
28660>>>>>>>        End
28660>>>>>>>>
28660>>>>>>>        Function_Return eCloseAction
28661>>>>>>>    End_Function
28662>>>>>>>    
28662>>>>>>>
28662>>>>>>>    // Callback message in response to VerifyRequest Callback. Called via NavigateClose, 
28662>>>>>>>    // do not call this directly.
28662>>>>>>>    // This is used for Yes/No verifies
28662>>>>>>>    Procedure NavigateClose_Callback Integer eConfirmMode
28664>>>>>>>        If (eConfirmMode = cmYes) Begin
28666>>>>>>>            Send NavigateCloseExec False // means close no save
28667>>>>>>>        End
28667>>>>>>>>
28667>>>>>>>    End_Procedure
28668>>>>>>>
28668>>>>>>>    // This is used for Yes/No/Cancel verifies (Save, Clear, Cancel)
28668>>>>>>>    Procedure NavigateCloseYNC_Callback Integer eConfirmMode
28670>>>>>>>        If (eConfirmMode = cmYes) Begin
28672>>>>>>>            Send NavigateCloseExec True
28673>>>>>>>        End
28673>>>>>>>>
28673>>>>>>>        Else If (eConfirmMode = cmNo) Begin
28676>>>>>>>            Send NavigateCloseExec False // means close no save
28677>>>>>>>        End
28677>>>>>>>>
28677>>>>>>>    End_Procedure
28678>>>>>>>    
28678>>>>>>>
28678>>>>>>>    // If a view is the current top view, you can send this message to it
28678>>>>>>>    // to close the view. If there is a view underneath in the view stack
28678>>>>>>>    // then it will be passed back navigation data from the callback object.
28678>>>>>>>    // This control must understand the GetNavigateBackData callback message.
28678>>>>>>>    // 
28678>>>>>>>    // If there is no special data to pass back to the view underneath in 
28678>>>>>>>    // the view stack then you should call NavigateCancel.
28678>>>>>>>    Procedure NavigateClose Handle hoCallback
28680>>>>>>>        Handle hoView
28680>>>>>>>        Get InvokingViewHandle of (ViewStack(Self)) to hoView
28681>>>>>>>        Send NavigateCloseTo hoView hoCallback
28682>>>>>>>    End_Procedure
28683>>>>>>>
28683>>>>>>>    // NavigateCloseTo is passed the view to return to. Normally NavigateClose is used and this is for more
28683>>>>>>>    // advanced usage when closing several views but wanting to return a value to the view
28683>>>>>>>    // 1. When multi-level closes are used the navigateFrom type is always changed to nfUndefined meaning you must
28683>>>>>>>    //    handle the update yourself.
28683>>>>>>>    // 2. We only check for data-loss changes in the top view. If there are changes in views in between this and the destination
28683>>>>>>>    //    view, they are lost.
28683>>>>>>>    // Use this with care.
28683>>>>>>>    Procedure NavigateCloseTo Handle hoView Handle hoCallback
28685>>>>>>>        Handle hoMainDD
28685>>>>>>>        Boolean bCanPopView bChanged 
28685>>>>>>>        Integer eCloseAction iIndex
28685>>>>>>>        String sReason sNavigateDataCallbackObj sInvokingView
28685>>>>>>>        Integer eWebViewStyle
28685>>>>>>>
28685>>>>>>>        Get peWebViewStyle to eWebViewStyle
28686>>>>>>>        If (eWebViewStyle = wvsDesktop) Begin
28688>>>>>>>            Error DFERR_PROGRAM "Can't navigate back with a non-drill down view"
28689>>>>>>>>
28689>>>>>>>            Procedure_Return
28690>>>>>>>        End            
28690>>>>>>>>
28690>>>>>>>
28690>>>>>>>
28690>>>>>>>        If hoView Begin
28692>>>>>>>            Get GetViewIndex of (ViewStack(Self)) hoView to iIndex
28693>>>>>>>            If (iIndex=-1) Begin
28695>>>>>>>                Error DFERR_PROGRAM "Target view not in view stack"
28696>>>>>>>>
28696>>>>>>>                Procedure_Return
28697>>>>>>>            End
28697>>>>>>>>
28697>>>>>>>            Get WebObjectName of hoView to sInvokingView
28698>>>>>>>        End
28698>>>>>>>>
28698>>>>>>>        WebSet psNavigateBackView to sInvokingView
28699>>>>>>>        
28699>>>>>>>        Get WebObjectName of hoCallback to sNavigateDataCallbackObj
28700>>>>>>>        WebSet psNavigateDataCallbackObj to sNavigateDataCallbackObj
28701>>>>>>>
28701>>>>>>>        Get CanPopView of (ViewStack(Self)) Self (&sReason) to bCanPopView
28702>>>>>>>        
28702>>>>>>>        If (bCanPopView) Begin
28704>>>>>>>            Get IsViewChanged to bChanged
28705>>>>>>>            
28705>>>>>>>            If bChanged Begin
28707>>>>>>>                Get GetChangedViewExitAction to eCloseAction
28708>>>>>>>                If (eCloseAction=cveConfirmAbandonChanges) Begin
28710>>>>>>>                    Send VerifyRequest (RefProc(NavigateClose_Callback)) (RefFunc(Verify_Data_Loss_msg))
28711>>>>>>>                End
28711>>>>>>>>
28711>>>>>>>                Else If (eCloseAction=cveConfirmSaveClearCancel) Begin
28714>>>>>>>                    Send VerifyRequest (RefProc(NavigateCloseYNC_Callback)) (RefFunc(Verify_SaveClearCancel_msg))
28715>>>>>>>                End
28715>>>>>>>>
28715>>>>>>>                Else If (eCloseAction=cveSave) Begin
28718>>>>>>>                    Send NavigateCloseExec True
28719>>>>>>>                End
28719>>>>>>>>
28719>>>>>>>                Else Begin
28720>>>>>>>                    Send NavigateCloseExec False
28721>>>>>>>                End
28721>>>>>>>>
28721>>>>>>>            End
28721>>>>>>>>
28721>>>>>>>            Else Begin            
28722>>>>>>>                Send NavigateCloseExec False
28723>>>>>>>            End
28723>>>>>>>>
28723>>>>>>>        End
28723>>>>>>>>
28723>>>>>>>        Else Begin
28724>>>>>>>            Error DFERR_PROGRAM ("View stack Navigate error: " + sReason)
28725>>>>>>>>
28725>>>>>>>        End
28725>>>>>>>>
28725>>>>>>>    End_Procedure
28726>>>>>>>    
28726>>>>>>>    // This actually performs the Navigate Close operation. This will close the current
28726>>>>>>>    // view and pop the view stack without returning any data to the invoking view.
28726>>>>>>>    // This operates like a cancel. All data loss checking and confirmation has already
28726>>>>>>>    // been performed before we get here.
28726>>>>>>>    //
28726>>>>>>>    // Called via NavigateCloseTo, do not call this directly.
28726>>>>>>>    Procedure NavigateCloseExec Boolean bSave
28728>>>>>>>        Handle hoView hoCallback
28728>>>>>>>        String sNavigateDataCallbackObj sView
28728>>>>>>>        Boolean bErr
28728>>>>>>>        
28728>>>>>>>        If bSave Begin
28730>>>>>>>           Get SaveViewExec to bErr            
28731>>>>>>>           If bErr ;            Procedure_Return 
28734>>>>>>>        End
28734>>>>>>>>
28734>>>>>>>        
28734>>>>>>>        WebGet psNavigateBackView to sView   // handle to the new top of view
28735>>>>>>>        If (Trim(sView) <> "") Begin
28737>>>>>>>            Get FindWebObject of (Owner(Self)) sView to hoView
28738>>>>>>>            WebGet psNavigateDataCallbackObj to sNavigateDataCallbackObj
28739>>>>>>>            If (sNavigateDataCallbackObj<>"") Begin
28741>>>>>>>                Get WebObjectByName sNavigateDataCallbackObj to hoCallback
28742>>>>>>>            End
28742>>>>>>>>
28742>>>>>>>            Send NavigateBackToHere of hoView False (If(hoCallback, hoCallback, Self))
28743>>>>>>>        End
28743>>>>>>>>
28743>>>>>>>        Else Begin
28744>>>>>>>            Send Hide   // If the view stack is empty, just hide this view
28745>>>>>>>        End
28745>>>>>>>>
28745>>>>>>>    End_Procedure
28746>>>>>>>
28746>>>>>>>    // this attempts a save and returns True if it failed.
28746>>>>>>>    // There should be no confirmation messages at this point.
28746>>>>>>>    // Unlike RequestSaveExec, this has to attempt a save at the view level.
28746>>>>>>>    // Currently it just saves the view's Server, which may not always be enough if
28746>>>>>>>    // have sub-DD like detail lines.
28746>>>>>>>    Function SaveViewExec Returns Boolean
28748>>>>>>>        Handle hoServer
28748>>>>>>>        Integer iRetVal
28748>>>>>>>        Boolean bRequestValidateAll bErr
28748>>>>>>>        Get Server to hoServer
28749>>>>>>>        If hoServer Begin
28751>>>>>>>            Get pbRequesteValidateAll to bRequestValidateAll
28752>>>>>>>            If bRequestValidateAll Begin
28754>>>>>>>                Get Request_Validate_All of hoServer to iRetVal
28755>>>>>>>            End
28755>>>>>>>>
28755>>>>>>>            Else Begin
28756>>>>>>>                Get Request_Validate of hoServer to iRetVal
28757>>>>>>>            End
28757>>>>>>>>
28757>>>>>>>            If (iRetVal=0) Begin
28759>>>>>>>                Move False to Err
28760>>>>>>>                Send Request_Save to hoServer
28761>>>>>>>                Move Err to iRetVal
28762>>>>>>>            End
28762>>>>>>>>
28762>>>>>>>        End
28762>>>>>>>>
28762>>>>>>>        Function_Return iRetVal
28763>>>>>>>    End_Function
28764>>>>>>>
28764>>>>>>>    // Save before navigate forward to some other view. Return 0 if ok.
28764>>>>>>>    // Upon completion a saved record must exist, else return non zero
28764>>>>>>>    Function SaveViewBeforeNavigate Returns Boolean
28766>>>>>>>        Handle hoServer
28766>>>>>>>        Boolean bChanged bErr bHasRec
28766>>>>>>>        Get Server to hoServer
28767>>>>>>>        Get IsViewChanged to bChanged
28768>>>>>>>        
28768>>>>>>>        If (bChanged) Begin
28770>>>>>>>           Get SaveViewExec to bErr
28771>>>>>>>        End
28771>>>>>>>>
28771>>>>>>>        Else Begin
28772>>>>>>>            // if nothing to save but a new record, we will attempt validation and save anyway. Most
28772>>>>>>>            // likely this will raise a validation error providing the user feedback that they cannot
28772>>>>>>>            // navigate forward without a valid save
28772>>>>>>>            If (hoServer) Begin
28774>>>>>>>                Get HasRecord of hoServer to bHasRec
28775>>>>>>>                If not bHasRec Begin
28777>>>>>>>                    Get SaveViewExec to bErr
28778>>>>>>>                End
28778>>>>>>>>
28778>>>>>>>            End
28778>>>>>>>>
28778>>>>>>>        End
28778>>>>>>>>
28778>>>>>>>        Function_Return bErr
28779>>>>>>>    End_Function
28780>>>>>>>
28780>>>>>>>
28780>>>>>>>    // Callback message in response to VerifyRequest Callback. Called via NavigateClose, 
28780>>>>>>>    // do not call this directly.
28780>>>>>>>    // This is used for Yes/No verifies
28780>>>>>>>    Procedure NavigateCancel_Callback Integer eConfirmMode
28782>>>>>>>        If (eConfirmMode = cmYes) Begin
28784>>>>>>>            Send NavigateCancelExec False
28785>>>>>>>        End
28785>>>>>>>>
28785>>>>>>>    End_Procedure
28786>>>>>>>
28786>>>>>>>    // This is used for Yes/No/Cancel verifies (Save, Clear, Cancel)
28786>>>>>>>    Procedure NavigateCancelYNC_Callback Integer eConfirmMode
28788>>>>>>>        If (eConfirmMode = cmYes) Begin
28790>>>>>>>            Send NavigateCancelExec True
28791>>>>>>>        End
28791>>>>>>>>
28791>>>>>>>        Else If (eConfirmMode = cmNo) Begin
28794>>>>>>>            Send NavigateCancelExec False // means close no save
28795>>>>>>>        End
28795>>>>>>>>
28795>>>>>>>    End_Procedure
28796>>>>>>>    
28796>>>>>>>
28796>>>>>>>    // If a view is the current top view, you can send this message to it
28796>>>>>>>    // to close the view. Typically this message is sent to a view by a 
28796>>>>>>>    // Cancel on the view.
28796>>>>>>>    Procedure NavigateCancel 
28798>>>>>>>        Handle hoView
28798>>>>>>>        Get InvokingViewHandle of (ViewStack(Self)) to hoView
28799>>>>>>>        Send NavigateCancelTo hoView
28800>>>>>>>    End_Procedure
28801>>>>>>>    
28801>>>>>>>    // If a view is the current top view, you can send this message to it
28801>>>>>>>    // to close the view and navigate down to the passed view. Typically this message is sent to
28801>>>>>>>    // a view by a breacrumb navigate back action
28801>>>>>>>    Procedure NavigateCancelTo Handle hoView
28803>>>>>>>        Boolean bCanPopView bChanged  bOk
28803>>>>>>>        Integer eCloseAction
28803>>>>>>>        String sReason sInvokingView
28803>>>>>>>        Integer eWebViewStyle iIndex
28803>>>>>>>
28803>>>>>>>        Get peWebViewStyle to eWebViewStyle
28804>>>>>>>        If (eWebViewStyle = wvsDesktop) Begin
28806>>>>>>>            Error DFERR_PROGRAM "Can't navigate back with a non-drill down view"
28807>>>>>>>>
28807>>>>>>>            Procedure_Return
28808>>>>>>>        End            
28808>>>>>>>>
28808>>>>>>>        
28808>>>>>>>        If hoView Begin
28810>>>>>>>            Get GetViewIndex of (ViewStack(Self)) hoView to iIndex
28811>>>>>>>            If (iIndex=-1) Begin
28813>>>>>>>                Error DFERR_PROGRAM "Target view not in view stack"
28814>>>>>>>>
28814>>>>>>>                Procedure_Return
28815>>>>>>>            End
28815>>>>>>>>
28815>>>>>>>            Get WebObjectName of hoView to sInvokingView
28816>>>>>>>        End
28816>>>>>>>>
28816>>>>>>>        WebSet psNavigateBackView to sInvokingView
28817>>>>>>>        
28817>>>>>>>        Get CanPopView of (ViewStack(Self)) Self (&sReason) to bCanPopView
28818>>>>>>>        
28818>>>>>>>        If (bCanPopView) Begin
28820>>>>>>>            
28820>>>>>>>            // Set the callback object that will be used by NavigateCloseExec
28820>>>>>>>            Get IsViewChanged to bChanged
28821>>>>>>>            If bChanged Begin
28823>>>>>>>                Get GetChangedViewExitAction to eCloseAction
28824>>>>>>>                If (eCloseAction=cveConfirmAbandonChanges) Begin
28826>>>>>>>                    Send VerifyRequest (RefProc(NavigateCancel_Callback)) (RefFunc(Verify_Data_Loss_msg))
28827>>>>>>>                End
28827>>>>>>>>
28827>>>>>>>                Else If (eCloseAction=cveConfirmSaveClearCancel) Begin
28830>>>>>>>                    Send VerifyRequest (RefProc(NavigateCancelYNC_Callback)) (RefFunc(Verify_SaveClearCancel_msg))
28831>>>>>>>                End
28831>>>>>>>>
28831>>>>>>>                Else If (eCloseAction=cveSave) Begin
28834>>>>>>>                    Send NavigateCancelExec True
28835>>>>>>>                End
28835>>>>>>>>
28835>>>>>>>                Else Begin
28836>>>>>>>                    Send NavigateCancelExec False
28837>>>>>>>                End
28837>>>>>>>>
28837>>>>>>>            End
28837>>>>>>>>
28837>>>>>>>            Else Begin            
28838>>>>>>>                Send NavigateCancelExec False
28839>>>>>>>            End
28839>>>>>>>>
28839>>>>>>>        End
28839>>>>>>>>
28839>>>>>>>        Else Begin
28840>>>>>>>            Error DFERR_PROGRAM ("View stack Navigate error: " + sReason)
28841>>>>>>>>
28841>>>>>>>        End
28841>>>>>>>>
28841>>>>>>>    End_Procedure
28842>>>>>>>
28842>>>>>>>    
28842>>>>>>>    // This actually performs the Navigate Close operation. This will close the current
28842>>>>>>>    // view and pop the view stack without returning any data to the invoking view.
28842>>>>>>>    // This operates like a cancel. All data loss checking and confirmation has already
28842>>>>>>>    // been performed before we get here.
28842>>>>>>>    //
28842>>>>>>>    // Called via NavigateCancel, do not call this directly.
28842>>>>>>>    Procedure NavigateCancelExec Boolean bSave
28844>>>>>>>        Handle hoView hoCallback
28844>>>>>>>        Boolean bErr
28844>>>>>>>        String sView
28844>>>>>>>
28844>>>>>>>        If bSave Begin
28846>>>>>>>           Get SaveViewExec to bErr            
28847>>>>>>>           If bErr ;            Procedure_Return
28850>>>>>>>           // If save was successful treat this as a close and not a cancel
28850>>>>>>>           Send NavigateCloseExec False 
28851>>>>>>>           Procedure_Return
28852>>>>>>>        End
28852>>>>>>>>
28852>>>>>>>
28852>>>>>>>//        // Navigate to the next view down in the view stack
28852>>>>>>>//        Send PopView to (ViewStack(Self))                  // removes this view
28852>>>>>>>//        Get TopViewHandle of (ViewStack(Self)) to hoView   // handle to the new top of view
28852>>>>>>>        WebGet psNavigateBackView to sView   // handle to the new top of view
28853>>>>>>>
28853>>>>>>>        If (Trim(sView) <> "") Begin
28855>>>>>>>            Get FindWebObject of (Owner(Self)) sView to hoView
28856>>>>>>>            Send NavigateBackToHere of hoView True 0
28857>>>>>>>        End
28857>>>>>>>>
28857>>>>>>>        Else Begin
28858>>>>>>>            Send Hide   // If the view stack is empty, just hide this view
28859>>>>>>>        End
28859>>>>>>>>
28859>>>>>>>    End_Procedure
28860>>>>>>>
28860>>>>>>>    // Loads default data for NavigateData for NavigateForward.
28860>>>>>>>    // This must be executed from the point of view
28860>>>>>>>    // of the invoking object, which is the object that calls this.
28860>>>>>>>    Procedure LoadDefaultNavigateForwardData Handle hoInvokIngObject tWebNavigateData ByRef NavigateData
28862>>>>>>>        Integer iFile iField
28862>>>>>>>        String sValue
28862>>>>>>>        Handle hoServer hoDDO
28862>>>>>>>        Boolean bChanged bDataBindable
28862>>>>>>>        RowID ri
28862>>>>>>>        
28862>>>>>>>        // step Populate the Navigate Data struct with the best guess values from
28862>>>>>>>        // this control's server DDO.
28862>>>>>>>        // If this is called from outside a view, like a main menu, this should
28862>>>>>>>        // delegate to cWebApp and return 0.
28862>>>>>>>        Get Server of hoInvokIngObject to hoServer
28863>>>>>>>        
28863>>>>>>>        If (hoServer) Begin
28865>>>>>>>            Get pbDataBindable of hoInvokIngObject to bDataBindable
28866>>>>>>>            Get Main_File of hoServer to iFile
28867>>>>>>>            
28867>>>>>>>            If (NavigateData.eNavigateType=nfFromParent) Begin
28869>>>>>>>
28869>>>>>>>                // Assertion: Check that the constraining table is set properly
28869>>>>>>>                If (iFile<>NavigateData.iTable) Begin
28871>>>>>>>                    Error DFERR_PROGRAM "Assert: Bad NavigateData for fromParent"
28872>>>>>>>>
28872>>>>>>>                    Procedure_Return
28873>>>>>>>                End
28873>>>>>>>>
28873>>>>>>>
28873>>>>>>>                Get CurrentRowId of hoServer to ri
28874>>>>>>>                Move (SerializeRowID(ri)) to NavigateData.sRowID 
28875>>>>>>>            End
28875>>>>>>>>
28875>>>>>>>            Else If (NavigateData.eNavigateType=nfFromChild or NavigateData.eNavigateType=nfFromMain) Begin
28878>>>>>>>
28878>>>>>>>                // Assertion: Check that the table is set properly for a from main
28878>>>>>>>                If (NavigateData.eNavigateType=nfFromMain and NavigateData.iTable<>iFile) Begin
28880>>>>>>>                    // With the NavigateInitialize logic we don't always have the right invoking object where this is not an error but something we want to correct
28880>>>>>>>                    Move NavigateData.iTable to iFile
28881>>>>>>>//                    Error DFERR_PROGRAM "Assert: Bad NavigateData for fromMain"
28881>>>>>>>//                    Procedure_Return
28881>>>>>>>                End
28881>>>>>>>>
28881>>>>>>>                // Assertion: Check that the table is set properly for a from child
28881>>>>>>>                If (NavigateData.eNavigateType=nfFromChild and (NavigateData.iTable=0 or NavigateData.iTable=iFile)) Begin
28883>>>>>>>                    Error DFERR_PROGRAM "Assert: Bad NavigateData for fromChild"
28884>>>>>>>>
28884>>>>>>>                    Procedure_Return
28885>>>>>>>                End
28885>>>>>>>>
28885>>>>>>>
28885>>>>>>>                // use the DDO that owns the file 
28885>>>>>>>                Get Data_Set of hoServer NavigateData.iTable to hoDDO
28886>>>>>>>                If hoDDO Begin
28888>>>>>>>                    Get CurrentRowId of hoDDO to ri
28889>>>>>>>                    If (bDataBindable) Begin
28891>>>>>>>                        Get Data_File of hoInvokIngObject  to iFile
28892>>>>>>>                        If (iFile=NavigateData.iTable) Begin
28894>>>>>>>                            Get Data_Field of hoInvokIngObject to iField
28895>>>>>>>                            Move iField to NavigateData.iColumn
28896>>>>>>>                            WebGet pbChanged of hoInvokIngObject to bChanged
28897>>>>>>>                            // if changed we will do item_find (read) to seed this
28897>>>>>>>                            If bChanged Begin
28899>>>>>>>                                // note this deferred (a DDO read)
28899>>>>>>>                                Send Item_Find of hoServer GE iFile iField True False True
28900>>>>>>>                                Move (GetRowID(iFile)) to ri
28901>>>>>>>                            End
28901>>>>>>>>
28901>>>>>>>                        End
28901>>>>>>>>
28901>>>>>>>                    End
28901>>>>>>>>
28901>>>>>>>                    Move (SerializeRowID(ri)) to NavigateData.sRowID    // Store the resulting RowID
28902>>>>>>>                End
28902>>>>>>>>
28902>>>>>>>            End
28902>>>>>>>>
28902>>>>>>>            // If undefined we provide no extra information. Trying to guess what the developer wants
28902>>>>>>>            // to do will just make things too confusing. Use OnGetNavigateForwardData to set whatever you want 
28902>>>>>>>        End
28902>>>>>>>>
28902>>>>>>>    End_Procedure
28903>>>>>>>    
28903>>>>>>>    // loads default data for NavigateData for a NavigateClose
28903>>>>>>>    // This must be executed from the point of view
28903>>>>>>>    // of the invoking object, which is the object that calls this.
28903>>>>>>>    
28903>>>>>>>    Procedure LoadDefaultNavigateBackData Handle hoInvokingObject tWebNavigateData ByRef NavigateData
28905>>>>>>>        Integer iFile iField
28905>>>>>>>        Handle hoServer
28905>>>>>>>        Boolean bChanged bDataBindable
28905>>>>>>>        RowID ri
28905>>>>>>>        
28905>>>>>>>        // Populate the Navigate Data struct with the best guess values from
28905>>>>>>>        // this control's server DDO
28905>>>>>>>        // If this is called from outside a view, like a main menu, this should
28905>>>>>>>        // delegate to cWebApp and return 0.
28905>>>>>>>        Get Server of hoInvokingObject to hoServer
28906>>>>>>>        If (hoServer) Begin
28908>>>>>>>            Get pbDataBindable of hoInvokingObject to bDataBindable
28909>>>>>>>            Get CurrentRowId of hoServer to ri
28910>>>>>>>            Move (SerializeRowID(ri)) to NavigateData.sRowID 
28911>>>>>>>            Get Main_File of hoServer to NavigateData.iTable
28912>>>>>>>            
28912>>>>>>>            If (bDataBindable) Begin
28914>>>>>>>                Get Data_File of hoInvokingObject  to iFile
28915>>>>>>>                Get Data_Field of hoInvokingObject to iField
28916>>>>>>>                
28916>>>>>>>                Move iFile  to NavigateData.iTable
28917>>>>>>>                Move iField to NavigateData.iColumn
28918>>>>>>>            End
28918>>>>>>>>
28918>>>>>>>        End
28918>>>>>>>>
28918>>>>>>>    
28918>>>>>>>    End_Procedure
28919>>>>>>>    
28919>>>>>>>    
28919>>>>>>>    // Triggers an update of the state hash and pushes it to the history stack.
28919>>>>>>>    //
28919>>>>>>>    // Params:
28919>>>>>>>    //      bReplace    If true the new state will replace the existing state instead of pushing a 
28919>>>>>>>    //                  new history item.
28919>>>>>>>    Procedure UpdateStateHash Boolean bReplace
28921>>>>>>>        String sPrevHash sStateHash
28921>>>>>>>        
28921>>>>>>>        If (peApplicationStateMode(Host(Self)) <> asmOff) Begin
28923>>>>>>>            Get GenerateStateHash to sStateHash
28924>>>>>>>
28924>>>>>>>            If (bReplace) Begin
28926>>>>>>>                Get StateHash of (Host(Self)) to sPrevHash
28927>>>>>>>                If (sStateHash <> sPrevHash) Begin
28929>>>>>>>                    Send SetStateHash of (Host(Self)) sStateHash "" True
28930>>>>>>>                End
28930>>>>>>>>
28930>>>>>>>            End
28930>>>>>>>>
28930>>>>>>>            Else Begin
28931>>>>>>>                Send SetStateHash of (Host(Self)) sStateHash "" False
28932>>>>>>>            End
28932>>>>>>>>
28932>>>>>>>        End
28932>>>>>>>>
28932>>>>>>>    End_Procedure
28933>>>>>>>    
28933>>>>>>>    
28933>>>>>>>    // Triggered when a state hash is defined allowing the application to add a custom piece to the
28933>>>>>>>    // hash. This piece can be used inside OnShow / OnLoad / OnNavigateForward to restore the state.
28933>>>>>>>    //
28933>>>>>>>    // Params:
28933>>>>>>>    //      ByRef sStateHash    String that should be filled with the custom hash.
28933>>>>>>>    Procedure OnDefineCustomStateHash String ByRef sStateHash
28935>>>>>>>    End_Procedure
28936>>>>>>>    
28936>>>>>>>    
28936>>>>>>>    // Determines the custom state hash by parsing it out of the view state hash. The view state
28936>>>>>>>    // has is retrieved form the navigation data or read directly from the url.
28936>>>>>>>    //
28936>>>>>>>    // Returns:
28936>>>>>>>    //      Custom state hash.
28936>>>>>>>    Function CustomStateHash Returns String
28938>>>>>>>        Integer eViewStyle
28938>>>>>>>        String sStateHash sView sRecordId sCustomHash
28938>>>>>>>        tWebNavigateData navData
28938>>>>>>>        tWebNavigateData navData
28938>>>>>>>        
28938>>>>>>>        Get peWebViewStyle to eViewStyle
28939>>>>>>>        
28939>>>>>>>        If (eViewStyle = wvsDesktop) Begin
28941>>>>>>>            Get StateHash of (Host(Self)) to sStateHash
28942>>>>>>>        End
28942>>>>>>>>
28942>>>>>>>        Else If (eViewStyle = wvsDrillDown or eViewStyle = wvsDialog) Begin
28945>>>>>>>            Get GetNavigateData to navData
28946>>>>>>>            Get NamedValueGet navData.NamedValues "Init_StateHash" to sStateHash
28947>>>>>>>        End
28947>>>>>>>>
28947>>>>>>>        
28947>>>>>>>        Send ParseViewStateHash of (Host(Self)) sStateHash (&sView) (&sRecordId) (&sCustomHash)
28948>>>>>>>        
28948>>>>>>>        Function_Return sCustomHash
28949>>>>>>>    End_Function
28950>>>>>>>    
28950>>>>>>>    
28950>>>>>>>    // Converts a record id from a hash for a specific table into a rowid. By default it offloads
28950>>>>>>>    // this to RecordIdToRowId of the Data Dictionary.
28950>>>>>>>    //
28950>>>>>>>    // Params:
28950>>>>>>>    //      iFile       File number.
28950>>>>>>>    //      sRecordId   String representing the record id.
28950>>>>>>>    //      rRowId      (ByRef) Filled with the rowid by this function.
28950>>>>>>>    // Returns:
28950>>>>>>>    //      True if the record id is valid.
28950>>>>>>>    Function HashRecordIdToRowId Integer iFile String sRecordId RowID ByRef rRowId Returns Boolean
28952>>>>>>>        Handle hoMainDD hoDD
28952>>>>>>>        Boolean bFound
28952>>>>>>>        
28952>>>>>>>        Move True to bFound
28953>>>>>>>        
28953>>>>>>>        Get Main_DD to hoMainDD
28954>>>>>>>        If (hoMainDD > 0) Begin
28956>>>>>>>            Get Data_Set of hoMainDD iFile to hoDD
28957>>>>>>>            
28957>>>>>>>            If (hoDD > 0) Begin
28959>>>>>>>                If (Lowercase(sRecordId) <> (Lowercase(psStateNewRecordId(Self)))) Begin
28961>>>>>>>                    Get RecordIdToRowId of hoDD sRecordId (&rRowId) to bFound
28962>>>>>>>                End
28962>>>>>>>>
28962>>>>>>>            End
28962>>>>>>>>
28962>>>>>>>        End
28962>>>>>>>>
28962>>>>>>>        
28962>>>>>>>        Function_Return bFound
28963>>>>>>>    End_Function
28964>>>>>>>    
28964>>>>>>>    
28964>>>>>>>    // Converts a rowid into a state hash record id (a readable format). By default this is
28964>>>>>>>    // offloaded to the Data Dictionary RowIdToRecordId logic that works on the primary key.
28964>>>>>>>    //
28964>>>>>>>    // Params:
28964>>>>>>>    //      iFile       File number.
28964>>>>>>>    //      sRowId      Serialized rowid.
28964>>>>>>>    // Returns:
28964>>>>>>>    //      Record id.
28964>>>>>>>    Function GenerateStateHashRecordId Integer iFile RowID rRowId Returns String
28966>>>>>>>        Handle hoMainDD hoDD
28966>>>>>>>        String sRecordId
28966>>>>>>>        
28966>>>>>>>        
28966>>>>>>>        Get Main_DD to hoMainDD
28967>>>>>>>        If (hoMainDD > 0) Begin
28969>>>>>>>            Get Data_Set of hoMainDD iFile to hoDD
28970>>>>>>>            
28970>>>>>>>            If (hoDD > 0) Begin
28972>>>>>>>                If (IsNullRowID(rRowId)) Begin
28974>>>>>>>                    Move (psStateNewRecordId(Self)) to sRecordId
28975>>>>>>>                End
28975>>>>>>>>
28975>>>>>>>                Else Begin
28976>>>>>>>                    Get RowIdToRecordId of hoDD rRowId to sRecordId
28977>>>>>>>                End
28977>>>>>>>>
28977>>>>>>>            End
28977>>>>>>>>
28977>>>>>>>        End
28977>>>>>>>>
28977>>>>>>>        
28977>>>>>>>        Function_Return sRecordId
28978>>>>>>>    End_Function
28979>>>>>>>    
28979>>>>>>>    
28979>>>>>>>    // Generates the view state hash for the drill-down model. Recursively calls its invoking view
28979>>>>>>>    // (if it is in sync) to get the entire view stack in the hash.
28979>>>>>>>    //
28979>>>>>>>    // Returns:
28979>>>>>>>    //      View state hash including hashes of invoking views.
28979>>>>>>>    Function GenerateStateHash_DrillDown Returns String
28981>>>>>>>        String sInvokingHash sViewHash sHash sName sId sCustom sRowId
28981>>>>>>>        Boolean bInScope
28981>>>>>>>        Handle hoInvokingView hoDefault hoMain hoInvokingObject
28981>>>>>>>        tWebNavigateData navData
28981>>>>>>>        tWebNavigateData navData
28981>>>>>>>        Integer eViewType eStateMode
28981>>>>>>>        RowID rRowId
28981>>>>>>>        
28981>>>>>>>        Get InvokingViewHandleByView of (ViewStack(Self)) Self to hoInvokingView
28982>>>>>>>        Get peStateMode to eStateMode
28983>>>>>>>        Get GetDefaultView of (Host(Self)) to hoDefault
28984>>>>>>>        
28984>>>>>>>        
28984>>>>>>>        If (eStateMode <> vsmOff) Begin
28986>>>>>>>            Get peViewType to eViewType
28987>>>>>>>            
28987>>>>>>>            
28987>>>>>>>            //  For zoom views or record views we look at the main DD
28987>>>>>>>            If (eStateMode = vsmRecord or (eViewType = vtZoom and eStateMode = vsmDefault)) Begin
28989>>>>>>>                Get Main_DD to hoMain
28990>>>>>>>                
28990>>>>>>>                If (hoMain > 0) Begin
28992>>>>>>>                    Get CurrentRowId of hoMain to rRowId
28993>>>>>>>                    
28993>>>>>>>                    Get GenerateStateHashRecordId (Main_File(hoMain)) rRowId to sId
28994>>>>>>>                End
28994>>>>>>>>
28994>>>>>>>            End
28994>>>>>>>>
28994>>>>>>>            Else If (eStateMode = vsmDefault) Begin
28997>>>>>>>                //  For other views we we look at the navigation data (if eStatEMode is default)
28997>>>>>>>                Get GetNavigateData to navData
28998>>>>>>>                
28998>>>>>>>                Case Begin
28998>>>>>>>                    Case (navData.eNavigateType = nfFromParent)
29000>>>>>>>                    Case (navData.eNavigateType = nfFromChild)
29003>>>>>>>                    Case (navData.eNavigateType = nfFromMain) 
29006>>>>>>>                        If (hoInvokingView = C_WebUnresolvedObject) Begin
29008>>>>>>>                            Function_Return ""
29009>>>>>>>                        End
29009>>>>>>>>
29009>>>>>>>                        
29009>>>>>>>                        If (navData.bNewRecord) Begin
29011>>>>>>>                            Move "" to sId    
29012>>>>>>>                        End
29012>>>>>>>>
29012>>>>>>>                        Else Begin
29013>>>>>>>                            Move navData.sRowID to sRowId
29014>>>>>>>                        End
29014>>>>>>>>
29014>>>>>>>                        
29014>>>>>>>                        Get GenerateStateHashRecordId of hoInvokingView navData.iTable (DeserializeRowID(sRowId)) to sId
29015>>>>>>>                        
29015>>>>>>>                        Case Break
29016>>>>>>>                Case End
29016>>>>>>>            End
29016>>>>>>>>
29016>>>>>>>        
29016>>>>>>>            Get GetInvokingObject to hoInvokingObject
29017>>>>>>>            Get StateHashKey hoInvokingObject to sName
29018>>>>>>>            
29018>>>>>>>            If (sName <> "") Begin
29020>>>>>>>                Send OnDefineCustomStateHash (&sCustom)
29021>>>>>>>            
29021>>>>>>>                Get ConcatViewStateHash of (Host(Self)) sName sId sCustom to sViewHash
29022>>>>>>>            End
29022>>>>>>>>
29022>>>>>>>        End
29022>>>>>>>>
29022>>>>>>>        
29022>>>>>>>        If (hoInvokingView <> C_WebUnresolvedObject) Begin
29024>>>>>>>            Get IsInCallActionScope of hoInvokingView to bInScope
29025>>>>>>>            If (bInScope) Begin
29027>>>>>>>                Get GenerateStateHash_DrillDown of hoInvokingView to sInvokingHash
29028>>>>>>>                WebSet psInvokingStateHash to sInvokingHash
29029>>>>>>>            End
29029>>>>>>>>
29029>>>>>>>            Else Begin
29030>>>>>>>                WebGet psInvokingStateHash to sInvokingHash 
29031>>>>>>>            End
29031>>>>>>>>
29031>>>>>>>            
29031>>>>>>>        End
29031>>>>>>>>
29031>>>>>>>        
29031>>>>>>>        If (eStateMode <> vsmOff) Begin
29033>>>>>>>            Get AppendStateHash of (Host(Self)) sInvokingHash sViewHash to sHash
29034>>>>>>>        End
29034>>>>>>>>
29034>>>>>>>        Else Begin
29035>>>>>>>            Move sInvokingHash to sHash
29036>>>>>>>        End
29036>>>>>>>>
29036>>>>>>>        
29036>>>>>>>        Function_Return sHash
29037>>>>>>>    End_Function

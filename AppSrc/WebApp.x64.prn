29103>>>>>>>    
29103>>>>>>>    // Default refresh logic that updates the state hash when the record changes.
29103>>>>>>>    // 
29103>>>>>>>    // Params:
29103>>>>>>>    //      eMode   The refresh mode.
29103>>>>>>>    Procedure Refresh Integer eMode
29105>>>>>>>        String sName sHash sView 
29105>>>>>>>        Integer eViewType eViewStyle eStateMode iIndex
29105>>>>>>>        tWebNavigateData navData
29105>>>>>>>        tWebNavigateData navData
29105>>>>>>>        
29105>>>>>>>        Forward Send Refresh eMode
29107>>>>>>>                
29107>>>>>>>        // if application style is wvsNone it is a basic non-framework application that does handle web-views at
29107>>>>>>>        // all - refresh should do nothing. This allows web lookups to get added to a basic webapp. While
29107>>>>>>>        // compiled, we don't want to use them.        
29107>>>>>>>        If (peApplicationStyle(Host(Self)) = wvsNone or peApplicationStateMode(Host(Self)) = asmOff) ;            Procedure_Return
29110>>>>>>>        
29110>>>>>>>        If (not(AppSynching(Owner(Self)))) Begin
29112>>>>>>>            If (phoLoadView(Host(Self)) <> Self and phoCurrentShowView(Host(Self)) <> Self and not(pbNavigating(Self)) and not(pbInitForShow(Self))) Begin
29114>>>>>>>                Get peViewType to eViewType
29115>>>>>>>                Get peWebViewStyle to eViewStyle
29116>>>>>>>                Get peStateMode to eStateMode
29117>>>>>>>                
29117>>>>>>>                If (eViewStyle = wvsDrillDown) Begin
29119>>>>>>>                    If (eStateMode = vsmRecord or (eViewStyle = wvsDrillDown and eViewType = vtZoom and eStateMode = vsmDefault)) Begin
29121>>>>>>>                        //  Check if still initializing (we can't check if the name is in the URL because the statehash might not be up-to-date)
29121>>>>>>>                        Get GetNavigateData to navData
29122>>>>>>>                        Get NamedValueIndex navData.NamedValues "Init_Mode" to iIndex
29123>>>>>>>                        If (iIndex < 0) Begin
29125>>>>>>>                            Send UpdateStateHash True
29126>>>>>>>                        End
29126>>>>>>>>
29126>>>>>>>                    End
29126>>>>>>>>
29126>>>>>>>                End
29126>>>>>>>>
29126>>>>>>>                Else Begin
29127>>>>>>>                    If (eStateMode = vsmRecord or (eStateMode = vsmDefault and pbStateRestoreRecord(Host(Self)) and pbStateRestoreRecord(Self))) Begin
29129>>>>>>>                        Get psStateViewName to sName
29130>>>>>>>                        Get StateHash of (Host(Self)) to sHash
29131>>>>>>>                        Send ParseViewStateHash sHash (&sView)        
29132>>>>>>>                        
29132>>>>>>>                        If (lowercase(sName) = Lowercase(sView)) Begin
29134>>>>>>>                            Send UpdateStateHash True
29135>>>>>>>                        End
29135>>>>>>>>
29135>>>>>>>                    End
29135>>>>>>>>
29135>>>>>>>                End
29135>>>>>>>>
29135>>>>>>>            End
29135>>>>>>>>
29135>>>>>>>        End
29135>>>>>>>>
29135>>>>>>>    End_Procedure

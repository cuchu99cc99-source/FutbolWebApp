21466>>>>>>>>>    Procedure RebuildDDConstraints
21468>>>>>>>>>        Handle hoMainDD
21468>>>>>>>>>        Integer i iCount
21468>>>>>>>>>        Handle[] aAdditionalDDOStructures
21469>>>>>>>>>        
21469>>>>>>>>>        Get Main_DD to hoMainDD
21470>>>>>>>>>        
21470>>>>>>>>>        If hoMainDD Begin
21472>>>>>>>>>            Send RebuildAllConstraints of hoMainDD
21473>>>>>>>>>        End
21473>>>>>>>>>>
21473>>>>>>>>>        
21473>>>>>>>>>        // Now iterate the main dd of any 'additional' DDO structures
21473>>>>>>>>>        Get paAdditionalDDOStructures to aAdditionalDDOStructures
21474>>>>>>>>>        Move (SizeOfArray(aAdditionalDDOStructures)) to iCount
21475>>>>>>>>>        
21475>>>>>>>>>        For i from 0 to (iCount - 1)
21481>>>>>>>>>>
21481>>>>>>>>>            If (aAdditionalDDOStructures[i] <> 0) Begin
21483>>>>>>>>>                Send RebuildAllConstraints of aAdditionalDDOStructures[i]
21484>>>>>>>>>            End
21484>>>>>>>>>>
21484>>>>>>>>>        Loop
21485>>>>>>>>>>
21485>>>>>>>>>    End_Procedure

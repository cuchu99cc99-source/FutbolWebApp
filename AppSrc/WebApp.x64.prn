29038>>>>>>>
29038>>>>>>>    // Restores the view state for desktop style by performing a find if needed.
29038>>>>>>>    //
29038>>>>>>>    // Params:
29038>>>>>>>    //      sRecordId       Record id.
29038>>>>>>>    //      bManualEnter    True if the state was changed manually so a find should be done (the
29038>>>>>>>    //                      back button won't cause a find on desktop-style).
29038>>>>>>>    Procedure RestoreViewState_Desktop String sRecordId Boolean bManualEnter
29040>>>>>>>        String sRowId
29040>>>>>>>        Integer iPos
29040>>>>>>>        Handle hoMain
29040>>>>>>>        RowID rRowId
29040>>>>>>>        Boolean bValid
29040>>>>>>>        
29040>>>>>>>        If (pbStateRestoreRecord(Host(Self)) and pbStateRestoreRecord(Self)) Begin
29042>>>>>>>            If (bManualEnter) Begin
29044>>>>>>>                Get Main_DD to hoMain
29045>>>>>>>                
29045>>>>>>>                If (hoMain > 0) Begin
29047>>>>>>>                    Get HashRecordIdToRowId (Main_File(hoMain)) sRecordId (&rRowId) to bValid  
29048>>>>>>>                    If (bValid and not(IsSameRowID(CurrentRowId(hoMain), rRowId))) Begin
29050>>>>>>>                        Send FindByRowId of hoMain (Main_File(hoMain)) rRowId
29051>>>>>>>                    End
29051>>>>>>>>
29051>>>>>>>                    Else If (not(bValid)) Begin
29054>>>>>>>                        
29054>>>>>>>                        If (pbStateHashInvalidError(Host(Self))) Begin
29056>>>>>>>                            Error DFERR_WEBAPP_INVALID_URL_REC
29057>>>>>>>>
29057>>>>>>>                        End
29057>>>>>>>>
29057>>>>>>>                        Send Clear of hoMain
29058>>>>>>>                    End
29058>>>>>>>>
29058>>>>>>>                End
29058>>>>>>>>
29058>>>>>>>            End
29058>>>>>>>>
29058>>>>>>>            Else Begin
29059>>>>>>>                Send UpdateStateHash True
29060>>>>>>>            End
29060>>>>>>>>
29060>>>>>>>        End
29060>>>>>>>>
29060>>>>>>>    End_Procedure
29061>>>>>>>    
29061>>>>>>>    
29061>>>>>>>    // Generates the view state hash for desktop-style.
29061>>>>>>>    //
29061>>>>>>>    // Returns:
29061>>>>>>>    //      View state string.
29061>>>>>>>    Function GenerateStateHash_Desktop Returns String
29063>>>>>>>        String sState sName sCustom sRowId sRecordId
29063>>>>>>>        Handle hoMain
29063>>>>>>>        RowID rRowId
29063>>>>>>>        Integer eStateMode
29063>>>>>>>        
29063>>>>>>>        Get peStateMode to eStateMode
29064>>>>>>>        
29064>>>>>>>        If (eStateMode = vsmOff) Begin
29066>>>>>>>            Function_Return ""
29067>>>>>>>        End
29067>>>>>>>>
29067>>>>>>>        
29067>>>>>>>        If ((eStateMode = vsmDefault or eStateMode = vsmRecord) and pbStateRestoreRecord(Host(Self)) and pbStateRestoreRecord(Self)) Begin
29069>>>>>>>            Get Main_DD to hoMain
29070>>>>>>>            If (hoMain > 0) Begin
29072>>>>>>>                Get CurrentRowId of hoMain to rRowId
29073>>>>>>>                
29073>>>>>>>                Get GenerateStateHashRecordId (Main_File(hoMain)) rRowId to sRecordId
29074>>>>>>>            End
29074>>>>>>>>
29074>>>>>>>        End
29074>>>>>>>>
29074>>>>>>>        
29074>>>>>>>        Get psStateViewName to sName
29075>>>>>>>        
29075>>>>>>>        Send OnDefineCustomStateHash (&sCustom)
29076>>>>>>>        
29076>>>>>>>        Get ConcatViewStateHash of (Host(Self)) sName sRecordId sCustom to sState
29077>>>>>>>        
29077>>>>>>>        Function_Return sState
29078>>>>>>>    End_Function
29079>>>>>>>    
29079>>>>>>>    

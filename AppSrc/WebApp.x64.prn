29189>>>>>>>    // Hides all active dialogs
29189>>>>>>>    Procedure HideAllDialogs
29191>>>>>>>        Handle hoView
29191>>>>>>>        String sInvokingView
29191>>>>>>>        Integer eViewStyle iCount
29191>>>>>>>        tWebViewInfo[] aViewStack
29191>>>>>>>        tWebViewInfo[] aViewStack
29192>>>>>>>        
29192>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
29193>>>>>>>        // We start from the 2nd last element going down
29193>>>>>>>        Move (SizeOfArray(aViewStack)-1) to iCount
29194>>>>>>>        
29194>>>>>>>        While (iCount <> 0)
29198>>>>>>>            Get WebObjectByName aViewStack[iCount].sViewName False to hoView
29199>>>>>>>            Get peWebViewStyle of hoView to eViewStyle
29200>>>>>>>            //If the previous view isnt a dialog we can stop looking back
29200>>>>>>>            If (eViewStyle <> wvsDialog) Begin
29202>>>>>>>                Procedure_Return
29203>>>>>>>            End
29203>>>>>>>>
29203>>>>>>>            
29203>>>>>>>            Send Hide of hoView
29204>>>>>>>            
29204>>>>>>>            Decrement iCount
29205>>>>>>>        Loop
29206>>>>>>>>
29206>>>>>>>    End_Procedure
29207>>>>>>>    
29207>>>>>>>    // Shows a dialog again. It does this by showing All the previous dialogs in the viewstack up untill the first actual view.
29207>>>>>>>    Procedure RestoreDialog
29209>>>>>>>        Handle hoView hoNextView
29209>>>>>>>        String sViewName
29209>>>>>>>        Integer eViewStyle iIndex iCount iViewsInStack iAmountOfViewsToShow
29209>>>>>>>        Handle[] aViewsToShow
29210>>>>>>>        Boolean bFirstNonDialogView
29210>>>>>>>        tWebViewInfo[] aViewStack
29210>>>>>>>        tWebViewInfo[] aViewStack
29211>>>>>>>        tWebViewInfo searchStack
29211>>>>>>>        tWebViewInfo searchStack
29211>>>>>>>        
29211>>>>>>>        Get psStateViewName to sViewName
29212>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
29213>>>>>>>        Move sViewName to searchStack.sViewName        
29214>>>>>>>        Move (SearchArray(searchStack, aViewStack)) to iIndex
29215>>>>>>>        Move Self to aViewsToShow[-1]
29216>>>>>>>        
29216>>>>>>>        // This should never be possible
29216>>>>>>>        If (iIndex = -1) Begin
29218>>>>>>>            Procedure_Return
29219>>>>>>>        End
29219>>>>>>>>
29219>>>>>>>        
29219>>>>>>>        //Start going down the viewstack, and start showing each view that isnt a drill down view.
29219>>>>>>>        While (not(bFirstNonDialogView))
29223>>>>>>>            Decrement iIndex
29224>>>>>>>            Get FindWebObject of (Owner(Self)) aViewStack[iIndex].sViewName to hoView
29225>>>>>>>            Get peWebViewStyle of hoView to eViewStyle
29226>>>>>>>            Move (InsertInArray(aViewsToShow, 0, hoView)) to aViewsToShow
29227>>>>>>>            
29227>>>>>>>            If (eViewStyle <> wvsDialog) Begin
29229>>>>>>>                Move True to bFirstNonDialogView
29230>>>>>>>            End
29230>>>>>>>>
29230>>>>>>>        Loop
29231>>>>>>>>
29231>>>>>>>        
29231>>>>>>>        //Now loop through the array of views we should be showing
29231>>>>>>>        Move (SizeOfArray(aViewsToShow)-1) to iAmountOfViewsToShow
29232>>>>>>>        For iCount from 0 to iAmountOfViewsToShow
29238>>>>>>>>
29238>>>>>>>            Send ShowView to (Host(Self)) aViewsToShow[iCount]
29239>>>>>>>        Loop
29240>>>>>>>>
29240>>>>>>>    End_Procedure

21833>>>>>>>>>>>>>    // Desktop-style implementation of the restorestate logic. It finds out which view should be
21833>>>>>>>>>>>>>    // shown and calls ShowView, the callback messages will do further processing. If the state 
21833>>>>>>>>>>>>>    // hash is empty we show the default view.
21833>>>>>>>>>>>>>    //
21833>>>>>>>>>>>>>    // Params:
21833>>>>>>>>>>>>>    //      sStateHash      The full state hash.
21833>>>>>>>>>>>>>    //      bManualEnter    If true the state hash is entered by the user and a record should be 
21833>>>>>>>>>>>>>    //                      found.
21833>>>>>>>>>>>>>    Procedure RestoreState_Desktop String sStateHash Boolean bManualEnter
21835>>>>>>>>>>>>>        Boolean bDefault
21835>>>>>>>>>>>>>        Integer iPos
21835>>>>>>>>>>>>>        String sView
21835>>>>>>>>>>>>>        Handle hoView
21835>>>>>>>>>>>>>        
21835>>>>>>>>>>>>>        Move True to bDefault
21836>>>>>>>>>>>>>        
21836>>>>>>>>>>>>>        If (Trim(sStateHash) <> "") Begin
21838>>>>>>>>>>>>>            Send ParseViewStateHash sStateHash (&sView)
21839>>>>>>>>>>>>>            
21839>>>>>>>>>>>>>            Get ViewByStateHashName sView to hoView
21840>>>>>>>>>>>>>            
21840>>>>>>>>>>>>>            If (hoView > 0) Begin
21842>>>>>>>>>>>>>                If (bManualEnter) Begin
21844>>>>>>>>>>>>>                    Send Showview hoView (RefProc(RestoreState_Desktop_Callback_ManualEnter)) Self
21845>>>>>>>>>>>>>                End
21845>>>>>>>>>>>>>>
21845>>>>>>>>>>>>>                Else Begin
21846>>>>>>>>>>>>>                    Send Showview hoView (RefProc(RestoreState_Desktop_Callback)) Self
21847>>>>>>>>>>>>>                End
21847>>>>>>>>>>>>>>
21847>>>>>>>>>>>>>                Move False to bDefault
21848>>>>>>>>>>>>>            End
21848>>>>>>>>>>>>>>
21848>>>>>>>>>>>>>            Else Begin
21849>>>>>>>>>>>>>                If (pbStateHashInvalidError(Self)) Begin
21851>>>>>>>>>>>>>                    Error DFERR_WEBAPP_INVALID_URL
21852>>>>>>>>>>>>>>
21852>>>>>>>>>>>>>                End
21852>>>>>>>>>>>>>>
21852>>>>>>>>>>>>>                Else  Begin
21853>>>>>>>>>>>>>                    Get GetDefaultView to hoView
21854>>>>>>>>>>>>>                    If (hoView > 0) Begin
21856>>>>>>>>>>>>>                        Send Show of hoView
21857>>>>>>>>>>>>>                        Send UpdateStateHash of hoView True
21858>>>>>>>>>>>>>                    End
21858>>>>>>>>>>>>>>
21858>>>>>>>>>>>>>                End
21858>>>>>>>>>>>>>>
21858>>>>>>>>>>>>>                Procedure_Return
21859>>>>>>>>>>>>>            End
21859>>>>>>>>>>>>>>
21859>>>>>>>>>>>>>        End
21859>>>>>>>>>>>>>>
21859>>>>>>>>>>>>>        
21859>>>>>>>>>>>>>        //  Else we just show the default view
21859>>>>>>>>>>>>>        If (bDefault) Begin
21861>>>>>>>>>>>>>            Get GetDefaultView to hoView
21862>>>>>>>>>>>>>            If (hoView > 0) Begin
21864>>>>>>>>>>>>>                Send Show of hoView
21865>>>>>>>>>>>>>            End
21865>>>>>>>>>>>>>>
21865>>>>>>>>>>>>>        End
21865>>>>>>>>>>>>>>
21865>>>>>>>>>>>>>    End_Procedure

8100>>>>>>>>>    Function GetWorkspaceFileName String sWorkspace Returns String
8102>>>>>>>>>        // Returns the name of the physical Workspace file for the passed Workspace name.
8102>>>>>>>>>        String sVdfRootDir
8102>>>>>>>>>        Handle hoIniFile
8102>>>>>>>>>        String sPath
8102>>>>>>>>>        String sFileName
8102>>>>>>>>>        String sWorkspacePath
8102>>>>>>>>>        
8102>>>>>>>>>        Move "" to sFileName
8103>>>>>>>>>        
8103>>>>>>>>>        Get_Profile_String "Defaults" "VdfRootDir" to sVdfRootDir
8106>>>>>>>>>        If (Right(sVdfRootDir,1) <>"\") ;            Move (sVdfRootDir +"\") to sVdfRootDir
8109>>>>>>>>>        
8109>>>>>>>>>        Get Create U_cIniFile to hoIniFile
8110>>>>>>>>>        Set psFilename of hoIniFile to (sVdfRootDir +"bin\Workspaces.ini")
8111>>>>>>>>>        Get ReadString of hoIniFile sWorkspace "Path" "" to sWorkspacePath
8112>>>>>>>>>        If (sWorkspacePath <>"") Begin
8114>>>>>>>>>            If (Right(sWorkspacePath,1) <>"\") ;                Move (sWorkspacePath +"\") to sWorkspacePath
8117>>>>>>>>>            Move (sWorkspacePath +sWorkspace +".ws") to sFileName
8118>>>>>>>>>        End
8118>>>>>>>>>>
8118>>>>>>>>>        Send Destroy of hoIniFile
8119>>>>>>>>>        
8119>>>>>>>>>        Function_Return sFileName
8120>>>>>>>>>    End_Function

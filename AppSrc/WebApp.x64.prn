34092>>>>>>>                Move (Character(13)+Character(10)) to sCRLF
34093>>>>>>>                Error DFERR_PROGRAM (SFormat(C_$WebAppTargetObjectNotFound + " Set psLoadViewOnClick to '" + sViewName + "'" + sCRLF + sCRLF + "A reference to this object cannot be located. Check that the object name is correct.",sViewName)) 
34094>>>>>>>>
34094>>>>>>>            End
34094>>>>>>>>
34094>>>>>>>        End
34094>>>>>>>>
34094>>>>>>>        Function_Return hoView

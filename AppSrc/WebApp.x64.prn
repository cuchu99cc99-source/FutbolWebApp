1080>>>>>>>>>
1080>>>>>>>>> //  Encodes the passed value using the URI encoding scheme.
1080>>>>>>>>>Function UrlEncode Global String sValue Boolean bSegment Returns String
1082>>>>>>>>>    WString wWideEncoded wPart
1082>>>>>>>>>    String sEncoded  
1082>>>>>>>>>    String sResult
1082>>>>>>>>>    DWord dwSize dwFlags
1082>>>>>>>>>    Integer iRes iPart iStart
1082>>>>>>>>>    
1082>>>>>>>>>    //  The UrlEscape is limited by the maximum URL lenght so we call it chunck by chunck
1082>>>>>>>>>    Move 0 to iStart
1083>>>>>>>>>    Move 1000 to iPart
1084>>>>>>>>>    
1084>>>>>>>>>    If (bSegment) Begin
1086>>>>>>>>>        Move URL_ESCAPE_SEGMENT_ONLY to dwFlags
1087>>>>>>>>>    End
1087>>>>>>>>>>
1087>>>>>>>>>    
1087>>>>>>>>>    While (iStart < Length(sValue))
1091>>>>>>>>>        Move (Mid(sValue, iPart, iStart + 1)) to wPart
1092>>>>>>>>>        
1092>>>>>>>>>        //  Call UrlEscape
1092>>>>>>>>>        Move (Length(wPart) + 1) to dwSize
1093>>>>>>>>>        Move (Repeat(" ", dwSize)) to wWideEncoded
1094>>>>>>>>>        
1094>>>>>>>>>        Move (UrlEscapeW(AddressOf(wPart), AddressOf(wWideEncoded), AddressOf(dwSize), dwFlags)) to iRes
1095>>>>>>>>>                
1095>>>>>>>>>        If (Length(wPart) < dwSize) Begin
1097>>>>>>>>>            Move (Repeat(" ", dwSize)) to wWideEncoded
1098>>>>>>>>>            Move (UrlEscapeW(AddressOf(wPart), AddressOf(wWideEncoded), AddressOf(dwSize), dwFlags)) to iRes
1099>>>>>>>>>        End
1099>>>>>>>>>>
1099>>>>>>>>>        
1099>>>>>>>>>        Move (CString(wWideEncoded)) to sEncoded
1100>>>>>>>>>        
1100>>>>>>>>>        //  Do extra replacements for cookies
1100>>>>>>>>>        Move (Replaces(";", sEncoded, "%3B")) to sEncoded
1101>>>>>>>>>        If (bSegment) Begin
1103>>>>>>>>>            Move (Replaces("=", sEncoded, "%3D")) to sEncoded
1104>>>>>>>>>        End
1104>>>>>>>>>>
1104>>>>>>>>>        
1104>>>>>>>>>        
1104>>>>>>>>>        Move (iStart + iPart) to iStart
1105>>>>>>>>>        Move (sResult + sEncoded) to sResult
1106>>>>>>>>>    Loop
1107>>>>>>>>>>
1107>>>>>>>>>    
1107>>>>>>>>>    Function_Return sResult    
1108>>>>>>>>>End_Function
1109>>>>>>>>>
1109>>>>>>>>>//  Decodes the passed value using the URI encoding scheme.
1109>>>>>>>>>Function UrlDecode Global String sValue Returns String
1111>>>>>>>>>    Integer iVoid
1111>>>>>>>>>    WString wValue
1111>>>>>>>>>    
1111>>>>>>>>>    If (Trim(sValue) <> "") Begin
1113>>>>>>>>>        Move (Replaces("%3D", Replaces("%3B", sValue, ";"), "=")) to wValue
1114>>>>>>>>>        Move (UrlUnescapeW(AddressOf(wValue), 0, 0, URL_UNESCAPE_INPLACE)) to iVoid
1115>>>>>>>>>    End
1115>>>>>>>>>>
1115>>>>>>>>>    
1115>>>>>>>>>    Function_Return (CString(wValue))
1116>>>>>>>>>End_Function

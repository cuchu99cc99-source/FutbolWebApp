13376>>>>>>>    
13376>>>>>>>    Function phXMLErrorObject Returns Handle
13378>>>>>>>        Handle hoParseErrorObject
13378>>>>>>>        Handle hInfcParseError
13378>>>>>>>        Get phParseError to hInfcParseError
13379>>>>>>>        If hInfcParseError ;            Get CreateXMLObject U_cXMLDOMParseError hinfcParseError to hoParseErrorObject
13382>>>>>>>        Function_Return hoParseErrorObject
13383>>>>>>>    End_Function
13384>>>>>>>    
13384>>>>>>>    //  The following procedure is meant to be overridden by one provided by the developer.
13384>>>>>>>    
13384>>>>>>>    Procedure BasicParseErrorReport
13386>>>>>>>        String sProblem
13386>>>>>>>        String sLinePosition
13386>>>>>>>        String sDescr
13386>>>>>>>        String sReason
13386>>>>>>>        String sSource
13386>>>>>>>        Handle hoParseErrorObject
13386>>>>>>>        Get phXMLErrorObject to hoParseErrorObject
13387>>>>>>>        If hoParseErrorObject Begin
13389>>>>>>>            Move (SFormat(C_$CannotLoad, psDocumentName(Self)) + "."+character(13)+character(10)) to sProblem
13390>>>>>>>            Move (SFormat(C_$ParsingError, piLine(hoParseErrorObject), piLinePos(hoParseErrorObject))) to sLinePosition
13391>>>>>>>            Move (sLinePosition +character(13)+character(10)) to sLinePosition
13392>>>>>>>            
13392>>>>>>>            Move (C_$Reason + ":" * (psReason(hoParseErrorObject))  +character(13)+character(10)) to sReason
13393>>>>>>>            Move (C_$Source + ":" * (psSrcText(hoParseErrorObject))) to sSource
13394>>>>>>>            Move (sProblem + sLinePosition + sReason + sSource) to sDescr
13395>>>>>>>            Error DFERR_XML_INTERNAL_ERROR sDescr
13396>>>>>>>>
13396>>>>>>>            Send Destroy of hoParseErrorObject
13397>>>>>>>        End
13397>>>>>>>>
13397>>>>>>>        Else ;            Error DFERR_XML_INTERNAL_ERROR C_$NotCreatedParseObject
13399>>>>>>>    End_Procedure
13400>>>>>>>    
13400>>>>>>>    // bind an xml interface node to the passed XML object. If the
13400>>>>>>>    // object type is of the wrong type, we will destroy it and recreate it
13400>>>>>>>    // which is why hoNode is passed byRef.
13400>>>>>>>    // to use this you'd have to use the lower level private messages to get the
13400>>>>>>>    // xml interface handles and then bind them to an object. Just like in COM you could
13400>>>>>>>    // bind these to the same object, which might save some parsing time. This is made private
13400>>>>>>>    // because the time savings would probably be small and would not justify the extra
13400>>>>>>>    // complexity.
13400>>>>>>>    // It is a programming error to pass this a zero handle.
13400>>>>>>>    Procedure BindXMLInfc Handle hInfc Handle ByRef hoNode
13402>>>>>>>        Integer iType iClassId iType2
13402>>>>>>>        Get piNodeType of hoNode to iType2 // type of the DF XML object
13403>>>>>>>        
13403>>>>>>>        // Get the node type of the infc handle w/o creating a DF object
13403>>>>>>>        Move (invokexml(DF_IXMLDOMNODE, GET_piNodeType, hinfc, 0, 0, 0, 0)) to iType
13404>>>>>>>        Move (invokexml(DF_IXMLDOMNODE, GET_ChangeNodeType, hinfc, iType, 1, 0, 0)) to hInfc
13405>>>>>>>        If (hinfc=0) Begin
13407>>>>>>>            // this should not happen and we would need to know about this.
13407>>>>>>>            Error DFERR_XML_INTERNAL_ERROR (C_$XmlFailedNoDocObject + String(iType))
13408>>>>>>>>
13408>>>>>>>            Procedure_Return 0
13409>>>>>>>        End
13409>>>>>>>>
13409>>>>>>>        // if the type is the same we can reuse the current object and binding it to the interface pointer
13409>>>>>>>        If (iType=iType2) Begin
13411>>>>>>>            // resuse Self and return
13411>>>>>>>            Set XMLInterface of hoNode to hInfc
13412>>>>>>>        End
13412>>>>>>>>
13412>>>>>>>        // if diffrent type, destroy the existing object and recreate it
13412>>>>>>>        Else Begin
13413>>>>>>>            Send Destroy of hoNode
13414>>>>>>>            Get NodeClassId iType to iClassId
13415>>>>>>>            Get CreateXMLObject iClassId hInfc to hoNode
13416>>>>>>>        End
13416>>>>>>>>
13416>>>>>>>    End_Procedure
13417>>>>>>>    

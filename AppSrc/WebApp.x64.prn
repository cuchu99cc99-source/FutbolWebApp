25358>>>>>>>>>>>>>    Procedure RemoveTag String sTag
25360>>>>>>>>>>>>>        String[] aTags
25361>>>>>>>>>>>>>        Boolean bCaseSensitive
25361>>>>>>>>>>>>>        Integer i
25361>>>>>>>>>>>>>        
25361>>>>>>>>>>>>>        Get GetTags to aTags
25362>>>>>>>>>>>>>        Get pbCaseSensitive to bCaseSensitive
25363>>>>>>>>>>>>>        
25363>>>>>>>>>>>>>        If (not(bCaseSensitive)) ;            Move (Uppercase(sTag)) to sTag
25366>>>>>>>>>>>>>            
25366>>>>>>>>>>>>>        For i from 0 to (SizeOfArray(aTags) - 1)
25372>>>>>>>>>>>>>>
25372>>>>>>>>>>>>>            If ((bCaseSensitive and aTags[i]= sTag) or (not(bCaseSensitive) and Uppercase(aTags[i]) = sTag)) Begin
25374>>>>>>>>>>>>>                Move (RemoveFromArray(aTags, i)) to aTags
25375>>>>>>>>>>>>>                Decrement i
25376>>>>>>>>>>>>>            End
25376>>>>>>>>>>>>>>
25376>>>>>>>>>>>>>        Loop
25377>>>>>>>>>>>>>>
25377>>>>>>>>>>>>>        
25377>>>>>>>>>>>>>        Send UpdateTags aTags
25378>>>>>>>>>>>>>    End_Procedure

27335>>>>>>>>>    
27335>>>>>>>>>    // Called by the JavaScript engine to perform a search on an automatic data aware list
27335>>>>>>>>>    // (peDbGridType = gtAutomatic and pbDataAware = true). It can just perform the find on the DD
27335>>>>>>>>>    // and the list will refresh itself and select the right record.
27335>>>>>>>>>    Procedure OnSearch String sSearchText
27337>>>>>>>>>        Integer iCol
27337>>>>>>>>>        Handle hoCol
27337>>>>>>>>>        WebGet piSortColumn to iCol
27338>>>>>>>>>
27338>>>>>>>>>        If (iCol>=0) Begin
27340>>>>>>>>>            Get GetColumnObject iCol to hoCol
27341>>>>>>>>>            
27341>>>>>>>>>            // Perform the lookup
27341>>>>>>>>>            Send RequestColumnLookup of hoCol sSearchText
27342>>>>>>>>>        End
27342>>>>>>>>>>
27342>>>>>>>>>    End_Procedure
27343>>>>>>>>>
27343>>>>>>>>>    // Attempt to find the field from the server's MainFile that relates to iRelatedFile
27343>>>>>>>>>    Function RelatingField Integer iRelatedFile Returns Integer
27345>>>>>>>>>        Integer iField iRelFile iNumFields iIndex iMainfile
27345>>>>>>>>>        Handle hoServer
27345>>>>>>>>>        Boolean bDDRelates
27345>>>>>>>>>        Get Server to hoServer
27346>>>>>>>>>        Get Main_File of hoServer to iMainfile
27347>>>>>>>>>        Get pbUseDDRelates of hoServer to bDDRelates
27348>>>>>>>>>        Get_Attribute DF_FILE_NUMBER_FIELDS of iMainFile to iNumFields
27351>>>>>>>>>        For iField from 1 to iNumFields
27357>>>>>>>>>>
27357>>>>>>>>>            
27357>>>>>>>>>            // find first field that relates to the related file and has an index.
27357>>>>>>>>>            If (bDDRelates) Begin
27359>>>>>>>>>                Get Field_Related_File of hoServer iField to iRelFile
27360>>>>>>>>>            End
27360>>>>>>>>>>
27360>>>>>>>>>            Else Begin
27361>>>>>>>>>                Get_Attribute DF_FIELD_RELATED_FILE of iMainFile  iField to iRelFile
27364>>>>>>>>>            End
27364>>>>>>>>>>
27364>>>>>>>>>            
27364>>>>>>>>>            If (iRelFile=iRelatedFile) Begin
27366>>>>>>>>>                
27366>>>>>>>>>                If (bDDRelates) Begin
27368>>>>>>>>>                    Get Field_Related_Field of hoServer iField to iIndex
27369>>>>>>>>>                End
27369>>>>>>>>>>
27369>>>>>>>>>                Else Begin
27370>>>>>>>>>                    Get_Attribute DF_FIELD_INDEX of iMainFile iField to iIndex
27373>>>>>>>>>                End
27373>>>>>>>>>>
27373>>>>>>>>>                
27373>>>>>>>>>                If (iIndex>0) Begin
27375>>>>>>>>>                    Function_Return iField
27376>>>>>>>>>                End
27376>>>>>>>>>>
27376>>>>>>>>>            End
27376>>>>>>>>>>
27376>>>>>>>>>        Loop
27377>>>>>>>>>>
27377>>>>>>>>>        Function_Return -1
27378>>>>>>>>>    End_Function
27379>>>>>>>>>
27379>>>>>>>>>    // refresh DD aware Grid from the Top
27379>>>>>>>>>    Procedure FindFromTop
27381>>>>>>>>>       Send FindFromTB True
27382>>>>>>>>>    End_Procedure
27383>>>>>>>>>
27383>>>>>>>>>    // refresh DD aware Grid from the Bottom
27383>>>>>>>>>    Procedure FindFromBottom
27385>>>>>>>>>       Send FindFromTB False
27386>>>>>>>>>    End_Procedure
27387>>>>>>>>>    
27387>>>>>>>>>    // called for Select views to refresh the select list during back navigation.
27387>>>>>>>>>    // If a cancel, there is no target DD and no rowId. Just refresh around what's in the DDO
27387>>>>>>>>>    // If a close, we have a RowId for a target DDO. If the DDO matches this list's DDO, refresh 
27387>>>>>>>>>    // around that. 
27387>>>>>>>>>    // For now this is private
27387>>>>>>>>>    Procedure RefreshListForBackNavigation Boolean bCancel Handle hoDDTarget RowID riTarget
27389>>>>>>>>>        Boolean bDataAware bSuccess
27389>>>>>>>>>        Handle hoDD
27389>>>>>>>>>        Integer iMain
27389>>>>>>>>>        RowID riId
27389>>>>>>>>>        
27389>>>>>>>>>        If (pbGhost(Self)) ;            Procedure_Return
27392>>>>>>>>>        
27392>>>>>>>>>        Get pbDataAware to bDataAware
27393>>>>>>>>>        // if non-data aware there is no list update
27393>>>>>>>>>        If bDataAware Begin
27395>>>>>>>>>            // if close & update, with a different rowid refind the rowid passed in. 
27395>>>>>>>>>            If not bCancel Begin
27397>>>>>>>>>                Get Server to hoDD
27398>>>>>>>>>                If (hoDD and hoDD=hoDDTarget) Begin // test to make sure this is an appropriate list to update
27400>>>>>>>>>                    Get Main_File of hoDD to iMain
27401>>>>>>>>>                    Get CurrentRowId of hoDD to riId
27402>>>>>>>>>                    If (not(IsNullRowID(riTarget)) and not(IsSameRowID(riId,riTarget))) Begin
27404>>>>>>>>>                        // this will cause the list to refresh itself
27404>>>>>>>>>                        Get FindByRowIdEx of hoDD iMain riTarget to bSuccess
27405>>>>>>>>>                        If not bSuccess Begin
27407>>>>>>>>>                            Send HandleCacheError
27408>>>>>>>>>                        End
27408>>>>>>>>>>
27408>>>>>>>>>                        Procedure_Return
27409>>>>>>>>>                    End
27409>>>>>>>>>>
27409>>>>>>>>>                End
27409>>>>>>>>>>
27409>>>>>>>>>            End
27409>>>>>>>>>>
27409>>>>>>>>>            // else, refresh with current information around existing DD
27409>>>>>>>>>            Send RefreshListFromDD
27410>>>>>>>>>        End
27410>>>>>>>>>>
27410>>>>>>>>>    End_Procedure
27411>>>>>>>>>
27411>>>>>>>>>    
27411>>>>>>>>>    
27411>>>>>>>>>    // Refresh a data-aware grid around the current record in the DD
27411>>>>>>>>>    // If that record is 0 or not found, which you really don't want to happen,
27411>>>>>>>>>    // just refresh from firsts record
27411>>>>>>>>>    Procedure RefreshListFromDD
27413>>>>>>>>>        Handle hoDD
27413>>>>>>>>>        RowID riId
27413>>>>>>>>>        Integer iMain
27413>>>>>>>>>        Boolean bDataAware bSuccess
27413>>>>>>>>>        Get pbDataAware to bDataAware
27414>>>>>>>>>        If bDataAware Begin
27416>>>>>>>>>
27416>>>>>>>>>            If (pbNotifyingExternalDD(Self)) Begin
27418>>>>>>>>>                Error DFERR_PROGRAM "Assert: RefreshListFromDD called with pbNotifyingExternalDD set"
27419>>>>>>>>>>
27419>>>>>>>>>            End
27419>>>>>>>>>>
27419>>>>>>>>>
27419>>>>>>>>>            Get Server to hoDD
27420>>>>>>>>>            Get Main_File of hoDD to iMain
27421>>>>>>>>>            Get CurrentRowId of hoDD to riId
27422>>>>>>>>>            Move False to bSuccess
27423>>>>>>>>>            
27423>>>>>>>>>            If (not(IsNullRowID(riId))) Begin
27425>>>>>>>>>                // test to see if the record still exists
27425>>>>>>>>>                Get FindByRowIdEx of hoDD iMain riId to bSuccess 
27426>>>>>>>>>            End
27426>>>>>>>>>>
27426>>>>>>>>>            
27426>>>>>>>>>            If (not(bSuccess)) Begin
27428>>>>>>>>>                // missing record, we don't know what to do.
27428>>>>>>>>>                // Just refresh the entire list
27428>>>>>>>>>                Get FindInDD hoDD FIRST_RECORD to bSuccess
27429>>>>>>>>>                If (not(bSuccess)) Begin
27431>>>>>>>>>                    Send ClearGrid
27432>>>>>>>>>                End
27432>>>>>>>>>>
27432>>>>>>>>>            End
27432>>>>>>>>>>
27432>>>>>>>>>        End
27432>>>>>>>>>>
27432>>>>>>>>>    End_Procedure
27433>>>>>>>>>    
27433>>>>>>>>>    
27433>>>>>>>>>    // This event procedure is called when a row is clicked within the list and pbServerOnRowClick 
27433>>>>>>>>>    // is true. It is called after the actual row change is performed which means that if the row 
27433>>>>>>>>>    // change succeeded the psCurrentRowId matches the clicked row id. In case of a cWebGrid row 
27433>>>>>>>>>    // changes can fail due to validation issues so in that case the clicked row can be different. 
27433>>>>>>>>>    // Note that if pbOfflineEditing is true the buffer will not contain the selected row.
27433>>>>>>>>>    //
27433>>>>>>>>>    // Params:
27433>>>>>>>>>    //  sRowID          The rowid of the clicked row.
27433>>>>>>>>>    //  iColumnIndex    The cWebColumn object index (excl. non-cWebColumn siblings).
27433>>>>>>>>>    //                  When pressing enter in a cWebList this will be -1.
27433>>>>>>>>>    Procedure OnRowClick String sRowID Integer iColumnIndex
27435>>>>>>>>>        //  Empty event stub
27435>>>>>>>>>    End_Procedure
27436>>>>>>>>>
27436>>>>>>>>>    // Callback method sent to the callback control when a view receives NavigateForward.
27436>>>>>>>>>    // This should populate the tWebNavigateData in the default way according to the control's data bindings.
27436>>>>>>>>>    Procedure GetNavigateBackData Handle hoView tWebNavigateData ByRef NavigateData
27438>>>>>>>>>        Integer eGridType
27438>>>>>>>>>        String sId
27438>>>>>>>>>        Handle hoServer 
27438>>>>>>>>>        RowID ri
27438>>>>>>>>>        Boolean bOk bDataAware
27438>>>>>>>>>        
27438>>>>>>>>>        // Populate the Navigate Data struct with the best guess values from
27438>>>>>>>>>        // this control's server DDO
27438>>>>>>>>>        Get Server to hoServer
27439>>>>>>>>>        If (hoServer) Begin
27441>>>>>>>>>            WebGet peDbGridType to eGridType
27442>>>>>>>>>            WebGet pbDataAware to bDataAware
27443>>>>>>>>>            If (bDataAware and  eGridType<>gtAutomatic) Begin
27445>>>>>>>>>                WebGet psCurrentRowId     to sId
27446>>>>>>>>>                Get FindByRowIdEx of hoServer (Main_File(hoServer)) (DeserializeRowID(sId)) to bOk
27447>>>>>>>>>            End
27447>>>>>>>>>>
27447>>>>>>>>>            
27447>>>>>>>>>            WebGet psCurrentRowId     to sId
27448>>>>>>>>>            Get CurrentRowId of hoServer to ri
27449>>>>>>>>>            If (not(IsSameRowID(ri,(DeserializeRowID(sId))))) Begin
27451>>>>>>>>>                Error DFERR_PROGRAM "Assert: Different ids in weblist"
27452>>>>>>>>>>
27452>>>>>>>>>            End
27452>>>>>>>>>>
27452>>>>>>>>>
27452>>>>>>>>>        End
27452>>>>>>>>>>
27452>>>>>>>>>        Forward Send GetNavigateBackData hoView (&NavigateData)
27454>>>>>>>>>        
27454>>>>>>>>>    End_Procedure
27455>>>>>>>>>    
27455>>>>>>>>>    
27455>>>>>>>>>    // Callback method sent to the callback control when a view receives NavigateForward.
27455>>>>>>>>>    // This should populate the tWebNavigateData in the default way according to the control's data bindings.
27455>>>>>>>>>    Procedure GetNavigateForwardData Handle hoView tWebNavigateData ByRef NavigateData
27457>>>>>>>>>        Integer eGridType
27457>>>>>>>>>        String sId
27457>>>>>>>>>        Handle hoServer 
27457>>>>>>>>>        RowID ri
27457>>>>>>>>>        Boolean bOk bOldGridAction bFromDynamic
27457>>>>>>>>>        
27457>>>>>>>>>        // Populate the Navigate Data struct with the best guess values from
27457>>>>>>>>>        // this control's server DDO
27457>>>>>>>>>        Get Server to hoServer
27458>>>>>>>>>        // if not dataaware there will be no server!
27458>>>>>>>>>        If (hoServer) Begin
27460>>>>>>>>>            WebGet peDbGridType to eGridType
27461>>>>>>>>>            WebGet psCurrentRowId     to sId
27462>>>>>>>>>            // if not automatic, the server's row Id may not be current yet. 
27462>>>>>>>>>            If (eGridType<>gtAutomatic) Begin
27464>>>>>>>>>                Get pbNotifyingExternalDD to bOldGridAction
27465>>>>>>>>>                Set pbNotifyingExternalDD to True
27466>>>>>>>>>                Get FindByRowIdEx of hoServer (Main_File(hoServer)) (DeserializeRowID(sId)) to bOk
27467>>>>>>>>>                Set pbNotifyingExternalDD to bOldGridAction
27468>>>>>>>>>            End
27468>>>>>>>>>>
27468>>>>>>>>>            
27468>>>>>>>>>            // If the navigation is executed by a dynamic object, we don't care about this sanity check - especially durin initialization
27468>>>>>>>>>            Get IsDynamicObject to bFromDynamic
27469>>>>>>>>>            If (not(bFromDynamic) and not(pbGhost(Self))) Begin
27471>>>>>>>>>                // Assert that the Server's rowid matches the weblist's current row id
27471>>>>>>>>>                // if the DDO has no record, it is possible it could not refind what it
27471>>>>>>>>>                // needed and cleared it. We will not consider this an error, although it
27471>>>>>>>>>                // may display odd stuff (like a cleared parent).
27471>>>>>>>>>                Get CurrentRowId of hoServer to ri
27472>>>>>>>>>                If (not(IsNullRowID(ri)) and  not(IsSameRowID(ri,(DeserializeRowID(sId))))) Begin
27474>>>>>>>>>                    Error DFERR_PROGRAM "Assert: Different ids in weblist"
27475>>>>>>>>>>
27475>>>>>>>>>                End
27475>>>>>>>>>>
27475>>>>>>>>>            End
27475>>>>>>>>>>
27475>>>>>>>>>
27475>>>>>>>>>        End
27475>>>>>>>>>>
27475>>>>>>>>>        Forward Send GetNavigateForwardData hoView (&NavigateData)
27477>>>>>>>>>    
27477>>>>>>>>>    End_Procedure
27478>>>>>>>>>    
27478>>>>>>>>>    // Special augmentation for weblists. If this is not a dataaware grid, we want the server
27478>>>>>>>>>    // to be 0. We also want any child DEOs to have a 0 server, which they will
27478>>>>>>>>>    Function Server Returns Integer
27480>>>>>>>>>        Boolean bDataAware
27480>>>>>>>>>        Handle hoServer
27480>>>>>>>>>        
27480>>>>>>>>>        // note we use the property and not the web-property. Even though this is a web-property
27480>>>>>>>>>        // it is not expected that this would ever be webset changed
27480>>>>>>>>>        Get pbDataAware to bDataAware
27481>>>>>>>>>        If (bDataAware) Begin
27483>>>>>>>>>            Forward Get Server to hoServer
27485>>>>>>>>>        End
27485>>>>>>>>>>
27485>>>>>>>>>        Function_Return hoServer
27486>>>>>>>>>    End_Function
27487>>>>>>>>>
27487>>>>>>>>>    // This message is broadcast to all controls in a list view when
27487>>>>>>>>>    // navigating to the view. It is intended to allow the controls to set the
27487>>>>>>>>>    // ordering of row data (e.g. piOrdering)
27487>>>>>>>>>    Procedure InitOrdering tWebNavigateData NavigateData Handle hoInvokingObject
27489>>>>>>>>>        Integer iMainTable iSortCol
27489>>>>>>>>>        Integer eDbGridType
27489>>>>>>>>>        Handle hoServer hoMainDD
27489>>>>>>>>>        Boolean bDataAware bReverseOrdering
27489>>>>>>>>>    
27489>>>>>>>>>        Get Server to hoServer
27490>>>>>>>>>        Get Main_DD to hoMainDD
27491>>>>>>>>>        
27491>>>>>>>>>        // If no server or the server is not the view's main server, do nothing
27491>>>>>>>>>        If (hoServer=0 or hoServer<>hoMainDD) Begin
27493>>>>>>>>>            Procedure_Return
27494>>>>>>>>>        End
27494>>>>>>>>>>
27494>>>>>>>>>        
27494>>>>>>>>>        Get pbDataAware to bDataAware
27495>>>>>>>>>        Get peDbGridType to eDbGridType
27496>>>>>>>>>        
27496>>>>>>>>>        // restore to design time values
27496>>>>>>>>>        Get pbReverseOrdering to bReverseOrdering
27497>>>>>>>>>        WebSet pbReverseOrdering to bReverseOrdering
27498>>>>>>>>>
27498>>>>>>>>>        Get piSortColumn to iSortCol
27499>>>>>>>>>        WebSet piSortColumn to iSortCol
27500>>>>>>>>>
27500>>>>>>>>>        // if data-aware and autoloading we assign an automatic sort column    
27500>>>>>>>>>        If (eDbGridType <> gtManual and bDataAware) Begin
27502>>>>>>>>>            If (NavigateData.eNavigateType <> nfFromParent) Begin
27504>>>>>>>>>                Get Main_File of hoServer to iMainTable
27505>>>>>>>>>                If (iMainTable = NavigateData.iTable and iMainTable <> 0) Begin
27507>>>>>>>>>                    Get SelectBestColumn NavigateData.iTable NavigateData.iColumn to iSortCol
27508>>>>>>>>>                    If (iSortCol>=0) Begin
27510>>>>>>>>>                        WebSet piSortColumn to iSortCol
27511>>>>>>>>>                    End
27511>>>>>>>>>>
27511>>>>>>>>>                End
27511>>>>>>>>>>
27511>>>>>>>>>            End
27511>>>>>>>>>>
27511>>>>>>>>>        End
27511>>>>>>>>>>
27511>>>>>>>>>    End_Procedure 
27512>>>>>>>>>    
27512>>>>>>>>>    // This message is broadcast to a Select view when navigating to the view and there is no 
27512>>>>>>>>>    // record for the grid. It is intended to allow the list control to fill itself
27512>>>>>>>>>    // automatically when appropriate. It only does a fill if this is data aware grid,
27512>>>>>>>>>    // and the grid's server is the view's main DD. It simply loads from the "first" record 
27512>>>>>>>>>    Procedure InitGrid tWebNavigateData NavigateData Handle hoInvokingObject
27514>>>>>>>>>        Integer iIndex iMainTable
27514>>>>>>>>>        Integer eDbGridType
27514>>>>>>>>>        Handle hoServer hoMainDD
27514>>>>>>>>>        Boolean bSeeded bReverseOrdering bDataAware
27514>>>>>>>>>        Boolean bOldGridAction
27514>>>>>>>>>    
27514>>>>>>>>>        Get Server to hoServer
27515>>>>>>>>>        Get Main_DD to hoMainDD
27516>>>>>>>>>        If (hoServer=0 or hoServer<>hoMainDD) Begin
27518>>>>>>>>>            Procedure_Return
27519>>>>>>>>>        End
27519>>>>>>>>>>
27519>>>>>>>>>        
27519>>>>>>>>>        Get pbDataAware to bDataAware
27520>>>>>>>>>        Get peDbGridType to eDbGridType
27521>>>>>>>>>        
27521>>>>>>>>>        // if manually loaded or not data aware we will not do any init here. It can be done
27521>>>>>>>>>        // in OnNavigateForward
27521>>>>>>>>>        If (eDbGridType = gtManual or not(bDataAware)) Begin
27523>>>>>>>>>            Procedure_Return
27524>>>>>>>>>        End
27524>>>>>>>>>>
27524>>>>>>>>>        
27524>>>>>>>>>        Get pbReverseOrdering to bReverseOrdering
27525>>>>>>>>>        Get Main_File of hoServer to iMainTable
27526>>>>>>>>>        Get IndexOrder to iIndex
27527>>>>>>>>>
27527>>>>>>>>>        // Init list at the "start"
27527>>>>>>>>>        If (bReverseOrdering) Begin
27529>>>>>>>>>            Send Find of hoServer LAST_RECORD iIndex
27530>>>>>>>>>        End
27530>>>>>>>>>>
27530>>>>>>>>>        Else Begin
27531>>>>>>>>>            Send Find of hoServer FIRST_RECORD iIndex
27532>>>>>>>>>        End
27532>>>>>>>>>>
27532>>>>>>>>>
27532>>>>>>>>>        // If the seeding succeeded then ensure that all controls latch onto this
27532>>>>>>>>>        // otherwise just clear the DDOs
27532>>>>>>>>>        Get HasRecord of hoServer to bSeeded
27533>>>>>>>>>        
27533>>>>>>>>>        If bSeeded Begin
27535>>>>>>>>>            // this only updates the current record and does not refill the grid
27535>>>>>>>>>            Get pbNotifyingExternalDD to bOldGridAction
27536>>>>>>>>>            Set pbNotifyingExternalDD to True
27537>>>>>>>>>            Send Request_Assign of hoServer
27538>>>>>>>>>            Set pbNotifyingExternalDD to bOldGridAction
27539>>>>>>>>>        End
27539>>>>>>>>>>
27539>>>>>>>>>        Else Begin
27540>>>>>>>>>            Send ClearGrid
27541>>>>>>>>>        End
27541>>>>>>>>>>
27541>>>>>>>>>    End_Procedure 
27542>>>>>>>>>
27542>>>>>>>>>    Function SelectBestColumn Integer iFile Integer iField Returns Integer
27544>>>>>>>>>        Integer iCol iColFile iColField
27544>>>>>>>>>        Boolean bCol
27544>>>>>>>>>        Handle[] hoColumnObjects
27545>>>>>>>>>        
27545>>>>>>>>>        Get phoColumnObjects to hoColumnObjects
27546>>>>>>>>>        For iCol from 0 to (SizeOfArray(hoColumnObjects)-1)
27552>>>>>>>>>>
27552>>>>>>>>>            Get pbIsWebColumn of hoColumnObjects[iCol] to bCol
27553>>>>>>>>>            If (bCol) Begin
27555>>>>>>>>>                Get Data_File of hoColumnObjects[iCol] iCol to iColFile
27556>>>>>>>>>                If iFile Begin
27558>>>>>>>>>                    Get Data_Field of hoColumnObjects[iCol] iCol to iColField
27559>>>>>>>>>                    If (iColFile=iFile and iColField=iField) Begin
27561>>>>>>>>>                        Function_Return iCol
27562>>>>>>>>>                    End
27562>>>>>>>>>>
27562>>>>>>>>>                End
27562>>>>>>>>>>
27562>>>>>>>>>            End
27562>>>>>>>>>>
27562>>>>>>>>>        Loop
27563>>>>>>>>>>
27563>>>>>>>>>        Function_Return -1
27564>>>>>>>>>    End_Function
27565>>>>>>>>>    
27565>>>>>>>>>    Function DragData Returns Variant
27567>>>>>>>>>        tWebListDragData DragData
27567>>>>>>>>>        tWebListDragData DragData
27567>>>>>>>>>        Handle hoJsonData 
27567>>>>>>>>>        
27567>>>>>>>>>        Get phoJsonDragData to hoJsonData
27568>>>>>>>>>        If (hoJsonData <> C_WebUnresolvedObject) Begin
27570>>>>>>>>>            Get JsonToDataType of hoJsonData to DragData
27571>>>>>>>>>        End
27571>>>>>>>>>>
27571>>>>>>>>>        
27571>>>>>>>>>        Function_Return DragData
27572>>>>>>>>>    End_Function
27573>>>>>>>>>    
27573>>>>>>>>>    Function DropData Returns Variant
27575>>>>>>>>>        tWebListDropData DropData
27575>>>>>>>>>        tWebListDropData DropData
27575>>>>>>>>>        Handle hoJsonData
27575>>>>>>>>>        
27575>>>>>>>>>        Get phoJsonDropData to hoJsonData
27576>>>>>>>>>        
27576>>>>>>>>>        If (hoJsonData <> C_WebUnresolvedObject and IsOfJsonType(hoJsonData, jsonTypeObject)) Begin
27578>>>>>>>>>            Set pbRequireAllMembers of hoJsonData to False
27579>>>>>>>>>            Get JsonToDataType of hoJsonData to DropData
27580>>>>>>>>>        End
27580>>>>>>>>>>
27580>>>>>>>>>        
27580>>>>>>>>>        Function_Return DropData
27581>>>>>>>>>    End_Function
27582>>>>>>>>>    
27582>>>>>>>>>    Function SupportsDragAction Integer eAction Returns Boolean
27584>>>>>>>>>        If (eAction = C_WebDragListRow) Begin
27586>>>>>>>>>            Function_Return True
27587>>>>>>>>>        End
27587>>>>>>>>>>
27587>>>>>>>>>        
27587>>>>>>>>>        Function_Return False

12701>>>>>>>    
12701>>>>>>>    // Create a document fragment.  Document fragments can be used to house nodes temporarily. When
12701>>>>>>>    // You append or insert a document fragment (appendNode InsertBeforeNode) child nodes are appended
12701>>>>>>>    // to the destination object and not the fragment node itself. This is useful!
12701>>>>>>>    
12701>>>>>>>    Function CreateDocumentFragmentNode Returns Handle
12703>>>>>>>        Handle hoNew
12703>>>>>>>        Handle hoDocumentObject
12703>>>>>>>        Handle infcNew
12703>>>>>>>        Integer iClassID
12703>>>>>>>        Get DocumentObject to hoDocumentObject
12704>>>>>>>        // Create an Comment in the document and assign its interface to the new DF object.
12704>>>>>>>        Get createDocumentFragment of hoDocumentObject to infcNew
12705>>>>>>>        If infcNew Begin // if there was an error, no infc handle would be returned
12707>>>>>>>            Get NodeClassId of hoDocumentObject NODE_DOCUMENT_FRAGMENT to iClassId
12708>>>>>>>            Get CreateXMLObject iClassId infcNew to hoNew
12709>>>>>>>        End
12709>>>>>>>>
12709>>>>>>>        Function_Return hoNew
12710>>>>>>>    End_Function
12711>>>>>>>    
12711>>>>>>>    //  Create a Node of any passed Type (e.g. Node_element). Normally you don't need this as there are
12711>>>>>>>    //  specific messages to do this for each node type. Node that this lets you pass namespaces as a separate
12711>>>>>>>    //  parameter. With all of the other messages (e.g. createElementNode) you pass namespaces as prefixed to
12711>>>>>>>    // the tagname (e.g. Get CreateElementNode "MyNameSpace:MyTag" "MyValue" to hoEle)
12711>>>>>>>    
12711>>>>>>>    Function CreateChildNode Integer iNodeType String sTagName String sNameSpace Returns Handle
12713>>>>>>>        Handle hoNewNode hoDocumentObject
12713>>>>>>>        Handle infcNewNode
12713>>>>>>>        Integer iClassid iType
12713>>>>>>>        Get DocumentObject to hoDocumentObject
12714>>>>>>>        Get NodeClassId iNodeType to iClassId
12715>>>>>>>        If (iClassId<>0) Begin
12717>>>>>>>            // Create a node in the document and assign its interface to the new DF object.
12717>>>>>>>            Get createNode of hoDocumentObject iNodeType sTagName sNameSpace to infcNewNode
12718>>>>>>>            // this is required to force the interface type to be correct.
12718>>>>>>>            Move (invokexml(DF_IXMLDOMNODE, GET_piNodeType, infcNewNode, 0, 0, 0, 0)) to iType
12719>>>>>>>            Move (invokexml(DF_IXMLDOMNODE, GET_ChangeNodeType, infcNewNode, iType, 1, 0, 0)) to infcNewNode
12720>>>>>>>            
12720>>>>>>>            If infcNewNode ;                Get CreateXMLObject iClassId infcNewNode to hoNewNode
12723>>>>>>>        End
12723>>>>>>>>
12723>>>>>>>        Function_Return hoNewNode
12724>>>>>>>    End_Function
12725>>>>>>>    
12725>>>>>>>    
12725>>>>>>>    
12725>>>>>>>    // The Addxxxxx messages create a new node and appends it to the list. When used as a function,
12725>>>>>>>    // the object handle is returned and must be disposed of later by the programmer.
12725>>>>>>>    // When used as a procedure, the object is destroyed--it just does it and is done.
12725>>>>>>>    
12725>>>>>>>    Function AddElement String sTagName String sValue Returns Handle
12727>>>>>>>        Handle hoNewElement
12727>>>>>>>        Get CreateElementNode sTagName sValue to hoNewElement
12728>>>>>>>        If hoNewElement ;            Get AppendNode hoNewElement to hoNewElement
12731>>>>>>>        Function_Return hoNewElement
12732>>>>>>>    End_Function
12733>>>>>>>    

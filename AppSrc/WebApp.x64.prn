22655>>>>>>>>>>>>>
22655>>>>>>>>>>>>>// Returns the value of the named Web Property belonging to the named object.
22655>>>>>>>>>>>>>// Displays an appropriate message if the property cannot be reached.
22655>>>>>>>>>>>>>//
22655>>>>>>>>>>>>>// Only use this function in the Debugger Watches window to watch Web 
22655>>>>>>>>>>>>>// Property values. Should never be used to get a Web Property value in 
22655>>>>>>>>>>>>>// your application. Use WebGet instead.
22655>>>>>>>>>>>>>
22655>>>>>>>>>>>>>Function _wp Global Handle hoObject String sPropName Returns Variant
22657>>>>>>>>>>>>>    Boolean bIsAjaxWebObject bInScope
22657>>>>>>>>>>>>>    String sObject
22657>>>>>>>>>>>>>    Handle hoHandler hoOwner
22657>>>>>>>>>>>>>    Variant vReturn
22657>>>>>>>>>>>>>    tWebPropMetaData pubProp
22657>>>>>>>>>>>>>    tWebPropMetaData pubProp
22657>>>>>>>>>>>>>    
22657>>>>>>>>>>>>>    //  Test ig target object is WO
22657>>>>>>>>>>>>>    Get IsAjaxWebObject of hoObject to bIsAjaxWebObject
22658>>>>>>>>>>>>>    Get Object_Label of hoObject to sObject
22659>>>>>>>>>>>>>    
22659>>>>>>>>>>>>>    If (not(bIsAjaxWebObject)) Begin
22661>>>>>>>>>>>>>        Function_Return ("Object " + sObject + " does not support web properties")
22662>>>>>>>>>>>>>    End
22662>>>>>>>>>>>>>>
22662>>>>>>>>>>>>>    
22662>>>>>>>>>>>>>    //  Find property index
22662>>>>>>>>>>>>>    Get FindWebPropertyMetaByName of hoObject sPropName to pubProp
22663>>>>>>>>>>>>>    If (pubProp.hmGetter = 0) Begin
22665>>>>>>>>>>>>>        Function_Return (sPropName + " is not a web property of " + sObject) 
22666>>>>>>>>>>>>>    End
22666>>>>>>>>>>>>>>
22666>>>>>>>>>>>>>    
22666>>>>>>>>>>>>>    //  Get handler
22666>>>>>>>>>>>>>    Get Owner of hoObject to hoOwner
22667>>>>>>>>>>>>>    If (hoOwner = -1) Begin
22669>>>>>>>>>>>>>        Function_Return (SFormat("Object '%1' is not a valid web web object for %2.", sObject, "WebGet"))        
22670>>>>>>>>>>>>>    End
22670>>>>>>>>>>>>>>
22670>>>>>>>>>>>>>    
22670>>>>>>>>>>>>>    Get PropertyHandler of hoOwner hoObject pubProp.eMode to hoHandler
22671>>>>>>>>>>>>>    If (hoHandler = -1) Begin
22673>>>>>>>>>>>>>        Function_Return (SFormat("Property '%2' of object '%1' is not a valid web property for %3, check the web property meta value.", sPropName, sObject, "WebGet"))        
22674>>>>>>>>>>>>>    End
22674>>>>>>>>>>>>>>
22674>>>>>>>>>>>>>    
22674>>>>>>>>>>>>>    // Test if handler is active....
22674>>>>>>>>>>>>>    If (not(pbActive(hoHandler))) Begin
22676>>>>>>>>>>>>>        Function_Return "Web property handler is inactive"
22677>>>>>>>>>>>>>    End
22677>>>>>>>>>>>>>>
22677>>>>>>>>>>>>>    

30670>>>>>>>    // Received whenever cWebSessionManager - NotifyChangeRights message is sent.
30670>>>>>>>    // Augment this event to manage any global rights settings.
30670>>>>>>>    Procedure OnChangeRights
30672>>>>>>>    End_Procedure
30673>>>>>>>
30673>>>>>>>    // Server-Action
30673>>>>>>>    //
30673>>>>>>>    // Call this from the client to create a new Session Key. This should effectively log out the current user.
30673>>>>>>>    Function RecreateSession Returns Boolean
30675>>>>>>>        String sSessionKey sRemoteAddress
30675>>>>>>>        Boolean bValidSession
30675>>>>>>>        Handle hoSessionManager
30675>>>>>>>        
30675>>>>>>>        Get SessionManager to hoSessionManager
30676>>>>>>>        Move False to bValidSession      
30677>>>>>>>
30677>>>>>>>        Get ServerVariable  of (ServiceDispatcher(Self)) "REMOTE_ADDR" to sRemoteAddress
30678>>>>>>>        Get CreateSession   of hoSessionManager sRemoteAddress to sSessionKey
30679>>>>>>>        Get ValidateSession of hoSessionManager sSessionKey to bValidSession
30680>>>>>>>
30680>>>>>>>        If (bValidSession) Begin
30682>>>>>>>            // Pass the session key back to the client using a client action
30682>>>>>>>            Send StoreSessionKey sSessionKey
30683>>>>>>>        End
30683>>>>>>>>
30683>>>>>>>        
30683>>>>>>>        Function_Return bValidSession
30684>>>>>>>    End_Function
30685>>>>>>>    
30685>>>>>>>    // Your user login system should call this whenever the logged-in user changes, or their rights & roles are
30685>>>>>>>    // modified.
30685>>>>>>>    //
30685>>>>>>>    // This sends NotifyChangeRights to the command bar (which will create its own cascade or NotifyChangeRights/OnChangeRights)
30685>>>>>>>    // and then sends OnChangeRights.
30685>>>>>>>    Procedure FireNotifyChangeRights
30687>>>>>>>        Handle hoCommandBar
30687>>>>>>>        Integer i iCount
30687>>>>>>>        Handle[] aClients
30688>>>>>>>        
30688>>>>>>>        // Notify all listners....
30688>>>>>>>        Get paChangeRightsClients to aClients
30689>>>>>>>        Move (SizeOfArray(aClients)) to iCount
30690>>>>>>>        
30690>>>>>>>        For i from 0 to (iCount-1)
30696>>>>>>>>
30696>>>>>>>            Send NotifyChangeRights of aClients[i]
30697>>>>>>>        Loop
30698>>>>>>>>
30698>>>>>>>        
30698>>>>>>>        // Notify the command bar...
30698>>>>>>>        Get phoCommandBar to hoCommandBar
30699>>>>>>>        If (hoCommandBar) Begin
30701>>>>>>>            Send NotifyChangeRights of hoCommandBar
30702>>>>>>>        End
30702>>>>>>>>
30702>>>>>>>
30702>>>>>>>        // Review: Determine if we should also send NotifyChangeRights/OnChangeRights to all views.
30702>>>>>>>        
30702>>>>>>>        Send OnChangeRights    // Send to self
30703>>>>>>>    End_Procedure

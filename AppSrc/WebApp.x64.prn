29327>>>>>>>// This class is the main entry point for Web Framework WebApps. It handles the HTTP API requests
29327>>>>>>>// that come in from the JavaScript Engine. The initial parsing and validation is done here before
29327>>>>>>>// the request is forwarded to the cWebApp for further handling. 
29327>>>>>>>
29327>>>>>>>Class cWebServiceDispatcher is a cWebHttpHandler
29328>>>>>>>    Procedure Construct_Object
29330>>>>>>>        Forward Send Construct_Object
29332>>>>>>>        
29332>>>>>>>        // Global handle is deprecated
29332>>>>>>>        Move Self to ghoWebServiceDispatcher
29333>>>>>>>        // Set it on the cWebApp object
29333>>>>>>>        Delegate Set phoServiceDispatcher to Self
29335>>>>>>>        
29335>>>>>>>        Set psPath to "WebServiceDispatcher.wso"
29336>>>>>>>        Set psVerbs to "GET,POST"
29337>>>>>>>        Set peErrorType to httpErrorJson
29338>>>>>>>    End_Procedure
29339>>>>>>>    
29339>>>>>>>    // Generates a fatal error (HTTP error) with JSON in the body.
29339>>>>>>>    Procedure ReportFatalError UShort usStatusCode String sReason UShort usStatusSubCode String sDescription
29341>>>>>>>        Handle hoJson hoJsonErr
29341>>>>>>>        UChar[] ucData
29342>>>>>>>        
29342>>>>>>>        //  Set headers & status
29342>>>>>>>        Send SetResponseStatus usStatusCode sReason usStatusSubCode
29343>>>>>>>        Send AddHttpResponseHeader "Content-Type" "application/json; charset=utf-8"
29344>>>>>>>        Send AddHttpResponseHeader "Cache-Control" "no-cache"
29345>>>>>>>        
29345>>>>>>>        //  Generate JSON response header
29345>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJson
29346>>>>>>>        Send InitializeJsonType of hoJson jsonTypeObject
29347>>>>>>>        
29347>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJsonErr
29348>>>>>>>        Send InitializeJsonType of hoJsonErr jsonTypeObject
29349>>>>>>>        Send SetMember of hoJson "error" hoJsonErr
29350>>>>>>>        
29350>>>>>>>        Send SetMemberValue of hoJsonErr "status" jsonTypeString usStatusCode
29351>>>>>>>        Send SetMemberValue of hoJsonErr "reason" jsonTypeString sReason
29352>>>>>>>        Send SetMemberValue of hoJsonErr "message" jsonTypeString sDescription
29353>>>>>>>        
29353>>>>>>>        Get StringifyUtf8 of hoJson to ucData
29354>>>>>>>        Send OutputUChar ucData
29355>>>>>>>        
29355>>>>>>>        Send Destroy of hoJsonErr
29356>>>>>>>        Send Destroy of hoJson
29357>>>>>>>    End_Procedure
29358>>>>>>>    
29358>>>>>>>    // Generates a fatal error (HTTP error) with JSON in the body in the style of cWebService so 
29358>>>>>>>    // that older JavaScript Engines can parse them.
29358>>>>>>>    Procedure ReportFatalErrorLegacyStyle UShort usStatusCode String sReason UShort usStatusSubCode String sDescription
29360>>>>>>>        Handle hoJson
29360>>>>>>>        UChar[] ucData
29361>>>>>>>        
29361>>>>>>>        //  Set headers & status
29361>>>>>>>        Send SetResponseStatus usStatusCode sReason sDescription
29362>>>>>>>        Send AddHttpResponseHeader "Content-Type" "application/json; charset=utf-8"
29363>>>>>>>        Send AddHttpResponseHeader "Cache-Control" "no-cache"
29364>>>>>>>        
29364>>>>>>>        //  Generate JSON response header
29364>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJson
29365>>>>>>>        Send InitializeJsonType of hoJson jsonTypeObject
29366>>>>>>>        
29366>>>>>>>        Send SetMemberValue of hoJson "errorCode" jsonTypeString "soap:Server"
29367>>>>>>>        Send SetMemberValue of hoJson "errorDescription" jsonTypeString sDescription
29368>>>>>>>        
29368>>>>>>>        Get StringifyUtf8 of hoJson to ucData
29369>>>>>>>        Send OutputUChar ucData
29370>>>>>>>        
29370>>>>>>>        Send Destroy of hoJson
29371>>>>>>>    End_Procedure
29372>>>>>>>    
29372>>>>>>>    // Generates a fatal error listing DataFlex errors that occurred.
29372>>>>>>>    Procedure ReportDataFlexErrors
29374>>>>>>>        String sMessage sError
29374>>>>>>>        Integer iErrs iIndex iError
29374>>>>>>>        
29374>>>>>>>        Move "Unexpected DataFlex Errors." to sMessage
29375>>>>>>>        
29375>>>>>>>        // handle any errors
29375>>>>>>>        Get ErrorCount to iErrs // any errors
29376>>>>>>>        
29376>>>>>>>        For iIndex from 0 to (iErrs - 1)   
29382>>>>>>>>
29382>>>>>>>            Get ErrorNumber iIndex to iError   
29383>>>>>>>            Get ErrorMessage iIndex to sError 
29384>>>>>>>            Move (sMessage + C_NewLine + String(iError) + ": " + sError) to sMessage
29385>>>>>>>        Loop
29386>>>>>>>>
29386>>>>>>>        
29386>>>>>>>        Send ReportFatalError 500 "Internal server error" 0 sMessage
29387>>>>>>>    End_Procedure
29388>>>>>>>    
29388>>>>>>>    // Handles API calls made by the JavaScript Engine. It parses the incoming JSON and performs several validations. 
29388>>>>>>>    //
29388>>>>>>>    // HTTP errors will be returned on:
29388>>>>>>>    //  - Bad request format (couldn't parse JSON)
29388>>>>>>>    //  - Invalid JSON format
29388>>>>>>>    //  - Version check fails
29388>>>>>>>    //  - Other DataFlex errors occurred
29388>>>>>>>    //
29388>>>>>>>    // When succesfull CallAction on ghoWebApp is triggered to do framework processing.
29388>>>>>>>    Procedure OnHttpPost String sPath String sContentType String sAcceptType Integer iSize
29390>>>>>>>        UChar[] ucData ucEmpty
29392>>>>>>>        Boolean bSuccess bOrigEV bLogErrors
29392>>>>>>>        String sReason
29392>>>>>>>        Integer iErrorCount
29392>>>>>>>        
29392>>>>>>>        tWebCallContext cctx
29392>>>>>>>        tWebCallContext cctx
29392>>>>>>>        
29392>>>>>>>        Delegate Get pbLogInvalidRequests to bLogErrors 
29394>>>>>>>        
29394>>>>>>>        Send ErrorQueueStart 
29395>>>>>>>        Get pbAllErrorsToEventLog to bOrigEV
29396>>>>>>>        Set pbAllErrorsToEventLog to bLogErrors
29397>>>>>>>        
29397>>>>>>>        Move 0 to cctx.iFatalErrorCode
29398>>>>>>>        Move False to cctx.bCancel
29399>>>>>>>        
29399>>>>>>>        If (Lowercase(sContentType) contains "application/json") Begin
29401>>>>>>>        
29401>>>>>>>            //  Retrieve and parse JSON request
29401>>>>>>>            Get RequestDataUChar -1 to ucData
29402>>>>>>>            If (SizeOfArray(ucData) > 0) Begin
29404>>>>>>>                Get Create (RefClass(cJsonObject)) to cctx.hoJsonRequest
29405>>>>>>>            
29405>>>>>>>                //  Parse & validate request JSON
29405>>>>>>>                Get ParseUtf8 of cctx.hoJsonRequest ucData to bSuccess
29406>>>>>>>                If (bSuccess) Begin
29408>>>>>>>                    Move ucEmpty to ucData
29409>>>>>>>                
29409>>>>>>>                    //  Assemble the response JSON
29409>>>>>>>                    Get Create (RefClass(cJsonObject)) to cctx.hoJsonResponse
29410>>>>>>>                    Send InitializeJsonType of cctx.hoJsonResponse jsonTypeObject
29411>>>>>>>                    
29411>>>>>>>                    Send ErrorQueueEnd
29412>>>>>>>                    Get ErrorCount to iErrorCount
29413>>>>>>>                    
29413>>>>>>>                    If (iErrorCount = 0) Begin
29415>>>>>>>                        //  Reset error logging before going into application code
29415>>>>>>>                        Set pbAllErrorsToEventLog to bOrigEV
29416>>>>>>>                        
29416>>>>>>>                        Send ProcessRequest of (Host(Self)) (&cctx)
29417>>>>>>>                        
29417>>>>>>>                        //  Restart error queuing and logging after application code
29417>>>>>>>                        Send ErrorQueueStart 
29418>>>>>>>                        Set pbAllErrorsToEventLog to bLogErrors
29419>>>>>>>                        
29419>>>>>>>                        
29419>>>>>>>                        If (cctx.iFatalErrorCode= 0) Begin
29421>>>>>>>                            Send AddHttpResponseHeader "Cache-Control" "no-cache"
29422>>>>>>>                            Send AddHttpResponseHeader "Content-Type" "application/json; charset=utf-8"
29423>>>>>>>                            
29423>>>>>>>                            Get StringifyUtf8 of cctx.hoJsonResponse to ucData
29424>>>>>>>                            Send OutputUChar ucData  
29425>>>>>>>                        End
29425>>>>>>>>
29425>>>>>>>                        Else Begin
29426>>>>>>>                            Send ReportFatalError cctx.iFatalErrorCode "Fatal error"  0 cctx.sFatalError
29427>>>>>>>                        End
29427>>>>>>>>
29427>>>>>>>                    
29427>>>>>>>                        Send Destroy of cctx.hoJsonResponse
29428>>>>>>>                    End
29428>>>>>>>>
29428>>>>>>>                    Else  Begin
29429>>>>>>>                        Send ReportDataFlexErrors 
29430>>>>>>>                    End
29430>>>>>>>>
29430>>>>>>>                End
29430>>>>>>>>
29430>>>>>>>                Else Begin
29431>>>>>>>                    Get psParseError of cctx.hoJsonRequest to sReason
29432>>>>>>>                    Send ReportFatalError 400 "Bad request" 0 ("Unable to parse request data: " + sReason)
29433>>>>>>>                    
29433>>>>>>>                    If (bLogErrors) Begin
29435>>>>>>>                        Error DFERR_WEBAPP_BAD_REQUEST ("Unable to parse request data: " + sReason)
29436>>>>>>>>
29436>>>>>>>                    End
29436>>>>>>>>
29436>>>>>>>                End
29436>>>>>>>>
29436>>>>>>>                
29436>>>>>>>                Send Destroy of cctx.hoJsonRequest
29437>>>>>>>            End
29437>>>>>>>>
29437>>>>>>>            Else Begin
29438>>>>>>>                Send ReportFatalError 400 "Bad request" 0 "No request body"
29439>>>>>>>                
29439>>>>>>>                If (bLogErrors) Begin
29441>>>>>>>                    Error DFERR_WEBAPP_BAD_REQUEST "No request body"
29442>>>>>>>>
29442>>>>>>>                End
29442>>>>>>>>
29442>>>>>>>            End
29442>>>>>>>>
29442>>>>>>>        End
29442>>>>>>>>
29442>>>>>>>        Else Begin
29443>>>>>>>            Send ReportFatalError 400 "Bad request" 0 "Unexpected content-type header value."
29444>>>>>>>            If (bLogErrors) Begin
29446>>>>>>>                Error DFERR_WEBAPP_BAD_REQUEST "Unexpected content-type header value."
29447>>>>>>>>
29447>>>>>>>            End
29447>>>>>>>>
29447>>>>>>>        End
29447>>>>>>>>
29447>>>>>>>        
29447>>>>>>>        //  Cleanup
29447>>>>>>>        Send ErrorQueueEnd
29448>>>>>>>        Send ClearErrors
29449>>>>>>>        Set pbAllErrorsToEventLog to bOrigEV
29450>>>>>>>        
29450>>>>>>>    End_Procedure

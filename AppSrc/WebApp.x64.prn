10634>>>>>>>>>        Get psDriverId            to sDrvrId
10635>>>>>>>>>        
10635>>>>>>>>>        // Call the procedure
10635>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10637>>>>>>>>>            // Pass the information
10637>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                Callback Self ;                Passing ihdbc iArgnum ihstmt ;                Result iVoid
10642>>>>>>>>>            
10642>>>>>>>>>            // Pass the argument
10642>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLSETPROCARG ;                Callback Self ;                Passing sArgument sEmpty 0 ;                Result iVoid
10647>>>>>>>>>        End

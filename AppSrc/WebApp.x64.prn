7252>>>>>>>>>    // lpsWin32FindData is a pointer to a WIN32_FIND_DATAW struct, which contains pointers to UTF-8 strings.
7252>>>>>>>>>    // These string must be converted to UTF-16 and afterwards back to UTF-8.
7252>>>>>>>>>
7252>>>>>>>>>    // Copy the struct to a local struct that can be modified to UTF-16.
7252>>>>>>>>>    Move (SizeOfType(tWin32FindData) - MAX_PATH - MAX_ALTPATH) to iSizeOfStructWithoutStrings

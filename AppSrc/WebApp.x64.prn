34714>>>>>>>    // called for relational update. DD should contain selected record
34714>>>>>>>    Procedure OnMoveValueOutByRelational Handle hoInvokingObject
34716>>>>>>>        RowID rRowId
34716>>>>>>>        Handle hoInvokingServer hoServer
34716>>>>>>>        Integer iFile 
34716>>>>>>>        Boolean bDataAware bSuccess
34716>>>>>>>
34716>>>>>>>        Get pbDataAware to bDataAware
34717>>>>>>>        If not bDataAware Begin
34719>>>>>>>            // this should have already been tested and should not be possible
34719>>>>>>>            Error DFERR_PROGRAM "Assert: OnMoveValueOutByRelational called by non data aware grid list can not be used as a relational prompt list for this object"
34720>>>>>>>>
34720>>>>>>>            Procedure_Return
34721>>>>>>>        End
34721>>>>>>>>
34721>>>>>>>
34721>>>>>>>        Get Server to hoServer
34722>>>>>>>        Get Main_File of hoServer to iFile
34723>>>>>>>        Get CurrentRowId of hoServer to rRowId
34724>>>>>>>        If (not(IsNullRowID(rRowId))) Begin
34726>>>>>>>            Get Server of hoInvokingObject to hoInvokingServer
34727>>>>>>>            Get FindByRowIdEx of hoInvokingServer iFile rRowId to bSuccess
34728>>>>>>>            // this is very unlikely
34728>>>>>>>            If not bSuccess Begin
34730>>>>>>>                Error DFERR_CANT_REFIND_RECORD
34731>>>>>>>>
34731>>>>>>>            End
34731>>>>>>>>
34731>>>>>>>        End
34731>>>>>>>>
34731>>>>>>>    End_Procedure
34732>>>>>>>
34732>>>>>>>    // called for move value out update. DD and web column objects should contain selected record
34732>>>>>>>    Procedure OnMoveValueOutByValue Handle hoInvokingObject
34734>>>>>>>        String sValue
34734>>>>>>>        Handle hoCol
34734>>>>>>>        Integer iCol
34734>>>>>>>
34734>>>>>>>        WebGet piUpdateColumn to iCol
34735>>>>>>>        Get GetColumnObject iCol to hoCol
34736>>>>>>>        
34736>>>>>>>        WebGet psValue of hoCol to sValue
34737>>>>>>>        WebSet psValue of hoInvokingObject to sValue
34738>>>>>>>        WebSet pbChanged of hoInvokingObject to True
34739>>>>>>>    End_Procedure
34740>>>>>>>
34740>>>>>>>    Procedure OnMoveValueOutByCustom Handle hoInvokingObject
34742>>>>>>>    End_Procedure
34743>>>>>>>
34743>>>>>>>    // This is only called in a successful close
34743>>>>>>>    Procedure ClosePromptList
34745>>>>>>>        Handle hoInvokingObject hoServer
34745>>>>>>>        Handle hmCallBack
34745>>>>>>>        Integer iFile eUpdateMode
34745>>>>>>>        RowID rRowId
34745>>>>>>>        String sRowId sCallBack
34745>>>>>>>        Boolean bOldExt bDataAware bSuccess
34745>>>>>>>        
34745>>>>>>>        Get pbDataAware to bDataAware
34746>>>>>>>        If bDataAware Begin
34748>>>>>>>            // update DD with the current selected record
34748>>>>>>>            WebGet psCurrentRowID to sRowId
34749>>>>>>>            Move (DeserializeRowID(sRowId)) to rRowId            
34750>>>>>>>            Get Server to hoServer
34751>>>>>>>            Get Main_File of hoServer to iFile
34752>>>>>>>            If (not(IsNullRowID(rRowId))) Begin
34754>>>>>>>                Get pbNotifyingExternalDD to bOldExt
34755>>>>>>>                Set pbNotifyingExternalDD to True // refresh will not try to fill the grid
34756>>>>>>>                Get FindByRowIdEx of hoServer iFile rRowId to bSuccess
34757>>>>>>>                // this is very unlikely
34757>>>>>>>                If not bSuccess Begin
34759>>>>>>>                    Error DFERR_CANT_REFIND_RECORD
34760>>>>>>>>
34760>>>>>>>                End
34760>>>>>>>>
34760>>>>>>>                Set pbNotifyingExternalDD to bOldExt
34761>>>>>>>            End
34761>>>>>>>>
34761>>>>>>>        End
34761>>>>>>>>
34761>>>>>>>        
34761>>>>>>>        WebGet peUpdateMode to eUpdateMode
34762>>>>>>>        // If non-invoking there is by definition, no Move value out
34762>>>>>>>        If (eUpdateMode<>umPromptNonInvoking) Begin
34764>>>>>>>            Get GetInvokingObject to hoInvokingObject            
34765>>>>>>>            
34765>>>>>>>            If not hoInvokingObject Begin
34767>>>>>>>                Error DFERR_PROGRAM "Assert: hoInvokingObject is 0"
34768>>>>>>>>
34768>>>>>>>                Procedure_Return
34769>>>>>>>            End
34769>>>>>>>>
34769>>>>>>>            
34769>>>>>>>            If (eUpdateMode=umPromptRelational) Begin
34771>>>>>>>                Send OnMoveValueOutByRelational hoInvokingObject
34772>>>>>>>            End
34772>>>>>>>>
34772>>>>>>>            Else If (eUpdateMode=umPromptValue) Begin
34775>>>>>>>                Send OnMoveValueOutByValue hoInvokingObject
34776>>>>>>>            End
34776>>>>>>>>
34776>>>>>>>            Else If (eUpdateMode=umPromptCustom) Begin
34779>>>>>>>                Send OnMoveValueOutByCustom hoInvokingObject
34780>>>>>>>            End
34780>>>>>>>>
34780>>>>>>>            WebGet psPromptUpdateCallback to sCallBack
34781>>>>>>>            If sCallBack Begin
34783>>>>>>>                Get WebMethodByName of hoInvokingObject sCallBack to hmCallBack
34784>>>>>>>                If hmCallBack Begin
34786>>>>>>>                    Send hmCallBack of hoInvokingObject Self
34787>>>>>>>                End
34787>>>>>>>>
34787>>>>>>>            End
34787>>>>>>>>
34787>>>>>>>        End
34787>>>>>>>>
34787>>>>>>>    End_Procedure
34788>>>>>>>
34788>>>>>>>    Procedure Cancel
34790>>>>>>>        Integer eViewStyle
34790>>>>>>>        Get peWebViewStyle to eViewStyle
34791>>>>>>>        
34791>>>>>>>        // if drilldown we do a NavigateCancel instead of a Hide.
34791>>>>>>>        // We use NavigateCancel instead of NavigateClose because the prompt
34791>>>>>>>        // list has already updated the invoking object.
34791>>>>>>>        // If it is a dialog we call CloseDialog and let the dialog decide how it needs to be closed
34791>>>>>>>        If (eViewStyle=wvsDrillDown) Begin
34793>>>>>>>            Send NavigateCancel
34794>>>>>>>        End
34794>>>>>>>>
34794>>>>>>>        Else If (eViewStyle=wvsDialog) Begin
34797>>>>>>>            Send CloseDialog
34798>>>>>>>        End
34798>>>>>>>>
34798>>>>>>>        Else Begin
34799>>>>>>>            Send Hide
34800>>>>>>>        End
34800>>>>>>>>
34800>>>>>>>    End_Procedure
34801>>>>>>>
34801>>>>>>>    Procedure Ok
34803>>>>>>>        Send ClosePromptList
34804>>>>>>>        Send Cancel
34805>>>>>>>        Send NotifyCloseModalDialog
34806>>>>>>>    End_Procedure

25942>>>>>>>>>>>    // Augmented to apply a pbSortable value for columns that are not already set
25942>>>>>>>>>>>    Procedure Attach_Deo_To_Server
25944>>>>>>>>>>>        Integer iIndex iSortable eDataType eFooterDataType iPrecision iFooterPrecision
25944>>>>>>>>>>>        Boolean bClientSortable
25944>>>>>>>>>>>        String sMask sFooterMask
25944>>>>>>>>>>>
25944>>>>>>>>>>>        Forward Send Attach_Deo_To_Server
25946>>>>>>>>>>>        
25946>>>>>>>>>>>        Get peDataType to eDataType
25947>>>>>>>>>>>        Get peFooterDataType to eFooterDataType
25948>>>>>>>>>>>        If (eFooterDataType = C_WebDefault) Begin
25950>>>>>>>>>>>            Set peFooterDataType to eDataType
25951>>>>>>>>>>>        End
25951>>>>>>>>>>>>
25951>>>>>>>>>>>        
25951>>>>>>>>>>>        Get psMask to sMask
25952>>>>>>>>>>>        Get psFooterMask to sFooterMask
25953>>>>>>>>>>>        If (sFooterMask = "") Begin
25955>>>>>>>>>>>            Set psFooterMask to sMask
25956>>>>>>>>>>>        End
25956>>>>>>>>>>>>
25956>>>>>>>>>>>         
25956>>>>>>>>>>>        Get piPrecision to iPrecision
25957>>>>>>>>>>>        Get piFooterPrecision to iFooterPrecision
25958>>>>>>>>>>>        If (iFooterPrecision = C_WebDefault) Begin
25960>>>>>>>>>>>            Set piFooterPrecision to iPrecision
25961>>>>>>>>>>>        End
25961>>>>>>>>>>>>
25961>>>>>>>>>>>
25961>>>>>>>>>>>        // need to set piDefaultIndex and pbSortable (if not explicitly set)
25961>>>>>>>>>>>        // find out who does the sorting, the client or the server
25961>>>>>>>>>>>        Delegate Get ClientSortable to bClientSortable
25963>>>>>>>>>>>        Get pbSortable to iSortable
25964>>>>>>>>>>>        
25964>>>>>>>>>>>        If (bClientSortable) Begin
25966>>>>>>>>>>>            // if client sorting, we dont care about piDefaultIndex
25966>>>>>>>>>>>            // and if  pbSortable is undefined, true is a good default
25966>>>>>>>>>>>            If (iSortable = C_WebDefault) Begin
25968>>>>>>>>>>>                Set pbSortable to True
25969>>>>>>>>>>>            End
25969>>>>>>>>>>>>
25969>>>>>>>>>>>        End
25969>>>>>>>>>>>>
25969>>>>>>>>>>>        Else Begin
25970>>>>>>>>>>>            
25970>>>>>>>>>>>            // if server sorting, we will set piDefaultIndex
25970>>>>>>>>>>>            // and if pbSortable is undefined, set it based on having an index
25970>>>>>>>>>>>            Get piDefaultIndex to iIndex
25971>>>>>>>>>>>            
25971>>>>>>>>>>>            If (iIndex = -1) Begin
25973>>>>>>>>>>>                Get DefaultIndex to iIndex
25974>>>>>>>>>>>                Set piDefaultIndex to iIndex 
25975>>>>>>>>>>>            End
25975>>>>>>>>>>>>
25975>>>>>>>>>>>            
25975>>>>>>>>>>>            // If the pbSortable is undefined, set a proper default for it
25975>>>>>>>>>>>            If (iSortable = C_WebDefault) Begin
25977>>>>>>>>>>>                Set pbSortable to (iIndex <> -1)
25978>>>>>>>>>>>            End
25978>>>>>>>>>>>>
25978>>>>>>>>>>>        End
25978>>>>>>>>>>>>
25978>>>>>>>>>>>
25978>>>>>>>>>>>    End_Procedure
25979>>>>>>>>>>>    

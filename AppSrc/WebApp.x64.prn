32979>>>>>>>    Procedure Construct_Object
32981>>>>>>>        Forward Send Construct_Object
32983>>>>>>>
32983>>>>>>>        Property Boolean pbAutoSave True    // Determines if a changed row should be saved automatically when changing rows
32984>>>>>>>        Property Boolean pbAutoRegenerate False  // Determines If adding a new row can trigger a refresh of the grid's ordering. (note: the Windows cCJGrid control defaults this property to True)
32985>>>>>>>        

6561>>>>>>>    Procedure ApplySQLFilter
6563>>>>>>>        String sNewFilter sOldFilter
6563>>>>>>>        Boolean bApplyGlobalSQLFilters bOldFilterActive
6563>>>>>>>        Get psSQLFilter to sNewFilter
6564>>>>>>>        // if we have am active  table filter we can either ignore it or and it to the where clause
6564>>>>>>>        // pbApplyGlobalSQLFilters determines what to do.
6564>>>>>>>        Get pbApplyGlobalSQLFilters to bApplyGlobalSQLFilters
6565>>>>>>>        Get pbOldFilterActive to bOldFilterActive
6566>>>>>>>        If (bApplyGlobalSQLFilters and bOldFilterActive) Begin
6568>>>>>>>            Get psOldFilter to sOldFilter
6569>>>>>>>            Get SQLStrAppend sOldFilter sNewFilter to sNewFilter
6570>>>>>>>        End
6570>>>>>>>>
6570>>>>>>>        Send ApplySQLFilterStr sNewFilter
6571>>>>>>>    End_Procedure
6572>>>>>>>
6572>>>>>>>    Procedure Data_Set_PreFind
6574>>>>>>>        Boolean bUseDDSQLFilters
6574>>>>>>>        String sOldDDFilter
6574>>>>>>>        Get pbUseDDSQLFilters to bUseDDSQLFilters
6575>>>>>>>        If bUseDDSQLFilters Begin
6577>>>>>>>
6577>>>>>>>            Send StoreDefaultSQLFilters
6578>>>>>>>
6578>>>>>>>            // this can get called during cascade deletes. In such a case we will
6578>>>>>>>            // never explicitly not apply an SQL filters because it could violate relational integrity
6578>>>>>>>            If (OPERATION_MODE=MODE_DELETING) Begin
6580>>>>>>>                Get psSQLFilter to sOldDDFilter
6581>>>>>>>                Set psSQLFilter to "" // make sure there is no filter applied
6582>>>>>>>            End
6582>>>>>>>>
6582>>>>>>>
6582>>>>>>>            Send ApplySQLFilter
6583>>>>>>>
6583>>>>>>>            If (OPERATION_MODE=MODE_DELETING) Begin
6585>>>>>>>                Set psSQLFilter to sOldDDFilter
6586>>>>>>>            End
6586>>>>>>>>
6586>>>>>>>        End
6586>>>>>>>>
6586>>>>>>>    End_Procedure
6587>>>>>>>
6587>>>>>>>    Procedure Data_Set_PostFind
6589>>>>>>>        Boolean bUseDDSQLFilters
6589>>>>>>>        Get pbUseDDSQLFilters to bUseDDSQLFilters
6590>>>>>>>        If bUseDDSQLFilters Begin
6592>>>>>>>            Send RestoreDefaultSQLFilters
6593>>>>>>>        End
6593>>>>>>>>
6593>>>>>>>    End_Procedure

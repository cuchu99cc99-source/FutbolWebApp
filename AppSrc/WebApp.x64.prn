26336>>>>>>>>>        
26336>>>>>>>>>        Property Integer piOrdering -1                // initial ordering index see also Function Ordering
26337>>>>>>>>>        Property Integer piPageSize 80                // Max number of rows to send to the client at a time. 0 = load all available rows
26338>>>>>>>>>        
26338>>>>>>>>>        // should columns adjust their pbEnabled based on the DDO binding or should it be static.
26338>>>>>>>>>        // Normally only grids should be dynamic. This property is queried by cWebColumn objects.
26338>>>>>>>>>        Property Boolean pbColumnsEnabledStatic True
26339>>>>>>>>>
26339>>>>>>>>>        Property Integer peRequestFindMode rfmFindAll
26340>>>>>>>>>        
26340>>>>>>>>>        Property Boolean pbDataAware True             // Set True if Grid Columns use data binding to DDO. False if there should be no DDO connection.
26343>>>>>>>>>
26343>>>>>>>>>        Property Integer peDbGridType gtAutomatic           // If set to true, data is static and load just once. Only used with pbDataAware=T.
26346>>>>>>>>>        
26346>>>>>>>>>        Property Integer peGrouping grpDisabled
26349>>>>>>>>>        
26349>>>>>>>>>        Property Boolean pbGroupsCollapsible True
26352>>>>>>>>>        
26352>>>>>>>>>        Property Boolean pbGroupsCollapseByDefault False
26355>>>>>>>>>        
26355>>>>>>>>>        Property Handle[] phoColumnObjects            // ordered list of cWebColumn objects (in left to right column order)
26356>>>>>>>>>        Property Boolean pbNotifyingExternalDD False  // Private: Used to indicate to the Refresh event that we are handling an event generated by some action on the list/grid control (i.e. delete row, change row, etc)
26357>>>>>>>>>        Property Boolean pbGridBehavior False         // Private: Used by cWebColumn objects to test if they live in a cWebList (read only) or a cWebGrid (save and other stuff is supported)
26358>>>>>>>>>        Property Boolean pbInClearGrid False          // Private: should be set when a DD Clear is supposed refresh an empty grid instead of adding a new row            
26359>>>>>>>>>        
26359>>>>>>>>>        Property Boolean pbSuppressCacheError True // if a record cannot be found in cache, do we report the error?        
26360>>>>>>>>>        // Published Properties
26360>>>>>>>>>        Property Boolean pbColumnSortable True      // If true, column sorting is allowed (which may be server side or client side)
26363>>>>>>>>>        Property Boolean pbAutoSearch True          // If true the search dialog will popup automatically when the user starts typing
26366>>>>>>>>>        Property Boolean pbShowSelected True        // If true the list will visually show which row is selected.
26369>>>>>>>>>        Property Boolean pbShowHeader True          // If true the list will show a header that allows the user to see the column captions and sorting.
26372>>>>>>>>>        Property Boolean pbShowFooter False          // If true the list will show a footer that allows the user to see the footer information.
26375>>>>>>>>>        Property Boolean pbScroll True              // If true the list will scroll vertically
26378>>>>>>>>>        
26378>>>>>>>>>        Property Boolean pbReverseOrdering False    // If true then the current grid ordering is reversed
26381>>>>>>>>>        Property Boolean pbUnOrdered False          // If True then the grid data has potentially become unordered due to changes in the data
26384>>>>>>>>>        Property Integer piSortColumn -1            // Indicates which column the grid is currently sorted on (-1 means the data is sorted via piOrdering)
26387>>>>>>>>>        Property String psCurrentRowId ""           // Row ID of the currently selected row.
26390>>>>>>>>>        Property Integer piCurrentRowIndex -1       // The row index of the currently selected row on the client. Does not reflect row changes on the server within the current request. Note that if peGridType is set to gtAutomatic this number is relative to the rows in cache on the client.
26393>>>>>>>>>        Property Integer piRowCount 0               // The number of rows currently on the client. Note that if peGridType is set to gtAutomatic this number does not represent the entire set.
26396>>>>>>>>>        
26396>>>>>>>>>        Property Boolean pbColumnsResizable True
26399>>>>>>>>>        
26399>>>>>>>>>        Property Boolean pbAutoColumnSizing True
26402>>>>>>>>>        
26402>>>>>>>>>        Property Boolean pbOfflineEditing False      // Optimization: Disable server call on row change
26405>>>>>>>>>        Property String psPlaceHolder ""            //  Placeholder text shown if the list has no records
26408>>>>>>>>>        
26408>>>>>>>>>        Property Integer piLimitRows 0              // Only show the first x rows (0 = show all), requires peDbGridType to be set to gtAllData or pbScroll to false!
26411>>>>>>>>>        
26411>>>>>>>>>        Property String psKeyBuddy ""
26414>>>>>>>>>        
26414>>>>>>>>>        Property Handle phoKeyBuddy C_WebUnresolvedObject   //  Can be set to another cWebBaseUIObject and the cWebList will respond to key actions on that control 
26415>>>>>>>>>        
26415>>>>>>>>>         
26415>>>>>>>>>        Property Boolean pbServerOnRowClick False   // Switches the OnRowClick event on and off
26418>>>>>>>>>        Property String psClientOnRowClick ""       // Can be set to a client-side JavaScript event handler for the OnRowClick event
26421>>>>>>>>>        
26421>>>>>>>>>        Property Boolean pbAllowDeleteRow False   // Allows deleting rows.
26422>>>>>>>>>        
26422>>>>>>>>>        Property Boolean pbAllowColumnReordering True // Allows the moving of columns by dragging.
26425>>>>>>>>>        Property Boolean pbAllowColumnHiding True // Allows the showing and hiding of columns by context menu.
26428>>>>>>>>>        
26428>>>>>>>>>        Property Boolean pbStoreColumnLayout True
26431>>>>>>>>>        Property String psClientOnColumnLayoutChanged ""
26434>>>>>>>>>        Property Boolean pbServerOnColumnLayoutChanged False
26437>>>>>>>>>        
26437>>>>>>>>>        Property Boolean pbStoreGroupConfig True
26440>>>>>>>>>        Property String psClientOnGroupConfigChanged ""
26443>>>>>>>>>        Property Boolean pbServerOnGroupConfigChanged False
26446>>>>>>>>>        
26446>>>>>>>>>        Property Boolean pbServerOnGroupHeaderToggle False
26449>>>>>>>>>        
26449>>>>>>>>>        Property Boolean pbUseCustomHeaderMenu False
26450>>>>>>>>>        Property Boolean pbUseHeaderMenuOnWholeList False // Implicit (True) if pbShowHeader is (False)
26451>>>>>>>>>        Property Handle phPrivateDefaultHeaderMenu 0
26452>>>>>>>>>                
26452>>>>>>>>>        Set psJSClass to "df.WebList"
26453>>>>>>>>>        Set Auto_Fill_State to True                 // Indicates that server DDO should find first record in it's dataset (important to set True for constrained child grids such as Order Details, for unconstrained lists it does not matter what the value is).
26454>>>>>>>>>        Set pbShowLabel to False                    // Lists won't have a label by default
26455>>>>>>>>>        Set piColumnSpan to 0                       // Lists will span the whole width by default (0 does this)
26456>>>>>>>>>        Set piHeight to 200

7231>>>>>>>>>// Wrapper Function winFindFirstFile
7231>>>>>>>>>Function winFindFirstFile Global ;    String  sFileSpec ;    Pointer lpsWin32FindData ;    Returns Handle
7233>>>>>>>>>    
7233>>>>>>>>>    Handle  hResult
7233>>>>>>>>>    Integer iVoid iFilenameSize iAltFilenameSize
7233>>>>>>>>>    Integer iSizeOfStructWithoutStrings
7233>>>>>>>>>    String  sFileName sAlternateFileName
7233>>>>>>>>>    WString wFileName wAlternateFileName
7233>>>>>>>>>    Pointer pWFD
7233>>>>>>>>>    tWin32FindDataW tWFD
7233>>>>>>>>>    tWin32FindDataW tWFD
7233>>>>>>>>>    
7233>>>>>>>>>    // lpsWin32FindData is a pointer to a WIN32_FIND_DATAW struct, which contains pointers to UTF-8 strings.
7233>>>>>>>>>    // These string must be converted to UTF-16 and afterwards back to UTF-8.
7233>>>>>>>>>
7233>>>>>>>>>    Move (SizeOfType(tWin32FindData) - MAX_PATH - MAX_ALTPATH) to iSizeOfStructWithoutStrings
7234>>>>>>>>>    Move (AddressOf(tWFD)) to pWFD
7235>>>>>>>>>    
7235>>>>>>>>>    // Call the function
7235>>>>>>>>>    Move (winFindFirstFileW (sFileSpec, pWFD)) to hResult
7236>>>>>>>>>
7236>>>>>>>>>    // Copy the struct contents back to the incoming one.
7236>>>>>>>>>    Move (CopyMemory(lpsWin32FindData, pWFD, iSizeOfStructWithoutStrings)) to iVoid
7237>>>>>>>>>    
7237>>>>>>>>>    // But do the strings separately and convert them to UTF8
7237>>>>>>>>>    Move (PointerToWString(pWFD + iSizeOfStructWithoutStrings)) to sFileName
7238>>>>>>>>>    Move (PointerToWString(pWFD + iSizeOfStructWithoutStrings + (MAX_PATH*2))) to sAlternateFileName
7239>>>>>>>>>    
7239>>>>>>>>>    // Extend string with 0 to the maximum number of characters
7239>>>>>>>>>    If (SizeOfString(sFileName)<MAX_PATH) ;        Append sFileName (Repeat(Character(0), MAX_PATH - SizeOfString(sFileName)))
7242>>>>>>>>>    If (SizeOfString(sAlternateFileName)<MAX_ALTPATH) ;        Append sAlternateFileName (Repeat(Character(0), MAX_ALTPATH - SizeOfString(sAlternateFileName)))
7245>>>>>>>>>        
7245>>>>>>>>>    Move (MemCopy(lpsWin32FindData + iSizeOfStructWithoutStrings, AddressOf(sFileName), MAX_PATH)) to iVoid
7246>>>>>>>>>    Move (MemCopy(lpsWin32FindData + iSizeOfStructWithoutStrings + MAX_PATH, AddressOf(sAlternateFileName), MAX_ALTPATH)) to iVoid
7247>>>>>>>>>    
7247>>>>>>>>>    Function_Return hResult
7248>>>>>>>>>End_Function
7249>>>>>>>>>
